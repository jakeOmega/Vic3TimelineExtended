	type te_budget_expense_legend = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2
		te_budget_chart_row = {
			visible = "[NotEqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_expense_institution_colonial_affairs'), '(CFixedPoint)0')]"
			tooltip = "te_budget_chart_institution_colonial_affairs_tt"
			blockoverride "swatch" { texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_pie_republican.dds" }
			blockoverride "label" { text = "institution_colonial_affairs" }
			blockoverride "amount" { raw_text = "@money![TopScope.ScriptValue('te_budget_expense_institution_colonial_affairs')|D]" }
			blockoverride "share" { raw_text = "[TopScope.ScriptValue('te_budget_expense_institution_colonial_affairs_share')|%1]" }
		}
		te_budget_chart_row = {
			visible = "[NotEqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_expense_institution_health_system'), '(CFixedPoint)0')]"
			tooltip = "te_budget_chart_institution_health_system_tt"
