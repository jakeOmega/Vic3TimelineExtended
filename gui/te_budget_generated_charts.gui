	type te_budget_expense_row_administration_group = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		visible = "[And(GreaterThan_CFixedPoint(TopScope.ScriptValue('te_budget_expense_administration_group_cached_active'), '(CFixedPoint)0'), EqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_expense_administration_group_cached_rank'), TopScope.ScriptValue('te_budget_row_slot')))]"
		te_budget_chart_row = {
			tooltip = "te_budget_chart_group_tt"
			blockoverride "indent" { size = { 0 1 } }
			blockoverride "label_width" { minimumsize = { 271 28 } maximumsize = { 271 -1 } }
			blockoverride "swatch" { texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_pie_republican.dds" alpha = "[Select_float(GetVariableSystem.Exists('te_budget_expense_administration_group_open'), '(float)0', '(float)1')]" }
			blockoverride "label" { text = "te_budget_chart_administration_group" }
			blockoverride "amount" { raw_text = "@money![TopScope.ScriptValue('te_budget_expense_administration_group')|D]" }
			blockoverride "share" { raw_text = "[TopScope.ScriptValue('te_budget_expense_administration_group_share')|%1]" }
			blockoverride "toggle" {
				button = {
					size = { 18 24 }
					parentanchor = vcenter
					onclick = "[GetVariableSystem.Toggle('te_budget_expense_administration_group_open')]"
					tooltip = "te_budget_chart_expand_tt"
					button = { using = expand_arrow size = { 18 18 } parentanchor = center alwaystransparent = yes visible = "[Not(GetVariableSystem.Exists('te_budget_expense_administration_group_open'))]" }
					button = { using = expand_arrow_expanded size = { 18 18 } parentanchor = center alwaystransparent = yes visible = "[GetVariableSystem.Exists('te_budget_expense_administration_group_open')]" }
				}
			}
		}
	}
