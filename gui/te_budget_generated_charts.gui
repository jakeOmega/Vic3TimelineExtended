	type te_budget_expense_section = flowcontainer {
		direction = vertical
		spacing = 8
		ignoreinvisible = yes
		# Intermediate value scopes share the building sum, pool and denominator.
		datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('total', MakeScopeValue(Subtract_CFixedPoint(GetPlayer.GetWeeklyExpenses, GetPlayer.GetInvestmentIncome))).AddScope('private_construction', MakeScopeValue(GetPlayer.GetInvestmentIncome)).AddScope('institution_usage', MakeScopeValue(GetPlayer.GetInstitutionInvestmentBureaucracyCost)).AddScope('administration_actual', MakeScopeValue(GetPlayer.MakeScope.ScriptValue('te_budget_administration_actual'))).AddScope('institution_levels', MakeScopeValue(GetPlayer.MakeScope.ScriptValue('te_budget_institution_levels'))).AddScope('civil_0', MakeScopeValue(GetPlayer.PredictGovernmentWagesExpenses)).AddScope('civil_1', MakeScopeValue(GetPlayer.GetGovernmentGoodsExpenses)).AddScope('civil_2', MakeScopeValue(GetPlayer.GetGovernmentSlavesExpenses)).AddScope('construction_0', MakeScopeValue(GetPlayer.GetConstructionGoodsExpenses)).AddScope('military_0', MakeScopeValue(GetPlayer.PredictMilitaryWagesExpenses)).AddScope('military_1', MakeScopeValue(GetPlayer.GetMilitaryGoodsExpenses)).AddScope('military_2', MakeScopeValue(GetPlayer.GetMilitarySlavesExpenses)).AddScope('military_3', MakeScopeValue(GetPlayer.GetMilitaryShipConstructionGoodsExpenses)).AddScope('military_4', MakeScopeValue(GetPlayer.GetMilitaryShipMaintenanceExpenses)).AddScope('shipping_0', MakeScopeValue(GetPlayer.GetSupplyShipConstructionGoodsExpenses)).AddScope('shipping_1', MakeScopeValue(GetPlayer.GetSupplyShipMaintenanceExpenses)).AddScope('shipping_2', MakeScopeValue(GetPlayer.GetPortConnectionExpenses)).AddScope('welfare_0', MakeScopeValue(GetPlayer.GetWelfarePaymentsExpenses)).AddScope('subsidies_0', MakeScopeValue(GetPlayer.GetSubsidiesExpenses)).AddScope('subventions_0', MakeScopeValue(GetPlayer.GetSubventionsExpenses)).AddScope('government_losses_0', MakeScopeValue(GetPlayer.PredictGovernmentShareLosses)).AddScope('pacts_0', MakeScopeValue(GetPlayer.PredictDiplomaticPactsExpenses)).AddScope('treaties_0', MakeScopeValue(GetPlayer.PredictTreatyExpenses)).AddScope('interest_0', MakeScopeValue(GetPlayer.GetInterestPayment)).AddScope('banking_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_banking_add'))).AddScope('covert_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_covert_add'))).AddScope('culture_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_culture_add'))).AddScope('colonial_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_colonial_add'))).AddScope('un_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_un_add'))).AddScope('nuclear_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_nuclear_add'))).AddScope('nuclear_taboo_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_nuclear_taboo_add'))).AddScope('space_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_space_add'))).AddScope('drugs_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_drugs_add'))).AddScope('additional_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_expenses_add')))]"
		default_header_2texts = {
			blockoverride "size" { size = { 520 44 } }
			blockoverride "text1" { text = "te_budget_chart_expense" }
			blockoverride "text2" { raw_text = "@money![TopScope.ScriptValue('te_budget_total')|D]" }
		}
		flowcontainer = {
			direction = vertical
			spacing = 8
			datacontext = "[TopScope.AddScope('institution_pool', MakeScopeValue(TopScope.ScriptValue('te_budget_institution_pool')))]"
			flowcontainer = {
				direction = vertical
				spacing = 8
				datacontext = "[TopScope.AddScope('positive_total', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_positive_total')))]"
				te_budget_expense_charts = {}
				te_budget_expense_legend = { parentanchor = hcenter datacontext = "[TopScope.AddScope('row_institution_colonial_affairs', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_colonial_affairs'))).AddScope('row_institution_health_system', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_health_system'))).AddScope('row_institution_home_affairs', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_home_affairs'))).AddScope('row_institution_migration_controls', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_migration_controls'))).AddScope('row_institution_ministry_of_commerce', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_commerce'))).AddScope('row_institution_ministry_of_consumer_protection', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_consumer_protection'))).AddScope('row_institution_ministry_of_culture', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_culture'))).AddScope('row_institution_ministry_of_foreign_affairs', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_foreign_affairs'))).AddScope('row_institution_ministry_of_intelligence_and_security', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_intelligence_and_security'))).AddScope('row_institution_ministry_of_international_aid', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_international_aid'))).AddScope('row_institution_ministry_of_labor', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_labor'))).AddScope('row_institution_ministry_of_propaganda', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_propaganda'))).AddScope('row_institution_ministry_of_refugee_affairs', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_refugee_affairs'))).AddScope('row_institution_ministry_of_religion', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_religion'))).AddScope('row_institution_ministry_of_science', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_science'))).AddScope('row_institution_ministry_of_the_environment', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_the_environment'))).AddScope('row_institution_ministry_of_thought_control', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_thought_control'))).AddScope('row_institution_ministry_of_urban_planning', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_urban_planning'))).AddScope('row_institution_ministry_of_war', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_ministry_of_war'))).AddScope('row_institution_national_bank', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_national_bank'))).AddScope('row_institution_police', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_police'))).AddScope('row_institution_schools', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_schools'))).AddScope('row_institution_social_security', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_social_security'))).AddScope('row_institution_workplace_safety', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_institution_workplace_safety'))).AddScope('row_administration', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_administration'))).AddScope('row_civil', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_civil'))).AddScope('row_construction', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_construction'))).AddScope('row_military', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_military'))).AddScope('row_shipping', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_shipping'))).AddScope('row_welfare', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_welfare'))).AddScope('row_subsidies', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_subsidies'))).AddScope('row_subventions', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_subventions'))).AddScope('row_government_losses', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_government_losses'))).AddScope('row_pacts', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_pacts'))).AddScope('row_treaties', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_treaties'))).AddScope('row_interest', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_interest'))).AddScope('row_banking', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_banking'))).AddScope('row_covert', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_covert'))).AddScope('row_culture', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_culture'))).AddScope('row_colonial', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_colonial'))).AddScope('row_un', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_un'))).AddScope('row_nuclear', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_nuclear'))).AddScope('row_nuclear_taboo', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_nuclear_taboo'))).AddScope('row_space', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_space'))).AddScope('row_drugs', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_drugs'))).AddScope('row_additional', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_additional'))).AddScope('row_other', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_other')))]" }
				textbox = {
					visible = "[EqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_expense_positive_total'), '(CFixedPoint)0')]"
					text = "te_budget_chart_no_expense"
					autoresize = yes
					parentanchor = hcenter
					using = fontsize_medium
				}
			}
		}
	}
