	type te_budget_expense_section = flowcontainer {
		direction = vertical
		spacing = 8
		ignoreinvisible = yes
		# Intermediate value scopes share the building sum, pool and denominator.
		datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('total', MakeScopeValue(GetPlayer.GetWeeklyExpenses)).AddScope('institution_usage', MakeScopeValue(GetPlayer.GetInstitutionInvestmentBureaucracyCost)).AddScope('administration_actual', MakeScopeValue(GetPlayer.MakeScope.ScriptValue('te_budget_administration_actual'))).AddScope('institution_levels', MakeScopeValue(GetPlayer.MakeScope.ScriptValue('te_budget_institution_levels'))).AddScope('civil_0', MakeScopeValue(GetPlayer.PredictGovernmentWagesExpenses)).AddScope('civil_1', MakeScopeValue(GetPlayer.GetGovernmentGoodsExpenses)).AddScope('civil_2', MakeScopeValue(GetPlayer.GetGovernmentSlavesExpenses)).AddScope('construction_0', MakeScopeValue(GetPlayer.GetConstructionGoodsExpenses)).AddScope('military_0', MakeScopeValue(GetPlayer.PredictMilitaryWagesExpenses)).AddScope('military_1', MakeScopeValue(GetPlayer.GetMilitaryGoodsExpenses)).AddScope('military_2', MakeScopeValue(GetPlayer.GetMilitarySlavesExpenses)).AddScope('military_3', MakeScopeValue(GetPlayer.GetMilitaryShipConstructionGoodsExpenses)).AddScope('military_4', MakeScopeValue(GetPlayer.GetMilitaryShipMaintenanceExpenses)).AddScope('shipping_0', MakeScopeValue(GetPlayer.GetSupplyShipConstructionGoodsExpenses)).AddScope('shipping_1', MakeScopeValue(GetPlayer.GetSupplyShipMaintenanceExpenses)).AddScope('shipping_2', MakeScopeValue(GetPlayer.GetPortConnectionExpenses)).AddScope('welfare_0', MakeScopeValue(GetPlayer.GetWelfarePaymentsExpenses)).AddScope('subsidies_0', MakeScopeValue(GetPlayer.GetSubsidiesExpenses)).AddScope('subventions_0', MakeScopeValue(GetPlayer.GetSubventionsExpenses)).AddScope('government_losses_0', MakeScopeValue(GetPlayer.PredictGovernmentShareLosses)).AddScope('pacts_0', MakeScopeValue(GetPlayer.PredictDiplomaticPactsExpenses)).AddScope('treaties_0', MakeScopeValue(GetPlayer.PredictTreatyExpenses)).AddScope('interest_0', MakeScopeValue(GetPlayer.GetInterestPayment)).AddScope('banking_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_banking_add'))).AddScope('covert_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_covert_add'))).AddScope('culture_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_culture_add'))).AddScope('colonial_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_colonial_add'))).AddScope('un_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_un_add'))).AddScope('nuclear_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_nuclear_add'))).AddScope('nuclear_taboo_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_nuclear_taboo_add'))).AddScope('space_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_space_add'))).AddScope('drugs_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_drugs_add'))).AddScope('additional_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_expenses_add')))]"
		default_header_2texts = {
			blockoverride "size" { size = { 520 44 } }
			blockoverride "text1" { text = "te_budget_chart_expense" }
			blockoverride "text2" { raw_text = "@money![GetPlayer.GetWeeklyExpenses|D]" }
		}
		flowcontainer = {
			direction = vertical
			spacing = 8
			datacontext = "[TopScope.AddScope('institution_pool', MakeScopeValue(TopScope.ScriptValue('te_budget_institution_pool')))]"
			flowcontainer = {
				direction = vertical
				spacing = 8
				datacontext = "[TopScope.AddScope('positive_total', MakeScopeValue(TopScope.ScriptValue('te_budget_expense_positive_total')))]"
				te_budget_expense_charts = {}
				te_budget_expense_legend = { parentanchor = hcenter }
				textbox = {
					visible = "[EqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_expense_positive_total'), '(CFixedPoint)0')]"
					text = "te_budget_chart_no_expense"
					autoresize = yes
					parentanchor = hcenter
					using = fontsize_medium
				}
			}
		}
	}
}
