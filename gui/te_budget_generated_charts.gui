			tooltip = "te_budget_chart_group_tt"
			blockoverride "indent" { size = { 0 1 } }
			blockoverride "label_width" { minimumsize = { 271 28 } maximumsize = { 271 -1 } }
			blockoverride "swatch" { texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_pie_republican.dds" alpha = "[Select_float(GetVariableSystem.Exists('te_budget_income_taxes_open'), '(float)0', '(float)1')]" }
			blockoverride "label" { text = "te_budget_chart_taxes" }
			blockoverride "amount" { raw_text = "@money![TopScope.ScriptValue('te_budget_income_taxes')|D]" }
