	type te_budget_income_row_taxes = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		visible = "[And(GreaterThan_CFixedPoint(TopScope.ScriptValue('te_budget_income_taxes_cached_active'), '(CFixedPoint)0'), EqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_income_taxes_cached_rank'), TopScope.ScriptValue('te_budget_row_slot')))]"
