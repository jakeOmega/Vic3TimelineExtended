	type te_budget_income_section = flowcontainer {
		direction = vertical
		spacing = 8
		ignoreinvisible = yes
		# Intermediate value scopes share the building sum, pool and denominator.
		datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('total', MakeScopeValue(Subtract_CFixedPoint(GetPlayer.PredictWeeklyIncome, GetPlayer.GetInvestmentIncome))).AddScope('income_tax', MakeScopeValue(GetPlayer.GetIncomeTaxIncome)).AddScope('poll_tax', MakeScopeValue(GetPlayer.GetPollTaxIncome)).AddScope('consumption_tax', MakeScopeValue(GetPlayer.PredictConsumptionTaxes)).AddScope('dividends_tax', MakeScopeValue(GetPlayer.PredictDividendsTaxes)).AddScope('tariffs', MakeScopeValue(GetPlayer.PredictTariffs)).AddScope('minting', MakeScopeValue(GetPlayer.PredictMinting)).AddScope('government_dividends', MakeScopeValue(GetPlayer.PredictGovernmentShareDividends)).AddScope('pacts', MakeScopeValue(GetPlayer.PredictDiplomaticPactsIncome)).AddScope('treaties', MakeScopeValue(GetPlayer.PredictTreatyIncome)).AddScope('un', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_income_un_add'))).AddScope('reserve', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_income_reserve_add'))).AddScope('war_tax', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_income_war_tax_add'))).AddScope('tax_code', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_income_tax_code_add'))).AddScope('additional', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_tax_income_add')))]"
		default_header_2texts = {
			blockoverride "size" { size = { 520 44 } }
			blockoverride "text1" { text = "te_budget_chart_income" }
			blockoverride "text2" { raw_text = "@money![TopScope.ScriptValue('te_budget_total')|D]" }
		}
		flowcontainer = {
			direction = vertical
			spacing = 8
			datacontext = "[TopScope.AddScope('positive_total', MakeScopeValue(TopScope.ScriptValue('te_budget_income_positive_total')))]"
			te_budget_income_charts = {}
			te_budget_income_legend = { parentanchor = hcenter datacontext = "[TopScope.AddScope('row_income_tax', MakeScopeValue(TopScope.ScriptValue('te_budget_income_income_tax'))).AddScope('row_poll_tax', MakeScopeValue(TopScope.ScriptValue('te_budget_income_poll_tax'))).AddScope('row_consumption_tax', MakeScopeValue(TopScope.ScriptValue('te_budget_income_consumption_tax'))).AddScope('row_dividends_tax', MakeScopeValue(TopScope.ScriptValue('te_budget_income_dividends_tax'))).AddScope('row_tariffs', MakeScopeValue(TopScope.ScriptValue('te_budget_income_tariffs'))).AddScope('row_minting', MakeScopeValue(TopScope.ScriptValue('te_budget_income_minting'))).AddScope('row_government_dividends', MakeScopeValue(TopScope.ScriptValue('te_budget_income_government_dividends'))).AddScope('row_pacts', MakeScopeValue(TopScope.ScriptValue('te_budget_income_pacts'))).AddScope('row_treaties', MakeScopeValue(TopScope.ScriptValue('te_budget_income_treaties'))).AddScope('row_un', MakeScopeValue(TopScope.ScriptValue('te_budget_income_un'))).AddScope('row_reserve', MakeScopeValue(TopScope.ScriptValue('te_budget_income_reserve'))).AddScope('row_war_tax', MakeScopeValue(TopScope.ScriptValue('te_budget_income_war_tax'))).AddScope('row_tax_code', MakeScopeValue(TopScope.ScriptValue('te_budget_income_tax_code'))).AddScope('row_additional', MakeScopeValue(TopScope.ScriptValue('te_budget_income_additional'))).AddScope('row_other', MakeScopeValue(TopScope.ScriptValue('te_budget_income_other')))]" }
			textbox = {
				visible = "[EqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_income_positive_total'), '(CFixedPoint)0')]"
				text = "te_budget_chart_no_income"
				autoresize = yes
				parentanchor = hcenter
				using = fontsize_medium
			}
		}
	}
