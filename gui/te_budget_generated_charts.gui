	type te_budget_expense_section = flowcontainer {
		direction = vertical
		spacing = 4
		ignoreinvisible = yes
		# GUI-local expansion flags, then cached amounts/ranks/positive totals.
		datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('total', MakeScopeValue(Subtract_CFixedPoint(GetPlayer.GetWeeklyExpenses, GetPlayer.GetInvestmentIncome))).AddScope('private_construction', MakeScopeValue(GetPlayer.GetInvestmentIncome)).AddScope('institution_usage', MakeScopeValue(GetPlayer.GetInstitutionInvestmentBureaucracyCost)).AddScope('administration_actual', MakeScopeValue(GetPlayer.MakeScope.ScriptValue('te_budget_administration_actual'))).AddScope('institution_levels', MakeScopeValue(GetPlayer.MakeScope.ScriptValue('te_budget_institution_levels'))).AddScope('army_support_actual', MakeScopeValue(GetPlayer.MakeScope.ScriptValue('te_budget_army_support_actual'))).AddScope('navy_support_actual', MakeScopeValue(GetPlayer.MakeScope.ScriptValue('te_budget_navy_support_actual'))).AddScope('civil_0', MakeScopeValue(GetPlayer.PredictGovernmentWagesExpenses)).AddScope('civil_1', MakeScopeValue(GetPlayer.GetGovernmentGoodsExpenses)).AddScope('civil_2', MakeScopeValue(GetPlayer.GetGovernmentSlavesExpenses)).AddScope('construction_0', MakeScopeValue(GetPlayer.GetConstructionGoodsExpenses)).AddScope('military_0', MakeScopeValue(GetPlayer.PredictMilitaryWagesExpenses)).AddScope('military_1', MakeScopeValue(GetPlayer.GetMilitaryGoodsExpenses)).AddScope('military_2', MakeScopeValue(GetPlayer.GetMilitarySlavesExpenses)).AddScope('military_3', MakeScopeValue(GetPlayer.GetMilitaryShipConstructionGoodsExpenses)).AddScope('military_4', MakeScopeValue(GetPlayer.GetMilitaryShipMaintenanceExpenses)).AddScope('shipping_0', MakeScopeValue(GetPlayer.GetSupplyShipConstructionGoodsExpenses)).AddScope('shipping_1', MakeScopeValue(GetPlayer.GetSupplyShipMaintenanceExpenses)).AddScope('shipping_2', MakeScopeValue(GetPlayer.GetPortConnectionExpenses)).AddScope('welfare_0', MakeScopeValue(GetPlayer.GetWelfarePaymentsExpenses)).AddScope('subsidies_0', MakeScopeValue(GetPlayer.GetSubsidiesExpenses)).AddScope('subventions_0', MakeScopeValue(GetPlayer.GetSubventionsExpenses)).AddScope('government_losses_0', MakeScopeValue(GetPlayer.PredictGovernmentShareLosses)).AddScope('pacts_0', MakeScopeValue(GetPlayer.PredictDiplomaticPactsExpenses)).AddScope('treaties_0', MakeScopeValue(GetPlayer.PredictTreatyExpenses)).AddScope('interest_0', MakeScopeValue(GetPlayer.GetInterestPayment)).AddScope('banking_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_banking_add'))).AddScope('covert_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_covert_add'))).AddScope('culture_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_culture_add'))).AddScope('colonial_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_colonial_add'))).AddScope('un_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_un_add'))).AddScope('nuclear_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_nuclear_add'))).AddScope('nuclear_taboo_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_nuclear_taboo_add'))).AddScope('space_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_space_add'))).AddScope('drugs_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_expense_drugs_add'))).AddScope('additional_0', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_expenses_add'))).AddScope('army_total', MakeScopeValue(GetPlayer.PredictTotalArmyExpenses)).AddScope('navy_total', MakeScopeValue(GetPlayer.PredictTotalNavyExpenses)).AddScope('army_goods', MakeScopeValue(GetPlayer.GetArmyGoodsExpenses)).AddScope('navy_goods', MakeScopeValue(GetPlayer.GetNavyGoodsExpenses)).AddScope('open_administration_group', MakeScopeValue(Select_CFixedPoint(GetVariableSystem.Exists('te_budget_expense_administration_group_open'), '(CFixedPoint)1', '(CFixedPoint)0'))).AddScope('open_military', MakeScopeValue(Select_CFixedPoint(GetVariableSystem.Exists('te_budget_expense_military_open'), '(CFixedPoint)1', '(CFixedPoint)0'))).AddScope('open_army', MakeScopeValue(Select_CFixedPoint(GetVariableSystem.Exists('te_budget_expense_army_open'), '(CFixedPoint)1', '(CFixedPoint)0'))).AddScope('open_navy', MakeScopeValue(Select_CFixedPoint(GetVariableSystem.Exists('te_budget_expense_navy_open'), '(CFixedPoint)1', '(CFixedPoint)0'))).AddScope('open_shipping', MakeScopeValue(Select_CFixedPoint(GetVariableSystem.Exists('te_budget_expense_shipping_open'), '(CFixedPoint)1', '(CFixedPoint)0'))).AddScope('open_programmes', MakeScopeValue(Select_CFixedPoint(GetVariableSystem.Exists('te_budget_expense_programmes_open'), '(CFixedPoint)1', '(CFixedPoint)0'))).AddScope('open_diplomacy', MakeScopeValue(Select_CFixedPoint(GetVariableSystem.Exists('te_budget_expense_diplomacy_open'), '(CFixedPoint)1', '(CFixedPoint)0')))]"
		default_header_2texts = {
			blockoverride "size" { size = { 520 44 } }
			blockoverride "text1" { text = "te_budget_chart_expense" }
			blockoverride "text2" { raw_text = "@money![TopScope.ScriptValue('te_budget_total')|D]" }
		}
		flowcontainer = {
			direction = vertical
			datacontext = "[TopScope.AddScope('institution_pool', MakeScopeValue(TopScope.ScriptValue('te_budget_institution_pool')))]"
			flowcontainer = {
				direction = vertical
