			blockoverride "share" { raw_text = "[TopScope.ScriptValue('te_budget_income_additional_share')|%1]" }
		}
		te_budget_chart_row = {
			visible = "[NotEqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_income_other'), '(CFixedPoint)0')]"
			tooltip = "te_budget_chart_row_tt"
			blockoverride "swatch" { texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_pie_republican.dds" }
			blockoverride "label" { text = "te_budget_chart_other_income" }
			blockoverride "amount" { raw_text = "@money![TopScope.ScriptValue('te_budget_income_other')|D]" }
			blockoverride "share" { raw_text = "[TopScope.ScriptValue('te_budget_income_other_share')|%1]" }
		}
	}
	type te_budget_income_section = flowcontainer {
		direction = vertical
		spacing = 8
		ignoreinvisible = yes
		# Intermediate value scopes share the building sum, pool and denominator.
		datacontext = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('total', MakeScopeValue(GetPlayer.PredictWeeklyIncome)).AddScope('income_tax', MakeScopeValue(GetPlayer.GetIncomeTaxIncome)).AddScope('poll_tax', MakeScopeValue(GetPlayer.GetPollTaxIncome)).AddScope('consumption_tax', MakeScopeValue(GetPlayer.PredictConsumptionTaxes)).AddScope('dividends_tax', MakeScopeValue(GetPlayer.PredictDividendsTaxes)).AddScope('tariffs', MakeScopeValue(GetPlayer.PredictTariffs)).AddScope('minting', MakeScopeValue(GetPlayer.PredictMinting)).AddScope('government_dividends', MakeScopeValue(GetPlayer.PredictGovernmentShareDividends)).AddScope('investment', MakeScopeValue(GetPlayer.GetInvestmentIncome)).AddScope('pacts', MakeScopeValue(GetPlayer.PredictDiplomaticPactsIncome)).AddScope('treaties', MakeScopeValue(GetPlayer.PredictTreatyIncome)).AddScope('un', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_income_un_add'))).AddScope('reserve', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_income_reserve_add'))).AddScope('war_tax', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_income_war_tax_add'))).AddScope('tax_code', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_te_budget_income_tax_code_add'))).AddScope('additional', MakeScopeValue(GetPlayer.GetModifier.GetValueFor('country_tax_income_add')))]"
		default_header_2texts = {
			blockoverride "size" { size = { 520 44 } }
			blockoverride "text1" { text = "te_budget_chart_income" }
			blockoverride "text2" { raw_text = "@money![GetPlayer.PredictWeeklyIncome|D]" }
		}
		flowcontainer = {
			direction = vertical
			spacing = 8
			datacontext = "[TopScope.AddScope('positive_total', MakeScopeValue(TopScope.ScriptValue('te_budget_income_positive_total')))]"
			te_budget_income_charts = {}
			te_budget_income_legend = { parentanchor = hcenter }
			textbox = {
				visible = "[EqualTo_CFixedPoint(TopScope.ScriptValue('te_budget_income_positive_total'), '(CFixedPoint)0')]"
				text = "te_budget_chart_no_income"
				autoresize = yes
				parentanchor = hcenter
				using = fontsize_medium
			}
		}
	}
