	### A holding's line in the detail, shown while the firm holds it (the
	### instance gives its visible, text and hover). Later tasks add the
	### holding's yield and Trouble to its hover.
	type te_pa_detail_line = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = te_pa_fontsize_row
	}

	type te_pa_firm_holdings = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2

		te_pa_note = {
			visible = "[Not( GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('te_pa_row_holdings_count'), '(CFixedPoint)0' ) )]"
			tooltip = "te_pa_det_holdings_none_tt"
			text = "te_pa_det_holdings_none"
		}
		te_pa_detail_line = {
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.GetVariableValue('te_pa_r_cartel'), '(CFixedPoint)0' )]"
			tooltip = "te_pa_chip_cartel_tt"
			text = "te_pa_det_cartel"
		}
		te_pa_detail_line = {
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.GetVariableValue('te_pa_r_reg'), '(CFixedPoint)0' )]"
			tooltip = "te_pa_chip_reg_tt"
			text = "te_pa_det_reg"
		}
		te_pa_detail_line = {
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.GetVariableValue('te_pa_r_press'), '(CFixedPoint)0' )]"
			tooltip = "te_pa_chip_press_tt"
			text = "te_pa_det_press"
		}
		te_pa_detail_line = {
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.GetVariableValue('te_pa_r_town'), '(CFixedPoint)0' )]"
			tooltip = "te_pa_chip_town_tt"
			text = "te_pa_det_town"
		}
		te_pa_detail_line = {
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.GetVariableValue('te_pa_r_lab'), '(CFixedPoint)0' )]"
			tooltip = "te_pa_chip_lab_tt"
			text = "te_pa_det_lab"
		}
		te_pa_detail_line = {
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.GetVariableValue('te_pa_r_found'), '(CFixedPoint)0' )]"
			tooltip = "te_pa_chip_found_tt"
			text = "te_pa_det_found"
		}
	}

	type te_pa_firm_detail = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 3
		margin_top = 2

		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_det_goals_sub"
			}
		}
		te_pa_goals_table = {}

		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_det_position_sub"
			}
		}
		### The law being enacted and its stance on it, or None when nothing
		### is being enacted that the law table covers (te_pa_r_enacting_law 0).
		te_pa_line = {
			tooltip = "te_pa_det_enacting_tt"
			text = "[SelectLocalization( GreaterThan_CFixedPoint( ScriptContainer.GetVariableValue('te_pa_r_enacting_law'), '(CFixedPoint)0' ), 'te_pa_det_enacting', 'te_pa_det_enacting_none' )]"
		}
		flowcontainer = {
			direction = horizontal
			spacing = 8

			te_pa_cell = {
				tooltip = "te_pa_det_seat_tt"
				text = "[SelectLocalization( ScriptContainer.HasVariable('te_pa_r_seat'), 'te_pa_det_seat', 'te_pa_det_seat_none' )]"
			}
			te_pa_cell = {
				tooltip = "te_pa_det_share_tt"
				text = "te_pa_det_share"
			}
		}
		te_pa_line = {
			tooltip = "te_pa_det_griev_tt"
			text = "te_pa_det_griev"
		}

		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_det_holdings_sub"
			}
		}
		te_pa_firm_holdings = {}

		### Task 4: the state's actions against the firm (§§ 6.6, 8.7, 9.4), each
		### a button with its cost, go here under a subheading of their own,
		### under te_own_country_only.
	}

	type te_pa_roster_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

		te_pa_panel = {
			te_pa_heading = {
				blockoverride "heading_text" {
					text = "te_pa_roster_header"
				}
				blockoverride "heading_right" {
					tooltip = "te_pa_ov_firms_tt"
					text = "te_pa_roster_count"
				}
			}
			te_pa_note = {
				visible = "[IsDataModelEmpty( Country.MakeScope.GetList('te_pa_rows') )]"
				tooltip = "te_pa_ov_none_tt"
				text = "te_pa_roster_none"
			}
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 6
				margin_top = 4
				datamodel = "[Country.MakeScope.GetList('te_pa_rows')]"

				item = {
					te_pa_firm_row = {
						datacontext = "[Scope.GetScriptContainer]"
					}
				}
			}
		}
	}

	### Task 5: the Politics section (te_pa_politics_panel: the law being
	### enacted with the firms for and against it and their spending, campaign
	### money by party, patronage by interest group) goes here, as a type of
	### its own placed in te_pa_tab_layout and te_pa_wide_sections.
	### Task 9: the Abroad section (te_pa_abroad_panel: foreign firms'
	### concessions here, this country's firms' concessions by host) likewise.

	### ----------------------------------------------------------------------
	### The ledger (rule 1: a list of past items, collapsed; te_pa_ledger_open):
	### who did what, newest first, at most 20 lines. A line is the firm's
	### name, then what it did (te_pa_ledger_line, a predicate): "author
	### unknown" for a secret move not yet exposed (te_pa_l_known 0), "a
	### dissolved firm" once its company has gone (te_pa_l_gone, set as it is
	### cleared, or a company that no longer resolves: Company.IsValid, as
	### vanilla's treaty article tests ArticleDraft.GetCompany). The hover says
	### how long ago.
	### ----------------------------------------------------------------------
	type te_pa_ledger_row = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = te_pa_fontsize_row
		tooltip = "te_pa_ledger_row_tt"
		text = "[SelectLocalization( EqualTo_CFixedPoint( ScriptContainer.GetVariableValue('te_pa_l_known'), '(CFixedPoint)0' ), 'te_pa_ledger_row_unknown', SelectLocalization( ScriptContainer.HasVariable('te_pa_l_gone'), 'te_pa_ledger_row_gone', SelectLocalization( ScriptContainer.MakeScope.Var('te_pa_l_actor').GetCompany.IsValid, 'te_pa_ledger_row_named', 'te_pa_ledger_row_gone' ) ) )]"
	}

	type te_pa_ledger_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		section_header_button = {
			blockoverride "layout" {
				parentanchor = hcenter
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "te_pa_ledger_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_pa_ledger_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_pa_ledger_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_pa_ledger_open')]"
			}
		}

		te_pa_panel = {
			visible = "[GetVariableSystem.Exists('te_pa_ledger_open')]"

			te_pa_note = {
				visible = "[IsDataModelEmpty( Country.MakeScope.GetList('te_pa_ledger_view') )]"
				text = "te_pa_ledger_none"
			}
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 4
				margin_top = 4
				margin_bottom = 4
				datamodel = "[Country.MakeScope.GetList('te_pa_ledger_view')]"

				item = {
					te_pa_ledger_row = {
						datacontext = "[Scope.GetScriptContainer]"
					}
				}
			}
		}
	}

	### ----------------------------------------------------------------------
	### The Help page: every explanation, out of the live sections, one
	### subheading per topic. It reads nothing, so it opens from any host
	### (test_te_help_pages.py). Instanced only by te_private_actors_help_popup.
	### ----------------------------------------------------------------------
	type te_private_actors_help_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_how_sub_firms"
			}
		}
		te_pa_note = {
			text = "te_pa_how_firms"
		}
		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_how_sub_goals"
			}
		}
		te_pa_note = {
			text = "te_pa_how_goals"
		}
		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_how_sub_currencies"
			}
		}
		te_pa_note = {
			text = "te_pa_how_currencies"
		}
		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_how_sub_holdings"
			}
		}
		te_pa_note = {
			text = "te_pa_how_holdings"
		}
		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_how_sub_turn"
			}
		}
		te_pa_note = {
			text = "te_pa_how_turn"
		}
		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_how_sub_posture"
			}
		}
		te_pa_note = {
			text = "te_pa_how_posture"
		}
		te_pa_subheader = {
			blockoverride "subheader_text" {
				text = "te_pa_how_sub_rule"
			}
		}
		te_pa_note = {
			text = "te_pa_how_rule"
		}
	}

	### The Help page's popup, in te_popups (gui/te_popups.gui).
	type te_private_actors_help_popup = te_ui_help_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'help_private_actors')]"
		}
		blockoverride "popup_title" {
			text = "te_pa_how_header"
		}
		blockoverride "popup_list" {
			te_private_actors_help_body = {}
		}
	}

	### ----------------------------------------------------------------------
	### The Private Actors tab of the Timeline Extended window
	### (te_system_tab_frame, gui/te_system_tab_widgets.gui; the window mounts it
	### from gui/te_systems_window_generated.gui). No journal entry: the panels
	### read Country, the player's in the window (the frame's tab_country),
	### under the tab's gate (te_window_private_actors_tab_sgui) on a parent,
	### the header outside it, and no Open Journal Entry. te_pa_tab_layout is
	### the block a wide mount overrides.
	### ----------------------------------------------------------------------
	type te_pa_tab_body = te_system_tab_frame {
		blockoverride "tab_header" {
			default_header = {
				using = default_list_position
				blockoverride "text" {
					text = "te_pa_tab_header"
				}
				### Full screen, the page's title across the frame: the window's full-screen
				### mount fills te_tab_header_size (gen_te_systems_window.py); everywhere else
				### it is vanilla's own 554 (@panel_width_plus_14).
				blockoverride "size" {
					block "te_tab_header_size" {
						size = { 554 44 }
					}
				}
				te_help_button = {
					visible = "[Not( GetMetaPlayer.IsObserver )]"
					onclick = "[GetVariableSystem.Set('te_popup', 'help_private_actors')]"
				}
			}
		}
		blockoverride "tab_gate" {
			visible = "[GetScriptedGui('te_window_private_actors_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}
		blockoverride "tab_content" {
			block "te_pa_tab_layout" {
				te_pa_overview_panel = {}
				te_pa_roster_panel = {}
				### Task 5: te_pa_politics_panel = {} here; Task 9: te_pa_abroad_panel = {}.
				te_pa_ledger_panel = {}
			}
		}
		blockoverride "tab_open_journal" {}
	}

	### The tab full screen (spec docs/superpowers/specs/2026-11-02-te-window-wide-mode-design.md
	### § 7), te_pa_tab_layout's override in the window's full-screen frame: the
	### overview, the roster, then the ledger, one to a column of a fixed 520
	### (te_ui_columns_three), in the tab's order. The roster is the long one
	### and has its column; Task 5's Politics and Task 9's Abroad go in column 3,
	### above the ledger. The tab's gate stays on the frame's parent, and none
	### of the three hides while the tab is open, so the three columns always
	### draw.
	type te_pa_wide_sections = te_ui_columns_three {
