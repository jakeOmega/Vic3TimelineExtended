	### A trophy we hold: its name, what it was and where from, what it counts
	### for, who claims it, and Return It (or Bring It Home, when its origin is
	### ours).
	type gm_tr_row_held = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 8

			gm_tr_trophy_picture = {}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				gm_tr_line = {
					using = gm_fontsize_heading
					text = "gm_tr_row_title"
				}
				gm_tr_line = {
					text = "gm_tr_row_detail"
				}
				### Its unique dedication (signatures spec §3): the parent named on
				### its own line, what it gives on hover.
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_has_sig'), '(CFixedPoint)1' )]"
					tooltip = "gm_tr_sig_tt"
					text = "gm_tr_row_sig"
				}
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_is_landmark'), '(CFixedPoint)1' )]"
					tooltip = "gm_tr_row_landmark_tt"
					text = "gm_row_landmark"
				}
				gm_tr_line = {
					tooltip = "gm_tr_row_value_tt"
					text = "gm_tr_row_value"
				}
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_home_owned'), '(CFixedPoint)0' )]"
					text = "gm_tr_row_claimant"
				}
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_home_owned'), '(CFixedPoint)1' )]"
					text = "gm_tr_row_home"
				}
			}
		}

		gm_tr_button = {
			blockoverride "tr_button" {
				datacontext = "[GetScriptedGui('gm_tr_return_sgui')]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End )]"
				tooltip = "gm_button_tr_return_tooltip"
			}
			blockoverride "tr_button_text" {
				text = "gm_button_tr_return"
			}
		}
	}

	### A trophy taken from our lands: its name, its holder and where it
	### stands, the ways home on hover.
	type gm_tr_row_abroad = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 8

		gm_tr_trophy_picture = {}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 2

			gm_tr_line = {
				using = gm_fontsize_heading
				text = "gm_tr_row_title"
			}
			gm_tr_line = {
				text = "gm_tr_row_detail"
			}
			### Its unique dedication (signatures spec §3): the parent named on
			### its own line, what it gives on hover.
			gm_tr_line = {
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_has_sig'), '(CFixedPoint)1' )]"
				tooltip = "gm_tr_sig_tt"
				text = "gm_tr_row_sig"
			}
			gm_tr_line = {
				visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_is_landmark'), '(CFixedPoint)1' )]"
				tooltip = "gm_tr_row_landmark_tt"
				text = "gm_row_landmark"
			}
			gm_tr_line = {
				tooltip = "gm_tr_row_held_by_tt"
				text = "gm_tr_row_held_by"
			}
		}
	}

	### A trophy on display in a state, on its card, in the Full view: its name
	### and where it came from, what it counts for, and Carry It Off (Bring It
	### Home when its origin is ours) while our armies hold the state.
	type gm_tr_row_site = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 8

			gm_tr_trophy_picture = {}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				gm_tr_line = {
					using = gm_fontsize_heading
					text = "gm_tr_row_title"
				}
				gm_tr_line = {
					text = "gm_tr_row_detail"
				}
				### Its unique dedication (signatures spec §3): the parent named on
				### its own line, what it gives on hover.
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_has_sig'), '(CFixedPoint)1' )]"
					tooltip = "gm_tr_sig_tt"
					text = "gm_tr_row_sig"
				}
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_is_landmark'), '(CFixedPoint)1' )]"
					tooltip = "gm_tr_row_landmark_tt"
					text = "gm_row_landmark"
				}
				### What it counts for: its grandeur, with the effects and where
				### to view them on hover.
				gm_tr_line = {
					tooltip = "gm_tr_row_site_value_tt"
					text = "gm_tr_row_site_value"
				}
			}
		}

		gm_tr_button = {
			blockoverride "tr_button" {
				datacontext = "[GetScriptedGui('gm_tr_take_site_sgui')]"
				visible = "[And( Not( GetMetaPlayer.IsObserver ), ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End ) )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End )]"
				tooltip = "gm_button_tr_take_site_tooltip"
			}
			blockoverride "tr_button_text" {
				text = "gm_button_tr_take_site"
			}
		}
	}

	### A trophy on display in a state, in the Short view: one line, no picture.
	### Its name and what it counts for; the rest (the dedication, where it came
	### from and when, the levels, a landmark's history) on hover. Carry It Off
	### (Bring It Home) ends the line, small, while our armies hold the state.
	### 374 + 6 + 130 = 510, the card's width inside its margins: the button at
	### the row size fits "Bring It Home".
	type gm_tr_row_short = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6

		textbox = {
			autoresize = yes
			multiline = yes
			minimumsize = { 374 -1 }
			maximumsize = { 374 -1 }
			align = left|nobaseline
			using = gm_fontsize_row
			tooltip = "gm_tr_short_tt"
			text = "gm_tr_short_line"
		}

		gm_tr_button = {
			blockoverride "tr_button_layout" {
				size = { 130 26 }
				parentanchor = vcenter
			}
			blockoverride "tr_button_text_width" {
				max_width = 124
			}
			blockoverride "tr_button" {
				datacontext = "[GetScriptedGui('gm_tr_take_site_sgui')]"
				visible = "[And( Not( GetMetaPlayer.IsObserver ), ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End ) )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_tr', ScriptContainer.MakeScope ).End )]"
				tooltip = "gm_button_tr_take_site_tooltip"
			}
			blockoverride "tr_button_text" {
				text = "gm_button_tr_take_site"
			}
		}
	}

	### Trophies (open): what ours count for, the Homecoming while it runs,
	### and a row per trophy. Shown while we hold one or the Homecoming runs.
	type te_gm_sec_trophies = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_tr_disp_trophies_shown'), '(CFixedPoint)1' )]"

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_trophies_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_trophies_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_trophies_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_trophies_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_trophies_closed'))]"
			spacing = 2

			gm_text = {
				visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_tr_disp_held_count'), '(CFixedPoint)0' )]"
				tooltip = "gm_je_tr_summary_tt"
				text = "gm_je_tr_summary"
			}
			gm_value_row = {
				visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_tr_disp_boon_homecoming'), '(CFixedPoint)0' )]"
				tooltip = "gm_je_tt_boon_homecoming"
				blockoverride "row_label" {
					text = "gm_je_lbl_boon_homecoming"
				}
				blockoverride "row_value" {
					text = "gm_je_val_boon_homecoming"
				}
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				margin_top = 4
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gm_trophies_held')]"

				item = {
					gm_tr_row_held = { datacontext = "[Scope.GetScriptContainer]" }
				}
			}
		}
	}

	### Held Abroad (open): a row per trophy taken from our lands. Shown while
	### there is one.
	type te_gm_sec_abroad = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_tr_disp_abroad_count'), '(CFixedPoint)0' )]"

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_abroad_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_abroad_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_abroad_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_abroad_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_abroad_closed'))]"
			spacing = 2

			gm_text = {
				tooltip = "gm_je_abroad_ways_tt"
				text = "gm_je_abroad_summary"
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				margin_top = 4
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gm_trophies_abroad')]"

				item = {
					gm_tr_row_abroad = { datacontext = "[Scope.GetScriptContainer]" }
				}
			}
		}
	}

	### The state view's Trophies on Display card, under the monument card,
	### while trophies stand in this state (gm_state_tr_disp_here). Three views,
	### chosen by the buttons in its header and kept in the client-side
	### gm_state_tr_view (unset is Full, so a fresh session opens as before):
	###   Full       the pictured rows, with what each counts for spelled out
	###   Short      one line per trophy, no pictures, the rest on hover
	###   Collapsed  the summary line alone: how many, and what they count for
	### The summary line shows in every view but a Full one with a single trophy,
	### whose row says the same.
	type te_state_gm_trophy_card = flowcontainer {
		visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_tr_disp_here'), '(CFixedPoint)0')]"
		direction = vertical
		parentanchor = hcenter
		margin_top = 10

		container = {
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				margin = { 10 8 }
				spacing = 6
				minimumsize = { 530 -1 }

				background = {
					using = entry_bg_simple
				}

				### The header: the title, and the three views at its right.
				### 88 * 3 + 4 * 2 = 272 beside a title of about 210.
				widget = {
					size = { 510 26 }

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						align = left|nobaseline
						using = gm_fontsize_heading
						tooltip = "gm_state_tr_header_tt"
						text = "gm_state_tr_header"
					}

					flowcontainer = {
						parentanchor = right|vcenter
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4

						gm_tr_view_button = {
							tooltip = "gm_state_tr_view_full_tt"
							blockoverride "tr_view_button" {
								enabled = "[GetVariableSystem.Exists('gm_state_tr_view')]"
								onclick = "[GetVariableSystem.Clear('gm_state_tr_view')]"
							}
							blockoverride "tr_view_button_text" {
								text = "gm_state_tr_view_full"
							}
						}
						gm_tr_view_button = {
							tooltip = "gm_state_tr_view_short_tt"
							blockoverride "tr_view_button" {
								enabled = "[Not(GetVariableSystem.HasValue('gm_state_tr_view', 'short'))]"
								onclick = "[GetVariableSystem.Set('gm_state_tr_view', 'short')]"
							}
							blockoverride "tr_view_button_text" {
								text = "gm_state_tr_view_short"
							}
						}
						gm_tr_view_button = {
							tooltip = "gm_state_tr_view_collapsed_tt"
							blockoverride "tr_view_button" {
								enabled = "[Not(GetVariableSystem.HasValue('gm_state_tr_view', 'collapsed'))]"
								onclick = "[GetVariableSystem.Set('gm_state_tr_view', 'collapsed')]"
							}
							blockoverride "tr_view_button_text" {
								text = "gm_state_tr_view_collapsed"
							}
						}
					}
				}

				### How many, and what they count for together, in every view but
				### a Full one with a single trophy.
				textbox = {
					visible = "[Or( GetVariableSystem.Exists('gm_state_tr_view'), GreaterThan_CFixedPoint( State.MakeScope.ScriptValue('gm_state_tr_disp_here'), '(CFixedPoint)1' ) )]"
					autoresize = yes
					multiline = yes
					maximumsize = { 510 -1 }
					align = left|nobaseline
					using = gm_fontsize_row
					tooltip = "gm_state_tr_summary_tt"
					text = "gm_state_tr_summary"
				}

				### Full: unset is Full.
				flowcontainer = {
					visible = "[Not(GetVariableSystem.Exists('gm_state_tr_view'))]"
					direction = vertical
					ignoreinvisible = yes
					spacing = 8
					datamodel = "[State.MakeScope.GetList('gm_trophies_here')]"

					item = {
						gm_tr_row_site = { datacontext = "[Scope.GetScriptContainer]" }
					}
				}

				### Short: a line each.
				flowcontainer = {
					visible = "[GetVariableSystem.HasValue('gm_state_tr_view', 'short')]"
					direction = vertical
					ignoreinvisible = yes
					spacing = 4
					datamodel = "[State.MakeScope.GetList('gm_trophies_here')]"

					item = {
						gm_tr_row_short = { datacontext = "[Scope.GetScriptContainer]" }
					}
				}
			}
		}
	}

	### Carry It Off, for one secondary monument's row: shown while the player
	### occupies its state in a war (gm_mon_take_sgui, gm_monument_sguis.txt).
	### Its monument is the row's container.
	type gm_mon_take_button = button {
		using = default_button_action
		size = { 200 28 }
		parentanchor = hcenter
		margin_top = 2
		datacontext = "[GetScriptedGui('gm_mon_take_sgui')]"
		visible = "[And( Not( GetMetaPlayer.IsObserver ), ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_mon', ScriptContainer.MakeScope ).End ) )]"
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_mon', ScriptContainer.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_mon', ScriptContainer.MakeScope ).End )]"
		tooltip = "gm_mon_take_button_tooltip"

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 190
			elide = right
			using = gm_fontsize_row
			text = "gm_button_tr_take"
		}
	}

	### A choice on a monument beside another, in the journal entry's row
	### (gm_mon_tear_down_sgui and its siblings), its monument as gm_mon: the
	### shape of the journal entry's gm_choice_button.
	type gm_mon_choice_button = button {
		using = default_button_action
		size = { 156 28 }
		margin_top = 2

		block "choice_context" {}

		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_mon', ScriptContainer.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_mon', ScriptContainer.MakeScope ).End )]"

		block "choice_tooltip" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 150
			elide = right
			using = gm_fontsize_row
			block "choice_text" {}
		}
	}

	### A monument standing beside the state's primary, on the Also Standing
	### Here card: the picture, name, form and dedication of what came home,
	### what it adds to the building, and Carry It Off while our armies hold
	### the state. It is a trophy's container still (gm_tr_*), so the trophy
	### row's picture, title and landmark line serve it.
	type gm_mon_row_site = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 8

			gm_tr_picture = {}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				gm_tr_line = {
					using = gm_fontsize_heading
					text = "gm_tr_row_title"
				}
				gm_tr_line = {
					text = "gm_mon_row_detail"
				}
				### Its unique dedication (signatures spec §3): the parent named on
				### its own line, what it gives on hover.
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_has_sig'), '(CFixedPoint)1' )]"
					tooltip = "gm_tr_sig_tt"
					text = "gm_tr_row_sig"
				}
				### Its status (ageing spec 2026-10-16 §4.3), a code each.
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_mon_status_code'), '(CFixedPoint)2' )]"
					tooltip = "gm_je_status_upheld_tt"
					text = "gm_mon_row_status_upheld"
				}
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_mon_status_code'), '(CFixedPoint)3' )]"
					tooltip = "gm_je_status_heritage_tt"
					text = "gm_mon_row_status_heritage"
				}
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_mon_status_code'), '(CFixedPoint)4' )]"
					tooltip = "gm_je_status_contested_tt"
					text = "gm_mon_row_status_contested"
				}
				gm_tr_line = {
					visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_is_landmark'), '(CFixedPoint)1' )]"
					tooltip = "gm_tr_row_landmark_tt"
					text = "gm_row_landmark"
				}
				### Its grandeur: its levels and its years, with how the
				### building sums the levels on hover.
				gm_tr_line = {
					tooltip = "gm_mon_row_value_tt"
					text = "gm_mon_row_value"
				}
				### Where it stands, for the journal entry's list (the state
				### card is in that state already): the instance's override.
				block "mon_where" {}
			}
		}

		gm_mon_take_button = {}
		### The journal entry's rows: a contested one's choices.
		block "mon_choices" {}
	}

	### The monuments that stand beside a state's own, a section of the state
	### view's monument card (te_state_gm_card, te_state_panel_widgets.gui), under
	### its picture and details and across its width, while a secondary monument
	### stands in this state (gm_state_mon_disp_here). The card above it is the
	### state's whole (the building, at every monument's levels together) and its
	### primary; each monument beside the primary has a row here.
	type te_state_gm_beside = flowcontainer {
		visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_mon_disp_here'), '(CFixedPoint)0')]"
		direction = vertical
		ignoreinvisible = yes
		spacing = 6

		textbox = {
			autoresize = yes
			align = left|nobaseline
			using = gm_fontsize_heading
			tooltip = "gm_state_mon_header_tt"
			text = "gm_state_mon_header"
		}

		### How many, and what they add to the building together.
		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 510 -1 }
			align = left|nobaseline
			using = gm_fontsize_row
			text = "gm_state_mon_summary"
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 8
			datamodel = "[State.MakeScope.GetList('gm_monuments_here')]"

			item = {
				gm_mon_row_site = { datacontext = "[Scope.GetScriptContainer]" }
			}
		}
	}
}
