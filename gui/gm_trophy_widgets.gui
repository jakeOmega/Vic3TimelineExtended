### Grand Monument trophies (docs/superpowers/archive/specs/2026-10-12-grand-monument-
### trophies-design.md §6). Types only, composed elsewhere:
###   te_gm_sec_trophies, te_gm_sec_abroad   the journal entry's Trophies and
###     Held Abroad sections, in te_gm_status_sections
###     (journal_entry_widgets/grand_monuments_widget.gui) after Our Monuments
###   gm_tr_take_button                      Carry It Off, under a monument's
###     row there and on its state card (te_state_panel_widgets.gui)
###   te_state_gm_trophy_card                the state view's Trophies on
###     Display card (states_panel.gui), under the monument card
###   gm_mon_take_button, gm_mon_row_site,   a secondary monument's Carry It Off,
###   te_state_gm_beside                     its row, and the section of the state
###     view's monument card (te_state_panel_widgets.gui) that lists the
###     monuments standing beside the state's primary
###     (docs/superpowers/archive/specs/2026-10-13-multiple-monuments-per-state-design.md §5)
### A trophy is a script container (gm_trophy_effects.txt): its rows come from
### the country's gm_trophies_held / gm_trophies_abroad and the state's
### gm_trophies_here lists, rebuilt by the monthly pass, each item under
### datacontext = "[Scope.GetScriptContainer]". It names itself through the
### container custom localization in gm_trophy_custom_loc.txt, and shows the
### picture of the monument it was taken from (gm_tr_picture), with its own
### over it where one is drawn (gm_tr_trophy_picture).
###
### EDITING RULES (as grand_monuments_widget.gui's)
### * Numbers come from ScriptValue reads: the country's gm_tr_disp_* and the
###   container's gm_tr_disp_* (gm_trophy_values.txt), every one guarded.
### * Buttons pass the row's state as gm_state or its trophy as gm_tr, and are
###   shown by their scripted GUI's is_shown (gm_trophy_sguis.txt). The
###   buttons on the state card check Not( GetMetaPlayer.IsObserver ) first:
###   an observer has no GetPlayer, and the is_shown logs a null-country
###   error every frame the card draws (log triage 2026-10-25).
### * The collapse flags say their default: *_closed sections are open until
###   closed (test_grand_monuments_layout.py).

types gm_trophy_widget_types
{
	### A line of a trophy row, beside its picture (96 + 8 + 376 = 480), at the
	### panel's row size (gm_fontsize_row, grand_monuments_widget.gui).
	type gm_tr_line = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 376 -1 }
		maximumsize = { 376 -1 }
		align = left|nobaseline
		using = gm_fontsize_row
	}

	### A trophy row's or card's button: its scripted GUI and label from the
	### instance, its trophy as gm_tr. The size, anchor and label width are
	### blocks with a default body: the short line overrides them to sit at the
	### end of a line.
	type gm_tr_button = button {
		using = default_button_action
		block "tr_button_layout" {
			size = { 200 28 }
			parentanchor = hcenter
			margin_top = 2
		}

		block "tr_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			block "tr_button_text_width" {
				max_width = 190
			}
			elide = right
			using = gm_fontsize_row
			block "tr_button_text" {}
		}
	}

	### One of the Trophies on Display card's three views (Full, Short,
	### Collapsed). The instance sets the label, the tooltip, `enabled` (off for
	### the view showing now) and the click, which sets the client-side
	### gm_state_tr_view (unset is Full).
	type gm_tr_view_button = button {
		using = default_button_action
		size = { 88 24 }
		parentanchor = vcenter

		block "tr_view_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			using = gm_fontsize_row
			block "tr_view_button_text" {}
		}
	}

	### Carry It Off, for the row's or card's monument: shown while the player
	### could take it (occupied in a war, or our own unincorporated state
	### holding a monument we did not raise).
	type gm_tr_take_button = button {
		using = default_button_action
		size = { 200 28 }
		parentanchor = hcenter
		margin_top = 4
		datacontext = "[GetScriptedGui('gm_tr_take_sgui')]"
		visible = "[And( Not( GetMetaPlayer.IsObserver ), ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End ) )]"
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End )]"
		tooltip = "gm_button_tr_take_tooltip"

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 190
			elide = right
			using = gm_fontsize_row
			text = "gm_button_tr_take"
		}
	}

	### The picture of the monument a trophy was taken from, a piece's too:
	### gm_picture's icons (grand_monuments_widget.gui), one per picture code,
	### shown on the trophy's gm_tr_disp_picture_code (gm_tr_update_picture).
	### No grandeur frame: that marks a standing monument's steps. 96 px, as in
	### Our Monuments.
	type gm_tr_picture = widget {
		size = { 96 96 }

		icon = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_tr_disp_picture_code'), '(CFixedPoint)1' )]"
