# The Budget panel's always-available Breakdown tab. The generated chart
# library owns category order, amounts and colours; this file owns layout.

# The tab's type sizes (GUI audit BNK-20, 2026-10-27), the house ladder the
# Banking tab beside it uses (gui_style_guide.md rule 3): rows, amounts and
# notes at 17, the How section's subheadings at 20. Templates are global, so
# the generated rows in te_budget_generated_charts.gui read nothing here but
# the row type below. test_budget_breakdown.WidthBudgetTest reads both sizes.
template te_budget_fontsize_row {
	fontsize = 17
}

template te_budget_fontsize_heading {
	fontsize = 20
}

types te_budget_breakdown {
	### One row of a chart's list: an indent by depth, the expand arrow of a
	### group, the swatch, the label, the weekly amount and the share. 500
	### wide (5 + 18 + 5 + 12 + 5 + 291 + 5 + 94 + 5 + 60 = 500 at depth 0),
	### so a label of about 30 characters fits on one line at 17; a longer one
	### wraps. A row whose hover is on its amount (a vanilla graph template,
	### gen_budget_breakdown.TOOLTIP_TEMPLATES) carries no row tooltip.
	type te_budget_chart_row = flowcontainer {
		direction = horizontal
		spacing = 5
		minimumsize = { 500 28 }
		maximumsize = { 500 -1 }
		widget = { block "indent" { size = { 0 1 } } }
		widget = { size = { 18 28 } parentanchor = vcenter block "toggle" {} }
		icon = {
			size = { 12 12 }
			parentanchor = vcenter
			framesize = { 128 128 }
			frame = 2
			block "swatch" {}
		}
		textbox = {
			block "label_width" { minimumsize = { 291 28 } maximumsize = { 291 -1 } }
			autoresize = yes
			multiline = yes
			align = left|vcenter|nobaseline
			using = te_budget_fontsize_row
			block "label" {}
		}
		textbox = {
			size = { 94 28 }
			parentanchor = vcenter
			align = right|vcenter|nobaseline
			using = te_budget_fontsize_row
			block "amount" {}
		}
		textbox = {
			size = { 60 28 }
			parentanchor = vcenter
			align = right|vcenter|nobaseline
			using = te_budget_fontsize_row
			block "share" {}
		}
	}

	### A topic's heading in How the Breakdown Works, with a faint rule under
	### it: Banking's banking_dash_subheader, at this tab's 480.
	type te_budget_how_subheader = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		block "subheader_margin" {
			margin_top = 6
		}

		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 480 -1 }
			align = left|nobaseline
			using = te_budget_fontsize_heading
			default_format = "#title"
			block "subheader_text" {}
		}
		divider_clean = {
			blockoverride "size" {
				size = { 480 2 }
			}
		}
	}

	### A topic's note: Banking's banking_dash_note, at this tab's 480.
	type te_budget_how_note = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = te_budget_fontsize_row
		default_format = "#lore"
	}

	### How the Breakdown Works: a link at the foot of the tab to the Help page
	### (style guide rule 1; spec 2026-11-02-charts-help-national-info § 5.2).
	### Its header alone, which opens te_budget_breakdown_help_popup (te_popup =
	### help_budget_breakdown) instead of expanding. Lifted out of
	### te_budget_breakdown_panel so the full-screen layout can place it (spec
	### 2026-11-02-te-window-wide-mode § 7). The tab has no header, so no "?".
	type te_budget_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }
		spacing = 8
		ignoreinvisible = yes

		section_header_button = {
			tooltip = "te_help_link_tt"
			blockoverride "layout" { parentanchor = hcenter size = { 520 38 } }
			blockoverride "left_text" { text = "te_budget_chart_how" }
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Set('te_popup', 'help_budget_breakdown')]"
			}
			blockoverride "onclick_showmore" {
				visible = no
			}
			blockoverride "onclick_showless" {
				visible = no
			}
		}
	}

	### The Help page: every explanation, gathered out of the live sections, one
	### subheading per topic. The live sections say what is happening; this says
	### how it works. It reads no country at all, so it opens from any host
	### (test_te_help_pages.py). Instanced only by
	### te_budget_breakdown_help_popup. Its loc is gen_budget_breakdown.py's
	### HOW_TOPICS.
	type te_budget_breakdown_help_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		### One subheading per topic (GUI audit BNK-20): the topics are the
		### generator's HOW_TOPICS, in its order.
		te_budget_how_subheader = {
			blockoverride "subheader_margin" {}
			blockoverride "subheader_text" {
				text = "te_budget_chart_how_sub_admin"
			}
		}
		te_budget_how_note = {
			text = "te_budget_chart_how_admin"
		}
		te_budget_how_subheader = {
			blockoverride "subheader_text" {
				text = "te_budget_chart_how_sub_civil"
			}
		}
		te_budget_how_note = {
			text = "te_budget_chart_how_civil"
		}
		te_budget_how_subheader = {
			blockoverride "subheader_text" {
				text = "te_budget_chart_how_sub_military"
			}
		}
		te_budget_how_note = {
			text = "te_budget_chart_how_military"
		}
		te_budget_how_subheader = {
			blockoverride "subheader_text" {
				text = "te_budget_chart_how_sub_journal"
			}
		}
		te_budget_how_note = {
			text = "te_budget_chart_how_journal"
		}
		te_budget_how_subheader = {
			blockoverride "subheader_text" {
				text = "te_budget_chart_how_sub_charts"
			}
		}
		te_budget_how_note = {
			text = "te_budget_chart_how_charts"
		}
	}

	### The Help page's popup, in te_popups (gui/te_popups.gui).
	type te_budget_breakdown_help_popup = te_ui_help_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'help_budget_breakdown')]"
		}
		blockoverride "popup_title" {
			text = "te_budget_chart_how"
		}
		blockoverride "popup_list" {
			te_budget_breakdown_help_body = {}
		}
	}

	type te_budget_breakdown_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }
		spacing = 8
		ignoreinvisible = yes

		te_budget_income_section = {}
		te_budget_expense_section = {}
		te_budget_sec_how = {}
	}

	### The Timeline Extended window's Budget Breakdown full screen (spec
	### docs/superpowers/specs/2026-11-02-te-window-wide-mode-design.md § 7):
	### the panel's three sections side by side, each in a column of a fixed
	### 520. The window mounts it in place of the panel, whose root carries no
	### gate: its fixed 520 is the columns', and its spacing has nothing to
	### separate with one section to a column.
	type te_budget_breakdown_wide_sections = te_ui_columns_three {
		blockoverride "column_1" {
			te_budget_income_section = {}
		}

		blockoverride "column_2" {
			te_budget_expense_section = {}
		}

		blockoverride "column_3" {
			te_budget_sec_how = {}
		}
	}
}
