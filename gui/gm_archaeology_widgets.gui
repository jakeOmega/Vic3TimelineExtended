### Grand Monument archaeology (docs/superpowers/archive/specs/2026-10-14-grand-monument-
### archaeology-design.md, issue #939). Types only, composed elsewhere:
###   te_gm_sec_archaeology   the journal entry's Archaeological Expeditions
###     section, in te_gm_status_sections
###     (journal_entry_widgets/grand_monuments_widget.gui) after the opportunity
### A site is a script container (gm_archaeology_effects.txt): its rows come from
### the country's gm_arch_digging and gm_arch_available lists, rebuilt by the
### monthly pass and after every order, each item under
### datacontext = "[Scope.GetScriptContainer]". It names itself through the
### container custom localization in gm_trophy_custom_loc.txt
### (gm_tr_landmark_name), which a site shares with a trophy's records.
###
### EDITING RULES (as grand_monuments_widget.gui's)
### * Numbers come from ScriptValue reads: the country's gm_arch_disp_* and the
###   container's (gm_archaeology_values.txt), every one guarded.
### * Buttons pass the row's site as gm_arch, and are shown by their scripted
###   GUI's is_shown (gm_archaeology_sguis.txt).
### * The collapse flag says its default: *_closed sections are open until
###   closed.
### * Type sizes are the panel's templates (gm_fontsize_*,
###   grand_monuments_widget.gui).

types gm_archaeology_widget_types
{
	### A line of a site's row, the panel's width.
	type gm_arch_line = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = gm_fontsize_row
	}

	### A row's button: its scripted GUI, tooltip and label from the instance,
	### its site as gm_arch. Three of these fit a row (3 x 150 + 2 x 8 = 466).
	type gm_arch_button = button {
		using = default_button_action
		size = { 150 28 }
		margin_top = 2

		block "arch_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 140
			elide = right
			using = gm_fontsize_row
			block "arch_button_text" {}
		}
	}

	### A site we may dig: its name, what it raises, the terms if we would dig
	### it abroad, what is done if a dig was suspended, and a launch button for
	### each method whose technology we have.
	type gm_arch_row_open = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2

		gm_arch_line = {
			using = gm_fontsize_heading
			text = "gm_arch_row_title"
		}
		gm_arch_line = {
			text = "gm_arch_row_open_detail"
		}
		### Abroad: decided for the viewer (gm_arch_abroad_*_sgui), the row
		### being shared by every country that may dig the site.
		gm_arch_line = {
			visible = "[GetScriptedGui('gm_arch_abroad_concession_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
			text = "gm_arch_row_abroad_concession"
			tooltip = "gm_arch_row_abroad_concession_tt"
		}
		gm_arch_line = {
			visible = "[GetScriptedGui('gm_arch_abroad_permit_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
			text = "gm_arch_row_abroad_permit"
			tooltip = "gm_arch_row_abroad_permit_tt"
		}
		gm_arch_line = {
			visible = "[GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_arch_disp_progress'), '(CFixedPoint)0' )]"
			text = "gm_arch_row_resume"
		}
		gm_arch_line = {
			tooltip = "gm_tr_row_landmark_tt"
			text = "gm_row_landmark"
		}

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 8
			margin_top = 2

			gm_arch_button = {
				blockoverride "arch_button" {
					datacontext = "[GetScriptedGui('gm_arch_launch_antiquarian_sgui')]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					tooltip = "gm_arch_launch_antiquarian_tooltip"
				}
				blockoverride "arch_button_text" {
					text = "gm_arch_launch_antiquarian"
				}
			}
			gm_arch_button = {
				blockoverride "arch_button" {
					datacontext = "[GetScriptedGui('gm_arch_launch_systematic_sgui')]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					tooltip = "gm_arch_launch_systematic_tooltip"
				}
				blockoverride "arch_button_text" {
					text = "gm_arch_launch_systematic"
				}
			}
			gm_arch_button = {
				blockoverride "arch_button" {
					datacontext = "[GetScriptedGui('gm_arch_launch_forensic_sgui')]"
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
					tooltip = "gm_arch_launch_forensic_tooltip"
				}
				blockoverride "arch_button_text" {
					text = "gm_arch_launch_forensic"
				}
			}
		}
	}

	### A dig we run: its name, its method, how far it has come, what it costs,
	### the terms if it is abroad, and Suspend.
	type gm_arch_row_digging = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2

		gm_arch_line = {
			using = gm_fontsize_heading
			text = "gm_arch_row_title"
		}
		gm_arch_line = {
			text = "gm_arch_row_dig_detail"
		}
		gm_arch_line = {
			text = "gm_arch_row_dig_innovation"
		}
		gm_arch_line = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_arch_disp_terms'), '(CFixedPoint)1' )]"
			text = "gm_arch_row_dig_concession"
			tooltip = "gm_arch_row_abroad_concession_tt"
		}
		gm_arch_line = {
			visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_arch_disp_terms'), '(CFixedPoint)2' )]"
			text = "gm_arch_row_dig_permit"
			tooltip = "gm_arch_row_abroad_permit_tt"
		}
		gm_arch_line = {
			tooltip = "gm_tr_row_landmark_tt"
			text = "gm_row_landmark"
		}

		gm_arch_button = {
			blockoverride "arch_button" {
				datacontext = "[GetScriptedGui('gm_arch_suspend_sgui')]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_arch', ScriptContainer.MakeScope ).End )]"
				tooltip = "gm_arch_suspend_tooltip"
			}
			blockoverride "arch_button_text" {
				text = "gm_arch_suspend"
			}
		}
	}

	### Archaeological Expeditions (open): shown while a dig runs or a site
	### waits for us. Digs first, then the sites open to us, each list under a
	### heading shown while it has a row (GM-14); how digs work is How Grand
	### Monuments Work's Archaeology.
	type te_gm_sec_archaeology = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_arch_disp_shown'), '(CFixedPoint)1' )]"

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_archaeology_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_arch_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_arch_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_arch_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_arch_closed'))]"
			spacing = 2

			gm_text = {
				tooltip = "gm_je_arch_summary_tt"
				text = "gm_je_arch_summary"
			}
			gm_text = {
				visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_arch_disp_dig_count'), '(CFixedPoint)0' )]"
				tooltip = "gm_je_arch_costs_tt"
				text = "gm_je_arch_costs"
			}

			gm_subheader = {
				visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_arch_disp_dig_count'), '(CFixedPoint)0' )]"
				blockoverride "subheader_text" {
					text = "gm_je_arch_sub_digs"
				}
			}
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				margin_top = 4
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gm_arch_digging')]"

				item = {
					gm_arch_row_digging = { datacontext = "[Scope.GetScriptContainer]" }
				}
			}

			gm_subheader = {
				visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_arch_disp_open_count'), '(CFixedPoint)0' )]"
				blockoverride "subheader_text" {
					text = "gm_je_arch_sub_open"
				}
			}
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				margin_top = 4
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gm_arch_available')]"

				item = {
					gm_arch_row_open = { datacontext = "[Scope.GetScriptContainer]" }
				}
			}
		}
	}
}
