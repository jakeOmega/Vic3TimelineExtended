right_click_menu = {
	name = "add_consumption_tax_menu"

	parentanchor = top|right
	widgetanchor = top|left

	blockoverride "title_text" {
		text = "ADD_CONSUMPTION_TAX"
	}

	blockoverride "items" {
		datamodel = "[BudgetPanel.AccessTaxableGoods]"

		item = {
			right_click_menu_item = {
				blockoverride "properties" {
					onclick = "[Execute( Goods.ToggleTaxation(GetPlayer) )]"
					### MOD: Tax Code: greyed while the legislated tax code sets the taxed goods (te_tax_native_goods_controls_sgui).
					# vanilla: enabled = "[IsValid( Goods.ToggleTaxation(GetPlayer) )]"
					enabled = "[And( GetScriptedGui('te_tax_native_goods_controls_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), IsValid( Goods.ToggleTaxation(GetPlayer) ) )]" # REVIEWED 2026-10-27 (missing_reason): never greyed by the code in practice: the Budget panel's + that opens this menu is greyed by the same gate, and its tooltip gives the Tax Code's reason (TAX-11)
					### END MOD ###
					tooltip = "[Goods.GetTaxDesc(GetPlayer)]"


					icon = {
						size = { 40 40 }
						alwaystransparent = yes
						parentanchor = vcenter
						position = { 5 0 }
					}
				}

				blockoverride "margin" {
					margin_left = 55
				}

				blockoverride "texture" {
					texture = "[Goods.GetTexture]"
				}
			
				blockoverride = "text" {
					text = "ADD_CONSUMPTION_TAX_ENTRY"
				}

				blockoverride "right_text" {
					expand = {}
					textbox = {
						margin_right = 10
						align = right|nobaseline
						autoresize = yes
						text = "ADD_CONSUMPTION_TAX_ENTRY_COST"
					}
				}
			}
		}
	}
}
