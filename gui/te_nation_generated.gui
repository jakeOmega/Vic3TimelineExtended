				visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_nation_type_country_colonial_stability_drift_add_count'), '(CFixedPoint)0' )]"
				text = "te_nation_type_country_colonial_stability_drift_add"
				tooltip = "te_nation_type_country_colonial_stability_drift_add_tt"
			}
		}
	}
}
