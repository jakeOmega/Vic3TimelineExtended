types te_nation_generated_types
{
	### The governance section's type rows (TYPE_ROWS, STATUS_ROWS).
	type te_nation_types_governance = flowcontainer {
		visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_nation_types_governance_count'), '(CFixedPoint)0' )]"
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		flowcontainer = {
			visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_nation_group_authority_count'), '(CFixedPoint)0' )]"
			direction = vertical
			ignoreinvisible = yes
			spacing = 4

			te_nation_subheader = {
				blockoverride "subheader_text" {
					text = "te_nation_grp_authority"
				}
			}
			te_nation_row = {
				visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_nation_type_country_authority_add_count'), '(CFixedPoint)0' )]"
				text = "te_nation_type_country_authority_add"
				tooltip = "te_nation_type_country_authority_add_tt"
			}
			te_nation_row = {
				visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_nation_type_country_authority_mult_count'), '(CFixedPoint)0' )]"
				text = "te_nation_type_country_authority_mult"
				tooltip = "te_nation_type_country_authority_mult_tt"
			}
			te_nation_row = {
				visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_nation_type_country_authority_cost_add_count'), '(CFixedPoint)0' )]"
				text = "te_nation_type_country_authority_cost_add"
				tooltip = "te_nation_type_country_authority_cost_add_tt"
			}
			te_nation_row = {
				visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_nation_type_country_bureaucracy_mult_count'), '(CFixedPoint)0' )]"
				text = "te_nation_type_country_bureaucracy_mult"
				tooltip = "te_nation_type_country_bureaucracy_mult_tt"
			}
			te_nation_row = {
				visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_nation_type_country_institution_cost_institution_health_system_mult_count'), '(CFixedPoint)0' )]"
				text = "te_nation_type_country_institution_cost_institution_health_system_mult"
				tooltip = "te_nation_type_country_institution_cost_institution_health_system_mult_tt"
			}
			te_nation_row = {
