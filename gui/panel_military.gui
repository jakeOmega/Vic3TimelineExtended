# TE override of vanilla panel_military.gui (1.15.0): vanilla's file plus the Nuclear and Covert tabs
# (### MOD blocks) and the mobilization option groups one a row (datamodel_wrap = 1, commented there).
# Re-diff against the installed file on every vanilla patch (docs/guides/vanilla_patch_runbook.md § 5).
# COPY-PASTED FOR NOW
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

types panel_military {
	type tab_army = top_illu {
		size = { @panel_width_plus_20 180 }

		background = {
			block "illu" {
				texture = "gfx/interface/illustrations/top_illus/top_illu_army.dds"
			}
			using = top_illu_properties
		}

		vbox = {
			parentanchor = hcenter
			margin_top = 10
			margin_bottom = 20

			hbox = {
				visible = "[InformationPanel.IsTabSelected('army')]"
				layoutpolicy_horizontal = expanding
				margin = { 10 15 }

				# Cost
				vbox = {
					layoutpolicy_vertical = expanding
					tooltip = "ARMY_TOTAL_EXPENSE_BREAKDOWN"

					textbox = {
						autoresize = yes
						default_format = "#title"
						text = "EXPENSES"
						margin_bottom = 10
					}

					hbox = {
						textbox = {
							raw_text = "@money![Negate_CFixedPoint(Country.PredictTotalArmyExpenses)|D+]"
							autoresize = yes
							align = left|nobaseline
							using = fontsize_mega
						}
					}

					widget = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding
					}
				}

				# Battalions
				vbox = {
					layoutpolicy_vertical = expanding
					tooltip = "PANEL_MILITARY_ARMY_OVERVIEW_TOOLTIP"

					textbox = {
						autoresize = yes
						margin_bottom = 10
						default_format = "#title"
						text = "REGULARS_AND_CONSCRIPTS"
					}

					hbox = {
						spacing = 30

						### ARMY / FORCELIMIT
						textbox = {
							raw_text = "@battalions![Country.GetRegularBattalions|v]"
							autoresize = yes
							align = left|nobaseline
							using = fontsize_mega
						}

						### ARMY / FORCELIMIT
						textbox = {
							raw_text = "@conscripts!#v [Country.CalcConscriptableBattalions]"
							autoresize = yes
							align = left|nobaseline
							using = fontsize_mega
						}
					}

					widget = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding
					}
				}
			}

			big_mobilize_all_button = {}
		}

	}

	type tab_navy = top_illu {
		size = { @panel_width_plus_20 150 }

		background = {
			texture = "gfx/interface/illustrations/top_illus/top_illu_navy.dds"
			using = top_illu_properties
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 20 4 }

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 20

				military_panel_ship_info = {}

				military_panel_ship_info = {
					blockoverride "tooltip" {
						tooltip = "NAVY_TOTAL_EXPENSE_BREAKDOWN"
					}

					blockoverride "first_text" {
						raw_text = "@money![Negate_CFixedPoint(Country.PredictTotalNavyExpenses)|D+]"
					}

					blockoverride "second_text" {
						text = "EXPENSES"
					}
				}

				military_panel_sailors_info = {}
			}

			divider_clean = {
				blockoverride "size" {
					layoutpolicy_horizontal = expanding
					size = { 0 2 }
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding

				widget = {
					layoutpolicy_horizontal = expanding
					size = { 0 28 }

					supply_network_information_small = {
						parentanchor = vcenter
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					size = { 0 40 }

					supply_route_filter_row = {
						parentanchor = vcenter
					}
				}
			}
		}
	}

	type supply_network_information_small = flowcontainer {
		spacing = 8
		alwaystransparent = no
		max_update_rate = 8
		onmousehierarchyenter = "[AccessHighlightManager.HighlightSupplyNetwork(Country.Self)]"
		onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
		tooltip = "SUPPLY_NETWORK_STRENGTH_TOOLTIP"

		textbox = {
			parentanchor = vcenter
			max_width = 200
			autoresize = yes
			align = nobaseline
			using = elide_fontsize_min
			text = "SUPPLY_NETWORK_STRENGTH_TEXT"
		}

		textbox = {
			parentanchor = vcenter
			max_width = 50
			autoresize = yes
			align = nobaseline
			using = elide_fontsize_min
			text = "SUPPLY_NETWORK_STRENGTH_VALUE"
		}
	}

	type supply_route_filter_row = flowcontainer {
		spacing = 6

		textbox = {
			parentanchor = vcenter
			max_width = 110
			autoresize = yes
			align = nobaseline
			margin_right = 12
			using = elide_fontsize_min
			text = "SUPPLY_ROUTE_FILTERS_LABEL"
		}

		supply_route_filter_checkbox = {
			blockoverride "button" {
				onclick = "[ToggleOwnSupplyRoutes]"
				tooltip = "SHOW_OWN_SUPPLY_ROUTES_TOOLTIP"
			}

			blockoverride "icon_texture" {
				texture = "gfx/interface/navy/supply_line_filter_own.dds"
			}

			blockoverride "highlight_visibility" {
				visible = "[IsShowingOwnSupplyRoutes]"
			}
		}

		supply_route_filter_checkbox = {
			blockoverride "button" {
				onclick = "[ToggleAlliedSupplyRoutes]"
				tooltip = "SHOW_ALLIED_SUPPLY_ROUTES_TOOLTIP"
			}

			blockoverride "icon_texture" {
				texture = "gfx/interface/navy/supply_line_filter_allies.dds"
			}

			blockoverride "highlight_visibility" {
				visible = "[IsShowingAlliedSupplyRoutes]"
			}
		}

		supply_route_filter_checkbox = {
			blockoverride "button" {
				onclick = "[ToggleEnemySupplyRoutes]"
				tooltip = "SHOW_ENEMY_SUPPLY_ROUTES_TOOLTIP"
			}

			blockoverride "icon_texture" {
				texture = "gfx/interface/navy/supply_line_filter_enemy.dds"
			}

			blockoverride "highlight_visibility" {
				visible = "[IsShowingEnemySupplyRoutes]"
			}
		}
	}

	### SUPPLY ROUTE FILTER CHECKBOX
	type supply_route_filter_checkbox = flowcontainer {

		button = {
			size = { 40 40 }
			using = default_button
			using = tooltip_se

			block "button" {}

			icon = {
				size = { 70% 70% }
				parentanchor = center

				block "icon_texture" {}
			}

			icon = {
				block "highlight_visibility" {}
				using = highlighted_square_selection
			}
		}
	}

	type military_panel_ship_info = flowcontainer {
		direction = vertical
		spacing = 2

		block "tooltip" {
			tooltipwidget = {
				RegularTooltip_CountryShips = {}
			}
		}

		textbox = {
			autoresize = yes
			align = nobaseline
			margin_left = 5

			block "second_text" {
				text = "TOTAL_SHIPS"
			}
		}

		widget = {
			size = { 100 26 }

			background = {
				using = entry_bg_simple
				alpha = 0.5
			}

			background = {
				using = dark_area
			}

			textbox = {
				autoresize = yes
				align = nobaseline
				using = fontsize_large
				parentanchor = vcenter
				margin_left = 5
				max_width = 90
				using = elide_fontsize_min

				block "first_text" {
					text = "PANEL_MILITARY_NAVY_CURRENT_SHIPS"
				}
			}
		}

	}

	type military_panel_sailors_info = flowcontainer {
		direction = vertical
		spacing = 2
		tooltip = "COUNTRY_SAILORS_TOOLTIP"

		textbox = {
			autoresize = yes
			align = nobaseline
			margin_left = 5
			text = "COUNTRY_SAILORS_LABEL"
		}

		widget = {
			size = { 280 26 }
			max_update_rate = 8

			changed_value_increased_progressbar_horizontal = {
				visible = "[And(Country.HasSailorDeficit, Country.IsGainingSailors)]"
				size = { 100% 100% }

				blockoverride "values" {
					value = "[FixedPointToFloat(Country.GetSailorSufficiency)]"
					min = 0
					max = 1
				}
			}

			bad_progressbar_horizontal = {
				visible = "[And(Country.HasSailorDeficit, Not(Country.IsGainingSailors))]"
				size = { 100% 100% }

				blockoverride "values" {
					value = "[FixedPointToFloat(Country.GetSailorSufficiency)]"
					min = 0
					max = 1
				}
			}

			default_progressbar_horizontal = {
				visible = "[Not(Country.HasSailorDeficit)]"
				size = { 100% 100% }

				blockoverride "values" {
					value = "[FixedPointToFloat(Country.GetSailorSufficiency)]"
					min = 0
					max = 1
				}
			}

			textbox = {
				autoresize = yes
				align = nobaseline
				using = fontsize_large
				parentanchor = vcenter
				margin_left = 5
				max_width = 270
				using = elide_fontsize_min
				text = "COUNTRY_SAILORS_VALUE"
			}
		}
	}

	### MOBILIZATION CONTROLS
	type mobilization_icon = widget {
		visible = no
		size = { 22 22 }

		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/backgrounds/round_button_bg.dds"
		}
		icon = {
			size = { 100% 100% }
			framesize = { 120 120 }
			texture = "gfx/interface/icons/generic_icons/mobilize_icon.dds"
			block "frame" {
				frame = 0
			}
		}
	}

	type icon_with_background_big = widget {
		size = { 60 60 }

		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/backgrounds/round_button_bg.dds"
		}

		icon = {
			parentanchor = center
			framesize = { 120 120 }

			block "icon_size" {
				size = { 100% 100% }
			}

			block "texture" {
				texture = "gfx/interface/icons/generic_icons/mobilize_icon.dds"
			}

			block "frame" {
				frame = 0
			}
		}
	}

	type conscription_icon_big = widget {
		size = { 60 60 }

		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/backgrounds/round_button_bg.dds"
		}

		icon = {
			parentanchor = center
			framesize = { 120 120 }
			size = { 70% 70% }
			texture = "gfx/interface/icons/lens_toolbar_icons/activate_conscription_centers_lens_option.dds"
		}
	}

	type mobilization_controls = widget {
		size = { 535 60 }

		icon = {
			texture = "gfx/interface/animation/smoke.dds"
			size = { 560 180 }
			parentanchor = bottom|hcenter
			position = { 0 60 }
			alpha = 0

			modify_texture = {
				name = mask_01
				texture = "gfx/interface/animation/smoke.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply

				translate_uv = { 0 0 }
			}

			modify_texture = {
				name = mask_02
				texture = "gfx/interface/animation/smoke.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply

				translate_uv = { 0 -0.5 }
			}

			state = {
				name = mobilization_effect
				next = 2
				duration = 0.8
				alpha = 1

				modify_texture = {
					name = mask_01
					translate_uv = { 0 0.4 }
				}
				modify_texture = {
					name = mask_02
					translate_uv = { 0 0 }
				}
			}

			state = {
				name = 2
				next = reset
				duration = 2.5
				using = Animation_Curve_EaseOut
				alpha = 0

				modify_texture = {
					name = mask_01
					translate_uv = { 0 0.8 }
				}
				modify_texture = {
					name = mask_02
					translate_uv = { 0 1 }
				}
			}

			state = {
				name = reset

				modify_texture = {
					name = mask_01
					translate_uv = { 0 0 }
				}
				modify_texture = {
					name = mask_02
					translate_uv = { 0 -0.5 }
				}
			}
		}

		margin_widget = {
			parentanchor = center
			margin = { 0 6 }
			size = { 0 50 }
			alpha = 0

			state = {
				name = mobilization_effect
				next = effect2
				size = { 530 50 }
				duration = 0.2
				alpha = 0.5
				using = Animation_Curve_Default
			}
			state = {
				name = effect2
				next = reset
				size = { 530 50 }
				duration = 0.4
				alpha = 0
				using = Animation_Curve_Default
			}
			state = {
				name = reset
				size = { 0 50 }
			}

			icon = {
				size = { 50% 100% }
				texture = "gfx/interface/animation/mobilize_effect.dds"
			}
			icon = {
				parentanchor = right
				mirror = horizontal
				size = { 50% 100% }
				texture = "gfx/interface/animation/mobilize_effect.dds"
			}

			icon = {
				parentanchor = hcenter
				size = { 60% 100% }
				texture = "gfx/interface/animation/mobilize_effect2.dds"
				alpha = 0.5
			}
		}

		icon_with_background_big = {
			parentanchor = vcenter
			enabled = "[IsValid( MilitaryFormation.Mobilize )]"
		}
	}

	type military_panel_army_content = flowcontainer {
		direction = vertical

		state = {
			name = "_show"

			start_sound = {
				soundeffect = "event:/SFX/UI/SideBar/military"
			}
		}

		tab_army = {
			visible = "[Country.IsCommittedInDiplomaticPlay]"
		}

		tab_army = {
			visible = "[Not(Country.IsCommittedInDiplomaticPlay)]"
			size = { @panel_width_plus_20 120 }
		}

		default_header = {
			using = default_list_position

			blockoverride "text" {
				text = "MILITARY_FORMATIONS_ARMY_HEADER"
			}
		}

		widget = { size = { 1 5 }}

		military_formation_list = {}

		widget = { size = { 1 5 }}
	}

	type military_panel_navy_content = flowcontainer {
		direction = vertical

		state = {
			name = "_show"
			using = fleet_panel_open
		}

		tab_navy = {}

		textbox = {
			margin_top = 10
			margin_bottom = 20
			parentanchor = hcenter
			autoresize = yes
			maximumsize = { @panel_width -1 }
			minimumsize = { @panel_width -1 }
			multiline = yes
			#visible = "[Not(StringIsEmpty(Country.GetSeaNodesMightBeConvoyRaidedInDesc))]"
			visible = no # todo PRCAL-32539 - Remove this textbox and implement the dynamicgridbox specified in the Jira.
			text = "[Country.GetSeaNodesMightBeConvoyRaidedInDesc]"
		}

		default_header = {
			using = default_list_position

			blockoverride "text" {
				text = "MILITARY_FORMATIONS_FLEET_HEADER"
			}
		}

		flowcontainer = {
			visible = "[Not(IsDataModelEmpty(Country.GetShipList.GetShipTypesWithShipsOrNewBuilds))]"
			parentanchor = hcenter
			direction = vertical
			datacontext = "[Country.GetShipList]"

			background = {
				using = dropdown_background
				margin = { 0 -2 }
			}

			section_header_button = {
				blockoverride "left_text" {
					text = "FILTERS"
				}

				blockoverride "right_text" {
					section_header_right_text = {
						visible = "[Not(ShipList.HasShipTypeFilter)]"
						text = "ALL"
					}

					flowcontainer = {
						visible = "[ShipList.HasShipTypeFilter]"
						margin_right = 20
						spacing = 10

						flowcontainer = {
							spacing = 5
							datamodel = "[DataModelFirst(ShipList.GetShipTypeFilters, '(int32)3')]"

							item = {
								flowcontainer = {
									parentanchor = vcenter
									spacing = 5

									vertical_divider_full = {
										visible = "[NotEqualTo_int32(PdxGuiWidget.AccessParent.GetIndexInDataModel, '(int32)0')]"
										parentanchor = vcenter
									}

									textbox = {
										parentanchor = vcenter
										max_width = 120
										autoresize = yes
										align = nobaseline
										alwaystransparent = yes
										default_format = "#v"
										using = elide_fontsize_min
										text = "[ShipType.GetNameNoFormatting]"
									}
								}
							}
						}

						textbox = {
							visible = "[GreaterThan_int32(GetDataModelSize(ShipList.GetShipTypeFilters), '(int32)3')]"
							autoresize = yes
							align = nobaseline
							alwaystransparent = yes
							raw_text = "#v [GetDataModelSize(DataModelSkipFirst(ShipList.GetShipTypeFilters, '(int32)3'))|=]#!"
						}
					}
				}

				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle( 'navy_ship_type_filters_collapsed' )]"
				}

				blockoverride "onclick_showmore" {
					visible = "[GetVariableSystem.Exists( 'navy_ship_type_filters_collapsed' )]"
				}

				blockoverride "onclick_showless" {
					visible = "[Not(GetVariableSystem.Exists( 'navy_ship_type_filters_collapsed' ))]"
				}
			}

			flowcontainer = {
				visible = "[Not(GetVariableSystem.Exists( 'navy_ship_type_filters_collapsed' ))]"
				minimumsize = { @panel_width 40 }
				parentanchor = hcenter
				spacing = 2
				margin = { 2 10 }
				margin_top = 5

				textbox = {
					size = { 102 40 }
					margin = { 8 8 }
					align = nobaseline
					alpha = 0.5
					using = elide_fontsize_min
					text = "FILTER_SHIP_TYPE"
				}

				country_ship_types = {
					blockoverride "wrap_count" {
						wrap_count = 4
					}

					blockoverride "ship_types_datamodel" {
						datamodel = "[ShipList.GetShipTypesWithShipsOrNewBuilds]"
					}

					blockoverride "ship_type_size" {
						size = { 105 40 }
					}

					blockoverride "filter_tooltip" {
						tooltip = "COMPACT_SHIP_TYPE_FILTER_TOOLTIP"
					}

					blockoverride "filter_ship_number" {
						text = "COMPACT_SHIP_TYPE_NUMBER"
					}

					blockoverride "background_visibility" {
						visible = no
					}

					blockoverride "filter_button_visibility" {}

					blockoverride "filter_onclick" {
						onclick = "[ShipList.ToggleShipTypeFilter(ShipType.Self)]"
					}

					blockoverride "filter_highlight_visibility" {
						visible = "[ShipList.IsShipTypeFilterSelected(ShipType.Self)]"
					}
				}
			}
		}

		widget = { size = { 1 5 }}

		empty_state = {
			blockoverride "visible" {
				visible = "[And(Country.GetShipList.HasShipTypeFilter, IsDataModelEmpty(Country.GetShipList.GetFleetsFilteredByShipType))]"
			}

			blockoverride "text" {
				text = "NO_FLEETS_WITH_SELECTED_SHIP_TYPES"
			}
		}

		military_formation_list = {
			blockoverride "datamodel" {
				datamodel = "[Country.GetShipList.GetFleetsFilteredByShipType]"
			}
		}

		widget = { size = { 1 10 }}
	}

	type panel_military = default_block_window {
		name = "panel_military"
		datacontext = "[PanelMilitary.AccessCountry]"

		blockoverride "window_header_name"
		{
			text = "MILITARY_PANEL"
		}

		blockoverride "map_modes_button" {
			map_modes_single_button_minimized = {
				datacontext = "[PanelMilitary.GetMapModeList]"
				using = map_modes_button_position
			}
		}

		blockoverride "fixed_top"
		{
			tab_buttons = {
				# Army
				blockoverride "first_button" {
					text = "MILITARY_PANEL_TAB_ARMY"
				}
				blockoverride "first_button_tooltip" {
					tooltip = "MILITARY_PANEL_TAB_ARMY"
				}
				blockoverride "first_button_click" {
					onclick = "[InformationPanel.SelectTab('army')]"
				}
				blockoverride "first_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('army')]"
				}
				blockoverride "first_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('army') )]"
				}
				blockoverride "first_button_selected" {
					text = "MILITARY_PANEL_TAB_ARMY_SELECTED"
				}

				# Mobilization
				blockoverride "second_button" {
					text = "MILITARY_FORMATION_PANEL_MOBILIZATION_TAB"
				}
				blockoverride "second_button_tooltip" {
					tooltip = "MILITARY_FORMATION_PANEL_MOBILIZATION_TAB"
				}
				blockoverride "second_button_click" {
					onclick = "[InformationPanel.SelectTab('mobilization')]"
				}
				blockoverride "second_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('mobilization')]"
				}
				blockoverride "second_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('mobilization') )]"
				}
				blockoverride "second_button_selected" {
					text = "MILITARY_FORMATION_PANEL_MOBILIZATION_TAB_SELECTED"
				}

				# Navy
				blockoverride "third_button" {
					text = "MILITARY_PANEL_TAB_NAVY"
				}
				blockoverride "third_button_tooltip" {
					tooltip = "MILITARY_PANEL_TAB_NAVY"
				}
				blockoverride "third_button_click" {
					onclick = "[InformationPanel.SelectTab('navy')]"
				}
				blockoverride "third_button_visibility" {
					visible = "[InformationPanel.IsTabSelected('navy')]"
				}
				blockoverride "third_button_visibility_checked" {
					visible = "[Not( InformationPanel.IsTabSelected('navy') )]"
				}
				blockoverride "third_button_selected" {
					text = "MILITARY_PANEL_TAB_NAVY_SELECTED"
				}

				### MOD: Nuclear tab (te_nuclear) ###
				# A fourth tab showing the nuclear journal entry's own panels (the
				# content block at the foot of scrollarea_content). On the strip
				# whenever the nuclear rule is on (te_military_nuclear_tab_unlock_sgui),
				# greyed until the entry runs (te_military_nuclear_tab_sgui); the greyed
				# tab's tooltip lists the unlock conditions with a tick or a cross.
				# tab_buttons defaults both halves of an unused slot to `visible = no`,
				# so each visibility block tests the gate as well as the tab. Gates:
				# common/scripted_guis/te_system_tab_sguis.txt. No icon: system tabs
				# carry none, as vanilla's don't (gui_style_guide.md rule 9).
				# An observer has no GetPlayer, so each visibility block checks
				# Not( GetMetaPlayer.IsObserver ) first: the gate's is_shown otherwise
				# logs a null-country error every frame (gui_modding_guide.md).
				blockoverride "fourth_button" {
					text = "te_military_tab_nuclear"
				}
				blockoverride "fourth_button_tooltip" {
					tooltip = "[SelectLocalization( GetScriptedGui('te_military_nuclear_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_military_tab_nuclear_tt', SelectLocalization( GetScriptedGui('te_military_nuclear_tab_unlock_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'te_military_tab_nuclear_locked_tt' ), GetScriptedGui('te_military_nuclear_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) )]"
				}
				blockoverride "fourth_button_click" {
					enabled = "[GetScriptedGui('te_military_nuclear_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[InformationPanel.SelectTab('te_nuclear')]"
				}
				blockoverride "fourth_button_visibility" {
					visible = "[And( Not( GetMetaPlayer.IsObserver ), And( InformationPanel.IsTabSelected('te_nuclear'), GetScriptedGui('te_military_nuclear_tab_unlock_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
				}
				blockoverride "fourth_button_visibility_checked" {
					visible = "[And( Not( GetMetaPlayer.IsObserver ), And( Not( InformationPanel.IsTabSelected('te_nuclear') ), GetScriptedGui('te_military_nuclear_tab_unlock_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
				}
				blockoverride "fourth_button_selected" {
					text = "te_military_tab_nuclear"
				}
				### END MOD ###

				### MOD: Covert tab (te_covert) ###
				# A fifth tab showing the covert journal entry's own panels (the
				# content block at the foot of scrollarea_content), a copy of the
				# Nuclear tab above. On the strip whenever the covert rule is on
				# (te_military_covert_tab_unlock_sgui), greyed until the entry runs
				# (te_military_covert_tab_sgui); the greyed tab's tooltip lists the
				# unlock test with a tick or a cross. Gates:
				# common/scripted_guis/te_system_tab_sguis.txt. No icon, as for
				# Nuclear (gui_style_guide.md rule 9).
				# Not( GetMetaPlayer.IsObserver ) first in each visibility block, as
				# for Nuclear: an observer has no GetPlayer.
				blockoverride "fifth_button" {
					text = "te_military_tab_covert"
				}
				blockoverride "fifth_button_tooltip" {
					tooltip = "[SelectLocalization( GetScriptedGui('te_military_covert_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_military_tab_covert_tt', SelectLocalization( GetScriptedGui('te_military_covert_tab_unlock_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'te_military_tab_covert_locked_tt' ), GetScriptedGui('te_military_covert_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) )]"
				}
				blockoverride "fifth_button_click" {
					enabled = "[GetScriptedGui('te_military_covert_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[InformationPanel.SelectTab('te_covert')]"
				}
				blockoverride "fifth_button_visibility" {
					visible = "[And( Not( GetMetaPlayer.IsObserver ), And( InformationPanel.IsTabSelected('te_covert'), GetScriptedGui('te_military_covert_tab_unlock_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
				}
				blockoverride "fifth_button_visibility_checked" {
					visible = "[And( Not( GetMetaPlayer.IsObserver ), And( Not( InformationPanel.IsTabSelected('te_covert') ), GetScriptedGui('te_military_covert_tab_unlock_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
				}
				blockoverride "fifth_button_selected" {
					text = "te_military_tab_covert"
				}
				### END MOD ###
			}
		}

		blockoverride "scrollarea_content" {
			flowcontainer = {
				using = default_list_position
				direction = vertical

				military_panel_army_content = {
					visible = "[InformationPanel.IsTabSelected('army')]"
					using = default_fade_in_out
				}

				military_panel_navy_content = {
					visible = "[InformationPanel.IsTabSelected('navy')]"
					using = default_fade_in_out
				}

				flowcontainer = {
					visible = "[InformationPanel.IsTabSelected('mobilization')]"
					direction = vertical

					flowcontainer = {
						direction = vertical
						spacing = 5
						parentanchor = hcenter
						datamodel = "[Country.GetMilitaryFormationsArmy]"
						margin_top = 10
						margin_bottom = 5

						item = {
							mobilization_widget = {}
						}
					}
				}

				### MOD: Nuclear tab (te_nuclear) ###
				# The tab's content is te_nuclear_tab_body
				# (gui/journal_entry_widgets/nuclear_layout_widget.gui), which the
				# Timeline Extended window's Nuclear Weapons tab mounts too: the
				# header, the entry's panels under the tab's gate, and the link back
				# to the entry. This flowcontainer keeps what is the panel's own: the
				# tab's selection, its fade, its position and its margins.
				flowcontainer = {
					name = "te_military_nuclear_tab"
					visible = "[InformationPanel.IsTabSelected('te_nuclear')]"
					using = default_fade_in_out
					parentanchor = hcenter
					direction = vertical
					spacing = 10
					margin_top = 10
					margin_bottom = 15

					te_nuclear_tab_body = {}
				}
				### END MOD ###

				### MOD: Covert tab (te_covert) ###
				# The tab's content is te_covert_tab_body
				# (gui/journal_entry_widgets/covert_operations_widget.gui), which the
				# Timeline Extended window's Covert Warfare tab mounts too: the
				# header, the entry's panels under the tab's gate, and the link back
				# to the entry. This flowcontainer keeps what is the panel's own: the
				# tab's selection, its fade, its position and its margins.
				flowcontainer = {
					name = "te_military_covert_tab"
					visible = "[InformationPanel.IsTabSelected('te_covert')]"
					using = default_fade_in_out
					parentanchor = hcenter
					direction = vertical
					spacing = 10
					margin_top = 10
					margin_bottom = 15

					te_covert_tab_body = {}
				}
				### END MOD ###
			}
		}

		blockoverride "fixed_bottom" {

			flowcontainer = {
				visible = "[Or(InformationPanel.IsTabSelected('army'), InformationPanel.IsTabSelected('navy'))]"
				direction = vertical
				spacing = 5

				divider_clean = {
					size = { @panel_width_plus_14 4 }
				}

				background = {
					using = dark_area
				}

				widget = {
					size = { 1 1 }
				}

				flowcontainer = {
					parentanchor = hcenter
					spacing = 5

					button = {
						visible = "[InformationPanel.IsTabSelected('navy')]"
						using = default_button
						parentanchor = vcenter
						size = { 255 50 }
						enabled = "[LessThan_int32(GetPlayer.GetNumUnassignedAdmirals, GetPlayer.GetMaxUnassignedAdmirals)]"
						onclick = "[PopupManager.ToggleRecruitAdmiral]"
						tooltip = "[SelectLocalization(LessThan_int32(GetPlayer.GetNumUnassignedAdmirals, GetPlayer.GetMaxUnassignedAdmirals), 'MILITARY_FORMATION_RECRUIT_ADMIRAL', 'MILITARY_FORMATION_RECRUIT_ADMIRAL_LIMIT')]"
						using = tooltip_ne

						textbox = {
							parentanchor = center
							autoresize = yes
							align = nobaseline
							using = fontsize_large
							using = elide_fontsize_min
							max_width = 250
							text = "RECRUIT_ADMIRAL_BUTTON"
						}
					}

					button = {
						visible = "[And(InformationPanel.IsTabSelected('navy'), HasDlcFeature('ship_designer'))]"
						size = { 255 50 }
						parentanchor = vcenter
						using = default_button
						onclick = "[PopupManager.ToggleShipDesignerPopup]"
						onclick = "[RightClickMenuManager.Close]"
						tooltip = "SHIP_DESIGNER_CREATE_NEW_TEMPLATE"

						textbox = {
							parentanchor = center
							autoresize = yes
							align = nobaseline
							using = fontsize_large
							using = elide_fontsize_min
							max_width = 250
							text = "ADD_NEW_TEMPLATE"
						}
					}
				}

				button = {
					visible = "[InformationPanel.IsTabSelected('navy')]"
					using = default_button_map_interaction
					parentanchor = hcenter
					size = { 520 50 }
					using = default_content_fade
					tooltip = "CREATE_FLEET_FORMATION_TOOLTIP"
					onclick = "[PanelMilitary.OnClickRecruitFleetFormation]"

					textbox = {
						parentanchor = center
						autoresize = yes
						using = fontsize_large
						align = nobaseline
						using = elide_fontsize_min
						max_width = 500
						text = "CREATE_FLEET_FORMATION"
					}
				}

				flowcontainer = {
					parentanchor = hcenter
					spacing = 5

					button = {
						visible = "[InformationPanel.IsTabSelected('army')]"
						using = default_button
						parentanchor = vcenter
						size = { 255 50 }
						enabled = "[LessThan_int32(GetPlayer.GetNumUnassignedGenerals, GetPlayer.GetMaxUnassignedGenerals)]"
						onclick = "[PopupManager.ToggleRecruitGeneral]"
						tooltip = "[SelectLocalization(LessThan_int32(GetPlayer.GetNumUnassignedGenerals, GetPlayer.GetMaxUnassignedGenerals), 'MILITARY_FORMATION_RECRUIT_GENERAL', 'MILITARY_FORMATION_RECRUIT_GENERAL_LIMIT')]"
						using = tooltip_ne

						textbox = {
							parentanchor = center
							autoresize = yes
							align = nobaseline
							using = fontsize_large
							using = elide_fontsize_min
							max_width = 250
							text = "RECRUIT_GENERAL_BUTTON"
						}
					}

					### CREATE FORMATIONS
					button = {
						visible = "[InformationPanel.IsTabSelected('army')]"
						name = "tutorial_highlight_create_army"
						using = default_button_map_interaction
						parentanchor = vcenter
						size = { 255 50 }
						using = default_content_fade
						tooltip = "CREATE_ARMY_FORMATION_TOOLTIP"
						onclick = "[PanelMilitary.OnClickRecruitArmyFormation]"

						textbox = {
							parentanchor = center
							autoresize = yes
							using = fontsize_large
							align = nobaseline
							using = elide_fontsize_min
							max_width = 250
							text = "CREATE_ARMY_FORMATION"
						}
					}
				}

				button = {
					visible = "[And(InformationPanel.IsTabSelected('army'), PanelMilitary.CanAnyUnitInAnyPlayerFormationBeUpgraded)]"
					using = default_button_map_interaction
					parentanchor = hcenter
					size = { 520 50 }
					tooltip = "MILITARY_FORMATION_UNITS_UPGRADE_ALL_ALL"
					onclick = "[Execute( PanelMilitary.GetUpgradeAllUnitsInAllFormationsCommand)]"
					enabled = "[IsValid( PanelMilitary.GetUpgradeAllUnitsInAllFormationsCommand)]"

					textbox = {
						parentanchor = center
						autoresize = yes
						align = nobaseline
						using = fontsize_large
						using = elide_fontsize_min
						max_width = 500
						text = "MILITARY_FORMATION_UNITS_UPGRADE_ALL"
					}
				}

				widget = {
					size = { 5 5 }
				}
			}

			flowcontainer = {
				visible = "[And(InformationPanel.IsTabSelected('mobilization'), Country.IsCommittedInDiplomaticPlay)]"
				margin_bottom = 10
				direction = vertical
				spacing = 10

				divider_clean = {
					size = { @panel_width_plus_14 4 }
				}

				background = {
					using = dark_area
				}

				big_mobilize_all_button = {
					parentanchor = hcenter
				}
			}
		}

		blockoverride "bottom_spacing" {}
	}
}

types mobilization_options {
	type mobilization_option_small = widget {
		alpha = "[TransparentIfFalse(Or(MobilizationOption.IsActivated(MilitaryFormation.AccessSelf),IsValid(MobilizationOption.Toggle(MilitaryFormation.AccessSelf))))]"
		#visible = "[Or(MobilizationOption.IsActivated(MilitaryFormation.AccessSelf),IsValid(MobilizationOption.Toggle(MilitaryFormation.AccessSelf)))]"
		size = { 45 45 }

		widget = {
			size = { 100% 100% }

			# Activate
			widget = {
				visible = "[Not(MobilizationOption.IsActivated(MilitaryFormation.AccessSelf))]"
				size = { 100% 100% }

				# Activate button - show confirmation popup
				button = {
					using = default_button
					size = { 100% 100% }
					visible = "[ShouldAskConfirmation(MobilizationOption.Toggle(MilitaryFormation.AccessSelf))]"

					enabled = "[And(Not(MobilizationOption.IsActivated(MilitaryFormation.AccessSelf)), IsValid(MobilizationOption.Toggle(MilitaryFormation.AccessSelf)))]"
					onclick = "[PopupManager.AskConfirmation(MobilizationOption.Toggle(MilitaryFormation.AccessSelf))]"
					tooltip = "ACTIVATE_MOBILIZATION_OPTION_BUTTON_TOOLTIP"
					using = tooltip_se
				}

				# Activate button - no confirmation popup
				button = {
					using = default_button
					size = { 100% 100% }
					visible = "[Not(ShouldAskConfirmation(MobilizationOption.Toggle(MilitaryFormation.AccessSelf)))]"

					enabled = "[And(Not(MobilizationOption.IsActivated(MilitaryFormation.AccessSelf)), IsValid(MobilizationOption.Toggle(MilitaryFormation.AccessSelf)))]"
					onclick = "[Execute(MobilizationOption.Toggle(MilitaryFormation.AccessSelf))]"
					tooltip = "ACTIVATE_MOBILIZATION_OPTION_BUTTON_TOOLTIP"
					using = tooltip_se
				}
			}

			# Deactivate
			widget = {
				visible = "[MobilizationOption.IsActivated(MilitaryFormation.AccessSelf)]"
				size = { 100% 100% }

				# Deactivate button - show confirmation popup
				button = {
					using = default_button
					size = { 100% 100% }
					visible = "[ShouldAskConfirmation(MobilizationOption.Toggle(MilitaryFormation.AccessSelf))]"

					enabled = "[And(MobilizationOption.IsActivated(MilitaryFormation.AccessSelf), IsValid(MobilizationOption.Toggle(MilitaryFormation.AccessSelf)))]"
					onclick = "[PopupManager.AskConfirmation(MobilizationOption.Toggle(MilitaryFormation.AccessSelf))]"
					tooltip = "DEACTIVATE_MOBILIZATION_OPTION_BUTTON_TOOLTIP"
					using = tooltip_se
				}

				# Deactivate button - no confirmation popup
				button = {
					using = default_button
					size = { 100% 100% }
					visible = "[Not(ShouldAskConfirmation(MobilizationOption.Toggle(MilitaryFormation.AccessSelf)))]"

					enabled = "[And(MobilizationOption.IsActivated(MilitaryFormation.AccessSelf), IsValid(MobilizationOption.Toggle(MilitaryFormation.AccessSelf)))]"
					onclick = "[Execute(MobilizationOption.Toggle(MilitaryFormation.AccessSelf))]"
					tooltip = "DEACTIVATE_MOBILIZATION_OPTION_BUTTON_TOOLTIP"
					using = tooltip_se
				}
			}
		}

		icon = {
			size = { 75% 75% }
			texture = "[MobilizationOption.GetTexture]"
			parentanchor = center
		}

		icon = {
			visible = "[MobilizationOption.IsActivated(MilitaryFormation.AccessSelf)]"
			using = highlighted_square_selection
		}
	}

	type big_mobilize_all_button = container {
		### Mobilize button
		widget = {
			size = { 500 50 }
			visible = "[And(IsValid( Country.MobilizeAllArmies ), Country.IsCommittedInDiplomaticPlay)]"

			button = {
				enabled = "[IsValid( Country.MobilizeAllArmies )]"

				parentanchor = right|vcenter
				using = default_button
				using = diplomatic_play_mobilize_button_sound
				size = { 470 50 }
				using = fontsize_large

				onclick = "[PopupManager.AskConfirmation( Country.MobilizeAllArmies )]"
				tooltip = "MOBILIZE_ALL_MILITARY_FORMATIONS_BUTTON_TOOLTIP"

				textbox = {
					text = "MOBILIZE_ALL_MILITARY_FORMATIONS"
					align = center|nobaseline
					parentanchor = center
					margin_right = 30
					size = { 470 30 }
					fontsize_min = 12
					elide = right
					using = fontsize_large
				}
			}

			icon_with_background_big = {
				parentanchor = left|vcenter
				enabled = "[IsValid( Country.MobilizeAllArmies )]"
			}
		}

		### Demobilize button
		widget = {
			size = { 500 50 }
			visible = "[And(Not(IsValid( Country.MobilizeAllArmies )), Country.IsCommittedInDiplomaticPlay)]"

			button = {
				enabled = "[IsValid( Country.DemobilizeAllArmies )]"

				parentanchor = right|vcenter
				using = default_button
				using = diplomatic_play_mobilize_button_sound
				size = { 470 50 }
				using = fontsize_large

				onclick = "[PopupManager.AskConfirmation( Country.DemobilizeAllArmies )]"
				tooltip = "DEMOBILIZE_ALL_MILITARY_FORMATIONS_BUTTON_TOOLTIP"

				textbox = {
					text = "DEMOBILIZE_ALL_MILITARY_FORMATIONS"
					align = center|nobaseline
					parentanchor = center
					margin_right = 30
					size = { 470 30 }
					fontsize_min = 12
					elide = right
					using = fontsize_large
				}
			}

			icon_with_background_big = {
				parentanchor = left|vcenter
				enabled = "[IsValid( Country.DemobilizeAllArmies )]"
			}
		}
	}

	type mobilization_widget = flowcontainer {
		direction = vertical
		minimumsize = { 540 -1 }
		margin_bottom = 10

		using = entry_bg_fancy

		# Name and info header
		container = {
			minimumsize = { @panel_width 35 }

			background = {
				using = fade_right_entry_fancy_header_colored
				color = "[MilitaryFormation.GetCountry.GetMapColor]"
			}

			flowcontainer = {
				position = { 12 0 }
				parentanchor = vcenter
				spacing = 2

				icon = {
					size = { 30 30 }
					texture = "[MilitaryFormation.GetFlag]"
					color = "[MilitaryFormation.GetFlagColor]"
					parentanchor = vcenter
				}

				textbox = {
					maximumsize = { 200 -1 }
					parentanchor = vcenter
					multiline = yes
					autoresize = yes
					text = "[MilitaryFormation.GetNameNoIcon]"
					align = nobaseline
					elide = right
					margin_right = 3
				}

				button_icon_goto = {
					parentanchor = vcenter
					size = { 25 25 }
					tooltip = "GO_TO_BUTTON_MILITARY_FORMATION"
					onclick = "[InformationPanelBar.OpenMilitaryFormationPanelTab( MilitaryFormation.Self, 'default' )]"
				}
			}

			# Formation status
			flowcontainer = {
				position = { -15 0 }
				parentanchor = right|vcenter

				block "estimated_costs_visibility" {}

				textbox = {
					autoresize = yes
					text = "[MilitaryFormation.GetEstimatedMobilizationCostFormatted]"
					parentanchor = vcenter
					align = right|nobaseline
				}
			}
		}

		dynamicgridbox = {
			datamodel = "[GetMobilizationOptionGroups]"
			# TE: one group a row: with the mod's options a group holds up to ten (special_weapons),
			# 45 px each, too wide to share a row
			datamodel_wrap = 1
			flipdirection = yes
			parentanchor = hcenter

			item = {
				flowcontainer = {
					minimumsize = { 262 75 }

					flowcontainer = {
						minimumsize = { 258 75 }
						direction = vertical
						spacing = 2

						background = {
							texture = "[MobilizationOptionGroup.GetBackground]"
							alpha = 0.8
							fittype = centercrop
						}

						background = {
							using = entry_bg_simple
						}

						textbox = {
							text = "[MobilizationOptionGroup.GetNameNoFormatting]"
							margin_left = 10
							maximumsize = { 238 -1 }
							autoresize = yes
							align = left|nobaseline
							default_format = "#title"
							fontsize_min = 12
							elide = right
						}

						flowcontainer = {
							datamodel = "[MobilizationOptionGroup.GetMobilizationOptions]"
							margin_left = 10

							item = {
								mobilization_option_small = {}
							}
						}
					}
				}
			}
		}

		widget = { size = { 5 5 }}
		divider_clean = {
			parentanchor = hcenter
			size = { 520 2 }
		}
		widget = { size = { 5 5 }}

		flowcontainer = {
			parentanchor = hcenter
			spacing = 10

			### UNIT NUMBERS AND MANPOWER
			flowcontainer = {
				parentanchor = vcenter
				spacing = 5
				tooltip = "MILITARY_FORMATION_TOTAL_NUMBER_OF_UNITS_TOOLTIP"
				minimumsize = { 120 -1 }
				margin_left = 5

				### ARMY ICON
				icon = {
					visible = "[MilitaryFormation.IsArmy]"
					size = { 23 23 }
					parentanchor = vcenter
					texture = "gfx/interface/icons/generic_icons/battalions.dds"
				}

				### FLEET ICON
				icon = {
					visible = "[MilitaryFormation.IsFleet]"
					size = { 23 23 }
					parentanchor = vcenter
					texture = "gfx/interface/icons/generic_icons/flotillas.dds"
				}

				### ARMY - NUMBER OF UNITS
				textbox = {
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					text = "MILITARY_FORMATION_TOTAL_NUMBER_OF_UNITS"
					using = fontsize_large
					maximumsize = { 90 -1 }
					fontsize_min = 12
				}

				widget = { size = { 1 1 }}

				manpower_bar = {}
			}

			flowcontainer = {
				minimumsize = { 80 -1 }
				spacing = 10
				tooltip = "MILITARY_FORMATION_MORALE_TOOLTIP"
				parentanchor = vcenter

				### MORALE VALUE
				textbox = {
					parentanchor = vcenter
					autoresize = yes
					align = right|nobaseline

					text = "MILITARY_FORMATION_MORALE"
					minimumsize = { 70 -1 }
				}

				### MORALE BAR
				morale_bar = {
					size = { 6 24 }
					parentanchor = vcenter

					blockoverride "morale_value" {
						value = "[FixedPointToFloat( MilitaryFormation.GetMorale )]"
					}
					blockoverride "morale_color" {
						color = "[GetMoraleColorVec( MilitaryFormation.GetMorale )]"
					}
				}
			}

			flowcontainer = {
				tooltip = "MILITARY_FORMATION_ORGANIZATION_TOOLTIP"
				spacing = 10
				parentanchor = vcenter

				### ORGANIZATION
				textbox = {
					raw_text = "@organization! [MilitaryFormation.GetOrganizationPercentage|%v0]"
					parentanchor = vcenter
					align = right|nobaseline
					minimumsize = { 70 -1 }
				}

				### ORGANIZATION BAR
				organization_bar = {
					size = { 6 24 }
					parentanchor = vcenter

					blockoverride "organization_value" {
						value = "[FixedPointToFloat( MilitaryFormation.GetOrganizationPercentage )]"
					}
					blockoverride "organization_color" {
						color = "[GetOrganizationColorVec( MilitaryFormation.GetOrganizationPercentage )]"
					}
				}
			}

			widget = { size = { 1 1 }}
			vertical_divider = {}

			military_formation_mobilize_button = {
				parentanchor = vcenter
				visible = "[MilitaryFormation.IsArmy]"

				blockoverride "size" {
					size = { 180 50 }
				}

				blockoverride "button_size" {
					size = { 160 75% }
				}

				blockoverride "fontsize" {}

				blockoverride "mobilization_icon_size" {
					size = { 50 50 }
				}
			}
		}
	}
}
