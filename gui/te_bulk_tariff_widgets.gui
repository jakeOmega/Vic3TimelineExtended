				onclick = "[GetScriptedGui('te_bulk_tariff_export_low_tariffs_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				using = decrease_button_sound
			}
			blockoverride "is_selected_visibility" {
				visible = no
			}
			blockoverride "is_clickable_alpha" {
				alpha = "[TransparentIfFalse( GetScriptedGui('te_bulk_tariff_export_low_tariffs_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			}
		}
