			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_ms_sub_measures"
				}
			}
			te_demog_measure_head = {}
			te_demog_measure_row = {
				datacontext = "[GetScriptedGui('te_demog_ms_child_allowance_sgui')]"
				blockoverride "measure_name" {
					text = "te_demog_ms_child_allowance_name"
					tooltip = "te_demog_ms_child_allowance_tt"
				}
				blockoverride "measure_cost" {
					text = "te_demog_ms_child_allowance_upkeep"
				}
				blockoverride "measure_term" {
					text = "te_demog_ms_child_allowance_term"
				}
				blockoverride "measure_button" {
					text = "te_demog_ms_child_allowance_btn"
				}
			}
			te_demog_measure_row = {
				datacontext = "[GetScriptedGui('te_demog_ms_family_housing_sgui')]"
				blockoverride "measure_name" {
					text = "te_demog_ms_family_housing_name"
					tooltip = "te_demog_ms_family_housing_tt"
				}
				blockoverride "measure_cost" {
					text = "te_demog_ms_family_housing_upkeep"
				}
				blockoverride "measure_term" {
					text = "te_demog_ms_family_housing_term"
				}
				blockoverride "measure_button" {
					text = "te_demog_ms_family_housing_btn"
				}
			}
			te_demog_measure_row = {
				datacontext = "[GetScriptedGui('te_demog_ms_honours_sgui')]"
				blockoverride "measure_name" {
					text = "te_demog_ms_honours_name"
					tooltip = "te_demog_ms_honours_tt"
				}
				blockoverride "measure_cost" {
					text = "te_demog_ms_honours_upkeep"
				}
				blockoverride "measure_term" {
					text = "te_demog_ms_honours_term"
				}
				blockoverride "measure_button" {
					text = "te_demog_ms_honours_btn"
				}
			}
			te_demog_measure_row = {
				datacontext = "[GetScriptedGui('te_demog_ms_restricted_contraception_sgui')]"
