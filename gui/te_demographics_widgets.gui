				visible = "[And( Not( And( GetVariableSystem.Exists('te_demog_pyr_bio_open'), GetScriptedGui('te_demog_lx_bio_pyr_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('te_demog_outline_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
				text = "te_demog_pyr_legend_now"
			}
			te_demog_note = {
				visible = "[And( GetVariableSystem.Exists('te_demog_pyr_bio_open'), GetScriptedGui('te_demog_lx_bio_pyr_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "te_demog_pyr_legend_bio"
			}
		}
	}

	### Wealth: the Gini beside the strata's average incomes (vanilla's own
	### figures and hovers), Wealth Concentration as a bar heading for its
	### target, the target's six terms as pillars, and the most and least
	### concentrated states. Wealth Concentration's national figures exist once
	### a state has a score (te_demog_wealth_ready_sgui); until then one line.
	### The Gini cell has its own gate (te_demog_gini_ready_sgui) and shows a
	### dash until the country has a Gini.
	type te_demog_sec_wealth = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_wealth"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_wealth_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_wealth_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_wealth_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_wealth_closed'))]"

			te_demog_text = {
				visible = "[Not( GetScriptedGui('te_demog_wealth_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "te_demog_wealth_pending"
			}

			flowcontainer = {
				visible = "[GetScriptedGui('te_demog_wealth_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 3

				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 8

					te_demog_wealth_cell = {
						tooltip = "te_demog_gini_tt"
						blockoverride "cell_size" {
							minimumsize = { 120 -1 }
							maximumsize = { 120 -1 }
						}
						blockoverride "cell_label" {
							text = "te_demog_gini_label"
						}
						blockoverride "cell_value" {
							text = "[SelectLocalization( GetScriptedGui('te_demog_gini_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_demog_gini_value', 'te_demog_gini_pending' )]"
						}
					}
					te_demog_wealth_cell = {
						tooltip = "POPS_OVERVIEW_AVERAGE_INCOME_LOW_LABEL_TOOLTIP"
						blockoverride "cell_label" {
							text = "LOWER_NO_ICON"
						}
						blockoverride "cell_value" {
							text = "POPS_OVERVIEW_AVERAGE_INCOME_LOW_LABEL"
						}
					}
					te_demog_wealth_cell = {
						tooltip = "POPS_OVERVIEW_AVERAGE_INCOME_MIDDLE_LABEL_TOOLTIP"
						blockoverride "cell_label" {
							text = "MIDDLE_NO_ICON"
						}
						blockoverride "cell_value" {
							text = "POPS_OVERVIEW_AVERAGE_INCOME_MIDDLE_LABEL"
						}
					}
					te_demog_wealth_cell = {
						tooltip = "POPS_OVERVIEW_AVERAGE_INCOME_UPPER_LABEL_TOOLTIP"
						blockoverride "cell_label" {
							text = "UPPER_NO_ICON"
						}
						blockoverride "cell_value" {
							text = "POPS_OVERVIEW_AVERAGE_INCOME_UPPER_LABEL"
						}
					}
				}

				te_demog_subheader = {
					blockoverride "subheader_text" {
						text = "te_demog_wc_head"
					}
				}
				te_demog_figure_row = {
					tooltip = "te_demog_ov_wc_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_now"
					}
					blockoverride "row_value" {
						text = "te_demog_ov_wc_value"
					}
				}

				### Wealth Concentration on its 0-100 scale, heading for its target
				### (rule 5), in Global Warming's temperature-bar layers: the bar's
				### background and frame; a pale segment of the bar's own fill to the
				### higher of score and target (neither direction is good or bad for
				### the player in itself); the solid fill to the lower; and a thin line
				### at 50, where #822's modifiers change sides, with its own hover.
				widget = {
					size = { 480 18 }
					tooltip = "te_demog_wc_bar_tt"

					default_progressbar_horizontal = {
						size = { 100% 100% }
						blockoverride "values" {
							value = 0
							min = 0
							max = 1
						}
					}
					widget = {
						size = { 100% 100% }
						alpha = 0.4

						default_progressbar_horizontal = {
							size = { 100% 100% }
							blockoverride "background" {}
							blockoverride "frame" {}
							blockoverride "values" {
								value = "[FixedPointToFloat( Max_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_inh_concentration_display'), GetPlayer.MakeScope.ScriptValue('te_inh_concentration_target') ) )]"
								min = 0
								max = 100
							}
						}
					}
					default_progressbar_horizontal = {
						size = { 100% 100% }
						blockoverride "background" {}
						blockoverride "frame" {}
						blockoverride "values" {
							value = "[FixedPointToFloat( Min_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_inh_concentration_display'), GetPlayer.MakeScope.ScriptValue('te_inh_concentration_target') ) )]"
							min = 0
							max = 100
						}
					}
					icon = {
						size = { 3 24 }
						parentanchor = center
						texture = "gfx/interface/backgrounds/white.dds"
						color = { 0.96 0.90 0.72 0.95 }
						tooltip = "te_demog_wc_line_tt"
					}
				}

				te_demog_subheader = {
					blockoverride "subheader_text" {
						text = "te_demog_wc_terms_head"
					}
				}
				te_demog_term_row = {
					tooltip = "te_demog_wc_t_law_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_t_law"
					}
					blockoverride "term_left" {
						value = "[FixedPointToFloat( Min_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_wc_law_term'), '(CFixedPoint)0' ) )]"
					}
					blockoverride "term_right" {
						value = "[FixedPointToFloat( Max_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_wc_law_term'), '(CFixedPoint)0' ) )]"
					}
					blockoverride "row_value" {
						text = "[GetPlayer.MakeScope.ScriptValue('te_demog_wc_law_term')|+0]"
					}
				}
				te_demog_term_row = {
					tooltip = "te_demog_wc_t_land_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_t_land"
					}
					blockoverride "term_left" {
						value = "[FixedPointToFloat( Min_CFixedPoint( GetPlayer.MakeScope.Var('te_dg_wc_t_land').GetValue, '(CFixedPoint)0' ) )]"
					}
					blockoverride "term_right" {
						value = "[FixedPointToFloat( Max_CFixedPoint( GetPlayer.MakeScope.Var('te_dg_wc_t_land').GetValue, '(CFixedPoint)0' ) )]"
					}
					blockoverride "row_value" {
						text = "[GetPlayer.MakeScope.Var('te_dg_wc_t_land').GetValue|+0]"
					}
				}
				te_demog_term_row = {
					tooltip = "te_demog_wc_t_own_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_t_own"
					}
					blockoverride "term_left" {
						value = "[FixedPointToFloat( Min_CFixedPoint( GetPlayer.MakeScope.Var('te_dg_wc_t_own').GetValue, '(CFixedPoint)0' ) )]"
					}
					blockoverride "term_right" {
						value = "[FixedPointToFloat( Max_CFixedPoint( GetPlayer.MakeScope.Var('te_dg_wc_t_own').GetValue, '(CFixedPoint)0' ) )]"
					}
					blockoverride "row_value" {
						text = "[GetPlayer.MakeScope.Var('te_dg_wc_t_own').GetValue|+0]"
					}
				}
				te_demog_term_row = {
					tooltip = "te_demog_wc_t_ineq_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_t_ineq"
					}
					blockoverride "term_left" {
						value = "[FixedPointToFloat( Min_CFixedPoint( GetPlayer.MakeScope.Var('te_dg_wc_t_ineq').GetValue, '(CFixedPoint)0' ) )]"
					}
					blockoverride "term_right" {
						value = "[FixedPointToFloat( Max_CFixedPoint( GetPlayer.MakeScope.Var('te_dg_wc_t_ineq').GetValue, '(CFixedPoint)0' ) )]"
					}
					blockoverride "row_value" {
						text = "[GetPlayer.MakeScope.Var('te_dg_wc_t_ineq').GetValue|+0]"
					}
				}
				te_demog_term_row = {
					tooltip = "te_demog_wc_t_tax_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_t_tax"
					}
					blockoverride "term_left" {
						value = "[FixedPointToFloat( Min_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_wc_tax_term'), '(CFixedPoint)0' ) )]"
					}
					blockoverride "term_right" {
						value = "[FixedPointToFloat( Max_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_wc_tax_term'), '(CFixedPoint)0' ) )]"
					}
					blockoverride "row_value" {
						text = "[GetPlayer.MakeScope.ScriptValue('te_demog_wc_tax_term')|+0]"
					}
				}
				te_demog_term_row = {
					tooltip = "te_demog_wc_t_econ_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_t_econ"
					}
					blockoverride "term_left" {
						value = "[FixedPointToFloat( Min_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_wc_econ_term'), '(CFixedPoint)0' ) )]"
					}
					blockoverride "term_right" {
						value = "[FixedPointToFloat( Max_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_wc_econ_term'), '(CFixedPoint)0' ) )]"
					}
					blockoverride "row_value" {
						text = "[GetPlayer.MakeScope.ScriptValue('te_demog_wc_econ_term')|+0]"
					}
				}

				te_demog_note = {
					visible = "[GetScriptedGui('te_demog_wc_pinned_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					text = "te_demog_wc_pinned_note"
				}
				te_demog_figure_row = {
					visible = "[GetScriptedGui('te_demog_wc_top_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "te_demog_wc_top_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_top"
					}
					blockoverride "row_value" {
						text = "te_demog_wc_top_value"
					}
				}
				te_demog_figure_row = {
					visible = "[GetScriptedGui('te_demog_wc_bottom_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "te_demog_wc_bottom_tt"
					blockoverride "row_label" {
						text = "te_demog_wc_bottom"
					}
					blockoverride "row_value" {
						text = "te_demog_wc_bottom_value"
					}
				}
			}
		}
	}

	### Where people live: the national urban pattern (spec §5.1), then the
	### three largest cities, a state each, by the game's city ranking.
	type te_demog_sec_places = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_places"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_places_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_places_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_places_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_places_closed'))]"

			te_demog_figure_row = {
				tooltip = "te_demog_pl_urban_tt"
				blockoverride "row_label" {
					text = "te_demog_pl_urban"
				}
				blockoverride "row_value" {
					text = "te_demog_pl_urban_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_neutral = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_trend_urban_share'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_trend_urban_share'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_trend_urban_share'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_pl_primacy_tt"
				blockoverride "row_label" {
					text = "te_demog_pl_primacy"
				}
				blockoverride "row_value" {
					text = "te_demog_pl_primacy_value"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_pl_cities_tt"
				blockoverride "row_label" {
					text = "te_demog_pl_cities"
				}
				blockoverride "row_value" {
					text = "te_demog_pl_cities_value"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_ov_pattern_tt"
				blockoverride "row_label" {
					text = "te_demog_pl_pattern"
				}
				blockoverride "row_value" {
					text = "te_demog_pl_pattern_value"
				}
			}
			### Phase 3: the states whose metropolitan share reads Metropolis (spec §5.2), of those with a share; the
			### hover counts each label. Live script values (te_demog_metro_values.txt), no variable read.
			te_demog_figure_row = {
				tooltip = "te_demog_mt_pl_tt"
				blockoverride "row_label" {
					text = "te_demog_mt_pl"
				}
				blockoverride "row_value" {
					text = "te_demog_mt_pl_value"
				}
			}

			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_cities_head"
				}
			}
			te_demog_text = {
				visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('te_dg_cities') )]"
				text = "te_demog_cities_none"
			}
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2
				datamodel = "[GetPlayer.MakeScope.GetList('te_dg_cities')]"

				item = {
					te_demog_city_row = {
						datacontext = "[Scope.GetState]"
					}
				}
			}
		}
	}

	### States: the ten largest by people (te_dg_states_top), and under Show All the 40 the census lists
	### (te_dg_states); each list is stored largest first and a datamodel draws it in its stored order. A country whose
	### last census came before the ten-row list (an old save, until 31 December) shows the 40. The button sits centred
	### under the rows (rule 6) and shows only while there are more than ten (te_demog_states_more_sgui).
	type te_demog_sec_states = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_states"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_states_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_states_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_states_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_states_closed'))]"

			te_demog_state_head = {}
			flowcontainer = {
				visible = "[And( Not( GetVariableSystem.Exists('te_demog_states_all_open') ), Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList('te_dg_states_top') ) ) )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2
				datamodel = "[GetPlayer.MakeScope.GetList('te_dg_states_top')]"

				item = {
					te_demog_state_row = {
						datacontext = "[Scope.GetState]"
					}
				}
			}
			flowcontainer = {
				visible = "[Or( GetVariableSystem.Exists('te_demog_states_all_open'), IsDataModelEmpty( GetPlayer.MakeScope.GetList('te_dg_states_top') ) )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2
				datamodel = "[GetPlayer.MakeScope.GetList('te_dg_states')]"

				item = {
					te_demog_state_row = {
						datacontext = "[Scope.GetState]"
					}
				}
			}
			button = {
				visible = "[And( GetScriptedGui('te_demog_states_more_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList('te_dg_states_top') ) ) )]"
				using = default_button_action
				size = { 240 28 }
				parentanchor = hcenter
				onclick = "[GetVariableSystem.Toggle('te_demog_states_all_open')]"
				tooltip = "te_demog_states_show_tt"

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 230
					elide = right
					using = te_demog_fontsize_row
					text = "[SelectLocalization( GetVariableSystem.Exists('te_demog_states_all_open'), 'te_demog_states_show_top', SelectLocalization( GetScriptedGui('te_demog_states_over_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_demog_states_show_40', 'te_demog_states_show_all' ) )]"
				}
			}
		}
	}

	### The pips over a year's bar in every History chart (issue #1029), each on a row of its own so two never hide each
	### other: the war dead the states' counts took (te_dg_h_mk_war), a month of famine (te_dg_h_mk_famine), a demographic
	### event (te_dg_h_mk_event; te_demog_history_effects.txt). Mouse-through: the bar's tooltip names them.
	type te_demog_hist_pips = widget {
		size = { 100% 100% }
		alwaystransparent = yes

		icon = {
			visible = "[ScriptContainer.HasVariable( 'te_dg_h_mk_war' )]"
			parentanchor = hcenter
			position = { 0 2 }
			alwaystransparent = yes
			size = { 10 10 }
			texture = "gfx/interface/icons/generic_icons/battalions.dds"
		}
		icon = {
			visible = "[ScriptContainer.HasVariable( 'te_dg_h_mk_famine' )]"
			parentanchor = hcenter
			position = { 0 14 }
			alwaystransparent = yes
			size = { 10 10 }
			texture = "gfx/interface/icons/generic_icons/goods_shortage.dds"
		}
		icon = {
			visible = "[ScriptContainer.HasVariable( 'te_dg_h_mk_event' )]"
			parentanchor = hcenter
			position = { 0 26 }
			alwaystransparent = yes
			size = { 9 9 }
			texture = "gfx/interface/icons/generic_icons/information.dds"
		}
	}

	### The pips' key: the same textures at the same sizes, one line each.
	type te_demog_hist_pip_legend = flowcontainer {
		direction = horizontal
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 12
		margin = { 4 2 }

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			tooltip = "te_demog_hist_pip_war_tt"

			icon = {
				parentanchor = vcenter
				alwaystransparent = yes
				size = { 10 10 }
				texture = "gfx/interface/icons/generic_icons/battalions.dds"
			}
			textbox = {
				parentanchor = vcenter
				autoresize = yes
				align = nobaseline
				using = fontsize_medium
				default_format = "#tooltippable"
				text = "te_demog_hist_pip_war"
			}
		}
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			tooltip = "te_demog_hist_pip_famine_tt"

			icon = {
				parentanchor = vcenter
				alwaystransparent = yes
				size = { 10 10 }
				texture = "gfx/interface/icons/generic_icons/goods_shortage.dds"
			}
			textbox = {
				parentanchor = vcenter
				autoresize = yes
				align = nobaseline
				using = fontsize_medium
				default_format = "#tooltippable"
				text = "te_demog_hist_pip_famine"
			}
		}
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			tooltip = "te_demog_hist_pip_event_tt"

			icon = {
				parentanchor = vcenter
				alwaystransparent = yes
				size = { 9 9 }
				texture = "gfx/interface/icons/generic_icons/information.dds"
			}
			textbox = {
				parentanchor = vcenter
				autoresize = yes
				align = nobaseline
				using = fontsize_medium
				default_format = "#tooltippable"
				text = "te_demog_hist_pip_event"
			}
		}
	}

	### History: one bar a census year from te_dg_hist (Task 12; the player's country is always tracked), on one range of 5,
	### 20 or 100 years (te_demog_hist_range; unset shows every sample, up to 100). Open by default (rule 1). Eight charts,
	### one a unit (issue #1029, after Banking's six): births and deaths per 1,000 side by side, whose gap is natural change;
	### net migration per 1,000, signed; life expectancy, children per woman and median age; deaths by cause, a column a
	### year stacked in the pie's order; the Gini and Wealth Concentration, recorded since Task 12 and drawn since #1029.
	### Each chart is a te_history_chart instance with its plot blocks overridden on the instance (gotcha #37), as Cultural
	### Hegemony's annual chart does: 5 / 20 / 100 years at 80 / 20 / 4 px are 400 px of bars, in a frame of 48 px for the
	### axis labels + 400 + the plots' 8 px right margin. A sample that lacks a figure draws an empty slot, not a zero (a
	### seed year has no births or deaths; a year before #1029 no causes). Titles take the panel's heading type, legends
	### and axis labels the tooltip face's medium, as Banking's charts do. Over each bar the year's pips
	### (te_demog_hist_pips): war dead, a famine, a demographic event, with their key above the charts.
	type te_demog_sec_history = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_history"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_hist_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_hist_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_hist_closed'))]"
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_hist_closed'))]"
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 2

			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				spacing = 4
				margin = { 4 4 }

				te_history_range_button = {
					size = { 96 26 }
					blockoverride "range_text" {
						text = "te_hist_range_5y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue('te_demog_hist_range', '5'))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set('te_demog_hist_range', '5')]"
					}
				}
				te_history_range_button = {
					size = { 96 26 }
					blockoverride "range_text" {
						text = "te_hist_range_20y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue('te_demog_hist_range', '20'))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set('te_demog_hist_range', '20')]"
					}
				}
				te_history_range_button = {
					size = { 96 26 }
					blockoverride "range_text" {
						text = "te_demog_hist_range_100y"
					}
					blockoverride "range_enabled" {
						enabled = "[Or(GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20'))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set('te_demog_hist_range', '100')]"
					}
				}
			}

			### What the pips over a bar mean (the year's war dead, a famine, a demographic event)
			te_demog_hist_pip_legend = {
				visible = "[Not( IsDataModelEmpty( GetPlayer.MakeScope.GetList('te_dg_hist') ) )]"
			}

			### Births and deaths per 1,000, side by side: their gap is natural change
			te_history_chart = {
				blockoverride "chart_title_font" {
					using = te_demog_fontsize_heading
				}
				blockoverride "chart_legend_font" {
					using = fontsize_medium
				}
				blockoverride "chart_title" {
					text = "te_demog_hist_bd_title"
				}
				blockoverride "chart_legend" {
					text = "te_demog_hist_bd_legend"
				}
				blockoverride "sample_datamodel" {
					datamodel = "[GetPlayer.MakeScope.GetList('te_dg_hist')]"
				}
				blockoverride "sample_visible" {
					visible = "[Or( Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) ), Or( And( GetVariableSystem.HasValue('te_demog_hist_range', '5'), LessThan_CFixedPoint( Subtract_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_history_current_year'), ScriptContainer.GetVariableValue('te_hist_i') ), '(CFixedPoint)5' ) ), And( GetVariableSystem.HasValue('te_demog_hist_range', '20'), LessThan_CFixedPoint( Subtract_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_history_current_year'), ScriptContainer.GetVariableValue('te_hist_i') ), '(CFixedPoint)20' ) ) ) )]"
				}
				blockoverride "bar_tooltip" {
					tooltip = "te_demog_hist_bd_tt"
				}
				blockoverride "marker_pips" {
					te_demog_hist_pips = {}
				}
				blockoverride "bar_body" {
					widget = {
						size = { 100% 100% }
						visible = "[ScriptContainer.HasVariable('te_dg_h_cbr')]"

						widget = {
							size = { 50% 100% }
							parentanchor = left

							progressbar = {
								size = { 100% 100% }
								direction = vertical
								progresstexture = "gfx/interface/backgrounds/white.dds"
								noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								texture_density = 2
								skip_initial_animation = yes
								alwaystransparent = yes
								color = { 0.42 0.70 0.48 1.0 }
								value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0.6', ScriptContainer.GetVariableValue('te_dg_h_cbr') ) )]"
								min = 0
								max = 60
							}
						}
						widget = {
							size = { 50% 100% }
							parentanchor = right

							progressbar = {
								size = { 100% 100% }
								direction = vertical
								progresstexture = "gfx/interface/backgrounds/white.dds"
								noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								texture_density = 2
								skip_initial_animation = yes
								alwaystransparent = yes
								color = { 0.82 0.40 0.36 1.0 }
								value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0.6', ScriptContainer.GetVariableValue('te_dg_h_cdr') ) )]"
								min = 0
								max = 60
							}
						}
					}
				}
				blockoverride "plot_size" {
					size = { 456 96 }
				}
				blockoverride "plot_layouts" {
					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '5')]"
						blockoverride "bar_size" {
							size = { 80 84 }
						}
					}
					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '20')]"
						blockoverride "bar_size" {
							size = { 20 84 }
						}
					}
					te_history_plot = {
						visible = "[Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) )]"
						blockoverride "bar_size" {
							size = { 4 84 }
						}
					}
					textbox = {
						parentanchor = left|top
						position = { 8 6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "60"
					}
					textbox = {
						parentanchor = left|bottom
						position = { 8 -6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "0"
					}
				}
				blockoverride "empty_visible" {
					visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('te_dg_hist') )]"
				}
				blockoverride "empty_text" {
					text = "te_demog_hist_empty"
				}
			}
			### Net migration per 1,000, signed
			te_history_chart = {
				blockoverride "chart_title_font" {
