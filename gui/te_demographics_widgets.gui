	### ======================================================================
	### FAMILY POLICY (phase 2 step 3a; docs/superpowers/specs/
	### 2026-10-12-demographics-phase2-consequences-design.md §3.7)
	### ======================================================================
	###
	### The Family & Reproductive Policy law in force; a row a measure it
	### allows, with its running cost, its term and its button; then, dimmed
	### under "Other Laws", the measures only another law allows, each naming
	### that law on hover (rule 2). A row shows while its scripted GUI's
	### is_shown holds (te_demog_measure_sguis.txt: the law allows it). Every
	### figure is a script value (te_demog_measure_values.txt), never a
	### measure's variable, which exists only while it is on. Under Display
	### only one line above the rows says why every button is greyed (rule 6).

	### The column heads. Fixed cells, 200 + 104 + 100 + 64 and three 4 px gaps
	### = 480; each head explains its column on hover.
	type te_demog_measure_head = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4

		textbox = {
			autoresize = yes
			minimumsize = { 164 -1 }
			maximumsize = { 164 -1 }
			align = left|nobaseline
			using = te_demog_fontsize_row
			default_format = "#tooltippable"
			text = "te_demog_ms_head_measure"
			tooltip = "te_demog_ms_head_measure_tt"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 100 -1 }
			maximumsize = { 100 -1 }
			align = right|nobaseline
			using = te_demog_fontsize_row
			default_format = "#tooltippable"
			text = "te_demog_ms_head_cost"
			tooltip = "te_demog_ms_head_cost_tt"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 132 -1 }
			maximumsize = { 132 -1 }
			align = right|nobaseline
			using = te_demog_fontsize_row
			default_format = "#tooltippable"
			text = "te_demog_ms_head_term"
			tooltip = "te_demog_ms_head_term_tt"
		}
		widget = {
			size = { 72 4 }
		}
	}

	### One measure the law in force allows (datacontext its scripted GUI):
	### its name (its aim and its modifiers on hover), running cost, term and
	### button. The instance sets the texts. "Honours for Large Families", 26
	### characters, is about 224 units in the medium font, so the name shrinks
	### to 12 before it would elide; "Barred to 1915", 14 in the small font,
	### about 100.
	type te_demog_measure_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

		textbox = {
			autoresize = yes
			minimumsize = { 164 -1 }
			maximumsize = { 164 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = te_demog_fontsize_row
			multiline = yes
			default_format = "#tooltippable"
			elide = right
			block "measure_name" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 100 -1 }
			maximumsize = { 100 -1 }
			parentanchor = vcenter
			align = right|nobaseline
			using = te_demog_fontsize_row
			elide = right
			block "measure_cost" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 132 -1 }
			maximumsize = { 132 -1 }
			parentanchor = vcenter
			align = right|nobaseline
			using = te_demog_fontsize_row
			elide = right
			block "measure_term" {}
		}
		button = {
			using = default_button_action
			size = { 72 24 }
			parentanchor = vcenter
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 68
				elide = right
				using = te_demog_fontsize_row
				block "measure_button" {}
			}
		}
	}

	### One measure only another law allows (datacontext its scripted GUI):
	### dimmed, its name and what it would cost; the hover names the laws that
	### allow it and what it does. The term and button cells stay empty, so
	### the columns line up with the rows above.
	type te_demog_measure_row_other = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		alpha = 0.5
		visible = "[Not( ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"

		textbox = {
			autoresize = yes
			minimumsize = { 164 -1 }
			maximumsize = { 164 -1 }
			align = left|nobaseline
			using = te_demog_fontsize_row
			multiline = yes
			default_format = "#tooltippable"
			elide = right
			block "measure_name" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 100 -1 }
			maximumsize = { 100 -1 }
			align = right|nobaseline
			using = te_demog_fontsize_row
			elide = right
			block "measure_cost" {}
		}
		widget = {
			size = { 208 4 }
		}
	}

	type te_demog_sec_family = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_family"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_family_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_family_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_family_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_family_closed'))]"

			### The law in force, "Law in Force" then its name ("State-Sponsored
			### Family Planning", 31 characters, about 270 units, in a 352 cell),
			### with the law's own tooltip on hover.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 8

				textbox = {
					autoresize = yes
					minimumsize = { 120 -1 }
					maximumsize = { 120 -1 }
					align = left|nobaseline
					using = te_demog_fontsize_row
					default_format = "#tooltippable"
					text = "te_demog_ms_law"
					tooltip = "te_demog_ms_law_tt"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 352 -1 }
					maximumsize = { 352 -1 }
					align = right|nobaseline
