					default_format = "#v"
					datacontext = "[AccessPlayer.AccessActiveLawFromGroup('lawgroup_family_reproductive_policy')]"
					text = "[Law.GetNameNoFormatting]"
					tooltipwidget = {
						FancyTooltip_Law = {}
					}
				}
			}
			te_demog_text = {
				visible = "[Not( GetScriptedGui('te_demog_ms_full_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
