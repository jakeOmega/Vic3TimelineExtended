	### The state's Work and Retirement (phase 2 step 2; the design §2.6, §10): the same rows as the country's, without
	### the buttons (the setting is the owner's) or the bill (a country's), each under a state gate: the figures
	### (te_demog_state_work_sgui), the owner's pension (te_demog_state_pension_sgui). Open by default, flag
	### te_demog_st_work_closed. Under Full the workforce's hover adds the census's term (te_demog_state_wf_term_sgui).
	type te_state_demog_work = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_work"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_st_work_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_st_work_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_st_work_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_st_work_closed'))]"

			te_demog_text = {
				visible = "[Not( GetScriptedGui('te_demog_state_work_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ) )]"
				text = "te_demog_st_wk_pending"
			}

			flowcontainer = {
				visible = "[GetScriptedGui('te_demog_state_work_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 3

				te_demog_figure_row = {
					tooltip = "te_demog_st_wk_workforce_tt"
					blockoverride "row_label" {
						text = "te_demog_wk_workforce"
					}
					blockoverride "row_value" {
						text = "te_demog_st_wk_workforce_value"
					}
				}
				### issue #1029: from the overview
				te_demog_figure_row = {
					tooltip = "[SelectLocalization( GetScriptedGui('te_demog_lx_state_old_c_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_old_age_tt_late', 'te_demog_st_old_age_tt' )]"
					blockoverride "row_label" {
						text = "te_demog_ov_old_age"
					}
					blockoverride "row_value" {
						text = "te_demog_st_old_age_value"
					}
				}
				te_demog_figure_row = {
					visible = "[GetScriptedGui('te_demog_state_pension_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
					tooltip = "te_demog_st_wk_pension_age_tt"
					blockoverride "row_label" {
						text = "te_demog_wk_pension_age"
					}
					blockoverride "row_value" {
						text = "te_demog_st_wk_pension_age_value"
					}
				}
				te_demog_figure_row = {
					visible = "[GetScriptedGui('te_demog_state_pension_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
					tooltip = "te_demog_st_wk_pensioners_tt"
					blockoverride "row_label" {
						text = "te_demog_wk_pensioners"
					}
					blockoverride "row_value" {
						text = "te_demog_st_wk_pensioners_value"
					}
				}
				te_demog_figure_row = {
					tooltip = "te_demog_st_wk_need_tt"
					blockoverride "row_label" {
						text = "te_demog_wk_need"
					}
					blockoverride "row_value" {
						text = "te_demog_st_wk_need_value"
					}
				}
				### phase 2 step 4 (the consequences design §4.5)
				te_state_demog_fam_row = {}
				### issue #1029: from the overview, while the state has a youth bulge
				te_demog_figure_row = {
					visible = "[GetScriptedGui('te_demog_state_youth_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
					tooltip = "te_demog_st_youth_tt"
					blockoverride "row_label" {
						text = "te_demog_youth"
					}
					blockoverride "row_value" {
						text = "te_demog_st_youth_value"
					}
				}
			}
		}
	}

	### The state's Longevity (phase 3), as the country's (te_demog_sec_longevity), with the state's own figures and the
	### cover its ever-treated still have; its own flag (te_demog_st_lx_closed). Shown once the state has had a late step.
	type te_state_demog_longevity = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('te_demog_lx_state_ready_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_longevity"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_st_lx_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_st_lx_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_st_lx_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_st_lx_closed'))]"

			### issue #1029: from the overview, beside the care that moves them
			te_demog_figure_row = {
				tooltip = "te_demog_st_lx_l100_tt"
				blockoverride "row_label" {
					text = "te_demog_lx_l100"
				}
				blockoverride "row_value" {
					text = "te_demog_st_lx_l100_value"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_lx_bio_tt"
				blockoverride "row_label" {
					text = "te_demog_lx_bio"
				}
				blockoverride "row_value" {
					text = "te_demog_st_lx_bio_value"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_lx_care_tt"
				blockoverride "row_label" {
					text = "te_demog_lx_care"
				}
				blockoverride "row_value" {
					text = "te_demog_st_lx_care_value"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_lx_gap_tt"
				blockoverride "row_label" {
					text = "te_demog_lx_gap"
				}
				blockoverride "row_value" {
					text = "te_demog_st_lx_gap_value"
				}
			}
		}
	}

	### The state's pyramid: the same row as the country's, 85 and over at the
	### top, on the state's own scale (te_dg_pyr_max, te_demog_state_pyramid_max
	### stored at its census: the largest of its 36 bands) and without the outline (next_visible off, so the
	### outline bars are never drawn). The overrides of men_range and
	### women_range reach both bars of each side.
	type te_state_demog_pyramid = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_pyramid"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_st_pyr_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_st_pyr_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_st_pyr_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_st_pyr_closed'))]"

			### issue #1029: the sex balance and the urban share, from the overview
			te_demog_figure_row = {
				tooltip = "te_demog_st_sex_tt"
				blockoverride "row_label" {
					text = "te_demog_ov_sex"
				}
				blockoverride "row_value" {
					text = "te_demog_st_sex_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_neutral = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_urban_tt"
				blockoverride "row_label" {
					text = "te_demog_st_urban"
				}
				blockoverride "row_value" {
					text = "te_demog_st_urban_value"
				}
			}
			### Phase 3: the metropolitan share (spec §5.2), beside Urban People: its label and share, an arrow toward
			### its target, and on hover the target's eight terms as bars with the effects (te_demog_mt_tooltip,
			### gui/te_demographics_metro.gui). None for a state with too few urban people; nothing before its first count.
			te_demog_figure_row = {
				visible = "[GetScriptedGui('te_demog_state_mt_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
				tooltip = "te_demog_mt_st_tt"
				tooltipwidget = {
					te_demog_mt_tooltip = {}
				}
				blockoverride "row_label" {
					text = "te_demog_mt_st"
				}
				blockoverride "row_value" {
					text = "te_demog_mt_st_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_neutral = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_mt'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_mt'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_mt'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			te_demog_figure_row = {
				visible = "[GetScriptedGui('te_demog_state_mt_none_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
				tooltip = "te_demog_mt_st_none_tt"
				blockoverride "row_label" {
					text = "te_demog_mt_st"
				}
				blockoverride "row_value" {
					text = "te_demog_mt_st_none_value"
				}
			}
			### Phase 3: the Calendar / Biological toggle, where the biological bands exist (a GUI flag, no script state)
			button = {
				visible = "[GetScriptedGui('te_demog_lx_state_bio_pyr_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
				using = default_button_action
				size = { 220 24 }
				parentanchor = hcenter
				onclick = "[GetVariableSystem.Toggle('te_demog_st_pyr_bio_open')]"
				tooltip = "te_demog_pyr_toggle_tt"

				textbox = {
					visible = "[Not(GetVariableSystem.Exists('te_demog_st_pyr_bio_open'))]"
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 210
					elide = right
					using = te_demog_fontsize_row
					text = "te_demog_pyr_show_bio"
				}
				textbox = {
					visible = "[GetVariableSystem.Exists('te_demog_st_pyr_bio_open')]"
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 210
					elide = right
					using = te_demog_fontsize_row
					text = "te_demog_pyr_show_cal"
				}
			}
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 12

				textbox = {
					autoresize = yes
					minimumsize = { 196 -1 }
					maximumsize = { 196 -1 }
					align = right|nobaseline
					using = te_demog_fontsize_row
					default_format = "#title"
					text = "te_demog_pyr_men"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 64 -1 }
					maximumsize = { 64 -1 }
					align = hcenter|nobaseline
					using = te_demog_fontsize_row
					default_format = "#title"
					text = "te_demog_pyr_age"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 196 -1 }
					maximumsize = { 196 -1 }
					align = left|nobaseline
					using = te_demog_fontsize_row
					default_format = "#title"
					text = "te_demog_pyr_women"
				}
			}
			### Phase 3 (the late-game design §6.2): calendar ages, or biological ages where the bands exist (each cohort's
			### treated part at its biological band); the subtab's own flag (te_demog_st_pyr_bio_open: the biological view, off until opened)
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 3
				visible = "[Not( And( GetVariableSystem.Exists('te_demog_st_pyr_bio_open'), GetScriptedGui('te_demog_lx_state_bio_pyr_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ) ) )]"

				te_demog_pyramid_row = {
					blockoverride "row_tooltip" {
						tooltip = "te_demog_st_pyr_tt_17"
					}
					blockoverride "band_label" {
						raw_text = "85+"
					}
					blockoverride "next_visible" {
						visible = no
					}
					blockoverride "men_range" {
						min = "[Negate_float( FixedPointToFloat( State.MakeScope.Var('te_dg_pyr_max').GetValue ) )]"
						max = 0
					}
					blockoverride "women_range" {
						min = 0
						max = "[FixedPointToFloat( State.MakeScope.Var('te_dg_pyr_max').GetValue )]"
					}
					blockoverride "men_now" {
						value = "[Negate_float( FixedPointToFloat( State.MakeScope.Var('te_dg_bm17').GetValue ) )]"
					}
					blockoverride "women_now" {
						value = "[FixedPointToFloat( State.MakeScope.Var('te_dg_bf17').GetValue )]"
					}
				}
				te_demog_pyramid_row = {
