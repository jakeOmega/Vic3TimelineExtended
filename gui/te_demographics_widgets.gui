	### How Demographics Works: every explanation, collapsed by default, one
	### heading per topic (rule 1).
	type te_demog_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_how"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_demog_how_open')]"
			}
		}

		te_demog_panel = {
			visible = "[GetVariableSystem.Exists('te_demog_how_open')]"

			te_demog_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_census"
				}
			}
			te_demog_note = {
				text = "te_demog_how_census"
			}
			te_demog_note = {
				text = "te_demog_how_applied"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_fertility"
				}
			}
			te_demog_note = {
				text = "te_demog_how_fertility"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_mortality"
				}
			}
			te_demog_note = {
				text = "te_demog_how_mortality"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_outline"
				}
			}
			te_demog_note = {
				text = "te_demog_how_outline"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_migration"
				}
			}
			te_demog_note = {
				text = "te_demog_how_migration"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_wealth"
				}
			}
			te_demog_note = {
				text = "te_demog_how_gini"
			}
			te_demog_note = {
				text = "te_demog_how_wc"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_places"
				}
			}
			te_demog_note = {
				text = "te_demog_how_places"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_sources"
				}
			}
			te_demog_note = {
				text = "te_demog_how_sources"
			}
		}
	}

	### ======================================================================
	### THE TAB
	### ======================================================================

	### The sections in their one order; gui/pops_overview.gui instances this
	### once. A fixed 520 width (rule 8). Until the country's first census
	### (te_pops_demog_tab_unlock_sgui's is_valid) one line says when it comes:
	### the tab is greyed then, but a panel reopened on it still shows the
	### line. The system has no journal entry, so there is no Open Journal
	### Entry button (rule 9).
	type te_demog_tab_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 10
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }

		te_demog_panel = {
			visible = "[Not( GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"

			te_demog_text = {
				text = "te_demog_pending"
			}
		}

		flowcontainer = {
			visible = "[GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 10

			te_demog_overview = {}
			te_demog_sec_pyramid = {}
			te_demog_sec_wealth = {}
			te_demog_sec_places = {}
			te_demog_sec_states = {}
			te_demog_sec_history = {}
		}

		te_demog_sec_how = {}
	}

	### ======================================================================
	### THE STATE PANEL'S DEMOGRAPHICS SUBTAB (plan Task 14)
	### ======================================================================
	###
	### The state's own census, as a fourth subtab of the state panel's
	### Population tab (gui/states_panel.gui instances te_state_demog_content
	### once). It reuses the building blocks and the pyramid row above, with the
	### state's figures: State.MakeScope.Var(...), never the player's. A state
	### has no outline twenty years ahead (the projection is the player's
	### country's), so its pyramid has none, and no history (nothing keeps one
	### per state). Every read sits under a state-scope gate
	### (te_demog_state_census_sgui, _wealth_sgui and _stepped_sgui in
	### common/scripted_guis/te_demog_sguis.txt, each called with
	### GuiScope.SetRoot( State.MakeScope ).End): a state with no census shows
	### "Census pending". Do not reuse te_demog_sec_wealth here: its strata
	### cells need the Population panel's PopsOverviewPanel context.
	###
	### Sections: te_state_demog_overview (the figures), te_state_demog_pyramid,
	### te_state_demog_wealth (the Gini, Wealth Concentration and its target) and
	### te_state_demog_how (collapsed). Three flags of this subtab's own, so
	### collapsing the Population panel's sections leaves these alone:
	### te_demog_st_pyr_closed and te_demog_st_wealth_closed (open by default)
	### and te_demog_st_how_open (collapsed by default).

	### The state's figures. The Gini and Wealth Concentration are in the Wealth
	### section; net migration and the births and deaths in the hovers need a
	### stepped census (a seed's flows are 0).
	type te_state_demog_overview = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

		te_demog_panel = {
			te_demog_text = {
				default_format = "#tooltippable"
				text = "te_demog_st_census"
				tooltip = "te_demog_st_census_tt"
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_median_tt"
				blockoverride "row_label" {
					text = "te_demog_ov_median"
				}
				blockoverride "row_value" {
					text = "te_demog_st_median_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_neutral = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_median'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_median'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_median'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_tfr_tt"
				blockoverride "row_label" {
					text = "te_demog_ov_tfr"
				}
				blockoverride "row_value" {
					text = "te_demog_st_tfr_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_neutral = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_tfr'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_tfr'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_tfr'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_e0_tt"
				blockoverride "row_label" {
					text = "te_demog_ov_e0"
				}
				blockoverride "row_value" {
					text = "te_demog_st_e0_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_good_up = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_e0'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_e0'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_e0'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_dependency_tt"
				blockoverride "row_label" {
					text = "te_demog_ov_dependency"
				}
				blockoverride "row_value" {
					text = "te_demog_st_dependency_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_good_down = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_dependency'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_dependency'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_dependency'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_sex_tt"
				blockoverride "row_label" {
					text = "te_demog_ov_sex"
				}
				blockoverride "row_value" {
					text = "te_demog_st_sex_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_neutral = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_mig_tt"
				blockoverride "row_label" {
					text = "te_demog_st_mig"
				}
				blockoverride "row_value" {
					text = "[SelectLocalization( GetScriptedGui('te_demog_state_stepped_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_mig_value', 'te_demog_st_next' )]"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_st_urban_tt"
				blockoverride "row_label" {
					text = "te_demog_st_urban"
				}
				blockoverride "row_value" {
					text = "te_demog_st_urban_value"
				}
			}
		}
	}

	### The state's pyramid: the same row as the country's, 85 and over at the
	### top, on the state's own scale (te_demog_state_pyramid_max, the largest
	### of its 36 bands) and without the outline (next_visible off, so the
	### outline bars are never drawn). The overrides of men_range and
	### women_range reach both bars of each side.
	type te_state_demog_pyramid = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_pyramid"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_st_pyr_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_st_pyr_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_st_pyr_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_st_pyr_closed'))]"

			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 12

				textbox = {
					autoresize = yes
					minimumsize = { 196 -1 }
					maximumsize = { 196 -1 }
					align = right|nobaseline
					using = fontsize_small
					default_format = "#title"
					text = "te_demog_pyr_men"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 64 -1 }
					maximumsize = { 64 -1 }
					align = hcenter|nobaseline
					using = fontsize_small
					default_format = "#title"
					text = "te_demog_pyr_age"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 196 -1 }
					maximumsize = { 196 -1 }
					align = left|nobaseline
					using = fontsize_small
					default_format = "#title"
					text = "te_demog_pyr_women"
				}
			}
			te_demog_pyramid_row = {
				blockoverride "row_tooltip" {
					tooltip = "te_demog_st_pyr_tt_17"
				}
				blockoverride "band_label" {
					raw_text = "85+"
				}
				blockoverride "next_visible" {
					visible = no
				}
				blockoverride "men_range" {
