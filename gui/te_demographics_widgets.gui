					}
				}
			}
		}
	}

	### Causes of Death (issue #1029; the state subtab's since the owner's 2026-10-11 design): the state's. First
	### last year's deaths per 1,000 people, then the pie of those deaths by cause and its legend (rule 5): the
	### census's own deaths split by an estimate over its bands (te_demog_cause_deaths_estimate), childbirth's, the
	### deaths added on top under Full, the war dead and the people killed by events as counted. Each legend row's
	### hover gives its cause's rate against a poor country's and what sets it, the factors the census multiplies.
	### Then Health Care Access with where it is heading. Open by default (rule 1), its own flag.
	### The pie waits for a count with deaths by cause (te_demog_state_dc_sgui); until then one line.
	type te_state_demog_causes = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_causes"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_st_causes_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_st_causes_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_st_causes_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_st_causes_closed'))]"

			### Deaths per 1,000 people last year, which the pie below splits
			te_demog_figure_row = {
				tooltip = "te_demog_st_cdr_tt"
				blockoverride "row_label" {
					text = "te_demog_cd_cdr"
				}
				blockoverride "row_value" {
					text = "[SelectLocalization( GetScriptedGui('te_demog_state_stepped_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_cdr_value', 'te_demog_ov_pending' )]"
				}
			}
			te_demog_text = {
				visible = "[Not( GetScriptedGui('te_demog_state_dc_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ) )]"
				text = "te_demog_st_dc_pending"
			}
			### The pie and its legend: last year's deaths by cause
			flowcontainer = {
				visible = "[GetScriptedGui('te_demog_state_dc_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
				direction = horizontal
				ignoreinvisible = yes
				spacing = 8

				te_demog_cause_pie = {
					parentanchor = vcenter
					tooltip = "te_demog_st_pie_tt"
					blockoverride "cum_1" {
						value = "[FixedPointToFloat( State.MakeScope.ScriptValue('te_demog_dc_cum_1') )]"
					}
					blockoverride "cum_2" {
						value = "[FixedPointToFloat( State.MakeScope.ScriptValue('te_demog_dc_cum_2') )]"
					}
					blockoverride "cum_3" {
						value = "[FixedPointToFloat( State.MakeScope.ScriptValue('te_demog_dc_cum_3') )]"
					}
					blockoverride "cum_4" {
						value = "[FixedPointToFloat( State.MakeScope.ScriptValue('te_demog_dc_cum_4') )]"
					}
					blockoverride "cum_5" {
						value = "[FixedPointToFloat( State.MakeScope.ScriptValue('te_demog_dc_cum_5') )]"
					}
					blockoverride "cum_6" {
						value = "[FixedPointToFloat( State.MakeScope.ScriptValue('te_demog_dc_cum_6') )]"
					}
					blockoverride "cum_7" {
						value = "[FixedPointToFloat( State.MakeScope.ScriptValue('te_demog_dc_cum_7') )]"
					}
				}
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					parentanchor = vcenter

					te_demog_cause_head = {}
					te_demog_cause_row = {
						tooltip = "te_demog_st_dc_inf_tt"
						blockoverride "swatch" {
							texture = "gfx/interface/icons/demographics_icons/pie_infection.dds"
						}
						blockoverride "cause" {
							text = "te_demog_dc_inf"
						}
						blockoverride "deaths" {
							text = "[State.MakeScope.Var('te_dg_dc_inf').GetValue|K]"
						}
						blockoverride "share" {
							text = "[State.MakeScope.ScriptValue('te_demog_dc_share_inf')|%0]"
						}
					}
					te_demog_cause_row = {
						tooltip = "te_demog_st_dc_chr_tt"
						blockoverride "swatch" {
							texture = "gfx/interface/icons/demographics_icons/pie_chronic.dds"
						}
						blockoverride "cause" {
							text = "te_demog_dc_chr"
						}
						blockoverride "deaths" {
							text = "[State.MakeScope.Var('te_dg_dc_chr').GetValue|K]"
						}
						blockoverride "share" {
							text = "[State.MakeScope.ScriptValue('te_demog_dc_share_chr')|%0]"
						}
					}
					te_demog_cause_row = {
						tooltip = "te_demog_st_dc_ext_tt"
						blockoverride "swatch" {
							texture = "gfx/interface/icons/demographics_icons/pie_external.dds"
						}
						blockoverride "cause" {
							text = "te_demog_dc_ext"
						}
						blockoverride "deaths" {
							text = "[State.MakeScope.Var('te_dg_dc_ext').GetValue|K]"
						}
						blockoverride "share" {
							text = "[State.MakeScope.ScriptValue('te_demog_dc_share_ext')|%0]"
						}
					}
					te_demog_cause_row = {
						tooltip = "te_demog_st_dc_work_tt"
						blockoverride "swatch" {
							texture = "gfx/interface/icons/demographics_icons/pie_work.dds"
						}
						blockoverride "cause" {
							text = "te_demog_dc_work"
						}
						blockoverride "deaths" {
							text = "[State.MakeScope.Var('te_dg_dc_work').GetValue|K]"
						}
						blockoverride "share" {
							text = "[State.MakeScope.ScriptValue('te_demog_dc_share_work')|%0]"
						}
					}
					te_demog_cause_row = {
						tooltip = "te_demog_st_dc_mat_tt"
						blockoverride "swatch" {
							texture = "gfx/interface/icons/demographics_icons/pie_maternal.dds"
						}
						blockoverride "cause" {
							text = "te_demog_dc_mat"
						}
						blockoverride "deaths" {
							text = "[State.MakeScope.Var('te_dg_dc_mat').GetValue|K]"
						}
						blockoverride "share" {
							text = "[State.MakeScope.ScriptValue('te_demog_dc_share_mat')|%0]"
						}
					}
					te_demog_cause_row = {
						visible = "[GetScriptedGui('te_demog_state_full_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
						tooltip = "te_demog_st_dc_ontop_tt"
						blockoverride "swatch" {
							texture = "gfx/interface/icons/demographics_icons/pie_on_top.dds"
						}
						blockoverride "cause" {
							text = "te_demog_dc_ontop"
						}
						blockoverride "deaths" {
							text = "[State.MakeScope.Var('te_dg_dc_ontop').GetValue|K]"
						}
						blockoverride "share" {
							text = "[State.MakeScope.ScriptValue('te_demog_dc_share_ontop')|%0]"
						}
					}
					te_demog_cause_row = {
						tooltip = "te_demog_st_dc_kill_tt"
						blockoverride "swatch" {
							texture = "gfx/interface/icons/demographics_icons/pie_killed.dds"
						}
						blockoverride "cause" {
							text = "te_demog_dc_kill"
						}
						blockoverride "deaths" {
							text = "[State.MakeScope.Var('te_dg_dc_kill').GetValue|K]"
						}
						blockoverride "share" {
							text = "[State.MakeScope.ScriptValue('te_demog_dc_share_kill')|%0]"
						}
					}
					te_demog_cause_row = {
						tooltip = "te_demog_st_dc_war_tt"
						blockoverride "swatch" {
							texture = "gfx/interface/icons/demographics_icons/pie_war.dds"
						}
						blockoverride "cause" {
							text = "te_demog_dc_war"
						}
						blockoverride "deaths" {
