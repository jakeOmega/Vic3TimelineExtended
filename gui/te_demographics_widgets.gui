	### Fighting-Age Men (phase 2 step 4; docs/superpowers/archive/specs/2026-10-12-demographics-phase2-consequences-design.md
	### §4.5): the pool, men aged 20 to 39, as a share of the men, and the conscription multiplier it gives, with the
	### pool and the term on hover (while te_demog_k_conscription_effects is 0, "not applied yet"). The last row of step 2's Work
	### and Retirement section, te_demog_sec_work and te_state_demog_work. A census from before step 4 shows the pending
	### text until its next count. Fits the figure row's cells:
	### "Fighting-Age Men" is 16 characters, about 150 units; "100% (×1.25)" 12, about 115.
	type te_demog_fam_row = te_demog_figure_row {
		tooltip = "te_demog_ov_fam_tt"
		blockoverride "row_label" {
			text = "te_demog_fam"
		}
		blockoverride "row_value" {
			text = "[SelectLocalization( GetScriptedGui('te_demog_pool_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_demog_ov_fam_value', 'te_demog_ov_pending' )]"
		}
	}

	type te_state_demog_fam_row = te_demog_figure_row {
		tooltip = "te_demog_st_fam_tt"
		blockoverride "row_label" {
			text = "te_demog_fam"
		}
		blockoverride "row_value" {
			text = "[SelectLocalization( GetScriptedGui('te_demog_state_pool_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_fam_value', 'te_demog_st_next' )]"
		}
	}

	### The population pyramid: 18 five-year bands, 85 and over at the top, men
	### left and women right, all on one scale (te_dg_pyr_max, te_demog_pyramid_max
	### stored at the census: the largest band now or in the outline). The outline twenty years ahead shows while
	### the player's country has one (te_demog_outline_ready_sgui).
	type te_demog_sec_pyramid = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_pyramid"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_pyr_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_pyr_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_pyr_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_pyr_closed'))]"

			### issue #1029: the sex balance, from the overview (men per 100 women aged 20-59)
			te_demog_figure_row = {
				tooltip = "te_demog_ov_sex_tt"
				blockoverride "row_label" {
					text = "te_demog_ov_sex"
				}
				blockoverride "row_value" {
					text = "te_demog_ov_sex_value"
				}
				blockoverride "row_trend" {
					te_demog_trend_neutral = {
						blockoverride "trend_up" {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)1' )]"
						}
						blockoverride "trend_down" {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)-1' )]"
						}
						blockoverride "trend_level" {
							visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_demog_trend_sex_balance'), '(CFixedPoint)0' )]"
						}
					}
				}
			}
			### Phase 3: the Calendar / Biological toggle, where the biological bands exist (a GUI flag, no script state)
			button = {
				visible = "[GetScriptedGui('te_demog_lx_bio_pyr_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				using = default_button_action
				size = { 220 24 }
				parentanchor = hcenter
				onclick = "[GetVariableSystem.Toggle('te_demog_pyr_bio_open')]"
				tooltip = "te_demog_pyr_toggle_tt"

				textbox = {
					visible = "[Not(GetVariableSystem.Exists('te_demog_pyr_bio_open'))]"
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 210
					elide = right
					using = te_demog_fontsize_row
					text = "te_demog_pyr_show_bio"
				}
				textbox = {
					visible = "[GetVariableSystem.Exists('te_demog_pyr_bio_open')]"
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 210
					elide = right
					using = te_demog_fontsize_row
					text = "te_demog_pyr_show_cal"
				}
			}
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 12

				textbox = {
					autoresize = yes
					minimumsize = { 196 -1 }
					maximumsize = { 196 -1 }
					align = right|nobaseline
					using = te_demog_fontsize_row
					default_format = "#title"
					text = "te_demog_pyr_men"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 64 -1 }
					maximumsize = { 64 -1 }
					align = hcenter|nobaseline
					using = te_demog_fontsize_row
					default_format = "#title"
					text = "te_demog_pyr_age"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 196 -1 }
					maximumsize = { 196 -1 }
					align = left|nobaseline
					using = te_demog_fontsize_row
					default_format = "#title"
					text = "te_demog_pyr_women"
				}
			}
			### Phase 3 (the late-game design §6.2): calendar ages, or biological ages where the bands exist (each cohort's
			### treated part at its biological band); the tab's own flag (te_demog_pyr_bio_open: the biological view, off until opened)
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 3
				visible = "[Not( And( GetVariableSystem.Exists('te_demog_pyr_bio_open'), GetScriptedGui('te_demog_lx_bio_pyr_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"

				te_demog_pyramid_row = {
					blockoverride "row_tooltip" {
						tooltip = "[SelectLocalization( GetScriptedGui('te_demog_outline_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_demog_pyr_tt_17', 'te_demog_pyr_tt_now_17' )]"
