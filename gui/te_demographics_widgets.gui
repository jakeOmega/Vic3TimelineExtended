	### The state's Gini, then its Wealth Concentration as a bar heading for its
	### target in the country tab's layers (te_demog_sec_wealth): a background; a
	### pale segment to the higher of score and target; the solid fill to the
	### lower; a thin line at 50. Pale = neutral (rule 5). The score and its
	### target exist once the state has been scored (te_demog_state_wealth_sgui);
	### until then one line.
	type te_state_demog_wealth = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_wealth"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_st_wealth_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_st_wealth_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_st_wealth_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_st_wealth_closed'))]"

			te_demog_figure_row = {
				tooltip = "te_demog_st_gini_tt"
				blockoverride "row_label" {
					text = "te_demog_ov_gini"
				}
				blockoverride "row_value" {
					text = "te_demog_st_gini_value"
				}
			}

			te_demog_text = {
				visible = "[Not( GetScriptedGui('te_demog_state_wealth_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ) )]"
				text = "te_demog_st_wealth_pending"
			}

			flowcontainer = {
				visible = "[GetScriptedGui('te_demog_state_wealth_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 3

				te_demog_figure_row = {
					tooltip = "te_demog_st_wc_tt"
					blockoverride "row_label" {
						text = "te_demog_ov_wc"
					}
					blockoverride "row_value" {
						text = "te_demog_st_wc_value"
					}
				}

				widget = {
					size = { 480 18 }
					tooltip = "te_demog_wc_bar_tt"

					default_progressbar_horizontal = {
						size = { 100% 100% }
						blockoverride "values" {
							value = 0
							min = 0
							max = 1
						}
					}
					widget = {
						size = { 100% 100% }
						alpha = 0.4

						default_progressbar_horizontal = {
							size = { 100% 100% }
							blockoverride "background" {}
							blockoverride "frame" {}
							blockoverride "values" {
								value = "[FixedPointToFloat( Max_CFixedPoint( State.MakeScope.Var('te_dg_wc').GetValue, State.MakeScope.Var('te_dg_wc_target').GetValue ) )]"
								min = 0
								max = 100
							}
						}
					}
					default_progressbar_horizontal = {
						size = { 100% 100% }
						blockoverride "background" {}
						blockoverride "frame" {}
						blockoverride "values" {
							value = "[FixedPointToFloat( Min_CFixedPoint( State.MakeScope.Var('te_dg_wc').GetValue, State.MakeScope.Var('te_dg_wc_target').GetValue ) )]"
							min = 0
							max = 100
						}
					}
					icon = {
						size = { 3 24 }
						parentanchor = center
						texture = "gfx/interface/backgrounds/white.dds"
						color = { 0.96 0.90 0.72 0.95 }
						tooltip = "te_demog_wc_line_tt"
					}
				}
			}
		}
	}

	### How Demographics Works on the state panel: the country tab's topics that
	### apply to one state (the outline and the national urban pattern do not),
	### from the same loc, collapsed by default (its own flag, te_demog_st_how_open).
	type te_state_demog_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_how"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_st_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_st_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_demog_st_how_open')]"
			}
		}

		te_demog_panel = {
			visible = "[GetVariableSystem.Exists('te_demog_st_how_open')]"

			te_demog_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_census"
				}
			}
			te_demog_note = {
				text = "te_demog_how_census"
			}
			te_demog_note = {
				text = "te_demog_how_applied"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_fertility"
				}
			}
			te_demog_note = {
				text = "te_demog_how_fertility"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_mortality"
				}
			}
			te_demog_note = {
				text = "te_demog_how_mortality"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_migration"
				}
			}
			te_demog_note = {
				text = "te_demog_how_migration"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_wealth"
				}
			}
			te_demog_note = {
				text = "te_demog_how_gini"
			}
			te_demog_note = {
				text = "te_demog_how_wc"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_sources"
				}
			}
			te_demog_note = {
				text = "te_demog_how_sources"
			}
		}
	}

	### The subtab: the sections in their one order, at a fixed 520 (rule 8). A
	### state with no census shows "Census pending" and the collapsed
	### explanation. The system has no journal entry, so no Open Journal Entry
	### button (rule 9).
	type te_state_demog_content = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 10
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }

		te_demog_panel = {
			visible = "[Not( GetScriptedGui('te_demog_state_census_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ) )]"

			te_demog_text = {
				text = "te_demog_st_pending"
			}
		}

		flowcontainer = {
			visible = "[GetScriptedGui('te_demog_state_census_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 10

			te_state_demog_overview = {}
			te_state_demog_pyramid = {}
			te_state_demog_wealth = {}
		}

		te_state_demog_how = {}
	}
}
