### Demographics: the census as a tab of the Population panel
### (docs/superpowers/specs/2026-10-08-demographics-design.md §10; plan Task 13).
###
### gui/pops_overview.gui, a full-file override re-merged every vanilla patch,
### holds one instance of te_demog_tab_sections in its fifth tab (te_demog);
### every section is a type here (gui_style_guide.md rule 9), so the state
### panel's Demographics subtab (Task 14) composes the same pieces. In order:
###   te_demog_overview         always shown: the census year and eight figures,
###                             each "Label: value" with a trend arrow
###   te_demog_sec_pyramid      open: 18 five-year bands, men left, women right,
###                             with the outline twenty years ahead
###   te_demog_sec_wealth       open: the Gini beside the strata's incomes, Wealth
###                             Concentration as a bar heading for its target, the
###                             target's five terms, the most and least
###                             concentrated states
###   te_demog_sec_places       open: urban share, primacy, the effective number
###                             of cities, the pattern, the three largest cities
###   te_demog_sec_states       open: a row per state, from te_dg_states
###   te_demog_sec_history      open: median age, children per woman and life
###                             expectancy by census year
###   te_demog_sec_how          collapsed: How Demographics Works
###
### The state panel's Demographics subtab (plan Task 14) composes the same
### blocks into te_state_demog_content, at the end of this file.
###
### EDITING RULES
### * No Scope in GUI can ask whether a variable exists, and reading a missing
###   one logs every frame (gui_modding_guide.md gotchas #14 and #23). Every
###   figure is read under a gate that asks script: the census
###   (te_pops_demog_tab_unlock_sgui's IsValid, te_dg_census_year), Wealth
###   Concentration's national figures (te_demog_wealth_ready_sgui), the outline
###   (te_demog_outline_ready_sgui), the capital's census
###   (te_demog_capital_census_sgui) and a stepped census for births and deaths
###   (te_demog_stepped_sgui); common/scripted_guis/te_demog_sguis.txt. A loc key
###   that reads a gated figure is picked by SelectLocalization on the gate, so
###   the branch not taken is never rendered.
### * Country figures read GetPlayer.MakeScope.Var('te_dg_x').GetValue; a state
###   row's, State.MakeScope.Var(...). Never SCOPE.sCountry(...), which printed
###   wrong values in the 2026-10-08 probe (scripting_best_practices.md).
### * A trend arrow tests a te_demog_trend_* code (te_demog_display_values.txt)
###   for identity (gotcha #23): 1 rose, -1 fell, 0 level, 2 none.
### * A tooltip inside a datamodel row reads only that row's State (gotcha #24);
###   a history bar's, only its ScriptContainer.
### * Collapse flags say their default: *_closed sections start open, *_open
###   ones collapsed (gui_style_guide.md rule 7).
### * @panel_width constants are file-scoped in vanilla, so the sizes here are
###   literals: 520 sections, a 480 column inside a 20 px margin (rule 8).

types te_demographics_widgets
{
	### ======================================================================
	### BUILDING BLOCKS (Grand Monuments' shapes, grand_monuments_widget.gui)
	### ======================================================================

	type te_demog_panel = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 8 }
		spacing = 3

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	type te_demog_section_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 520 38 }
		}
	}

	### A heading inside a section's panel, over one group of its lines, with a
	### faint rule under it.
	type te_demog_subheader = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		block "subheader_margin" {
			margin_top = 10
		}

		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 480 -1 }
			align = left|nobaseline
			using = fontsize_large
			default_format = "#title"
			block "subheader_text" {}
		}
		divider_clean = {
			blockoverride "size" {
				size = { 480 2 }
			}
		}
	}

	### Explanatory text under a heading in How Demographics Works.
	type te_demog_note = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_medium
		default_format = "#lore"
	}

	### A live line of text across the panel.
	type te_demog_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_medium
	}

	### A figure: its label (hover the row for what it means and last year's
	### figure), its value and a trend arrow. Fixed cells, 240 + 200 + 24 and
	### two 8 px gaps = 480, so a long label or value cannot widen the row:
	### "Wealth Concentration" is 20 characters, about 190 units in the medium
	### font; "100 men per 100 women", 21, about 200.
	type te_demog_figure_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 8

		textbox = {
			autoresize = yes
			minimumsize = { 240 -1 }
			maximumsize = { 240 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = fontsize_medium
			default_format = "#tooltippable"
			elide = right
			block "row_label" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 200 -1 }
			maximumsize = { 200 -1 }
			parentanchor = vcenter
			align = right|nobaseline
			using = fontsize_medium
			elide = right
			block "row_value" {}
		}
		widget = {
			size = { 24 22 }
			parentanchor = vcenter
			block "row_trend" {}
		}
	}

	### Trend arrows. The instance sets each icon's `visible` from a
	### te_demog_trend_* code. Three flavours, by whether the direction is good
	### for the player (gui_style_guide.md rule 5: green good, red bad,
	### whatever the direction):
	###   te_demog_trend_good_up    life expectancy: rising green, falling orange
	###   te_demog_trend_good_down  the dependency ratio: vanilla's arrows turned
	###                             over (mirror = vertical), so a rise is an
	###                             orange arrow pointing up
	###   te_demog_trend_neutral    a figure whose direction is neither good nor
	###                             bad in itself (median age, children per
	###                             woman, sex balance, urban share): a bronze
	###                             chevron, the politics summary's arrow, so the
	###                             colour claims nothing
	type te_demog_trend_good_up = widget {
		size = { 24 22 }

		icon = {
			size = { 20 20 }
			parentanchor = center
			texture = "gfx/interface/icons/generic_icons/trend_up.dds"
			block "trend_up" {}
		}
		icon = {
			size = { 20 20 }
			parentanchor = center
			texture = "gfx/interface/icons/generic_icons/trend_down.dds"
			block "trend_down" {}
		}
		icon = {
			size = { 8 20 }
			parentanchor = center
			texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
			block "trend_level" {}
		}
	}

	type te_demog_trend_good_down = widget {
		size = { 24 22 }

		icon = {
			size = { 20 20 }
			parentanchor = center
			texture = "gfx/interface/icons/generic_icons/trend_down.dds"
			mirror = vertical
			block "trend_up" {}
		}
		icon = {
			size = { 20 20 }
			parentanchor = center
			texture = "gfx/interface/icons/generic_icons/trend_up.dds"
			mirror = vertical
			block "trend_down" {}
		}
		icon = {
			size = { 8 20 }
			parentanchor = center
			texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
			block "trend_level" {}
		}
	}

	type te_demog_trend_neutral = widget {
		size = { 24 22 }

		icon = {
			size = { 18 8 }
			parentanchor = center
			texture = "gfx/interface/politics_view/summary_arrow_down.dds"
			mirror = vertical
			block "trend_up" {}
		}
		icon = {
			size = { 18 8 }
			parentanchor = center
			texture = "gfx/interface/politics_view/summary_arrow_down.dds"
			block "trend_down" {}
		}
		icon = {
			size = { 8 20 }
			parentanchor = center
			texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
			block "trend_level" {}
		}
	}

	### One five-year band of the pyramid: the men's bar growing left from the
	### centre, the band's ages, the women's bar growing right. Fixed cells,
	### 196 + 64 + 196 and two 12 px gaps = 480.
	###
	### Each bar is two layers in one 196 x 14 cell. Behind, full height and
	### pale (the bar's own colour at 35%), the band twenty years ahead; in
	### front, 8 px high and centred, the band now. So the pale band shows
	### round the solid bar as far as the outline reaches, and past its end
	### when the band will grow: where the pale stops is the band in twenty
	### years, where the solid stops is the band today. The plain rule-5 form
	### (solid to the lower of the two, pale to the higher) would draw a
	### shrinking band's solid bar at its future size, and the pyramid's first
	### job is today's shape.
	###
	### The men's bars are vanilla's REVERSE HACK (gui/shared/progressbars.gui,
	### double_direction_progressbar's left half): progress and no-progress
	### textures swapped and a range of -max .. 0, with the value negated, so
	### the coloured part runs from the value to the right-hand end.
	###
	### Blocks: "band_label" (the ages), "men_now", "women_now", "men_next",
	### "women_next" (each a `value`), "next_visible" (the outline's gate),
	### "men_range" and "women_range" (min and max; the country's
	### te_demog_pyramid_max by default, so a state's pyramid overrides them),
	### and "row_tooltip".
	type te_demog_pyramid_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 12
		block "row_tooltip" {}

		widget = {
			size = { 196 14 }
			parentanchor = vcenter

			widget = {
				size = { 196 14 }
				parentanchor = vcenter
				block "next_visible" {}

				progressbar = {
					size = { 196 14 }
					parentanchor = vcenter
					direction = horizontal
					progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					noprogresstexture = "gfx/interface/backgrounds/white.dds"
					texture_density = 2
					skip_initial_animation = yes
					alwaystransparent = yes
					color = { 0.36 0.56 0.82 0.35 }
					block "men_range" {
						min = "[Negate_float( FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('te_demog_pyramid_max') ) )]"
						max = 0
					}
					block "men_next" {}
				}
			}
			progressbar = {
				size = { 196 8 }
				parentanchor = vcenter
				direction = horizontal
				progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				noprogresstexture = "gfx/interface/backgrounds/white.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.36 0.56 0.82 1.0 }
				block "men_range" {
					min = "[Negate_float( FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('te_demog_pyramid_max') ) )]"
					max = 0
				}
				block "men_now" {}
			}
		}

		textbox = {
			autoresize = yes
			minimumsize = { 64 -1 }
			maximumsize = { 64 -1 }
			parentanchor = vcenter
			align = hcenter|nobaseline
			using = fontsize_small
			block "band_label" {}
		}

		widget = {
			size = { 196 14 }
			parentanchor = vcenter

			widget = {
				size = { 196 14 }
				parentanchor = vcenter
				block "next_visible" {}

				progressbar = {
					size = { 196 14 }
					parentanchor = vcenter
					direction = horizontal
					progresstexture = "gfx/interface/backgrounds/white.dds"
					noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					texture_density = 2
					skip_initial_animation = yes
					alwaystransparent = yes
					color = { 0.82 0.42 0.44 0.35 }
					block "women_range" {
						min = 0
						max = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('te_demog_pyramid_max') )]"
					}
					block "women_next" {}
				}
			}
			progressbar = {
				size = { 196 8 }
				parentanchor = vcenter
				direction = horizontal
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.82 0.42 0.44 1.0 }
				block "women_range" {
					min = 0
					max = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('te_demog_pyramid_max') )]"
				}
				block "women_now" {}
			}
		}
	}

	### One term of Wealth Concentration's target as a pillar (the Colonial
	### Empire's colonial_empire_pillar_row): its name, a bar either side of a
	### centre line on one shared scale of -50 .. +50, so the terms compare,
	### and its signed value. Fixed cells, 190 + 190 + 72, two 8 px gaps and
	### the 4 px margins = 476.
	###
	### The bar is drawn here rather than with vanilla's double bar, whose
	### halves are red and green: neither direction is good or bad for the
	### player in itself (rule 5), so both halves take one neutral fill. The
	### left half is the reverse hack, as the pyramid's men's bars are. Blocks:
	### "term_left" (the value, clamped to 0 or below) and "term_right" (0 or
	### above).
	type te_demog_term_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 8
		margin = { 4 1 }

		textbox = {
			autoresize = yes
			minimumsize = { 190 -1 }
			maximumsize = { 190 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = fontsize_medium
			default_format = "#tooltippable"
			elide = right
			block "row_label" {}
		}
		widget = {
			size = { 190 14 }
			parentanchor = vcenter

			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/backgrounds/white.dds"
				color = { 0.50 0.50 0.50 0.20 }
			}
			widget = {
				size = { 95 14 }
				parentanchor = left|vcenter

				progressbar = {
					size = { 95 14 }
					direction = horizontal
					progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					noprogresstexture = "gfx/interface/backgrounds/white.dds"
					texture_density = 2
					skip_initial_animation = yes
					alwaystransparent = yes
					color = { 0.78 0.68 0.46 1.0 }
					min = -50
					max = 0
					block "term_left" {}
				}
			}
			widget = {
				size = { 95 14 }
				parentanchor = right|vcenter

				progressbar = {
					size = { 95 14 }
					direction = horizontal
					progresstexture = "gfx/interface/backgrounds/white.dds"
					noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					texture_density = 2
					skip_initial_animation = yes
					alwaystransparent = yes
					color = { 0.78 0.68 0.46 1.0 }
					min = 0
					max = 50
					block "term_right" {}
				}
			}
			icon = {
				size = { 2 18 }
				parentanchor = center
				texture = "gfx/interface/backgrounds/white.dds"
				color = { 0.96 0.90 0.72 0.80 }
			}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 72 -1 }
			maximumsize = { 72 -1 }
			parentanchor = vcenter
			align = right|nobaseline
			using = fontsize_medium
			default_format = "#v"
			elide = right
			block "row_value" {}
		}
	}

	### The States table's column heads, in the small font, each with its hover.
	### Fixed cells as te_demog_state_row's.
	type te_demog_state_head = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4

		textbox = {
			autoresize = yes
			minimumsize = { 164 -1 }
			maximumsize = { 164 -1 }
			align = left|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			elide = right
			text = "te_demog_states_head_state"
			tooltip = "te_demog_states_head_state_tt"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 64 -1 }
			maximumsize = { 64 -1 }
			align = right|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			elide = right
			text = "te_demog_states_head_people"
			tooltip = "te_demog_states_head_people_tt"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			elide = right
			text = "te_demog_states_head_median"
			tooltip = "te_demog_states_head_median_tt"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			elide = right
			text = "te_demog_states_head_tfr"
			tooltip = "te_demog_states_head_tfr_tt"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			elide = right
			text = "te_demog_states_head_sex"
			tooltip = "te_demog_states_head_sex_tt"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			elide = right
			text = "te_demog_states_head_gini"
			tooltip = "te_demog_states_head_gini_tt"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			elide = right
			text = "te_demog_states_head_wc"
			tooltip = "te_demog_states_head_wc_tt"
		}
	}

	### One state of te_dg_states (datacontext State). Fixed cells, 164 + 64 +
	### 5 x 44 and six 4 px gaps = 472: the state's name shrinks to the small
	### font before it elides ("South Atlantic Islands", 22 characters, is about
	### 190 units in the medium font). The tooltip reads only State (gotcha #24).
	type te_demog_state_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		tooltip = "te_demog_state_row_tt"

		textbox = {
			autoresize = yes
			minimumsize = { 164 -1 }
			maximumsize = { 164 -1 }
			align = left|nobaseline
			using = fontsize_medium
			fontsize_min = 12
			elide = right
			text = "[State.GetNameNoFormatting]"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 64 -1 }
			maximumsize = { 64 -1 }
			align = right|nobaseline
			using = fontsize_medium
			default_format = "#v"
			text = "[State.MakeScope.Var('te_dg_people').GetValue|D]"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_medium
			default_format = "#v"
			text = "[State.MakeScope.Var('te_dg_median').GetValue|1]"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_medium
			default_format = "#v"
			text = "[State.MakeScope.Var('te_dg_tfr').GetValue|1]"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_medium
			default_format = "#v"
			text = "[State.MakeScope.Var('te_dg_sex_balance').GetValue|0]"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_medium
			default_format = "#v"
			text = "[State.MakeScope.Var('te_dg_gini').GetValue|2]"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 44 -1 }
			maximumsize = { 44 -1 }
			align = right|nobaseline
			using = fontsize_medium
			default_format = "#v"
			text = "[State.MakeScope.Var('te_dg_wc').GetValue|0]"
		}
	}

	### One of the three largest cities (te_dg_cities; datacontext State): the
	### state, which counts as one city, and its urban people. Fixed cells,
	### 300 + 176 and a 4 px gap = 480.
	type te_demog_city_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		tooltip = "te_demog_city_row_tt"

		textbox = {
			autoresize = yes
			minimumsize = { 300 -1 }
			maximumsize = { 300 -1 }
			align = left|nobaseline
			using = fontsize_medium
			fontsize_min = 12
			elide = right
			text = "[State.GetNameNoFormatting]"
		}
		textbox = {
			autoresize = yes
			minimumsize = { 176 -1 }
			maximumsize = { 176 -1 }
			align = right|nobaseline
			using = fontsize_medium
			elide = right
			text = "te_demog_city_row_value"
		}
	}

	### A cell of the Wealth section's first row: a small heading over a figure.
	### 120 wide for the Gini, 112 for each stratum's income: 120 + 3 x 112 and
	### three 8 px gaps = 480.
	type te_demog_wealth_cell = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		block "cell_size" {
			minimumsize = { 112 -1 }
			maximumsize = { 112 -1 }
		}

		textbox = {
			autoresize = yes
			parentanchor = hcenter
			align = hcenter|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			block "cell_label" {}
		}
		textbox = {
			autoresize = yes
			parentanchor = hcenter
			align = hcenter|nobaseline
			using = fontsize_medium
			block "cell_value" {}
		}
	}

	### ======================================================================
	### SECTIONS
	### ======================================================================

	### The overview: always shown, no header (rule 1). The census year, then
	### the eight figures, each with its trend against last year's. The Gini has
	### no arrow (the census keeps no last year's Gini); Wealth Concentration's
	### value says where it is heading instead ("62 → 68", rule 5). The Gini and
	### the urban pattern pick their loc by gate, so a figure not yet written
	### is never read.
	type te_demog_overview = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

