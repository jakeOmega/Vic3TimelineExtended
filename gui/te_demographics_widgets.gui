	### Work and Retirement (phase 2 step 2; docs/superpowers/archive/specs/2026-10-12-demographics-phase2-consequences-design.md
	### §2.6, late-game §6.2): open by default (rule 1), flag te_demog_work_closed. The workforce as the working-age
	### share times the share at work; under Old Age Pension the pension age with its five buttons beside it (rule 6),
	### the pensioners and, under Full, the pension bill; health need. Every figure sits under te_demog_work_ready_sgui
	### (a census from before this build waits a count), the pension rows under te_demog_pension_law_sgui, the bill
	### under te_demog_pension_bill_sgui. What greys every button is said once above them (rule 6): outside Full, or a
	### five-year term running; each button's tooltip still names its own failing condition. Values fit the 200-unit
	### cell: "84 (Linked to Average)" is the longest, 22 characters, about 190 in the medium font.
	type te_demog_sec_work = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_work"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_work_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_work_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_work_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_work_closed'))]"

			te_demog_text = {
				visible = "[Not( GetScriptedGui('te_demog_work_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "te_demog_wk_pending"
			}

			flowcontainer = {
				visible = "[GetScriptedGui('te_demog_work_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 3

				te_demog_figure_row = {
					tooltip = "te_demog_wk_workforce_tt"
					blockoverride "row_label" {
						text = "te_demog_wk_workforce"
					}
					blockoverride "row_value" {
						text = "te_demog_wk_workforce_value"
					}
				}
				### issue #1029: from the overview; phase 3 (§1.5): "None" once no age has fifteen years left
				te_demog_figure_row = {
					tooltip = "[SelectLocalization( GetScriptedGui('te_demog_lx_old_c_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_demog_ov_old_age_tt_late', 'te_demog_ov_old_age_tt' )]"
					blockoverride "row_label" {
						text = "te_demog_ov_old_age"
					}
					blockoverride "row_value" {
						text = "te_demog_ov_old_age_value"
					}
				}

				flowcontainer = {
					visible = "[GetScriptedGui('te_demog_pension_law_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					direction = vertical
					ignoreinvisible = yes
					spacing = 3

					te_demog_figure_row = {
						tooltip = "te_demog_wk_pension_age_tt"
						blockoverride "row_label" {
							text = "te_demog_wk_pension_age"
						}
						blockoverride "row_value" {
							text = "te_demog_wk_pension_age_value"
						}
					}
					te_demog_text = {
						visible = "[Not( GetScriptedGui('te_demog_work_full_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						default_format = "#grey"
						text = "te_demog_wk_buttons_full_only"
					}
					te_demog_text = {
						visible = "[And( GetScriptedGui('te_demog_work_full_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('te_demog_pension_term_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						default_format = "#grey"
						text = "te_demog_wk_buttons_term"
					}
					flowcontainer = {
						direction = horizontal
						parentanchor = hcenter
						spacing = 6

						te_demog_pension_button = {
							blockoverride "pension_context" { datacontext = "[GetScriptedGui('te_demog_pension_early_sgui')]" }
							blockoverride "pension_tooltip" { tooltip = "te_demog_pension_early_tt" }
							blockoverride "pension_text" { text = "te_demog_pension_early_button" }
						}
						te_demog_pension_button = {
							blockoverride "pension_context" { datacontext = "[GetScriptedGui('te_demog_pension_standard_sgui')]" }
							blockoverride "pension_tooltip" { tooltip = "te_demog_pension_standard_tt" }
							blockoverride "pension_text" { text = "te_demog_pension_standard_button" }
						}
						te_demog_pension_button = {
							blockoverride "pension_context" { datacontext = "[GetScriptedGui('te_demog_pension_raised_sgui')]" }
							blockoverride "pension_tooltip" { tooltip = "te_demog_pension_raised_tt" }
							blockoverride "pension_text" { text = "te_demog_pension_raised_button" }
						}
					}
					flowcontainer = {
						direction = horizontal
						parentanchor = hcenter
						spacing = 6

						te_demog_pension_button = {
							blockoverride "pension_context" { datacontext = "[GetScriptedGui('te_demog_pension_linked_average_sgui')]" }
							blockoverride "pension_tooltip" { tooltip = "te_demog_pension_linked_average_tt" }
							blockoverride "pension_text" { text = "te_demog_pension_linked_average_button" }
						}
						te_demog_pension_button = {
							blockoverride "pension_context" { datacontext = "[GetScriptedGui('te_demog_pension_linked_common_sgui')]" }
							blockoverride "pension_tooltip" { tooltip = "te_demog_pension_linked_common_tt" }
							blockoverride "pension_text" { text = "te_demog_pension_linked_common_button" }
						}
					}
					te_demog_figure_row = {
						tooltip = "te_demog_wk_pensioners_tt"
						blockoverride "row_label" {
							text = "te_demog_wk_pensioners"
						}
						blockoverride "row_value" {
							text = "te_demog_wk_pensioners_value"
						}
					}
					te_demog_figure_row = {
						visible = "[GetScriptedGui('te_demog_pension_bill_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						tooltip = "te_demog_wk_bill_tt"
						blockoverride "row_label" {
							text = "te_demog_wk_bill"
						}
						blockoverride "row_value" {
							text = "te_demog_wk_bill_value"
						}
					}
				}

				te_demog_figure_row = {
					tooltip = "te_demog_wk_need_tt"
					blockoverride "row_label" {
						text = "te_demog_wk_need"
					}
					blockoverride "row_value" {
						text = "te_demog_wk_need_value"
					}
				}
				### phase 2 step 4 (the consequences design §4.5)
				te_demog_fam_row = {}
				### issue #1029: from the overview, while any of our census states has a youth bulge
				te_demog_figure_row = {
					visible = "[GetScriptedGui('te_demog_youth_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "te_demog_ov_youth_tt"
					blockoverride "row_label" {
						text = "te_demog_youth"
					}
					blockoverride "row_value" {
						text = "te_demog_ov_youth_value"
					}
				}
			}
		}
	}

	### Longevity (phase 3; the late-game design §6.2, rule 7): who is within reach of the treatments that slow ageing,
	### and how much likelier they are than the rest to reach 100. Shown once the country's late figures exist (one of
	### its census states has had a late step), after Work and Retirement; open by default (rule 1), with its own flag
	### (te_demog_lx_closed). Labels fit the 240-unit cell ("Longevity Care", 14 characters); values the 200-unit one
	### ("100% of people", 14).
	type te_demog_sec_longevity = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('te_demog_lx_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_longevity"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_lx_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_lx_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_lx_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_lx_closed'))]"

			### issue #1029: from the overview, beside the care that moves them
			te_demog_figure_row = {
				tooltip = "te_demog_ov_lx_l100_tt"
				blockoverride "row_label" {
					text = "te_demog_lx_l100"
				}
				blockoverride "row_value" {
					text = "te_demog_ov_lx_l100_value"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_ov_lx_bio_tt"
				blockoverride "row_label" {
					text = "te_demog_lx_bio"
				}
				blockoverride "row_value" {
					text = "te_demog_ov_lx_bio_value"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_ov_lx_care_tt"
				blockoverride "row_label" {
					text = "te_demog_lx_care"
				}
				blockoverride "row_value" {
					text = "te_demog_ov_lx_care_value"
				}
			}
			te_demog_figure_row = {
				tooltip = "te_demog_ov_lx_gap_tt"
				blockoverride "row_label" {
					text = "te_demog_lx_gap"
				}
				blockoverride "row_value" {
					text = "te_demog_ov_lx_gap_value"
				}
			}
		}
	}

	### One of the five pension positions (late-game §2.2), beside the pension age: three to a row, then two, each 156
	### wide (3 x 156 + 2 x 6 = 480). The position in force is greyed (its scripted GUI is invalid for it), as are all
	### five outside Full and while the five-year term runs. Labels fit the 146-unit text in the small font: "Linked:
	### Average" is the longest, 15 characters, about 120.
	type te_demog_pension_button = button {
		using = default_button_action
		size = { 156 24 }

		block "pension_context" {}

		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

		block "pension_tooltip" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 146
			elide = right
			using = te_demog_fontsize_row
			block "pension_text" {}
		}
	}

	### ======================================================================
	### ======================================================================

	### The overview, always shown and with no header (gui_style_guide.md rule 1): the state's own census, with the date of its next count on its census line, as Banking's
	### grid of icon cells, two to a row (rule 4; issue #1029). Each cell's hover is its old row's (rule 2); the
	### rows it dropped are in their sections: the sex balance in the pyramid's, old age from and youth in Work and
	### Retirement's, Living to 100 and biological age in Longevity's, the urban share in the pyramid's.
	### Every figure is picked by its gate (a stepped census for the rates, deaths by cause for the leading cause),
	### so a figure not yet written is never read. Icons are placeholders: docs/systems/demographics_gui_icons.md.
	type te_state_demog_overview = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

		te_demog_panel = {
			spacing = 4

			te_demog_text = {
				default_format = "#tooltippable"
				text = "[SelectLocalization( GetScriptedGui('te_demog_state_count_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_census_next', 'te_demog_st_census' )]"
				tooltip = "te_demog_st_census_tt"
			}
			### Natural Change and Net Migration
			te_demog_ov_row = {
				te_demog_ov_cell = {
					tooltip = "te_demog_st_nat_tt"
					blockoverride "icon" {
						texture = "gfx/interface/icons/generic_icons/population.dds"
					}
					blockoverride "caption" {
						text = "te_demog_ov_nat"
					}
					blockoverride "word" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_state_stepped_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_nat_value', 'te_demog_ov_cell_pending' )]"
					}
					blockoverride "third_line" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_state_stepped_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_nat_third', 'te_tt_blank' )]"
					}
					blockoverride "trend" {
						te_demog_trend_neutral = {
							blockoverride "trend_up" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_natural'), '(CFixedPoint)1' )]"
							}
							blockoverride "trend_down" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_natural'), '(CFixedPoint)-1' )]"
							}
							blockoverride "trend_level" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_natural'), '(CFixedPoint)0' )]"
							}
						}
					}
				}
				te_demog_ov_cell = {
					tooltip = "te_demog_st_mig_cell_tt"
					blockoverride "icon" {
						texture = "gfx/interface/icons/state_status_icons/mass_migration_target.dds"
					}
					blockoverride "caption" {
						text = "te_demog_ov_mig"
					}
					blockoverride "word" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_state_stepped_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_mig_cell_value', 'te_demog_ov_cell_pending' )]"
					}
					blockoverride "third_line" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_state_stepped_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_mig_third', 'te_tt_blank' )]"
					}
				}
			}
			### Life Expectancy and the Leading Cause of Death
			te_demog_ov_row = {
				te_demog_ov_cell = {
					tooltip = "[SelectLocalization( GetScriptedGui('te_demog_lx_state_e0_over_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_e0_tt_100', 'te_demog_st_e0_tt' )]"
					blockoverride "icon" {
						texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/healthcare_aid.dds"
					}
					blockoverride "caption" {
						text = "te_demog_ov_e0"
					}
					blockoverride "word" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_lx_state_e0_over_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_ov_e0_100', 'te_demog_st_e0_value' )]"
					}
					blockoverride "third_line" {
						text = "te_demog_st_e0_third"
					}
					blockoverride "trend" {
						te_demog_trend_good_up = {
							blockoverride "trend_up" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_e0'), '(CFixedPoint)1' )]"
							}
							blockoverride "trend_down" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_e0'), '(CFixedPoint)-1' )]"
							}
							blockoverride "trend_level" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_e0'), '(CFixedPoint)0' )]"
							}
						}
					}
				}
				te_demog_ov_cell = {
					tooltip = "[SelectLocalization( GetScriptedGui('te_demog_state_dc_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_lead_tt', 'te_demog_st_lead_pending_tt' )]"
					blockoverride "icon" {
						texture = "gfx/interface/icons/generic_icons/red_cross.dds"
					}
					blockoverride "caption" {
						text = "te_demog_ov_lead"
					}
					blockoverride "word" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_state_dc_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_lead_value', 'te_demog_ov_cell_pending' )]"
					}
					blockoverride "third_line" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_state_dc_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_lead_third', 'te_tt_blank' )]"
					}
				}
			}
			### Fertility and Median Age
			te_demog_ov_row = {
				te_demog_ov_cell = {
					tooltip = "te_demog_st_tfr_tt"
					blockoverride "icon" {
						texture = "gfx/interface/icons/decree/decree_natalism_initiative.dds"
					}
					blockoverride "caption" {
						text = "te_demog_ov_fert"
					}
					blockoverride "word" {
						text = "te_demog_st_fert_value"
					}
					blockoverride "third_line" {
						text = "[SelectLocalization( Not( EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_tfr'), '(CFixedPoint)2' ) ), 'te_demog_st_fert_third', 'te_tt_blank' )]"
					}
					blockoverride "trend" {
						te_demog_trend_neutral = {
							blockoverride "trend_up" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_tfr'), '(CFixedPoint)1' )]"
							}
							blockoverride "trend_down" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_tfr'), '(CFixedPoint)-1' )]"
							}
							blockoverride "trend_level" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_tfr'), '(CFixedPoint)0' )]"
							}
						}
					}
				}
				te_demog_ov_cell = {
					tooltip = "te_demog_st_median_tt"
					blockoverride "icon" {
						texture = "gfx/interface/icons/generic_icons/clock.dds"
					}
					blockoverride "caption" {
						text = "te_demog_ov_median"
					}
					blockoverride "word" {
						text = "te_demog_st_median_value"
					}
					blockoverride "third_line" {
						text = "te_demog_st_median_third"
					}
					blockoverride "trend" {
						te_demog_trend_neutral = {
							blockoverride "trend_up" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_median'), '(CFixedPoint)1' )]"
							}
							blockoverride "trend_down" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_median'), '(CFixedPoint)-1' )]"
							}
							blockoverride "trend_level" {
								visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_demog_trend_median'), '(CFixedPoint)0' )]"
							}
						}
					}
				}
			}
			### Working Age and the Gini
			te_demog_ov_row = {
				te_demog_ov_cell = {
					tooltip = "[SelectLocalization( GetScriptedGui('te_demog_state_work_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_working_age_tt', 'te_demog_ov_working_age_pending_tt' )]"
					blockoverride "icon" {
						texture = "gfx/interface/icons/institution_icons/institution_ministry_of_labor.dds"
					}
					blockoverride "caption" {
						text = "te_demog_ov_working_age"
					}
					blockoverride "word" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_state_work_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_working_age_value', 'te_demog_ov_cell_pending' )]"
					}
					blockoverride "third_line" {
						text = "[SelectLocalization( GetScriptedGui('te_demog_state_work_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ), 'te_demog_st_working_third', 'te_tt_blank' )]"
					}
				}
				te_demog_ov_cell = {
					tooltip = "te_demog_st_gini_cell_tt"
					blockoverride "icon" {
						texture = "gfx/interface/icons/generic_icons/money.dds"
