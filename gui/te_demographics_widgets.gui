	### How Demographics Works: every explanation, collapsed by default, one
	### heading per topic (rule 1).
	type te_demog_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_how"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_demog_how_open')]"
			}
		}

		te_demog_panel = {
			visible = "[GetVariableSystem.Exists('te_demog_how_open')]"

			te_demog_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_census"
				}
			}
			te_demog_note = {
				text = "te_demog_how_census"
			}
			te_demog_note = {
				text = "te_demog_how_applied"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_fertility"
				}
			}
			te_demog_note = {
				text = "te_demog_how_fertility"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_mortality"
				}
			}
			te_demog_note = {
				text = "te_demog_how_mortality"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_causes"
				}
			}
			te_demog_note = {
				text = "te_demog_how_causes"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_family"
				}
			}
			te_demog_note = {
				text = "te_demog_how_family"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_outline"
				}
			}
			te_demog_note = {
				text = "te_demog_how_outline"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_migration"
				}
			}
			te_demog_note = {
				text = "te_demog_how_migration"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_wealth"
				}
			}
			te_demog_note = {
				text = "te_demog_how_gini"
			}
			te_demog_note = {
				text = "te_demog_how_wc"
			}
			te_demog_subheader = {
				blockoverride "subheader_text" {
					text = "te_demog_how_sub_places"
				}
			}
