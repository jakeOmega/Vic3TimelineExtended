	### The population pyramid: 18 five-year bands, 85 and over at the top, men
	### left and women right, all on one scale (te_demog_pyramid_max, the largest
	### band now or in the outline). The outline twenty years ahead shows while
	### the player's country has one (te_demog_outline_ready_sgui).
	type te_demog_sec_pyramid = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_demog_section_header = {
			blockoverride "left_text" {
				text = "te_demog_sec_pyramid"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_demog_pyr_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('te_demog_pyr_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('te_demog_pyr_closed'))]"
			}
		}

		te_demog_panel = {
			visible = "[Not(GetVariableSystem.Exists('te_demog_pyr_closed'))]"

			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 12

				textbox = {
					autoresize = yes
					minimumsize = { 196 -1 }
					maximumsize = { 196 -1 }
					align = right|nobaseline
					using = fontsize_small
					default_format = "#title"
					text = "te_demog_pyr_men"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 64 -1 }
					maximumsize = { 64 -1 }
					align = hcenter|nobaseline
					using = fontsize_small
					default_format = "#title"
					text = "te_demog_pyr_age"
				}
				textbox = {
					autoresize = yes
					minimumsize = { 196 -1 }
					maximumsize = { 196 -1 }
					align = left|nobaseline
					using = fontsize_small
					default_format = "#title"
					text = "te_demog_pyr_women"
				}
			}
			te_demog_pyramid_row = {
				blockoverride "row_tooltip" {
					tooltip = "[SelectLocalization( GetScriptedGui('te_demog_outline_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_demog_pyr_tt_17', 'te_demog_pyr_tt_now_17' )]"
				}
				blockoverride "band_label" {
					raw_text = "85+"
				}
				blockoverride "next_visible" {
					visible = "[GetScriptedGui('te_demog_outline_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
				blockoverride "men_now" {
					value = "[Negate_float( FixedPointToFloat( GetPlayer.MakeScope.Var('te_dg_cbm17').GetValue ) )]"
				}
				blockoverride "women_now" {
					value = "[FixedPointToFloat( GetPlayer.MakeScope.Var('te_dg_cbf17').GetValue )]"
				}
				blockoverride "men_next" {
					value = "[Negate_float( FixedPointToFloat( GetPlayer.MakeScope.Var('te_dg_pjm17').GetValue ) )]"
				}
				blockoverride "women_next" {
					value = "[FixedPointToFloat( GetPlayer.MakeScope.Var('te_dg_pjf17').GetValue )]"
				}
			}
			te_demog_pyramid_row = {
				blockoverride "row_tooltip" {
					tooltip = "[SelectLocalization( GetScriptedGui('te_demog_outline_ready_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_demog_pyr_tt_16', 'te_demog_pyr_tt_now_16' )]"
