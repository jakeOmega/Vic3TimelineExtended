			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_leading_cause"
				tooltip = "te_jmap_pick_leading_cause_desc"
				visible = "[GetScriptedGui('te_jmap_pick_leading_cause_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
