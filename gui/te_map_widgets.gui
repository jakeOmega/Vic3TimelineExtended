		}

		# The census maps, three to a row: how long people live and what they die of,
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			te_jmap_pick_button = {
				text = "te_jmap_pick_life_expectancy"
				tooltip = "te_jmap_pick_life_expectancy_desc"
				visible = "[GetScriptedGui('te_jmap_pick_life_expectancy_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_life_expectancy_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_life_expectancy_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_infant_mortality"
				tooltip = "te_jmap_pick_infant_mortality_desc"
				visible = "[GetScriptedGui('te_jmap_pick_infant_mortality_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_infant_mortality_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
