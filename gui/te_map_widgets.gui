				visible = "[GetScriptedGui('te_jmap_pick_birth_rate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_birth_rate_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_birth_rate_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_death_rate"
				tooltip = "te_jmap_pick_death_rate_desc"
				visible = "[GetScriptedGui('te_jmap_pick_death_rate_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_death_rate_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_death_rate_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_natural_change"
				tooltip = "te_jmap_pick_natural_change_desc"
				visible = "[GetScriptedGui('te_jmap_pick_natural_change_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_natural_change_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_natural_change_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}
		}

		# the population's shape,
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			te_jmap_pick_button = {
				text = "te_jmap_pick_fertility"
				tooltip = "te_jmap_pick_fertility_desc"
				visible = "[GetScriptedGui('te_jmap_pick_fertility_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_fertility_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_fertility_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_median_age"
				tooltip = "te_jmap_pick_median_age_desc"
				visible = "[GetScriptedGui('te_jmap_pick_median_age_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_median_age_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_median_age_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_old_share"
				tooltip = "te_jmap_pick_old_share_desc"
				visible = "[GetScriptedGui('te_jmap_pick_old_share_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_old_share_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_old_share_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}
		}

		# and who is in it.
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			te_jmap_pick_button = {
				text = "te_jmap_pick_sex_balance"
				tooltip = "te_jmap_pick_sex_balance_desc"
				visible = "[GetScriptedGui('te_jmap_pick_sex_balance_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_sex_balance_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_sex_balance_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_net_migration"
				tooltip = "te_jmap_pick_net_migration_desc"
				visible = "[GetScriptedGui('te_jmap_pick_net_migration_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_net_migration_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_net_migration_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
