}

### THE REPAINTER (a scripted widget: gui/scripted_widgets/te_systems_window.txt). A pick's second click fires
### te_jmap_repaint here, outside the page. The third pass ran it on the pick button itself, both callbacks in one
### state, ClosePanel then OpenJournalEntryPanelDontToggle: the page closed and stayed closed, with nothing in the
### logs (fifth session). Either the button went with the page before the second line ran, or the close landed after
### the open had found the page still open. This widget outlives the page, and the open is a state of its own, a
### fifth of a second after the close. It is the plain open, the one the Demographics and Banking buttons use from outside
### the page; with the page closed its toggle opens it. The entry is this widget's own datacontext.
### The reopen logs TE_JMAP reopen first (te_jmap_reopen_log_sgui), so a page that stays closed says which half failed.
### Zero size: it draws nothing. Visible whenever a player can click a pick, as the launcher (te_systems_window.gui).
widget = {
	name = "te_jmap_repainter"
	size = { 0 0 }
	visible = "[And( GetMetaPlayer.GetPlayedOrObservedCountry.IsValid, Not( GetMetaPlayer.IsObserver ) )]"
	datacontext = "[GetPlayerJournalEntry('je_te_map_room')]"

	### 0.1 s (2026-11-07): 0.25 worked (sixth session), and the fifth pass's 0.05 sometimes left the page closed (the
	### owner, 2026-11-07). Too short for the pick to land and the page reopens on the old map (play-test check 1).
	state = {
		name = te_jmap_repaint
		next = te_jmap_repaint_open
		duration = 0.1
		on_finish = "[InformationPanelBar.ClosePanel]"
	}

	### 0.2 s (2026-11-07): 0.1 worked (sixth session); at the fifth pass's 0.05 the page sometimes failed to reopen
	### (the owner, 2026-11-07), the toggle finding it still open and closing it for good (play-test check 1). Twice
	### the tenth that worked, for a slow frame.
	state = {
		name = te_jmap_repaint_open
		duration = 0.2
		on_finish = "[GetScriptedGui('te_jmap_reopen_log_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		on_finish = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
	}
}
