	### The Timeline Extended window's Map Room button, left of its width toggle in both frames
	### (te_systems_window_toggle): opens the Map Room on whatever map was picked last, then closes the window, which
	### would cover the page (both are side panels, and the full screen covers the map). The close comes last: a button
	### whose own window hides mid-click may lose the lines after it (a pick's close-then-open on the page did, fifth
	### session). It notes the player as the maps' viewer first, for the maps of "your" country (te_jmap_viewer,
	### te_journal_map_effects.txt).
	type te_jmap_window_button = button {
		using = default_button
		size = { 140 26 }
		datacontext = "[GetPlayerJournalEntry('je_te_map_room')]"
		text = "te_jmap_window_button"
		tooltip = "te_jmap_window_button_tt"
		onclick = "[GetVariableSystem.Clear('te_je_see_through')]"
		onclick = "[GetScriptedGui('te_jmap_note_viewer_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
		onclick = "[GetVariableSystem.Clear('com_open_window')]"
	}

	### One pick: a button that runs its scripted GUI, then has te_jmap_repainter (below) close and reopen the page.
	### It holds no repaint state of its own: on the page, a state dies with the close (fifth session), and
	### PdxGuiTriggerAllAnimations would fire one here too.
	type te_jmap_pick_button = button {
		using = default_button
		size = { 150 30 }
	}

	### A category's header on the Map Room's page: the Demographics tab's section header (te_demog_section_header), as
	### wide as a row of three picks and a little more.
	type te_jmap_category_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 470 38 }
		}
	}

	### A category's rows, under its header while it is open.
	type te_jmap_category = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		margin_top = 2
		margin_bottom = 4
	}

	### The Map Room's picks, one per map (common/scripted_guis/te_journal_map_sguis.txt), in seven categories, each a
	### collapsible section (owner, 2026-11-11): a header (te_jmap_category_header) and its rows, shown while the
	### category's client-side flag te_jmap_cat_<key>_open is set. Every category starts collapsed (a long list:
	### gui_style_guide.md, Sections), and the flags outlive a pick's reopen (the GetVariableSystem's, as the see-through
	### page's), so a category opened stays open from map to map. A button is pressed while it is the pick, hidden while
	### its data doesn't exist (the census maps while the census doesn't run). Three 150-wide buttons to a row fit the
	### page.
	type te_jmap_pick_row = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# Society: the world's own figures: the state's turmoil and devastation, and the yearly walk's urban share.
		te_jmap_category_header = {
			blockoverride "left_text" {
				text = "te_jmap_cat_society"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_jmap_cat_society_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_jmap_cat_society_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_jmap_cat_society_open')]"
			}
		}
		te_jmap_category = {
			visible = "[GetVariableSystem.Exists('te_jmap_cat_society_open')]"

			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 4

				te_jmap_pick_button = {
					text = "te_jmap_pick_turmoil"
					tooltip = "te_jmap_pick_turmoil_desc"
					visible = "[GetScriptedGui('te_jmap_pick_turmoil_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[Not( GetScriptedGui('te_jmap_pick_turmoil_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_turmoil_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
				}

				te_jmap_pick_button = {
					text = "te_jmap_pick_devastation"
					tooltip = "te_jmap_pick_devastation_desc"
					visible = "[GetScriptedGui('te_jmap_pick_devastation_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[Not( GetScriptedGui('te_jmap_pick_devastation_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_devastation_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
				}

				te_jmap_pick_button = {
					text = "te_jmap_pick_urban_share"
					tooltip = "te_jmap_pick_urban_share_desc"
					visible = "[GetScriptedGui('te_jmap_pick_urban_share_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[Not( GetScriptedGui('te_jmap_pick_urban_share_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_urban_share_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
				}
			}
		}

		# Classes: four classes' share of the people, the yearly walk's (whatever the Demographics rule): the old elites, then the new.
		te_jmap_category_header = {
			blockoverride "left_text" {
				text = "te_jmap_cat_classes"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_jmap_cat_classes_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_jmap_cat_classes_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_jmap_cat_classes_open')]"
			}
		}
		te_jmap_category = {
			visible = "[GetVariableSystem.Exists('te_jmap_cat_classes_open')]"

			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 4

				te_jmap_pick_button = {
					text = "te_jmap_pick_aristocrats"
					tooltip = "te_jmap_pick_aristocrats_desc"
					visible = "[GetScriptedGui('te_jmap_pick_aristocrats_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[Not( GetScriptedGui('te_jmap_pick_aristocrats_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_aristocrats_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
				}

				te_jmap_pick_button = {
					text = "te_jmap_pick_clergy"
					tooltip = "te_jmap_pick_clergy_desc"
					visible = "[GetScriptedGui('te_jmap_pick_clergy_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[Not( GetScriptedGui('te_jmap_pick_clergy_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_clergy_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
				}
			}

			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 4

				te_jmap_pick_button = {
					text = "te_jmap_pick_capitalists"
					tooltip = "te_jmap_pick_capitalists_desc"
					visible = "[GetScriptedGui('te_jmap_pick_capitalists_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[Not( GetScriptedGui('te_jmap_pick_capitalists_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_capitalists_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
				}

				te_jmap_pick_button = {
					text = "te_jmap_pick_academics"
					tooltip = "te_jmap_pick_academics_desc"
					visible = "[GetScriptedGui('te_jmap_pick_academics_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[Not( GetScriptedGui('te_jmap_pick_academics_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_academics_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
				}
			}
		}

		# Economy: wealth (GDP per capita, then the walk's Gini and Dynastic Wealth), then who owns the economy and where the
			# companies keep their headquarters, then what each state's owners pay into the Investment Pool and its Trade Capacity.
		te_jmap_category_header = {
			blockoverride "left_text" {
				text = "te_jmap_cat_economy"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_jmap_cat_economy_open')]"
