	### The Timeline Extended window's Map Room button, left of its width toggle in both frames
	### (te_systems_window_toggle): opens the Map Room on whatever map was picked last, then closes the window, which
	### would cover the page (both are side panels, and the full screen covers the map). The close comes last: a button
	### whose own window hides mid-click may lose the lines after it (a pick's close-then-open on the page did, fifth
	### session). It notes the player as the maps' viewer first, for the maps of "your" country (te_jmap_viewer,
	### te_journal_map_effects.txt).
	type te_jmap_window_button = button {
		using = default_button
		size = { 140 26 }
		datacontext = "[GetPlayerJournalEntry('je_te_map_room')]"
		text = "te_jmap_window_button"
		tooltip = "te_jmap_window_button_tt"
		onclick = "[GetVariableSystem.Clear('te_je_see_through')]"
		onclick = "[GetScriptedGui('te_jmap_note_viewer_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
		onclick = "[GetVariableSystem.Clear('com_open_window')]"
	}

	### One pick: a button that runs its scripted GUI, then has te_jmap_repainter (below) close and reopen the page.
	### It holds no repaint state of its own: on the page, a state dies with the close (fifth session), and
	### PdxGuiTriggerAllAnimations would fire one here too.
	type te_jmap_pick_button = button {
		using = default_button
		size = { 150 30 }
	}

	### The Map Room's picks, one per map (common/scripted_guis/te_journal_map_sguis.txt): pressed while it is the
	### pick, hidden while its data doesn't exist (the census maps while the census doesn't run). Three 150-wide buttons
	### to a row fit the page.
	type te_jmap_pick_row = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# The world's maps: the state's own figures, and the yearly walk's urban share (whatever the Demographics rule).
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			te_jmap_pick_button = {
				text = "te_jmap_pick_turmoil"
				tooltip = "te_jmap_pick_turmoil_desc"
				visible = "[GetScriptedGui('te_jmap_pick_turmoil_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_turmoil_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_turmoil_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_devastation"
				tooltip = "te_jmap_pick_devastation_desc"
				visible = "[GetScriptedGui('te_jmap_pick_devastation_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_devastation_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_devastation_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_urban_share"
				tooltip = "te_jmap_pick_urban_share_desc"
				visible = "[GetScriptedGui('te_jmap_pick_urban_share_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_urban_share_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_urban_share_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}
		}

		# Wealth, from the same walk.
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			te_jmap_pick_button = {
				text = "te_jmap_pick_gini"
				tooltip = "te_jmap_pick_gini_desc"
				visible = "[GetScriptedGui('te_jmap_pick_gini_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_gini_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_gini_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_dynastic_wealth"
				tooltip = "te_jmap_pick_dynastic_wealth_desc"
				visible = "[GetScriptedGui('te_jmap_pick_dynastic_wealth_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_dynastic_wealth_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_dynastic_wealth_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}
		}

		# The systems' maps, each also on its own entry: emissions, the bomb and the networks,
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			te_jmap_pick_button = {
				text = "te_jmap_pick_emissions"
				tooltip = "te_jmap_pick_emissions_desc"
				visible = "[GetScriptedGui('te_jmap_pick_emissions_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_emissions_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_emissions_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_nuclear"
				tooltip = "te_jmap_pick_nuclear_desc"
				visible = "[GetScriptedGui('te_jmap_pick_nuclear_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_nuclear_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_nuclear_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_networks"
				tooltip = "te_jmap_pick_networks_desc"
				visible = "[GetScriptedGui('te_jmap_pick_networks_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_networks_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_networks_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}
		}

		# the world's institutions and ideas and the seabed,
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			te_jmap_pick_button = {
				text = "te_jmap_pick_united_nations"
				tooltip = "te_jmap_pick_united_nations_desc"
				visible = "[GetScriptedGui('te_jmap_pick_united_nations_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_united_nations_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_united_nations_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_political_models"
				tooltip = "te_jmap_pick_political_models_desc"
				visible = "[GetScriptedGui('te_jmap_pick_political_models_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_political_models_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_political_models_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_ocean_basins"
				tooltip = "te_jmap_pick_ocean_basins_desc"
				visible = "[GetScriptedGui('te_jmap_pick_ocean_basins_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_ocean_basins_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_ocean_basins_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}
		}

		# the monuments and the empires.
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			te_jmap_pick_button = {
				text = "te_jmap_pick_grandeur"
				tooltip = "te_jmap_pick_grandeur_desc"
				visible = "[GetScriptedGui('te_jmap_pick_grandeur_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_grandeur_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_grandeur_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
			}

			te_jmap_pick_button = {
				text = "te_jmap_pick_colonies"
				tooltip = "te_jmap_pick_colonies_desc"
				visible = "[GetScriptedGui('te_jmap_pick_colonies_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_colonies_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_colonies_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
