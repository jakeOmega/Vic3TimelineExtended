### Journal entry map modes (vanilla 1.15; docs/systems/mod_systems/journal_map_modes.md), second pass, 2026-11-05.
### A journal entry's map shows (the engine switches to it from code) while its page is open, so a "show on the map"
### button is a button that opens the page. Every button here names its entry through a datacontext and passes
### JournalEntry.AccessSelf: inside a callback, GetPlayerJournalEntry fails at load both bare and ended with .AccessSelf
### ("requires non const promote"; gui_modding_guide.md gotcha #29).
###   - te_jmap_demog_map_button, in the Demographics tab's header (te_demog_window_body): one click picks life
###     expectancy and opens the Map Room (je_te_map_room, contextless, in no journal, there from the game's start);
###   - te_jmap_banking_map_button, in the Banking tab's header (te_banking_tab_body): opens je_banking_cycle.
### Both sit left of the header's "?" (te_help_button, 10 in from the right; this one 45 in), hidden for an observer.
###
### te_jmap_pick_row is the Map Room's picks: scripted GUIs, since the engine locks a contextless entry's own scripted
### buttons for a country not involved in it. It sits on the Map Room's page (te_map_room_widget.gui) and on the strip.
###
### te_jmap_test_strip is the play-test's harness (docs/testing/journal-map-modes-playtest.md), in debug mode only
### (InDebugMode, the -debug_mode launch the console's `event` command already needs), on the Demographics tab above
### its sections. It goes once the questions are answered.

types te_map_widgets
{
	### The round map button: vanilla's States map mode icon on the small round button the "?" uses.
	type te_map_button = button_icon_round {
		blockoverride "size" {
			size = { 29 29 }
		}
		blockoverride "icon" {
			texture = "gfx/interface/icons/map_mode_icons/states.dds"
		}
	}

	### Demographics: pick life expectancy and open the Map Room, in one click. The pick lands at the next tick (a
	### scripted GUI's effect, play-test check 2), so a paused game shows the old pick until unpaused.
	type te_jmap_demog_map_button = widget {
		size = { 29 29 }
		parentanchor = right|vcenter
		position = { -45 0 }
		visible = "[Not( GetMetaPlayer.IsObserver )]"

		te_map_button = {
			datacontext = "[GetPlayerJournalEntry('je_te_map_room')]"
			tooltip = "te_jmap_demog_button_tt"
			onclick = "[GetScriptedGui('te_jmap_pick_life_expectancy_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
		}
	}

	### Banking: every country holds the entry, so the button only opens it (vanilla's own pattern, states_panel.gui's
	### Meiji domain button: the entry as datacontext, then OpenJournalEntryPanel).
	type te_jmap_banking_map_button = widget {
		size = { 29 29 }
		parentanchor = right|vcenter
		position = { -45 0 }
		visible = "[Not( GetMetaPlayer.IsObserver )]"

		te_map_button = {
			datacontext = "[GetPlayerJournalEntry('je_banking_cycle')]"
			visible = "[JournalEntry.IsActive]"
			tooltip = "te_jmap_banking_button_tt"
			onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
		}
	}

	### The Map Room's picks, one per map (common/scripted_guis/te_journal_map_sguis.txt): pressed while it is the
	### pick, hidden while its data doesn't exist (the census maps while the census doesn't run).
	type te_jmap_pick_row = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# The world's maps, and the test map.
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			button = {
				using = default_button
				size = { 150 30 }
				text = "te_jmap_pick_turmoil"
				tooltip = "te_jmap_pick_turmoil_desc"
				visible = "[GetScriptedGui('te_jmap_pick_turmoil_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_turmoil_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_turmoil_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}

			button = {
				using = default_button
				size = { 150 30 }
				text = "te_jmap_pick_literacy"
				tooltip = "te_jmap_pick_literacy_desc"
				visible = "[GetScriptedGui('te_jmap_pick_literacy_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_literacy_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_literacy_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}

			# A test map (play-test check 3); it goes once answered.
			button = {
				using = default_button
				size = { 150 30 }
				text = "te_jmap_pick_scope_probe"
				tooltip = "te_jmap_pick_scope_probe_desc"
				visible = "[GetScriptedGui('te_jmap_pick_scope_probe_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_scope_probe_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_scope_probe_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}

		# The census maps.
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			button = {
				using = default_button
				size = { 150 30 }
				text = "te_jmap_pick_life_expectancy"
				tooltip = "te_jmap_pick_life_expectancy_desc"
				visible = "[GetScriptedGui('te_jmap_pick_life_expectancy_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_life_expectancy_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_life_expectancy_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}

			button = {
				using = default_button
				size = { 150 30 }
				text = "te_jmap_pick_fertility"
				tooltip = "te_jmap_pick_fertility_desc"
				visible = "[GetScriptedGui('te_jmap_pick_fertility_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_fertility_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_fertility_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}

			button = {
				using = default_button
				size = { 150 30 }
				text = "te_jmap_pick_median_age"
				tooltip = "te_jmap_pick_median_age_desc"
				visible = "[GetScriptedGui('te_jmap_pick_median_age_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				down = "[Not( GetScriptedGui('te_jmap_pick_median_age_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				onclick = "[GetScriptedGui('te_jmap_pick_median_age_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
	}

	### The test strip. Each button is one check in the play-test list; its tooltip says what to watch.
	type te_jmap_test_strip = flowcontainer {
		visible = "[And( InDebugMode, Not( GetMetaPlayer.IsObserver ) )]"
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }

		textbox = {
			parentanchor = hcenter
			autoresize = yes
			multiline = yes
			max_width = 500
			align = center|nobaseline
			text = "te_jmap_strip_heading"
		}

		# The same picks as the Map Room's page: a fallback if its widget doesn't draw there (check 1).
		te_jmap_pick_row = {}

		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4

			# Open the Map Room without changing its pick.
			button = {
				using = default_button
				size = { 166 32 }
				datacontext = "[GetPlayerJournalEntry('je_te_map_room')]"
				text = "te_jmap_strip_room"
				tooltip = "te_jmap_strip_room_tt"
				onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
			}

			# Check 7: put the probe entry in Potential (or take it out).
			button = {
				using = default_button
				size = { 166 32 }
				text = "te_jmap_strip_potential"
				tooltip = "te_jmap_strip_potential_tt"
				onclick = "[GetScriptedGui('te_jmap_potential_probe_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}

			# Check 7: open the probe entry, once the player holds it, inactive or active. The gate on a parent and
			# the entry on the child, as vanilla's Meiji button has them.
			widget = {
				size = { 166 32 }
				visible = "[GetScriptedGui('te_jmap_potential_probe_held_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

				button = {
					using = default_button
					size = { 166 32 }
					datacontext = "[GetPlayerJournalEntry('je_te_map_potential_probe')]"
					text = "te_jmap_strip_potential_open"
					tooltip = "te_jmap_strip_potential_open_tt"
					onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
				}
			}
		}
	}
}
