### Timeline Extended: types for showing a system outside its journal entry,
### as a tab in a vanilla panel (budget_panel.gui, culture_panel.gui,
### diplomatic_overview.gui) or in the Timeline Extended window
### (te_systems_window.gui), and te_system_tab_frame, the shape a system's tab
### body takes in either. Additive: this file replaces nothing in vanilla.
###
### The te_je_* types read JournalEntry, so instance them under a JournalEntry
### datacontext: GetPlayerJournalEntry('<key>') on a child of a widget gated on
### the entry being active (gotcha #29 in docs/guides/gui_modding_guide.md).
###
### --- Other countries' panels (charts-help-national-info plan, PR F0) --------
### A system's sections read the shown country as `Country`
### (docs/superpowers/specs/2026-11-02-charts-help-national-info-design.md
### § 6.3), and every mount supplies it: te_system_tab_frame's root (block
### "tab_country", the player), the Timeline Extended window's mounts (the
### player), each journal root's te_je_country (the entry's country), the
### Population panel (AccessPlayer) and the Census Data window
### (PopBrowserPanel.GetCountry), which shows another country.
###
### te_own_country_only  the one own-country guard (spec § 6.5): a widget that
###                      carries `using = te_own_country_only` shows only for
###                      the player's own country, and so does everything
###                      inside it. Put every control (a scripted GUI's
###                      Execute), every opener of a popup that holds
###                      controls, and every part that reads JournalEntry or
###                      the player, under it:
###                        - a widget with no `visible` of its own takes the
###                          `using` itself;
###                        - a widget with its own `visible`, or an instance of
###                          a type whose root has one, gets a wrapper that
###                          takes it (one visible per widget; an instance's
###                          visible replaces its type's, gotcha #17). Give the
###                          wrapper the slot's fixed size where the control
###                          sits in a row (style guide rule 8).
###                      Hidden, not grayed: another country sees no control.
###                      test_te_system_tab_bodies.py's GuardTest and
###                      BindingTest hold every public tab to it.
### --- end other countries' panels --------------------------------------------

template te_own_country_only {
	visible = "[Country.IsLocalPlayer]"
}

types te_system_tab_widgets
{
	### The entry's scripted progress bars (JournalEntry.GetScriptedProgressBars),
	### in vanilla 1.15's markup (gui/journal_entry.gui, the item of the
	### GetScriptedProgressBars block) at 480 px: all four looks, the three
	### ready-made ones (default, default_bad, default_green) and the one a bar
	### defines in script (IsDynamic: progress_texture, background_texture, the
	### glows, color, marker, left_icon/right_icon), so a bar of any look draws
	### here as it does in the journal. Only the widths are the mod's (504 -> 480;
	### the IsDynamic row 520 -> 480 and its bar 430 -> 390, the row less two icons).
	type te_je_scripted_bars = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		visible = "[Not( IsDataModelEmpty( JournalEntry.GetScriptedProgressBars ) )]"
		datamodel = "[JournalEntry.GetScriptedProgressBars]"
		spacing = 8
		margin_bottom = 8

		item = {
			container = {

				# Default
				default_progressbar_horizontal = {
					visible = "[ScriptedProgressBar.IsDefault]"
					block "progressbar_size" {
						size = { 480 30 }
					}
					tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
					blockoverride "values" {
						value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
						min = 0
						max = 1
					}
					textbox = {
						text = "[ScriptedProgressBar.GetDesc]"
						autoresize = yes
						align = nobaseline
						margin_left = 10
						parentanchor = vcenter
					}
				}

				# Default Bad
				bad_progressbar_horizontal = {
					visible = "[ScriptedProgressBar.IsDefaultBad]"
					block "progressbar_size" {
						size = { 480 30 }
					}
					tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
					blockoverride "values" {
						value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
						min = 0
						max = 1
					}
					textbox = {
						text = "[ScriptedProgressBar.GetDesc]"
						autoresize = yes
						align = nobaseline
						margin_left = 10
						parentanchor = vcenter
					}
				}

				#Default Green
				green_progressbar_horizontal = {
					visible = "[ScriptedProgressBar.IsDefaultGreen]"
					block "progressbar_size" {
						size = { 480 30 }
					}

					tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
					blockoverride "values" {
						value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
						min = 0
						max = 1
					}
					textbox = {
						text = "[ScriptedProgressBar.GetDesc]"
						autoresize = yes
						align = nobaseline
						margin_left = 10
						parentanchor = vcenter
					}
					textbox = {
						text = "[ScriptedProgressBar.GetSecondDesc]"
						autoresize = yes
						align = right|nobaseline
						margin_right = 10
						parentanchor = right|vcenter
					}
				}

				# Look defined in script
				widget = {
					size = { 480 45 }
					parentanchor = center
					visible = "[ScriptedProgressBar.IsDynamic]"

					hbox = {
						size = { 100% 100% }
						spacing = 5

						icon = {
							size = { 40 40 }
							visible = "[ScriptedProgressBar.HasLeftIcon]"
							texture = "[ScriptedProgressBar.GetLeftIcon]"
						}

						scripted_progressbar_dynamic = {
							layoutpolicy_horizontal = expanding
							tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"

							block "progressbar_size" {
								size = { 390 30 }
							}

							textbox = {
								text = "[ScriptedProgressBar.GetDesc]"
								autoresize = yes
								align = nobaseline
								margin_left = 10
								parentanchor = vcenter
							}
							textbox = {
								text = "[ScriptedProgressBar.GetSecondDesc]"
								autoresize = yes
								align = right|nobaseline
								margin_right = 10
								parentanchor = right|vcenter
							}
						}

						icon = {
							size = { 40 40 }
							visible = "[ScriptedProgressBar.HasRightIcon]"
							texture = "[ScriptedProgressBar.GetRightIcon]"
						}
					}
				}
			}
		}
	}

	### The entry's goal bar (`progressbar = yes`, from current_value and
	### goal_add_value), in vanilla 1.15's markup (gui/journal_entry.gui, the block
	### under the scripted bars), at 480 px like the scripted bars. All four of
	### vanilla's texts, so an entry whose bar counts time works too. First used
	### by the Military panel's Nuclear tab: progress toward the next warhead.
	type te_je_goal_bar = flowcontainer {
		parentanchor = hcenter
		visible = "[And(JournalEntry.HasProgressBar, JournalEntry.IsActive)]"
		margin = { 0 5 }

		default_progressbar_horizontal = {
			block "progressbar_size" {
				size = { 480 30 }
			}
			blockoverride "values" {
				value = "[FixedPointToFloat(JournalEntry.GetGoalProgressPercent)]"
				min = 0
				max = 1
			}

			container = {
				visible = "[Not(JournalEntry.ShowProgressbarAsTime)]"

				textbox = {
					visible = "[EqualTo_CFixedPoint(JournalEntry.GetBaselineValue, '(CFixedPoint)0')]"
					text = "JOURNAL_ENTRY_PROGRESSBAR_FROM_ZERO"
					size = { 480 30 }
					align = nobaseline
					margin_left = 10
					parentanchor = vcenter
				}
				textbox = {
					visible = "[Not(EqualTo_CFixedPoint(JournalEntry.GetBaselineValue, '(CFixedPoint)0'))]"
					text = "JOURNAL_ENTRY_PROGRESSBAR_FROM_BASE"
					size = { 480 30 }
					align = nobaseline
					margin_left = 10
					parentanchor = vcenter
				}
			}

			container = {
				visible = "[JournalEntry.ShowProgressbarAsTime]"

				textbox = {
					visible = "[JournalEntry.ShowProgressbarAsMonths]"
					text = "JOURNAL_ENTRY_PROGRESSBAR_MONTHS"
					size = { 480 30 }
					align = nobaseline
					margin_left = 10
					parentanchor = vcenter
				}
				textbox = {
					visible = "[JournalEntry.ShowProgressbarAsWeeks]"
					text = "JOURNAL_ENTRY_PROGRESSBAR_WEEKS"
					size = { 480 30 }
					align = nobaseline
					margin_left = 10
					parentanchor = vcenter
				}
			}
		}
	}

	### The entry's status description, as vanilla's panel draws it
	### (gui/journal_entry.gui, the textbox under custom_widget_container_1).
	type te_je_status_desc = textbox {
		visible = "[Not(StringIsEmpty(JournalEntry.GetStatusDesc))]"
		text = "[JournalEntry.GetStatusDesc]"
		autoresize = yes
		multiline = yes
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }
		using = default_list_position
		align = hcenter|nobaseline
		using = fontsize_large

		margin = { 20 20 }

		background = {
			alpha = 0.5
			using = entry_bg_fancy_dark
		}
	}

	### The entry's scripted buttons, two to a row, as vanilla's panel draws them
	### (gui/journal_entry.gui). scripted_journal_entry_button is vanilla's type.
	type te_je_scripted_buttons = dynamicgridbox {
		parentanchor = hcenter
		visible = "[Not( IsDataModelEmpty( JournalEntry.GetScriptedButtons ) )]"
		datamodel = "[JournalEntry.GetScriptedButtons]"
		datamodel_wrap = 2
		flipdirection = yes

		item = {
			widget = {
				size = { 260 60 }

				scripted_journal_entry_button = {
					parentanchor = center
				}
			}
		}
	}

	### --- Other countries' panels (charts-help-national-info plan, PR F0) ----
	### The journal-entry root's Country (spec § 6.3): each widget_je_* root
	### holds its composer in one, so the sections read the entry's own country
	### as `Country`, as the tab's frame and the window's mounts supply the
	### player's. It sits on a child of the root, so the root's own
	### visible = "[JournalEntry.IsActive]" still reads the entry. Nothing else:
	### no spacing, margin or size, and the composers' own anchor (hcenter), so
	### a composer sits exactly where it did. A non-te_ widget beside the
	### composer (Tax Code's link to the Budget tab) stays outside it.
	type te_je_country = flowcontainer {
		datacontext = "[JournalEntry.GetCountry]"
		parentanchor = hcenter
		direction = vertical
		ignoreinvisible = yes
	}
	### --- end other countries' panels ----------------------------------------

	### Vanilla's tab_buttons (gui/shared/tab_bars.gui), copied verbatim with a
	### sixth slot (sixth_button* blocks) before the end divider, for a strip that
	### needs six: diplomatic_overview.gui (vanilla's five and the UN) and
	### market_panel.gui (vanilla's four, Climate and Reserve), and Budget
	### (vanilla's three, Banking, Tax Code and Breakdown). Slot 6 has no
	### input_action: vanilla's input profile defines tab_1 to tab_5 only. Slot 5
	### keeps vanilla's `block "fourth_button_icon"` slip on its selected icon;
	### slot 6 uses its own name. Re-copy on a vanilla patch that changes
	### tab_buttons.
