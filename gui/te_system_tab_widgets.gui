### Timeline Extended: types for showing a system outside its journal entry,
### as a tab in a vanilla panel (budget_panel.gui, culture_panel.gui,
### diplomatic_overview.gui). Additive: this file replaces nothing in vanilla.
###
### The te_je_* types read JournalEntry, so instance them under a JournalEntry
### datacontext: GetPlayerJournalEntry('<key>') on a child of a widget gated on
### the entry being active (gotcha #29 in docs/guides/gui_modding_guide.md).

types te_system_tab_widgets
{
	### The entry's scripted progress bars (JournalEntry.GetScriptedProgressBars),
	### in vanilla's markup (gui/journal_entry.gui) at 480 px. Only the variants the
	### mod's entries use are reproduced (default_green, default_bad,
	### double_sided_gold); a bar of another kind needs its variant added here.
	type te_je_scripted_bars = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		visible = "[Not( IsDataModelEmpty( JournalEntry.GetScriptedProgressBars ) )]"
		datamodel = "[JournalEntry.GetScriptedProgressBars]"
		spacing = 8
		margin_bottom = 8

		item = {
			container = {
				bad_progressbar_horizontal = {
					visible = "[ScriptedProgressBar.IsDefaultBad]"
					size = { 480 30 }
					tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
					blockoverride "values" {
						value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
						min = 0
						max = 1
					}
					textbox = {
						text = "[ScriptedProgressBar.GetDesc]"
						autoresize = yes
						align = nobaseline
						margin_left = 10
						parentanchor = vcenter
					}
				}

				green_progressbar_horizontal = {
					visible = "[ScriptedProgressBar.IsDefaultGreen]"
					size = { 480 30 }
					tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
					blockoverride "values" {
						value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
						min = 0
						max = 1
					}
					textbox = {
						text = "[ScriptedProgressBar.GetDesc]"
						autoresize = yes
						align = nobaseline
						margin_left = 10
						parentanchor = vcenter
					}
				}

				widget = {
					size = { 480 34 }
					visible = "[ScriptedProgressBar.IsDoubleSidedGold]"

					default_progressbar_horizontal = {
						parentanchor = center
						size = { 480 30 }

						blockoverride "noprogresstexture" {
							noprogresstexture = "gfx/interface/progressbar/progressbar_gold.dds"
						}

						tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
						blockoverride "values" {
							value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
							min = 0
							max = 1
						}
						textbox = {
							text = "[ScriptedProgressBar.GetDesc]"
							autoresize = yes
							align = nobaseline
							margin_left = 10
							parentanchor = vcenter
						}
						textbox = {
							text = "[ScriptedProgressBar.GetSecondDesc]"
							autoresize = yes
							align = right|nobaseline
							margin_right = 10
							parentanchor = right|vcenter
						}

						blockoverride "on_top_of_the_progressbar" {
							progressbar = {
								noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								size = { 100% 100% }
								spriteType = Corneredtiled
								spriteborder = { 4 4 }
								texture_density = 2
								skip_initial_animation = yes

								block "values" {}
								block "direction" {
									direction = horizontal
								}
								block "progress_changed_animation" {
									using = progressbar_changed_animation
								}
								block "animate_negative_change" {
									animate_negative_changes = yes
								}
								marker = {
									icon = {
										size = { 65 33 }
										parentanchor = vcenter
										widgetanchor = center
										texture = "gfx/interface/progressbar/progressbar_marker.dds"
										using = shimmer
									}
								}
							}
						}
					}
				}
			}
		}
	}

	### The entry's goal bar (`progressbar = yes`, from current_value and
	### goal_add_value), as vanilla's panel draws it (gui/journal_entry.gui, above
	### custom_widget_container_4), at 480 px like the scripted bars. All four of
	### vanilla's texts, so an entry whose bar counts time works too. First used
	### by the Military panel's Nuclear tab: progress toward the next warhead.
	type te_je_goal_bar = flowcontainer {
		parentanchor = hcenter
		visible = "[And( JournalEntry.HasProgressBar, JournalEntry.IsActive )]"
		margin = { 0 5 }

		default_progressbar_horizontal = {
			size = { 480 30 }
			blockoverride "values" {
				value = "[FixedPointToFloat(JournalEntry.GetGoalProgressPercent)]"
				min = 0
				max = 1
			}

			container = {
				visible = "[Not(JournalEntry.ShowProgressbarAsTime)]"

				textbox = {
					visible = "[EqualTo_CFixedPoint(JournalEntry.GetBaselineValue, '(CFixedPoint)0')]"
					text = "JOURNAL_ENTRY_PROGRESSBAR_FROM_ZERO"
					size = { 480 30 }
					align = nobaseline
					margin_left = 10
					parentanchor = vcenter
				}
				textbox = {
					visible = "[Not(EqualTo_CFixedPoint(JournalEntry.GetBaselineValue, '(CFixedPoint)0'))]"
					text = "JOURNAL_ENTRY_PROGRESSBAR_FROM_BASE"
					size = { 480 30 }
					align = nobaseline
					margin_left = 10
					parentanchor = vcenter
				}
			}

			container = {
				visible = "[JournalEntry.ShowProgressbarAsTime]"

				textbox = {
					visible = "[JournalEntry.ShowProgressbarAsMonths]"
					text = "JOURNAL_ENTRY_PROGRESSBAR_MONTHS"
					size = { 480 30 }
					align = nobaseline
					margin_left = 10
					parentanchor = vcenter
				}
				textbox = {
					visible = "[JournalEntry.ShowProgressbarAsWeeks]"
					text = "JOURNAL_ENTRY_PROGRESSBAR_WEEKS"
					size = { 480 30 }
					align = nobaseline
					margin_left = 10
					parentanchor = vcenter
				}
			}
		}
	}

	### The entry's status description, as vanilla's panel draws it
	### (gui/journal_entry.gui, the textbox under custom_widget_container_1).
	type te_je_status_desc = textbox {
		visible = "[Not(StringIsEmpty(JournalEntry.GetStatusDesc))]"
		text = "[JournalEntry.GetStatusDesc]"
		autoresize = yes
		multiline = yes
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }
		using = default_list_position
		align = hcenter|nobaseline
		using = fontsize_large

		margin = { 20 20 }

		background = {
			alpha = 0.5
			using = entry_bg_fancy_dark
		}
	}

	### The entry's scripted buttons, two to a row, as vanilla's panel draws them
	### (gui/journal_entry.gui). scripted_journal_entry_button is vanilla's type.
	type te_je_scripted_buttons = dynamicgridbox {
		parentanchor = hcenter
		visible = "[Not( IsDataModelEmpty( JournalEntry.GetScriptedButtons ) )]"
		datamodel = "[JournalEntry.GetScriptedButtons]"
		datamodel_wrap = 2
		flipdirection = yes

		item = {
			widget = {
				size = { 260 60 }

				scripted_journal_entry_button = {
					parentanchor = center
				}
			}
		}
	}

	### Vanilla's tab_buttons (gui/shared/tab_bars.gui), copied verbatim with a
	### sixth slot (sixth_button* blocks) before the end divider, for a strip that
	### needs six: diplomatic_overview.gui (vanilla's five and the UN) and
	### market_panel.gui (vanilla's four, Climate and Reserve). Slot 6 has no
	### input_action: vanilla's input profile defines tab_1 to tab_5 only. Slot 5
	### keeps vanilla's `block "fourth_button_icon"` slip on its selected icon;
	### slot 6 uses its own name. Re-copy on a vanilla patch that changes
	### tab_buttons.
	type te_tab_buttons_six = hbox {
		margin = { 3 0 }
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = fixed
		
		### START DIVIDER
		icon = {
			texture = "gfx/interface/tabs/tab_divider.dds"
			layoutpolicy_horizontal = fixed
			layoutpolicy_vertical = expanding
			block = "divider_size" {
				size = { 5 -1 }
			}
			spriteType = Corneredstretched
			spriteborder = { 0 20 }
			
			block "divider_fade_left" {
			}
		}
		
		### TAB 1
		tab_button = {
			block "first_button_name" {}
			block "first_button_background" {}
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred			
			block "height" {}
			
			block "first_button_visibility_checked" {
				visible = no
			}
			
			block "first_button_tooltip" {
				tooltip = "TAB_1"
			}
			input_action = "tab_1"
			using = tooltip_above
			
			block "first_button_click" {}
			block "first_button_icon" {}
			
			textbox = {
				block "first_button" {
					raw_text = "Placeholder"
				}
				default_format = "#title"
				using = tab_text_properties
			}
		}
		icon = {
			block "first_button_name" {}
			block "first_button_background_selected" {}
			using = selected_tabs
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "first_button_visibility" {
				visible = no
			}
			block "first_button_icon" {}

			textbox = {
				block "first_button_selected" {
					raw_text = "#BOLD Placeholder#!"
				}
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		### TAB 2
		tab_button = {
			block "second_button_name" {}
			block "second_button_background" {}
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "second_button_visibility_checked" {
				visible = no
			}
			
			block "second_button_tooltip" {
				tooltip = "TAB_2"
			}
			input_action = "tab_2"
			using = tooltip_above

			block "second_button_click" {}
			block "second_button_icon" {}
			
			textbox = {
				block "second_button" {
					raw_text = "Placeholder"
				}
				default_format = "#title"
				using = tab_text_properties
			}
		}
		icon = {
			block "second_button_name" {}
			block "second_button_background_selected" {}
			using = selected_tabs
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}

			block "second_button_visibility" {
				visible = no
			}
			block "second_button_icon" {}

			textbox = {
				block "second_button_selected" {
					raw_text = "#BOLD Placeholder#!"
				}
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		### TAB 3
		tab_button = {
			block "third_button_name" {}
			block "third_button_background" {}
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "third_button_visibility_checked" {
				visible = no
			}
			
			block "third_button_tooltip" {
				tooltip = "TAB_3"
			}
			input_action = "tab_3"
			using = tooltip_above
			
			block "third_button_click" {}
			block "third_button_icon" {}
			
			textbox = {
				block "third_button" {
					raw_text = "Placeholder"
				}
				default_format = "#title"
				using = tab_text_properties
			}
		}
		icon = {
			block "third_button_name" {}
			block "third_button_background_selected" {}
			using = selected_tabs
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "third_button_visibility" {
				visible = no
			}
			block "third_button_icon" {}

			textbox = {
				block "third_button_selected" {
					raw_text = "#BOLD Placeholder#!"
				}
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		### TAB 4
		tab_button = {
			block "fourth_button_name" {}
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "fourth_button_visibility_checked" {
				visible = no
			}
			
			block "fourth_button_tooltip" {
				tooltip = "TAB_4"
			}
			input_action = "tab_4"
			using = tooltip_above

			block "fourth_button_click" {}
			block "fourth_button_icon" {}
			
			textbox = {
				block "fourth_button" {
					raw_text = "Placeholder"
				}
				default_format = "#title"
				using = tab_text_properties
			}
		}
		icon = {
			block "fourth_button_name" {}
			using = selected_tabs
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "fourth_button_visibility" {
				visible = no
			}
			block "fourth_button_icon" {}

			textbox = {
				block "fourth_button_selected" {
					raw_text = "#BOLD Placeholder#!"
				}
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		### TAB 5
		tab_button = {
			block "fifth_button_name" {}
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "fifth_button_visibility_checked" {
				visible = no
			}
			
			block "fifth_button_tooltip" {
				tooltip = "TAB_5"
			}
			input_action = "tab_5"
			using = tooltip_above

			block "fifth_button_click" {}
			block "fifth_button_icon" {}
			
			textbox = {
				block "fifth_button" {
					raw_text = "Placeholder"
				}
				default_format = "#title"
				using = tab_text_properties
			}
		}
		icon = {
			block "fifth_button_name" {}
			using = selected_tabs
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "fifth_button_visibility" {
				visible = no
			}
			block "fourth_button_icon" {}

			textbox = {
				block "fifth_button_selected" {
					raw_text = "#BOLD Placeholder#!"
				}
				default_format = "#variable"
				using = tab_text_properties
			}
		}
		
		### TAB 6
		tab_button = {
			block "sixth_button_name" {}
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "sixth_button_visibility_checked" {
				visible = no
			}
			
			block "sixth_button_tooltip" {
				tooltip = "TAB_6"
			}
			using = tooltip_above

			block "sixth_button_click" {}
			block "sixth_button_icon" {}
			
			textbox = {
				block "sixth_button" {
					raw_text = "Placeholder"
				}
				default_format = "#title"
				using = tab_text_properties
			}
		}
		icon = {
			block "sixth_button_name" {}
			using = selected_tabs
			layoutstretchfactor_horizontal = 1
			layoutpolicy_horizontal = preferred
			block "height" {}
			
			block "sixth_button_visibility" {
