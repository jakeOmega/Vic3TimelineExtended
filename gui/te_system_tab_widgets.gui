	### ------------------------------------------------------------------
	### THE TAB FRAME (spec docs/superpowers/specs/2026-11-02-te-window-wide-mode-design.md
	### § 9.1): one shape for a system's tab, wherever it is mounted, so the
	### journal-entry tabs stop drifting in column width and link font. Each
	### system's te_<system>_tab_body derives from it and fills the blocks:
	###   tab_country               the Country the sections read (spec 2026-11-02-
	###                             charts-help-national-info § 6.3): the player,
	###                             GetPlayer, on the root, so the header and the
	###                             part before the gate read it too
	###   tab_header                the tab's default_header, outside the gate, so
	###                             it shows whenever the tab does
	###   tab_before_gate           anything above the gated content (Banking's
	###                             readout for a country with no entry)
	###   tab_gate                  the gate's visible, on a parent of the
	###                             datacontext, never on its widget (gotcha #29)
	###   tab_entry                 datacontext = "[GetPlayerJournalEntry('<key>')]"
	###   tab_content               the composers, in a fixed 520 column
	###                             (style guide rule 8); a body declares its
	###                             layout block inside it, which a wide mount
	###                             overrides
	###   tab_open_journal          the Open Journal Entry button: emptied where
	###                             the tab has no entry
	###   tab_open_journal_font     its font, after default_button's
	###   tab_open_journal_tooltip  its tooltip
	### The root carries no visible: an instance may gate the whole frame, header
	### included (each Space Race milestone in the window). A visible beside the
	### root's GetPlayer datacontext is vanilla's own shape (culture_panel.gui's
	### society tab, budget_panel.gui's Declare Bankruptcy button).
	type te_system_tab_frame = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 10

		block "tab_country" {
			datacontext = "[GetPlayer]"
		}
		block "tab_header" {}
		block "tab_before_gate" {}

		flowcontainer = {
			block "tab_gate" {}
			parentanchor = hcenter
			direction = vertical
			ignoreinvisible = yes

			flowcontainer = {
				block "tab_entry" {}
				parentanchor = hcenter
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				minimumsize = { 520 -1 }

				block "tab_content" {}

				block "tab_open_journal" {
					button = {
						visible = "[JournalEntry.IsActive]"
						using = default_button
						block "tab_open_journal_font" {}
						parentanchor = hcenter
						size = { 480 32 }
						text = "te_system_tab_open_journal"
						block "tab_open_journal_tooltip" {}
						onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
					}
				}
			}
		}
	}

	### --- Help pages (charts-help-national-info plan, PR H1) -------------
	### The "?" that opens a system's Help page (spec 2026-11-02-charts-help-
	### national-info § 5.2), right-aligned in the tab's header: a child of
	### the body's default_header, vanilla's own shape for a button in a
	### header (states_panel_buildings.gui's list toggle). An instance adds
	### its onclick, `[GetVariableSystem.Set('te_popup', 'help_<key>')]`, as
	### the header's last child, and `visible = "[Not(
	### GetMetaPlayer.IsObserver )]"`: te_popups is down for an observer, so a
	### "?" would do nothing. A host with no header has te_help_row (below).
	### It is the only way to a Help page: the "How X Works" links are gone
	### (owner, 2026-11-03). The icon is a placeholder (style guide rule
	### 10; docs/systems/te_systems_window_gui_icons.md): vanilla's own gold
	### question mark, which it ships in button_icons/unused/ and draws
	### nowhere. The plan named the encyclopedia button's book, but that reads
	### as opening the encyclopedia.
	type te_help_button = button_icon_round {
		blockoverride "size" {
			size = { 29 29 }
		}
		parentanchor = right|vcenter
		position = { -10 0 }
		tooltip = "te_help_button_tt"

		blockoverride "icon" {
			texture = "gfx/interface/buttons/button_icons/unused/help.dds"
		}
	}

	### --- The "?" where there is no header (help-button-everywhere PR) ---
	### A host with no header of its own gets its "?" in this row, a section's
	### width (520) with the button at its right, 10 in, where a header has it
	### (owner, 2026-11-03: a "?" in every host, the "How X Works" links gone).
	### It sits at the top of the host: a journal entry's, as the first child of
	### its overview root (each widget_je_*_overview in
	### custom_widget_container_1), outside te_je_country and so outside the
	### composer the entry shares with its tab, whose header has its own "?"; and
	### the state panel's Demographics subtab, which has no header either. Hidden
	### for an observer, for whom te_popups never opens; on the row, not the
	### button, so the hidden row collapses in its host (each is ignoreinvisible)
	### instead of leaving 29 px. An instance names its page:
	###   te_help_row = {
	###   	blockoverride "help_onclick" {
	###   		onclick = "[GetVariableSystem.Set('te_popup', 'help_<key>')]"
	###   	}
	###   }
	type te_help_row = widget {
		visible = "[Not( GetMetaPlayer.IsObserver )]"
		parentanchor = hcenter
		size = { 520 29 }

		te_help_button = {
