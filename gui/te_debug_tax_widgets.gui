# TEMPORARY PR 585. Visible only under the armed-country tab gate.
# Fixed-width rows use horizontal flowcontainers: hbox/vbox cannot be direct
# children of the panel flowcontainer, even while the panel is hidden.
types te_debug_tax_widgets {
	type te_tp_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		spacing = 8
		minimumsize = { 500 -1 }
		maximumsize = { 500 -1 }
		text_single = { text = "te_tp_heading" parentanchor = hcenter using = fontsize_large }
		textbox = {
			text = "te_tp_warning"
			multiline = yes
			autoresize = yes
			maximumsize = { 480 -1 }
			parentanchor = hcenter
		}
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			textbox = { text = "te_tp_metric_snapshot_seq" size = { 370 40 } multiline = yes using = fontsize_small }
			textbox = { text = "[GetPlayer.MakeScope.ScriptValue('te_tp_view_snapshot_seq')|2]" size = { 100 40 } align = right|nobaseline }
		}
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			textbox = { text = "te_tp_metric_version" size = { 370 40 } multiline = yes using = fontsize_small }
