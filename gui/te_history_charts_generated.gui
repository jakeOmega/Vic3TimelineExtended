	### The viewer: each chart's popup
	type te_chart_bank_value_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'chart_bank_value')]"
		}
		blockoverride "popup_title" {
			text = "te_hist_chart_bank_value_title"
		}
		blockoverride "popup_size" {
			size = { 1320 620 }
		}
		blockoverride "popup_list" {
			flowcontainer = {
				datacontext = "[GetPlayer]"
				visible = "[GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 4

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_banking_cycle')]"
					direction = vertical
					ignoreinvisible = yes
					spacing = 4

					te_chart_range_row_te_hist_range = {}
					te_hist_bank_value_large = {}
					te_banking_hist_marker_key = {}
				}
			}
			textbox = {
				visible = "[Not( GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				parentanchor = hcenter
				autoresize = yes
				multiline = yes
				max_width = 1204
				align = hcenter|nobaseline
				using = fontsize_large
				text = "te_chart_gone"
			}
