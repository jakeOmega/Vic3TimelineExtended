						min = 0
						max = "[FixedPointToFloat( Country.MakeScope.ScriptValue('te_demog_hist_e0_axis_shown') )]"
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( Min_CFixedPoint( ScriptContainer.GetVariableValue('te_dg_h_e0'), '(CFixedPoint)10000' ), Multiply_CFixedPoint( Country.MakeScope.ScriptValue('te_demog_hist_e0_axis_shown'), '(CFixedPoint)0.04' ) ) ) )]"
					}
					blockoverride "color" {
						color = { 0.42 0.70 0.48 1.0 }
					}
				}
			}
			blockoverride "plot_size" {
				size = { 456 132 }
			}
			blockoverride "plot_layouts" {
