					direction = vertical
					min = 0
					max = 100
					value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('ch_model_hist_cum_anarchist') )]"
					progresstexture = "gfx/interface/backgrounds/white.dds"
					noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					texture_density = 2
					skip_initial_animation = yes
					alwaystransparent = yes
					color = { 0.607843 0.219608 0.462745 1.0 }
				}
				progressbar = {
					size = { 100% 100% }
					direction = vertical
					min = 0
					max = 100
					value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('ch_model_hist_cum_corporatist') )]"
					progresstexture = "gfx/interface/backgrounds/white.dds"
					noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					texture_density = 2
					skip_initial_animation = yes
					alwaystransparent = yes
					color = { 0.772549 0.423529 0.129412 1.0 }
				}
				progressbar = {
					size = { 100% 100% }
					direction = vertical
					min = 0
					max = 100
					value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('ch_model_hist_cum_republican') )]"
					progresstexture = "gfx/interface/backgrounds/white.dds"
					noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
					texture_density = 2
					skip_initial_animation = yes
					alwaystransparent = yes
					color = { 0.294118 0.607843 0.811765 1.0 }
				}
			}
			### The plot blocks (datamodel, range filter, tooltip, bars, markers) are
			### overridden on this te_history_chart instance and reach the three plain
			### te_history_plot layouts below, as in every other history chart. #633
			### set them in a type derived from te_history_plot instead, and that type
			### drew nothing, even on its own (gui_modding_guide.md gotcha #37).
			### 5 / 20 / 100 years at 80 / 20 / 4px are 400px of bars. The
			### frame is sized to them, not left at the monthly charts' 496px
			### (which left ~90px empty on the left of a full 100 years):
			### 48px for the axis labels + 400 + the plots' 8px right margin.
			### Bars are 168px tall, 6px clear of the frame top and bottom,
			### level with the two axis labels.
			blockoverride "plot_size" { size = { 456 180 } }
			blockoverride "plot_layouts" {
				te_history_plot = {
					visible = "[GetVariableSystem.HasValue('ch_model_hist_range', '5')]"
					blockoverride "bar_size" { size = { 80 168 } }
				}
				te_history_plot = {
					visible = "[GetVariableSystem.HasValue('ch_model_hist_range', '20')]"
					blockoverride "bar_size" { size = { 20 168 } }
				}
				te_history_plot = {
					visible = "[Not(Or(GetVariableSystem.HasValue('ch_model_hist_range', '5'), GetVariableSystem.HasValue('ch_model_hist_range', '20')))]"
					blockoverride "bar_size" { size = { 4 168 } }
				}
				textbox = {
					parentanchor = left|top
					position = { 8 6 }
					autoresize = yes
					text = "ch_model_hist_axis_top"
				}
				textbox = {
					parentanchor = left|bottom
					position = { 8 -6 }
					autoresize = yes
					text = "ch_model_hist_axis_bottom"
				}
			}
			blockoverride "empty_visible" {
				visible = "[EqualTo_CFixedPoint(Country.MakeScope.ScriptValue('ch_model_hist_has_data'), '(CFixedPoint)0')]"
			}
			blockoverride "empty_text" { text = "ch_model_hist_empty" }
			blockoverride "chart_title_width" {
				max_width = 456
			}
			blockoverride "chart_open" {
				te_chart_open_button = {
					onclick = "[GetVariableSystem.Set('te_popup', 'chart_ch_models')]"
				}
			}
		}
	}

