	### demog_births_deaths: demographics, annual_pips
	type te_hist_demog_births_deaths = flowcontainer {
		parentanchor = hcenter

		te_history_chart = {
			blockoverride "chart_title_font" {
				using = te_demog_fontsize_heading
			}
			blockoverride "chart_legend_font" {
				using = fontsize_medium
			}
			blockoverride "chart_title" {
				text = "te_demog_hist_bd_title"
			}
			blockoverride "chart_legend" {
				text = "te_demog_hist_bd_legend"
			}
			blockoverride "sample_datamodel" {
				datamodel = "[Country.MakeScope.GetList('te_dg_hist')]"
			}
			blockoverride "sample_visible" {
				visible = "[Or( Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) ), Or( And( GetVariableSystem.HasValue('te_demog_hist_range', '5'), LessThan_CFixedPoint( Subtract_CFixedPoint( Country.MakeScope.ScriptValue('te_history_current_year'), ScriptContainer.GetVariableValue('te_hist_i') ), '(CFixedPoint)5' ) ), And( GetVariableSystem.HasValue('te_demog_hist_range', '20'), LessThan_CFixedPoint( Subtract_CFixedPoint( Country.MakeScope.ScriptValue('te_history_current_year'), ScriptContainer.GetVariableValue('te_hist_i') ), '(CFixedPoint)20' ) ) ) )]"
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_demog_hist_bd_tt"
			}
			blockoverride "marker_pips" {
				te_demog_hist_pips = {}
			}
			blockoverride "bar_body" {
				widget = {
					size = { 100% 100% }
					visible = "[ScriptContainer.HasVariable('te_dg_h_cbr')]"

					widget = {
						size = { 50% 100% }
						parentanchor = left

						progressbar = {
							size = { 100% 100% }
							direction = vertical
							progresstexture = "gfx/interface/backgrounds/white.dds"
							noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							texture_density = 2
							skip_initial_animation = yes
							alwaystransparent = yes
							color = { 0.42 0.70 0.48 1.0 }
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0.6', ScriptContainer.GetVariableValue('te_dg_h_cbr') ) )]"
							min = 0
							max = 60
						}
					}
					widget = {
						size = { 50% 100% }
						parentanchor = right

						progressbar = {
							size = { 100% 100% }
							direction = vertical
							progresstexture = "gfx/interface/backgrounds/white.dds"
							noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							texture_density = 2
							skip_initial_animation = yes
							alwaystransparent = yes
							color = { 0.82 0.40 0.36 1.0 }
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0.6', ScriptContainer.GetVariableValue('te_dg_h_cdr') ) )]"
							min = 0
							max = 60
						}
					}
				}
			}
			blockoverride "plot_size" {
				size = { 456 132 }
			}
			blockoverride "plot_layouts" {
				### The bars' 96 px at the frame's foot, as te_history_chart has them; the 36 px above are the pips' lane.
				widget = {
					size = { 100% 96 }
					parentanchor = bottom

					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '5')]"
						blockoverride "bar_size" {
							size = { 80 84 }
						}
					}
					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '20')]"
						blockoverride "bar_size" {
							size = { 20 84 }
						}
					}
					te_history_plot = {
						visible = "[Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) )]"
						blockoverride "bar_size" {
							size = { 4 84 }
						}
					}
					textbox = {
						parentanchor = left|top
						position = { 8 6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "60"
					}
					textbox = {
						parentanchor = left|bottom
						position = { 8 -6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "0"
					}
				}
			}
			blockoverride "empty_visible" {
				visible = "[IsDataModelEmpty( Country.MakeScope.GetList('te_dg_hist') )]"
			}
			blockoverride "empty_text" {
				text = "[SelectLocalization( GetScriptedGui('te_demog_hist_tracked_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_demog_hist_empty', 'te_demog_hist_untracked' )]"
			}
			blockoverride "chart_title_width" {
				max_width = 456
			}
			blockoverride "chart_open" {
				te_chart_open_button = {
					visible = "[Country.IsLocalPlayer]"
					onclick = "[GetVariableSystem.Set('te_popup', 'chart_demog_births_deaths')]"
				}
			}
		}
	}

	type te_hist_demog_births_deaths_large = flowcontainer {
		parentanchor = hcenter

		te_history_chart = {
			blockoverride "chart_title_font" {
				using = te_demog_fontsize_heading
			}
			blockoverride "chart_legend_font" {
				using = fontsize_medium
			}
			blockoverride "chart_title" {
				text = "te_demog_hist_bd_title"
			}
			blockoverride "chart_legend" {
				text = "te_demog_hist_bd_legend"
			}
			blockoverride "sample_datamodel" {
				datamodel = "[Country.MakeScope.GetList('te_dg_hist')]"
			}
			blockoverride "sample_visible" {
				visible = "[Or( Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) ), Or( And( GetVariableSystem.HasValue('te_demog_hist_range', '5'), LessThan_CFixedPoint( Subtract_CFixedPoint( Country.MakeScope.ScriptValue('te_history_current_year'), ScriptContainer.GetVariableValue('te_hist_i') ), '(CFixedPoint)5' ) ), And( GetVariableSystem.HasValue('te_demog_hist_range', '20'), LessThan_CFixedPoint( Subtract_CFixedPoint( Country.MakeScope.ScriptValue('te_history_current_year'), ScriptContainer.GetVariableValue('te_hist_i') ), '(CFixedPoint)20' ) ) ) )]"
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_demog_hist_bd_tt"
			}
			blockoverride "marker_pips" {
				te_demog_hist_pips = {}
			}
			blockoverride "bar_body" {
				widget = {
					size = { 100% 100% }
					visible = "[ScriptContainer.HasVariable('te_dg_h_cbr')]"

					widget = {
						size = { 50% 100% }
						parentanchor = left

						progressbar = {
							size = { 100% 100% }
							direction = vertical
							progresstexture = "gfx/interface/backgrounds/white.dds"
							noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							texture_density = 2
							skip_initial_animation = yes
							alwaystransparent = yes
							color = { 0.42 0.70 0.48 1.0 }
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0.15', ScriptContainer.GetVariableValue('te_dg_h_cbr') ) )]"
							min = 0
							max = 60
						}
					}
					widget = {
						size = { 50% 100% }
						parentanchor = right

						progressbar = {
							size = { 100% 100% }
							direction = vertical
							progresstexture = "gfx/interface/backgrounds/white.dds"
							noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							texture_density = 2
							skip_initial_animation = yes
							alwaystransparent = yes
							color = { 0.82 0.40 0.36 1.0 }
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0.15', ScriptContainer.GetVariableValue('te_dg_h_cdr') ) )]"
							min = 0
							max = 60
						}
					}
				}
			}
			blockoverride "plot_size" {
				size = { 1256 384 }
			}
			blockoverride "plot_layouts" {
				widget = {
					size = { 100% 348 }
					parentanchor = bottom

					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '5')]"
						blockoverride "bar_size" {
							size = { 240 336 }
						}
					}
					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '20')]"
						blockoverride "bar_size" {
							size = { 60 336 }
						}
					}
					te_history_plot = {
						visible = "[Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) )]"
						blockoverride "bar_size" {
							size = { 12 336 }
						}
					}
					textbox = {
						parentanchor = left|top
						position = { 8 6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "60"
					}
					textbox = {
						parentanchor = left|bottom
						position = { 8 -6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "0"
					}
				}
			}
			blockoverride "empty_visible" {
				visible = "[IsDataModelEmpty( Country.MakeScope.GetList('te_dg_hist') )]"
			}
			blockoverride "empty_text" {
				text = "[SelectLocalization( GetScriptedGui('te_demog_hist_tracked_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_demog_hist_empty', 'te_demog_hist_untracked' )]"
			}
			blockoverride "chart_text_width" {
				max_width = 1244
			}
			blockoverride "empty_width" {
				max_width = 1000
			}
		}
	}

	### demog_migration: demographics, annual_pips
	type te_hist_demog_migration = flowcontainer {
		parentanchor = hcenter

		te_history_chart = {
			blockoverride "chart_title_font" {
				using = te_demog_fontsize_heading
			}
			blockoverride "chart_legend_font" {
				using = fontsize_medium
			}
			blockoverride "chart_title" {
				text = "te_demog_hist_mig_title"
			}
			blockoverride "chart_legend" {
				text = "te_demog_hist_mig_legend"
			}
			blockoverride "sample_datamodel" {
				datamodel = "[Country.MakeScope.GetList('te_dg_hist')]"
			}
			blockoverride "sample_visible" {
				visible = "[Or( Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) ), Or( And( GetVariableSystem.HasValue('te_demog_hist_range', '5'), LessThan_CFixedPoint( Subtract_CFixedPoint( Country.MakeScope.ScriptValue('te_history_current_year'), ScriptContainer.GetVariableValue('te_hist_i') ), '(CFixedPoint)5' ) ), And( GetVariableSystem.HasValue('te_demog_hist_range', '20'), LessThan_CFixedPoint( Subtract_CFixedPoint( Country.MakeScope.ScriptValue('te_history_current_year'), ScriptContainer.GetVariableValue('te_hist_i') ), '(CFixedPoint)20' ) ) ) )]"
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_demog_hist_mig_tt"
			}
			blockoverride "marker_pips" {
				te_demog_hist_pips = {}
			}
			blockoverride "zero_axis" {
				### Centred on the bars, not on the frame, which the pips' lane makes taller.
				widget = {
					size = { 100% 96 }
					parentanchor = bottom
					alwaystransparent = yes

					widget = {
						size = { 100% 2 }
						parentanchor = vcenter
						alwaystransparent = yes

						background = {
							using = dark_area
							alpha = 0.7
						}
					}
				}
			}
			blockoverride "bar_body" {
				te_history_bar_signed = {
					visible = "[ScriptContainer.HasVariable('te_dg_h_mig')]"
					blockoverride "positive_values" {
						min = 0
						max = 20
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue('te_dg_h_mig') ) )]"
					}
					blockoverride "positive_cover_values" {
						min = 0
						max = 20
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue('te_dg_h_mig'), '(CFixedPoint)1' ) ) )]"
					}
					blockoverride "positive_color" {
						color = { 0.42 0.62 0.85 1.0 }
					}
					blockoverride "negative_values" {
						min = -20
						max = 0
						value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue('te_dg_h_mig') ) )]"
					}
					blockoverride "negative_cover_values" {
						min = -20
						max = 0
						value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', Add_CFixedPoint( ScriptContainer.GetVariableValue('te_dg_h_mig'), '(CFixedPoint)1' ) ) )]"
					}
					blockoverride "negative_color" {
						color = { 0.82 0.52 0.48 1.0 }
					}
				}
			}
			blockoverride "plot_size" {
				size = { 456 132 }
			}
			blockoverride "plot_layouts" {
				### The bars' 96 px at the frame's foot, as te_history_chart has them; the 36 px above are the pips' lane.
				widget = {
					size = { 100% 96 }
					parentanchor = bottom

					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '5')]"
						blockoverride "bar_size" {
							size = { 80 84 }
						}
					}
					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '20')]"
						blockoverride "bar_size" {
							size = { 20 84 }
						}
					}
					te_history_plot = {
						visible = "[Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) )]"
						blockoverride "bar_size" {
							size = { 4 84 }
						}
					}
					textbox = {
						parentanchor = left|top
						position = { 8 6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "+20"
					}
					textbox = {
						parentanchor = left|bottom
						position = { 8 -6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "-20"
					}
				}
			}
			blockoverride "empty_visible" {
				visible = "[IsDataModelEmpty( Country.MakeScope.GetList('te_dg_hist') )]"
			}
			blockoverride "empty_text" {
				text = "[SelectLocalization( GetScriptedGui('te_demog_hist_tracked_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_demog_hist_empty', 'te_demog_hist_untracked' )]"
			}
			blockoverride "chart_title_width" {
				max_width = 456
			}
			blockoverride "chart_open" {
				te_chart_open_button = {
					visible = "[Country.IsLocalPlayer]"
					onclick = "[GetVariableSystem.Set('te_popup', 'chart_demog_migration')]"
				}
			}
		}
	}

