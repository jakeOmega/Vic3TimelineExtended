						blockoverride "bar_size" {
							size = { 80 84 }
						}
					}
					te_history_plot = {
						visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '20')]"
						blockoverride "bar_size" {
							size = { 20 84 }
						}
					}
					te_history_plot = {
						visible = "[Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) )]"
						blockoverride "bar_size" {
							size = { 4 84 }
						}
					}
					textbox = {
						parentanchor = left|top
						position = { 8 6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "100"
					}
					textbox = {
						parentanchor = left|bottom
						position = { 8 -6 }
						autoresize = yes
						using = fontsize_medium
						raw_text = "0"
