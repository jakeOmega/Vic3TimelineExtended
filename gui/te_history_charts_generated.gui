### AUTO-GENERATED by scripts/generators/gen_te_history_charts.py from its CHARTS registry
### and the fragments in scripts/generators/te_history_charts/. Do not edit.
### Each history chart as two wrapper types: te_hist_<id>, the panel's size, which the
### chart's section instances where the chart sits, and te_hist_<id>_large, the
### full-screen viewer's. Each is a plain flowcontainer holding the chart's
### te_history_chart instance inline (gotcha #37). The large one leaves out the chart's
### comments, which describe the panel's size. How to add a chart: the generator's
### docstring and docs/systems/mod_systems/history_charts.md.
### Then the viewer (charts PR C2): each range variable's buttons (te_chart_range_row_<var>),
### each chart's popup (te_chart_<id>_popup, on te_popup = chart_<id>) and te_chart_popups,
### which gui/te_popups.gui instances.

types te_history_charts_generated_types
{
	### bank_value: banking, monthly
	type te_hist_bank_value = flowcontainer {
		parentanchor = hcenter

		te_history_chart = {
			blockoverride "chart_title_font" {
				using = banking_dash_fontsize_heading
			}
			blockoverride "chart_legend_font" {
				using = fontsize_medium
			}
			blockoverride "chart_title" {
				text = "te_hist_chart_bank_value_title"
			}
			blockoverride "chart_legend" {
				text = "te_hist_chart_bank_value_legend"
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_hist_tt_bank_value"
			}
			### The one chart here that does NOT use te_history_bar_unsigned:
			### its colour is the phase the month's reading falls in, so the
			### series reads as a run of Stable years broken by a red Panic
			### without anyone having to check the axis. Type and bands:
			### te_history_bar_cycle_phase at the top of this file.
			blockoverride "bar_body" {
				te_history_bar_cycle_phase = {
					visible = "[ScriptContainer.HasVariable( 'te_hist_v_bank_value' )]"
					blockoverride "phase_value" {
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_bank_value' ) ) )]"
					}
					blockoverride "phase_cover_value" {
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_bank_value' ), '(CFixedPoint)4' ) ) )]"
					}
				}
			}
			blockoverride "chart_title_width" {
				max_width = 456
			}
			blockoverride "chart_open" {
				te_chart_open_button = {
					onclick = "[GetVariableSystem.Set('te_popup', 'chart_bank_value')]"
				}
			}
		}
	}

