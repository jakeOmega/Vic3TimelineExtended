}

template te_ni_strip_shown {
	visible = yes
}

template te_ni_content_shown {
	visible = "[Or( Or( Or( And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), GetVariableSystem.HasValue('te_ni_tab', 'nation') ), Or( And( GetVariableSystem.HasValue('te_ni_tab', 'banking'), Or( GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'tax_code'), GetScriptedGui('te_budget_tax_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ), Or( Or( And( GetVariableSystem.HasValue('te_ni_tab', 'grand_monuments'), GetScriptedGui('te_window_grand_monuments_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'colonial_empire'), Or( GetScriptedGui('te_window_colonial_empire_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_window_colonial_empire_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'seabed'), GetScriptedGui('te_window_seabed_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) )]"
}

types te_national_info_generated_types
{
	### The strips: Pops, then each public tab in NI_ORDER, five a strip, side by
	### side and centered, each at the narrow strip width.
	type te_ni_strips = hbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = fixed

		expand = {}
		tab_buttons = {
			minimumsize = { 540 -1 }
			maximumsize = { 540 -1 }

			### pops
			blockoverride "first_button" {
				text = "te_pop_browser_tab_pops"
			}
			blockoverride "first_button_tooltip" {
				tooltip = "te_pop_browser_tab_pops_tt"
			}
			blockoverride "first_button_click" {
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'pops')]"
			}
			blockoverride "first_button_visibility" {
				using = te_ni_pops_selected
			}
			blockoverride "first_button_visibility_checked" {
				using = te_ni_pops_unselected
			}
			blockoverride "first_button_selected" {
				text = "te_pop_browser_tab_pops"
			}

			### demographics
			blockoverride "second_button" {
				text = "te_window_tab_demographics"
			}
			blockoverride "second_button_tooltip" {
				tooltip = "[SelectLocalization( And( Not( Country.IsLocalPlayer ), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), 'te_ni_tab_other_tt', SelectLocalization( Not( Country.IsLocalPlayer ), 'te_ni_tab_not_running_tt', SelectLocalization( And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ), 'te_pops_tab_demog_tt', SelectLocalization( GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'te_pops_tab_demog_locked_tt' ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) ) )]"
			}
			blockoverride "second_button_click" {
				enabled = "[And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) )]"
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'demographics')]"
			}
			blockoverride "second_button_visibility" {
				using = te_ni_demographics_selected
			}
			blockoverride "second_button_visibility_checked" {
				using = te_ni_demographics_unselected
			}
			blockoverride "second_button_selected" {
				text = "te_window_tab_demographics"
			}

			### nation
			blockoverride "third_button" {
				text = "te_window_tab_nation"
			}
			blockoverride "third_button_tooltip" {
				tooltip = "[SelectLocalization( Country.IsLocalPlayer, 'te_window_tab_nation_tt', 'te_ni_tab_other_tt' )]"
			}
			blockoverride "third_button_click" {
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'nation')]"
			}
			blockoverride "third_button_visibility" {
				using = te_ni_nation_selected
			}
			blockoverride "third_button_visibility_checked" {
				using = te_ni_nation_unselected
			}
			blockoverride "third_button_selected" {
				text = "te_window_tab_nation"
			}

			### banking
			blockoverride "fourth_button" {
				text = "te_window_tab_banking"
			}
			blockoverride "fourth_button_tooltip" {
				tooltip = "[SelectLocalization( And( Not( Country.IsLocalPlayer ), Or( GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), 'te_ni_tab_other_tt', SelectLocalization( Not( Country.IsLocalPlayer ), 'te_ni_tab_not_running_tt', SelectLocalization( GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_budget_tab_banking_tt', SelectLocalization( GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_budget_tab_banking_readout_tt', 'te_budget_tab_banking_locked_tt' ) ) ) )]"
			}
			blockoverride "fourth_button_click" {
				enabled = "[Or( GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) )]"
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'banking')]"
			}
			blockoverride "fourth_button_visibility" {
				using = te_ni_banking_selected
			}
			blockoverride "fourth_button_visibility_checked" {
				using = te_ni_banking_unselected
			}
			blockoverride "fourth_button_selected" {
				text = "te_window_tab_banking"
			}

			### tax_code
			blockoverride "fifth_button" {
				text = "te_window_tab_tax_code"
			}
			blockoverride "fifth_button_tooltip" {
				tooltip = "[SelectLocalization( And( Not( Country.IsLocalPlayer ), GetScriptedGui('te_budget_tax_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ), 'te_ni_tab_other_tt', SelectLocalization( Not( Country.IsLocalPlayer ), 'te_ni_tab_not_running_tt', SelectLocalization( GetScriptedGui('te_budget_tax_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_tax_tab_tt', SelectLocalization( GetScriptedGui('te_budget_tax_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'te_tax_tab_locked_tt' ), GetScriptedGui('te_budget_tax_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) ) )]"
			}
			blockoverride "fifth_button_click" {
				enabled = "[GetScriptedGui('te_budget_tax_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'tax_code')]"
			}
			blockoverride "fifth_button_visibility" {
				using = te_ni_tax_code_selected
			}
			blockoverride "fifth_button_visibility_checked" {
				using = te_ni_tax_code_unselected
			}
			blockoverride "fifth_button_selected" {
				text = "te_window_tab_tax_code"
			}
		}
		tab_buttons = {
			minimumsize = { 540 -1 }
			maximumsize = { 540 -1 }

			### grand_monuments
			blockoverride "first_button" {
				text = "te_window_tab_grand_monuments"
			}
			blockoverride "first_button_tooltip" {
				tooltip = "[SelectLocalization( And( Not( Country.IsLocalPlayer ), GetScriptedGui('te_window_grand_monuments_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ), 'te_ni_tab_other_tt', SelectLocalization( Not( Country.IsLocalPlayer ), 'te_ni_tab_not_running_tt', SelectLocalization( GetScriptedGui('te_window_grand_monuments_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_window_tab_grand_monuments_tt', SelectLocalization( GetScriptedGui('te_window_grand_monuments_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'te_window_tab_grand_monuments_locked_tt' ), GetScriptedGui('te_window_grand_monuments_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) ) )]"
			}
			blockoverride "first_button_click" {
				enabled = "[GetScriptedGui('te_window_grand_monuments_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'grand_monuments')]"
			}
			blockoverride "first_button_visibility" {
				using = te_ni_grand_monuments_selected
			}
			blockoverride "first_button_visibility_checked" {
				using = te_ni_grand_monuments_unselected
			}
			blockoverride "first_button_selected" {
				text = "te_window_tab_grand_monuments"
			}

			### colonial_empire
			blockoverride "second_button" {
				text = "te_window_tab_colonial_empire"
			}
			blockoverride "second_button_tooltip" {
				tooltip = "[SelectLocalization( And( Not( Country.IsLocalPlayer ), Or( GetScriptedGui('te_window_colonial_empire_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_window_colonial_empire_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), 'te_ni_tab_other_tt', SelectLocalization( Not( Country.IsLocalPlayer ), 'te_ni_tab_not_running_tt', SelectLocalization( GetScriptedGui('te_window_colonial_empire_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_window_tab_colonial_empire_tt', SelectLocalization( GetScriptedGui('te_window_colonial_empire_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_window_tab_colonial_empire_readout_tt', SelectLocalization( GetScriptedGui('te_window_colonial_empire_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'te_window_tab_colonial_empire_locked_tt' ), GetScriptedGui('te_window_colonial_empire_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) ) ) )]"
			}
			blockoverride "second_button_click" {
				enabled = "[Or( GetScriptedGui('te_window_colonial_empire_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_window_colonial_empire_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) )]"
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'colonial_empire')]"
			}
			blockoverride "second_button_visibility" {
				using = te_ni_colonial_empire_selected
			}
			blockoverride "second_button_visibility_checked" {
				using = te_ni_colonial_empire_unselected
			}
			blockoverride "second_button_selected" {
				text = "te_window_tab_colonial_empire"
			}

			### seabed
			blockoverride "third_button" {
				text = "te_window_tab_seabed"
			}
			blockoverride "third_button_tooltip" {
				tooltip = "[SelectLocalization( And( Not( Country.IsLocalPlayer ), GetScriptedGui('te_window_seabed_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ), 'te_ni_tab_other_tt', SelectLocalization( Not( Country.IsLocalPlayer ), 'te_ni_tab_not_running_tt', SelectLocalization( GetScriptedGui('te_window_seabed_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_window_tab_seabed_tt', SelectLocalization( GetScriptedGui('te_window_seabed_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_window_tab_seabed_met_tt', Concatenate( Localize( 'te_window_tab_seabed_locked_tt' ), GetScriptedGui('te_window_seabed_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) ) )]"
			}
			blockoverride "third_button_click" {
				enabled = "[GetScriptedGui('te_window_seabed_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'seabed')]"
			}
			blockoverride "third_button_visibility" {
				using = te_ni_seabed_selected
			}
			blockoverride "third_button_visibility_checked" {
				using = te_ni_seabed_unselected
			}
			blockoverride "third_button_selected" {
				text = "te_window_tab_seabed"
			}
		}
		expand = {}
	}

	### The window's column, in its scroll area (te_ni_content): each public tab's
	### pair of mounts, up only while its tab is shown.
	type te_ni_tabs = flowcontainer {
		name = "te_ni_tabs"
		parentanchor = hcenter
		direction = vertical
		ignoreinvisible = yes
		margin_top = 10
		margin_bottom = 15

		### demographics
		flowcontainer = {
			name = "te_ni_demographics_tab"
			using = te_ni_demographics_selected
			parentanchor = hcenter
			direction = vertical
			ignoreinvisible = yes

			### The player's own country: the window's full-screen mount, with its gate,
			### its entry and its controls.
			flowcontainer = {
				name = "te_ni_demographics_own"
				visible = "[Country.IsLocalPlayer]"
				parentanchor = hcenter
				direction = vertical
				ignoreinvisible = yes

				te_demog_window_body = {
					blockoverride "te_demog_tab_layout" {
						te_demog_browser_sections = {}
					}
				}
			}

			### Another country: the tab's header, its readout if it has one, then its
			### sections under the window's Country, with no journal entry and no frame.
			flowcontainer = {
				name = "te_ni_demographics_other"
				visible = "[Not( Country.IsLocalPlayer )]"
				parentanchor = hcenter
				direction = vertical
				ignoreinvisible = yes
				spacing = 10

				default_header = {
					using = default_list_position
					blockoverride "text" {
						text = "te_window_tab_demographics"
					}
					te_help_button = {
						visible = "[Not( GetMetaPlayer.IsObserver )]"
						onclick = "[GetVariableSystem.Set('te_popup', 'help_demographics')]"
					}
				}

				te_demog_browser_sections = {}
			}
		}

		### nation
		flowcontainer = {
			name = "te_ni_nation_tab"
			using = te_ni_nation_selected
			parentanchor = hcenter
			direction = vertical
			ignoreinvisible = yes

			### The player's own country: the window's full-screen mount, with its gate,
			### its entry and its controls.
			flowcontainer = {
