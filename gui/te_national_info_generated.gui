### AUTO-GENERATED by scripts/generators/gen_te_systems_window.py from its TABS registry (the public
### tabs, in NI_ORDER). Do not edit.
### National Info, the Census Data window (gui/pop_browser_panel.gui): its selection templates,
### its strip (te_ni_strips) and its column of mounts (te_ni_tabs), which the window instances in
### its ### MOD: National Info blocks. The generator's National Info section has the rule.

### Which tab is shown: the last one chosen while it is open for the window's
### country, otherwise Pops. A tab's unselected half shows while it is on the
### strip for that country and not shown. Then the strip's gate and the
### column's (every tab but Pops).

template te_ni_pops_selected {
	visible = "[Not( Or( Or( Or( And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), GetVariableSystem.HasValue('te_ni_tab', 'nation') ), Or( And( GetVariableSystem.HasValue('te_ni_tab', 'banking'), Or( GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'tax_code'), GetScriptedGui('te_budget_tax_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ), Or( Or( And( GetVariableSystem.HasValue('te_ni_tab', 'grand_monuments'), GetScriptedGui('te_window_grand_monuments_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'colonial_empire'), Or( GetScriptedGui('te_window_colonial_empire_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_window_colonial_empire_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'seabed'), GetScriptedGui('te_window_seabed_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) )]"
}

template te_ni_pops_unselected {
	visible = "[Or( Or( Or( And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), GetVariableSystem.HasValue('te_ni_tab', 'nation') ), Or( And( GetVariableSystem.HasValue('te_ni_tab', 'banking'), Or( GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'tax_code'), GetScriptedGui('te_budget_tax_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ), Or( Or( And( GetVariableSystem.HasValue('te_ni_tab', 'grand_monuments'), GetScriptedGui('te_window_grand_monuments_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'colonial_empire'), Or( GetScriptedGui('te_window_colonial_empire_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_window_colonial_empire_readout_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ), And( GetVariableSystem.HasValue('te_ni_tab', 'seabed'), GetScriptedGui('te_window_seabed_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) )]"
}

template te_ni_demographics_selected {
	visible = "[And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) )]"
}

template te_ni_demographics_unselected {
	visible = "[And( GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), Not( And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) )]"
}

template te_ni_nation_selected {
	visible = "[GetVariableSystem.HasValue('te_ni_tab', 'nation')]"
}

template te_ni_nation_unselected {
	visible = "[Not( GetVariableSystem.HasValue('te_ni_tab', 'nation') )]"
}

