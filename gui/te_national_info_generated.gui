### AUTO-GENERATED by scripts/generators/gen_te_systems_window.py from its TABS registry (the public
### tabs, in NI_ORDER). Do not edit.
### National Info, the Census Data window (gui/pop_browser_panel.gui): its selection templates,
### its strip (te_ni_strips) and its column of mounts (te_ni_tabs), which the window instances in
### its ### MOD: National Info blocks. The generator's National Info section has the rule.

### Which tab is shown: the last one chosen while it is open for the window's
### country, otherwise Pops. A tab's unselected half shows while it is on the
### strip for that country and not shown. Then the strip's gate and the
### column's (every tab but Pops).

template te_ni_pops_selected {
	visible = "[Not( And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) )]"
}

template te_ni_pops_unselected {
	visible = "[And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) )]"
}

template te_ni_demographics_selected {
	visible = "[And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) )]"
}

template te_ni_demographics_unselected {
	visible = "[And( GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), Not( And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) )]"
}

template te_ni_strip_shown {
	visible = "[GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
}

template te_ni_content_shown {
	visible = "[And( GetVariableSystem.HasValue('te_ni_tab', 'demographics'), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) )]"
}

types te_national_info_generated_types
{
	### The strips: Pops, then each public tab in NI_ORDER, five a strip, side by
	### side and centered, each at the narrow strip width.
	type te_ni_strips = hbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = fixed

		expand = {}
		tab_buttons = {
			minimumsize = { 540 -1 }
			maximumsize = { 540 -1 }

			### pops
			blockoverride "first_button" {
				text = "te_pop_browser_tab_pops"
			}
			blockoverride "first_button_tooltip" {
				tooltip = "te_pop_browser_tab_pops_tt"
			}
			blockoverride "first_button_click" {
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'pops')]"
			}
			blockoverride "first_button_visibility" {
				using = te_ni_pops_selected
			}
			blockoverride "first_button_visibility_checked" {
				using = te_ni_pops_unselected
			}
			blockoverride "first_button_selected" {
				text = "te_pop_browser_tab_pops"
			}

			### demographics
			blockoverride "second_button" {
				text = "te_window_tab_demographics"
			}
			blockoverride "second_button_tooltip" {
				tooltip = "[SelectLocalization( And( Not( Country.IsLocalPlayer ), And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ) ), 'te_ni_tab_other_tt', SelectLocalization( Not( Country.IsLocalPlayer ), 'te_ni_tab_not_running_tt', SelectLocalization( And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) ), 'te_pops_tab_demog_tt', SelectLocalization( GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'te_pops_tab_demog_locked_tt' ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) ) ) )]"
			}
			blockoverride "second_button_click" {
				enabled = "[And( GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) )]"
				onclick = "[GetVariableSystem.Set('te_ni_tab', 'demographics')]"
			}
			blockoverride "second_button_visibility" {
				using = te_ni_demographics_selected
			}
			blockoverride "second_button_visibility_checked" {
				using = te_ni_demographics_unselected
			}
			blockoverride "second_button_selected" {
				text = "te_window_tab_demographics"
			}
		}
		expand = {}
	}

	### The window's column, in its scroll area (te_ni_content): each public tab's
	### pair of mounts, up only while its tab is shown.
	type te_ni_tabs = flowcontainer {
		name = "te_ni_tabs"
		parentanchor = hcenter
		direction = vertical
		ignoreinvisible = yes
		margin_top = 10
		margin_bottom = 15

		### demographics
		flowcontainer = {
			name = "te_ni_demographics_tab"
			using = te_ni_demographics_selected
			parentanchor = hcenter
			direction = vertical
			ignoreinvisible = yes

			### The player's own country: the window's full-screen mount, with its gate,
			### its entry and its controls.
			flowcontainer = {
				name = "te_ni_demographics_own"
				visible = "[Country.IsLocalPlayer]"
				parentanchor = hcenter
				direction = vertical
				ignoreinvisible = yes

				te_demog_window_body = {
					blockoverride "te_demog_tab_layout" {
						te_demog_browser_sections = {}
					}
				}
			}

			### Another country: the tab's header, its readout if it has one, then its
			### sections under the window's Country, with no journal entry and no frame.
			flowcontainer = {
				name = "te_ni_demographics_other"
				visible = "[Not( Country.IsLocalPlayer )]"
				parentanchor = hcenter
				direction = vertical
				ignoreinvisible = yes
				spacing = 10

				default_header = {
					using = default_list_position
					blockoverride "text" {
						text = "te_window_tab_demographics"
					}
					te_help_button = {
						onclick = "[GetVariableSystem.Set('te_popup', 'help_demographics')]"
					}
				}

				te_demog_browser_sections = {}
			}
		}
	}
}
