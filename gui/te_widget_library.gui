### Timeline Extended: the widget library (Space Race UI pass design § 13,
### docs/superpowers/specs/2026-10-31-space-race-ui-pass-design.md). Types the
### mod's panels share, prefixed te_ui_ (GUI type names are global, and the
### Community Mod Framework redefines some vanilla ones: gui_modding_guide.md
### gotcha #30). Additive: types only, nothing drawn on its own.
###
### te_ui_popup  a centred popup over a dimmed screen (design § 3), the shell of
###              every picker. Its shape is vanilla's principle_selection_window:
###              a full-size dim, a full-size button behind the body that closes
###              it (a click outside), and the body with a header whose close
###              button carries vanilla's shortcut = "close_window" (Escape).
###              Both close the popup by clearing the client-side te_popup key,
###              which says which popup is open (one at a time). A popup is a
###              type deriving from this one, instanced in te_popups
###              (gui/te_popups.gui). Blocks:
###                popup_visible  its visible (on te_popup's value)
###                popup_title    the header's text
###                popup_size     the body's size, 640 × 620 by default
###                popup_list     the scrolled content
###                popup_footer   under the scrollarea, empty by default
###                popup_close    both close buttons' onclick (the click
###                               outside and the header's, with Escape):
###                               clearing te_popup by default; National
###                               Info's chart viewers clear te_ni_chart
###                               (charts-help-national-info plan, PR F1)
###              Not yet seen in game (docs/testing/solar-colonies-playtest.md):
###              the layer over the journal panel and the Timeline Extended
###              window, Escape, and the panel behind still scrolling.
###
### --- Help pages (charts-help-national-info plan, PR H1) -----------------
### te_ui_help_popup  a system's Help page (spec 2026-11-02-charts-help-
###              national-info § 5.2): te_ui_popup at 640 × 820, the sections'
###              480 to 520 of text plus the window's margins (2 × 35), the
###              list's (2 × 10) and a scrollbar. A page is
###              `type te_<key>_help_popup = te_ui_help_popup`, filling
###              popup_visible (te_popup = help_<key>), popup_title (the
###              section's own header key, "How Banking Works") and popup_list
###              (te_<key>_help_body = {}, the section's content, which reads
###              GetPlayer only). Instanced in te_popups; test_te_help_pages.py.
### --- end Help pages ------------------------------------------------------
###
### te_ui_columns_three, te_ui_columns_two  a row of columns of a fixed 520, 30
###              apart (style guide rule 8), centred, for the full-screen layouts
###              (spec 2026-11-02-te-window-wide-mode § 9.4). Content reads down
###              each column and then across, as in the Census Data window's
###              Demographics tab (te_demog_browser_sections, the first one on
###              it). Blocks: column_1, column_2 and, on the three, column_3. An
###              empty column keeps its 520 and the 30 beside it, so two columns
###              of content take te_ui_columns_two, not the three with one left
###              empty. An instance may gate the row with its own visible.

types te_widget_library_types
{
	type te_ui_popup = widget {
		size = { 100% 100% }
		block "popup_visible" {}

		using = Animation_ShowHide_Quick
		using = Background_Full_Dim
		### A window gets this from vanilla's defaults; a widget doesn't, so the
		### wheel and right-clicks would reach the panel or map behind.
		filter_mouse = left|right|wheel

		### A click outside the body: this button fills the screen behind it.
		button_normal = {
			size = { 100% 100% }
			### --- National Info's viewers close on their own key (PR F1) ---
			block "popup_close" {
				onclick = "[GetVariableSystem.Clear('te_popup')]"
			}
			### --- end National Info -----------------------------------------
			using = close_button_sound
		}

		widget = {
			parentanchor = center
			alwaystransparent = no
			block "popup_size" {
				size = { 640 620 }
			}

			using = Window_Background
			using = Window_Decoration_Spike

			vbox = {
				using = Window_Margins

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text" {
						block "popup_title" {}
					}
					blockoverride "button_close" {
						### --- National Info's viewers close on their own key (PR F1)
						block "popup_close" {
							onclick = "[GetVariableSystem.Clear('te_popup')]"
						}
						### --- end National Info --------------------------------------
					}
				}

				scrollarea = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					scrollbaralign_vertical = right
					scrollbarpolicy_horizontal = always_off

					scrollwidget = {
						flowcontainer = {
							direction = vertical
							ignoreinvisible = yes
							margin = { 10 6 }
							spacing = 4
							block "popup_list" {}
						}
					}

					scrollbar_vertical = {
						using = vertical_scrollbar
					}
					scrollbar_horizontal = {
						using = horizontal_scrollbar
					}
				}

				block "popup_footer" {}
			}
		}
	}

	### --- Help pages (charts-help-national-info plan, PR H1) -------------
	### A system's Help page: the shell above, sized for the How sections'
	### text (see the header). A page derives from it and fills the rest.
	type te_ui_help_popup = te_ui_popup {
		blockoverride "popup_size" {
			size = { 640 820 }
		}
	}
	### --- end Help pages ---------------------------------------------------

	type te_ui_columns_three = flowcontainer {
		direction = horizontal
		spacing = 30
		parentanchor = hcenter
		ignoreinvisible = yes

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 10
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }
			block "column_1" {}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 10
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }
			block "column_2" {}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 10
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }
			block "column_3" {}
		}
	}

	type te_ui_columns_two = flowcontainer {
		direction = horizontal
		spacing = 30
		parentanchor = hcenter
		ignoreinvisible = yes

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 10
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }
			block "column_1" {}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 10
			minimumsize = { 520 -1 }
			maximumsize = { 520 -1 }
			block "column_2" {}
		}
	}
}
