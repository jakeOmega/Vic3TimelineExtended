				### The UN headquarters, under its building: where it stands, or
				### that we host it but have not built it. Shown only when there is
				### something to say (un_overview_hq_sgui); it was the journal
				### entry's status text until 2026-09-28.
				flowcontainer = {
					direction = vertical
					spacing = 2
					minimumsize = { 480 -1 }
					visible = "[GetScriptedGui('un_overview_hq_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					icon = {
						size = { 48 48 }
						parentanchor = hcenter
						texture = "gfx/interface/icons/building_icons/building_un_headquarters.dds"
					}
					textbox = {
						autoresize = yes
						multiline = yes
						maximumsize = { 460 -1 }
						parentanchor = hcenter
						align = hcenter|nobaseline
						text = "[GetScriptedGui('un_overview_hq_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
					}
				}
			}
		}
	}
