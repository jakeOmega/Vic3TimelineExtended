			### The UN's own state, under the cells: only once it exists and has had
			### its first monthly update.
			flowcontainer = {
				direction = vertical
				spacing = 10
				ignoreinvisible = yes
				minimumsize = { 480 -1 }
				visible = "[GetScriptedGui('un_authority_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				### Authority and where it is heading (gui_style_guide.md rule 5; the
				### 2026-10-27 audit, UN-17). Three fixed cells, 116 + 180 + 160 and two 8 px
				### gaps = 472. The bar, bottom to top: its own background and frame; the
				### fill, pale (alpha 0.4), to the higher of authority and its target; the
				### fill, solid, to the lower. So a rise shows past the solid fill and a fall
				### as the tail about to go. The bar's own colour, pale: authority is good
				### for some players and bad for others. No eye marker. The tooltip says why
				### the target is where it is.
				flowcontainer = {
					direction = horizontal
					spacing = 8
					tooltip = "je_un_ov_authority_tt"

					widget = {
						size = { 116 24 }
						parentanchor = vcenter

						textbox = {
							parentanchor = left|vcenter
							autoresize = yes
							max_width = 116
							elide = right
							align = left|nobaseline
							using = un_fontsize_row
							default_format = "#tooltippable"
							text = "je_un_ov_authority_label"
						}
					}
					widget = {
						size = { 180 18 }
						parentanchor = vcenter

						default_progressbar_horizontal = {
							size = { 100% 100% }
							blockoverride "values" {
								value = 0
								min = 0
								max = 1
							}
						}
						widget = {
							size = { 100% 100% }
							alpha = 0.4

							default_progressbar_horizontal = {
								size = { 100% 100% }
								blockoverride "background" {}
								blockoverride "frame" {}
								blockoverride "values" {
									value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_auth_bar_high_frac') )]"
									min = 0
									max = 1
								}
							}
						}
						default_progressbar_horizontal = {
							size = { 100% 100% }
							blockoverride "background" {}
							blockoverride "frame" {}
							blockoverride "values" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_auth_bar_low_frac') )]"
								min = 0
								max = 1
							}
						}
					}
					widget = {
						size = { 160 24 }
						parentanchor = vcenter

						textbox = {
							parentanchor = left|vcenter
							autoresize = yes
							max_width = 160
							elide = right
							align = left|nobaseline
							using = un_fontsize_row
							text = "je_un_ov_authority_value"
						}
					}
				}

