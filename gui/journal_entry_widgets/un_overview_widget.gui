							}
							blockoverride "lit" {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_agency_iaea'), '(CFixedPoint)1' )]"
							}
							blockoverride "unlit" {
								visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_agency_iaea'), '(CFixedPoint)1' ) )]"
							}
						}
						te_un_ov_agency = {
							tooltip = "[Concatenate( Localize( 'je_un_ov_agency_unep_tt' ), SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_agency_unep'), '(CFixedPoint)1' ), 'je_un_ov_agency_founded', 'je_un_ov_agency_not_founded' ) )]"
							blockoverride "agency_texture" {
								texture = "gfx/interface/icons/goods_icons/wood.dds"
