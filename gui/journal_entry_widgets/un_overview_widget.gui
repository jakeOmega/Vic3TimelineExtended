### United Nations — the overview, at the top of both hosts (un_layout_widget.gui
### sets the order). A glance for the player who knows the UN: what needs us
### (a vote due, our dues, the motions we could table, the case against us),
### then how strong the UN is, who runs it and what it has built. The first
### part is a grid of Banking's te_banking_ov_cell (the owner's decision of
### 2026-10-27, which replaced the round-1 row of icons; gui_style_guide.md
### rule 4), with the journal entry's membership controls under the
### membership cell. Every figure is a un_disp_* value
### (common/script_values/un_overview_display_values.txt); every tooltip is the
### text it replaced, from a scripted GUI in un_chamber_sguis.txt.
### Icons are the UN's own (gfx/interface/icons/un_icons/, PR #572), and four of
### vanilla's used as vanilla uses them (a vote's approval, disapproval and
### undecided marks; money for dues; prestige for standing); what each shows
### is in docs/systems/un_gui_icons.md.
### Spec: docs/superpowers/archive/specs/2026-09-28-un-gui-pass-design.md §2;
### the cells: docs/audits/gui_audit/un.md, UN-1.

types un_overview_widget_types
{
	### A 0..1 share as a pie over a background disc, inside vanilla's
	### decorated round frame, its label beneath. The
	### textures are the Cultural Hegemony pie's (frame 1 transparent, frame 2
	### the colour; gui_modding_guide.md "Pie charts of script-held data").
	type te_un_ov_pie = widget {
		size = { 150 108 }

		icon = {
			size = { 86 86 }
			parentanchor = top|hcenter
			texture = "gfx/interface/backgrounds/round_frame_dec.dds"
		}
		widget = {
			size = { 62 62 }
			parentanchor = top|hcenter
			position = { 0 12 }

			progresspie = {
				size = { 100% 100% }
				min = 0
				max = 1
				value = 1
				texture = "gfx/interface/icons/un_icons/pie_rest.dds"
				framesize = { 128 128 }
				frame = 2
			}
			progresspie = {
				size = { 100% 100% }
				min = 0
				max = 1
				block "pie_value" {}
				texture = "gfx/interface/icons/un_icons/pie_members.dds"
				framesize = { 128 128 }
				frame = 2
			}
		}
		textbox = {
			parentanchor = bottom|hcenter
			autoresize = yes
			align = hcenter|nobaseline
			using = un_fontsize_overview
			default_format = "#tooltippable"
			block "label" {}
		}
	}

	### One agency: full colour once founded, dimmed until then. The instance
	### sets the texture on both icons and the value that picks one.
	type te_un_ov_agency = widget {
		size = { 40 40 }

		icon = {
			size = { 36 36 }
			parentanchor = center
			block "lit" {}
			block "agency_texture" {}
		}
		icon = {
			size = { 36 36 }
			parentanchor = center
			alpha = 0.25
			block "unlit" {}
			block "agency_texture" {}
		}
	}

	### A vacant permanent seat. Its hover is the council's, as the label's is:
	### the seats and who is in line for one (the 2026-10-27 audit, UN-21; it
	### used to send the player to hover the label instead).
	type te_un_ov_vacant_seat = widget {
		size = { 70 48 }
		tooltip = "[GetScriptedGui('un_chamber_council_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"

		icon = {
			size = { 66 44 }
			parentanchor = center
			texture = "gfx/interface/icons/un_icons/seat_vacant.dds"
		}
	}

	type te_un_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		visible = "[JournalEntry.IsActive]"

		un_chamber_panel = {
			spacing = 10

			### The cells (gui_style_guide.md rule 4, Banking's te_banking_ov_cell): what
			### needs us, two to a row, 238 + 4 + 238 = 480. Each cell's code is a
			### un_disp_* display value (un_overview_display_values.txt); each hover the
			### text it replaced. A row whose cells are all hidden collapses.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 4
				minimumsize = { 480 -1 }

				### Row 1: membership, with its controls under it, and the UN's tier.
				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					flowcontainer = {
						direction = vertical
						ignoreinvisible = yes
						spacing = 4

						### Membership: our seat, from no UN at all to a suspended permanent seat (un_disp_member_code; its hover the old status line).
						te_banking_ov_cell = {
							tooltip = "[GetScriptedGui('un_chamber_status_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
							size = { 238 70 }
							blockoverride "caption_width" {
								max_width = 154
							}
							blockoverride "caption" {
								text = "je_un_ov_member_caption"
							}
							blockoverride "icons" {
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_member_code'), '(CFixedPoint)0' )]"
									texture = "gfx/interface/icons/un_icons/member_no_un.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_member_code'), '(CFixedPoint)1' )]"
									texture = "gfx/interface/icons/un_icons/member_cannot_join.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_member_code'), '(CFixedPoint)2' )]"
									texture = "gfx/interface/icons/un_icons/member_can_join.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_member_code'), '(CFixedPoint)3' )]"
									texture = "gfx/interface/icons/un_icons/member.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_member_code'), '(CFixedPoint)4' )]"
									texture = "gfx/interface/icons/un_icons/member_permanent.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_member_code'), '(CFixedPoint)5' )]"
									texture = "gfx/interface/icons/un_icons/member_suspended_carried.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_member_code'), '(CFixedPoint)6' )]"
									texture = "gfx/interface/icons/un_icons/member_suspended.dds"
								}
							}
							blockoverride "word" {
								te_banking_ov_word = {
									text = "je_un_ov_member_word"
								}
							}
							blockoverride "third_line" {
								te_banking_ov_word = {
									visible = "[GetScriptedGui('un_ov_conference_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
									position = { 78 46 }
									text = "je_un_ov_member_conference"
								}
								te_banking_ov_word = {
									visible = "[And( GetScriptedGui('un_ov_refounding_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Not( GetScriptedGui('un_ov_conference_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
									position = { 78 46 }
									text = "je_un_ov_member_dissolved"
								}
							}
						}
						# Found or convene, join, and leave: the journal entry's buttons, which
						# are the AI's now, as controls under the cell they act on (UN-9).
						un_act_control = {
							blockoverride "act_context" {
								datacontext = "[GetScriptedGui('un_act_found_sgui')]"
							}
							blockoverride "act_label" {
								text = "[SelectLocalization( GetScriptedGui('un_ov_refounding_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), 'je_un_act_convene_label', 'je_un_act_found_label' )]"
							}
						}
						un_act_control = {
							blockoverride "act_context" {
								datacontext = "[GetScriptedGui('un_act_join_sgui')]"
							}
							blockoverride "act_label" {
								text = "je_un_act_join_label"
							}
						}
						# Leave is armed before it acts, as the veto is: a membership
						# undone by one stray click is decades of standing. The flag is
						# client-side GUI state (gui_modding_guide.md, the veto's note).
						flowcontainer = {
							direction = vertical
							spacing = 4
							ignoreinvisible = yes
							parentanchor = hcenter
							datacontext = "[GetScriptedGui('un_act_leave_sgui')]"

							button = {
								using = default_button_action
								size = { 236 30 }
								parentanchor = hcenter
								visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Not( GetVariableSystem.Exists('un_leave_armed') ) )]"
								enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
								onclick = "[GetVariableSystem.Toggle('un_leave_armed')]"
								tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"

								textbox = {
									parentanchor = center
									align = center|nobaseline
									autoresize = yes
									max_width = 226
									elide = right
									using = un_fontsize_row
									text = "je_un_act_leave_label"
								}
							}
							button = {
								using = default_button_action
								size = { 236 30 }
								parentanchor = hcenter
								visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetVariableSystem.Exists('un_leave_armed') )]"
								enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
								onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
								onclick = "[GetVariableSystem.Toggle('un_leave_armed')]"
								tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"

								textbox = {
									parentanchor = center
									align = center|nobaseline
									autoresize = yes
									max_width = 226
									elide = right
									using = un_fontsize_row
									text = "je_un_act_leave_confirm_label"
								}
							}
							button = {
								using = default_button_action
								size = { 236 30 }
								parentanchor = hcenter
								visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetVariableSystem.Exists('un_leave_armed') )]"
								onclick = "[GetVariableSystem.Toggle('un_leave_armed')]"
								tooltip = "je_un_act_leave_cancel_tt"

								textbox = {
									parentanchor = center
									align = center|nobaseline
									autoresize = yes
									max_width = 226
									elide = right
									using = un_fontsize_row
									text = "je_un_act_leave_cancel_label"
								}
							}
						}
					}
					### The UN's authority tier, and the enforcement it sets (un_disp_tier_code; its hover the tier's line). Its value and target are the bar under the cells.
					te_banking_ov_cell = {
						visible = "[GetScriptedGui('un_authority_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[GetScriptedGui('un_overview_tier_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_un_ov_authority_label"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_tier_code'), '(CFixedPoint)0' )]"
								texture = "gfx/interface/icons/un_icons/tier_moribund.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_tier_code'), '(CFixedPoint)1' )]"
								texture = "gfx/interface/icons/un_icons/tier_contested.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_tier_code'), '(CFixedPoint)2' )]"
								texture = "gfx/interface/icons/un_icons/tier_established.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_tier_code'), '(CFixedPoint)3' )]"
								texture = "gfx/interface/icons/un_icons/tier_strong.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_tier_code'), '(CFixedPoint)4' )]"
								texture = "gfx/interface/icons/un_icons/tier_supranational.dds"
							}
						}
						blockoverride "word" {
							te_banking_ov_word = {
								text = "je_un_ov_tier_word"
							}
						}
						blockoverride "third_line" {
							te_banking_ov_word = {
								position = { 78 46 }
								text = "je_un_ov_enforcement"
							}
						}
					}
				}
				### Row 2: the resolution in session and our ballot, and our own motions.
				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					### The General Assembly: whether a resolution needs our ballot, and how we cast it (un_disp_our_vote_code, UN-2; its hover what is in session). The word is red while our vote is due.
					te_banking_ov_cell = {
						visible = "[GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[GetScriptedGui('un_ov_session_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_un_ov_session_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)-1' )]"
								alpha = 0.4
								texture = "gfx/interface/icons/un_icons/topic_reform.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)0' )]"
								texture = "gfx/interface/icons/generic_icons/undecided_icon.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)1' )]"
								texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[Or( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)2' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)3' ) )]"
								texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)4' )]"
								texture = "gfx/interface/icons/un_icons/topic_reform.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)5' )]"
								alpha = 0.4
								texture = "gfx/interface/icons/generic_icons/undecided_icon.dds"
							}
						}
						blockoverride "word" {
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)-1' )]"
								text = "je_un_ov_vote_none"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)0' )]"
								text = "je_un_ov_vote_due"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)1' )]"
								text = "je_un_ov_vote_for"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)2' )]"
								text = "je_un_ov_vote_against"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)3' )]"
								text = "je_un_ov_vote_veto"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)4' )]"
								text = "je_un_ov_vote_ours"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)5' )]"
								text = "je_un_ov_vote_no_vote"
							}
						}
						blockoverride "third_line" {
							te_banking_ov_word = {
								visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_our_vote_code'), '(CFixedPoint)-1' ) )]"
								position = { 78 46 }
								text = "je_un_session_months"
							}
						}
					}
					### Our motions: whether we can table a resolution of our own, and how many topics have a case (un_disp_floor_code, UN-1 and UN-8; its hover those topics).
					te_banking_ov_cell = {
						visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[GetScriptedGui('un_ov_motions_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_un_ov_motions_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)3' ) )]"
								alpha = 0.4
								texture = "gfx/interface/icons/un_icons/topic_reform.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)3' )]"
								texture = "gfx/interface/icons/un_icons/topic_reform.dds"
							}
						}
						blockoverride "word" {
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)1' )]"
								text = "je_un_ov_motions_held"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)2' )]"
								text = "je_un_ov_motions_waiting"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)3' )]"
								text = "je_un_ov_motions_ready"
							}
						}
						blockoverride "third_line" {
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)1' )]"
								position = { 78 46 }
								text = "je_un_ov_motions_held_fig"
							}
							te_banking_ov_word = {
								visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)2' ), Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_propose_wait_months'), '(CFixedPoint)0' ) ) )]"
								position = { 78 46 }
								text = "je_un_ov_motions_wait_fig"
							}
							te_banking_ov_word = {
								visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)2' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_propose_wait_months'), '(CFixedPoint)0' ) )]"
								position = { 78 46 }
								text = "je_un_ov_motions_wait_unknown"
							}
							te_banking_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_floor_code'), '(CFixedPoint)3' )]"
								position = { 78 46 }
								text = "je_un_ov_motions_free_fig"
							}
						}
					}
				}
				### Row 3: our dues and our standing.
				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					### Our dues: paid, withheld, or withheld long enough to cost our vote (un_disp_dues_code; its hover our dues' lines).
					te_banking_ov_cell = {
						visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[GetScriptedGui('un_chamber_dues_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_un_ov_dues_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								visible = "[Or( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dues_code'), '(CFixedPoint)3' ), Or( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dues_code'), '(CFixedPoint)4' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dues_code'), '(CFixedPoint)5' ) ) )]"
								texture = "gfx/interface/icons/generic_icons/money.dds"
							}
							icon = {
