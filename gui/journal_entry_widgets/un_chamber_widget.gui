			}
		}
	}

	type te_un_sec_programmes = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Programmes and Conventions ----
		# World tallies of the UN's programmes and conventions: how many
		# countries take part in each. They were the journal entry's
		# "Resolutions & Programs" status lines until 2026-09-28. A table, and
		# collapsed by default: world counts, not the player's own business.
