				text = "[GetScriptedGui('un_chamber_reasons_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_in_session_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_ballot"
				}
			}
			un_chamber_text = {
				text = "[GetScriptedGui('un_chamber_active_voters_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
		}
	}

	type te_un_sec_propose = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Table a Resolution ----
		# A subsection of the General Assembly, shown when nothing is in session
		# (every proposal needs the one-vote lock free). Collapsed by default:
		# thirty ExecuteTooltip rows re-render every frame the panel is open.
		#
		# The rows are the topics a member can put before the Assembly on its own
		# initiative, in the order the chamber thinks about them — censure and
		# enforcement first, then requests for help, then the charter itself, then
		# the conventions the docket also raises. Each row's op code:
		#
		#   0 condemnation   1 sanctions   2 expulsion
		#   3 military mandate            4 peacekeepers   5 humanitarian aid
		#   6 charter reform (redesign phase 2)
		#   7 human rights   8 ICC         9 NPT          10 climate
		#   11 pandemic      12 refugee    13 heritage    14 decolonization
		#   15 space         16 law of the sea
		#
		# The table is repeated in common/scripted_guis/un_chamber_sguis.txt and in
		# the row renderers in
		# common/scripted_effects/un_chamber_display_effects.txt; keep all three in
		# step (test_un_chamber_propose_ops.py checks that they are). Nothing here
		# re-derives an eligibility rule: the Propose button asks
		# un_chamber_propose_sgui, which asks the very triggers the journal entry's
		# own scripted buttons and the docket ask.
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin_left = 20
			margin_bottom = 6

			un_chamber_subsection_header = {
				blockoverride "left_text" {
					text = "je_un_chamber_propose_header"
				}
				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('un_chamber_propose_open')]"
				}
				blockoverride "onclick_showmore" {
					visible = "[Not(GetVariableSystem.Exists('un_chamber_propose_open'))]"
				}
				blockoverride "onclick_showless" {
					visible = "[GetVariableSystem.Exists('un_chamber_propose_open')]"
				}
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			visible = "[GetVariableSystem.Exists('un_chamber_propose_open')]"

