	type te_un_sec_obligations = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Our obligations (redesign phase 5) ----
		# What membership asks of us: dues and arrears beside the whole budget,
		# the conventions that bind us, and the pressure on our sovereignty.
		# Open by default, like every section that changes.
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_chamber_obligations_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_obligations_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_obligations_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_obligations_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_obligations_closed'))]"

			# No UN: one line, and nothing else.
			un_chamber_text = {
				visible = "[Not( GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				text = "je_un_chamber_obligations_no_un"
			}

			# Dues: a member's assessment and arrears, or, outside, anything
			# still owed from before; then the whole budget.
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_dues"
				}
			}
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_dues_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			un_chamber_text = {
				visible = "[And( GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Not( GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
				text = "[GetScriptedGui('un_chamber_obligations_outside_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			# Everyone: what all the members pay, beside what we pay (owner,
			# 2026-09-28; it sat below the conventions).
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_budget_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}

			# A member: each convention we are party to, and its terms for us,
			# their modifiers on hover (un_chamber_regime_lines).
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_regimes"
				}
			}
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_regimes_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}

			# A Strong UN's reach into our country: intelligence sharing and the
			# sovereignty reaction, which grow with the tier rather than with
			# enforcement (un_chamber_reach_lines). Only when one of them applies.
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_reach_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_reach"
				}
			}
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_reach_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_reach_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}

		}
	}

	type te_un_sec_dev_fund = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[GetScriptedGui('un_chamber_dev_fund_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		# ---- The World Development Fund (owner, 2026-10-03) ----
		# Who the Fund pays this month and how much, under the line a member's
		# GDP per head must be at or under: a table of the month's figures,
		# then the recipients, largest grant first (un_dev_fund_recipient_lines).
		# Only while the Fund stands; open by default, as a live list. The
		# rows read the monthly snapshot, so nothing here iterates but the list.
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_dev_fund_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_dev_fund_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_dev_fund_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_dev_fund_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_dev_fund_closed'))]"

			# The line, with how it was set this month on hover.
			un_chamber_value_row = {
				tooltip = "[GetScriptedGui('un_chamber_dev_fund_line_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
