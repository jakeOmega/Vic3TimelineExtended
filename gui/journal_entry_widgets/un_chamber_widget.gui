	type te_un_sec_mandates = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Authorized military mandates ----
		# Open by default, like every section that changes. The register has
		# anything to say only once the Assembly has issued an authorization.
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_chamber_mandates_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_mandates_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_mandates_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_mandates_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_mandates_closed'))]"

			un_chamber_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_mandate_register"
				}
			}
			un_chamber_text = {
				text = "[GetScriptedGui('un_chamber_mandates_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			# The case we could table ourselves, while we hold no mandate and our
			# claims give us one.
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_mandate_case_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_mandate_case"
				}
			}
			# Hidden with its heading, so an empty text box leaves no blank line.
			# The case search runs only while this section is open.
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_mandate_case_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_mandate_case_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			# Table it from here (the 2026-10-27 audit, UN-21): the proposal
			# list's mandate row, op 3 of un_chamber_propose_sgui, with the
			# same gates, greyed reasons and effect.
			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				ignoreinvisible = yes
				margin = { 0 4 }
				visible = "[GetScriptedGui('un_chamber_mandate_case_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				datacontext = "[GetScriptedGui('un_chamber_propose_sgui')]"

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_mandate_propose_label"
					}
					blockoverride "action_binding" {
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ) ) )]"
					}
				}
			}
		}
	}

	type te_un_sec_archive = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Archive of closed resolutions ----
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_chamber_history_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_history_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_history_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('un_chamber_history_open')]"
			}
		}

		un_chamber_panel = {
			visible = "[GetVariableSystem.Exists('un_chamber_history_open')]"

			# Voting-detail depth for the archive: a section nested in this one,
			# so it sits inside the archive's panel, set in from its edge, rather
			# than between the archive's header and its panel where it read as the
			# next section. Rebuilt from the containers every frame, so nothing
			# about it survives a save/load beyond the toggle itself.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				margin_left = 20
				margin_bottom = 6

				un_chamber_subsection_header = {
					blockoverride "left_text" {
						text = "je_un_chamber_details_header"
					}
					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle('un_chamber_history_details')]"
					}
					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.Exists('un_chamber_history_details'))]"
					}
					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.Exists('un_chamber_history_details')]"
					}
				}
			}

			# One short row per archived resolution, newest first: its title and
			# how it ended, the rest of its card on hover (the 2026-10-27 audit,
			# UN-16; the op table: un_chamber_history_brief_row_sgui).
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 6
				visible = "[Not(GetVariableSystem.Exists('un_chamber_history_details'))]"

				un_chamber_text = {
					visible = "[Not( GetScriptedGui('un_chamber_history_brief_row_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) )]"
					text = "je_un_chamber_no_history"
				}
				un_chamber_text = {
					visible = "[GetScriptedGui('un_chamber_history_brief_row_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					default_format = "#tooltippable"
					text = "[GetScriptedGui('un_chamber_history_brief_row_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					tooltip = "[GetScriptedGui('un_chamber_history_card_row_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				}
				un_chamber_text = {
					visible = "[GetScriptedGui('un_chamber_history_brief_row_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
