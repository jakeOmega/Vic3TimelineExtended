	type te_un_sec_obligations = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Our obligations (redesign phase 5) ----
		# What membership asks of us: dues and arrears beside the whole budget,
		# the conventions that bind us, and the pressure on our sovereignty.
		# Open by default, like every section that changes.
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_chamber_obligations_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_obligations_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_obligations_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_obligations_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_obligations_closed'))]"

			# No UN: one line, and nothing else.
			un_chamber_text = {
				visible = "[Not( GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				text = "je_un_chamber_obligations_no_un"
			}

			# Dues: a member's assessment and arrears, or, outside, anything
			# still owed from before; then the whole budget.
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_dues"
				}
			}
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_dues_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			# Withhold or pay, under the dues they act on (UN-9), taking turns
			# in one slot.
			un_act_row = {
				visible = "[Or( GetScriptedGui('un_act_withhold_dues_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('un_act_pay_dues_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				blockoverride "act_row" {
					un_act_slot = {
						un_act_control = {
							blockoverride "act_context" {
								datacontext = "[GetScriptedGui('un_act_withhold_dues_sgui')]"
							}
							blockoverride "act_label" {
								text = "je_un_act_withhold_dues_label"
							}
						}
						un_act_control = {
							blockoverride "act_context" {
								datacontext = "[GetScriptedGui('un_act_pay_dues_sgui')]"
							}
							blockoverride "act_label" {
								text = "je_un_act_pay_dues_label"
							}
						}
					}
				}
			}
			un_chamber_text = {
				visible = "[And( GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Not( GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
				text = "[GetScriptedGui('un_chamber_obligations_outside_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			# Everyone: what all the members pay, beside what we pay (owner,
			# 2026-09-28; it sat below the conventions). A table since the
			# 2026-10-27 audit (UN-13): it was one seven-figure sentence that
			# also restated the Development Fund's section.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				visible = "[GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_budget_dues_label"
					}
					blockoverride "row_value" {
						text = "je_un_budget_dues_value"
					}
				}
				un_chamber_value_row = {
					tooltip = "je_un_budget_arrears_tt"
					blockoverride "row_label" {
						text = "je_un_budget_arrears_label"
					}
					blockoverride "row_value" {
						text = "je_un_budget_arrears_value"
					}
				}
				un_chamber_value_row = {
					visible = "[GetScriptedGui('un_chamber_budget_force_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					blockoverride "row_label" {
						text = "je_un_budget_force_label"
					}
					blockoverride "row_value" {
						text = "je_un_budget_force_value"
					}
				}
				un_chamber_value_row = {
					visible = "[GetScriptedGui('un_chamber_budget_dev_fund_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					blockoverride "row_label" {
						text = "je_un_budget_dev_fund_label"
					}
					blockoverride "row_value" {
						text = "je_un_budget_dev_fund_value"
					}
				}
				un_chamber_value_row = {
					visible = "[GetScriptedGui('un_chamber_budget_lending_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "je_un_budget_lending_tt"
					blockoverride "row_label" {
						text = "je_un_budget_lending_label"
					}
					blockoverride "row_value" {
						text = "je_un_budget_lending_value"
					}
				}
			}

			# A member: our grain pledge to the World Food Reserve, with Pledge
			# Grain or Withdraw Our Pledge under it (UN-9; the line used to send
			# the player to a button elsewhere).
			un_chamber_text = {
				visible = "[And( GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('un_chamber_food_reserve_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				text = "[GetScriptedGui('un_chamber_food_reserve_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			un_act_row = {
				visible = "[Or( GetScriptedGui('un_act_food_reserve_pledge_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('un_act_food_reserve_withdraw_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				blockoverride "act_row" {
					un_act_slot = {
						un_act_control = {
							blockoverride "act_context" {
								datacontext = "[GetScriptedGui('un_act_food_reserve_pledge_sgui')]"
							}
							blockoverride "act_label" {
								text = "je_un_act_food_pledge_label"
							}
						}
						un_act_control = {
							blockoverride "act_context" {
								datacontext = "[GetScriptedGui('un_act_food_reserve_withdraw_sgui')]"
							}
							blockoverride "act_label" {
								text = "je_un_act_food_withdraw_label"
							}
						}
					}
				}
			}
			# A Binding Ceasefire that binds or protects us.
			un_chamber_text = {
				visible = "[And( GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('un_chamber_orders_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				text = "[GetScriptedGui('un_chamber_orders_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}

			# A member: each convention we are party to, and its terms for us,
			# their modifiers on hover (un_chamber_regime_lines).
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_regimes"
				}
			}
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_regimes_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}

			# A Strong UN's reach into our country: intelligence sharing and the
			# sovereignty reaction, which grow with the tier rather than with
			# enforcement (un_chamber_reach_lines). Only when one of them applies.
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_reach_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_reach"
				}
			}
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_reach_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_reach_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}

		}
	}

	type te_un_sec_dev_fund = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[GetScriptedGui('un_chamber_dev_fund_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		# ---- The World Development Fund (owner, 2026-10-03) ----
		# Who the Fund pays this month and how much, under the line a member's
		# GDP per head must be at or under: a table of the month's figures,
		# then the recipients, largest grant first (un_dev_fund_recipient_lines).
		# Only while the Fund stands; open by default, as a live list. The
		# rows read the monthly snapshot, so nothing here iterates but the list.
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_dev_fund_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_dev_fund_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_dev_fund_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_dev_fund_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_dev_fund_closed'))]"

			# Our own position first, with the Development Programs controls
			# under it (the 2026-10-27 audit, UN-9 and UN-13: it sat under Our
			# Obligations' dues, and the buttons in the Actions grid).
			un_chamber_text = {
				text = "[GetScriptedGui('un_chamber_dev_fund_position_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			# Fund while we don't contribute; once we do, Reduce, Raise and Defund
			# in a row of their own (116 + 4 + 116 + 4 + 116 = 356). A control is
			# a fixed-size slot, so Reduce at the smallest size and Raise at the
			# largest leave their place empty rather than moving the others.
			# Defund shows whenever we contribute.
			un_act_row = {
				visible = "[GetScriptedGui('un_act_fund_development_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "act_row" {
					un_act_control = {
						blockoverride "act_context" {
							datacontext = "[GetScriptedGui('un_act_fund_development_sgui')]"
						}
						blockoverride "act_label" {
							text = "je_un_act_fund_development_label"
						}
					}
				}
			}
			un_act_row = {
				visible = "[GetScriptedGui('un_act_defund_development_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "act_row" {
					un_act_control = {
						blockoverride "act_context" {
							datacontext = "[GetScriptedGui('un_act_reduce_development_sgui')]"
						}
						blockoverride "act_size" {
							size = { 116 30 }
						}
						blockoverride "act_label_width" {
							max_width = 108
						}
						blockoverride "act_label" {
							text = "je_un_act_reduce_development_label"
						}
					}
					un_act_control = {
						blockoverride "act_context" {
							datacontext = "[GetScriptedGui('un_act_raise_development_sgui')]"
						}
						blockoverride "act_size" {
							size = { 116 30 }
						}
						blockoverride "act_label_width" {
							max_width = 108
						}
						blockoverride "act_label" {
							text = "je_un_act_raise_development_label"
						}
					}
					un_act_control = {
						blockoverride "act_context" {
							datacontext = "[GetScriptedGui('un_act_defund_development_sgui')]"
						}
						blockoverride "act_size" {
							size = { 116 30 }
						}
						blockoverride "act_label_width" {
							max_width = 108
						}
						blockoverride "act_label" {
							text = "je_un_act_defund_development_label"
						}
					}
				}
			}

			# The line, with how it was set this month on hover.
			un_chamber_value_row = {
				tooltip = "[GetScriptedGui('un_chamber_dev_fund_line_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				blockoverride "row_label" {
					text = "je_un_dev_fund_line_label"
				}
				blockoverride "row_value" {
					text = "je_un_dev_fund_line_value"
				}
			}
			un_chamber_value_row = {
				blockoverride "row_label" {
					text = "je_un_dev_fund_avg_label"
				}
				blockoverride "row_value" {
					text = "je_un_dev_fund_avg_value"
				}
			}
			un_chamber_value_row = {
				tooltip = "je_un_dev_fund_eligible_tt"
				blockoverride "row_label" {
					text = "je_un_dev_fund_eligible_label"
				}
				blockoverride "row_value" {
					text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dev_fund_recipients')|0]"
				}
			}
			un_chamber_value_row = {
				blockoverride "row_label" {
					text = "je_un_dev_fund_paid_label"
				}
				blockoverride "row_value" {
					text = "je_un_dev_fund_paid_value"
				}
			}

			un_chamber_subheader = {
				blockoverride "subheader_text" {
					text = "je_un_dev_fund_sub_recipients"
				}
			}
			un_chamber_text = {
				text = "[GetScriptedGui('un_chamber_dev_fund_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
		}
	}

	type te_un_sec_ballot = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Recorded ballot of the resolution in session ----
		# A subsection of the General Assembly, shown while a resolution is in
		# session. Collapsed by default.
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin_left = 20
			margin_bottom = 6

			un_chamber_subsection_header = {
				blockoverride "left_text" {
					text = "je_un_chamber_votes_header"
				}
				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('un_chamber_votes_open')]"
				}
				blockoverride "onclick_showmore" {
					visible = "[Not(GetVariableSystem.Exists('un_chamber_votes_open'))]"
				}
				blockoverride "onclick_showless" {
					visible = "[GetVariableSystem.Exists('un_chamber_votes_open')]"
				}
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			visible = "[GetVariableSystem.Exists('un_chamber_votes_open')]"

			# Redesign phase 3: why the members voted as they did. Both headings
			# wait for a resolution to be in session; without one, the ballot
			# builder prints the one line saying so.
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_in_session_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_reasons"
				}
			}
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_in_session_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_reasons_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_in_session_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_ballot"
				}
			}
			un_chamber_text = {
				text = "[GetScriptedGui('un_chamber_active_voters_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
		}
	}

	type te_un_sec_propose = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Propose a Resolution ----
		# A subsection of the General Assembly, shown when nothing is in session
		# (every proposal needs the one-vote lock free). Collapsed by default:
		# its rows re-render every frame the panel is open. Its header says how
		# many topics have a case (the overview's monthly snapshot,
		# un_propose_ready_snapshot).
		#
		# The rows are the topics a member can put before the Assembly on its own
		# initiative, in two passes over the same list (the 2026-10-27 audit,
		# UN-7, the owner's decision of that day): the topics with a case for
		# us first, under an open "Ready to Table", and the rest under a
		# collapsed "No Case Now". A topic in force (a convention ratified, an
		# institution founded) is in neither: the intro counts them once. Each
		# pass keeps the order the chamber thinks about them in: censure and
		# enforcement first, then requests for help, then the charter itself,
		# then the court and the institutions, then the conventions the docket
		# also raises. Each row's op code:
		#
		#   0 condemnation   1 sanctions   2 expulsion   3 military mandate
		#   4 peacekeepers   5 humanitarian aid   6 charter reform
		#   7-19, 29, 31-33 the conventions   20-28, 30 the charter's new business
		#
		# The table is repeated in common/scripted_guis/un_chamber_sguis.txt
		# (un_chamber_propose_sgui, _row_sgui, _ready_sgui, _shelved_sgui) and in
		# the row renderers in common/scripted_effects/un_chamber_display_effects.txt;
		# keep them in step (test_un_chamber_propose_ops.py checks that they are).
		# Nothing here re-derives an eligibility rule: the Propose button asks
		# un_chamber_propose_sgui, which asks the very triggers the journal
		# entry's own scripted buttons and the docket ask.
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin_left = 20
			margin_bottom = 6

			un_chamber_subsection_header = {
				blockoverride "left_text" {
					text = "je_un_chamber_propose_header"
				}
				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('un_chamber_propose_open')]"
				}
				blockoverride "onclick_showmore" {
					visible = "[Not(GetVariableSystem.Exists('un_chamber_propose_open'))]"
				}
				blockoverride "onclick_showless" {
					visible = "[GetVariableSystem.Exists('un_chamber_propose_open')]"
				}
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			visible = "[GetVariableSystem.Exists('un_chamber_propose_open')]"

			un_chamber_row_text = {
				text = "[GetScriptedGui('un_chamber_propose_intro_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}

			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_propose_ready"
				}
			}
			# Nothing ready, by the monthly count the header reads (a topic that
			# gains a case mid-month shows its row before the count catches up).
			un_chamber_row_text = {
				visible = "[And( GetScriptedGui('un_chamber_member_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_propose_ready_count'), '(CFixedPoint)0' ) )]"
				text = "je_un_ov_ready_none"
			}
			un_chamber_propose_row = {
				visible = "[GetScriptedGui('un_chamber_propose_ready_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				blockoverride "row_text" {
					text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End)]"
				}
				blockoverride "row_action" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
				}
			}
			un_chamber_propose_row = {
				visible = "[GetScriptedGui('un_chamber_propose_ready_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				blockoverride "row_text" {
					text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End)]"
				}
				blockoverride "row_action" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
				}
			}
			un_chamber_propose_row = {
				visible = "[GetScriptedGui('un_chamber_propose_ready_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)30' ) ).End )]"
				blockoverride "row_text" {
					text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)30' ) ).End)]"
