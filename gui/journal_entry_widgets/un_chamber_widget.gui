					onclick = "[GetScriptedGui('un_chamber_mission_withdraw_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
					tooltip = "[GetScriptedGui('un_chamber_mission_withdraw_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
				}
			}
			un_chamber_mission_row = {
				visible = "[GetScriptedGui('un_chamber_mission_slot_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
				blockoverride "row_text" {
					text = "[GetScriptedGui('un_chamber_mission_slot_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
				}
				blockoverride "progress" {
					tooltip = "je_un_chamber_mission_slot_7_tt"
					default_progressbar_horizontal = {
						size = { 200 12 }
						parentanchor = vcenter
						blockoverride "values" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_msn_slot_7_frac') )]"
							min = 0
							max = 1
						}
					}
					textbox = {
						autoresize = yes
						parentanchor = vcenter
						align = left|nobaseline
						using = un_fontsize_row
						default_format = "#tooltippable"
						text = "je_un_chamber_mission_slot_7_figures"
					}
				}
				blockoverride "join_action" {
					visible = "[And( And( GetScriptedGui('un_chamber_mission_volunteer_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('un_chamber_mission_joinable_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ) ), Not( GetScriptedGui('un_chamber_mission_withdraw_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ) ) )]"
					enabled = "[GetScriptedGui('un_chamber_mission_join_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
					onclick = "[GetScriptedGui('un_chamber_mission_join_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
					tooltip = "[Concatenate( GetScriptedGui('un_chamber_mission_join_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('un_chamber_mission_join_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ) ) )]"
				}
				blockoverride "withdraw_action" {
					visible = "[GetScriptedGui('un_chamber_mission_withdraw_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
					onclick = "[GetScriptedGui('un_chamber_mission_withdraw_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
					tooltip = "[GetScriptedGui('un_chamber_mission_withdraw_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
				}
			}
			# "No mission is in the field", or the missions opened while every row
			# was taken.
			un_chamber_text = {
				visible = "[GetScriptedGui('un_chamber_missions_unlisted_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_chamber_missions_active_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			# Ended missions: a subsection, collapsed by default.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				margin_left = 20
				margin_top = 6
				margin_bottom = 6

				un_chamber_subsection_header = {
					blockoverride "left_text" {
						text = "je_un_chamber_sub_missions_ended"
					}
					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle('un_chamber_missions_ended_open')]"
					}
					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.Exists('un_chamber_missions_ended_open'))]"
					}
					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.Exists('un_chamber_missions_ended_open')]"
					}
				}
			}
			un_chamber_text = {
				visible = "[GetVariableSystem.Exists('un_chamber_missions_ended_open')]"
				text = "[GetScriptedGui('un_chamber_missions_ended_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
		}
	}

	type te_un_sec_programmes = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Programmes and Conventions ----
		# World tallies of the UN's programmes and conventions: how many
		# countries take part in each, and, in the Ours column, whether we do,
		# with the control that joins or leaves the programmes a member runs by
		# choice and lifts the sanctions we enforce (the 2026-10-27 audit, UN-9:
		# those were journal-entry buttons at the bottom of the panel). They
		# were the journal entry's "Resolutions & Programs" status lines until
		# 2026-09-28. Open by default since the owner's decision of 2026-10-27,
		# which reversed "collapsed by default: world counts, not the player's
		# own business": the Ours column is the player's business. Development
		# Programs are run from the World Development Fund's section.
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_programmes_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_programmes_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_programmes_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_programmes_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_programmes_closed'))]"

			# The column heads.
			un_chamber_programme_row = {
				blockoverride "row_label" {
					text = "je_un_prog_head_label"
