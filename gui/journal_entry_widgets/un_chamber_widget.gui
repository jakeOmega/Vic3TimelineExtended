### United Nations JE widget — the General Assembly chamber.
### Shows the resolution currently before the Assembly, the recorded ballot,
### and the bounded history of closed resolutions.
###
### Everything this widget renders is built in script and handed over as
### tooltip text by common/scripted_guis/un_chamber_sguis.txt (vanilla's
### "Using SGUIs to build lists in loc" pattern — see
### game/common/scripted_guis/scripted_guis.md). The resolution containers
### store *countries* (un_res_proposer / un_res_target / un_res_vetoer and the
### un_res_yes / un_res_no voter lists), and the GUI chain
### `Var('x').GetCountry.GetName` is recorded as not working in this mod
### (docs/guides/gui_modding_guide.md gotcha #11) — which is why the
### covert-operations widget stores a state instead of a country. Iterating the
### country lists in script and printing `[THIS.GetCountry.GetName]` is the
### shape vanilla ships for exactly this case
### (je_hispanoamerica_not_recognized_countries_sgui, ip4_spain_l_english.yml).
###
### The widget is no longer display-only. Two of its scripted GUIs act:
###   un_chamber_vote_sgui     casts our ballot on the resolution in session
###                            (op 0 favour / 1 against / 2 veto)
###   un_chamber_propose_sgui  tables one of the seven member-initiated topics
###                            (op 0 condemn / 1 sanctions / 2 expulsion /
###                             3 mandate / 4 peacekeepers / 5 aid /
###                             6 charter reform)
### Both run the same script the existing paths run — un_vote.1's option bodies
### and the journal entry's own proposal buttons — so the AI, which still votes
### by event and proposes by button, behaves exactly as before. Every other
### scripted GUI here is still called only through ExecuteTooltip, which
### renders an effect without executing it.
###
### Wired via `widget = { name = "widget_je_un_chamber" container =
### "custom_widget_container_2" }` in je_united_nations, so it sits under the
### status description and above the button grid.
###
### The expand/collapse state lives in GetVariableSystem (client-side UI state,
### never saved and never gameplay state), keyed per section rather than per
### row: a script container exposes no stable string id to the GUI
### (ScriptContainer has no GetIDString, and GetVariableValue returns a
### CFixedPoint that cannot be fed to Concatenate), so a per-row toggle key
### cannot be built. One toggle switches the whole history between the brief
### and the detailed rendering instead.

types un_chamber_widget_types
{
	type un_chamber_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_large
	}

	type un_chamber_panel = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 8 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	type un_chamber_section_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 520 38 }
		}
	}

	### Smaller body text for the proposal rows, which carry four or five short
	### lines each and have to leave room for a button beside them.
	type un_chamber_row_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 460 -1 }
		maximumsize = { 460 -1 }
		align = left|nobaseline
		using = fontsize_medium
	}

	### A chamber action button. `action_binding` carries the four properties
	### that address the scripted GUI — visible / enabled / onclick / tooltip —
	### because they are the only part that differs between one control and the
	### next; the label and the sizing are shared.
	type un_chamber_action_button = button {
		using = default_button_action
		size = { 236 30 }
		parentanchor = vcenter

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 226
			elide = right
			using = fontsize_small
			block "action_label" {}
		}

		block "action_binding" {}
	}

	### One row of the proposal list: the topic's description, built in script
	### by un_chamber_propose_row_sgui, and the Propose control. Every row shares
	### one scripted GUI (un_chamber_propose_sgui) and differs only by its op
	### code, so the datacontext lives here rather than on each instance.
	type un_chamber_propose_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2
		margin = { 4 4 }
		datacontext = "[GetScriptedGui('un_chamber_propose_sgui')]"

		un_chamber_row_text = {
			block "row_text" {}
		}

		button = {
			using = default_button_action
			size = { 200 28 }

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 190
				elide = right
				using = fontsize_small
				text = "je_un_chamber_propose_button_label"
			}

			block "row_action" {}
		}
	}
}


### WIDGETS
flowcontainer = {
	name = "widget_je_un_chamber"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	spacing = 4

	# je_united_nations carries `is_shown_when_inactive`, so this widget is
	# built for every country that can see the entry at all — including ones
	# whose journal entry has never activated, where none of the UN's variables
	# and globals exist. Everything the panels render is guarded in script, but
	# there is nothing worth rendering in that state and the sguis re-run every
	# frame the entry is on screen, so the whole widget is gated here. Vanilla
	# uses the same test in gui/journal_entry.gui:670.
	visible = "[JournalEntry.IsActive]"

	# ---- Our own standing, and the resolution in session ----
	un_chamber_panel = {
		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_status_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		# Who holds the five permanent seats, and who is in line for an open one.
		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_council_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_active_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}

		# Redesign phase 3: how the Assembly reads our own position on the
		# resolution in session — the lean the AI votes by, term by term.
		un_chamber_text = {
			visible = "[GetScriptedGui('un_chamber_position_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			text = "[GetScriptedGui('un_chamber_position_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}

		# ---- Our ballot ----
		# Available from the day the resolution opens; the un_vote.1 popup that
		# arrives on day 30 is the same three options and is skipped entirely
		# once a ballot is on the record (its trigger is re-evaluated when it
		# fires). One scripted GUI, one op code per control:
		#
		#   op 0  Vote in Favour    op 1  Vote Against    op 2  Veto
		#
		# The table is repeated in common/scripted_guis/un_chamber_sguis.txt;
		# keep the two in step. Each tooltip is IsValidTooltip (why the control
		# is greyed out) concatenated with ExecuteTooltip (what the vote does),
		# which is the un_vote.1 option's own consequence text, lobbying
		# keep/break line included.
		flowcontainer = {
			direction = vertical
			spacing = 4
			ignoreinvisible = yes
			parentanchor = hcenter
			datacontext = "[GetScriptedGui('un_chamber_vote_sgui')]"

			flowcontainer = {
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_vote_yes_label"
					}
					blockoverride "action_binding" {
						visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
					}
				}

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_vote_no_label"
					}
					blockoverride "action_binding" {
						visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
					}
				}
			}

			# The veto is armed before it is cast. A scripted GUI's documented
			# confirm_title / confirm_text fields have no usage anywhere in
			# vanilla to copy, and this cannot be tested without running the
			# game, so the confirmation is built out of the expander mechanism
			# this widget already relies on: GetVariableSystem state, which is
			# client-side, never saved and never gameplay state.
			flowcontainer = {
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_vote_veto_label"
					}
					blockoverride "action_binding" {
						visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Not(GetVariableSystem.Exists('un_chamber_veto_armed')) )]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
					}
				}

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_vote_veto_confirm_label"
					}
					blockoverride "action_binding" {
						visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), GetVariableSystem.Exists('un_chamber_veto_armed') )]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
					}
				}

				button = {
					using = default_button_action
					size = { 152 30 }
					parentanchor = vcenter
					visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), GetVariableSystem.Exists('un_chamber_veto_armed') )]"
					onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
					tooltip = "je_un_chamber_vote_veto_cancel_tt"

					textbox = {
						parentanchor = center
						align = center|nobaseline
						autoresize = yes
						max_width = 142
						elide = right
						using = fontsize_small
						text = "je_un_chamber_vote_veto_cancel_label"
					}
				}
			}
		}
	}

	# ---- How international standing works ----
	# Collapsed by default like every other section here. The text never
	# changes, and ExecuteTooltip re-renders it every frame the panel is
	# visible, so there is no reason to keep it open. The score itself, its
	# tier and this year's accrual are in the always-visible status panel
	# above — this is only the explanation of where they come from.
	un_chamber_section_header = {
		blockoverride "left_text" {
			text = "je_un_chamber_standing_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_standing')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_standing'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_standing')]"
		}
	}

	un_chamber_panel = {
		visible = "[GetVariableSystem.Exists('un_chamber_standing')]"

		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_standing_help_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}

	# ---- Our exposure (redesign phase 3) ----
	# Our own dossier, and which punitive resolutions our record would support
	# against us today. Collapsed by default, like every other section.
	un_chamber_section_header = {
		blockoverride "left_text" {
			text = "je_un_chamber_exposure_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_exposure')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_exposure'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_exposure')]"
		}
	}

	un_chamber_panel = {
		visible = "[GetVariableSystem.Exists('un_chamber_exposure')]"

		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_exposure_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}

	# ---- Missions in the field (redesign phase 6) ----
	# The mission register: where the UN is, for whom, how far along, and
	# who serves in each mission. Collapsed by default.
	un_chamber_section_header = {
		blockoverride "left_text" {
			text = "je_un_chamber_missions_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_missions')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_missions'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_missions')]"
		}
	}

	un_chamber_panel = {
		visible = "[GetVariableSystem.Exists('un_chamber_missions')]"

		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_missions_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}

	# ---- Our obligations (redesign phase 5) ----
	# What membership asks of us: dues and arrears, the conventions' regimes
	# that bind us, and the pressure on our sovereignty at home. Collapsed by
	# default, like every other section.
	un_chamber_section_header = {
		blockoverride "left_text" {
			text = "je_un_chamber_obligations_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_obligations')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_obligations'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_obligations')]"
		}
	}

	un_chamber_panel = {
		visible = "[GetVariableSystem.Exists('un_chamber_obligations')]"

		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_obligations_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}

	# ---- Recorded ballot of the resolution in session ----
	un_chamber_section_header = {
		blockoverride "left_text" {
			text = "je_un_chamber_votes_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_votes')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_votes'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_votes')]"
		}
	}

	un_chamber_panel = {
		visible = "[GetVariableSystem.Exists('un_chamber_votes')]"

		# Redesign phase 3: why the members voted as they did.
		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_reasons_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_active_voters_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}

	# ---- Table a Resolution ----
	# Collapsed by default like every other section: six ExecuteTooltip rows
	# and an eleven-line list re-render every frame the panel is open.
	#
	# The seven rows are the topics a member can put before the Assembly on its
	# own initiative, in the order the chamber thinks about them — censure and
	# enforcement first, then requests for help, then the charter itself. Each
	# row's op code:
	#
	#   0 condemnation   1 sanctions   2 expulsion
	#   3 military mandate            4 peacekeepers   5 humanitarian aid
	#   6 charter reform (redesign phase 2)
	#
	# The table is repeated in common/scripted_guis/un_chamber_sguis.txt and in
	# the row renderers in
	# common/scripted_effects/un_chamber_display_effects.txt; keep all three in
	# step. Nothing here re-derives an eligibility rule: the Propose button asks
	# un_chamber_propose_sgui, which asks the very triggers the journal entry's
	# own scripted buttons ask.
	un_chamber_section_header = {
		blockoverride "left_text" {
			text = "je_un_chamber_propose_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_propose')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_propose'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_propose')]"
		}
	}

	un_chamber_panel = {
		visible = "[GetVariableSystem.Exists('un_chamber_propose')]"

		un_chamber_row_text = {
			text = "[GetScriptedGui('un_chamber_propose_intro_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}

		un_chamber_propose_row = {
			blockoverride "row_text" {
				text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End)]"
			}
			blockoverride "row_action" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
			}
		}

		un_chamber_propose_row = {
			blockoverride "row_text" {
				text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End)]"
			}
			blockoverride "row_action" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
			}
		}

		un_chamber_propose_row = {
			blockoverride "row_text" {
				text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End)]"
			}
			blockoverride "row_action" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
				tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
			}
		}

		un_chamber_propose_row = {
			blockoverride "row_text" {
				text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End)]"
			}
			blockoverride "row_action" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
				tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ) ) )]"
			}
		}

		un_chamber_propose_row = {
			blockoverride "row_text" {
				text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End)]"
			}
			blockoverride "row_action" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
				tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ) ) )]"
			}
		}

		un_chamber_propose_row = {
			blockoverride "row_text" {
				text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End)]"
			}
			blockoverride "row_action" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
				tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ) ) )]"
			}
		}

		un_chamber_propose_row = {
			blockoverride "row_text" {
				text = "[GetScriptedGui('un_chamber_propose_row_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End)]"
			}
			blockoverride "row_action" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
				tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End ) ) )]"
			}
		}

		# The ten topics with no proposal control of their own — they reach
		# the floor through the proposer events in events/un_events.txt. Listed
		# so a player knows the Assembly can take them up at all.
		un_chamber_row_text = {
			text = "[GetScriptedGui('un_chamber_assembly_business_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}

	# ---- Authorized military mandates ----
	# Collapsed by default like every other section here: ExecuteTooltip
	# re-renders each frame the panel is visible, and the register only has
	# anything to say once the Assembly has issued an authorization.
	un_chamber_section_header = {
		blockoverride "left_text" {
			text = "je_un_chamber_mandates_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_mandates')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_mandates'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_mandates')]"
		}
	}

	un_chamber_panel = {
		visible = "[GetVariableSystem.Exists('un_chamber_mandates')]"

		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_mandates_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}

	# ---- Archive of closed resolutions ----
	un_chamber_section_header = {
		blockoverride "left_text" {
			text = "je_un_chamber_history_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_history')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_history'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_history')]"
		}
	}

	# Voting-detail depth for the archive. Only offered while the archive is
	# open, and rebuilt from the containers every frame, so nothing about it
	# survives a save/load beyond the toggle itself.
	un_chamber_section_header = {
		visible = "[GetVariableSystem.Exists('un_chamber_history')]"

		blockoverride "left_text" {
			text = "je_un_chamber_details_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('un_chamber_history_details')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_history_details'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('un_chamber_history_details')]"
		}
	}

	un_chamber_panel = {
		visible = "[GetVariableSystem.Exists('un_chamber_history')]"

		un_chamber_text = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_history_details'))]"
			text = "[GetScriptedGui('un_chamber_history_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		un_chamber_text = {
			visible = "[GetVariableSystem.Exists('un_chamber_history_details')]"
			text = "[GetScriptedGui('un_chamber_history_details_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}
}
