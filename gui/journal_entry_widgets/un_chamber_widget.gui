							text = "[SelectLocalization( GetScriptedGui('un_act_end_peacekeeping_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), 'je_un_prog_ours_yes', 'je_un_prog_ours_no' )]"
						}
						un_act_slot = {
							blockoverride "slot_size" {
								size = { 106 28 }
							}
							un_act_control = {
								blockoverride "act_context" {
									datacontext = "[GetScriptedGui('un_act_peacekeeping_mission_sgui')]"
								}
								blockoverride "act_size" {
									size = { 106 28 }
								}
								blockoverride "act_label_width" {
									max_width = 100
								}
								blockoverride "act_label" {
									text = "je_un_act_prog_join_label"
								}
							}
							un_act_control = {
								blockoverride "act_context" {
									datacontext = "[GetScriptedGui('un_act_end_peacekeeping_sgui')]"
								}
								blockoverride "act_size" {
									size = { 106 28 }
								}
								blockoverride "act_label_width" {
									max_width = 100
								}
								blockoverride "act_label" {
									text = "je_un_act_prog_leave_label"
								}
							}
						}
