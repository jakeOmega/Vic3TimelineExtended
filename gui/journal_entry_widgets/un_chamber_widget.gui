### United Nations JE widget — the General Assembly chamber.
### Shows the resolution currently before the Assembly, the recorded ballot,
### and the bounded history of closed resolutions.
###
### Everything this widget renders is built in script and handed over as
### tooltip text by common/scripted_guis/un_chamber_sguis.txt (vanilla's
### "Using SGUIs to build lists in loc" pattern — see
### game/common/scripted_guis/scripted_guis.md). The resolution containers
### store *countries* (un_res_proposer / un_res_target / un_res_vetoer and the
### un_res_yes / un_res_no voter lists), and the GUI chain
### `Var('x').GetCountry.GetName` is recorded as not working in this mod
### (docs/guides/gui_modding_guide.md gotcha #11) — which is why the
### covert-operations widget stores a state instead of a country. Iterating the
### country lists in script and printing `[THIS.GetCountry.GetName]` is the
### shape vanilla ships for exactly this case
### (je_hispanoamerica_not_recognized_countries_sgui, ip4_spain_l_english.yml).
###
### The widget is no longer display-only. Two of its scripted GUIs act:
###   un_chamber_vote_sgui     casts our ballot on the resolution in session
###                            (op 0 favour / 1 against / 2 veto)
###   un_chamber_propose_sgui  tables one of thirty topics
###                            (op 0 condemn / 1 sanctions / 2 expulsion /
###                             3 mandate / 4 peacekeepers / 5 aid /
###                             6 charter reform / 7-19 and 29 the fourteen conventions)
### Both run the same script the existing paths run — un_vote.1's option bodies,
### the journal entry's own proposal buttons, and (ops 7-19 and 29) the docket's
### proposer events — so the AI, which still votes by event and proposes by
### button or on the docket's offer, behaves exactly as before. Every other
### scripted GUI here is still called only through ExecuteTooltip, which
### renders an effect without executing it.
###
### A type library, one type per section (te_un_sec_*).
### gui/journal_entry_widgets/un_layout_widget.gui sets their order, with the
### authority widget's sections, for the journal entry and the Diplomacy
### panel's UN tab alike: the General Assembly (te_un_sec_assembly, built there
### from te_un_sec_assembly_core, _delegations, _ballot and _propose), then the
### status sections, then the record and the explanations.
###
### The expand/collapse state lives in GetVariableSystem (client-side UI state,
### never saved and never gameplay state), keyed per section rather than per
### row: a script container exposes no stable string id to the GUI
### (ScriptContainer has no GetIDString, and GetVariableValue returns a
### CFixedPoint that cannot be fed to Concatenate), so a per-row toggle key
### cannot be built. One toggle switches the whole history between the brief
### and the detailed rendering instead.
###
### Inside a section, each group of lines sits under its own heading
### (un_chamber_subheader), one scripted GUI per group, so a section reads as
### its parts rather than one block of text. A section nested in another —
### the history's "Voting Details" — is an un_chamber_subsection_header inside
### the parent's panel, set in from its edge.

types un_chamber_widget_types
{
	type un_chamber_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_large
	}

	type un_chamber_panel = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 8 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	type un_chamber_section_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 520 38 }
		}
	}

	### A heading inside a section's panel, over one group of its lines, with a
	### faint rule under it. The sections grew a group per redesign phase, and
	### read as one undivided wall without these. Headings are GUI rows, not
	### script-built lines: in one ExecuteTooltip every root-level line prints
	### before any nested scope's (gui_modding_guide.md gotcha #18), so a
	### "heading, list, heading, list" builder prints both headings first. A
	### heading over a group that can be empty carries the group's `visible`.
	type un_chamber_subheader = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		block "subheader_margin" {
			margin_top = 10
		}

		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 480 -1 }
			align = left|nobaseline
			using = fontsize_large
			default_format = "#title"
			block "subheader_text" {}
		}
		divider_clean = {
			blockoverride "size" {
				size = { 480 2 }
			}
		}
	}

	### Explanatory text under a heading: how a group works, rather than what it
	### says now. Static keys only — the datacontext here is the journal entry,
	### so a key that reads THIS or a script value stays in its scripted GUI.
	type un_chamber_note = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_medium
		default_format = "#lore"
	}

	### An expandable section nested inside another section's panel. Narrower,
	### lower and in a smaller type than un_chamber_section_header, and set in
	### from the panel's edge by the flowcontainer that holds it, so it reads as
	### part of the section it sits in. "Voting Details" used to be a full-width
	### header between "Resolutions on the Record" and its panel, and looked
	### like the next section.
	type un_chamber_subsection_header = section_header_button {
		blockoverride "layout" {
			size = { 440 30 }
		}
		blockoverride "fontsize" {
			using = fontsize_medium
		}
		blockoverride "arrow_size" {
			size = { 20 20 }
		}
		blockoverride "left_textbox_margin_left" {
			margin_left = 32
		}
	}

	### A table row: a label on the left and its value on the right. The
	### Programmes and Conventions tallies and the record's terms.
	type un_chamber_value_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		margin = { 4 1 }

		textbox = {
			autoresize = yes
			minimumsize = { 360 -1 }
			maximumsize = { 360 -1 }
			align = left|nobaseline
			using = fontsize_medium
			elide = right
			block "row_label" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 100 -1 }
			maximumsize = { 100 -1 }
			align = right|nobaseline
			using = fontsize_medium
			default_format = "#v"
			block "row_value" {}
		}
	}

	### Smaller body text for the proposal rows, which carry four or five short
	### lines each and have to leave room for a button beside them.
	type un_chamber_row_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 460 -1 }
		maximumsize = { 460 -1 }
		align = left|nobaseline
		using = fontsize_medium
	}

	### A chamber action button. `action_binding` carries the four properties
	### that address the scripted GUI — visible / enabled / onclick / tooltip —
	### because they are the only part that differs between one control and the
	### next; the label and the sizing are shared.
	type un_chamber_action_button = button {
		using = default_button_action
		size = { 236 30 }
		parentanchor = vcenter

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 226
			elide = right
			using = fontsize_small
			block "action_label" {}
		}

		block "action_binding" {}
	}

	### One row of the proposal list: the topic's description, built in script
	### by un_chamber_propose_row_sgui, on the left, and the Propose control
	### beside it on the right (owner, 2026-09-28; it used to sit below). Every
	### row shares one scripted GUI (un_chamber_propose_sgui) and differs only by
	### its op code, so the datacontext lives here rather than on each instance.
	type un_chamber_propose_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 10
		margin = { 4 4 }
		datacontext = "[GetScriptedGui('un_chamber_propose_sgui')]"

		textbox = {
			autoresize = yes
			multiline = yes
			minimumsize = { 320 -1 }
			maximumsize = { 320 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = fontsize_medium
			block "row_text" {}
		}

		button = {
			using = default_button_action
			size = { 130 28 }
			parentanchor = vcenter

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 120
				elide = right
				using = fontsize_small
				text = "je_un_chamber_propose_button_label"
			}

			block "row_action" {}
		}
	}

	### One row of Missions in the Field: the mission in one display slot, built
	### in script by un_chamber_mission_slot_sgui, and our control under it —
	### Join while we do not serve in the mission, Withdraw while we do. Every
	### binding names its scripted GUI outright (no datacontext), because each
	### row asks three of them; the rows differ only by the slot code they pass
	### as `op` (the slot table: common/scripted_guis/un_chamber_sguis.txt).
	type un_chamber_mission_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2
		margin = { 4 4 }

		un_chamber_row_text = {
			block "row_text" {}
		}

		button = {
			using = default_button_action
			size = { 200 28 }
			parentanchor = hcenter

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 190
				elide = right
				using = fontsize_small
				text = "je_un_chamber_mission_join_label"
			}

			block "join_action" {}
		}

		button = {
			using = default_button_action
			size = { 200 28 }
			parentanchor = hcenter

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 190
				elide = right
				using = fontsize_small
				text = "je_un_chamber_mission_withdraw_label"
			}

			block "withdraw_action" {}
		}
	}

	### One row of Delegations: an AI member's position on the resolution in
	### session, built in script by un_chamber_deleg_row_sgui, and our controls
	### under it — Lobby For and Lobby Against while we run no campaign on it,
	### Stop Lobbying while we do, and Seek Pledge For / Against. Like the
	### mission rows, every binding names its scripted GUI outright, and the
	### rows differ only by the slot they pass as `op`
	### (common/scripted_guis/un_chamber_sguis.txt, § DELEGATIONS).
	type un_chamber_deleg_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2
		margin = { 4 4 }

		un_chamber_row_text = {
			block "row_text" {}
		}

		flowcontainer = {
			direction = horizontal
			spacing = 4
			ignoreinvisible = yes

			block "row_buttons" {}
		}
	}

	### A Delegations row's button: four fit across a row.
	type un_chamber_deleg_button = button {
		using = default_button_action
		size = { 112 28 }
		parentanchor = vcenter

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 106
			elide = right
			using = fontsize_small
			block "action_label" {}
		}

		block "action_binding" {}
	}

	### One of the Delegations' two bulk buttons, Lobby Top Members For and
	### Against: wider than a row button, two across the 480 column
	### (236 + 4 + 236 = 476).
	type un_chamber_deleg_bulk_button = button {
		using = default_button_action
		size = { 236 28 }
		parentanchor = vcenter

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 228
			elide = right
			using = fontsize_small
			block "action_label" {}
		}

		block "action_binding" {}
	}

	### ======================================================================
	### SECTIONS. Each is composed, in order, by un_layout_widget.gui.
	### ======================================================================
	type te_un_sec_assembly_core = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- The resolution in session, and our ballot ----
		# The General Assembly section's core (te_un_sec_assembly). Our standing
		# and the Security Council used to open this panel; they are the
		# overview's membership, standing and council tooltips now.
		un_chamber_subheader = {
			blockoverride "subheader_margin" {}
			blockoverride "subheader_text" {
				text = "je_un_chamber_sub_session"
			}
		}
		un_chamber_text = {
			text = "[GetScriptedGui('un_chamber_active_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}

		# Redesign phase 3: how the Assembly reads our own position on the
		# resolution in session — the lean the AI votes by, term by term.
		un_chamber_text = {
			visible = "[GetScriptedGui('un_chamber_position_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			text = "[GetScriptedGui('un_chamber_position_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}

		# ---- Our ballot ----
		# Available from the day the resolution opens; the un_vote.1 popup that
		# arrives on day 30 is the same three options and is skipped entirely
		# once a ballot is on the record (its trigger is re-evaluated when it
		# fires). One scripted GUI, one op code per control:
		#
		#   op 0  Vote in Favour    op 1  Vote Against    op 2  Veto
		#
		# The table is repeated in common/scripted_guis/un_chamber_sguis.txt;
		# keep the two in step. Each tooltip is IsValidTooltip (why the control
		# is greyed out) concatenated with ExecuteTooltip (what the vote does),
		# which is the un_vote.1 option's own consequence text, lobbying
		# keep/break line included.
		flowcontainer = {
			direction = vertical
			spacing = 4
			ignoreinvisible = yes
			parentanchor = hcenter
			datacontext = "[GetScriptedGui('un_chamber_vote_sgui')]"

			flowcontainer = {
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_vote_yes_label"
					}
					blockoverride "action_binding" {
						visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
					}
				}

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_vote_no_label"
					}
					blockoverride "action_binding" {
						visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
					}
				}
			}

			# The veto is armed before it is cast. A scripted GUI's documented
			# confirm_title / confirm_text fields have no usage anywhere in
			# vanilla to copy, and this cannot be tested without running the
			# game, so the confirmation is built out of the expander mechanism
			# this widget already relies on: GetVariableSystem state, which is
			# client-side, never saved and never gameplay state.
			flowcontainer = {
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_vote_veto_label"
					}
					blockoverride "action_binding" {
						visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Not(GetVariableSystem.Exists('un_chamber_veto_armed')) )]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
					}
				}

				un_chamber_action_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_vote_veto_confirm_label"
					}
					blockoverride "action_binding" {
						visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), GetVariableSystem.Exists('un_chamber_veto_armed') )]"
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
					}
				}

				button = {
					using = default_button_action
					size = { 152 30 }
					parentanchor = vcenter
					visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), GetVariableSystem.Exists('un_chamber_veto_armed') )]"
					onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
					tooltip = "je_un_chamber_vote_veto_cancel_tt"

					textbox = {
						parentanchor = center
						align = center|nobaseline
						autoresize = yes
						max_width = 142
						elide = right
						using = fontsize_small
						text = "je_un_chamber_vote_veto_cancel_label"
					}
				}
			}
		}
	}

	type te_un_sec_delegations = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Delegations (UN vote lobbying, §6) ----
		# How each AI member stands on the resolution in session, as a band: the
		# members someone is working on first, then the undecided, then those
		# leaning for, then those leaning against; the firmly decided are counted
		# on the summary line (its tooltip names them). Up to 24 rows, one
		# ExecuteTooltip each, passing the slot as `op` (gotcha #27). A subsection
		# of the General Assembly, shown while a resolution is in session, and
		# collapsed by default: 24 rows of five controls re-render every frame
		# the panel is open.
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin_left = 20
			margin_bottom = 6

			un_chamber_subsection_header = {
				blockoverride "left_text" {
					text = "je_un_chamber_deleg_header"
				}
				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('un_chamber_delegations_open')]"
				}
				blockoverride "onclick_showmore" {
					visible = "[Not(GetVariableSystem.Exists('un_chamber_delegations_open'))]"
				}
				blockoverride "onclick_showless" {
					visible = "[GetVariableSystem.Exists('un_chamber_delegations_open')]"
				}
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			visible = "[GetVariableSystem.Exists('un_chamber_delegations_open')]"

			un_chamber_text = {
				text = "[GetScriptedGui('un_chamber_deleg_summary_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				tooltip = "[GetScriptedGui('un_chamber_deleg_firm_list_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			### Lobby the top of the list in one press, either way: a campaign on
			### each member that qualifies, from the top row down, until our
			### influence runs out (common/scripted_guis/un_chamber_sguis.txt,
			### § the bulk buttons). No op: each reads all 24 rows itself.
			flowcontainer = {
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes
				parentanchor = hcenter
				margin_bottom = 2

				un_chamber_deleg_bulk_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_deleg_bulk_for_label"
					}
					blockoverride "action_binding" {
						enabled = "[GetScriptedGui('un_chamber_deleg_bulk_for_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('un_chamber_deleg_bulk_for_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('un_chamber_deleg_bulk_for_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('un_chamber_deleg_bulk_for_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
					}
				}
				un_chamber_deleg_bulk_button = {
					blockoverride "action_label" {
						text = "je_un_chamber_deleg_bulk_against_label"
					}
					blockoverride "action_binding" {
						enabled = "[GetScriptedGui('un_chamber_deleg_bulk_against_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('un_chamber_deleg_bulk_against_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('un_chamber_deleg_bulk_against_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('un_chamber_deleg_bulk_against_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
					}
				}
			}

			un_chamber_deleg_row = {
