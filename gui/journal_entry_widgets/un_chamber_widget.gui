	### How international standing works: the text only, for "How the UN Works"
	### (te_un_sec_how, un_layout_widget.gui), which carries the heading. The
	### score, its tier and this year's accrual are the overview's standing
	### meter and its tooltip (un_chamber_standing_sgui).
	type te_un_help_standing = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		un_chamber_note = {
			text = "je_un_standing_help_intro"
		}
		un_chamber_note = {
			text = "je_un_standing_help_sources"
		}
		un_chamber_note = {
			text = "je_un_standing_help_losses"
		}
		un_chamber_note = {
			text = "je_un_standing_help_limits"
		}
	}

	type te_un_sec_exposure = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Our record (redesign phase 3) ----
		# Our own dossier as a table: the case the Assembly could make against
		# us and its terms, then which punitive resolutions it would support
		# today (owner, 2026-09-28; it was a paragraph under "Our Exposure").
		# Open by default, like every section that changes. How the record
		# grows and fades is in "How the UN Works".
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_chamber_exposure_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_exposure_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_exposure_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_exposure_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_exposure_closed'))]"

			# No UN: one line, and nothing else.
			un_chamber_text = {
				visible = "[Not( GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				text = "je_un_chamber_exposure_no_un"
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				visible = "[GetScriptedGui('un_chamber_founded_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_case"
					}
					blockoverride "row_value" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_strength')|1] / 100"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_infamy"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_infamy_term')|1]"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_aggression"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dos_aggression')|1]"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_defiance"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dos_defiance')|1]"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_violation"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dos_violation')|1]"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_covert"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dos_covert')|1]"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_nuclear"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dos_nuclear')|1]"
					}
				}
				un_chamber_value_row = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_standing_term'), '(CFixedPoint)0' )]"
					tooltip = "je_un_record_standing_tt"
					blockoverride "row_label" {
						text = "je_un_record_standing"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_standing_term')|1]"
					}
				}

				un_chamber_subheader = {
					blockoverride "subheader_text" {
						text = "je_un_record_supports_header"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_supports_condemn"
					}
					blockoverride "row_value" {
						text = "[SelectLocalization( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_strength'), JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_threshold_condemn') ), 'je_un_record_yes', 'je_un_record_no' )]"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_supports_sanctions"
					}
					blockoverride "row_value" {
						text = "[SelectLocalization( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_strength'), JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_threshold_sanctions') ), 'je_un_record_yes', 'je_un_record_no' )]"
					}
				}
				un_chamber_value_row = {
					blockoverride "row_label" {
						text = "je_un_record_supports_mandate"
					}
					blockoverride "row_value" {
						text = "[SelectLocalization( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_strength'), JournalEntry.GetCountry.MakeScope.ScriptValue('un_case_threshold_mandate') ), 'je_un_record_yes', 'je_un_record_no' )]"
					}
				}
			}
		}
	}

	type te_un_sec_missions = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Missions in the field (redesign phase 6) ----
		# The mission register: where the UN is, for whom, how far along, and
		# who serves in each mission. Open by default; the ended missions are a
		# collapsed subsection, and how missions work is in "How the UN Works"
		# (te_un_sec_how, un_layout_widget.gui).
		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_chamber_missions_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_missions_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_missions_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_missions_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_missions_closed'))]"

			# Missions still at work, then the ones that have ended, then how a
			# mission works. Each list prints its own empty line.
			un_chamber_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_missions_active"
				}
			}
			# One row per display slot, 0-7 (the slot table:
			# common/scripted_guis/un_chamber_sguis.txt). Each row is its own
			# ExecuteTooltip, so a country serving in two missions is named under
			# each (gui_modding_guide.md gotcha #27).
			un_chamber_mission_row = {
				visible = "[GetScriptedGui('un_chamber_mission_slot_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				blockoverride "row_text" {
					text = "[GetScriptedGui('un_chamber_mission_slot_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				}
				blockoverride "join_action" {
					visible = "[Not( GetScriptedGui('un_chamber_mission_withdraw_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) )]"
					enabled = "[GetScriptedGui('un_chamber_mission_join_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					onclick = "[GetScriptedGui('un_chamber_mission_join_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					tooltip = "[Concatenate( GetScriptedGui('un_chamber_mission_join_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('un_chamber_mission_join_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
				}
				blockoverride "withdraw_action" {
					visible = "[GetScriptedGui('un_chamber_mission_withdraw_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					onclick = "[GetScriptedGui('un_chamber_mission_withdraw_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					tooltip = "[GetScriptedGui('un_chamber_mission_withdraw_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				}
			}
			un_chamber_mission_row = {
				visible = "[GetScriptedGui('un_chamber_mission_slot_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
