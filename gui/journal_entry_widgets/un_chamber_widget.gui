				}
			}
			un_chamber_programme_row = {
				blockoverride "row_label" {
					text = "je_un_prog_hr_champions"
				}
				blockoverride "row_value" {
					text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_human_rights_champion_count')|0]"
				}
				blockoverride "row_ours" {
					flowcontainer = {
						direction = horizontal
						spacing = 4
						ignoreinvisible = yes
						parentanchor = vcenter

						textbox = {
							minimumsize = { 34 -1 }
							max_width = 34
							autoresize = yes
							parentanchor = vcenter
							align = left|nobaseline
							using = un_fontsize_row
							text = "[SelectLocalization( GetScriptedGui('un_act_withdraw_human_rights_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), 'je_un_prog_ours_yes', 'je_un_prog_ours_no' )]"
						}
						un_act_slot = {
							blockoverride "slot_size" {
								size = { 106 28 }
							}
							un_act_control = {
								blockoverride "act_context" {
									datacontext = "[GetScriptedGui('un_act_human_rights_resolution_sgui')]"
								}
								blockoverride "act_size" {
									size = { 106 28 }
								}
								blockoverride "act_label_width" {
									max_width = 100
								}
								blockoverride "act_label" {
									text = "je_un_act_prog_join_label"
