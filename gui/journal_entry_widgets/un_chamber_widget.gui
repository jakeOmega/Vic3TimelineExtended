			un_chamber_text = {
				text = "[GetScriptedGui('un_chamber_dev_fund_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
		}
	}

	type te_un_sec_ballot = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Recorded ballot of the resolution in session ----
		# A subsection of the General Assembly, shown while a resolution is in
		# session. Collapsed by default.
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin_left = 20
			margin_bottom = 6

			un_chamber_subsection_header = {
				blockoverride "left_text" {
					text = "je_un_chamber_votes_header"
				}
				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('un_chamber_votes_open')]"
				}
				blockoverride "onclick_showmore" {
					visible = "[Not(GetVariableSystem.Exists('un_chamber_votes_open'))]"
				}
				blockoverride "onclick_showless" {
					visible = "[GetVariableSystem.Exists('un_chamber_votes_open')]"
				}
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			visible = "[GetVariableSystem.Exists('un_chamber_votes_open')]"

			# Redesign phase 3: why the members voted as they did. Both headings
			# wait for a resolution to be in session; without one, the ballot
			# builder prints the one line saying so.
			un_chamber_subheader = {
				visible = "[GetScriptedGui('un_chamber_in_session_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_un_chamber_sub_reasons"
				}
			}
			un_chamber_text = {
