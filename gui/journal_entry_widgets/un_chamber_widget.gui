			un_chamber_value_row = {
				blockoverride "row_label" {
					text = "je_un_dev_fund_avg_label"
				}
				blockoverride "row_value" {
					text = "je_un_dev_fund_avg_value"
				}
			}
			un_chamber_value_row = {
				tooltip = "je_un_dev_fund_eligible_tt"
				blockoverride "row_label" {
					text = "je_un_dev_fund_eligible_label"
				}
				blockoverride "row_value" {
					text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_dev_fund_recipients')|0]"
				}
			}
			un_chamber_value_row = {
				blockoverride "row_label" {
