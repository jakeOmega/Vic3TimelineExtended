	### Our Monuments (open): one row per monument. The entry can outlive its
	### last monument while a ledger fades; the panel then says so.
	type te_gm_sec_monuments = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_monuments_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_monuments_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_monuments_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_monuments_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_monuments_closed'))]"

			gm_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_display_count'), '(CFixedPoint)0' )]"
				text = "gm_je_monuments_none"
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gm_states')]"

				item = {
					gm_monument_row = { datacontext = "[Scope.GetState]" }
				}
			}
		}
	}

	### "How Grand Monuments Work": every explanation, collapsed by default,
	### one heading per topic. The live sections above say what is happening;
	### this says how it works.
	type te_gm_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('gm_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('gm_how_open')]"
			}
		}

		gm_panel = {
			visible = "[GetVariableSystem.Exists('gm_how_open')]"

			gm_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_grandeur"
				}
			}
			gm_note = {
				text = "gm_je_how_grandeur"
			}
			gm_note = {
				text = "gm_je_how_grandeur_national"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_counts"
				}
			}
			gm_note = {
				text = "gm_je_how_counts"
			}
			gm_note = {
				text = "gm_je_how_counts_other"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_contested"
				}
			}
			gm_note = {
				text = "gm_je_how_contested"
			}
			gm_note = {
				text = "gm_je_how_choices"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_hard_times"
				}
			}
			gm_note = {
				text = "gm_je_how_hard_times"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_commissions"
				}
			}
			gm_note = {
				text = "gm_je_how_commissions"
			}
			gm_note = {
				text = "gm_je_how_commissions_rewards"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_names"
				}
			}
			gm_note = {
				text = "gm_je_how_names"
			}
		}
	}

	### ======================================================================
	### COMPOSERS. The one order of the sections.
	### ======================================================================

	### Everything a returning player checks, open by default.
	type te_gm_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_gm_sec_commission = {}
		te_gm_sec_national = {}
		te_gm_sec_monuments = {}
	}

	### How it all works, collapsed.
	type te_gm_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_gm_sec_how = {}
	}
}

### ==========================================================================
### JOURNAL ENTRY ROOTS (je_grand_monuments.txt). Bare wrappers that repeat the
### composers' IsActive gate, so an inactive entry's containers collapse.
### ==========================================================================
flowcontainer = {
	name = "widget_je_gm_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_gm_overview_panel = {}
}

flowcontainer = {
	name = "widget_je_gm_status"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_gm_status_sections = {}
}

flowcontainer = {
	name = "widget_je_gm_reference"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_gm_reference_sections = {}
}
