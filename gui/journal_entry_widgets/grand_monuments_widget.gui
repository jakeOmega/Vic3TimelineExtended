	### A monument's status over its picture: a badge at the picture's
	### top-left corner, the status word beneath the picture. The instance sets
	### the texture, the `visible` (one status code each) and a tooltip that
	### reads nothing (gotcha #24); the state card widens it to its picture.
	type gm_row_status = widget {
		block "status_size" {
			size = { 96 116 }
		}

		icon = {
			size = { 28 28 }
			parentanchor = top|left
			position = { 2 2 }
			block "status_texture" {}
		}
		textbox = {
			parentanchor = bottom|hcenter
			autoresize = yes
			max_width = 94
			elide = right
			align = hcenter|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			text = "gm_row_status"
		}
	}

	### A line of a monument's row, beside its status (96 + 8 + 376 = 480).
	type gm_row_line = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 376 -1 }
		maximumsize = { 376 -1 }
		align = left|nobaseline
		using = fontsize_medium
	}

	### One of a contested row's three choices. choice_context points it at its
	### scripted GUI; the row's state travels as the saved scope gm_state.
	type gm_choice_button = button {
		using = default_button_action
		size = { 150 24 }
		margin_top = 2

		block "choice_context" {}

		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End )]"

		block "choice_tooltip" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 140
			elide = right
			using = fontsize_small
			block "choice_text" {}
		}
	}

	### Dedicate (owner, 2026-10-18): opens the ceremony of a monument of ours
	### waiting undedicated (gm_dedicate_sgui), under its row in Awaiting
	### Dedication and on the state view's card. Rooted at the player, as Carry
	### It Off (gui/gm_trophy_widgets.gui), so it reads the same in a datamodel
	### row and on the card (gotcha #24). Shown from the state's own value and
	### owner, not from is_shown: whether a saved scope reaches is_shown is
	### thinly evidenced (gotcha #22), and this is the only way to dedicate.
	type gm_dedicate_button = button {
		using = default_button_action
		size = { 200 26 }
		parentanchor = hcenter
		margin_top = 4
		datacontext = "[GetScriptedGui('gm_dedicate_sgui')]"
		visible = "[And( ObjectsEqual( State.GetOwner, GetPlayer.Self ), EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_awaiting'), '(CFixedPoint)1' ) )]"
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End )]"
		tooltip = "gm_button_dedicate_tooltip"

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 190
			elide = right
			using = fontsize_small
			text = "gm_button_dedicate"
		}
	}

	### A button of the naming line, its label set by naming_text.
	type gm_naming_button = button {
		using = default_button_action
		size = { 150 24 }
		margin_top = 2

		block "naming_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 140
			elide = right
			using = fontsize_small
			block "naming_text" {}
		}
	}

	### Typed names (v2 §3.5, tested in game 2026-10-05): a monument named in
	### the base game's company-rename popup, on the placeholder company
	### company_gm_name_carrier (gm_sguis.txt). Shown only while this
	### monument is being named (gm_is_being_named, set by Name It). As it
	### appears, its _show state stores the company's starting name
	### (gm_name_mark_old_sgui) and opens the popup: the popup can't open in
	### Name It's own click, before the company exists. The watcher, a 1x1
	### widget whose state fires when the company's name differs from the
	### starting one, names the monument without a second click; Rename, Use
	### This Name and Cancel do the same by hand. Every read of
	### Var('gm_name_carrier') sits here, where Name It has set it.
	type gm_naming_line = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4
		parentanchor = hcenter
		visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_is_being_named'), '(CFixedPoint)1' )]"

		state = {
			name = _show
			on_start = "[GetScriptedGui('gm_name_mark_old_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'gm_old_name', MakeScopeFlag( JournalEntry.GetCountry.MakeScope.Var('gm_name_carrier').GetCompany.GetNameNoFormatting ) ).End )]"
			on_start = "[PopupManager.ShowCompanyChangeName( JournalEntry.GetCountry.MakeScope.Var('gm_name_carrier').GetCompany.Self )]"
		}

		widget = {
			size = { 1 1 }
			state = {
				trigger_when = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_has_name_old'), '(CFixedPoint)1' ), Not( EqualTo_string( JournalEntry.GetCountry.MakeScope.Var('gm_name_carrier').GetCompany.GetNameNoFormatting, JournalEntry.GetCountry.MakeScope.Var('gm_name_old').GetFlagName ) ) )]"
				on_finish = "[GetScriptedGui('gm_name_use_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'gm_state', State.MakeScope ).AddScope( 'gm_name', MakeScopeFlag( JournalEntry.GetCountry.MakeScope.Var('gm_name_carrier').GetCompany.GetNameNoFormatting ) ).End )]"
			}
		}

		textbox = {
			autoresize = yes
			max_width = 470
			elide = right
			parentanchor = hcenter
			align = hcenter|nobaseline
			using = fontsize_medium
			text = "gm_name_pending"
		}

		flowcontainer = {
			direction = horizontal
			spacing = 4
			parentanchor = hcenter

			gm_naming_button = {
				blockoverride "naming_button" {
					tooltip = "gm_button_name_popup_tooltip"
					onclick = "[PopupManager.ShowCompanyChangeName( JournalEntry.GetCountry.MakeScope.Var('gm_name_carrier').GetCompany.Self )]"
				}
				blockoverride "naming_text" { text = "gm_button_name_popup" }
			}
			gm_naming_button = {
				blockoverride "naming_button" {
					datacontext = "[GetScriptedGui('gm_name_use_sgui')]"
					tooltip = "gm_button_name_use_tooltip"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'gm_state', State.MakeScope ).AddScope( 'gm_name', MakeScopeFlag( JournalEntry.GetCountry.MakeScope.Var('gm_name_carrier').GetCompany.GetNameNoFormatting ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'gm_state', State.MakeScope ).AddScope( 'gm_name', MakeScopeFlag( JournalEntry.GetCountry.MakeScope.Var('gm_name_carrier').GetCompany.GetNameNoFormatting ) ).End )]"
				}
				blockoverride "naming_text" { text = "gm_button_name_use" }
			}
			gm_naming_button = {
				blockoverride "naming_button" {
					datacontext = "[GetScriptedGui('gm_name_cancel_sgui')]"
					tooltip = "gm_button_name_cancel_tooltip"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				}
				blockoverride "naming_text" { text = "gm_button_name_cancel" }
			}
		}
	}

	### One of the four monument policies (v2 §5), in National Effects. Two to a
	### row (2 x 230 + 8 + 4 margins = 480). The current policy's button is
	### disabled: its scripted GUI is invalid for the policy already in force.
	type gm_policy_button = button {
		using = default_button_action
		size = { 230 24 }
		margin_top = 2

		block "policy_context" {}

		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		block "policy_tooltip" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 220
			elide = right
			using = fontsize_small
			block "policy_text" {}
		}
	}

	### A construction site (sites spec 2026-10-18 §3.1): the work, where it
	### stands, the levels built and the grandeur they come to, and whether
	### levels are still being built (Dedicate waits for them). Its Dedicate
	### button follows it under Awaiting Dedication (96 + 8 + 376 = 480).
	type gm_site_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 8

		icon = {
			size = { 96 96 }
			texture = "gfx/interface/icons/gm_icons/status_undedicated.dds"
		}
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 2
			textbox = {
				autoresize = yes
				multiline = yes
				minimumsize = { 376 -1 }
				maximumsize = { 376 -1 }
				align = left|nobaseline
				using = fontsize_large
				text = "gm_site_row_title"
			}
			gm_row_line = {
				default_format = "#tooltippable"
				tooltip = "gm_site_row_detail_tt"
				text = "gm_site_row_detail"
			}
			gm_row_line = {
				text = "gm_site_row_rate"
			}
			gm_row_line = {
				visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_site_building'), '(CFixedPoint)1' )]"
				text = "gm_site_row_building"
			}
			gm_row_line = {
				visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_site_building'), '(CFixedPoint)0' )]"
				text = "gm_site_row_ready"
			}
		}
	}

	### One monument: its status as an icon with the word beneath; its form
	### and dedication; where it stands and its grandeur; while contested, who
	### wants it kept and who resents it, and the three choices centred under
	### the row; last, the revived-language inscription (empty when none).
	type gm_monument_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 8

			widget = {
				size = { 96 116 }

				gm_picture = {
					size = { 96 96 }
					parentanchor = top|hcenter
				}
				gm_row_status = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)1' )]"
					tooltip = "gm_je_status_undedicated_tt"
					blockoverride "status_texture" {
						texture = "gfx/interface/icons/gm_icons/status_undedicated.dds"
					}
				}
				gm_row_status = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)2' )]"
					tooltip = "gm_je_status_upheld_tt"
					blockoverride "status_texture" {
						texture = "gfx/interface/icons/gm_icons/status_upheld.dds"
					}
				}
				gm_row_status = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)3' )]"
					tooltip = "gm_je_status_heritage_tt"
					blockoverride "status_texture" {
						texture = "gfx/interface/icons/gm_icons/status_heritage.dds"
					}
				}
				gm_row_status = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)4' )]"
					tooltip = "gm_je_status_contested_tt"
					blockoverride "status_texture" {
						texture = "gfx/interface/icons/gm_icons/status_contested.dds"
					}
				}
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				textbox = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_has_typed_name'), '(CFixedPoint)0' )]"
					autoresize = yes
					multiline = yes
					minimumsize = { 376 -1 }
					maximumsize = { 376 -1 }
					align = left|nobaseline
					using = fontsize_large
					text = "gm_row_title"
				}
				# A typed name (v2 §3.5) prints straight from the state's
				# gm_name, the form that ran in game, and only once it exists.
				textbox = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_has_typed_name'), '(CFixedPoint)1' )]"
					autoresize = yes
					multiline = yes
					minimumsize = { 376 -1 }
					maximumsize = { 376 -1 }
					align = left|nobaseline
					using = fontsize_large
					text = "gm_row_title_named"
				}
				# A landmark standing since 1836 (phase 4): its history on hover.
				gm_row_line = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_disp_is_landmark'), '(CFixedPoint)1' )]"
					default_format = "#tooltippable"
					tooltip = "gm_row_landmark_tt"
					text = "gm_row_landmark"
				}
				gm_row_line = {
					default_format = "#tooltippable"
					tooltip = "gm_row_detail_tt"
					text = "gm_row_detail"
				}
				# Finished: its levels and its years (ageing spec 2026-10-16 §3).
				gm_row_line = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_frozen'), '(CFixedPoint)1' )]"
					default_format = "#tooltippable"
					tooltip = "gm_row_frozen_tt"
					text = "gm_row_frozen"
				}
				# It counts toward the open opportunity (usability §4).
				gm_row_line = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_com_counts'), '(CFixedPoint)1' )]"
					default_format = "#tooltippable"
					tooltip = "gm_row_com_counts_tt"
					text = "gm_row_com_counts"
				}
				gm_row_line = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)4' )]"
					default_format = "#tooltippable"
					tooltip = "gm_row_contest_tt"
					text = "gm_row_contest"
				}
				gm_row_line = {
					text = "gm_row_inscription"
				}
			}
		}

		# Rename (v2 §3.3): an upheld monument's form and namesake again, at
		# no cost; Name It types a name of our own (§3.5), Clear Name drops it.
		# A contested or heritage monument keeps its name. Hidden while this
		# monument is being named: the naming line below replaces it.
		flowcontainer = {
			direction = horizontal
			spacing = 4
			parentanchor = hcenter
			visible = "[And( EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_can_rename'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_is_being_named'), '(CFixedPoint)0' ) )]"

			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_rename_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_rename_tooltip" }
				blockoverride "choice_text" { text = "gm_button_rename" }
			}
			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_name_start_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_name_start_tooltip" }
				blockoverride "choice_text" { text = "gm_button_name_start" }
			}
			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_clear_name_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_clear_name_tooltip" }
				blockoverride "choice_text" { text = "gm_button_clear_name" }
			}
		}

		gm_naming_line = {}

		flowcontainer = {
			direction = horizontal
			spacing = 4
			parentanchor = hcenter
			visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)4' )]"

			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_tear_down_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_tear_down_tooltip" }
				blockoverride "choice_text" { text = "gm_button_tear_down" }
			}
			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_rededicate_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_rededicate_tooltip" }
				blockoverride "choice_text" { text = "gm_button_rededicate" }
			}
			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_preserve_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_preserve_tooltip" }
				blockoverride "choice_text" { text = "gm_button_preserve" }
			}
		}

		# Carry It Off (trophies spec §2.2): a monument we did not raise, in a
		# state we have not incorporated (gui/gm_trophy_widgets.gui).
		gm_tr_take_button = {}
	}

	### ======================================================================
	### SECTIONS. Composed, in order, by te_gm_status_sections and
	### te_gm_reference_sections below.
	### ======================================================================

	### The overview, always shown. One cell per status, lit while any monument
	### has it; under the cells, Hard Times only while it holds. The cells share
	### the status tooltips with the rows below.
	type te_gm_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		visible = "[JournalEntry.IsActive]"

		gm_panel = {
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				minimumsize = { 480 -1 }

				flowcontainer = {
					direction = horizontal
					spacing = 0
					ignoreinvisible = yes
					parentanchor = hcenter

					gm_ov_cell = {
						tooltip = "gm_je_status_upheld_tt"
						blockoverride "cell_texture" {
							texture = "gfx/interface/icons/gm_icons/status_upheld.dds"
						}
						blockoverride "lit" {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_upheld'), '(CFixedPoint)0' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_upheld'), '(CFixedPoint)0' ) )]"
						}
						blockoverride "label" {
							text = "gm_je_ov_upheld"
						}
					}
					gm_ov_cell = {
						tooltip = "gm_je_status_heritage_tt"
						blockoverride "cell_texture" {
							texture = "gfx/interface/icons/gm_icons/status_heritage.dds"
						}
						blockoverride "lit" {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_heritage'), '(CFixedPoint)0' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_heritage'), '(CFixedPoint)0' ) )]"
						}
						blockoverride "label" {
							text = "gm_je_ov_heritage"
						}
					}
					gm_ov_cell = {
						tooltip = "gm_je_ov_building_tt"
						blockoverride "cell_texture" {
							texture = "gfx/interface/icons/gm_icons/status_undedicated.dds"
						}
						blockoverride "lit" {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_undedicated'), '(CFixedPoint)0' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_undedicated'), '(CFixedPoint)0' ) )]"
						}
						blockoverride "label" {
							text = "gm_je_ov_undedicated"
						}
					}
					gm_ov_cell = {
						tooltip = "gm_je_status_contested_tt"
						blockoverride "cell_texture" {
							texture = "gfx/interface/icons/gm_icons/status_contested.dds"
						}
						blockoverride "lit" {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_contested'), '(CFixedPoint)0' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_contested'), '(CFixedPoint)0' ) )]"
						}
						blockoverride "label" {
							text = "[SelectLocalization( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_contested'), '(CFixedPoint)0' ), 'gm_je_ov_contested_some', 'gm_je_ov_contested_none' )]"
						}
					}
				}

				# Hard times (§5): only while a finished level would cause
				# vanity backlash, the warning icon over a red phrase, each
				# with the sentence on hover (owner, play-test round 2). Its
				# own line, not a fifth cell: a cell appearing later would
				# widen the row after its first layout and pull it off-centre.
				# Every width here is fixed: the column is 480, the icon 32,
				# the phrase 480 with its text centred.
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					minimumsize = { 480 -1 }
					margin_top = 4
					visible = "[GetScriptedGui('gm_hard_times_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					icon = {
						size = { 32 32 }
						parentanchor = hcenter
						tooltip = "gm_je_ov_hard_times_tt"
						texture = "gfx/interface/icons/gm_icons/hard_times.dds"
					}
					textbox = {
						autoresize = yes
						minimumsize = { 480 -1 }
						maximumsize = { 480 -1 }
						align = hcenter|nobaseline
						using = fontsize_large
						default_format = "#tooltippable"
						tooltip = "gm_je_ov_hard_times_tt"
						text = "gm_je_ov_hard_times"
					}
				}

				# The monument policy (v2 §5): its name, what it does on hover and
				# when it can change. The buttons are in National Effects.
				textbox = {
					autoresize = yes
					minimumsize = { 480 -1 }
					maximumsize = { 480 -1 }
					margin_top = 4
					align = hcenter|nobaseline
					using = fontsize_medium
					default_format = "#tooltippable"
					tooltip = "gm_je_ov_policy_tt"
					text = "gm_je_ov_policy"
				}
			}
		}
	}

	### Opportunity (open), shown only while one is open (opportunities spec §2):
	### the moment that brought it, who asks for what, the monument it will be,
	### a bar of the grandeur added against the target, the months left, what
	### completing it gives, and Let It Pass. Country reads only: the
	### opportunity is the country's record. Its type and flag keep v2's
	### "commission" names.
	type te_gm_sec_commission = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_com_open'), '(CFixedPoint)1' )]"

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_commission_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_commission_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_commission_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_commission_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_commission_closed'))]"
			spacing = 2

			gm_text = {
				default_format = "#tooltippable"
				tooltip = "gm_je_com_occasion_tt"
				text = "gm_je_com_occasion"
			}
			gm_text = {
				default_format = "#tooltippable"
				tooltip = "gm_je_com_ask_tt"
				text = "gm_je_com_ask"
			}
			gm_text = {
				text = "gm_je_com_named"
			}
			# Where it counts, in plain sight (usability §4).
			gm_text = {
				text = "gm_je_com_where_line"
			}
			gm_step_row = {
				tooltip = "gm_je_com_progress_tt"
				blockoverride "row_label" {
					text = "gm_je_com_lbl_progress"
				}
				blockoverride "row_frac" {
					value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_com_frac') )]"
				}
				blockoverride "row_value" {
					text = "gm_je_com_val_progress"
				}
			}
			gm_value_row = {
				tooltip = "gm_je_com_months_tt"
				blockoverride "row_label" {
					text = "gm_je_com_lbl_months"
				}
				blockoverride "row_value" {
					text = "gm_je_com_val_months"
				}
			}
			# Levels queued count only once finished: say so while any are
			# being built, so the bar's standstill reads right (usability §4).
			gm_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_com_building'), '(CFixedPoint)1' )]"
				text = "gm_je_com_building"
			}
			gm_text = {
				default_format = "#tooltippable"
				tooltip = "gm_je_com_reward_tt"
				text = "gm_je_com_reward"
			}

			# Raise It (usability §1) beside Let It Pass, two to a row as the
			# policy buttons are (gm_policy_button: 2 x 230 + 8).
			flowcontainer = {
				direction = horizontal
				spacing = 8
				parentanchor = hcenter
				margin_top = 2

				gm_policy_button = {
					blockoverride "policy_context" { datacontext = "[GetScriptedGui('gm_com_raise_sgui')]" }
					blockoverride "policy_tooltip" { tooltip = "gm_button_com_raise_tooltip" }
					blockoverride "policy_text" { text = "gm_button_com_raise" }
				}
				gm_policy_button = {
					blockoverride "policy_context" { datacontext = "[GetScriptedGui('gm_com_let_pass_sgui')]" }
					blockoverride "policy_tooltip" { tooltip = "gm_button_com_let_pass_tooltip" }
					blockoverride "policy_text" { text = "gm_button_com_let_pass" }
				}
			}
		}
	}

	### National Effects (open): what our monuments give the country. Each total
	### only while it is in force (owner, play-test round 2: zero rows hide),
	### and one line when none is; then approval and the fading legitimacy,
	### each under a heading shown only while it has a line.
	type te_gm_sec_national = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_national_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_national_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_national_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_national_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_national_closed'))]"
			spacing = 2

			# What a level built this year adds (sites spec 2026-10-18 §3.2,
			# Plan B), why on hover.
			gm_text = {
				default_format = "#tooltippable"
				tooltip = "gm_je_world_rate_tt"
				text = "gm_je_world_rate"
			}
			# Nothing in force (every monument contested, say, or the month's
			# count not yet run): one line, so the section never opens empty.
			gm_text = {
