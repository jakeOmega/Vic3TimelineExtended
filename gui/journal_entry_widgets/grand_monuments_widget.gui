### Grand Monuments JE widgets (spec §6; style pass 2026-09-29,
### docs/guides/gui_style_guide.md)
###
### Three named roots at the foot of this file, mounted from je_grand_monuments:
###   widget_je_gm_overview   custom_widget_container_1 (above the status desc)
###     The overview, always shown: how many monuments are upheld, heritage,
###     undedicated or contested, as lit or dimmed icons, and under them
###     Hard Times while a finished level would cause vanity backlash (§5).
###   widget_je_gm_status     custom_widget_container_2
###     (The entry has no status description: its counts were the overview's.)
###     Commission (open), only while one is open (v2 §2.7): who asked, the
###     monument asked for, a progress bar, the months left and Ask for More
###     Time.
###     National Effects (open): a bar per stepped total, then interest group
###     approval and the fading ledgers. Our Monuments (open): one row per
###     monument, from the country's gm_states list (rebuilt by every
###     gm_country_refresh); a contested row carries three buttons.
###   widget_je_gm_reference  custom_widget_container_3
###     How Grand Monuments Work (collapsed): every explanation.
### The sections are types composed by te_gm_status_sections and
### te_gm_reference_sections, so a future tab can reuse them.
###
### EDITING RULES
### * Numbers come from JournalEntry.GetCountry.MakeScope.ScriptValue (the
###   guarded gm_display_* and gm_disp_* values in gm_values.txt) and, in a
###   monument's row, State.MakeScope.ScriptValue.
### * A row's status is gm_status_code (0-4), tested for identity, never a
###   threshold (gotcha #23).
### * The row buttons pass the row's state as the saved scope gm_state, one
###   scripted GUI per action (common/scripted_guis/gm_sguis.txt).
### * A tooltip inside a monument's row reads nothing but State: the row is a
###   datamodel item (gotcha #24).
### * Collapse flags say their default: *_closed sections are open until
###   closed, *_open ones collapsed until opened (test_grand_monuments_layout.py).
### * Every root and composer is gated on [JournalEntry.IsActive] (gotcha #14).
### * The status and Hard Times icons are the mod's own (gfx/interface/icons/
###   gm_icons/, PR #586); what each shows is in
###   docs/systems/grand_monuments_gui_icons.md.

types grand_monuments_widget_types
{
	### ======================================================================
	### BUILDING BLOCKS (the UN chamber's shapes, un_chamber_widget.gui)
	### ======================================================================

	type gm_panel = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 8 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	type gm_section_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 520 38 }
		}
	}

	### A heading inside a section's panel, over one group of its lines, with a
	### faint rule under it. A heading over a group that can be empty carries
	### the group's `visible`.
	type gm_subheader = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		block "subheader_margin" {
			margin_top = 10
		}

		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 480 -1 }
			align = left|nobaseline
			using = fontsize_large
			default_format = "#title"
			block "subheader_text" {}
		}
		divider_clean = {
			blockoverride "size" {
				size = { 480 2 }
			}
		}
	}

	### Explanatory text under a heading in How Grand Monuments Work.
	type gm_note = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_medium
		default_format = "#lore"
	}

	### A live line of text across the panel.
	type gm_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_medium
	}

	### A cell of the overview: an icon, its word small beneath. Lit at full
	### colour while its count is above zero, dimmed at zero; the instance sets
	### the texture and the two `visible`s. Fixed width, so the row cannot push
	### the panel wider: four cells of 120 fill the 480 column.
	type gm_ov_cell = widget {
		size = { 120 58 }

		icon = {
			size = { 36 36 }
			parentanchor = top|hcenter
			block "lit" {}
			block "cell_texture" {}
		}
		icon = {
			size = { 36 36 }
			parentanchor = top|hcenter
			alpha = 0.25
			block "unlit" {}
			block "cell_texture" {}
		}
		textbox = {
			parentanchor = bottom|hcenter
			autoresize = yes
			max_width = 118
			elide = right
			align = hcenter|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			block "label" {}
		}
	}

	### A stepped national total: its name, a bar showing how far the step now
	### being filled has come, and its value. The tooltip (on the instance)
	### gives the full modifier name, the grandeur behind it and where the next
	### step completes. 4 + 240 + 8 + 130 + 8 + 86 + 4 = 480: the label column
	### holds 25 characters of the medium font (play-test round 3; the budget
	### is test_grand_monuments_layout.LabelBudgetTest).
	type gm_step_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 8
		margin = { 4 2 }

		textbox = {
			minimumsize = { 240 -1 }
			maximumsize = { 240 -1 }
			autoresize = yes
			parentanchor = vcenter
			align = left|nobaseline
			using = fontsize_medium
			elide = right
			default_format = "#tooltippable"
			block "row_label" {}
		}
		default_progressbar_horizontal = {
			size = { 130 14 }
			parentanchor = vcenter
			blockoverride "values" {
				block "row_frac" {}
				min = 0
				max = 1
			}
		}
		textbox = {
			minimumsize = { 86 -1 }
			maximumsize = { 86 -1 }
			autoresize = yes
			parentanchor = vcenter
			align = right|nobaseline
			using = fontsize_medium
			block "row_value" {}
		}
	}

	### A table row: a label on the left and its value on the right, the value
	### column in line with gm_step_row's. 4 + 386 + 86 + 4 = 480.
	type gm_value_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		margin = { 4 1 }

		textbox = {
			minimumsize = { 386 -1 }
			maximumsize = { 386 -1 }
			autoresize = yes
			align = left|nobaseline
			using = fontsize_medium
			elide = right
			default_format = "#tooltippable"
			block "row_label" {}
		}
		textbox = {
			minimumsize = { 86 -1 }
			maximumsize = { 86 -1 }
			autoresize = yes
			align = right|nobaseline
			using = fontsize_medium
			block "row_value" {}
		}
	}

	### A monument's status: an icon, the status word beneath. The instance
	### sets the texture, the `visible` (one status code each) and a tooltip
	### that reads nothing (gotcha #24).
	type gm_row_status = widget {
		size = { 96 58 }

		icon = {
			size = { 36 36 }
			parentanchor = top|hcenter
			block "status_texture" {}
		}
		textbox = {
			parentanchor = bottom|hcenter
			autoresize = yes
			max_width = 94
			elide = right
			align = hcenter|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			text = "gm_row_status"
		}
	}

	### A line of a monument's row, beside its status (96 + 8 + 376 = 480).
	type gm_row_line = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 376 -1 }
		maximumsize = { 376 -1 }
		align = left|nobaseline
		using = fontsize_medium
	}

	### One of a contested row's three choices. choice_context points it at its
	### scripted GUI; the row's state travels as the saved scope gm_state.
	type gm_choice_button = button {
		using = default_button_action
		size = { 150 24 }
		margin_top = 2

		block "choice_context" {}

		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'gm_state', State.MakeScope ).End )]"

		block "choice_tooltip" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 140
			elide = right
			using = fontsize_small
			block "choice_text" {}
		}
	}

	### One monument: its status as an icon with the word beneath; its form
	### and dedication; where it stands and its grandeur; while contested, who
	### wants it kept and who resents it, and the three choices centred under
	### the row; last, the revived-language inscription (empty when none).
	type gm_monument_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 8

			gm_row_status = {
				visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)1' )]"
				tooltip = "gm_je_status_undedicated_tt"
				blockoverride "status_texture" {
					texture = "gfx/interface/icons/gm_icons/status_undedicated.dds"
				}
			}
			gm_row_status = {
				visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)2' )]"
				tooltip = "gm_je_status_upheld_tt"
				blockoverride "status_texture" {
					texture = "gfx/interface/icons/gm_icons/status_upheld.dds"
				}
			}
			gm_row_status = {
				visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)3' )]"
				tooltip = "gm_je_status_heritage_tt"
				blockoverride "status_texture" {
					texture = "gfx/interface/icons/gm_icons/status_heritage.dds"
				}
			}
			gm_row_status = {
				visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)4' )]"
				tooltip = "gm_je_status_contested_tt"
				blockoverride "status_texture" {
					texture = "gfx/interface/icons/gm_icons/status_contested.dds"
				}
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				textbox = {
					autoresize = yes
					multiline = yes
					minimumsize = { 376 -1 }
					maximumsize = { 376 -1 }
					align = left|nobaseline
					using = fontsize_large
					text = "gm_row_title"
				}
				gm_row_line = {
					text = "gm_row_detail"
				}
				gm_row_line = {
					visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)4' )]"
					default_format = "#tooltippable"
					tooltip = "gm_row_contest_tt"
					text = "gm_row_contest"
				}
				gm_row_line = {
					text = "gm_row_inscription"
				}
			}
		}

		# Rename (v2 §3.3): an upheld monument's form and namesake again, at
		# no cost. A contested or heritage monument keeps its name.
		flowcontainer = {
			direction = horizontal
			spacing = 4
			parentanchor = hcenter
			visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_can_rename'), '(CFixedPoint)1' )]"

			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_rename_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_rename_tooltip" }
				blockoverride "choice_text" { text = "gm_button_rename" }
			}
		}

		flowcontainer = {
			direction = horizontal
			spacing = 4
			parentanchor = hcenter
			visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)4' )]"

			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_tear_down_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_tear_down_tooltip" }
				blockoverride "choice_text" { text = "gm_button_tear_down" }
			}
			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_rededicate_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_rededicate_tooltip" }
				blockoverride "choice_text" { text = "gm_button_rededicate" }
			}
			gm_choice_button = {
				blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_preserve_sgui')]" }
				blockoverride "choice_tooltip" { tooltip = "gm_button_preserve_tooltip" }
				blockoverride "choice_text" { text = "gm_button_preserve" }
			}
		}
	}

	### ======================================================================
	### SECTIONS. Composed, in order, by te_gm_status_sections and
	### te_gm_reference_sections below.
	### ======================================================================

	### The overview, always shown. One cell per status, lit while any monument
	### has it; under the cells, Hard Times only while it holds. The cells share
	### the status tooltips with the rows below.
	type te_gm_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		visible = "[JournalEntry.IsActive]"

		gm_panel = {
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				minimumsize = { 480 -1 }

				flowcontainer = {
					direction = horizontal
					spacing = 0
					ignoreinvisible = yes
					parentanchor = hcenter

					gm_ov_cell = {
						tooltip = "gm_je_status_upheld_tt"
						blockoverride "cell_texture" {
							texture = "gfx/interface/icons/gm_icons/status_upheld.dds"
						}
						blockoverride "lit" {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_upheld'), '(CFixedPoint)0' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_upheld'), '(CFixedPoint)0' ) )]"
						}
						blockoverride "label" {
							text = "gm_je_ov_upheld"
						}
					}
					gm_ov_cell = {
						tooltip = "gm_je_status_heritage_tt"
						blockoverride "cell_texture" {
							texture = "gfx/interface/icons/gm_icons/status_heritage.dds"
						}
						blockoverride "lit" {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_heritage'), '(CFixedPoint)0' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_heritage'), '(CFixedPoint)0' ) )]"
						}
						blockoverride "label" {
							text = "gm_je_ov_heritage"
						}
					}
					gm_ov_cell = {
						tooltip = "gm_je_status_undedicated_tt"
						blockoverride "cell_texture" {
							texture = "gfx/interface/icons/gm_icons/status_undedicated.dds"
						}
						blockoverride "lit" {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_undedicated'), '(CFixedPoint)0' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_undedicated'), '(CFixedPoint)0' ) )]"
						}
						blockoverride "label" {
							text = "gm_je_ov_undedicated"
						}
					}
					gm_ov_cell = {
						tooltip = "gm_je_status_contested_tt"
						blockoverride "cell_texture" {
							texture = "gfx/interface/icons/gm_icons/status_contested.dds"
						}
						blockoverride "lit" {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_contested'), '(CFixedPoint)0' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_contested'), '(CFixedPoint)0' ) )]"
						}
						blockoverride "label" {
							text = "[SelectLocalization( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_contested'), '(CFixedPoint)0' ), 'gm_je_ov_contested_some', 'gm_je_ov_contested_none' )]"
						}
					}
				}

				# Hard times (§5): only while a finished level would cause
				# vanity backlash, the warning icon over a red phrase, each
				# with the sentence on hover (owner, play-test round 2). Its
				# own line, not a fifth cell: a cell appearing later would
				# widen the row after its first layout and pull it off-centre.
				# Every width here is fixed: the column is 480, the icon 32,
				# the phrase 480 with its text centred.
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					minimumsize = { 480 -1 }
					margin_top = 4
					visible = "[GetScriptedGui('gm_hard_times_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					icon = {
						size = { 32 32 }
						parentanchor = hcenter
						tooltip = "gm_je_ov_hard_times_tt"
						texture = "gfx/interface/icons/gm_icons/hard_times.dds"
					}
					textbox = {
						autoresize = yes
						minimumsize = { 480 -1 }
						maximumsize = { 480 -1 }
						align = hcenter|nobaseline
						using = fontsize_large
						default_format = "#tooltippable"
						tooltip = "gm_je_ov_hard_times_tt"
						text = "gm_je_ov_hard_times"
					}
				}
			}
		}
	}

	### Commission (open), shown only while one is open (v2 §2.7): who asked for
	### what, the monument it will be, a bar of the grandeur added against the
	### target, the months left and Ask for More Time (once). Country reads
	### only: the commission is the country's record.
	type te_gm_sec_commission = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_com_open'), '(CFixedPoint)1' )]"

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_commission_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_commission_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_commission_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_commission_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_commission_closed'))]"
			spacing = 2

			gm_text = {
				default_format = "#tooltippable"
				tooltip = "gm_je_com_ask_tt"
				text = "gm_je_com_ask"
			}
			gm_text = {
				text = "gm_je_com_named"
			}
			gm_step_row = {
				tooltip = "gm_je_com_progress_tt"
				blockoverride "row_label" {
					text = "gm_je_com_lbl_progress"
				}
				blockoverride "row_frac" {
					value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_com_frac') )]"
				}
				blockoverride "row_value" {
					text = "gm_je_com_val_progress"
				}
			}
			gm_value_row = {
				tooltip = "gm_je_com_months_tt"
				blockoverride "row_label" {
					text = "gm_je_com_lbl_months"
				}
				blockoverride "row_value" {
					text = "gm_je_com_val_months"
				}
			}

			button = {
				using = default_button_action
				size = { 220 26 }
				parentanchor = hcenter
				margin_top = 4
				datacontext = "[GetScriptedGui('gm_com_extend_sgui')]"
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "gm_button_com_extend_tooltip"

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 210
					elide = right
					using = fontsize_small
					text = "gm_button_com_extend"
				}
			}
		}
	}

	### National Effects (open): what our monuments give the country. Each total
	### only while it is in force (owner, play-test round 2: zero rows hide),
	### and one line when none is; then approval and the fading legitimacy,
	### each under a heading shown only while it has a line.
	type te_gm_sec_national = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_national_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_national_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_national_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_national_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_national_closed'))]"
			spacing = 2

			# Nothing in force (every monument contested, say, or the month's
			# count not yet run): one line, so the section never opens empty.
			gm_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_national_any'), '(CFixedPoint)0' )]"
				text = "gm_je_national_none"
			}
			gm_step_row = {
				visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_display_prestige'), '(CFixedPoint)0' )]"
				tooltip = "gm_je_tt_prestige"
				blockoverride "row_label" {
					text = "gm_je_lbl_prestige"
				}
				blockoverride "row_frac" {
					value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_frac_prestige') )]"
				}
				blockoverride "row_value" {
					text = "gm_je_val_prestige"
				}
			}
			gm_step_row = {
				visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_display_legitimacy'), '(CFixedPoint)0' )]"
				tooltip = "gm_je_tt_legitimacy"
				blockoverride "row_label" {
					text = "gm_je_lbl_legitimacy"
				}
				blockoverride "row_frac" {
					value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_frac_legitimacy') )]"
				}
				blockoverride "row_value" {
					text = "gm_je_val_legitimacy"
				}
			}
			gm_step_row = {
				visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_display_culture'), '(CFixedPoint)0' )]"
				tooltip = "gm_je_tt_culture"
				blockoverride "row_label" {
					text = "gm_je_lbl_culture"
				}
				blockoverride "row_frac" {
					value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_frac_culture') )]"
				}
				blockoverride "row_value" {
					text = "gm_je_val_culture"
				}
			}
			gm_step_row = {
