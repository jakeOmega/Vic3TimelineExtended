### JOURNAL ENTRY ROOTS (je_grand_monuments.txt). Bare wrappers that repeat the
### composers' IsActive gate, so an inactive entry's containers collapse.
### ==========================================================================
flowcontainer = {
	name = "widget_je_gm_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_gm_overview_panel = {}
}

flowcontainer = {
	name = "widget_je_gm_status"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_gm_status_sections = {}
}

flowcontainer = {
	name = "widget_je_gm_reference"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_gm_reference_sections = {}
}
