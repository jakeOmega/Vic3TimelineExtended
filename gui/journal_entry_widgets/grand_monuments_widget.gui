		}
	}

	### ======================================================================
	### COMPOSERS. The one order of the sections.
	### ======================================================================

	### Everything a returning player checks, open by default.
	type te_gm_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_gm_sec_commission = {}
		# Archaeological Expeditions (gui/gm_archaeology_widgets.gui): the digs we
		# run and the sites open to us.
		te_gm_sec_archaeology = {}
		te_gm_sec_national = {}
		# Awaiting Dedication (owner, 2026-10-18): the monuments a Dedicate
		# button finishes, above the others.
		te_gm_sec_awaiting = {}
		te_gm_sec_monuments = {}
		# Trophies (gui/gm_trophy_widgets.gui): ours, and ours held abroad.
		te_gm_sec_trophies = {}
		te_gm_sec_abroad = {}
	}

	### How it all works, collapsed.
	type te_gm_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_gm_sec_how = {}
	}
}

