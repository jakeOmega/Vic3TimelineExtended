	### Awaiting Dedication (open; owner, 2026-10-18): only while a construction
	### site of ours waits for its Dedicate button (gm_disp_count_awaiting),
	### above the rest: its row (gm_site_row), then the button. Our Monuments
	### lists the finished monuments (gm_state_disp_listed).
	type te_gm_sec_awaiting = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_awaiting'), '(CFixedPoint)0' )]"

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_awaiting_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_awaiting_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_awaiting_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_awaiting_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_awaiting_closed'))]"

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gm_states')]"

				item = {
					flowcontainer = {
						datacontext = "[Scope.GetState]"
						visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_awaiting'), '(CFixedPoint)1' )]"
						direction = vertical
						ignoreinvisible = yes
						spacing = 4

						gm_site_row = {}
						gm_dedicate_button = {}
					}
				}
			}
		}
	}

	### Our Monuments (open): one row per finished monument; construction sites
	### are the section above's. The entry can outlive its last monument
	### while a ledger fades; the panel then says so.
	type te_gm_sec_monuments = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_monuments_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_monuments_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('gm_monuments_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('gm_monuments_closed'))]"
			}
		}

		gm_panel = {
			visible = "[Not(GetVariableSystem.Exists('gm_monuments_closed'))]"

			gm_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_display_count'), '(CFixedPoint)0' )]"
				text = "gm_je_monuments_none"
			}
			# Every monument we have awaits its dedication, above.
			gm_text = {
				visible = "[And( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_display_count'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('gm_disp_count_listed'), '(CFixedPoint)0' ) )]"
				text = "gm_je_monuments_all_awaiting"
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gm_states')]"

				item = {
					gm_monument_row = {
						datacontext = "[Scope.GetState]"
						visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_listed'), '(CFixedPoint)1' )]"
					}
				}
			}

			### The monuments that stand beside a state's primary one
			### (gm_monuments_held, the monthly pass): a row each, under the
			### states', with where it stands. A trophy's container still, so
			### the trophy row's picture and title serve it
			### (gui/gm_trophy_widgets.gui).
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 10
				margin_top = 10
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gm_monuments_held')]"

				item = {
					gm_mon_row_site = {
						datacontext = "[Scope.GetScriptContainer]"
						blockoverride "mon_where" {
							gm_tr_line = {
								text = "gm_mon_row_where"
							}
						}
						### A contested one's three choices, centred under it
						### (ageing spec 2026-10-16 §4.3).
						blockoverride "mon_choices" {
							flowcontainer = {
								direction = horizontal
								spacing = 4
								parentanchor = hcenter
								visible = "[EqualTo_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('gm_mon_status_code'), '(CFixedPoint)4' )]"

								gm_mon_choice_button = {
									blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_mon_tear_down_sgui')]" }
									blockoverride "choice_tooltip" { tooltip = "gm_button_mon_tear_down_tooltip" }
									blockoverride "choice_text" { text = "gm_button_tear_down" }
								}
								gm_mon_choice_button = {
									blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_mon_rededicate_sgui')]" }
									blockoverride "choice_tooltip" { tooltip = "gm_button_mon_rededicate_tooltip" }
									blockoverride "choice_text" { text = "gm_button_rededicate" }
								}
								gm_mon_choice_button = {
									blockoverride "choice_context" { datacontext = "[GetScriptedGui('gm_mon_preserve_sgui')]" }
									blockoverride "choice_tooltip" { tooltip = "gm_button_mon_preserve_tooltip" }
									blockoverride "choice_text" { text = "gm_button_preserve" }
								}
							}
						}
					}
				}
			}
		}
	}

	### "How Grand Monuments Work": every explanation, collapsed by default,
	### one heading per topic. The live sections above say what is happening;
	### this says how it works.
	type te_gm_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		gm_section_header = {
			blockoverride "left_text" {
				text = "gm_je_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('gm_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('gm_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('gm_how_open')]"
			}
		}

		gm_panel = {
			visible = "[GetVariableSystem.Exists('gm_how_open')]"

			gm_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_grandeur"
				}
			}
			gm_note = {
