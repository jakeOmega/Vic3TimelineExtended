			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_signatures"
				}
			}
			gm_note = {
				text = "gm_je_how_signatures"
			}
			gm_note = {
				text = "gm_je_how_signatures_specials"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_contested"
				}
			}
			gm_note = {
				text = "gm_je_how_contested"
			}
			gm_note = {
				text = "gm_je_how_choices"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_hard_times"
				}
			}
			gm_note = {
				text = "gm_je_how_hard_times"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_commissions"
				}
			}
			gm_note = {
				text = "gm_je_how_commissions"
			}
			gm_note = {
				text = "gm_je_how_commissions_rewards"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
					text = "gm_je_how_sub_names"
				}
			}
			gm_note = {
				text = "gm_je_how_names"
			}
			gm_subheader = {
				blockoverride "subheader_text" {
