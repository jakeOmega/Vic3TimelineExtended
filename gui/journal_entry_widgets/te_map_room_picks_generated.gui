		# Economy: output (GDP, GDP per capita) and work (unemployment, the jobs open); how wealth is spread (the
		# walk's Gini and Dynastic Wealth) and who owns the capital; where the companies keep their headquarters, what
		# the owners invest and the trade a state can carry; its infrastructure to spare and the market access it
		# buys; the power grids, and what each station sends or receives on them.
		te_jmap_category_header = {
			blockoverride "left_text" {
				text = "te_jmap_cat_economy"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_jmap_cat_economy_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_jmap_cat_economy_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_jmap_cat_economy_open')]"
			}
		}
		te_jmap_category = {
			visible = "[GetVariableSystem.Exists('te_jmap_cat_economy_open')]"

			flowcontainer = {
