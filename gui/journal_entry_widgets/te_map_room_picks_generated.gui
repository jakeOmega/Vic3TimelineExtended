					down = "[Not( GetScriptedGui('te_jmap_pick_pollution_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_pollution_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
				}

