# AUTO-GENERATED by scripts/generators/gen_journal_map_picks.py — do not edit manually
### The Map Room's page (te_map_room_widget.gui) mounts te_jmap_pick_row above its options. Edit MAPS and GROUPS
### in the generator, not this file.
types te_map_room_picks_generated
{
	### The Map Room's picks, one per map (te_journal_map_picks_generated.txt), in groups by theme (owner,
	### 2026-11-23), each a collapsible section: a header (te_jmap_category_header, te_map_widgets.gui) and its rows,
	### shown while the group's client-side flag te_jmap_cat_<key>_open is set. Every group starts collapsed (a long
	### list: gui_style_guide.md, Sections), and the flags outlive a pick's reopen (the GetVariableSystem's, as the
	### see-through page's), so a group opened stays open from map to map. A button is pressed while it is the pick and
	### hidden while its map can't be drawn (a census map while the census doesn't run, a system's map while its rule
	### is off). A group whose every map is gated hides with them, header and all (te_jmap_cat_<key>_sgui), and a row
	### whose maps share a gate hides with it. Three 150-wide buttons to a row fit the page.
	type te_jmap_pick_row = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# Population: where people live and how their numbers move: the people, the people per km² and the yearly
		# walk's urban share; the walk's growth, the census's net migration, and the crowding that cuts a state's
		# migration attraction; tourism's ranking of the cities.
		te_jmap_category_header = {
			blockoverride "left_text" {
				text = "te_jmap_cat_population"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_jmap_cat_population_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_jmap_cat_population_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_jmap_cat_population_open')]"
			}
		}
		te_jmap_category = {
			visible = "[GetVariableSystem.Exists('te_jmap_cat_population_open')]"

			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 4

				te_jmap_pick_button = {
					text = "te_jmap_pick_population"
					tooltip = "te_jmap_pick_population_desc"
					visible = "[GetScriptedGui('te_jmap_pick_population_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					down = "[Not( GetScriptedGui('te_jmap_pick_population_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					onclick = "[GetScriptedGui('te_jmap_pick_population_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[PdxGuiTriggerAllAnimations('te_jmap_repaint')]"
