### Banking history charts — the "History" section of je_banking_cycle.
###
### Wired from common/journal_entries/je_banking.txt as
### `widget = { name = "widget_je_banking_history" container = "custom_widget_container_2" }`,
### directly under Current Conditions.
###
### Five charts, one per unit: the cycle value and bubble pressure are 0..100
### indices, momentum is a signed monthly delta, and the two monetary series are
### in percentage points, so they never share an axis. Each monetary chart's
### axis is deliberately narrower than its variable's full range — see the
### comment above each one.
### Every bar reads a `te_hist_v_*` variable recorded by
### common/scripted_effects/te_history_banking_effects.txt; the reusable
### chart type lives in te_history_chart.gui.
###
### The section is collapsed by default — the flag is the *open* flag, the
### inverse of the dashboard's collapsed flags — so a player who does not open
### it never pays for 360 bar widgets. Nothing here has an effect: the only
### click targets are the collapse header and the three range buttons, and
### both write GUI variables only.

flowcontainer = {
	name = "widget_je_banking_history"

	# je_banking_cycle has is_shown_when_inactive, so the panel can open for a
	# country whose entry has not activated yet and therefore has none of the
	# cycle variables. Draw nothing until the journal entry is running.
	visible = "[JournalEntry.IsActive]"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	spacing = 2

	banking_dash_category_header = {
		blockoverride "left_text" {
			text = "te_hist_section_header"
			using = elide_fontsize_min
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('te_hist_charts_open')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('te_hist_charts_open'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('te_hist_charts_open')]"
		}
	}

	flowcontainer = {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetVariableSystem.Exists('te_hist_charts_open')]"

		### Range selector + "history available since"
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 4
			margin = { 4 4 }

			te_history_range_button = {
				blockoverride "range_text" {
					text = "te_hist_range_1y"
				}
				blockoverride "range_enabled" {
					enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '1' ))]"
				}
				blockoverride "range_onclick" {
					onclick = "[GetVariableSystem.Set( 'te_hist_range', '1' )]"
				}
			}
			te_history_range_button = {
				blockoverride "range_text" {
					text = "te_hist_range_5y"
				}
				blockoverride "range_enabled" {
					enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '5' ))]"
				}
				blockoverride "range_onclick" {
					onclick = "[GetVariableSystem.Set( 'te_hist_range', '5' )]"
				}
			}
			te_history_range_button = {
				blockoverride "range_text" {
					text = "te_hist_range_10y"
				}
				blockoverride "range_enabled" {
					enabled = "[Or( GetVariableSystem.HasValue( 'te_hist_range', '1' ), GetVariableSystem.HasValue( 'te_hist_range', '5' ) )]"
				}
				blockoverride "range_onclick" {
					onclick = "[GetVariableSystem.Set( 'te_hist_range', '10' )]"
				}
			}
		}

		textbox = {
			visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('te_hist') ) )]"
			parentanchor = hcenter
			autoresize = yes
			multiline = yes
			max_width = 480
			align = hcenter|nobaseline
			text = "te_hist_since"
		}

		### ---- Cycle value (0-100 index) --------------------------------
		te_history_chart = {
			blockoverride "chart_title" {
				text = "te_hist_chart_bank_value_title"
			}
			blockoverride "chart_legend" {
				text = "te_hist_chart_bank_value_legend"
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_hist_tt_bank_value"
			}
			blockoverride "bar_body" {
				te_history_bar_unsigned = {
					visible = "[ScriptContainer.HasVariable( 'te_hist_v_bank_value' )]"
					blockoverride "values" {
						min = 0
						max = 100
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_bank_value' ) ) )]"
					}
					blockoverride "cover_values" {
						min = 0
						max = 100
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_bank_value' ), '(CFixedPoint)4' ) ) )]"
					}
					blockoverride "color" {
						color = { 0.42 0.62 0.85 1.0 }
					}
				}
			}
		}

		### ---- Momentum (signed monthly delta) --------------------------
		te_history_chart = {
			blockoverride "chart_title" {
				text = "te_hist_chart_bank_momentum_title"
			}
			blockoverride "chart_legend" {
				text = "te_hist_chart_bank_momentum_legend"
			}
			blockoverride "zero_axis" {
				widget = {
					size = { 100% 2 }
					parentanchor = vcenter
					alwaystransparent = yes

					background = {
						using = dark_area
						alpha = 0.7
					}
				}
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_hist_tt_bank_momentum"
			}
			blockoverride "bar_body" {
				te_history_bar_signed = {
					visible = "[ScriptContainer.HasVariable( 'te_hist_v_bank_momentum' )]"
					blockoverride "positive_values" {
						min = 0
						max = 6
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue( 'te_hist_v_bank_momentum' ) ) )]"
					}
					blockoverride "positive_cover_values" {
						min = 0
						max = 6
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_bank_momentum' ), '(CFixedPoint)0.5' ) ) )]"
					}
					blockoverride "negative_values" {
						min = -6
						max = 0
						value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue( 'te_hist_v_bank_momentum' ) ) )]"
					}
					blockoverride "negative_cover_values" {
						min = -6
						max = 0
						value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', Add_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_bank_momentum' ), '(CFixedPoint)0.5' ) ) )]"
					}
				}
			}
		}

		### ---- Bubble pressure (0-100 index) ----------------------------
		te_history_chart = {
			blockoverride "chart_title" {
				text = "te_hist_chart_bank_bubble_title"
			}
			blockoverride "chart_legend" {
				text = "te_hist_chart_bank_bubble_legend"
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_hist_tt_bank_bubble"
			}
			blockoverride "bar_body" {
				te_history_bar_unsigned = {
					visible = "[ScriptContainer.HasVariable( 'te_hist_v_bank_bubble' )]"
					blockoverride "values" {
						min = 0
						max = 100
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_bank_bubble' ) ) )]"
					}
					blockoverride "cover_values" {
						min = 0
						max = 100
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_bank_bubble' ), '(CFixedPoint)4' ) ) )]"
					}
					blockoverride "color" {
						color = { 0.85 0.55 0.28 1.0 }
					}
				}
			}
		}

		### ---- Policy rate (percentage points, signed) ------------------
		### Signed rather than unsigned because a digital-currency regime can
		### run the rate down to -3 (monetary_policy_design.md §5.1) and that
		### is precisely the interesting case: it is where open market
		### operations unlock. The axis is a symmetric +/-12 rather than the
		### variable's full -3..25 range, so the 2-6% band an ordinary
		### campaign lives in is readable; a rate above 12% draws a full bar
		### and the exact figure stays in the tooltip.
		te_history_chart = {
			blockoverride "chart_title" {
				text = "te_hist_chart_mon_policy_title"
			}
			blockoverride "chart_legend" {
				text = "te_hist_chart_mon_policy_legend"
			}
			blockoverride "zero_axis" {
				widget = {
					size = { 100% 2 }
					parentanchor = vcenter
					alwaystransparent = yes

					background = {
						using = dark_area
						alpha = 0.7
					}
				}
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_hist_tt_mon_policy"
			}
			blockoverride "bar_body" {
				te_history_bar_signed = {
					visible = "[ScriptContainer.HasVariable( 'te_hist_v_mon_policy' )]"
					blockoverride "positive_values" {
						min = 0
						max = 12
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue( 'te_hist_v_mon_policy' ) ) )]"
					}
					blockoverride "positive_cover_values" {
						min = 0
						max = 12
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_mon_policy' ), '(CFixedPoint)0.5' ) ) )]"
					}
					blockoverride "positive_color" {
						color = { 0.50 0.58 0.80 1.0 }
					}
					blockoverride "negative_values" {
						min = -12
						max = 0
						value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue( 'te_hist_v_mon_policy' ) ) )]"
					}
					blockoverride "negative_cover_values" {
						min = -12
						max = 0
						value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', Add_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_mon_policy' ), '(CFixedPoint)0.5' ) ) )]"
					}
				}
			}
		}

		### ---- Rate the government pays (percentage points) --------------
		### Never negative (the §4 clamp floors it at 0.5), so an unsigned
		### bar. The axis stops at 20 rather than the variable's 60 ceiling
		### for the same reason as above: a default campaign sits between 2
		### and 12, and a country in a debt spiral draws a full bar with the
		### real figure in the tooltip. Read against the policy-rate chart
		### above, the gap between the two IS the risk premium.
		te_history_chart = {
			blockoverride "chart_title" {
				text = "te_hist_chart_mon_rate_paid_title"
			}
			blockoverride "chart_legend" {
				text = "te_hist_chart_mon_rate_paid_legend"
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_hist_tt_mon_rate_paid"
			}
			blockoverride "bar_body" {
				te_history_bar_unsigned = {
					visible = "[ScriptContainer.HasVariable( 'te_hist_v_mon_rate_paid' )]"
					blockoverride "values" {
						min = 0
						max = 20
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0.4', ScriptContainer.GetVariableValue( 'te_hist_v_mon_rate_paid' ) ) )]"
					}
					blockoverride "cover_values" {
						min = 0
						max = 20
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_mon_rate_paid' ), '(CFixedPoint)0.8' ) ) )]"
					}
					blockoverride "color" {
						color = { 0.80 0.66 0.34 1.0 }
					}
				}
			}
		}
	}
}
