### United Nations — layout. The one place that sets the order of the UN's
### sections, for both hosts: the journal entry (je_united_nations.txt attaches
### the named roots at the foot of this file) and the Diplomacy panel's UN tab
### (gui/diplomatic_overview.gui instances the composers). The sections are
### types in un_chamber_widget.gui and un_authority_widget.gui; the overview is
### un_overview_widget.gui. Spec: docs/superpowers/archive/specs/2026-09-28-un-gui-pass-design.md.
###
### Collapse flags say their default: *_closed sections are open until closed,
### *_open ones collapsed until opened (test_un_layout.py).

types un_layout_widget_types
{
	### The General Assembly: the session core, then either the session's
	### delegations and ballot, or, with nothing in session, the proposals. The
	### two never both apply: every proposal needs the one-vote lock free.
	type te_un_sec_assembly = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_assembly_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_chamber_assembly_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_chamber_assembly_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_chamber_assembly_closed'))]"
			}
		}

		un_chamber_panel = {
			visible = "[Not(GetVariableSystem.Exists('un_chamber_assembly_closed'))]"

			### The resolution in session at a glance: topic, tally, time. The tally
			### spans the members with a vote: three stacked bars, red to the end,
			### grey (not yet voted) to 1 - no, green (yes) on top. The upper layers
			### blank their own background and frame so the lower ones show.
			flowcontainer = {
				direction = vertical
				spacing = 4
				ignoreinvisible = yes
				visible = "[GetScriptedGui('un_session_open_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				flowcontainer = {
					direction = horizontal
					spacing = 8

					widget = {
						size = { 40 40 }
						parentanchor = vcenter
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)0' )]"
							texture = "gfx/interface/icons/un_icons/topic_condemn.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)1' )]"
							texture = "gfx/interface/icons/un_icons/topic_sanctions.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)2' )]"
							texture = "gfx/interface/icons/un_icons/topic_expulsion.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)3' )]"
							texture = "gfx/interface/icons/un_icons/topic_mandate.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)4' )]"
							texture = "gfx/interface/icons/un_icons/topic_peacekeepers.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)5' )]"
							texture = "gfx/interface/icons/un_icons/topic_aid.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)6' )]"
							texture = "gfx/interface/icons/un_icons/topic_reform.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)7' )]"
							texture = "gfx/interface/icons/un_icons/topic_human_rights.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)8' )]"
							texture = "gfx/interface/icons/un_icons/topic_icc.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)9' )]"
							texture = "gfx/interface/icons/un_icons/topic_npt.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)10' )]"
							texture = "gfx/interface/icons/un_icons/topic_climate.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)11' )]"
							texture = "gfx/interface/icons/un_icons/topic_pandemic.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)12' )]"
							texture = "gfx/interface/icons/un_icons/topic_refugee.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)13' )]"
							texture = "gfx/interface/icons/un_icons/topic_heritage.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)14' )]"
							texture = "gfx/interface/icons/un_icons/topic_decolonization.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)15' )]"
							texture = "gfx/interface/icons/un_icons/topic_space.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)16' )]"
							texture = "gfx/interface/icons/un_icons/topic_law_of_sea.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)17' )]"
							texture = "gfx/interface/icons/un_icons/topic_physical_protection.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)29' )]"
							texture = "gfx/interface/icons/un_icons/topic_narcotics.dds"
						}
						# The Global Commons (2026-10-16-global-commons-design.md §4, §6.5):
						# for now copies of the climate accord's and space cooperation's
						# icons, under their own names, so new art drops in.
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)31' )]"
							texture = "gfx/interface/icons/un_icons/topic_antarctic.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)32' )]"
							texture = "gfx/interface/icons/un_icons/topic_asat.dds"
						}
						# The outer-space convention (solar colonization fleets § 13):
						# for now a copy of space cooperation's icon, under its own name.
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)33' )]"
							texture = "gfx/interface/icons/un_icons/topic_colony_protection.dds"
						}
						# Phase 7 (§0.12): each topic's icon is, for now, a copy of its
						# nearest older topic's, under its own name, so new art drops in.
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)18' )]"
							texture = "gfx/interface/icons/un_icons/topic_cultural_diversity.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)19' )]"
							texture = "gfx/interface/icons/un_icons/topic_nuclear_ban.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)20' )]"
							texture = "gfx/interface/icons/un_icons/topic_court_referral.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)21' )]"
							texture = "gfx/interface/icons/un_icons/topic_arms_embargo.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)22' )]"
							texture = "gfx/interface/icons/un_icons/topic_credentials.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)23' )]"
							texture = "gfx/interface/icons/un_icons/topic_standing_force.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)24' )]"
							texture = "gfx/interface/icons/un_icons/topic_observer_request.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)25' )]"
							texture = "gfx/interface/icons/un_icons/topic_food_reserve.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)26' )]"
							texture = "gfx/interface/icons/un_icons/topic_ceasefire.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)27' )]"
							texture = "gfx/interface/icons/un_icons/topic_development_fund.dds"
						}
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)28' )]"
							texture = "gfx/interface/icons/un_icons/topic_referendum.dds"
						}
						# §0.12a: for now a copy of International Sanctions' icon, under
						# its own name, so new art drops in.
						icon = {
							size = { 40 40 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_topic_code'), '(CFixedPoint)30' )]"
							texture = "gfx/interface/icons/un_icons/topic_lift_sanctions.dds"
						}
					}

					flowcontainer = {
						direction = vertical
						spacing = 4
						parentanchor = vcenter

						### Tally
						flowcontainer = {
							direction = horizontal
							spacing = 6
							tooltip = "je_un_tally_tt"

							widget = {
								size = { 300 18 }
								parentanchor = vcenter

								bad_progressbar_horizontal = {
									size = { 100% 100% }
									blockoverride "values" {
										value = 1
										min = 0
										max = 1
									}
								}
								white_progressbar_horizontal = {
									size = { 100% 100% }
									blockoverride "background" {}
									blockoverride "frame" {}
									blockoverride "values" {
										value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_not_no_frac') )]"
										min = 0
										max = 1
									}
								}
								green_progressbar_horizontal = {
									size = { 100% 100% }
									blockoverride "background" {}
									blockoverride "frame" {}
									blockoverride "values" {
										value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_yes_frac') )]"
										min = 0
										max = 1
									}
								}
								# two-thirds mark: expulsion and charter reform pass on two
								# thirds of the members with a vote (un_vote_supermajority_passed);
								# 200 is two thirds of the bar's 300. A thin cream line with a
								# hover of its own, as Global Warming's thresholds are (the
								# 2026-10-27 audit, UN-17; it was the eye-shaped marker the
								# style guide retired).
								icon = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_supermajority'), '(CFixedPoint)1' )]"
									size = { 3 24 }
									position = { 199 -3 }
									texture = "gfx/interface/backgrounds/white.dds"
									color = { 0.96 0.90 0.72 0.95 }
									tooltip = "je_un_tally_two_thirds_tt"
								}
							}
							textbox = {
								using = un_fontsize_row
								autoresize = yes
								parentanchor = vcenter
								align = left|nobaseline
								default_format = "#tooltippable"
								text = "je_un_tally_counts"
							}
						}
						textbox = {
							autoresize = yes
							align = left|nobaseline
							using = un_fontsize_row
							text = "[SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_supermajority'), '(CFixedPoint)1' ), 'je_un_tally_rule_super', 'je_un_tally_rule_simple' )]"
						}

						### Time in session: the report-back rule on hover (UN-3; it was a
						### line of the session card).
						flowcontainer = {
							direction = horizontal
							spacing = 6
							tooltip = "je_un_session_months_tt"

							default_progressbar_horizontal = {
								size = { 300 12 }
								parentanchor = vcenter
								blockoverride "values" {
									value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_res_months_frac') )]"
									min = 0
									max = 1
								}
							}
							textbox = {
								using = un_fontsize_row
								autoresize = yes
								parentanchor = vcenter
								align = left|nobaseline
								default_format = "#tooltippable"
								text = "je_un_session_months"
							}
						}
					}
				}
			}

			# Our ballot, under the tally (the 2026-10-27 audit, UN-2): how we
			# voted, or that our vote is due (un_disp_our_vote_code), then the
			# three vote controls, and how the Assembly reads our position, one
			# row with its terms on hover (UN-4). They followed the whole
			# session card until then, and how we had voted showed only in the
			# greyed buttons' tooltips.
			#
			# Every part is a fixed width, centred in a fixed 480: the vote
			# controls are hidden whenever no vote is open, and a centred block
			# sized by them would be centred at that empty width and spill out of
			# the panel when they appeared (gotcha #43).
			flowcontainer = {
				direction = vertical
				spacing = 4
				ignoreinvisible = yes
				parentanchor = hcenter
				minimumsize = { 480 -1 }
				visible = "[GetScriptedGui('un_session_open_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				textbox = {
					autoresize = yes
					minimumsize = { 480 -1 }
					maximumsize = { 480 -1 }
					align = hcenter|nobaseline
					using = un_fontsize_row
					text = "je_un_our_vote_line"
				}
				# ---- Our ballot ----
				# Available from the day the resolution opens; the un_vote.1 popup that
				# arrives on day 30 is the same three options and is skipped entirely
				# once a ballot is on the record (its trigger is re-evaluated when it
				# fires). One scripted GUI, one op code per control:
				#
				#   op 0  Vote in Favour    op 1  Vote Against    op 2  Veto
				#
				# The table is repeated in common/scripted_guis/un_chamber_sguis.txt;
				# keep the two in step. Each tooltip is IsValidTooltip (why the control
				# is greyed out) concatenated with ExecuteTooltip (what the vote does),
				# which is the un_vote.1 option's own consequence text, lobbying
				# keep/break line included.
				# For and Against show together (one is_shown); the veto row's two
				# slots sit under them, Veto or Confirm under For and Cancel under
				# Against: 236 + 4 + 236 = 476 whichever shows.
				flowcontainer = {
					direction = vertical
					spacing = 4
					ignoreinvisible = yes
					parentanchor = hcenter
					minimumsize = { 476 -1 }
					datacontext = "[GetScriptedGui('un_chamber_vote_sgui')]"

					flowcontainer = {
						direction = horizontal
						spacing = 4
						ignoreinvisible = yes

						un_chamber_action_button = {
							blockoverride "action_label" {
								text = "je_un_chamber_vote_yes_label"
							}
							blockoverride "action_binding" {
								visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
								enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
								onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
								tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
							}
						}

						un_chamber_action_button = {
							blockoverride "action_label" {
								text = "je_un_chamber_vote_no_label"
							}
							blockoverride "action_binding" {
								visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
								enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
								onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
								tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
							}
						}
					}

					# The veto is armed before it is cast. A scripted GUI's documented
					# confirm_title / confirm_text fields have no usage anywhere in
					# vanilla to copy, and this cannot be tested without running the
					# game, so the confirmation is built out of the expander mechanism
					# this widget already relies on: GetVariableSystem state, which is
					# client-side, never saved and never gameplay state.
					# Veto, and once armed Confirm, take turns in the slot under For;
					# Cancel has the slot under Against.
					flowcontainer = {
						direction = horizontal
						spacing = 4
						visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"

						widget = {
							size = { 236 30 }

							un_chamber_action_button = {
								blockoverride "action_label" {
									text = "je_un_chamber_vote_veto_label"
								}
								blockoverride "action_binding" {
									visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Not(GetVariableSystem.Exists('un_chamber_veto_armed')) )]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
									onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
									tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
								}
							}

							un_chamber_action_button = {
								blockoverride "action_label" {
									text = "je_un_chamber_vote_veto_confirm_label"
								}
								blockoverride "action_binding" {
									visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), GetVariableSystem.Exists('un_chamber_veto_armed') )]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
									onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
									tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
								}
							}
						}
						widget = {
							size = { 236 30 }

							button = {
								using = default_button_action
								size = { 236 30 }
								parentanchor = vcenter
								visible = "[And( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), GetVariableSystem.Exists('un_chamber_veto_armed') )]"
								onclick = "[GetVariableSystem.Toggle('un_chamber_veto_armed')]"
								tooltip = "je_un_chamber_vote_veto_cancel_tt"

								textbox = {
									parentanchor = center
									align = center|nobaseline
									autoresize = yes
									max_width = 226
									elide = right
									using = un_fontsize_row
									text = "je_un_chamber_vote_veto_cancel_label"
								}
							}
						}
					}
				}
				un_chamber_text = {
					visible = "[GetScriptedGui('un_chamber_position_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					parentanchor = hcenter
					align = hcenter|nobaseline
					default_format = "#tooltippable"
					text = "[GetScriptedGui('un_chamber_position_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
					tooltip = "[GetScriptedGui('un_chamber_position_terms_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}
			}

			te_un_sec_assembly_core = {}
			te_un_sec_delegations = {
				visible = "[GetScriptedGui('un_session_open_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			}
			te_un_sec_ballot = {
				visible = "[GetScriptedGui('un_session_open_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			}
			te_un_sec_propose = {
				visible = "[Not( GetScriptedGui('un_session_open_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
			}
		}
	}

	### Everything a returning player checks, open by default.
	type te_un_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_un_sec_assembly = {}
		te_un_sec_why = {}
		te_un_sec_missions = {}
		te_un_sec_programmes = {}
		te_un_sec_mandates = {}
		te_un_sec_obligations = {}
		te_un_sec_dev_fund = {}
		te_un_sec_exposure = {}
	}

	### "How the UN Works": every explanation, gathered out of the live sections
	### (owner, 2026-09-28) into one section, collapsed by default, one heading
	### per topic. The live sections above say what is happening; this says how
	### it works.
	type te_un_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		un_chamber_section_header = {
			blockoverride "left_text" {
				text = "je_un_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('un_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('un_how_open')]"
			}
		}

		un_chamber_panel = {
			visible = "[GetVariableSystem.Exists('un_how_open')]"

			un_chamber_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_un_how_sub_authority"
				}
			}
			te_un_help_authority = {}
			un_chamber_note = {
				text = "je_un_auth_log_intro"
			}
			un_chamber_subheader = {
				blockoverride "subheader_text" {
					text = "je_un_how_sub_standing"
				}
			}
			te_un_help_standing = {}
			un_chamber_subheader = {
				blockoverride "subheader_text" {
					text = "je_un_how_sub_missions"
				}
			}
			un_chamber_note = {
				text = "je_un_chamber_missions_intro"
			}
			un_chamber_note = {
				text = "je_un_chamber_missions_help"
			}
			un_chamber_subheader = {
				blockoverride "subheader_text" {
					text = "je_un_how_sub_delegations"
				}
			}
			un_chamber_note = {
				text = "je_un_chamber_deleg_intro"
			}
			un_chamber_note = {
				text = "je_un_chamber_reasons_intro"
			}
			un_chamber_subheader = {
				blockoverride "subheader_text" {
					text = "je_un_how_sub_dues"
				}
			}
			un_chamber_note = {
				text = "je_un_chamber_obligations_help"
			}
			un_chamber_subheader = {
				blockoverride "subheader_text" {
					text = "je_un_how_sub_record"
				}
			}
			un_chamber_note = {
				text = "je_un_chamber_exposure_help"
			}
		}
	}

	### The chart, then the record, then how it all works.
	type te_un_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_un_sec_auth_history = {}
		te_un_sec_archive = {}
		te_un_sec_how = {}
	}
}

