				}
				blockoverride "bill_sunset_visible" {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_cons_sun'), '(CFixedPoint)0' )]"
				}
				blockoverride "bill_sunset" {
					text = "te_tax_rv_bill_sun_cons"
				}
			}

			# The taxed goods, if the draft changes any: the count under
			# existing law and with the bill, then each good it changes.
			flowcontainer = {
				visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_goods_changed'), '(CFixedPoint)0' )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 1
				margin_top = 6

				# Who benefits, and for the goods what they forgo, on the name's
				# hover: the same text every time (GUI audit TAX-17).
				textbox = {
					autoresize = yes
					minimumsize = { 480 -1 }
					maximumsize = { 480 -1 }
					align = left|nobaseline
					using = te_tax_fontsize_heading
					default_format = "#title"
					text = "te_tax_en_goods_title"
					tooltip = "te_tax_rv_goods_tt"
				}
				te_tax_review_line = {
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_law"
						tooltip = "te_tax_rv_law_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_rv_goods_law"
					}
				}
				te_tax_review_line = {
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_bill"
						tooltip = "te_tax_rv_bill_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_rv_goods_bill"
					}
				}
				te_tax_rv_goods_rows = {}
			}

			# The draft's customs changes were dropped when the market was lost
			# (plan Task 15, controller ruling).
			te_tax_text = {
				visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_customs_dropped'), '(CFixedPoint)0' )]"
				text = "te_tax_rv_customs_dropped"
			}

			# Customs levels the draft changes (plan Task 15): each level, existing
			# law's in the commencement month and the bill's, and each good whose
			# level a treaty or the tariff cooldown kept (adopted into the code).
			flowcontainer = {
				visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_customs_changed'), '(CFixedPoint)0' )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 1
				margin_top = 6

				textbox = {
					autoresize = yes
					minimumsize = { 480 -1 }
					maximumsize = { 480 -1 }
					align = left|nobaseline
					using = te_tax_fontsize_heading
					default_format = "#title"
					text = "te_tax_rv_customs_header"
				}
				te_tax_text = {
					text = "te_tax_rv_customs_intro"
				}
				te_tax_rv_customs_rows = {}
			}

			# Relief the draft changes: existing law in the commencement month,
			# the bill, who benefits and what the relief forgoes.
			flowcontainer = {
				visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_agrel_on'), '(CFixedPoint)0' )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 1
				margin_top = 6

				# Who benefits, and for the goods what they forgo, on the name's
				# hover: the same text every time (GUI audit TAX-17).
				textbox = {
					autoresize = yes
					minimumsize = { 480 -1 }
					maximumsize = { 480 -1 }
					align = left|nobaseline
					using = te_tax_fontsize_heading
					default_format = "#title"
					text = "te_tax_en_agrel_title"
					tooltip = "te_tax_rv_agrel_tt"
				}
				te_tax_review_line = {
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_law"
						tooltip = "te_tax_rv_law_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_rv_agrel_law"
					}
				}
				# A passed bill that sets it (GUI audit TAX-12).
				te_tax_review_line = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pa_agrel_on'), '(CFixedPoint)0' )]"
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_passed"
						tooltip = "te_tax_rv_passed_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_pk_a_agrel"
					}
				}
				te_tax_review_line = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_agrel_on'), '(CFixedPoint)0' )]"
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_passed"
						tooltip = "te_tax_rv_passed_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_pk_b_agrel"
					}
				}
				te_tax_review_line = {
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_bill"
						tooltip = "te_tax_rv_bill_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_rv_agrel"
					}
				}
				te_tax_review_line = {
					blockoverride "line_label" {
						text = "te_tax_rv_relief_forgoes"
					}
					blockoverride "line_value" {
						text = "te_tax_rv_agrel_forgoes"
					}
				}
			}
			flowcontainer = {
				visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_regrel_on'), '(CFixedPoint)0' )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 1
				margin_top = 6

				# Who benefits, and for the goods what they forgo, on the name's
				# hover: the same text every time (GUI audit TAX-17).
				textbox = {
					autoresize = yes
					minimumsize = { 480 -1 }
					maximumsize = { 480 -1 }
					align = left|nobaseline
					using = te_tax_fontsize_heading
					default_format = "#title"
					text = "te_tax_en_regrel_title"
					tooltip = "te_tax_rv_regrel_tt"
				}
				te_tax_review_line = {
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_law"
						tooltip = "te_tax_rv_law_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_rv_regrel_law"
					}
				}
				# A passed bill that sets it (GUI audit TAX-12).
				te_tax_review_line = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pa_regrel_on'), '(CFixedPoint)0' )]"
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_passed"
						tooltip = "te_tax_rv_passed_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_pk_a_regrel"
					}
				}
				te_tax_review_line = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_regrel_on'), '(CFixedPoint)0' )]"
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_passed"
						tooltip = "te_tax_rv_passed_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_pk_b_regrel"
					}
				}
				# The states existing law names in the commencement month.
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					datamodel = "[AccessPlayer.AccessStates]"

					item = {
						textbox = {
							visible = "[NotEqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_tax_view_dr_relief_base_state'), '(CFixedPoint)0' )]"
							autoresize = yes
							minimumsize = { 480 -1 }
							maximumsize = { 480 -1 }
							margin_left = 24
							align = left|nobaseline
							using = te_tax_fontsize_row
							multiline = yes
							# A state the draft drops pays its taxes again: its estimate
							# (plan Task 14), wrapped rather than cut off. One the draft
							# keeps shows it in the bill's list.
							text = "[SelectLocalization( EqualTo_CFixedPoint( State.MakeScope.ScriptValue('te_tax_view_dr_relief_state'), '(CFixedPoint)0' ), 'te_tax_rv_regrel_state_est', 'te_tax_rv_regrel_state' )]"
						}
					}
				}
				te_tax_review_line = {
					blockoverride "line_label" {
						default_format = "#tooltippable"
						text = "te_tax_rv_bill"
						tooltip = "te_tax_rv_bill_tt"
					}
					blockoverride "line_value" {
						text = "te_tax_rv_regrel"
					}
				}
				# The states the bill names, with what each collects now and the
				# change the bill makes to it (plan Task 14).
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					datamodel = "[GetPlayer.MakeScope.GetList('te_tax_dr_relief_states')]"

					item = {
						textbox = {
							datacontext = "[Scope.GetState]"
							autoresize = yes
							minimumsize = { 480 -1 }
							maximumsize = { 480 -1 }
							margin_left = 24
							align = left|nobaseline
							using = te_tax_fontsize_row
							multiline = yes
							text = "te_tax_rv_regrel_state_est"
						}
					}
				}
				te_tax_review_line = {
					blockoverride "line_label" {
						text = "te_tax_rv_relief_forgoes"
					}
					blockoverride "line_value" {
						text = "te_tax_rv_regrel_forgoes"
					}
				}
			}

			# The revenue estimate (plan Task 14; tax_code_schema.md, "Economy
			# snapshot and estimates"): a table, one row per Budget line the draft
			# changes (GUI audit TAX-4), of today's receipts (the Budget's own
			# getter) scaled by existing law's and the draft's rates in its month
			# against the rates at the economy snapshot (te_tax_view_est_<line>_*),
			# and the change; dated, and marked out of date once the snapshot is
			# (te_tax_view_snap_current). A tax not collected at the snapshot has no
			# base and no figure. Goods and relief are labelled; regional relief's
			# figures are on its state lines above.
			flowcontainer = {
				visible = "[Not( And( And( And( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_provisions'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_goods_changed'), '(CFixedPoint)0' ) ), EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_relief_changed'), '(CFixedPoint)0' ) ), EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_customs_changed'), '(CFixedPoint)0' ) ) )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 1

				te_tax_subheader = {
					blockoverride "subheader_text" {
						text = "te_tax_est_header"
						tooltip = "te_tax_est_header_tt"
					}
				}
				te_tax_text = {
					# Before the first snapshot (a new country's first month) there is
					# no date to print and no base to scale.
					text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_snap_month'), '(CFixedPoint)-1' ), 'te_tax_est_none', SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_snap_current'), '(CFixedPoint)1' ), 'te_tax_est_static', 'te_tax_est_stale' ) )]"
					tooltip = "te_tax_est_header_tt"
					default_format = "#tooltippable"
				}
				# The table's heads, the cells of te_tax_estimate_row. A line with no
				# base prints a dash, and why on its hover.
				te_tax_estimate_row = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_snap_month'), '(CFixedPoint)-1' )]"
					blockoverride "est_label" {
						text = "te_tax_est_col_line"
					}
					blockoverride "est_law" {
						default_format = "#tooltippable"
						text = "te_tax_est_col_law"
						tooltip = "te_tax_rv_law_tt"
					}
					blockoverride "est_bill" {
						default_format = "#tooltippable"
						text = "te_tax_est_col_bill"
						tooltip = "te_tax_rv_bill_tt"
					}
					blockoverride "est_delta" {
						text = "te_tax_est_col_delta"
					}
				}
				te_tax_estimate_row = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_income_on'), '(CFixedPoint)0' )]"
					tooltip = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_income_nobase'), '(CFixedPoint)1' ), 'te_tax_est_nobase', 'te_tax_est_ch_income_tt' )]"
					blockoverride "est_label" {
						default_format = "#tooltippable"
						text = "te_tax_est_ch_income"
					}
					blockoverride "est_law" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_income_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_income_law' )]"
					}
					blockoverride "est_bill" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_income_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_income_bill' )]"
					}
					blockoverride "est_delta" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_income_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_income_delta' )]"
					}
				}
				te_tax_estimate_row = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_dividends_on'), '(CFixedPoint)0' )]"
					tooltip = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_dividends_nobase'), '(CFixedPoint)1' ), 'te_tax_est_nobase', 'te_tax_est_ch_dividends_tt' )]"
					blockoverride "est_label" {
						default_format = "#tooltippable"
						text = "te_tax_est_ch_dividends"
					}
					blockoverride "est_law" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_dividends_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_dividends_law' )]"
					}
					blockoverride "est_bill" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_dividends_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_dividends_bill' )]"
					}
					blockoverride "est_delta" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_dividends_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_dividends_delta' )]"
					}
				}
				te_tax_estimate_row = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_poll_on'), '(CFixedPoint)0' )]"
					tooltip = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_poll_nobase'), '(CFixedPoint)1' ), 'te_tax_est_nobase', 'te_tax_est_ch_poll_tt' )]"
					blockoverride "est_label" {
						default_format = "#tooltippable"
						text = "te_tax_est_ch_poll"
					}
					blockoverride "est_law" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_poll_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_poll_shared'), '(CFixedPoint)1' ), 'te_tax_est_poll_law_range', 'te_tax_est_poll_law' ) )]"
					}
					blockoverride "est_bill" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_poll_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_poll_shared'), '(CFixedPoint)1' ), 'te_tax_est_poll_bill_range', 'te_tax_est_poll_bill' ) )]"
					}
					blockoverride "est_delta" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_poll_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_poll_shared'), '(CFixedPoint)1' ), 'te_tax_est_poll_delta_range', 'te_tax_est_poll_delta' ) )]"
					}
				}
				te_tax_estimate_row = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_consumption_on'), '(CFixedPoint)0' )]"
					tooltip = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_consumption_nobase'), '(CFixedPoint)1' ), 'te_tax_est_nobase', 'te_tax_est_ch_consumption_tt' )]"
					blockoverride "est_label" {
						default_format = "#tooltippable"
						text = "te_tax_est_ch_consumption"
					}
					blockoverride "est_law" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_consumption_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_consumption_law' )]"
					}
					blockoverride "est_bill" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_consumption_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_consumption_bill' )]"
					}
					blockoverride "est_delta" {
						text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_est_consumption_nobase'), '(CFixedPoint)1' ), 'te_tax_est_dash', 'te_tax_est_consumption_delta' )]"
					}
				}
				te_tax_text = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_goods_changed'), '(CFixedPoint)0' )]"
					text = "te_tax_est_goods"
				}
				te_tax_text = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_customs_changed'), '(CFixedPoint)0' )]"
					text = "te_tax_est_customs"
				}
				te_tax_text = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_agrel_on'), '(CFixedPoint)0' )]"
					text = "te_tax_est_agrel"
				}
				te_tax_text = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_regrel_on'), '(CFixedPoint)0' )]"
					text = "te_tax_est_regrel"
				}
			}
		}
	}
}
