### Legislated Tax Code — the review (plan Task 8; docs/systems/tax_code_schema.md,
### "Panels"). The open draft read as law: one entry per provision it changes,
### each with the existing law's timeline (the enacted rate, its scheduled
### expiry, the passed bills that change it) above what the bill would make of
### it (its rate from the commencement month, its expiry and the rate it then
### reverts to). Changes to the baseline since the draft was written, each
### with its Accept button, are at the top of the workbench (GUI audit TAX-3).
### Collapsed until opened: the summary's Review button opens it.
###
### "Then reverts to" is te_tax_succ_dr_<key>, the scheduler's rule at the
### draft's commencement month: the pending successor if the tax has an
### expiry pending then, else the rate in force; commencement decides it again
### (rule 3), so the line is a preview. A passed bill the scheduler holds
### (state 2 conflict, 3 missed) says so on its line, as it will not commence
### as shown. Rows read only guarded views of the player's draft and passed
### bills (te_tax_view_dr_*, te_tax_view_p<s>_*); a package's pending relief
### marks are never shown. Relief entries also say who benefits, on the
### provision's name (the fixed text, GUI audit TAX-17), and what revenue the
### relief forgoes, in the words the capability ledger verified (agricultural
### relief: the wage tax of agricultural workers; regional relief: every tax
### collected from the named states' pops).
###
### Customs levels (plan Task 15) come after the goods: each changed level
### and each good a treaty or the tariff cooldown blocked. They have no
### revenue estimate (tariff receipts depend on trade volumes).
###
### The revenue estimate (plan Task 14) closes the review: a table, one row per
### Budget line the draft changes (GUI audit TAX-4), of today's receipts scaled
### by existing law's and the draft's rates against the economy snapshot's
### (te_tax_take_snapshot, never run from a panel), and the change; labelled a
### static estimate and marked once out of date. Its sum is the draft
### summary's Revenue row.

types te_tax_review_widget_types
{
	### A line of an entry: a label, then its text, which may wrap.
	### 4 + 200 + 272 + 4 = 480. The label holds the longest catalog good name
	### at 17 (test_tax_code_layout.py); an instance whose label has a hover sets
	### default_format = "#tooltippable" itself, so a label without one is
	### never drawn as hoverable.
	type te_tax_review_line = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		margin = { 4 1 }
		block "line_visible" {}

		textbox = {
			minimumsize = { 200 -1 }
			maximumsize = { 200 -1 }
			autoresize = yes
			align = left|nobaseline
			using = te_tax_fontsize_row
			elide = right
			block "line_label" {}
		}
		textbox = {
			minimumsize = { 272 -1 }
			maximumsize = { 272 -1 }
			autoresize = yes
			multiline = yes
			align = left|nobaseline
			using = te_tax_fontsize_row
			block "line_value" {}
		}
	}

	### A good the draft changes (the generated te_tax_rv_goods_rows).
	type te_tax_review_good_line = te_tax_review_line {}

	### A customs level the draft changes (the generated te_tax_rv_customs_rows,
	### plan Task 15): the good, imports or exports, existing law's level in the
	### commencement month, and the bill's. Each level cell holds seven
	### te_tax_cu_level_icon, one shown (GUI audit TAX-26).
	### 4 + 200 + 4 + 70 + 4 + 30 + 4 + 10 + 4 + 30 + 4 = 364; the name cell
	### holds the longest customs good at 17.
	type te_tax_review_customs_line = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		widget = {
			size = { 200 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 200
				elide = right
				align = left|nobaseline
				using = te_tax_fontsize_row
				block "good_name" {}
			}
		}
		widget = {
			size = { 70 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 70
				elide = right
				align = left|nobaseline
				using = te_tax_fontsize_row
				block "direction" {}
			}
		}
		widget = {
			size = { 30 26 }
			block "law_level" {}
		}
		widget = {
			size = { 10 26 }
			textbox = {
				parentanchor = center
				autoresize = yes
				align = center|nobaseline
				using = te_tax_fontsize_row
				text = "te_tax_wb_arrow"
			}
		}
		widget = {
			size = { 30 26 }
			block "bill_level" {}
		}
	}

	### A row of the Revenue Estimate (GUI audit TAX-4): the Budget line, its
	### receipts a week under existing law and with the bill, and the change.
	### 4 + 104 + 4 + 114 + 4 + 110 + 4 + 128 + 4 = 476. A figure holds "99.9K",
	### a range "99.9K–99.9K" and a change "+99.9K–+99.9K", each with the money icon.
	type te_tax_estimate_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		widget = {
			size = { 104 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 104
				elide = right
				align = left|nobaseline
				using = te_tax_fontsize_row
				block "est_label" {}
			}
		}
		widget = {
			size = { 114 26 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 114
				elide = right
				align = right|nobaseline
				using = te_tax_fontsize_row
				block "est_law" {}
			}
		}
		widget = {
			size = { 110 26 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 110
				elide = right
				align = right|nobaseline
				using = te_tax_fontsize_row
				block "est_bill" {}
			}
		}
		widget = {
			size = { 128 26 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 128
				elide = right
				align = right|nobaseline
				using = te_tax_fontsize_row
				block "est_delta" {}
			}
		}
	}

	### One provision: its name, then the existing law's timeline and the
	### bill's. The instance fills the blocks and gates the optional lines
	### (each line's "line_visible" block, overridden here by a block of the
	### provision's own, so the instance reaches it).
	type te_tax_review_provision = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		margin_top = 6

		textbox = {
			autoresize = yes
			minimumsize = { 480 -1 }
			maximumsize = { 480 -1 }
			align = left|nobaseline
			using = te_tax_fontsize_heading
			default_format = "#title"
			block "provision_name" {}
		}
		te_tax_review_line = {
			blockoverride "line_label" {
				default_format = "#tooltippable"
				text = "te_tax_rv_law"
				tooltip = "te_tax_rv_law_tt"
			}
			blockoverride "line_value" {
				block "law_now" {}
			}
		}
		te_tax_review_line = {
			blockoverride "line_visible" {
				block "law_sunset_visible" {}
			}
			blockoverride "line_value" {
				block "law_sunset" {}
			}
		}
		te_tax_review_line = {
			blockoverride "line_visible" {
				block "law_pa_visible" {}
			}
			blockoverride "line_label" {
				default_format = "#tooltippable"
				text = "te_tax_rv_passed"
				tooltip = "te_tax_rv_passed_tt"
			}
			blockoverride "line_value" {
				block "law_pa" {}
			}
		}
		te_tax_review_line = {
			blockoverride "line_visible" {
				block "law_pb_visible" {}
			}
			blockoverride "line_label" {
				default_format = "#tooltippable"
				text = "te_tax_rv_passed"
				tooltip = "te_tax_rv_passed_tt"
			}
			blockoverride "line_value" {
				block "law_pb" {}
			}
		}
		te_tax_review_line = {
			blockoverride "line_label" {
				default_format = "#tooltippable"
				text = "te_tax_rv_bill"
				tooltip = "te_tax_rv_bill_tt"
			}
			blockoverride "line_value" {
				block "bill_value" {}
			}
		}
		te_tax_review_line = {
			blockoverride "line_visible" {
				block "bill_sunset_visible" {}
			}
			blockoverride "line_value" {
				block "bill_sunset" {}
			}
		}
	}

	### A moved baseline: what changed, and Accept (te_tax_cmd_draft_rebase_sgui,
	### whose op the instance's button names). 4 + 372 + 4 + 96 + 4 = 480.
	type te_tax_rebase_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		textbox = {
			minimumsize = { 372 -1 }
			maximumsize = { 372 -1 }
			autoresize = yes
			multiline = yes
			parentanchor = vcenter
			align = left|nobaseline
			using = te_tax_fontsize_row
			block "rebase_text" {}
		}
		block "rebase_button" {}
	}

	### ======================================================================
	### REVIEW (collapsed until opened; the summary's Review button opens it)
	### ======================================================================
	type te_tax_review_section = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('te_tax_show_draft_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

		te_tax_section_header = {
			blockoverride "left_text" {
				text = "te_tax_rv_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_tax_review_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_tax_review_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_tax_review_open')]"
			}
		}

		te_tax_panel = {
			visible = "[GetVariableSystem.Exists('te_tax_review_open')]"

			# Nothing changed yet.
			te_tax_text = {
				visible = "[And( And( And( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_provisions'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_goods_changed'), '(CFixedPoint)0' ) ), EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_relief_changed'), '(CFixedPoint)0' ) ), EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_customs_changed'), '(CFixedPoint)0' ) )]"
				text = "te_tax_rv_nothing"
			}

			# One entry per tax the draft changes.
			te_tax_review_provision = {
				visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_wage_on'), '(CFixedPoint)0' )]"
				blockoverride "provision_name" {
					text = "te_tax_inst_wage"
				}
				blockoverride "law_now" {
					text = "te_tax_rv_now_wage"
				}
				blockoverride "law_sunset_visible" {
					visible = "[GetScriptedGui('te_tax_show_sunset_wage_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
				blockoverride "law_sunset" {
					text = "te_tax_en_sunset_wage"
				}
				blockoverride "law_pa_visible" {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pa_wage_on'), '(CFixedPoint)0' )]"
				}
				blockoverride "law_pa" {
					text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pa_state'), '(CFixedPoint)2' ), 'te_tax_pk_a_wage_conflict', SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pa_state'), '(CFixedPoint)3' ), 'te_tax_pk_a_wage_missed', SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pa_wage_exp'), '(CFixedPoint)-1' ), 'te_tax_pk_a_wage', 'te_tax_pk_a_wage_sun' ) ) )]"
				}
				blockoverride "law_pb_visible" {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_wage_on'), '(CFixedPoint)0' )]"
				}
				blockoverride "law_pb" {
					text = "[SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_state'), '(CFixedPoint)2' ), 'te_tax_pk_b_wage_conflict', SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_state'), '(CFixedPoint)3' ), 'te_tax_pk_b_wage_missed', SelectLocalization( EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_wage_exp'), '(CFixedPoint)-1' ), 'te_tax_pk_b_wage', 'te_tax_pk_b_wage_sun' ) ) )]"
				}
				blockoverride "bill_value" {
					text = "te_tax_rv_bill_wage"
				}
				blockoverride "bill_sunset_visible" {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_wage_sun'), '(CFixedPoint)0' )]"
				}
				blockoverride "bill_sunset" {
					text = "te_tax_rv_bill_sun_wage"
				}
			}
			te_tax_review_provision = {
				visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_div_on'), '(CFixedPoint)0' )]"
				blockoverride "provision_name" {
					text = "te_tax_inst_div"
				}
