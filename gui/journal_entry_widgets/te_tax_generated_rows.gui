				te_tax_cu_level_icon = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood'), '(CFixedPoint)-3' )]" texture = "gfx/interface/icons/trade_icons/max_subvention.dds" tooltip = "te_tax_cu_lv_m3" }
				te_tax_cu_level_icon = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood'), '(CFixedPoint)-2' )]" texture = "gfx/interface/icons/trade_icons/high_subvention.dds" tooltip = "te_tax_cu_lv_m2" }
				te_tax_cu_level_icon = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood'), '(CFixedPoint)-1' )]" texture = "gfx/interface/icons/trade_icons/low_subvention.dds" tooltip = "te_tax_cu_lv_m1" }
				te_tax_cu_level_icon = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood'), '(CFixedPoint)0' )]" texture = "gfx/interface/icons/trade_icons/no_tariffs_no_subvention.dds" tooltip = "te_tax_cu_lv_0" }
				te_tax_cu_level_icon = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood'), '(CFixedPoint)1' )]" texture = "gfx/interface/icons/trade_icons/low_tariffs.dds" tooltip = "te_tax_cu_lv_p1" }
				te_tax_cu_level_icon = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood'), '(CFixedPoint)2' )]" texture = "gfx/interface/icons/trade_icons/high_tariffs.dds" tooltip = "te_tax_cu_lv_p2" }
				te_tax_cu_level_icon = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood'), '(CFixedPoint)3' )]" texture = "gfx/interface/icons/trade_icons/max_tariffs.dds" tooltip = "te_tax_cu_lv_p3" }
			}
		}

		te_tax_review_line = {
			visible = "[And( NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood_blocked'), '(CFixedPoint)0' ), NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_exp_wood_on'), '(CFixedPoint)0' ) )]"
			blockoverride "line_label" {
				text = "wood"
				tooltip = "wood"
			}
			blockoverride "line_value" {
				text = "te_tax_rv_cu_blocked_exp"
			}
		}
	}
}
