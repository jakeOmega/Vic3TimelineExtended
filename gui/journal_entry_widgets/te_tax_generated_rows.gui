		direction = vertical
		ignoreinvisible = yes
		spacing = 1

		te_tax_customs_row = {
			datacontext = "[GetScriptedGui('te_tax_customs_clothes_sgui')]"
			blockoverride "good_name" {
				text = "clothes"
