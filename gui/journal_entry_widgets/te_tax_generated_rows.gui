				te_tax_cu_level_text = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_imp_clothes'), '(CFixedPoint)-3' )]" text = "te_tax_cu_lv_m3" }
