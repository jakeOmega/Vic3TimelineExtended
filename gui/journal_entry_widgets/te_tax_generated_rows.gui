	### Customs, military goods: each good's import and export level and their steppers
	### (te_tax_customs_<good>_sgui; te_tax_customs_row, te_tax_workbench_widget.gui).
	type te_tax_wb_customs_rows_military = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1

