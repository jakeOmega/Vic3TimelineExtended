	### The review's customs lines: each level the draft changes, existing law's level in the
	### draft's month and the bill's; then each good whose level a treaty or the tariff
	### cooldown kept, which the code adopted (te_tax_view_cu_<good>_blocked).
	type te_tax_rv_customs_rows = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		te_tax_review_customs_line = {
			visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_imp_advanced_materials_on'), '(CFixedPoint)0' )]"
			blockoverride "good_name" {
				text = "advanced_materials"
			}
			blockoverride "direction" {
				text = "te_tax_rv_cu_imp"
			}
			blockoverride "law_level" {
				te_tax_cu_level_text = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_imp_advanced_materials_base'), '(CFixedPoint)-3' )]" text = "te_tax_cu_lv_m3" }
				te_tax_cu_level_text = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_imp_advanced_materials_base'), '(CFixedPoint)-2' )]" text = "te_tax_cu_lv_m2" }
				te_tax_cu_level_text = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_imp_advanced_materials_base'), '(CFixedPoint)-1' )]" text = "te_tax_cu_lv_m1" }
				te_tax_cu_level_text = { visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_cu_imp_advanced_materials_base'), '(CFixedPoint)0' )]" text = "te_tax_cu_lv_0" }
