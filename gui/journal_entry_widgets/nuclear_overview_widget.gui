### Nuclear Weapons — the overview, at the top of the journal entry
### (nuclear_layout_widget.gui sets the order). What a returning player checks,
### in Banking's cells (te_banking_ov_cell, banking_dashboard_widget.gui; the
### owner's overview form of 2026-10-17, approved for this panel 2026-10-27 in
### place of the round-3 rows of icons): each a box with its icon down the left,
### the caption (a concept where the term has one), the reading's word and one
### figure, its breakdown on hover. Two to a row (238 + 4 + 238 = 480).
###
### Row 1  the crisis, while there is one: its stage and the weeks to its
###        deadline
### Row 2  the program and when its next warhead comes · warheads and the
###        world's estimate
### Row 3  doctrine and when it can next change · readiness and its upkeep
###        (while armed)
### Row 4  launch authority and when it can next change (while armed) ·
###        credibility (once there is a record)
### Row 5  the nuclear taboo: a bar with the change still to come as a pale
###        segment (no marker), the headline "62 → 68 (+0.4/mo)" and a trend
###        arrow (from the first warhead)
###
### Codes: nuclear_program_display_state (extra_script_values.txt) and
### nd_display_doctrine_code / _readiness_code / _authority_code
### (nuclear_deterrence_values.txt), each falling back the way the posture's
### name blocks do; nd_disp_taboo_step and nd_disp_taboo_trend
### (nuclear_taboo_values.txt). One icon per state, filling the cell's 44 px
### icon box. Icons are the system's own (gfx/interface/icons/nuclear_icons/,
### PR #586) but credibility's, a placeholder; what each shows is in
### docs/systems/nuclear_gui_icons.md.
###
### Type: the cell's caption is te_banking_ov_cell's own (16, the tooltip
### face); its word and figure are this file's te_nuclear_ov_word and
### te_nuclear_ov_figure at te_nuclear_fontsize_overview, the same size, in
### the cell's 154 column (test_nuclear_layout.LabelBudgetTest). The taboo
### row is at the overview size too. The frame is a fixed 480 column, so the
### rows that appear once their IsShown answers cannot widen it after it is
### centred (the play-test of 2026-09-29).

types nuclear_overview_widget_types
{
	### The overview's frame: un_chamber_panel's shape, with the rows spaced.
	type te_nuclear_ov_frame = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 8 }
		spacing = 4

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	### A cell's word, beside its icon under the caption (te_banking_ov_word's
	### place, at this panel's overview size).
	type te_nuclear_ov_word = textbox {
		position = { 78 24 }
		autoresize = yes
		max_width = 154
		elide = right
		align = left|nobaseline
		using = te_nuclear_fontsize_overview
	}

	### A cell's figure, its third line.
	type te_nuclear_ov_figure = textbox {
		position = { 78 46 }
		autoresize = yes
		max_width = 154
		elide = right
		align = left|nobaseline
		using = te_nuclear_fontsize_overview
	}

	type te_nuclear_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		visible = "[JournalEntry.IsActive]"

		te_nuclear_ov_frame = {
			### One column of a fixed 480, so the frame is a section's width from
			### its first layout and every row sits in it (see the header).
			flowcontainer = {
				direction = vertical
				spacing = 4
				ignoreinvisible = yes
				minimumsize = { 480 -1 }

				### Row 1: the crisis, while there is one.
				flowcontainer = {
					visible = "[GetScriptedGui('nd_in_crisis_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					### A crisis, while there is one: its stage, red once Acute, and the weeks to
					### its deadline, red from two weeks out (je_nuclear_ov_crisis_figure).
					te_banking_ov_cell = {
						tooltip = "je_nuclear_ov_crisis_tt"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_nuclear_ov_crisis_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/nuclear_icons/crisis.dds"
							}
						}
						blockoverride "word" {
							te_nuclear_ov_word = {
								text = "je_nuclear_ov_crisis_label"
							}
						}
						blockoverride "third_line" {
							te_nuclear_ov_figure = {
								text = "je_nuclear_ov_crisis_figure"
							}
						}
					}
				}

				### Row 2: the program and the warheads, always.
				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					### The program's state, and when its next warhead comes.
					te_banking_ov_cell = {
						tooltip = "je_nuclear_ov_prog_tt"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_nuclear_ov_prog_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)0' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_unfunded.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)1' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_developing.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)2' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_producing.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)3' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_frozen.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)4' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_at_ceiling.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)5' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_dismantling.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)6' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_none.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)7' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_renounced.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)8' )]"
								texture = "gfx/interface/icons/nuclear_icons/programme_disarmed.dds"
							}
						}
						blockoverride "word" {
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)0' )]"
								text = "je_nuclear_ov_prog_0"
							}
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)1' )]"
								text = "je_nuclear_ov_prog_1"
							}
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)2' )]"
								text = "je_nuclear_ov_prog_2"
							}
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)3' )]"
								text = "je_nuclear_ov_prog_3"
							}
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)4' )]"
								text = "je_nuclear_ov_prog_4"
							}
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)5' )]"
								text = "je_nuclear_ov_prog_5"
							}
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)6' )]"
								text = "je_nuclear_ov_prog_6"
							}
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)7' )]"
								text = "je_nuclear_ov_prog_7"
							}
							te_nuclear_ov_word = {
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)8' )]"
								text = "je_nuclear_ov_prog_8"
							}
						}
						blockoverride "third_line" {
							te_nuclear_ov_figure = {
								text = "je_nuclear_ov_prog_figure"
							}
						}
					}
					### Warheads held: our exact count, the world's estimate beneath.
					te_banking_ov_cell = {
						tooltip = "je_nuclear_ov_warheads_tt"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_nuclear_ov_warheads_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/nuclear_icons/warheads.dds"
							}
						}
						blockoverride "word" {
							te_nuclear_ov_word = {
								text = "je_nuclear_ov_warheads_label"
							}
						}
						blockoverride "third_line" {
							te_nuclear_ov_figure = {
								text = "je_nuclear_ov_warheads_figure"
							}
						}
					}
				}

				### Row 3: doctrine and readiness, while armed.
				flowcontainer = {
					visible = "[GetScriptedGui('nd_armed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					### The doctrine in force (its short name; the full one is the hover's
					### header), and when it can next change (NUC-4).
					te_banking_ov_cell = {
						tooltip = "nd_w_doctrine_tt"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_nuclear_ov_doctrine_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)1' )]"
								texture = "gfx/interface/icons/nuclear_icons/doctrine_nfu.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)2' )]"
								texture = "gfx/interface/icons/nuclear_icons/doctrine_existential.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)3' )]"
								texture = "gfx/interface/icons/nuclear_icons/doctrine_flexible.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)4' )]"
								texture = "gfx/interface/icons/nuclear_icons/doctrine_compellence.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)5' )]"
								texture = "gfx/interface/icons/nuclear_icons/doctrine_warfighting.dds"
							}
						}
						blockoverride "word" {
							te_nuclear_ov_word = {
								text = "je_nuclear_ov_doctrine_word"
							}
						}
						blockoverride "third_line" {
							te_nuclear_ov_figure = {
								text = "je_nuclear_ov_doctrine_figure"
							}
						}
					}
					### Readiness in force, and where it is moving or, when it is not, what the
					### deterrent costs a week.
					te_banking_ov_cell = {
						tooltip = "nd_w_readiness_tt"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_nuclear_ov_readiness_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_readiness_code'), '(CFixedPoint)0' )]"
								texture = "gfx/interface/icons/nuclear_icons/readiness_recessed.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_readiness_code'), '(CFixedPoint)1' )]"
								texture = "gfx/interface/icons/nuclear_icons/readiness_routine.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_readiness_code'), '(CFixedPoint)2' )]"
								texture = "gfx/interface/icons/nuclear_icons/readiness_heightened.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_readiness_code'), '(CFixedPoint)3' )]"
								texture = "gfx/interface/icons/nuclear_icons/readiness_high_alert.dds"
							}
						}
						blockoverride "word" {
							te_nuclear_ov_word = {
								text = "je_nuclear_ov_readiness_word"
							}
						}
						blockoverride "third_line" {
							te_nuclear_ov_figure = {
								text = "je_nuclear_ov_readiness_figure"
							}
						}
					}
				}

				### Row 4: launch authority (while armed) and credibility (once there is a
				### record). A row with one cell keeps it in the left column.
				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					### Launch authority in force, and when it can next change.
					te_banking_ov_cell = {
						visible = "[GetScriptedGui('nd_armed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "nd_w_authority_tt"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_nuclear_ov_authority_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_authority_code'), '(CFixedPoint)1' )]"
								texture = "gfx/interface/icons/nuclear_icons/authority_central.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_authority_code'), '(CFixedPoint)2' )]"
								texture = "gfx/interface/icons/nuclear_icons/authority_delegation.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_authority_code'), '(CFixedPoint)3' )]"
								texture = "gfx/interface/icons/nuclear_icons/authority_on_warning.dds"
							}
							icon = {
								size = { 100% 100% }
								visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_authority_code'), '(CFixedPoint)4' )]"
								texture = "gfx/interface/icons/nuclear_icons/authority_automatic.dds"
							}
						}
						blockoverride "word" {
							te_nuclear_ov_word = {
								text = "je_nuclear_ov_authority_word"
							}
						}
						blockoverride "third_line" {
							te_nuclear_ov_figure = {
								text = "je_nuclear_ov_authority_figure"
							}
						}
					}
					### Credibility, once there is a record: a word for it, the figure beneath.
					### Its icon is a placeholder (docs/systems/nuclear_gui_icons.md).
					te_banking_ov_cell = {
						visible = "[GetScriptedGui('nd_has_reputation_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "nd_w_credibility_tt"
						size = { 238 70 }
						blockoverride "caption_width" {
							max_width = 154
						}
						blockoverride "caption" {
							text = "je_nuclear_ov_credibility_caption"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/nuclear_guarantee.dds"
							}
						}
						blockoverride "word" {
							te_nuclear_ov_word = {
								text = "je_nuclear_ov_credibility_word"
							}
						}
						blockoverride "third_line" {
							te_nuclear_ov_figure = {
								text = "je_nuclear_ov_credibility_label"
							}
						}
					}
				}

				### Row 5: the nuclear taboo, heading for its target. The hover is the
				### taboo section's own (what the score is and the target's breakdown),
				### then a line on what the bar shows.
				###
				### THE BAR (play-test round 3, 2026-09-30): the projection bar shared
				### with Global Warming, in one fixed 170 x 18 cell, bottom to top: the
				### bar's background and frame (default_progressbar_horizontal at 0);
				### the change still to come, to the higher of the score and its target,
				### in the bar's own fill at 40% (a wrapper widget, alpha 0.4); and the
				### solid fill to the lower of the two (nd_disp_taboo_bar_low / _high).
				### The change is coloured neutral, not green or red, because the taboo
				### is two-sided for the player: a stronger taboo weighs on an arsenal
				### and on threats, and shields the unarmed. The arrow says which way it
				### is going. No eye marker, and no threshold line: the bar never had one.
				###
				### Fixed cells, 60 + 170 + 190 + 24 and three 8 px gaps = 468, at the
				### overview size: the label is the concept's short name ("Taboo"; its
				### hover names the Nuclear Taboo), and the headline fits
				### "100 → 100 (+1.00/mo)".
				flowcontainer = {
					direction = horizontal
					spacing = 8
					ignoreinvisible = yes
					parentanchor = hcenter
					margin_top = 4
					visible = "[GetScriptedGui('nd_taboo_exists_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "[Concatenate( Localize( 'je_nuclear_program_widget_taboo_score_tt' ), Concatenate( GetScriptedGui('nd_taboo_breakdown_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_nuclear_ov_taboo_bar_tt' ) ) ) )]"

					textbox = {
						autoresize = yes
						minimumsize = { 60 -1 }
						maximumsize = { 60 -1 }
						parentanchor = vcenter
						align = left|nobaseline
						using = te_nuclear_fontsize_overview
						elide = right
						text = "je_nuclear_ov_taboo_label"
					}
					widget = {
						size = { 170 18 }
						parentanchor = vcenter

						# 1. Background and frame.
						default_progressbar_horizontal = {
							size = { 100% 100% }
							blockoverride "values" {
								value = 0
								min = 0
								max = 100
							}
						}
						# 2. The change still to come, either way: the bar's own fill, pale (neutral).
						widget = {
							size = { 100% 100% }
							alpha = 0.4

							default_progressbar_horizontal = {
								size = { 100% 100% }
								blockoverride "background" {}
								blockoverride "frame" {}
								blockoverride "values" {
									value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_bar_high') )]"
									min = 0
									max = 100
								}
							}
						}
						# 3. Solid: the lower of the score and its target.
						default_progressbar_horizontal = {
							size = { 100% 100% }
							blockoverride "background" {}
							blockoverride "frame" {}
							blockoverride "values" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_bar_low') )]"
								min = 0
								max = 100
							}
						}
					}
					textbox = {
						autoresize = yes
						minimumsize = { 190 -1 }
						maximumsize = { 190 -1 }
						parentanchor = vcenter
						align = left|nobaseline
						using = te_nuclear_fontsize_overview
						elide = right
						text = "je_nuclear_ov_taboo_value"
					}
					widget = {
						size = { 24 24 }
						parentanchor = vcenter

						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_trend'), '(CFixedPoint)1' )]"
							texture = "gfx/interface/icons/generic_icons/trend_up.dds"
						}
						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_trend'), '(CFixedPoint)-1' )]"
							texture = "gfx/interface/icons/generic_icons/trend_down.dds"
						}
						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_trend'), '(CFixedPoint)0' )]"
							texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
						}
					}
				}
			}
		}
	}
}
