### Nuclear Weapons — the overview, at the top of the journal entry
### (nuclear_layout_widget.gui sets the order). A glance for the player who
### knows the system: is the programme running, how many warheads, is there a
### crisis, how is our word taken, what posture are we in, and where the
### nuclear taboo is heading. Every figure is a display script value; every
### tooltip is text the panel or the status line already carried.
###
### Row 1  programme · warheads · crisis (while in one) · credibility (once
###        there is a record)
### Row 2  doctrine · readiness · launch authority (while armed)
### Row 3  the nuclear taboo: a bar with a tick at its target, the headline
###        "62 → 68 (+0.4/mo)" and a trend arrow (from the first warhead)
###
### Codes: nuclear_program_display_state (extra_script_values.txt) and
### nd_display_doctrine_code / _readiness_code / _authority_code
### (nuclear_deterrence_values.txt), each falling back the way the status
### line and the posture's name blocks do; nd_disp_taboo_step and
### nd_disp_taboo_trend (nuclear_taboo_values.txt). Every icon is a
### placeholder, one widget per state so that the finished art is one path
### change each: docs/systems/nuclear_gui_icons.md lists them.
###
### Cells have a fixed width (style guide rule 8), so a long word cannot push
### its neighbours off-centre. The rows sit in one column of a fixed 480
### (the frame's 520 less its margins, a section's width), and every row
### fits inside it: row 1 up to 4 x 110 + 3 x 6 = 458, row 2 3 x 150 + 2 x 6
### = 462, row 3 104 + 170 + 146 + 24 + 3 x 8 = 468. Before the play-test of
### 2026-09-29 the frame took its width from the rows, and rows 2 and 3,
### which appear once their IsShown answers, widened it after it had been
### centred: the overview drew ~80 px left of the column, clipped.

types nuclear_overview_widget_types
{
	### The overview's frame: un_chamber_panel's shape, with the rows spaced.
	type te_nuclear_ov_frame = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 8 }
		spacing = 10

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	### A cell of row 1: an icon, its word small beneath (te_un_ov_icon_label's
	### shape). Fixed width, so the row cannot push the panel wider.
	type te_nuclear_ov_icon_label = widget {
		size = { 110 58 }

		icon = {
			size = { 36 36 }
			parentanchor = top|hcenter
			block "icon_texture" {}
		}
		textbox = {
			parentanchor = bottom|hcenter
			autoresize = yes
			max_width = 108
			elide = right
			align = hcenter|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			block "label" {}
		}
	}

	### A cell of row 2, wider: the posture's names run to 22 letters
	### ("Existential Deterrence", "Conditional Delegation", about 135 px
	### at this size in game).
	type te_nuclear_ov_posture_cell = widget {
		size = { 150 58 }

		icon = {
			size = { 36 36 }
			parentanchor = top|hcenter
			block "icon_texture" {}
		}
		textbox = {
			parentanchor = bottom|hcenter
			autoresize = yes
			max_width = 148
			elide = right
			align = hcenter|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			block "label" {}
		}
	}

	type te_nuclear_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		visible = "[JournalEntry.IsActive]"

		te_nuclear_ov_frame = {
			### One column of a fixed 480, so the frame is a section's width from
			### its first layout and every row is centred in it (see the header).
			flowcontainer = {
				direction = vertical
				spacing = 10
				ignoreinvisible = yes
				minimumsize = { 480 -1 }

				### Row 1: programme · warheads · crisis · credibility
				flowcontainer = {
					direction = horizontal
					spacing = 6
					ignoreinvisible = yes
					parentanchor = hcenter

					### The programme's state, the status line's programme sentence on hover.
					flowcontainer = {
						ignoreinvisible = yes
						tooltip = "je_nuclear_ov_prog_tt"
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)0' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/generic_icons/paused.dds"
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_0"
							}
						}
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)1' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/invention_icons/nuclear_weapons.dds"
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_1"
							}
						}
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)2' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/event_icons/mushroom_cloud.dds"
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_2"
							}
						}
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)3' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/nuclear_program_pause.dds"
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_3"
							}
						}
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)4' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/nuclear_arms_limitation.dds"
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_4"
							}
						}
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)5' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/nuclear_disarmament.dds"
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_5"
							}
						}
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)6' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/invention_icons/nuclear_weapons.dds"
								alpha = 0.3
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_6"
							}
						}
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)7' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/nuclear_disarmament.dds"
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_7"
							}
						}
						te_nuclear_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nuclear_program_display_state'), '(CFixedPoint)8' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/nuclear_disarmament.dds"
								alpha = 0.3
							}
							blockoverride "label" {
								text = "je_nuclear_ov_prog_8"
							}
						}
					}
					### Warheads held: our exact count; the world's estimate on hover.
					te_nuclear_ov_icon_label = {
						tooltip = "je_nuclear_ov_warheads_tt"
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/invention_icons/guided_missiles.dds"
						}
						blockoverride "label" {
							text = "je_nuclear_ov_warheads_label"
						}
					}
					### A crisis, while there is one: its stage beneath.
					te_nuclear_ov_icon_label = {
						visible = "[GetScriptedGui('nd_in_crisis_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "je_nuclear_ov_crisis_tt"
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/diplomatic_action_icons/nd_nuclear_ultimatum_action.dds"
						}
						blockoverride "label" {
							text = "je_nuclear_ov_crisis_label"
						}
					}
					### Credibility, once there is a record: a meter (the UN standing cell's shape).
					widget = {
						size = { 110 58 }
						visible = "[GetScriptedGui('nd_has_reputation_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "nd_w_credibility_tt"

						textbox = {
							parentanchor = bottom|hcenter
							autoresize = yes
							align = hcenter|nobaseline
							using = fontsize_small
							default_format = "#tooltippable"
							text = "je_nuclear_ov_credibility_label"
						}
						default_progressbar_horizontal = {
							size = { 96 12 }
							parentanchor = top|hcenter
							position = { 0 12 }
							blockoverride "values" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_credibility') )]"
								min = 0
								max = 100
							}
						}
					}
				}

				### Row 2: the posture, while armed. Each cell's tooltip is the posture
				### row's own (what the axis is); the choices are under Nuclear Posture.
				flowcontainer = {
					direction = horizontal
					spacing = 6
					ignoreinvisible = yes
					parentanchor = hcenter
					visible = "[GetScriptedGui('nd_armed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					flowcontainer = {
						ignoreinvisible = yes
						tooltip = "nd_w_doctrine_tt"
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)1' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/crisis_resolution.dds"
							}
							blockoverride "label" {
								text = "nd_doctrine_1"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)2' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_treaties_articles_icons/nuclear_guarantee.dds"
							}
							blockoverride "label" {
								text = "nd_doctrine_2"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)3' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_action_icons/nd_nuclear_warning_action.dds"
							}
							blockoverride "label" {
								text = "nd_doctrine_3"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)4' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/diplomatic_action_icons/nd_nuclear_ultimatum_action.dds"
							}
							blockoverride "label" {
								text = "nd_doctrine_4"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)5' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/invention_icons/tactical_nuclear_weapons.dds"
							}
							blockoverride "label" {
								text = "nd_doctrine_5"
							}
						}
					}
					flowcontainer = {
						ignoreinvisible = yes
						tooltip = "nd_w_readiness_tt"
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_readiness_code'), '(CFixedPoint)0' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/buttons/button_icons/lock.dds"
							}
							blockoverride "label" {
								text = "nd_readiness_0"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_readiness_code'), '(CFixedPoint)1' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/commander_order_icons/standby.dds"
							}
							blockoverride "label" {
								text = "nd_readiness_1"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_readiness_code'), '(CFixedPoint)2' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/generic_icons/warning.dds"
							}
							blockoverride "label" {
								text = "nd_readiness_2"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_readiness_code'), '(CFixedPoint)3' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/generic_icons/mobilize_icon_single.dds"
							}
							blockoverride "label" {
								text = "nd_readiness_3"
							}
						}
					}
					flowcontainer = {
						ignoreinvisible = yes
						tooltip = "nd_w_authority_tt"
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_authority_code'), '(CFixedPoint)1' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/generic_icons/government_building_icon.dds"
							}
							blockoverride "label" {
								text = "nd_authority_1"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_authority_code'), '(CFixedPoint)2' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/generic_icons/most_senior_front_commander.dds"
							}
							blockoverride "label" {
								text = "nd_authority_2"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_authority_code'), '(CFixedPoint)3' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/lens_toolbar_icons/nd_nuclear_warning_action.dds"
							}
							blockoverride "label" {
								text = "nd_authority_3"
							}
						}
						te_nuclear_ov_posture_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_authority_code'), '(CFixedPoint)4' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/generic_icons/observer_mode_icon.dds"
							}
							blockoverride "label" {
								text = "nd_authority_4"
							}
						}
					}
				}

				### Row 3: the nuclear taboo, heading for its target (the marker
				### technique of the UN overview's authority bar). The hover is the taboo
				### section's own: what the score is and the target's breakdown.
				flowcontainer = {
					direction = horizontal
					spacing = 8
					ignoreinvisible = yes
					parentanchor = hcenter
					visible = "[GetScriptedGui('nd_taboo_exists_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "[Concatenate( Localize( 'je_nuclear_program_widget_taboo_score_tt' ), GetScriptedGui('nd_taboo_breakdown_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"

					textbox = {
						autoresize = yes
						minimumsize = { 104 -1 }
						maximumsize = { 104 -1 }
						parentanchor = vcenter
						align = left|nobaseline
						elide = right
						text = "je_nuclear_ov_taboo_label"
					}
					default_progressbar_horizontal = {
						size = { 170 18 }
						parentanchor = vcenter
						blockoverride "values" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo') )]"
							min = 0
							max = 100
						}
						blockoverride "on_top_of_the_progressbar" {
							progressbar = {
								noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								size = { 100% 100% }
								skip_initial_animation = yes
								direction = horizontal
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_target') )]"
								min = 0
								max = 100
								marker = {
									icon = {
										size = { 36 20 }
										parentanchor = vcenter
										widgetanchor = center
										texture = "gfx/interface/progressbar/progressbar_marker.dds"
									}
								}
							}
						}
					}
					textbox = {
						autoresize = yes
						minimumsize = { 146 -1 }
						maximumsize = { 146 -1 }
						parentanchor = vcenter
						align = left|nobaseline
						elide = right
						text = "je_nuclear_ov_taboo_value"
					}
					widget = {
						size = { 24 24 }
						parentanchor = vcenter

						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_trend'), '(CFixedPoint)1' )]"
							texture = "gfx/interface/icons/generic_icons/trend_up.dds"
						}
						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_trend'), '(CFixedPoint)-1' )]"
							texture = "gfx/interface/icons/generic_icons/trend_down.dds"
						}
						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_disp_taboo_trend'), '(CFixedPoint)0' )]"
							texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
						}
					}
				}
			}
		}
	}
}
