				visible = "[EqualTo_CFixedPoint( ArticleDraft.GetFirstOrSource.MakeScope.ScriptValue('sr_cede_held_haumea'), '(CFixedPoint)1' )]"
			}

			te_sr_cede_site_tile = {
				datacontext = "[GetBuildingType('building_sr_site_sedna')]"
				visible = "[EqualTo_CFixedPoint( ArticleDraft.GetFirstOrSource.MakeScope.ScriptValue('sr_cede_held_sedna'), '(CFixedPoint)1' )]"
			}
		}
	}
}
