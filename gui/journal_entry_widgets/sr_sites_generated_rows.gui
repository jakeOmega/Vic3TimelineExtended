	type te_sr_cede_site_list_war = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 5

		flowcontainer = {
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 5

			te_sr_cede_site_tile = {
				datacontext = "[GetBuildingType('building_sr_site_shackleton')]"
				visible = "[EqualTo_CFixedPoint( WarGoalDraft.GetTarget.MakeScope.ScriptValue('sr_cede_held_shackleton'), '(CFixedPoint)1' )]"
			}

			te_sr_cede_site_tile = {
				datacontext = "[GetBuildingType('building_sr_site_peary')]"
				visible = "[EqualTo_CFixedPoint( WarGoalDraft.GetTarget.MakeScope.ScriptValue('sr_cede_held_peary'), '(CFixedPoint)1' )]"
			}

			te_sr_cede_site_tile = {
				datacontext = "[GetBuildingType('building_sr_site_tranquility')]"
				visible = "[EqualTo_CFixedPoint( WarGoalDraft.GetTarget.MakeScope.ScriptValue('sr_cede_held_tranquility'), '(CFixedPoint)1' )]"
			}
		}

		flowcontainer = {
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 5

			te_sr_cede_site_tile = {
				datacontext = "[GetBuildingType('building_sr_site_marius_hills')]"
				visible = "[EqualTo_CFixedPoint( WarGoalDraft.GetTarget.MakeScope.ScriptValue('sr_cede_held_marius_hills'), '(CFixedPoint)1' )]"
			}

			te_sr_cede_site_tile = {
				datacontext = "[GetBuildingType('building_sr_site_daedalus')]"
				visible = "[EqualTo_CFixedPoint( WarGoalDraft.GetTarget.MakeScope.ScriptValue('sr_cede_held_daedalus'), '(CFixedPoint)1' )]"
			}

