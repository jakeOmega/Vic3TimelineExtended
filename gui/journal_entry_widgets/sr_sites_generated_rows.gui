			}
			blockoverride "eb_away_visible" {
				visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_serve_sedna'), '(CFixedPoint)1' ), GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_away_sedna'), '(CFixedPoint)0' ) )]"
			}
			blockoverride "eb_blockaded_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_serve_sedna'), '(CFixedPoint)1' )]"
			}
			blockoverride "eb_occupied_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_serve_sedna'), '(CFixedPoint)2' )]"
			}
			blockoverride "eb_away" {
				raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_away_sedna')|0]#!"
			}
			blockoverride "eb_levels" {
				raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_at_sedna')|0]#! / [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_ebase_room_sedna')|0]"
			}
			blockoverride "eb_target" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_arrow_sedna'), '(CFixedPoint)1' )]"
				raw_text = "→ [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_target_sedna')|0]"
			}
			blockoverride "eb_minus" {
				enabled = "[GetScriptedGui('sr_ebase_assign_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
				onclick = "[GetScriptedGui('sr_ebase_assign_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
				onrightclick = "[GetScriptedGui('sr_ebase_assign_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
				tooltip = "[Concatenate( GetScriptedGui('sr_ebase_assign_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Concatenate( GetScriptedGui('sr_ebase_assign_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_space_race_widget_eb_step_tt' ) ) ) ) )]"
			}
			blockoverride "eb_plus" {
				enabled = "[GetScriptedGui('sr_ebase_assign_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				onclick = "[GetScriptedGui('sr_ebase_assign_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				onrightclick = "[GetScriptedGui('sr_ebase_assign_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
				tooltip = "[Concatenate( GetScriptedGui('sr_ebase_assign_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Concatenate( GetScriptedGui('sr_ebase_assign_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)34' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_space_race_widget_eb_step_tt' ) ) ) ) )]"
			}
