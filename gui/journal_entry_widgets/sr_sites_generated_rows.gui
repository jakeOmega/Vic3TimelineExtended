		te_sr_colony_row = {
			blockoverride "colony_visible" {
				visible = "[Or( And( Not( GetVariableSystem.HasValue('sr_colony_view', 'detail') ), Or( And( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_olympus_mons'), '(CFixedPoint)1' ) ), And( Not( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ) ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_olympus_mons'), '(CFixedPoint)1' ) ) ) ), And( GetVariableSystem.HasValue('sr_colony_view', 'detail'), And( GetVariableSystem.HasValue('sr_colony_focus', 'olympus_mons'), Or( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_olympus_mons'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_olympus_mons'), '(CFixedPoint)1' ) ) ) ) )]"
