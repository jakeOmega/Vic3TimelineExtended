		te_sr_colony_row = {
			blockoverride "colony_visible" {
				visible = "[Or( And( Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'bases') ) ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_titania'), '(CFixedPoint)1' ) ), And( Not( Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'bases') ) ) ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_titania'), '(CFixedPoint)1' ) ) )]"
			}
			blockoverride "colony_focus" {
				onclick = "[GetVariableSystem.Set('sr_colony_focus', 'titania')]"
				onclick = "[GetVariableSystem.Set('te_popup', 'sr_colony')]"
			}
			blockoverride "colony_icon" {
				texture = "gfx/interface/icons/space_race_icons/colony_uranian.dds"
