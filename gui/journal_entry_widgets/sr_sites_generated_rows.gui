	type te_sr_colony_pages = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		te_sr_colony_page = {
			blockoverride "page_visible" {
				visible = "[And( GetVariableSystem.HasValue('sr_colony_focus', 'shackleton'), Or( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_shackleton'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_shackleton'), '(CFixedPoint)1' ) ) )]"
			}
			blockoverride "page_place" {
				text = "je_space_race_widget_ss_loc_earth"
			}
			blockoverride "colony_icon" {
				texture = "gfx/interface/icons/space_race_icons/colony_moon.dds"
			}
			blockoverride "colony_name" {
				text = "sr_site_name_shackleton"
				tooltip = "je_space_race_widget_colony_site_tt_shackleton"
			}
			blockoverride "priority_button" {
				enabled = "[GetScriptedGui('sr_colony_priority_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End )]"
				onclick = "[GetScriptedGui('sr_colony_priority_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End )]"
				tooltip = "[Concatenate( GetScriptedGui('sr_colony_priority_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_colony_priority_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End ) ) )]"
			}
			blockoverride "prio_0_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_prio_shackleton'), '(CFixedPoint)0' )]"
			}
			blockoverride "prio_1_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_prio_shackleton'), '(CFixedPoint)1' )]"
			}
			blockoverride "prio_2_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_prio_shackleton'), '(CFixedPoint)2' )]"
			}
			blockoverride "prio_3_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_prio_shackleton'), '(CFixedPoint)3' )]"
			}
			blockoverride "settler_people" {
				raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_pop_shackleton')|K] / [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_site_room_shackleton')|K]#!"
			}
			blockoverride "module_crews" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_short_shackleton'), '(CFixedPoint)0' )]"
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_needed_shackleton')|0]/[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_shackleton')|0]"
			}
			blockoverride "module_crews_short" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_short_shackleton'), '(CFixedPoint)1' )]"
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_needed_shackleton')|0]/[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_shackleton')|0]"
			}
			blockoverride "module_staffing" {
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_staffing_shackleton')|0]%"
			}
			blockoverride "module_slots_tooltip" {
				tooltip = "je_space_race_widget_habs_tt_shackleton"
			}
			blockoverride "module_slots" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mod_past_shackleton'), '(CFixedPoint)0' )]"
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_hab_used_shackleton')|0]/[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_hab_cap_shackleton')|0]"
			}
			blockoverride "module_slots_past" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mod_past_shackleton'), '(CFixedPoint)1' )]"
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_hab_used_shackleton')|0]/[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_hab_cap_shackleton')|0]"
			}
			blockoverride "module_bases_tooltip" {
				tooltip = "je_space_race_widget_bases_tt_shackleton"
			}
			blockoverride "module_bases" {
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_ebase_room_shackleton')|0]"
			}
			blockoverride "module_grade" {
				raw_text = "(+0%)"
			}
			blockoverride "module_resorts_tooltip" {
				tooltip = "je_space_race_widget_resorts_tt"
			}
			blockoverride "module_resorts" {
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_resort_room_shackleton')|0]"
			}
			blockoverride "module_draw" {
				raw_text = "([JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_resort_draw_shackleton')|+0]%)"
			}
			blockoverride "page_name_a" {
				text = "sr_colony_shackleton_depot"
				tooltip = "je_space_race_widget_colony_shackleton_depot_tt"
			}
			blockoverride "page_name_b" {
				text = "sr_colony_shackleton_outpost"
				tooltip = "je_space_race_widget_colony_shackleton_outpost_tt"
			}
			blockoverride "mod_a_level" {
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_site_lvl_a_value_shackleton')|0]"
				tooltip = "je_space_race_widget_colony_shackleton_depot_tt"
			}
			blockoverride "mod_a_pending" {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mod_pending_a_shackleton'), '(CFixedPoint)1' )]"
				raw_text = "+[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mod_pending_a_shackleton')|0]"
			}
			blockoverride "mod_a_button" {
				enabled = "[GetScriptedGui('sr_colony_module_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				onclick = "[GetScriptedGui('sr_colony_module_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				tooltip = "[Concatenate( GetScriptedGui('sr_colony_module_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_colony_module_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
			}
			blockoverride "mod_a_dismantling" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_md_a_shackleton'), '(CFixedPoint)1' )]"
			}
			blockoverride "mod_a_dismantling_months" {
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_md_left_shackleton')|0]"
