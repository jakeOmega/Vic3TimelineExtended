	type te_sr_eb_near_earth_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		te_sr_eb_near_earth_box = {
				blockoverride "eb_ground" {
					text = "sr_ground_mixed"
				}
				blockoverride "eb_grade" {
					raw_text = "+0%"
				}
				blockoverride "eb_ground_tooltip" {
					tooltip = "je_space_race_widget_eb_near_earth_tt"
				}
				blockoverride "eb_away_visible" {
					visible = no
				}
				blockoverride "eb_levels" {
					raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_at_near_earth')|0]#! / [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_room_near_earth')|0]"
				}
				blockoverride "eb_target" {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_arrow_near_earth'), '(CFixedPoint)1' )]"
					raw_text = "→ [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_target_near_earth')|0]"
				}
				blockoverride "eb_minus" {
					enabled = "[GetScriptedGui('sr_ebase_assign_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
					onclick = "[GetScriptedGui('sr_ebase_assign_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
					onrightclick = "[GetScriptedGui('sr_ebase_assign_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
					tooltip = "[Concatenate( GetScriptedGui('sr_ebase_assign_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Concatenate( GetScriptedGui('sr_ebase_assign_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_space_race_widget_eb_step_tt' ) ) ) ) )]"
				}
				blockoverride "eb_plus" {
					enabled = "[GetScriptedGui('sr_ebase_assign_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					onclick = "[GetScriptedGui('sr_ebase_assign_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					onrightclick = "[GetScriptedGui('sr_ebase_assign_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
					tooltip = "[Concatenate( GetScriptedGui('sr_ebase_assign_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Concatenate( GetScriptedGui('sr_ebase_assign_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)0' ) ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_space_race_widget_eb_step_tt' ) ) ) ) )]"
				}
				blockoverride "eb_profit" {
					raw_text = "@money![JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_profit_near_earth')|K+=]"
				}
				blockoverride "eb_out_iron" {
					raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_out_near_earth_iron')|0]"
				}
				blockoverride "eb_out_tech_metals" {
					raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_out_near_earth_tech_metals')|0]"
				}
				blockoverride "eb_out_gold" {
					raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_out_near_earth_gold')|0]"
				}
				blockoverride "eb_out_copper" {
					raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_out_near_earth_copper')|0]"
				}
				blockoverride "eb_out_lead" {
					raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_out_near_earth_lead')|0]"
				}
				blockoverride "eb_out_sulfur" {
					raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_out_near_earth_sulfur')|0]"
				}
				blockoverride "eb_out_glass" {
					raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_out_near_earth_glass')|0]"
				}
		}
	}

