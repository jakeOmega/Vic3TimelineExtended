		te_sr_colony_row = {
			blockoverride "colony_visible" {
				visible = "[Or( And( Not( GetVariableSystem.HasValue('sr_colony_view', 'detail') ), Or( And( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_pallas'), '(CFixedPoint)1' ) ), And( Not( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ) ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_pallas'), '(CFixedPoint)1' ) ) ) ), And( GetVariableSystem.HasValue('sr_colony_view', 'detail'), And( GetVariableSystem.HasValue('sr_colony_focus', 'pallas'), Or( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_pallas'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_pallas'), '(CFixedPoint)1' ) ) ) ) )]"
			}
			blockoverride "colony_icon" {
				texture = "gfx/interface/icons/space_race_icons/colony_asteroid.dds"
			}
			blockoverride "colony_focus" {
				onclick = "[GetVariableSystem.Set('sr_colony_focus', 'pallas')]"
				onclick = "[GetVariableSystem.Set('sr_colony_view', 'detail')]"
			}
			blockoverride "colony_name" {
