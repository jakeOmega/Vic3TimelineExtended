			}
			blockoverride "site_other_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_venus'), '(CFixedPoint)2' )]"
			}
			blockoverride "site_context" {
				datacontext = "[JournalEntry.GetCountry.MakeScope.Var('sr_ss_cap_venus').GetState]"
			}
			blockoverride "site_unknown_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_venus'), '(CFixedPoint)3' )]"
			}
			blockoverride "site_target_mark_visible" {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_venus'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_target_venus'), '(CFixedPoint)2' ) )]"
			}
			blockoverride "site_unclaimed_visible" {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_venus'), '(CFixedPoint)0' ), Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_target_venus'), '(CFixedPoint)2' ) ) )]"
			}
			blockoverride "site_free_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_venus'), '(CFixedPoint)4' )]"
			}
			blockoverride "site_occupied_visible" {
