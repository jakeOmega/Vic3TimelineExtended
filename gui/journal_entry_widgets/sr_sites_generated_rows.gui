		te_sr_colony_row = {
			blockoverride "colony_visible" {
				visible = "[Or( And( Not( GetVariableSystem.HasValue('sr_colony_view', 'detail') ), Or( And( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_peary'), '(CFixedPoint)1' ) ), And( Not( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ) ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_peary'), '(CFixedPoint)1' ) ) ) ), And( GetVariableSystem.HasValue('sr_colony_view', 'detail'), And( GetVariableSystem.HasValue('sr_colony_focus', 'peary'), Or( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_peary'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_peary'), '(CFixedPoint)1' ) ) ) ) )]"
			}
			blockoverride "colony_icon" {
				texture = "gfx/interface/icons/space_race_icons/colony_moon.dds"
			}
			blockoverride "colony_focus" {
				onclick = "[GetVariableSystem.Set('sr_colony_focus', 'peary')]"
				onclick = "[GetVariableSystem.Set('sr_colony_view', 'detail')]"
			}
			blockoverride "colony_name" {
				text = "sr_site_name_peary"
				tooltip = "je_space_race_widget_colony_site_tt_peary"
			}
			blockoverride "priority_button" {
				enabled = "[GetScriptedGui('sr_colony_priority_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)36' ) ).End )]"
				onclick = "[GetScriptedGui('sr_colony_priority_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)36' ) ).End )]"
				tooltip = "[Concatenate( GetScriptedGui('sr_colony_priority_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)36' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_colony_priority_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)36' ) ).End ) ) )]"
