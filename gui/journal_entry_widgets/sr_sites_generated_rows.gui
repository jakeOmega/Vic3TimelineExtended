			}
			blockoverride "aut_none_visible" {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_aut_status_ceres'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_held_ceres'), '(CFixedPoint)0' ) )]"
