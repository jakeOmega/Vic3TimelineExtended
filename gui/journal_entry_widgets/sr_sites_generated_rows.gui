	type te_sr_colony_rows = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		te_sr_colony_row = {
			blockoverride "colony_visible" {
				visible = "[Or( And( Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'bases') ) ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_def_shackleton'), '(CFixedPoint)1' ) ), And( Not( Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'bases') ) ) ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_shackleton'), '(CFixedPoint)1' ) ) )]"
			}
			blockoverride "colony_focus" {
				onclick = "[GetVariableSystem.Set('sr_colony_focus', 'shackleton')]"
				onclick = "[GetVariableSystem.Set('te_popup', 'sr_colony')]"
			}
			blockoverride "colony_icon" {
				texture = "gfx/interface/icons/space_race_icons/colony_moon.dds"
			}
			blockoverride "colony_name" {
				text = "sr_site_name_shackleton"
				tooltip = "je_space_race_widget_colony_site_tt_shackleton"
			}
			blockoverride "priority_button" {
				enabled = "[GetScriptedGui('sr_colony_priority_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End )]"
				onclick = "[GetScriptedGui('sr_colony_priority_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End )]"
				tooltip = "[Concatenate( GetScriptedGui('sr_colony_priority_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_colony_priority_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End ) ) )]"
			}
			blockoverride "prio_0_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_prio_shackleton'), '(CFixedPoint)0' )]"
			}
			blockoverride "prio_1_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_prio_shackleton'), '(CFixedPoint)1' )]"
			}
			blockoverride "prio_2_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_prio_shackleton'), '(CFixedPoint)2' )]"
			}
			blockoverride "prio_3_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_prio_shackleton'), '(CFixedPoint)3' )]"
			}
			blockoverride "settler_people" {
				raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_pop_shackleton')|K] / [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_site_room_shackleton')|K]#!"
			}
			blockoverride "settler_crews" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_fit_shackleton'), '(CFixedPoint)0' )]"
				raw_text = "#G [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_needed_shackleton')|0]/[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_crews_shackleton')|0]#!"
