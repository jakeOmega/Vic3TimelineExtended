	type te_sr_free_rows = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2

		te_sr_free_row = {
			blockoverride "free_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_free_shackleton'), '(CFixedPoint)1' )]"
			}
			blockoverride "free_icon" {
				texture = "gfx/interface/icons/space_race_icons/colony_moon.dds"
			}
			blockoverride "free_name" {
				text = "sr_site_name_shackleton"
			}
			blockoverride "free_people" {
				raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_site_pop_shackleton')|K]#!"
			}
			blockoverride "free_ties" {
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_free_ties_shackleton')|0]"
			}
			blockoverride "free_supply_button" {
				enabled = "[GetScriptedGui('sr_free_supply_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End )]"
				onclick = "[GetScriptedGui('sr_free_supply_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'site', MakeScopeValue( '(CFixedPoint)35' ) ).End )]"
