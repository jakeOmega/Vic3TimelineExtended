### Nuclear Deterrence widgets — two panels for je_nuclear_program ("Nuclear
### Weapons"), which since 2026-09-25 carries posture and crises as well as the
### programme. Both sit in custom_widget_container_4, below the warhead bar,
### after the programme panel above it and before the delivery-and-defence and
### nuclear-powers panel (widget_je_nuclear_balance, nuclear_program_widget.gui)
### — the order is the order of the entry's widget declarations.
###
### widget_je_nuclear_posture   custom_widget_container_4 (first)
###     Posture (doctrine, readiness, launch authority) with what each costs and
###     risks, the forces behind it (arsenal, survivability, reliability,
###     strain, the two investment steppers), and how the posture is received
###     at home. Only drawn while the country is armed (nd_armed_sgui).
###
### widget_je_nuclear_crisis    custom_widget_container_4 (second)
###     The live crisis — opponent, dispute, stage, danger, the pressure on the
###     target, the deadline, and the crisis actions — or, between crises, how
###     the last one ended. Then reputation (credibility), once there is one
###     (nd_has_reputation_sgui): a great power still building its first
###     warhead has no record to show.
###
### Design: docs/systems/nuclear_crisis_design.md (§0 is what shipped); the
### panel is described in docs/systems/journal_entry_systems.md, "Nuclear
### Deterrence Widget".
###
### WHERE THE NUMBERS COME FROM. Nothing here computes anything. Every number
### is a display script value (nd_display_* and friends in
### common/script_values/nuclear_deterrence_values.txt), every word that
### depends on state is a customizable-localization block in
### common/customizable_localization/nuclear_deterrence_custom_loc.txt, and the
### incident band is projected into nd_risk_band in script. No threshold is
### restated in this file.
###
### WHAT A HUMAN CAN DO HERE. Two action handlers in
### common/scripted_guis/nuclear_deterrence_sguis.txt, addressed by op code
### (keep this table, the sgui header and journal_entry_systems.md in step):
###   nd_posture_sgui         11..15 doctrine 1..5   20..23 readiness 0..3
###                           31..34 authority 1..4  40/41 safeguards -/+
###                           50/51 hardening -/+
###   nd_crisis_action_sgui   1 go public  2 propose stand-down  3 exercise
###                           4 concede    5 let it go
### The AI does not use these (ai_is_valid = no): it sets its posture in
### nd_ai_review_posture and answers crises through the crisis events, which
### call the same effects.
###
### NO ACTION BUTTON'S `visible` COMES FROM AN op-BRANCHING IsShown
### (gui_modding_guide.md gotcha #22). The buttons are always drawn while their
### section is; is_valid greys them and says why. The yes/no questions this
### file does ask (armed? in a crisis? a last crisis to report? which side of
### the crisis are we on?) go to scope-free display handlers — the crisis move
### rows a side cannot make are hidden that way (nd_crisis_we_issued_sgui,
### nd_crisis_we_are_target_sgui, nd_crisis_private_sgui, nd_armed_sgui), and
### the pressure and danger breakdowns and the next-pressure line are
### script-built text from display handlers (nd_crisis_*_breakdown_sgui,
### nd_crisis_next_pressure_sgui).
###
### BOTH ROOTS ARE GATED ON JournalEntry.IsActive (gotcha #14).
###
### Section collapse state lives in GetVariableSystem: client-side, never
### saved, invisible to script.

types nuclear_deterrence_widget_types
{
	type nd_panel = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 1
		margin = { 10 6 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	type nd_section_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 520 38 }
		}
	}

	type nd_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_medium
	}

	### A label/value line with one tooltip for the whole row.
	type nd_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 6 1 }

		block "row_tooltip" {}

		textbox = {
			size = { 240 24 }
			align = left|nobaseline
			using = fontsize_medium
			parentanchor = vcenter
			elide = right
			alwaystransparent = yes
			block "row_label" {}
		}

		textbox = {
			size = { 236 24 }
			align = right|nobaseline
			using = fontsize_medium
			parentanchor = vcenter
			elide = right
			alwaystransparent = yes
			block "row_value" {}
		}
	}

	### A choice: its name (with its own tooltip) and one action button.
	type nd_choice_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6
		margin = { 6 1 }
	}

	### A funding-style stepper row: label, [-] value [+].
	type nd_stepper_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 6 2 }
	}

	### A line built in script (a country's name out of a variable).
	type nd_script_line = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 6 1 }

		textbox = {
			autoresize = yes
			multiline = yes
			minimumsize = { 468 -1 }
			maximumsize = { 468 -1 }
			align = left|nobaseline
			using = fontsize_medium
			block "line_text" {}
		}
	}
}


### ==========================================================================
### POSTURE — container_4, first
### ==========================================================================
flowcontainer = {
	name = "widget_je_nuclear_posture"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	spacing = 2

	visible = "[And( JournalEntry.IsActive, GetScriptedGui('nd_armed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"

	### ---- The posture in force (open by default) --------------------------
	nd_section_header = {
		blockoverride "left_text" {
			text = "nd_w_posture_header"
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('nd_posture_closed')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[GetVariableSystem.Exists('nd_posture_closed')]"
		}
		blockoverride "onclick_showless" {
			visible = "[Not(GetVariableSystem.Exists('nd_posture_closed'))]"
		}
	}

	nd_panel = {
		visible = "[Not(GetVariableSystem.Exists('nd_posture_closed'))]"

		nd_row = {
			blockoverride "row_label" {
				text = "nd_w_doctrine_label"
			}
			blockoverride "row_value" {
				text = "nd_w_doctrine_value"
			}
			blockoverride "row_tooltip" {
				tooltip = "nd_w_doctrine_tt"
			}
		}
		nd_row = {
			blockoverride "row_label" {
				text = "nd_w_readiness_label"
			}
			blockoverride "row_value" {
				text = "nd_w_readiness_value"
			}
