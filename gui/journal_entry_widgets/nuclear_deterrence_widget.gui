	### The forces behind the posture (open; only while armed): the arsenal,
	### survivability, reliability, strain, the investment steppers, and the
	### arsenal's size (the nuclear taboo's ceiling and dismantling).
	type te_nuclear_sec_forces = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('nd_armed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		nd_section_header = {
			blockoverride "left_text" {
				text = "nd_w_capabilities_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('nd_capabilities_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('nd_capabilities_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('nd_capabilities_closed'))]"
			}
		}

		nd_panel = {
			visible = "[Not(GetVariableSystem.Exists('nd_capabilities_closed'))]"

			nd_row = {
				blockoverride "row_label" {
					text = "nd_w_arsenal_label"
				}
				blockoverride "row_value" {
					text = "nd_w_arsenal_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "nd_w_arsenal_tt"
				}
			}
			### Survivability, heading for the ceiling our technology sets while we
			### pay for hardening and back toward the floor without it
			### (nd_display_survivability_heading). Play-test round 3: the
			### projection bar shared with Global Warming, in one fixed 200 x 14
			### cell, bottom to top: background and frame; the change still to come,
			### to the higher of today's value and where it is heading, green while
			### rising and red while falling (a wrapper, alpha 0.5; more
			### survivability is always good for us, owner 2026-09-30: red bad,
			### green good); the solid fill to the lower of the two; and the ceiling
			### as a 3 px cream line with its own hover. The row is an nd_row's width
			### (170 + 200 + 94 and two 8 px gaps, in 6 px margins). Rising and
			### falling compare the two values rather than a code: a (CFixedPoint)
			### literal here, between two action rows, would read as an op code to
			### test_nuclear_deterrence.gui_ops.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 8
				margin = { 6 1 }
				tooltip = "[Concatenate( Localize( 'nd_w_survivability_tt' ), Concatenate( Localize( 'te_tt_break' ), Localize( 'nd_w_survivability_bar_tt' ) ) )]"

				textbox = {
					size = { 170 24 }
					align = left|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
					alwaystransparent = yes
					text = "nd_w_survivability_label"
				}
				widget = {
					size = { 200 14 }
					parentanchor = vcenter

					# 1. Background and frame.
					default_progressbar_horizontal = {
						size = { 100% 100% }
						blockoverride "values" {
							value = 0
							min = 0
							max = 100
						}
					}
					# 2. Rising (good for us): green to where it is heading.
					widget = {
						size = { 100% 100% }
						alpha = 0.5
						visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability_heading'), JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability') )]"

						green_progressbar_horizontal = {
							size = { 100% 100% }
							blockoverride "background" {}
							blockoverride "frame" {}
							blockoverride "values" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability_bar_high') )]"
								min = 0
								max = 100
							}
						}
					}
					# 3. Falling (bad for us): red from where it is heading up to today's value.
					widget = {
						size = { 100% 100% }
						alpha = 0.5
						visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability'), JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability_heading') )]"

						bad_progressbar_horizontal = {
							size = { 100% 100% }
							blockoverride "background" {}
							blockoverride "frame" {}
							blockoverride "values" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability_bar_high') )]"
								min = 0
								max = 100
							}
						}
					}
					# 4. Solid: the lower of today's value and where it is heading.
					default_progressbar_horizontal = {
						size = { 100% 100% }
						blockoverride "background" {}
						blockoverride "frame" {}
						blockoverride "values" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability_bar_low') )]"
							min = 0
							max = 100
						}
					}
					# 5. The ceiling our technology sets: a thin line with its own hover.
					progressbar = {
						noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
						progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
						size = { 100% 100% }
						skip_initial_animation = yes
						direction = horizontal
						value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability_cap') )]"
						min = 0
						max = 100
						marker = {
							icon = {
								size = { 3 24 }
								parentanchor = vcenter
								widgetanchor = center
								texture = "gfx/interface/backgrounds/white.dds"
								color = { 0.96 0.90 0.72 0.95 }
								tooltip = "nd_w_survivability_cap_tt"
							}
						}
					}
				}
				textbox = {
					size = { 94 24 }
					align = right|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
					alwaystransparent = yes
					text = "nd_w_survivability_value"
				}
			}
			nd_row = {
				blockoverride "row_label" {
					text = "nd_w_reliability_label"
				}
				blockoverride "row_value" {
					text = "nd_w_reliability_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "nd_w_reliability_tt"
				}
			}
			nd_row = {
				blockoverride "row_label" {
					text = "nd_w_strain_label"
				}
				blockoverride "row_value" {
					text = "nd_w_strain_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "nd_w_strain_tt"
				}
			}
			nd_row = {
				blockoverride "row_label" {
					text = "nd_w_hold_label"
				}
				blockoverride "row_value" {
					text = "nd_w_hold_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "nd_w_hold_tt"
				}
			}
			nd_subheader = {
				blockoverride "subheader_text" {
					text = "nd_w_investment_sub"
				}
			}
			nd_stepper_row = {
				datacontext = "[GetScriptedGui('nd_posture_sgui')]"
				textbox = {
					text = "nd_w_safeguards_label"
					size = { 170 24 }
					align = left|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
					alwaystransparent = yes
				}
				button_icon_minus_action = {
					size = { 24 24 }
					parentanchor = vcenter
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)40' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)40' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)40' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)40' ) ).End ) ) )]"
				}
				textbox = {
					text = "nd_w_safeguards_value"
					tooltip = "nd_w_safeguards_tt"
					size = { 246 24 }
					align = center|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
				}
				button_icon_plus_action = {
					size = { 24 24 }
					parentanchor = vcenter
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)41' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)41' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)41' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)41' ) ).End ) ) )]"
				}
			}
			nd_stepper_row = {
				datacontext = "[GetScriptedGui('nd_posture_sgui')]"
				textbox = {
					text = "nd_w_hardening_label"
					size = { 170 24 }
					align = left|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
					alwaystransparent = yes
				}
