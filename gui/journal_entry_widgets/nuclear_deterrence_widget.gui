	### The forces behind the posture (open; only while armed): the arsenal,
	### survivability, reliability, strain, the investment steppers, and the
	### arsenal's size (the nuclear taboo's ceiling and dismantling).
	type te_nuclear_sec_forces = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('nd_armed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		nd_section_header = {
			blockoverride "left_text" {
				text = "nd_w_capabilities_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('nd_capabilities_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('nd_capabilities_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('nd_capabilities_closed'))]"
			}
		}

		nd_panel = {
			visible = "[Not(GetVariableSystem.Exists('nd_capabilities_closed'))]"

			nd_row = {
				blockoverride "row_label" {
					text = "nd_w_arsenal_label"
				}
				blockoverride "row_value" {
					text = "nd_w_arsenal_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "nd_w_arsenal_tt"
				}
			}
			### Survivability grows toward the ceiling our technology sets: a bar
			### with a tick at the ceiling (the marker technique of the UN
			### overview's authority bar), the same width as an nd_row.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 8
				margin = { 6 1 }
				tooltip = "nd_w_survivability_tt"

				textbox = {
					size = { 170 24 }
					align = left|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
					alwaystransparent = yes
					text = "nd_w_survivability_label"
				}
				default_progressbar_horizontal = {
					size = { 200 14 }
					parentanchor = vcenter
					blockoverride "values" {
						value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability') )]"
						min = 0
						max = 100
					}
					blockoverride "on_top_of_the_progressbar" {
						progressbar = {
							noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							size = { 100% 100% }
							skip_initial_animation = yes
							direction = horizontal
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('nd_display_survivability_cap') )]"
							min = 0
							max = 100
							marker = {
								icon = {
									size = { 36 20 }
									parentanchor = vcenter
									widgetanchor = center
									texture = "gfx/interface/progressbar/progressbar_marker.dds"
								}
							}
						}
					}
				}
				textbox = {
					size = { 94 24 }
					align = right|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
					alwaystransparent = yes
					text = "nd_w_survivability_value"
				}
			}
			nd_row = {
				blockoverride "row_label" {
					text = "nd_w_reliability_label"
				}
				blockoverride "row_value" {
					text = "nd_w_reliability_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "nd_w_reliability_tt"
				}
			}
			nd_row = {
				blockoverride "row_label" {
					text = "nd_w_strain_label"
				}
				blockoverride "row_value" {
					text = "nd_w_strain_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "nd_w_strain_tt"
				}
			}
			nd_row = {
				blockoverride "row_label" {
					text = "nd_w_hold_label"
				}
				blockoverride "row_value" {
					text = "nd_w_hold_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "nd_w_hold_tt"
				}
			}
			nd_subheader = {
				blockoverride "subheader_text" {
					text = "nd_w_investment_sub"
				}
			}
			nd_stepper_row = {
				datacontext = "[GetScriptedGui('nd_posture_sgui')]"
				textbox = {
					text = "nd_w_safeguards_label"
					size = { 200 24 }
					align = left|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
					alwaystransparent = yes
				}
				button_icon_minus_action = {
					size = { 24 24 }
					parentanchor = vcenter
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)40' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)40' ) ).End )]"
