	### How each interest group receives the posture (open; only while armed).
	### What the classes mean is in How Nuclear Weapons Work.
	type te_nuclear_sec_home = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('nd_armed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		nd_section_header = {
			blockoverride "left_text" {
				text = "nd_w_home_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('nd_home_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('nd_home_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('nd_home_closed'))]"
			}
		}

		nd_panel = {
			visible = "[Not(GetVariableSystem.Exists('nd_home_closed'))]"

			nd_script_line = {
				datacontext = "[GetScriptedGui('nd_home_list_sgui')]"
				blockoverride "line_text" {
					text = "[ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				}
			}

			nd_script_line = {
				datacontext = "[GetScriptedGui('nd_home_footer_sgui')]"
				blockoverride "line_text" {
					text = "[ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				}
			}
		}
	}

	### Our record (open; once there is one): the last crisis between crises,
	### then credibility and pledges.
	type te_nuclear_sec_reputation = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[Or( GetScriptedGui('nd_has_reputation_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('nd_last_crisis_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"

		nd_section_header = {
			blockoverride "left_text" {
				text = "nd_w_reputation_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('nd_reputation_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('nd_reputation_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('nd_reputation_closed'))]"
			}
		}

		nd_panel = {
			visible = "[Not(GetVariableSystem.Exists('nd_reputation_closed'))]"

			### Between crises: the last one and how it ended.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 1
				visible = "[GetScriptedGui('nd_last_crisis_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				nd_script_line = {
					datacontext = "[GetScriptedGui('nd_last_crisis_sgui')]"
					blockoverride "line_text" {
						text = "[ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					}
				}

				nd_text = {
					text = "nd_w_last_outcome"
				}
			}

			### Credibility exists once the posture is initialised or a crisis has
			### touched us; before that its display value would read a default.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 1
				visible = "[GetScriptedGui('nd_has_reputation_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				nd_row = {
					blockoverride "row_label" {
						text = "nd_w_credibility_label"
					}
					blockoverride "row_value" {
						text = "nd_w_credibility_value"
					}
					blockoverride "row_tooltip" {
						tooltip = "nd_w_credibility_tt"
					}
				}
				nd_row = {
					blockoverride "row_label" {
						text = "nd_w_pledge_label"
					}
					blockoverride "row_value" {
						text = "nd_w_pledge_value"
					}
					blockoverride "row_tooltip" {
						tooltip = "nd_w_pledge_tt"
					}
				}
			}
		}
	}
}
