### CRISIS AND REPUTATION — container_4, second
### ==========================================================================
flowcontainer = {
	name = "widget_je_nuclear_crisis"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	spacing = 2

	visible = "[JournalEntry.IsActive]"

	### ---- The live crisis (open by default, only while there is one) ---------
	nd_section_header = {
		visible = "[GetScriptedGui('nd_in_crisis_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		blockoverride "left_text" {
			text = "nd_w_crisis_header"
