				}
			}

			### Slot b.
			flowcontainer = {
				visible = "[GetScriptedGui('te_tax_show_package_b_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 1
				minimumsize = { 480 -1 }
				margin_top = 6

				te_tax_value_row = {
