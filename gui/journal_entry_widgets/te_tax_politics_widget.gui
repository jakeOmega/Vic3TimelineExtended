					}
				}
				te_tax_review_line = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_goods_changed'), '(CFixedPoint)0' )]"
					blockoverride "line_label" {
						text = "te_tax_en_goods"
					}
					blockoverride "line_value" {
						text = "te_tax_pk_b_goods"
					}
				}
				# Which goods, as icons (GUI audit TAX-12).
				te_tax_pk_goods_icons_b = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_goods_changed'), '(CFixedPoint)0' )]"
					margin_left = 4
				}
				# The relief it sets, and the states regional relief then names (GUI
				# audit TAX-12).
				te_tax_review_line = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_agrel_on'), '(CFixedPoint)0' )]"
					blockoverride "line_label" {
