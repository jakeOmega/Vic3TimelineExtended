				flowcontainer = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_regrel_pct'), '(CFixedPoint)0' )]"
					direction = vertical
					ignoreinvisible = yes
					datamodel = "[GetPlayer.MakeScope.GetList('te_tax_pb_relief_states')]"

					item = {
						textbox = {
							datacontext = "[Scope.GetState]"
							autoresize = yes
							minimumsize = { 480 -1 }
							maximumsize = { 480 -1 }
							margin_left = 24
							align = left|nobaseline
							using = te_tax_fontsize_row
							elide = right
							text = "te_tax_wb_relief_state_name"
						}
					}
				}
				# Customs levels it changes (plan Task 15; customs option only).
				te_tax_review_line = {
					visible = "[NotEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('te_tax_view_pb_customs_changed'), '(CFixedPoint)0' )]"
					blockoverride "line_label" {
						text = "te_tax_wb_sub_customs"
					}
					blockoverride "line_value" {
						text = "te_tax_pk_b_customs"
