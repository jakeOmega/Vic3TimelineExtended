		blockoverride "row_name" { text = "st_res_row_small_arms_name" }
		blockoverride "row_amount" { text = "st_res_row_small_arms_amount" }
		blockoverride "row_status" { text = "st_res_row_small_arms_status" }
		blockoverride "row_flow" { text = "st_res_row_small_arms_flow" }
		blockoverride "row_bar_value" {
			value = "[FixedPointToFloat(GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).ScriptValue('st_res_small_arms_fill_pct'))]"
		}
	}

	widget_je_st_res_inventory_row = {
		datacontext = "[GetScriptedGui('st_res_adjust_artillery_sgui')]"
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'dir', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
		tooltip = "st_res_row_artillery_tooltip"

		blockoverride "row_name" { text = "st_res_row_artillery_name" }
		blockoverride "row_amount" { text = "st_res_row_artillery_amount" }
		blockoverride "row_status" { text = "st_res_row_artillery_status" }
		blockoverride "row_flow" { text = "st_res_row_artillery_flow" }
		blockoverride "row_bar_value" {
			value = "[FixedPointToFloat(GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).ScriptValue('st_res_artillery_fill_pct'))]"
		}
	}

	widget_je_st_res_inventory_row = {
		datacontext = "[GetScriptedGui('st_res_adjust_aeroplanes_sgui')]"
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'dir', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
		tooltip = "st_res_row_aeroplanes_tooltip"

		blockoverride "row_name" { text = "st_res_row_aeroplanes_name" }
		blockoverride "row_amount" { text = "st_res_row_aeroplanes_amount" }
		blockoverride "row_status" { text = "st_res_row_aeroplanes_status" }
		blockoverride "row_flow" { text = "st_res_row_aeroplanes_flow" }
		blockoverride "row_bar_value" {
			value = "[FixedPointToFloat(GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).ScriptValue('st_res_aeroplanes_fill_pct'))]"
		}
	}

	widget_je_st_res_inventory_row = {
		datacontext = "[GetScriptedGui('st_res_adjust_tanks_sgui')]"
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'dir', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
		tooltip = "st_res_row_tanks_tooltip"

		blockoverride "row_name" { text = "st_res_row_tanks_name" }
		blockoverride "row_amount" { text = "st_res_row_tanks_amount" }
		blockoverride "row_status" { text = "st_res_row_tanks_status" }
		blockoverride "row_flow" { text = "st_res_row_tanks_flow" }
		blockoverride "row_bar_value" {
			value = "[FixedPointToFloat(GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).ScriptValue('st_res_tanks_fill_pct'))]"
		}
	}
}
