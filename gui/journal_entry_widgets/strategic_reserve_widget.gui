							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_tanks_sell_thr').GetValue|+0]"
						}
						blockoverride "policy_value_max_flow" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_tanks_max_flow').GetValue|0]"
						}
						blockoverride "policy_value_floor_pct" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_tanks_floor_pct').GetValue|0]"
						}
						blockoverride "policy_value_ceil_pct" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_tanks_ceil_pct').GetValue|0]"
						}
						blockoverride "policy_value_budget" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_tanks_budget').GetValue|0]"
						}
						blockoverride "policy_value_price_memory" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_tanks_price_memory').GetValue|0]"
						}
						blockoverride "policy_value_ramp" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_tanks_ramp').GetValue|0]"
						}
					}
				}
			}

			te_st_res_good_row = {
				datacontext = "[GetScriptedGui('st_res_adjust_fertilizer_sgui')]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'dir', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				tooltip = "st_res_row_fertilizer_tooltip"

				blockoverride "row_toggle" {
					onclick = "[GetVariableSystem.Toggle('st_res_row_fertilizer_open')]"
					tooltip = "st_res_row_collapse_tooltip"
				}
				blockoverride "row_open" {
					visible = "[GetVariableSystem.Exists('st_res_row_fertilizer_open')]"
				}
				blockoverride "row_closed" {
					visible = "[Not(GetVariableSystem.Exists('st_res_row_fertilizer_open'))]"
				}
				blockoverride "row_name" { text = "st_res_row_fertilizer_name" }
				blockoverride "row_status" { tooltip = "st_res_row_fertilizer_status" }
				blockoverride "row_status_idle" {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_status'), '(CFixedPoint)0' )]"
				}
				blockoverride "row_status_storing" {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_status'), '(CFixedPoint)1' )]"
				}
				blockoverride "row_status_withdrawing" {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_status'), '(CFixedPoint)2' )]"
				}
				blockoverride "row_status_blocked" {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_status'), '(CFixedPoint)3' )]"
				}
				blockoverride "row_fill" {
					value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_fill_pct') )]"
				}
				blockoverride "row_target_marker" {
					visible = "[LessThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_target'), '(CFixedPoint)100' )]"
					value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_target') )]"
				}
				blockoverride "row_floor_marker" {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_floor'), '(CFixedPoint)0' )]"
					value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_floor') )]"
				}
				blockoverride "row_auto" {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('st_res_fertilizer_disp_policy'), '(CFixedPoint)0' )]"
				}
				blockoverride "row_stored" { text = "st_res_row_fertilizer_amount" }
				blockoverride "row_rate" { text = "st_res_row_fertilizer_flow" }
				blockoverride "row_last" { text = "st_res_row_fertilizer_last" }
				blockoverride "row_decay" { text = "st_res_row_fertilizer_decay" }
				blockoverride "row_price" { text = "st_res_row_fertilizer_price" }
				blockoverride "row_policy" { text = "st_res_row_fertilizer_policy" }
				blockoverride "row_policy_reason" { text = "st_res_row_fertilizer_policy_reason" }
				blockoverride "row_history" {
					te_history_chart = {
						blockoverride "chart_title" {
							text = "st_res_hist_title"
						}
						blockoverride "chart_legend" {
							text = "st_res_hist_legend"
						}
						blockoverride "marker_pips" {}
						blockoverride "bar_tooltip" {
							tooltip = "st_res_hist_tt_fertilizer"
						}
						blockoverride "bar_body" {
							te_history_bar_unsigned = {
								visible = "[ScriptContainer.HasVariable( 'te_hist_v_st_res_fertilizer' )]"
								blockoverride "values" {
									min = 0
									max = 100
									value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_st_res_fertilizer' ) ) )]"
								}
								blockoverride "cover_values" {
									min = 0
									max = 100
									value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_st_res_fertilizer' ), '(CFixedPoint)4' ) ) )]"
								}
							}
						}
					}
				}
				blockoverride "row_settings_toggle" {
					onclick = "[GetVariableSystem.Toggle('st_res_policy_fertilizer_open')]"
				}
				blockoverride "row_settings_open" {
					visible = "[GetVariableSystem.Exists('st_res_policy_fertilizer_open')]"
				}
				blockoverride "row_settings_closed" {
					visible = "[Not(GetVariableSystem.Exists('st_res_policy_fertilizer_open'))]"
				}
				blockoverride "row_settings_shown" {
					visible = "[Or( GetVariableSystem.Exists('st_res_row_fertilizer_open'), GetVariableSystem.Exists('st_res_policy_fertilizer_open') )]"
				}
				blockoverride "row_policy_panel" {
					widget_je_st_res_policy_panel = {
						blockoverride "policy_panel_context" {
							datacontext = "[GetScriptedGui('st_res_policy_fertilizer_sgui')]"
						}
						blockoverride "policy_value_buy_thr" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_fertilizer_buy_thr').GetValue|+0]"
						}
						blockoverride "policy_value_sell_thr" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_fertilizer_sell_thr').GetValue|+0]"
						}
						blockoverride "policy_value_max_flow" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_fertilizer_max_flow').GetValue|0]"
						}
						blockoverride "policy_value_floor_pct" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_fertilizer_floor_pct').GetValue|0]"
						}
						blockoverride "policy_value_ceil_pct" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_fertilizer_ceil_pct').GetValue|0]"
						}
						blockoverride "policy_value_budget" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_fertilizer_budget').GetValue|0]"
						}
						blockoverride "policy_value_price_memory" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_fertilizer_price_memory').GetValue|0]"
						}
						blockoverride "policy_value_ramp" {
							text = "[JournalEntry.GetCountry.MakeScope.Var('st_res_fertilizer_ramp').GetValue|0]"
						}
					}
				}
			}
		}
	}

	### "How the Strategic Reserve Works": every explanation, one heading per
	### topic, collapsed until opened (style rule 1). The live sections above
	### say what is happening; this says how it works.
	type te_st_res_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		st_res_section_header = {
			blockoverride "left_text" {
				text = "je_strategic_reserve_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('st_res_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('st_res_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('st_res_how_open')]"
			}
		}

		st_res_panel = {
			visible = "[GetVariableSystem.Exists('st_res_how_open')]"

			st_res_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_strategic_reserve_how_sub_hub"
				}
			}
			st_res_note = {
				text = "je_strategic_reserve_how_hub"
			}
			st_res_subheader = {
				blockoverride "subheader_text" {
					text = "je_strategic_reserve_how_sub_rates"
				}
			}
			st_res_note = {
				text = "je_strategic_reserve_how_rates"
			}
			st_res_subheader = {
				blockoverride "subheader_text" {
					text = "je_strategic_reserve_how_sub_status"
				}
			}
			st_res_note = {
				text = "je_strategic_reserve_how_status"
			}
			st_res_subheader = {
				blockoverride "subheader_text" {
					text = "je_strategic_reserve_how_sub_decay"
				}
			}
			st_res_note = {
				text = "je_strategic_reserve_how_decay"
			}
			st_res_subheader = {
				blockoverride "subheader_text" {
					text = "je_strategic_reserve_how_sub_policies"
				}
			}
			st_res_note = {
				text = "je_strategic_reserve_how_policies"
			}
			st_res_subheader = {
				blockoverride "subheader_text" {
					text = "je_strategic_reserve_how_sub_presets"
				}
			}
			st_res_note = {
				text = "je_strategic_reserve_how_presets"
			}
			st_res_subheader = {
				blockoverride "subheader_text" {
					text = "je_strategic_reserve_how_sub_income"
				}
			}
			st_res_note = {
				text = "je_strategic_reserve_how_income"
			}
			st_res_subheader = {
				blockoverride "subheader_text" {
					text = "je_strategic_reserve_how_sub_history"
				}
			}
			st_res_note = {
				text = "je_strategic_reserve_how_history"
			}
		}
	}

	### ======================================================================
	### COMPOSERS. The one order of the sections, for the journal entry's
	### roots below and for the Market panel's Reserve tab.
	### ======================================================================

	### What a returning player checks, open by default.
	type te_st_res_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_st_res_sec_inventory = {}
	}

	### How it all works, collapsed.
	type te_st_res_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_st_res_sec_how = {}
	}
}

### ==========================================================================
### JOURNAL ENTRY ROOTS (je_strategic_reserve.txt). Bare wrappers that repeat
### the composers' IsActive gate: je_strategic_reserve has
### is_shown_when_inactive = logistics, so the panel can render for a country
### that has never built a hub and has none of the reserve's variables
### (gui_modding_guide.md gotcha #14).
### ==========================================================================
flowcontainer = {
	name = "widget_je_strategic_reserve_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_st_res_overview_panel = {}
}

flowcontainer = {
	name = "widget_je_strategic_reserve_inventory"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_st_res_status_sections = {}
}

flowcontainer = {
	name = "widget_je_strategic_reserve_reference"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_st_res_reference_sections = {}
}
