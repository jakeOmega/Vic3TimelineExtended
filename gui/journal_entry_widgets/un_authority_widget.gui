							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_pillar_order_trend'), '(CFixedPoint)1' )]"
							texture = "gfx/interface/icons/generic_icons/trend_up.dds"
						}
						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_pillar_order_trend'), '(CFixedPoint)-1' )]"
							texture = "gfx/interface/icons/generic_icons/trend_down.dds"
