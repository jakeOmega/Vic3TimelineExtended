						size = { 170 14 }
						parentanchor = vcenter
						blockoverride "value_left" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_pillar_funding_neg') )]"
						}
						blockoverride "value_right" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_pillar_funding_pos') )]"
