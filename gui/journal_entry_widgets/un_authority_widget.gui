				visible = "[GetScriptedGui('un_authority_underminers_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_authority_underminers_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			un_auth_text = {
				visible = "[GetScriptedGui('un_authority_outsiders_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				align = hcenter|nobaseline
				text = "je_un_auth_powers_outsiders"
			}
			un_auth_text = {
				visible = "[GetScriptedGui('un_authority_outsiders_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('un_authority_outsiders_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
			un_auth_text = {
				text = "[GetScriptedGui('un_authority_powers_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}

			# The ledger's display log: what each member did to the organisation,
			# and what became of the Assembly's resolutions and missions. A
			# subsection, collapsed by default (the chamber's nested header type).
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				margin_left = 20
				margin_top = 6
				margin_bottom = 6

				un_chamber_subsection_header = {
					blockoverride "left_text" {
						text = "je_un_auth_sub_log"
					}
					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle('un_auth_log_open')]"
					}
					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.Exists('un_auth_log_open'))]"
					}
					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.Exists('un_auth_log_open')]"
					}
				}
			}
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				visible = "[GetVariableSystem.Exists('un_auth_log_open')]"

				un_auth_note_text = {
					text = "je_un_auth_log_intro"
				}
				un_auth_text = {
					text = "[GetScriptedGui('un_authority_log_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}
			}
		}
	}

	### How UN authority works: the text only, for "How the UN Works"
	### (te_un_sec_how, un_layout_widget.gui), which carries the heading.
	type te_un_help_authority = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		un_auth_text = {
			text = "[GetScriptedGui('un_authority_help_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
	}

	type te_un_sec_auth_history = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		# ---- Authority history (open by default: the owner's call, 2026-09-28) ----
		un_auth_section_header = {
			blockoverride "left_text" {
				text = "je_un_auth_header_history"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('un_auth_hist_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('un_auth_hist_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('un_auth_hist_closed'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 2
			visible = "[Not(GetVariableSystem.Exists('un_auth_hist_closed'))]"

			### Range selector — the shared type and the shared GUI variable, so the
			### range picked here is the range on every history chart in the game.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 4
				margin = { 4 4 }

				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_1y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '1' ))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '1' )]"
					}
				}
				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_5y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '5' ))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '5' )]"
					}
				}
				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_20y"
					}
					blockoverride "range_enabled" {
						enabled = "[Or( GetVariableSystem.HasValue( 'te_hist_range', '1' ), GetVariableSystem.HasValue( 'te_hist_range', '5' ) )]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '20' )]"
					}
				}
			}

			textbox = {
				visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('te_hist') ) )]"
				parentanchor = hcenter
				autoresize = yes
				multiline = yes
				max_width = 480
				align = hcenter|nobaseline
				text = "te_hist_since"
			}

			### ---- UN authority (0-100) ----------------------------------------
			te_history_chart = {
				blockoverride "chart_title" {
					text = "un_hist_chart_auth_title"
				}
				blockoverride "chart_legend" {
					text = "un_hist_chart_auth_legend"
				}
				# The store's marker pips belong to the banking system; the UN
				# series has none of its own.
				blockoverride "marker_pips" {}
				blockoverride "bar_tooltip" {
					tooltip = "un_hist_tt_auth"
				}
				blockoverride "bar_body" {
					te_history_bar_unsigned = {
						visible = "[ScriptContainer.HasVariable( 'te_hist_v_un_auth' )]"
						blockoverride "values" {
							min = 0
							max = 100
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_un_auth' ) ) )]"
						}
						blockoverride "cover_values" {
							min = 0
							max = 100
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_un_auth' ), '(CFixedPoint)4' ) ) )]"
						}
						blockoverride "color" {
							color = { 0.36 0.60 0.85 1.0 }
						}
					}
				}
			}

			### ---- The target authority was moving toward (0-100) -------------
			te_history_chart = {
				blockoverride "chart_title" {
					text = "un_hist_chart_target_title"
				}
				blockoverride "chart_legend" {
					text = "un_hist_chart_target_legend"
				}
				# The store's marker pips belong to the banking system; the UN
				# series has none of its own.
				blockoverride "marker_pips" {}
				blockoverride "bar_tooltip" {
					tooltip = "un_hist_tt_target"
				}
				blockoverride "bar_body" {
					te_history_bar_unsigned = {
						visible = "[ScriptContainer.HasVariable( 'te_hist_v_un_target' )]"
						blockoverride "values" {
							min = 0
							max = 100
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_un_target' ) ) )]"
						}
						blockoverride "cover_values" {
							min = 0
							max = 100
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_un_target' ), '(CFixedPoint)4' ) ) )]"
						}
						blockoverride "color" {
							color = { 0.55 0.55 0.70 1.0 }
						}
					}
				}
			}
		}
	}
}


