							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('un_disp_pillar_order_trend'), '(CFixedPoint)0' )]"
							texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
