				### Base, a constant: label and value on the bars' columns, the detail in
				### the tooltip (je_un_auth_bar_base_tt).
				flowcontainer = {
					direction = horizontal
					spacing = 8
					margin = { 4 2 }
					tooltip = "je_un_auth_bar_base_tt"

					textbox = {
						minimumsize = { 170 -1 }
						maximumsize = { 170 -1 }
						autoresize = yes
						parentanchor = vcenter
