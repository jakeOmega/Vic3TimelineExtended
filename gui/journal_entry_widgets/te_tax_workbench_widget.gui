### Legislated Tax Code — the workbench (plan Task 8; docs/systems/tax_code_schema.md,
### "Panels"). Where the player drafts a reform: each tax moves in fixed steps
### from the law in force in the draft's commencement month, goods are toggled
### one by one, and the commencement month and each change's expiry are set
### with steppers. Every button runs a Task 6 command through its handler
### (common/scripted_guis/te_tax_sguis.txt, te_tax_generated_sguis.txt), whose
### is_valid is the command's own trigger: the button is enabled exactly when
### the click would do something, and its tooltip lists what is missing.
###
###   te_tax_workbench_section  open: Draft a Reform, or the draft in six
###                             accordions (Income, Land and Head,
###                             Consumption with the goods catalog, Relief
###                             with its named states, Customs (plan Task
###                             15; collapsed), Commencement)
###   te_tax_draft_summary      the draft at a glance and Review / Discard /
###                             Introduce (or Revise). The journal entry shows
###                             it under the workbench (te_tax_status_sections'
###                             "draft_summary" block); the Budget tab shows it
###                             in its fixed_bottom, so it stays on screen.
###
### EDITING RULES (te_tax_overview_widget.gui's apply too)
### * Every number is a guarded view of the PLAYER's draft,
###   GetPlayer.MakeScope.ScriptValue('te_tax_view_dr_*'): 0 or -1 with no
###   draft open. A row shown only in some state tests a display gate or a 0/1
###   code; no threshold is copied from script.
### * The "Law" column is the rate existing law will have in the draft's
###   commencement month (te_tax_base_dr_<key>): where an untouched tax starts
###   from, and what the change, the bill's class and its support are measured
###   against. It differs from the Enacted Code only when an expiry or a passed
###   bill falls before that month.
### * A step button's click_modifiers: click one step (op 0 down, 1 up),
###   shift-click to zero or the highest rate (2, 3), right-click to take the
###   tax out of the draft (4). The row's label hover says so; the buttons'
###   own tooltips are the handler's checklist and what the click does.
### * Every row is at most 480 wide, in fixed-width cells, inside a 520 panel.

types te_tax_workbench_widget_types
{
	### ======================================================================
	### BUILDING BLOCKS
	### ======================================================================

	### A heading nested in the workbench's panel: narrower, lower and in a
	### smaller type than te_tax_section_header (un_chamber_subsection_header).
	type te_tax_subsection_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 440 30 }
		}
		blockoverride "fontsize" {
			using = fontsize_medium
		}
		blockoverride "arrow_size" {
			size = { 20 20 }
		}
		blockoverride "left_textbox_margin_left" {
			margin_left = 32
		}
	}

	### The instrument rows' column heads, in their cells.
	### 4 + 146 + 4 + 70 + 4 + 18 + 4 + 70 + 4 + 26 + 4 + 26 + 4 + 80 + 4 = 468.
	type te_tax_instrument_head = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		widget = {
			size = { 146 20 }
		}
		widget = {
			size = { 70 20 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 70
				elide = right
				align = right|nobaseline
				using = fontsize_small
				default_format = "#tooltippable"
				text = "te_tax_wb_col_law"
				tooltip = "te_tax_wb_col_law_tt"
			}
		}
		widget = {
			size = { 18 20 }
		}
		widget = {
			size = { 70 20 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 70
				elide = right
				align = right|nobaseline
				using = fontsize_small
				text = "te_tax_wb_col_draft"
			}
		}
		widget = {
			size = { 56 20 }
		}
		widget = {
			size = { 80 20 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 80
				elide = right
				align = right|nobaseline
				using = fontsize_small
				text = "te_tax_wb_col_change"
			}
		}
	}

	### One tax: its name, its rate under existing law in the commencement
	### month, the draft's rate, the steppers and the change. The instance sets
	### datacontext = GetScriptedGui('te_tax_step_<key>_sgui'); the buttons
	### address it by op alone. Same cells as te_tax_instrument_head. The
	### rates are at most "@money!1.50" or "12.5%", the change "@money!+0.15".
	type te_tax_instrument_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		widget = {
			size = { 146 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 146
				elide = right
				align = left|nobaseline
				using = fontsize_medium
				default_format = "#tooltippable"
				block "row_label" {}
			}
		}
		widget = {
			size = { 70 26 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 70
				elide = right
				align = right|nobaseline
				using = fontsize_medium
				block "row_law" {}
			}
		}
		widget = {
			size = { 18 26 }
			textbox = {
				parentanchor = center
				autoresize = yes
				align = center|nobaseline
				using = fontsize_medium
				text = "te_tax_wb_arrow"
			}
		}
		widget = {
			size = { 70 26 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 70
				elide = right
				align = right|nobaseline
				using = fontsize_medium
				block "row_draft" {}
			}
		}
		button_icon_minus_action = {
			size = { 26 26 }
			parentanchor = vcenter
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
			### Click a step, shift-click to zero, right-click to take the tax out of the draft.
			click_modifiers = {
				ondefault = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				onshift = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
			}
			onrightclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
			tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
		}
		button_icon_plus_action = {
			size = { 26 26 }
			parentanchor = vcenter
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			### Click a step, shift-click to the highest rate, right-click to take the tax out of the draft.
			click_modifiers = {
				ondefault = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				onshift = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
			}
			onrightclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
			tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
		}
		widget = {
			size = { 80 26 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 80
				elide = right
				align = right|nobaseline
				using = fontsize_medium
				block "row_delta" {}
			}
		}
	}

