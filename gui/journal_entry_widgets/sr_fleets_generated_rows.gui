	### The target popup's slots (UI pass design § 7; te_sr_ftarget_popup in
	### space_race_widget.gui, te_popup sr_ftarget_<n>): one body a slot, each
	### a row per world (Solar System's order), the worlds at the fleet's
	### location shown, passing its slot and the world's index to
	### sr_fleet_set_target_sgui (scope:op, scope:pick).
	type te_sr_ftarget_popup_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		te_sr_ftarget_slot = {
			blockoverride "ft_visible" {
				visible = "[GetVariableSystem.HasValue('te_popup', 'sr_ftarget_1')]"
			}
			blockoverride "ft_here_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_1'), '(CFixedPoint)1' )]"
			}
			blockoverride "ft_rows" {
				te_sr_ftarget_row = {
					blockoverride "fr_visible" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_loc_value'), '(CFixedPoint)1' )]"
					}
					blockoverride "fr_icon" {
						texture = "gfx/interface/icons/space_race_icons/colony_moon.dds"
					}
					blockoverride "fr_name" {
						text = "sr_site_name_shackleton"
						tooltip = "je_space_race_widget_ss_site_tt_shackleton"
					}
