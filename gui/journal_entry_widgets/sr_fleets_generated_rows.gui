	### The destination popup's slots (UI pass design § 4; te_sr_dest_popup in
	### space_race_widget.gui, te_popup sr_dest_<n>): one body a slot, the
	### one open shown, each passing its slot and a location's code to
	### sr_fleet_set_dest_sgui (scope:op, scope:pick).
	type te_sr_dest_popup_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		te_sr_dest_slot = {
			blockoverride "dp_visible" {
				visible = "[GetVariableSystem.HasValue('te_popup', 'sr_dest_1')]"
			}
			blockoverride "dp_here_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_1'), '(CFixedPoint)1' )]"
			}
			blockoverride "dp_where" {
				text = "[JournalEntry.GetCountry.GetCustom('sr_fl_1_where_name')]"
			}
			blockoverride "dp_strength" {
				raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_strength')|0]/[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_strength_full')|0]#!"
				tooltip = "je_space_race_widget_fl_1_roles_tt"
			}
			blockoverride "dp_dv" {
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_dv_value')|1]"
			}
			blockoverride "dp_supply" {
				raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_supply_value')|0]"
			}
			blockoverride "dp_why_1_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_1_why'), '(CFixedPoint)1' )]"
			}
			blockoverride "dp_why_2_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_1_why'), '(CFixedPoint)2' )]"
			}
			blockoverride "dp_why_3_visible" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_1_why'), '(CFixedPoint)3' )]"
			}
			blockoverride "dp_rows" {
				te_sr_dest_row = {
					blockoverride "dr_visible" {
						visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_loc_value'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "dr_name" {
						text = "sr_loc_name_earth"
					}
					blockoverride "dr_months" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_leg_months_earth')|0]"
					}
					blockoverride "dr_dv_covered" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_dv_value'), JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_leg_dv_earth') )]"
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_leg_dv_earth')|1]"
					}
					blockoverride "dr_dv_short" {
						visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_dv_value'), JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_leg_dv_earth') ) )]"
						raw_text = "#R [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_fl_1_leg_dv_earth')|1]#!"
					}
					blockoverride "dr_win_open_visible" {
						visible = no
					}
					blockoverride "dr_win_wait" {
						visible = no
					}
					blockoverride "dr_worlds" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_loc_worlds_earth')|0]"
					}
					blockoverride "dr_enemy" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_loc_ai_enemy_fleets_earth')|0]"
					}
					blockoverride "dr_inbound" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_loc_hostile_inbound_strength_earth')|0]"
					}
					blockoverride "dr_button" {
						enabled = "[GetScriptedGui('sr_fleet_set_dest_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).AddScope( 'pick', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						onclick = "[GetScriptedGui('sr_fleet_set_dest_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).AddScope( 'pick', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						onclick = "[GetVariableSystem.Clear('te_popup')]"
						tooltip = "[Concatenate( GetScriptedGui('sr_fleet_set_dest_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).AddScope( 'pick', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_fleet_set_dest_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).AddScope( 'pick', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
					}
					blockoverride "dr_choose_visible" {
						visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_1_pick'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "dr_chosen_visible" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_1_pick'), '(CFixedPoint)1' )]"
					}
				}
				te_sr_dest_row = {
