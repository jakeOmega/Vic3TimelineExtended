### Banking — layout. The one place that sets the order of the banking
### sections, for both hosts: the journal entry (je_banking.txt attaches the
### named roots at the foot of this file) and the Budget panel's Banking tab
### (gui/budget_panel.gui instances the composers). The sections are types in
### banking_dashboard_widget.gui (the overview, Active Policies, Monetary
### Policy, Available Interventions), banking_history_widget.gui (the charts)
### and here (How Banking Works), in the shape of the UN's un_layout_widget.gui.
###
### Collapse flags say their default: *_closed sections are open until closed,
### *_open ones collapsed until opened (test_banking_layout.py).

types banking_layout_widget_types
{
	### What a returning player acts on, open by default: what is in force, the
	### dial, and the tools.
	type te_banking_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_banking_sec_active = {}
		te_banking_sec_monetary = {}
		te_banking_sec_interventions = {}
	}

	### "How Banking Works": the explanations, collapsed by default, one heading
	### per topic (style guide rule 1), for the player learning the system. The
	### live sections carry none: a row's tooltip gives its reading and what
	### moves it, each tool's its own, and the rules behind them are here (GUI
	### audit BNK-1, 2026-10-27: the Monetary Policy rows had taught them, at up
	### to 3,800 characters). The monetary topics follow the section's own
	### subheadings, and are shown only while the monetary layer is on (not
	### under banking_system_simplified), as the rows they explain are.
	type te_banking_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		banking_dash_category_header = {
			blockoverride "left_text" {
				text = "banking_dash_how_header"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('banking_dash_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('banking_dash_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('banking_dash_how_open')]"
			}
		}

		flowcontainer = {
			visible = "[GetVariableSystem.Exists('banking_dash_how_open')]"
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 2
			margin = { 8 6 }

			background = {
				using = entry_bg_fancy_dark
				alpha = 0.35
			}

			banking_dash_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_cycle"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_cycle"
			}
			banking_dash_note = {
				text = "banking_dash_how_cycle_moves"
			}
			banking_dash_note = {
				text = "banking_dash_how_start"
			}

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_crashes"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_crashes"
			}

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_budget"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_budget"
			}

			### The monetary layer's topics (not under banking_system_simplified).
			flowcontainer = {
				visible = "[GetScriptedGui('banking_mon_system_shown').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				banking_dash_subheader = {
					blockoverride "subheader_text" {
						text = "banking_dash_how_sub_rate"
					}
				}
				banking_dash_note = {
					text = "banking_dash_how_rate"
				}
				banking_dash_note = {
					text = "banking_dash_how_rate_none"
				}
				banking_dash_note = {
					text = "banking_dash_how_stance"
				}

				banking_dash_subheader = {
					blockoverride "subheader_text" {
						text = "banking_dash_how_sub_mandates"
					}
				}
				banking_dash_note = {
					text = "banking_dash_how_mandates"
				}
				banking_dash_note = {
					text = "banking_dash_how_mandates_change"
				}
				banking_dash_note = {
					text = "banking_dash_how_mandates_floor"
				}

				banking_dash_subheader = {
					blockoverride "subheader_text" {
						text = "banking_dash_how_sub_gold"
					}
				}
				banking_dash_note = {
					text = "banking_dash_how_gold"
				}
				banking_dash_note = {
					text = "banking_dash_how_gold_flow"
				}
				banking_dash_note = {
					text = "banking_dash_how_peg"
				}

				banking_dash_subheader = {
					blockoverride "subheader_text" {
						text = "banking_dash_how_sub_fx"
					}
				}
				banking_dash_note = {
					text = "banking_dash_how_fx"
				}
				banking_dash_note = {
					text = "banking_dash_how_fx_effects"
				}
				banking_dash_note = {
					text = "banking_dash_how_fx_fixed"
				}

				banking_dash_subheader = {
					blockoverride "subheader_text" {
						text = "banking_dash_how_sub_arrangements"
					}
				}
				banking_dash_note = {
					text = "banking_dash_how_anchor"
				}
				banking_dash_note = {
					text = "banking_dash_how_treaty_peg"
				}
				banking_dash_note = {
					text = "banking_dash_how_backstops"
				}
				banking_dash_note = {
					text = "banking_dash_how_union"
				}
				banking_dash_note = {
					text = "banking_dash_how_union_terms"
				}

				banking_dash_subheader = {
					blockoverride "subheader_text" {
						text = "banking_dash_how_sub_borrowing"
					}
				}
				banking_dash_note = {
					text = "banking_dash_how_borrowing"
				}

				banking_dash_subheader = {
					blockoverride "subheader_text" {
						text = "banking_dash_how_sub_prices"
					}
				}
				banking_dash_note = {
					text = "banking_dash_how_prices"
				}
				banking_dash_note = {
					text = "banking_dash_how_expected"
				}
				banking_dash_note = {
					text = "banking_dash_how_printing"
				}
			}
		}
	}

	### The record, then how it all works: the history charts, open by default
	### in both hosts (one shell, closed flag banking_dash_history_closed), and
	### How Banking Works, collapsed, last.
	type te_banking_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_banking_history_panel = {}
		te_banking_sec_how = {}
	}
}

### ==========================================================================
### JOURNAL ENTRY ROOTS (je_banking.txt). Bare wrappers that repeat the
### composers' IsActive gate: je_banking_cycle has is_shown_when_inactive, so
### the panel can open for a country whose entry has not activated yet, and an
### inactive entry's containers must collapse. An active entry may still be
### dormant, its financial cycle not started: the sections that read the cycle
### carry their own banking_dash_cycle_running gate.
### ==========================================================================
flowcontainer = {
	name = "widget_je_banking_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_banking_overview_panel = {}
}

flowcontainer = {
	name = "widget_je_banking_status"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_banking_status_sections = {}
}

flowcontainer = {
	name = "widget_je_banking_reference"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_banking_reference_sections = {}
}
