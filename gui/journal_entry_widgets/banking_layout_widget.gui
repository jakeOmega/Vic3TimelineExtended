### Banking — layout. The one place that sets the order of the banking
### sections, for both hosts: the journal entry (je_banking.txt attaches the
### named roots at the foot of this file) and the Banking tab, in the Budget
### panel and the Timeline Extended window (both mount te_banking_tab_body). The sections are types in
### banking_dashboard_widget.gui (the overview, Active Policies, Monetary
### Policy, Available Interventions), banking_history_widget.gui (the charts)
### and here (Banking's Help page, its body and popup, which the "?" in the
### tab's header and at the top of the entry opens), in the shape of the UN's
### un_layout_widget.gui.
###
### Collapse flags say their default: *_closed sections are open until closed,
### *_open ones collapsed until opened (test_banking_layout.py).

types banking_layout_widget_types
{
	### What a returning player acts on, open by default: what is in force, the
	### dial, and the tools.
	type te_banking_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"

		te_banking_sec_active = {}
		te_banking_sec_monetary = {}
		te_banking_sec_interventions = {}
	}

	### Banking's Help page, the explanations, one heading per topic, for the
	### player learning the system. The live sections carry none: a row's
	### tooltip gives its reading and what moves it, each tool's its own, and
	### the rules behind them are here (GUI audit BNK-1, 2026-10-27: the
	### Monetary Policy rows had taught them, at up to 3,800 characters). The
	### monetary topics follow that section's own subheadings, and are shown
	### only while the player's monetary layer is on (not under
	### banking_system_simplified), as the rows they explain are. It reads
	### GetPlayer only, never the entry, so it opens from any host
	### (test_te_help_pages.py). Instanced only by te_banking_help_popup.
	type te_banking_help_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		banking_dash_subheader = {
			blockoverride "subheader_margin" {}
			blockoverride "subheader_text" {
				text = "banking_dash_how_sub_cycle"
			}
		}
		banking_dash_note = {
			text = "banking_dash_how_cycle"
		}
		banking_dash_note = {
			text = "banking_dash_how_cycle_moves"
		}
		banking_dash_note = {
			text = "banking_dash_how_start"
		}

		banking_dash_subheader = {
			blockoverride "subheader_text" {
				text = "banking_dash_how_sub_crashes"
			}
		}
		banking_dash_note = {
			text = "banking_dash_how_crashes"
		}

		banking_dash_subheader = {
			blockoverride "subheader_text" {
				text = "banking_dash_how_sub_budget"
			}
		}
		banking_dash_note = {
			text = "banking_dash_how_budget"
		}

		### The monetary layer's topics (not under banking_system_simplified).
		flowcontainer = {
			visible = "[GetScriptedGui('banking_mon_system_shown').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			direction = vertical
			ignoreinvisible = yes
			spacing = 4

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_rate"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_rate"
			}
			banking_dash_note = {
				text = "banking_dash_how_rate_none"
			}
			banking_dash_note = {
				text = "banking_dash_how_stance"
			}

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_mandates"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_mandates"
			}
			banking_dash_note = {
				text = "banking_dash_how_mandates_change"
			}
			banking_dash_note = {
				text = "banking_dash_how_mandates_floor"
			}

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_gold"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_gold"
			}
			banking_dash_note = {
				text = "banking_dash_how_gold_flow"
			}
			banking_dash_note = {
				text = "banking_dash_how_peg"
			}

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_fx"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_fx"
			}
			banking_dash_note = {
				text = "banking_dash_how_fx_effects"
			}
			banking_dash_note = {
				text = "banking_dash_how_fx_fixed"
			}

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_arrangements"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_anchor"
			}
			banking_dash_note = {
				text = "banking_dash_how_treaty_peg"
			}
			banking_dash_note = {
				text = "banking_dash_how_backstops"
			}
			banking_dash_note = {
				text = "banking_dash_how_union"
			}
			banking_dash_note = {
				text = "banking_dash_how_union_terms"
			}

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_borrowing"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_borrowing"
			}

			banking_dash_subheader = {
				blockoverride "subheader_text" {
					text = "banking_dash_how_sub_prices"
				}
			}
			banking_dash_note = {
				text = "banking_dash_how_prices"
			}
			banking_dash_note = {
				text = "banking_dash_how_expected"
			}
			banking_dash_note = {
				text = "banking_dash_how_printing"
			}
		}
	}

	### The Help page's popup, in te_popups (gui/te_popups.gui).
	type te_banking_help_popup = te_ui_help_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'help_banking')]"
		}
		blockoverride "popup_title" {
			text = "banking_dash_how_header"
		}
		blockoverride "popup_list" {
			te_banking_help_body = {}
		}
	}

	### The record: the history charts, open by default in both hosts (one
	### shell, closed flag banking_dash_history_closed). Gated on the cycle
	### running as well as the entry, as the charts are: every country holds
	### the entry, dormant until its cycle starts, and an empty composer would
	### still take its host's spacing (a gap above Open Journal Entry).
	type te_banking_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[And( GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('banking_dash_cycle_running').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) )]"

		te_banking_history_panel = {}
	}

	### The Banking tab's body (spec 2026-11-02-te-window-wide-mode § 9.1):
	### te_system_tab_frame with its blocks filled, mounted by the Budget
	### panel's Banking tab and the Timeline Extended window's. Each header has
	### the "?" that opens Banking's Help page (te_help_button). The entry's
	### panels, the same composers the entry attaches, inside
	### te_banking_tab_layout, which a wide mount overrides; then the frame's
	### Open Journal Entry, in the tab's large font. The entry's scripted
	### buttons are not drawn: they are the AI's (each is `is_ai = yes`), and
	### the policy sections carry the same actions.
	###
	### A country with a monetary stance but no entry (#805,
	### te_budget_banking_readout_sgui) gets the monetary readout instead,
	### under a Monetary Policy header, with a note naming what opens the
	### rest. The readout reads Country, the frame's root, so it needs no
	### datacontext. Its gate and the entry's are never true together, so
	### exactly one header shows.
	type te_banking_tab_body = te_system_tab_frame {
		blockoverride "tab_header" {
			default_header = {
				using = default_list_position
				visible = "[Not( GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				blockoverride "text" {
					text = "je_banking_cycle"
				}
				### Show the world's cycle on the map (gui/te_map_widgets.gui; journal_map_modes.md).
				te_jmap_banking_map_button = {}
				te_help_button = {
					visible = "[Not( GetMetaPlayer.IsObserver )]"
					onclick = "[GetVariableSystem.Set('te_popup', 'help_banking')]"
				}
			}

			default_header = {
				using = default_list_position
				visible = "[GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				blockoverride "text" {
					text = "banking_dash_cat_monetary"
				}
				te_help_button = {
					visible = "[Not( GetMetaPlayer.IsObserver )]"
					onclick = "[GetVariableSystem.Set('te_popup', 'help_banking')]"
				}
			}
		}

		blockoverride "tab_before_gate" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_budget_banking_readout_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				using = default_list_position
				direction = vertical
				ignoreinvisible = yes
				spacing = 10

				te_banking_mon_readout = {}

				# What opens the rest: the tab's own unlock checklist on hover,
				# asked IsValid first like the tab's tooltip.
				textbox = {
					parentanchor = hcenter
					autoresize = yes
					multiline = yes
					max_width = 480
					align = center|nobaseline
					using = fontsize_large
					text = "banking_dash_ro_note"
					tooltip = "[SelectLocalization( GetScriptedGui('te_budget_banking_tab_unlock_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'banking_dash_ro_note_tt' ), GetScriptedGui('te_budget_banking_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
				}
			}
		}

		blockoverride "tab_gate" {
			visible = "[GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		blockoverride "tab_entry" {
			datacontext = "[GetPlayerJournalEntry('je_banking_cycle')]"
		}
		blockoverride "tab_entry_modifiers" {
			te_je_modifier_strip = {}
		}

		blockoverride "tab_content" {
			block "te_banking_tab_layout" {
				te_banking_overview_panel = {}
				te_banking_status_sections = {}
				te_banking_reference_sections = {}
			}
		}

		blockoverride "tab_open_journal_font" {
			using = fontsize_large
		}

		blockoverride "tab_open_journal_tooltip" {
			tooltip = "te_budget_banking_open_journal_tt"
		}
	}

	### The Timeline Extended window's full-screen Banking tab (spec
	### 2026-11-02-te-window-wide-mode § 7): the tab's sections in three
	### columns of 520 (te_ui_columns_three), as the owner balanced them
	### (2026-11-03): the overview, what is in force and the interventions
	### open, then the monetary dial, then the record. Each section keeps its narrow gates: the overview its own, the
	### rest their composer's, whose spacing the wrappers repeat. The
	### window's wide mount puts it in te_banking_tab_layout
	### (gen_te_systems_window.py); test_banking_layout.WideTest checks it
	### against the narrow layout.
	type te_banking_wide_sections = te_ui_columns_three {
		blockoverride "column_1" {
			te_banking_overview_panel = {}

			flowcontainer = {
				visible = "[GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
				direction = vertical
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 2

				te_banking_sec_active = {}
				te_banking_sec_interventions = {}
			}
		}

		### Monetary Policy alone: it hides under the simplified rule outside a
		### market economy (banking_dash_monetary_shown), so the column closes
		### up on its gate (column_2_visible) rather than leave an empty band.
		blockoverride "column_2_visible" {
			visible = "[GetScriptedGui('banking_dash_monetary_shown').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
		}

		blockoverride "column_2" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
				direction = vertical
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 2

				te_banking_sec_monetary = {}
			}
		}

		### The record, which waits for the cycle: until it runs the column
		### closes up (column_3_visible), so the two columns of a dormant
		### entry's sections sit centred rather than beside an empty band.
		blockoverride "column_3_visible" {
			visible = "[GetScriptedGui('banking_dash_cycle_running').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
		}

		blockoverride "column_3" {
			te_banking_reference_sections = {}
		}
	}
}

### ==========================================================================
### JOURNAL ENTRY ROOTS (je_banking.txt). Bare wrappers that ask the entry
### what the composers ask its country (te_budget_banking_tab_sgui on
### Country, the entry held): je_banking_cycle has is_shown_when_inactive, so
### the panel can open for a country whose entry has not activated yet, and an
### inactive entry's containers must collapse. An active entry may still be
### dormant, its financial cycle not started: the sections that read the cycle
### carry their own banking_dash_cycle_running gate.
### ==========================================================================
flowcontainer = {
	name = "widget_je_banking_overview"
	visible = "[JournalEntry.IsActive]"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes

	### The "?" to the Help page, at the top of the entry (te_help_row).
	te_help_row = {
		blockoverride "help_onclick" {
			onclick = "[GetVariableSystem.Set('te_popup', 'help_banking')]"
		}
	}

	te_je_country = {
		te_banking_overview_panel = {}
	}
}

flowcontainer = {
	name = "widget_je_banking_status"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_je_country = {
		te_banking_status_sections = {}
	}
}

### The record's root also waits for the cycle, as its composer does, so a
### dormant entry's container_3 collapses instead of leaving the journal's 10.
flowcontainer = {
	name = "widget_je_banking_reference"
	visible = "[And( JournalEntry.IsActive, GetScriptedGui('banking_dash_cycle_running').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_je_country = {
		te_banking_reference_sections = {}
	}
}
