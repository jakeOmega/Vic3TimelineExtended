					tooltip = "je_colonial_empire_drift_rank_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_rank"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_rank_neg') )]"
