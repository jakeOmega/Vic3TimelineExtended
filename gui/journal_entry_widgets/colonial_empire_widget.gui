	### One colonial subject: its flag, name, kind, liberty desire and GDP,
	### then Release (decolonization_events.403, independence) and Dominion
	### (.404, dominion status, for a colony only). An item of the datamodel
	### over colonial_empire_subject_capitals, whose datacontext is the
	### subject's capital (Scope.GetState); the cells reach the subject as
	### State.GetCountry (gotcha #11), and the buttons pass the capital
	### (ce_capital), whose owner script acts on. Both buttons are always drawn
	### and greyed with the reason when they cannot be pressed; their hovers,
	### and every other in the row, are rooted at GetPlayer (gotcha #24).
	###
	### TE_SELF_CHECK ce_subject_row: State.GetCountry from a datamodel item is
	### unproven (gotcha #15 proves it only from a stored variable). The first
	### row drawn in a session reports through one of the two 1x1 widgets
	### below, outside the row's flow so they take no room: ce_check 1 when
	### the row read its subject's name, 0 when it read none
	### (colonial_empire_selfcheck_subject_sgui logs once a game). The client
	### flag stops the other rows asking. Fallback: the play-test list
	### (docs/testing/colonial-holdings-playtest.md).
	type te_ce_subject_row = widget {
		size = { 476 28 }

		widget = {
			size = { 1 1 }
			visible = "[And( Not( GetVariableSystem.Exists('colonial_empire_selfcheck_subject') ), Not( EqualTo_string( State.GetCountry.GetNameNoFormatting, '' ) ) )]"
			state = {
				name = _show
				on_start = "[GetScriptedGui('colonial_empire_selfcheck_subject_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'ce_capital', State.MakeScope ).AddScope( 'ce_check', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				on_start = "[GetVariableSystem.Set( 'colonial_empire_selfcheck_subject', '1' )]"
			}
		}
		widget = {
			size = { 1 1 }
			visible = "[And( Not( GetVariableSystem.Exists('colonial_empire_selfcheck_subject') ), EqualTo_string( State.GetCountry.GetNameNoFormatting, '' ) )]"
			state = {
				name = _show
				on_start = "[GetScriptedGui('colonial_empire_selfcheck_subject_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'ce_capital', State.MakeScope ).AddScope( 'ce_check', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				on_start = "[GetVariableSystem.Set( 'colonial_empire_selfcheck_subject', '1' )]"
			}
		}

		flowcontainer = {
			direction = horizontal
			spacing = 4
			parentanchor = vcenter
			ignoreinvisible = yes

			widget = {
				size = { 28 26 }
				parentanchor = vcenter

				tiny_flag = {
					parentanchor = center
					datacontext = "[State.GetCountry]"
				}
			}
			widget = {
				size = { 134 26 }
				parentanchor = vcenter
				tooltip = "je_colonial_empire_subject_name_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 134
					fontsize_min = 12
					elide = right
					align = left|nobaseline
					using = colonial_empire_fontsize_row
					default_format = "#tooltippable"
					text = "je_colonial_empire_subject_name"
				}
			}
			widget = {
				size = { 38 26 }
				parentanchor = vcenter

				icon = {
					size = { 22 22 }
					parentanchor = center
					texture = "[State.GetCountry.GetSubjectType.GetTexture]"
					tooltip = "je_colonial_empire_subject_kind_tt"
				}
			}
			widget = {
				size = { 34 26 }
				parentanchor = vcenter
				tooltip = "je_colonial_empire_subject_ld_tt"

				textbox = {
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 34
					elide = right
					align = right|nobaseline
					using = colonial_empire_fontsize_row
					default_format = "#tooltippable"
					text = "je_colonial_empire_subject_ld"
				}
			}
			widget = {
				size = { 66 26 }
				parentanchor = vcenter
				tooltip = "je_colonial_empire_subject_gdp_tt"

				textbox = {
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 66
					elide = right
					align = right|nobaseline
					using = colonial_empire_fontsize_row
					default_format = "#tooltippable"
					text = "je_colonial_empire_subject_gdp"
				}
			}
			widget = {
				size = { 72 26 }
				parentanchor = vcenter

				button = {
					using = default_button_action
					size = { 72 26 }
					parentanchor = center
					datacontext = "[GetScriptedGui('colonial_empire_free_subject_sgui')]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'ce_capital', State.MakeScope ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'ce_capital', State.MakeScope ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'ce_capital', State.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'ce_capital', State.MakeScope ).End ) ) )]"

					textbox = {
						parentanchor = center
						align = center|nobaseline
						autoresize = yes
						max_width = 68
						elide = right
						using = colonial_empire_fontsize_row
						text = "je_colonial_empire_btn_release"
					}
				}
			}
			widget = {
				size = { 80 26 }
