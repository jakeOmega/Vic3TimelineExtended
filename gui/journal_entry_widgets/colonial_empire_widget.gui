			default_format = "#tooltippable"
			block "escalation_label" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 76 -1 }
			maximumsize = { 76 -1 }
			parentanchor = vcenter
			elide = right
			align = right|nobaseline
			using = colonial_empire_fontsize_row
			block "escalation_value" {}
		}
	}

	### One programme: its name, its level, what it adds to stability a month
	### now, and a minus and a plus that step it down and up (op codes: the
	### table in this file's header), all at the row size. Its costs, and what
	### each level adds, are on the row's hover (CE-6 of the 2026-10-27 GUI
	### audit: a small four-figure cost line under the name before). Both
	### controls are always drawn; a step that cannot be taken greys out with
	### the reason in its tooltip (IsValidTooltip, then what the step does).
	### Both address colonial_empire_policy_sgui, so the datacontext lives on
	### the type and each row passes its two op codes. Fixed cells,
	### 4 + 230 + 6 + 50 + 6 + 90 + 6 + 76 + 4 = 472: the longest name,
	### "Development Investment", is 22 characters, about 206 units.
	type colonial_empire_policy_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6
		margin = { 4 4 }
		parentanchor = hcenter
		datacontext = "[GetScriptedGui('colonial_empire_policy_sgui')]"

		textbox = {
			autoresize = yes
			minimumsize = { 230 -1 }
			maximumsize = { 230 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			elide = right
			using = colonial_empire_fontsize_row
			default_format = "#tooltippable"
			block "row_label" {}
		}

		widget = {
			size = { 50 26 }
			parentanchor = vcenter

			textbox = {
				parentanchor = center
				autoresize = yes
				max_width = 50
				elide = right
				align = center|nobaseline
				using = colonial_empire_fontsize_row
				block "row_level" {}
			}
		}

		widget = {
			size = { 90 26 }
			parentanchor = vcenter

			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 90
				elide = right
				align = right|nobaseline
				using = colonial_empire_fontsize_row
				block "row_term" {}
			}
		}

		widget = {
			size = { 76 28 }
			parentanchor = vcenter

			flowcontainer = {
				parentanchor = center
				direction = horizontal
				spacing = 12

				button_icon_minus_action = {
					size = { 26 26 }
					parentanchor = vcenter
					block "down_action" {}
				}
				button_icon_plus_action = {
					size = { 26 26 }
					parentanchor = vcenter
					block "up_action" {}
				}
			}
		}
	}

	### One decolonization decision: its name on the left, what it does on
	### hover, and the control that opens its confirmation event beside it
	### (style rule 6; it used to sit under a paragraph, flush left). One row
	### since 2026-10-24, Planned Full Decolonization: releasing one territory
	### or one subject is a button on its own row in the lists above it.
	type colonial_empire_decision_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 10
		margin = { 4 4 }
		datacontext = "[GetScriptedGui('colonial_empire_planned_sgui')]"

		textbox = {
			autoresize = yes
			multiline = yes
			minimumsize = { 300 -1 }
			maximumsize = { 300 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = colonial_empire_fontsize_row
			default_format = "#tooltippable"
			block "row_text" {}
		}

		button = {
			using = default_button_action
			size = { 150 28 }
			parentanchor = vcenter

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 140
				elide = right
				using = colonial_empire_fontsize_row
				text = "je_colonial_empire_btn_open_choice"
			}

			block "row_action" {}
		}
	}

	### ======================================================================
	### OVERVIEW. Always shown, not collapsible (style rule 1).
	### ======================================================================

	### A cell's word or third line (te_banking_ov_word's shape, the cell's 154
	### column at the overview's size). The instance sets the position for the
	### third line (y 46), the text and any hover of its own.
	type te_ce_ov_line = textbox {
		position = { 78 24 }
		autoresize = yes
		max_width = 154
		elide = right
		align = left|nobaseline
		using = colonial_empire_fontsize_overview
	}

	### One programme, in the Programmes cell's icon box: full colour while it
	### runs, dimmed while it does not. Three share the 44 box, two over one,
	### so the instance sets the position; and the texture on both icons, and
	### the visible gate and tooltip on each (te_un_ov_agency's shape).
	type te_ce_ov_programme = widget {
		size = { 22 22 }

		icon = {
			size = { 100% 100% }
			block "lit" {}
			block "programme_texture" {}
		}
		icon = {
			size = { 100% 100% }
			alpha = 0.25
			block "unlit" {}
			block "programme_texture" {}
		}
	}

	### Great-power prestige as a pie: the condemners' share and, beside it in
	### its own colour, the supporters' share, over a background disc inside
	### vanilla's decorated round frame (te_un_ov_pie's shape; the recipe is
	### "Pie charts of script-held data" in gui_modding_guide.md). Stacked
	### largest first: the supporters' layer fills to the sum of both shares
	### and the condemners' layer on top to its own, so each shows as its own
	### slice. Frame 1 of each texture is transparent, frame 2 the colour. The
	### legend beside it names the slices (te_ce_ov_legend_row).
	type te_ce_ov_pie = widget {
		size = { 86 86 }

		icon = {
			size = { 86 86 }
			parentanchor = top|hcenter
			texture = "gfx/interface/backgrounds/round_frame_dec.dds"
		}
		widget = {
			size = { 62 62 }
			parentanchor = top|hcenter
			position = { 0 12 }

			progresspie = {
				size = { 100% 100% }
				min = 0
				max = 1
				value = 1
				texture = "gfx/interface/icons/colonial_empire_icons/pie_rest.dds"
				framesize = { 128 128 }
				frame = 2
			}
			progresspie = {
				size = { 100% 100% }
				min = 0
				max = 1
				block "pie_value_cum" {}
				texture = "gfx/interface/icons/colonial_empire_icons/pie_supporters.dds"
				framesize = { 128 128 }
				frame = 2
			}
			progresspie = {
				size = { 100% 100% }
				min = 0
				max = 1
				block "pie_value" {}
				texture = "gfx/interface/icons/colonial_empire_icons/pie_condemners.dds"
				framesize = { 128 128 }
				frame = 2
			}
		}
	}

	### One line of the pie's legend: its slice's texture as a swatch (frame 2
	### is the coloured disc, as in ch_model_legend_row) and the share, with
	### what that share does on hover (CE-7: a note under the legend before).
	type te_ce_ov_legend_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6

		icon = {
			size = { 14 14 }
			parentanchor = vcenter
			framesize = { 128 128 }
			frame = 2
			block "legend_swatch" {}
		}
		textbox = {
			autoresize = yes
			max_width = 180
			elide = right
			parentanchor = vcenter
			align = nobaseline
			using = colonial_empire_fontsize_overview
			default_format = "#tooltippable"
			block "legend_text" {}
		}
	}

	### What a returning player checks: where the bar is and which way it is
	### moving; then four cells in Banking's pattern (te_banking_ov_cell, the
	### owner's call of 2026-10-27, CE's overview in the GUI audit): the band
	### and where the next one begins, the great powers' pressure and any
	### escalation in force, what holds the entry, and the programmes running.
	### Each cell's word is the status, red or orange where something is due,
	### its third line the one figure, its hover the breakdown. Then how close
	### the empire is to winning once it is Solidified, and how much of the
	### great powers' weight condemns or backs us.
	type te_ce_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		visible = "[JournalEntry.IsActive]"

		colonial_empire_panel = {
			### Pinned to the 480 column. A frame whose width comes from its content
			### is centred by the width it had at first layout, and the completion
			### clocks appear later, behind their gate (Nuclear and Global Warming
			### drew off-centre until pinned, play-test 2026-09-29).
			flowcontainer = {
				direction = vertical
				spacing = 10
				ignoreinvisible = yes
				minimumsize = { 480 -1 }
				maximumsize = { 480 -1 }

				### Before the first monthly assessment (a save upgraded mid-entry):
				### one line in place of the rows that read the snapshot.
				colonial_empire_text = {
					visible = "[Not(GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
					text = "je_colonial_empire_conditions_pending"
				}

				### Row 1: the stability bar, where it is heading, a line where the
				### next band begins, the value and this month's projected change, and
				### its direction. Reached the way vanilla's journal panel reaches it,
				### through the entry's own datamodel (one scripted bar, so one item).
				### The row's tooltip is the engine's own term-by-term breakdown, which
				### reads only the ScriptedProgressBar. Gotcha #24: a tooltip in a
				### datamodel item has no JournalEntry, so the value's and the line's
				### own hovers read GetPlayer (the entry's owner: a player sees only
				### his own journal). Everything else in the row is a widget property or
				### text, which does see JournalEntry. Four fixed cells, 90 + 180 + 145
				### + 24 and three 8 px gaps = 463: "100% (-1.67/mo)" is 15 characters,
				### about 142 units at the overview's size (it elided in 120,
				### play-test round 3).
				###
				### THE BAR (play-test round 3, 2026-09-30; the Global Warming bar's
				### construction, e4db4ce9). Five layers in one fixed 180 x 18 cell,
				### bottom to top, so the solid fill is always the lower of today's
				### stability and where it is heading, and the translucent stretch runs
				### to the higher:
				###   1. default_progressbar_horizontal at value 0: the bar's own
				###      background and frame, no fill.
				###   2. Rising (colonial_empire_disp_trend 1): green_progressbar_horizontal's
				###      fill at 40% (a wrapper widget, alpha = 0.4), blanked, up to the
				###      higher value, where the bar is heading. Green because rising
				###      stability is good for the player.
				###   3. Falling (colonial_empire_disp_trend -1): bad_progressbar_horizontal's
				###      red fill at 50%, blanked, up to the higher value, today's: the
				###      stretch about to be lost. Red because falling is bad.
				###   4. default_progressbar_horizontal's own fill, background and frame
				###      blanked, up to the lower of the two: solid.
				###   5. The next band's edge as a thin 3 px cream line (a progressbar
				###      marker drawn with white.dds tinted by `color`), with its own
				###      hover. In bands 1-4 only (colonial_empire_disp_next_tick): in
				###      the top band the edge is the bar's end, which the completion
				###      clocks below count toward.
				### "Where it is heading" is stability in colonial_empire_projection_months
				### (12) at this month's projected change (colonial_empire_disp_projected),
				### and today's value is colonial_empire_live_bar, the bar read as a whole
				### number. No eye marker.
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					parentanchor = hcenter
					datamodel = "[JournalEntry.GetScriptedProgressBars]"

					item = {
						flowcontainer = {
							direction = horizontal
							spacing = 8
							ignoreinvisible = yes
							tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"

							textbox = {
								minimumsize = { 90 -1 }
								maximumsize = { 90 -1 }
								autoresize = yes
								parentanchor = vcenter
								align = left|nobaseline
								elide = right
								using = colonial_empire_fontsize_overview
								text = "je_colonial_empire_ov_stability_label"
							}
							widget = {
								size = { 180 18 }
								parentanchor = vcenter

								# 1. Background and frame.
								default_progressbar_horizontal = {
									size = { 100% 100% }
									blockoverride "values" {
										value = 0
										min = 0
										max = 1
									}
								}
								# 2. Rising, good: the green stretch to where it is heading.
								widget = {
									size = { 100% 100% }
									alpha = 0.4
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_trend'), '(CFixedPoint)1' )]"

									green_progressbar_horizontal = {
										size = { 100% 100% }
										blockoverride "background" {}
										blockoverride "frame" {}
										blockoverride "values" {
											value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_bar_high_frac') )]"
											min = 0
											max = 1
										}
									}
								}
								# 3. Falling, bad: the red stretch from where it is heading up to today.
								widget = {
									size = { 100% 100% }
									alpha = 0.5
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_trend'), '(CFixedPoint)-1' )]"

									bad_progressbar_horizontal = {
										size = { 100% 100% }
										blockoverride "background" {}
										blockoverride "frame" {}
										blockoverride "values" {
											value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_bar_high_frac') )]"
											min = 0
											max = 1
										}
									}
								}
								# 4. Solid: the lower of today and where it is heading.
								default_progressbar_horizontal = {
									size = { 100% 100% }
									blockoverride "background" {}
									blockoverride "frame" {}
									blockoverride "values" {
										value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_bar_low_frac') )]"
										min = 0
										max = 1
									}
								}
								# 5. The next band's edge: a thin line with its own hover.
								progressbar = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_next_tick'), '(CFixedPoint)1' )]"
									noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
									progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
									size = { 100% 100% }
									skip_initial_animation = yes
									direction = horizontal
									value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_next_boundary_frac') )]"
									min = 0
									max = 1
									marker = {
										icon = {
											size = { 3 24 }
											parentanchor = vcenter
											widgetanchor = center
											texture = "gfx/interface/backgrounds/white.dds"
											color = { 0.96 0.90 0.72 0.95 }
											tooltip = "je_colonial_empire_ov_tick_tt"
										}
									}
								}
							}
							textbox = {
								minimumsize = { 145 -1 }
								maximumsize = { 145 -1 }
								autoresize = yes
								parentanchor = vcenter
								align = left|nobaseline
								using = colonial_empire_fontsize_overview
								default_format = "#tooltippable"
								elide = right
								text = "je_colonial_empire_ov_stability_value"
								tooltip = "je_colonial_empire_ov_heading_tt"
							}
							widget = {
								size = { 24 24 }
								parentanchor = vcenter

								icon = {
									size = { 24 24 }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_trend'), '(CFixedPoint)1' )]"
									texture = "gfx/interface/icons/generic_icons/trend_up.dds"
								}
								icon = {
									size = { 24 24 }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_trend'), '(CFixedPoint)-1' )]"
									texture = "gfx/interface/icons/generic_icons/trend_down.dds"
								}
								icon = {
									size = { 24 24 }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_trend'), '(CFixedPoint)0' )]"
									texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
								}
							}
						}
					}
				}

				### Rows 2 and 3: the four cells, two to a row (238 + 4 + 238 = 480).
				flowcontainer = {
					direction = vertical
					spacing = 4
					ignoreinvisible = yes
					parentanchor = hcenter
					visible = "[GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					flowcontainer = {
						direction = horizontal
						spacing = 4
						ignoreinvisible = yes

						### The band: its icon and name, coloured as the band is
						### (red in the two lowest), and where the next one begins
						### under it, in bands 1-4; that line's hover is the bar's line's.
						### The cell's hover is the entry's status line and the modifier
						### the band puts on the entry.
						te_banking_ov_cell = {
							tooltip = "je_colonial_empire_ov_band_tt"
							blockoverride "caption" {
								text = "je_colonial_empire_ov_band_label"
							}
							blockoverride "icons" {
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)5' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/band_solidified.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)4' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/band_stable.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)3' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/band_strained.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)2' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/band_crumbling.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)1' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/band_collapsing.dds"
								}
							}
							blockoverride "word" {
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)5' )]"
									text = "je_colonial_empire_band_solidified"
								}
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)4' )]"
									text = "je_colonial_empire_band_stable"
								}
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)3' )]"
									text = "je_colonial_empire_band_strained"
								}
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)2' )]"
									text = "je_colonial_empire_band_crumbling"
								}
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)1' )]"
									text = "je_colonial_empire_band_collapsing"
								}
							}
							blockoverride "third_line" {
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_next_tick'), '(CFixedPoint)1' )]"
									position = { 78 46 }
									default_format = "#tooltippable"
									tooltip = "je_colonial_empire_ov_tick_tt"
									text = "je_colonial_empire_ov_next"
								}
							}
						}

						### The great powers: the escalation in force (diplomatic
						### isolation, orange; international consensus, red), each with
						### its own hover, and what they do to stability a month. The
						### cell's hover counts them; International Pressure lists them.
						te_banking_ov_cell = {
							tooltip = "je_colonial_empire_ov_gp_tt"
							blockoverride "caption" {
								text = "je_colonial_empire_ov_gp_label"
							}
							blockoverride "icons" {
								icon = {
									size = { 100% 100% }
									alpha = 0.25
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_level'), '(CFixedPoint)0' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/alert_isolation.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_level'), '(CFixedPoint)1' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/alert_isolation.dds"
								}
								icon = {
									size = { 100% 100% }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_level'), '(CFixedPoint)2' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/alert_consensus.dds"
								}
							}
							blockoverride "word" {
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_level'), '(CFixedPoint)0' )]"
									text = "je_colonial_empire_ov_gp_calm"
								}
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_level'), '(CFixedPoint)1' )]"
									default_format = "#tooltippable"
									tooltip = "je_colonial_empire_ov_isolation_tt"
									text = "je_colonial_empire_ov_isolation"
								}
								te_ce_ov_line = {
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_level'), '(CFixedPoint)2' )]"
									default_format = "#tooltippable"
									tooltip = "je_colonial_empire_ov_consensus_tt"
									text = "je_colonial_empire_ov_consensus"
								}
							}
							blockoverride "third_line" {
								te_ce_ov_line = {
									position = { 78 46 }
									text = "je_colonial_empire_ov_gp_net"
								}
							}
						}
					}

					flowcontainer = {
						direction = horizontal
						spacing = 4
						ignoreinvisible = yes

						### What holds the entry, the answer to "why is this running for
						### us?": the colonies and the colonial subjects, from the monthly
						### snapshot, the colony icon lit while there is a colony. Each is
						### listed, with its buttons, in Colonial Holdings.
						te_banking_ov_cell = {
							tooltip = "je_colonial_empire_ov_held_tt"
							blockoverride "caption" {
								text = "je_colonial_empire_ov_held_label"
							}
							blockoverride "icons" {
								icon = {
									size = { 100% 100% }
									visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_colonies'), '(CFixedPoint)0' )]"
									texture = "gfx/interface/icons/colonial_empire_icons/territory_colony.dds"
								}
								icon = {
									size = { 100% 100% }
									alpha = 0.25
									visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_colonies'), '(CFixedPoint)0' ) )]"
									texture = "gfx/interface/icons/colonial_empire_icons/territory_colony.dds"
								}
							}
							blockoverride "word" {
								te_ce_ov_line = {
									text = "je_colonial_empire_ov_held_colonies"
								}
							}
							blockoverride "third_line" {
								te_ce_ov_line = {
									position = { 78 46 }
									text = "je_colonial_empire_ov_held_subjects"
								}
							}
						}

						### The three programmes, lit while they run, from the same
						### scope-free handlers that decide nothing else; how many run,
						### and what they add to stability a month. The cell's hover
						### gives each one's level.
						te_banking_ov_cell = {
							tooltip = "je_colonial_empire_ov_programmes_tt"
							blockoverride "caption" {
								text = "je_colonial_empire_ov_programmes_label"
							}
							blockoverride "icons" {
								te_ce_ov_programme = {
									position = { 0 0 }
									blockoverride "programme_texture" {
										texture = "gfx/interface/icons/colonial_empire_icons/programme_invest.dds"
									}
									blockoverride "lit" {
										visible = "[GetScriptedGui('colonial_empire_active_invest_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
										tooltip = "je_colonial_empire_ov_invest_on_tt"
									}
									blockoverride "unlit" {
										visible = "[Not(GetScriptedGui('colonial_empire_active_invest_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
										tooltip = "je_colonial_empire_ov_invest_off_tt"
									}
								}
								te_ce_ov_programme = {
									position = { 22 0 }
									blockoverride "programme_texture" {
										texture = "gfx/interface/icons/colonial_empire_icons/programme_garrison.dds"
									}
									blockoverride "lit" {
										visible = "[GetScriptedGui('colonial_empire_active_garrison_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
										tooltip = "je_colonial_empire_ov_garrison_on_tt"
									}
									blockoverride "unlit" {
										visible = "[Not(GetScriptedGui('colonial_empire_active_garrison_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
										tooltip = "je_colonial_empire_ov_garrison_off_tt"
									}
								}
								te_ce_ov_programme = {
									position = { 11 22 }
									blockoverride "programme_texture" {
										texture = "gfx/interface/icons/colonial_empire_icons/programme_assimilation.dds"
									}
									blockoverride "lit" {
										visible = "[GetScriptedGui('colonial_empire_active_assimilation_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
										tooltip = "je_colonial_empire_ov_assimilation_on_tt"
									}
									blockoverride "unlit" {
										visible = "[Not(GetScriptedGui('colonial_empire_active_assimilation_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
										tooltip = "je_colonial_empire_ov_assimilation_off_tt"
									}
								}
							}
							blockoverride "word" {
								te_ce_ov_line = {
									text = "je_colonial_empire_ov_programmes_running"
								}
							}
							blockoverride "third_line" {
								te_ce_ov_line = {
									position = { 78 46 }
									text = "je_colonial_empire_ov_programmes_net"
								}
							}
						}
					}
				}

				### Row 4, in the top band only: the completion clocks, each a bar whose
				### end is its target. Months held at 100 against
				### colonial_empire_completion_months, the count je_colonial_empire's
				### `complete` reads; and, for a great power, the months Solidified against
				### colonial_empire_federation_months, the Imperial Federation Act's gate.
				flowcontainer = {
					direction = vertical
					spacing = 4
					ignoreinvisible = yes
					parentanchor = hcenter
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_tier'), '(CFixedPoint)5' )]"

					flowcontainer = {
						direction = vertical
						spacing = 2
						parentanchor = hcenter
						tooltip = "je_colonial_empire_ov_hold_tt"

						textbox = {
							autoresize = yes
							parentanchor = hcenter
							align = hcenter|nobaseline
							using = colonial_empire_fontsize_overview
							default_format = "#tooltippable"
							text = "je_colonial_empire_ov_hold"
						}
						default_progressbar_horizontal = {
							size = { 240 12 }
							parentanchor = hcenter
							blockoverride "values" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_at_100_frac') )]"
								min = 0
								max = 1
							}
						}
					}
					flowcontainer = {
						direction = vertical
						spacing = 2
						parentanchor = hcenter
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_act_in_reach'), '(CFixedPoint)1' )]"
						tooltip = "je_colonial_empire_ov_act_tt"

						textbox = {
							autoresize = yes
							parentanchor = hcenter
							align = hcenter|nobaseline
							using = colonial_empire_fontsize_overview
							default_format = "#tooltippable"
							text = "je_colonial_empire_ov_act"
						}
						default_progressbar_horizontal = {
							size = { 240 12 }
							parentanchor = hcenter
							blockoverride "values" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_solidified_frac') )]"
								min = 0
								max = 1
							}
						}
					}
				}

				### Row 5: the great powers' prestige. The pie is great-power prestige
				### (ours included): the condemners' share, the number the two
				### escalations fire on, and the supporters' share in its own colour,
				### which no escalation reads. Each legend line says what its share
				### does on hover; the Great Powers cell above carries the escalation
				### in force.
				flowcontainer = {
					direction = horizontal
					spacing = 8
					ignoreinvisible = yes
					parentanchor = hcenter
					visible = "[GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					te_ce_ov_pie = {
						parentanchor = vcenter
						tooltip = "je_colonial_empire_ov_pie_tt"
						blockoverride "pie_value_cum" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_cum') )]"
						}
						blockoverride "pie_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_condemner_share') )]"
						}
					}
					flowcontainer = {
						direction = vertical
						spacing = 2
						ignoreinvisible = yes
						parentanchor = vcenter
						minimumsize = { 200 -1 }
						maximumsize = { 200 -1 }

						te_ce_ov_legend_row = {
							tooltip = "je_colonial_empire_ov_legend_condemn_tt"
							blockoverride "legend_swatch" {
								texture = "gfx/interface/icons/colonial_empire_icons/pie_condemners.dds"
							}
							blockoverride "legend_text" {
								text = "je_colonial_empire_ov_legend_condemn"
							}
						}
						te_ce_ov_legend_row = {
							tooltip = "je_colonial_empire_ov_legend_support_tt"
							blockoverride "legend_swatch" {
								texture = "gfx/interface/icons/colonial_empire_icons/pie_supporters.dds"
							}
							blockoverride "legend_text" {
								text = "je_colonial_empire_ov_legend_support"
							}
						}
					}
				}
			}
		}
	}

	### ======================================================================
	### SECTIONS. Each is composed, in order, by te_ce_status_sections or
	### te_ce_reference_sections below.
	### ======================================================================

	### Why stability is moving: the terms of the bar's formula as pillar bars
	### (colonial_empire_pillar_row, the UN's "why authority is moving" rows;
	### play-test round 3), then the monthly limit and the total. The eligible
	### territories that used to follow are the Colonial Holdings section's
	### list (te_ce_sec_holdings) since 2026-10-24. Open by default (the CLOSED
	### flag). Each
	### row's tooltip says what the term holds; the explanations are in "How
	### the Colonial Empire Works".
	type te_ce_sec_stability = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_stability_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_stability_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('colonial_empire_stability_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_stability_closed'))]"
			}
		}

		colonial_empire_panel = {
			visible = "[Not(GetVariableSystem.Exists('colonial_empire_stability_closed'))]"

			# Shown for a save upgraded mid-entry, until the first pulse.
			colonial_empire_text = {
				visible = "[Not(GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
				text = "je_colonial_empire_conditions_pending"
			}

			# Six terms read live (a click moves them the next frame); the
			# three that iterate — overreach, great-power pressure, acceptance —
			# read this month's snapshot, behind the display_ready gate. Each bar
			# spans its term's range (colonial_pillar_* in
			# colonial_empire_values.txt, where each range's derivation is noted).
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				visible = "[GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				# A constant, so no bar.
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_base_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_base"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_stability_drift_base')|=+2]"
					}
				}
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_laws_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_laws"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_laws_neg') )]"
							}
							blockoverride "value_right" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_laws_pos') )]"
							}
						}
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_stability_drift_laws')|=+2]"
					}
				}
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_igs_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_igs"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_igs_neg') )]"
							}
							blockoverride "value_right" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_igs_pos') )]"
							}
						}
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_stability_drift_igs')|=+2]"
					}
				}
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_rank_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_rank"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_rank_neg') )]"
							}
							blockoverride "value_right" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_rank_pos') )]"
							}
						}
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_stability_drift_rank')|=+2]"
					}
				}
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_policies_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_policies"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_policies_neg') )]"
							}
							blockoverride "value_right" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_policies_pos') )]"
							}
						}
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_stability_drift_policies')|=+2]"
					}
				}
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_domestic_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_domestic"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_domestic_neg') )]"
							}
							blockoverride "value_right" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_domestic_pos') )]"
							}
						}
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_stability_drift_domestic')|=+2]"
					}
				}
				# The three that iterate read this month's snapshot, through the guarded
				# colonial_empire_disp_d_* values.
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_overreach_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_overreach"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_overreach_neg') )]"
							}
							blockoverride "value_right" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_overreach_pos') )]"
							}
						}
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_d_overreach')|=+2]"
					}
				}
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_gp_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_gp"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_gp_neg') )]"
							}
							blockoverride "value_right" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_gp_pos') )]"
							}
						}
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_d_gp')|=+2]"
					}
				}
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_acceptance_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_acceptance"
					}
					blockoverride "row_bar" {
						double_direction_progressbar = {
							size = { 190 14 }
							blockoverride "value_left" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_acceptance_neg') )]"
							}
							blockoverride "value_right" {
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pillar_acceptance_pos') )]"
							}
						}
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_d_acceptance')|=+2]"
					}
				}

				divider_clean = {
					blockoverride "size" {
						size = { 480 2 }
					}
				}

				# What the monthly limit takes off, so the rows add up to the total.
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_cap_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_cap"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_stability_drift_cap_display')|=+2]"
					}
				}
				colonial_empire_pillar_row = {
					tooltip = "je_colonial_empire_drift_total_tt"
					blockoverride "row_label" {
						text = "je_colonial_empire_drift_total"
					}
					blockoverride "row_value" {
						text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_stability_drift_total_display')|=+2]"
					}
				}
			}
		}
	}

	### International pressure: a row per great power that condemns or backs
	### us, condemners first, each by its prestige, with what it does to
	### stability a month (CE-2 of the 2026-10-27 GUI audit: a script-built
	### roster in the row font before, which repeated the overview pie's two
	### shares and gave no power's weight). Then the escalation in force, if
	### any: the one great-power loss no single power makes. The rows are the
	### monthly assessment's (colonial_empire_refresh_gp_rows), so the panel
	### walks no country. Open by default, a live list.
	type te_ce_sec_pressure = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_pressure_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_pressure_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('colonial_empire_pressure_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_pressure_closed'))]"
			}
		}

		colonial_empire_panel = {
			visible = "[Not(GetVariableSystem.Exists('colonial_empire_pressure_closed'))]"

			# Shown for a save upgraded mid-entry, until the first pulse.
			colonial_empire_text = {
				visible = "[Not(GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
				text = "je_colonial_empire_conditions_pending"
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2
				visible = "[GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				te_ce_gp_head = {
					visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('colonial_empire_gp_rows') ) )]"
				}
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('colonial_empire_gp_rows')]"

					item = {
						te_ce_gp_row = {
							datacontext = "[Scope.GetScriptContainer]"
						}
					}
				}
				colonial_empire_list_text = {
					visible = "[IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('colonial_empire_gp_rows') )]"
					text = "je_colonial_empire_pressure_none"
				}

				# The escalations in force (colonial_empire_disp_pressure_level: 1
				# diplomatic isolation, 2 both, as they stack).
				te_ce_escalation_row = {
					visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_level'), '(CFixedPoint)1' )]"
					tooltip = "je_colonial_empire_ov_isolation_tt"
					blockoverride "escalation_label" {
						text = "je_colonial_empire_pressure_isolation"
					}
					blockoverride "escalation_value" {
						text = "je_colonial_empire_pressure_isolation_value"
					}
				}
				te_ce_escalation_row = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_pressure_level'), '(CFixedPoint)2' )]"
					tooltip = "je_colonial_empire_ov_consensus_tt"
					blockoverride "escalation_label" {
						text = "je_colonial_empire_pressure_consensus"
					}
					blockoverride "escalation_value" {
						text = "je_colonial_empire_pressure_consensus_value"
					}
				}
			}
		}
	}

	### The three colonial programmes, each with its level, what it adds to
	### stability a month, and the minus and plus that step it; its costs on
	### hover. Open by default.
	type te_ce_sec_programmes = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_programmes_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_programmes_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('colonial_empire_programmes_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_programmes_closed'))]"
			}
		}

		colonial_empire_panel = {
			visible = "[Not(GetVariableSystem.Exists('colonial_empire_programmes_closed'))]"

			# Development Investment — op 0 raise / op 1 lower
			colonial_empire_policy_row = {
				tooltip = "je_colonial_empire_tt_invest"
				blockoverride "row_label" {
					text = "je_colonial_empire_row_invest_short"
				}
				blockoverride "row_term" {
					text = "je_colonial_empire_term_invest"
				}
				blockoverride "row_level" {
					text = "je_colonial_empire_level_invest"
				}
				blockoverride "down_action" {
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
				}
				blockoverride "up_action" {
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
				}
			}

			# Military Garrison — op 2 raise / op 3 lower
			colonial_empire_policy_row = {
				tooltip = "je_colonial_empire_tt_garrison"
				blockoverride "row_label" {
					text = "je_colonial_empire_row_garrison_short"
				}
				blockoverride "row_term" {
					text = "je_colonial_empire_term_garrison"
				}
				blockoverride "row_level" {
					text = "je_colonial_empire_level_garrison"
				}
				blockoverride "down_action" {
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ) ) )]"
				}
				blockoverride "up_action" {
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
				}
			}

			# Cultural Assimilation — op 4 raise / op 5 lower
			colonial_empire_policy_row = {
				tooltip = "je_colonial_empire_tt_assimilation"
				blockoverride "row_label" {
					text = "je_colonial_empire_row_assimilation_short"
				}
				blockoverride "row_term" {
					text = "je_colonial_empire_term_assimilation"
				}
				blockoverride "row_level" {
					text = "je_colonial_empire_level_assimilation"
				}
				blockoverride "down_action" {
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ) ) )]"
				}
				blockoverride "up_action" {
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ) ) )]"
				}
			}
		}
	}

	### What holds the entry, and what can be done with each part of it: the
	### territories (the colonies and every other territory the decisions can
	### take) and the colonial subjects, each with its own buttons beside it,
	### then Planned Full Decolonization for the whole empire. The owner's
	### request (2026-10-24): show why the entry runs, and put an action that
	### targets a territory or a subject beside that target rather than behind
	### a button that asks which. First of the live sections, under the
	### overview's Holdings cell, which counts them; open by default (the CLOSED
	### flag), as a live list is (rule 1).
	###
	### Each list is a datamodel over the monthly snapshot
	### colonial_empire_refresh_display takes, every release bloc and every
	### colonial subject by GDP, players only (CE-1 of the 2026-10-27 GUI
	### audit: the first eight in fixed rows and the rest named in a "+N more"
	### hover before, with no button). The columns explain themselves on their
	### heads' hovers, so no caption repeats them (CE-3). A button opens a
	### confirmation for its one target (decolonization_events.402-.404), whose
	### default is Reconsider; one confirmation can be open at a time, and the
	### others grey out until it is answered.
	type te_ce_sec_holdings = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_holdings_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_holdings_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('colonial_empire_holdings_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_holdings_closed'))]"
			}
		}

		colonial_empire_panel = {
			visible = "[Not(GetVariableSystem.Exists('colonial_empire_holdings_closed'))]"

			# Shown for a save upgraded mid-entry, until the first pulse.
			colonial_empire_text = {
				visible = "[Not(GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
				text = "je_colonial_empire_conditions_pending"
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2
				visible = "[GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				# --- Wars of independence ------------------------------------
				# A row per war we are fighting, while there is one: the
				# records decol_iw_rebels_1..3 (decolonization_war_effects.txt),
				# each row on its rebels' capital (decol_iw_state_N).
				colonial_empire_subheader = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_wars'), '(CFixedPoint)0' )]"
					blockoverride "subheader_margin" {
						margin_top = 0
					}
					blockoverride "subheader_text" {
						text = "je_colonial_empire_holdings_wars"
						tooltip = "je_colonial_empire_holdings_wars_tt"
					}
				}
				te_ce_war_head = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_wars'), '(CFixedPoint)0' )]"
				}
				te_ce_war_row = {
					blockoverride "row_visible" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_slot_1'), '(CFixedPoint)1' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('decol_iw_state_1').GetState]"
					}
				}
				te_ce_war_row = {
					blockoverride "row_visible" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_slot_2'), '(CFixedPoint)1' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('decol_iw_state_2').GetState]"
					}
				}
				te_ce_war_row = {
					blockoverride "row_visible" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_slot_3'), '(CFixedPoint)1' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('decol_iw_state_3').GetState]"
					}
				}

				# --- Territories -------------------------------------------
				# Every state of ours that is_decolonization_eligible_state (a
				# colonial territory, the concept), the test Planned Full
				# Decolonization and the Release buttons use. One row per
				# release bloc, the states one release takes together
				# (colonial_empire_mark_release_blocs). The colony icon is lit for
				# a bloc with a state that also meets is_overseas_colonial_state,
				# the test that keeps the entry running.
				colonial_empire_subheader = {
					blockoverride "subheader_margin" {
						margin_top = 0
					}
					blockoverride "subheader_text" {
						text = "je_colonial_empire_holdings_territories"
						tooltip = "je_colonial_empire_holdings_territories_tt"
					}
				}
				te_ce_territory_head = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territories_eligible'), '(CFixedPoint)0' )]"
				}
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('colonial_empire_blocs')]"

					item = {
						te_ce_territory_row = {
							datacontext = "[Scope.GetState]"
						}
					}
				}
				# None eligible (a country held by its colonial subjects alone, say).
				colonial_empire_list_text = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territories_eligible'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_territories_none"
				}
				# Eligible territories but no stored rows yet: a save upgraded
				# mid-entry, until the next monthly assessment.
				colonial_empire_list_text = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territories_pending'), '(CFixedPoint)1' )]"
					text = "je_colonial_empire_conditions_pending"
				}

				# --- Colonial subjects ---------------------------------------
				# Every subject, at any depth, that is_qualifying_colonial_subject
				# (a colonial subject, the concept): a colony, a chartered company,
				# or an overseas protectorate whose people share no heritage with
				# ours. Release and Dominion act on our direct subjects; a
				# subject's own subject greys them, with the reason on hover.
				colonial_empire_subheader = {
					blockoverride "subheader_text" {
						text = "je_colonial_empire_holdings_subjects"
						tooltip = "je_colonial_empire_holdings_subjects_tt"
					}
				}
				te_ce_subject_head = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subjects'), '(CFixedPoint)0' )]"
				}
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('colonial_empire_subject_capitals')]"

					item = {
						te_ce_subject_row = {
							datacontext = "[Scope.GetState]"
						}
					}
				}
				colonial_empire_list_text = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subjects'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_subjects_none"
				}

				# --- The whole empire ----------------------------------------
				colonial_empire_subheader = {
					blockoverride "subheader_text" {
						text = "je_colonial_empire_holdings_whole"
					}
				}
				colonial_empire_decision_row = {
					blockoverride "row_text" {
						text = "je_colonial_empire_decision_planned"
						tooltip = "je_colonial_empire_decision_planned_tt"
					}
					blockoverride "row_action" {
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
					}
				}
			}
		}
	}

	### The history charts. Open by default, as the UN's is (the owner's call
	### for the UN, 2026-09-28; rule 1: what changes month to month is open).
	###
	### te_history_chart / te_history_bar_unsigned / te_history_bar_signed /
	### te_history_range_button are declared in
	### gui/journal_entry_widgets/te_history_chart.gui. Types declared in a .gui
	### file are global once loaded, so they are instanced here without
	### including it. `te_hist_range` is a single global GUI variable shared with
	### every other history chart: changing the range here changes it there too.
	type te_ce_sec_history = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_history_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_history_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('colonial_empire_history_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_history_closed'))]"
			}
		}

		colonial_empire_panel = {
			visible = "[Not(GetVariableSystem.Exists('colonial_empire_history_closed'))]"

			# ---- Range ----
			flowcontainer = {
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes
				parentanchor = hcenter

				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_1y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '1' ))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '1' )]"
					}
				}
				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_5y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '5' ))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '5' )]"
					}
				}
				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_20y"
					}
					blockoverride "range_enabled" {
						enabled = "[Or( GetVariableSystem.HasValue( 'te_hist_range', '1' ), GetVariableSystem.HasValue( 'te_hist_range', '5' ) )]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '20' )]"
					}
				}
			}

			textbox = {
				visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('te_hist') ) )]"
				parentanchor = hcenter
				autoresize = yes
				multiline = yes
				max_width = 480
				align = hcenter|nobaseline
				text = "te_hist_since"
			}

			# ---- Colonial stability, 0-100 ----
			# Sampled to the nearest 5 (see colonial_empire_refresh_display: the bar
			# is trigger-only, so a comparison ladder is the only read). The legend
			# says so.
			te_history_chart = {
				blockoverride "chart_title" {
					text = "te_hist_chart_colonial_stability_title"
				}
				blockoverride "chart_legend" {
					text = "te_hist_chart_colonial_stability_legend"
				}
				# This series records no markers; the store's pips belong to
				# other systems (banking, cultural hegemony) and would go unexplained.
				blockoverride "marker_pips" {}
				blockoverride "bar_tooltip" {
					tooltip = "te_hist_tt_colonial_stability"
				}
				blockoverride "bar_body" {
					te_history_bar_unsigned = {
						visible = "[ScriptContainer.HasVariable( 'te_hist_v_colonial_stability' )]"
						blockoverride "values" {
							min = 0
							max = 100
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_colonial_stability' ) ) )]"
						}
						blockoverride "cover_values" {
							min = 0
							max = 100
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_colonial_stability' ), '(CFixedPoint)4' ) ) )]"
						}
						blockoverride "color" {
							color = { 0.45 0.68 0.45 1.0 }
						}
					}
				}
			}

			# ---- Projected monthly drift, signed ----
			# Exact: colonial_stability_drift_total, the same capped sum of leaf
			# script values the bar applies. The scale is +/-2 because that sum is
			# capped at +/-colonial_stability_drift_cap (1.667); the cap stripe is
			# 0.17, the same 1/12 of the half-height the other signed charts use.
			te_history_chart = {
				blockoverride "chart_title" {
					text = "te_hist_chart_colonial_drift_title"
				}
				blockoverride "chart_legend" {
					text = "te_hist_chart_colonial_drift_legend"
				}
				# This series records no markers; the store's pips belong to
				# other systems (banking, cultural hegemony) and would go unexplained.
				blockoverride "marker_pips" {}
				blockoverride "zero_axis" {
					widget = {
						size = { 100% 2 }
						parentanchor = vcenter
						alwaystransparent = yes

						background = {
							using = dark_area
							alpha = 0.7
						}
					}
				}
				blockoverride "bar_tooltip" {
					tooltip = "te_hist_tt_colonial_drift"
				}
				blockoverride "bar_body" {
					te_history_bar_signed = {
						visible = "[ScriptContainer.HasVariable( 'te_hist_v_colonial_drift' )]"
						blockoverride "positive_values" {
							min = 0
							max = 2
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue( 'te_hist_v_colonial_drift' ) ) )]"
						}
						blockoverride "positive_cover_values" {
							min = 0
							max = 2
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_colonial_drift' ), '(CFixedPoint)0.17' ) ) )]"
						}
						blockoverride "negative_values" {
							min = -2
							max = 0
							value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue( 'te_hist_v_colonial_drift' ) ) )]"
						}
						blockoverride "negative_cover_values" {
							min = -2
							max = 0
							value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', Add_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_colonial_drift' ), '(CFixedPoint)0.17' ) ) )]"
						}
					}
				}
			}
		}
	}

	### "How the Colonial Empire Works": every explanation, gathered out of the
	### live sections into one section at the foot, collapsed by default, one
	### subheading per topic (style rule 1). The live sections say what is
	### happening; this says how it works.
	type te_ce_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('colonial_empire_how_open')]"
			}
		}

		colonial_empire_panel = {
			visible = "[GetVariableSystem.Exists('colonial_empire_how_open')]"

			colonial_empire_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_bar"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_bar_1"
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_bar_2"
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_bar_3"
			}
			colonial_empire_subheader = {
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_moves"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_moves"
			}
			colonial_empire_subheader = {
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_pressure"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_pressure"
			}
			colonial_empire_subheader = {
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_programmes"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_programmes"
			}
			colonial_empire_subheader = {
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_decolonization"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_decolonization"
			}
		}
	}

	### ======================================================================
	### LAYOUT. The one order of the sections.
	### ======================================================================

	### Everything a returning player checks or acts on, open by default.
	type te_ce_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_ce_sec_holdings = {}
		te_ce_sec_stability = {}
		te_ce_sec_pressure = {}
		te_ce_sec_programmes = {}
	}

	### The charts, then how it all works.
	type te_ce_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_ce_sec_history = {}
		te_ce_sec_how = {}
	}
}


### ==========================================================================
### JOURNAL ENTRY ROOTS (je_colonial_empire.txt). Bare wrappers that repeat the
### composers' IsActive gate, so an inactive entry's containers collapse.
### ==========================================================================
flowcontainer = {
	name = "widget_je_colonial_empire_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ce_overview_panel = {}
}

flowcontainer = {
	name = "widget_je_colonial_empire_status"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ce_status_sections = {}
}

flowcontainer = {
	name = "widget_je_colonial_empire_reference"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ce_reference_sections = {}
}
