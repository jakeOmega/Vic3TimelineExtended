					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ) ) )]"
				}
				blockoverride "up_action" {
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ) ) )]"
				}
			}
		}
	}

	### What holds the entry, and what can be done with each part of it: the
	### territories (the colonies and every other territory the decisions can
	### take) and the colonial subjects, each with its own buttons beside it,
	### then Planned Full Decolonization for the whole empire. The owner's
	### request (2026-10-24): show why the entry runs, and put an action that
	### targets a territory or a subject beside that target rather than behind
	### a button that asks which. First of the live sections, under the
	### overview's holdings line, which counts them; open by default (the CLOSED
	### flag), as a live list is (rule 1).
	###
	### Each list is the monthly snapshot colonial_empire_refresh_display takes
	### (the first eight by GDP, players only, the Space Race rivals' pattern),
	### each row gated on the count of stored rows; "+N more" names the rest on
	### hover. A button opens a confirmation for its one target
	### (decolonization_events.402-.404), whose default is Reconsider; one
	### confirmation can be open at a time, and the others grey out until it is
	### answered.
	type te_ce_sec_holdings = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_holdings_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_holdings_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('colonial_empire_holdings_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_holdings_closed'))]"
			}
		}

		colonial_empire_panel = {
			visible = "[Not(GetVariableSystem.Exists('colonial_empire_holdings_closed'))]"

			# Shown for a save upgraded mid-entry, until the first pulse.
			colonial_empire_text = {
				visible = "[Not(GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
				text = "je_colonial_empire_conditions_pending"
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2
				visible = "[GetScriptedGui('colonial_empire_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				# --- Wars of independence ------------------------------------
				# A row per war we are fighting, while there is one: the
				# records decol_iw_rebels_1..3 (decolonization_war_effects.txt),
				# each row on its rebels' capital (decol_iw_state_N).
				colonial_empire_subheader = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_wars'), '(CFixedPoint)0' )]"
					blockoverride "subheader_margin" {
						margin_top = 0
					}
					blockoverride "subheader_text" {
						text = "je_colonial_empire_holdings_wars"
						tooltip = "je_colonial_empire_holdings_wars_tt"
					}
				}
				colonial_empire_list_text = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_wars'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_wars_caption"
				}
				te_ce_war_head = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_wars'), '(CFixedPoint)0' )]"
				}
				te_ce_war_row = {
					blockoverride "row_visible" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_slot_1'), '(CFixedPoint)1' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('decol_iw_state_1').GetState]"
					}
				}
				te_ce_war_row = {
					blockoverride "row_visible" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_slot_2'), '(CFixedPoint)1' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('decol_iw_state_2').GetState]"
					}
				}
				te_ce_war_row = {
					blockoverride "row_visible" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('decol_iw_disp_slot_3'), '(CFixedPoint)1' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('decol_iw_state_3').GetState]"
					}
				}

				# --- Territories -------------------------------------------
				# Every state of ours that is_decolonization_eligible_state, the
				# test Planned Full Decolonization and the Release buttons use:
				# overseas, not a homeland of our cultures, at least
				# colonial_territory_min_population people, not settled land.
				# One row per release bloc, the states one release takes together
				# (colonial_empire_mark_release_blocs). The colony icon is lit for
				# a bloc with a state that also meets is_overseas_colonial_state,
				# the test that keeps the entry running.
				colonial_empire_subheader = {
					blockoverride "subheader_margin" {
						margin_top = 0
					}
					blockoverride "subheader_text" {
						text = "je_colonial_empire_holdings_territories"
						tooltip = "je_colonial_empire_holdings_territories_tt"
					}
				}
				colonial_empire_list_text = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territories_eligible'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_territories_caption"
				}
				te_ce_territory_head = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territories_eligible'), '(CFixedPoint)0' )]"
				}
				te_ce_territory_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territory_rows'), '(CFixedPoint)1' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_territory_1').GetState]"
					}
				}
				te_ce_territory_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territory_rows'), '(CFixedPoint)2' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_territory_2').GetState]"
					}
				}
				te_ce_territory_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territory_rows'), '(CFixedPoint)3' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_territory_3').GetState]"
					}
				}
				te_ce_territory_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territory_rows'), '(CFixedPoint)4' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_territory_4').GetState]"
					}
				}
				te_ce_territory_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territory_rows'), '(CFixedPoint)5' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_territory_5').GetState]"
					}
				}
				te_ce_territory_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territory_rows'), '(CFixedPoint)6' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_territory_6').GetState]"
					}
				}
				te_ce_territory_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territory_rows'), '(CFixedPoint)7' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_territory_7').GetState]"
					}
				}
				te_ce_territory_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territory_rows'), '(CFixedPoint)8' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_territory_8').GetState]"
					}
				}
				# None eligible (a country held by its colonial subjects alone, say).
				colonial_empire_list_text = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territories_eligible'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_territories_none"
				}
				# Eligible territories but no stored rows yet: a save upgraded
				# mid-entry, until the next monthly assessment.
				colonial_empire_list_text = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territories_pending'), '(CFixedPoint)1' )]"
					text = "je_colonial_empire_conditions_pending"
				}
				# The rest, named on hover (colonial_empire_territories_sgui, built
				# only while hovered).
				textbox = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_territories_more'), '(CFixedPoint)0' )]"
					autoresize = yes
					max_width = 476
					elide = right
					align = left|nobaseline
					using = fontsize_medium
					default_format = "#tooltippable"
					text = "je_colonial_empire_territories_more"
					tooltip = "[GetScriptedGui('colonial_empire_territories_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}

				# --- Colonial subjects ---------------------------------------
				# Every subject, at any depth, that is_qualifying_colonial_subject:
				# a colony, a chartered company, or an overseas protectorate whose
				# people share no heritage with ours. Release and Dominion act on
				# our direct subjects; a subject's own subject greys them, with the
				# reason on hover.
				colonial_empire_subheader = {
					blockoverride "subheader_text" {
						text = "je_colonial_empire_holdings_subjects"
						tooltip = "je_colonial_empire_holdings_subjects_tt"
					}
				}
				colonial_empire_list_text = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subjects'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_subjects_caption"
				}
				te_ce_subject_head = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subjects'), '(CFixedPoint)0' )]"
				}
				te_ce_subject_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subject_rows'), '(CFixedPoint)1' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_subject_1').GetState]"
					}
				}
				te_ce_subject_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subject_rows'), '(CFixedPoint)2' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_subject_2').GetState]"
					}
				}
				te_ce_subject_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subject_rows'), '(CFixedPoint)3' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_subject_3').GetState]"
					}
				}
				te_ce_subject_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subject_rows'), '(CFixedPoint)4' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_subject_4').GetState]"
					}
				}
				te_ce_subject_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subject_rows'), '(CFixedPoint)5' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_subject_5').GetState]"
					}
				}
				te_ce_subject_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subject_rows'), '(CFixedPoint)6' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_subject_6').GetState]"
					}
				}
				te_ce_subject_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subject_rows'), '(CFixedPoint)7' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_subject_7').GetState]"
					}
				}
				te_ce_subject_row = {
					blockoverride "row_visible" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subject_rows'), '(CFixedPoint)8' )]"
					}
					blockoverride "row_context" {
						datacontext = "[JournalEntry.GetCountry.MakeScope.Var('colonial_empire_subject_8').GetState]"
					}
				}
				colonial_empire_list_text = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subjects'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_subjects_none"
				}
				# Every colonial subject on hover, when the rows leave some out
				# (colonial_empire_subjects_sgui, built only while hovered).
				textbox = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('colonial_empire_disp_subjects_more'), '(CFixedPoint)0' )]"
					autoresize = yes
					max_width = 476
					elide = right
					align = left|nobaseline
					using = fontsize_medium
					default_format = "#tooltippable"
					text = "je_colonial_empire_subjects_more"
					tooltip = "[GetScriptedGui('colonial_empire_subjects_sgui').ExecuteTooltip(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}

				# --- The whole empire ----------------------------------------
				colonial_empire_subheader = {
					blockoverride "subheader_text" {
						text = "je_colonial_empire_holdings_whole"
					}
				}
				colonial_empire_decision_row = {
					blockoverride "row_text" {
						text = "je_colonial_empire_decision_planned"
						tooltip = "je_colonial_empire_decision_planned_tt"
					}
					blockoverride "row_action" {
						enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
					}
				}
			}
		}
	}

	### The history charts. Open by default, as the UN's is (the owner's call
	### for the UN, 2026-09-28; rule 1: what changes month to month is open).
	###
	### te_history_chart / te_history_bar_unsigned / te_history_bar_signed /
	### te_history_range_button are declared in
	### gui/journal_entry_widgets/te_history_chart.gui. Types declared in a .gui
	### file are global once loaded, so they are instanced here without
	### including it. `te_hist_range` is a single global GUI variable shared with
	### every other history chart: changing the range here changes it there too.
	type te_ce_sec_history = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_history_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_history_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('colonial_empire_history_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_history_closed'))]"
			}
		}

		colonial_empire_panel = {
			visible = "[Not(GetVariableSystem.Exists('colonial_empire_history_closed'))]"

			# ---- Range ----
			flowcontainer = {
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes
				parentanchor = hcenter

				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_1y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '1' ))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '1' )]"
					}
				}
				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_5y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '5' ))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '5' )]"
					}
				}
				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_20y"
					}
					blockoverride "range_enabled" {
						enabled = "[Or( GetVariableSystem.HasValue( 'te_hist_range', '1' ), GetVariableSystem.HasValue( 'te_hist_range', '5' ) )]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '20' )]"
					}
				}
			}

			textbox = {
				visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('te_hist') ) )]"
				parentanchor = hcenter
				autoresize = yes
				multiline = yes
				max_width = 480
				align = hcenter|nobaseline
				text = "te_hist_since"
			}

			# ---- Colonial stability, 0-100 ----
			# Sampled to the nearest 5 (see colonial_empire_refresh_display: the bar
			# is trigger-only, so a comparison ladder is the only read). The legend
			# says so.
			te_history_chart = {
				blockoverride "chart_title" {
					text = "te_hist_chart_colonial_stability_title"
				}
				blockoverride "chart_legend" {
					text = "te_hist_chart_colonial_stability_legend"
				}
				# This series records no markers; the store's pips belong to
				# other systems (banking, cultural hegemony) and would go unexplained.
				blockoverride "marker_pips" {}
				blockoverride "bar_tooltip" {
					tooltip = "te_hist_tt_colonial_stability"
				}
				blockoverride "bar_body" {
					te_history_bar_unsigned = {
						visible = "[ScriptContainer.HasVariable( 'te_hist_v_colonial_stability' )]"
						blockoverride "values" {
							min = 0
							max = 100
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_colonial_stability' ) ) )]"
						}
						blockoverride "cover_values" {
							min = 0
							max = 100
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_colonial_stability' ), '(CFixedPoint)4' ) ) )]"
						}
						blockoverride "color" {
							color = { 0.45 0.68 0.45 1.0 }
						}
					}
				}
			}

			# ---- Projected monthly drift, signed ----
			# Exact: colonial_stability_drift_total, the same capped sum of leaf
			# script values the bar applies. The scale is +/-2 because that sum is
			# capped at +/-colonial_stability_drift_cap (1.667); the cap stripe is
			# 0.17, the same 1/12 of the half-height the other signed charts use.
			te_history_chart = {
				blockoverride "chart_title" {
					text = "te_hist_chart_colonial_drift_title"
				}
				blockoverride "chart_legend" {
					text = "te_hist_chart_colonial_drift_legend"
				}
				# This series records no markers; the store's pips belong to
				# other systems (banking, cultural hegemony) and would go unexplained.
				blockoverride "marker_pips" {}
				blockoverride "zero_axis" {
					widget = {
						size = { 100% 2 }
						parentanchor = vcenter
						alwaystransparent = yes

						background = {
							using = dark_area
							alpha = 0.7
						}
					}
				}
				blockoverride "bar_tooltip" {
					tooltip = "te_hist_tt_colonial_drift"
				}
				blockoverride "bar_body" {
					te_history_bar_signed = {
						visible = "[ScriptContainer.HasVariable( 'te_hist_v_colonial_drift' )]"
						blockoverride "positive_values" {
							min = 0
							max = 2
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue( 'te_hist_v_colonial_drift' ) ) )]"
						}
						blockoverride "positive_cover_values" {
							min = 0
							max = 2
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_colonial_drift' ), '(CFixedPoint)0.17' ) ) )]"
						}
						blockoverride "negative_values" {
							min = -2
							max = 0
							value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', ScriptContainer.GetVariableValue( 'te_hist_v_colonial_drift' ) ) )]"
						}
						blockoverride "negative_cover_values" {
							min = -2
							max = 0
							value = "[FixedPointToFloat( Min_CFixedPoint( '(CFixedPoint)0', Add_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_colonial_drift' ), '(CFixedPoint)0.17' ) ) )]"
						}
					}
				}
			}
		}
	}

	### "How the Colonial Empire Works": every explanation, gathered out of the
	### live sections into one section at the foot, collapsed by default, one
	### subheading per topic (style rule 1). The live sections say what is
	### happening; this says how it works.
	type te_ce_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		colonial_empire_section_header = {
			blockoverride "left_text" {
				text = "je_colonial_empire_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('colonial_empire_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('colonial_empire_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('colonial_empire_how_open')]"
			}
		}

		colonial_empire_panel = {
			visible = "[GetVariableSystem.Exists('colonial_empire_how_open')]"

			colonial_empire_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_bar"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_bar_1"
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_bar_2"
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_bar_3"
			}
			colonial_empire_subheader = {
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_moves"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_moves"
			}
			colonial_empire_subheader = {
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_pressure"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_pressure"
			}
			colonial_empire_subheader = {
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_programmes"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_programmes"
			}
			colonial_empire_subheader = {
				blockoverride "subheader_text" {
					text = "je_colonial_empire_how_sub_decolonization"
				}
			}
			colonial_empire_note = {
				text = "je_colonial_empire_how_decolonization"
			}
		}
	}

	### ======================================================================
	### LAYOUT. The one order of the sections.
	### ======================================================================

	### Everything a returning player checks or acts on, open by default.
	type te_ce_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_ce_sec_holdings = {}
		te_ce_sec_stability = {}
		te_ce_sec_pressure = {}
		te_ce_sec_programmes = {}
	}

	### The charts, then how it all works.
	type te_ce_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_ce_sec_history = {}
		te_ce_sec_how = {}
	}
}


### ==========================================================================
### JOURNAL ENTRY ROOTS (je_colonial_empire.txt). Bare wrappers that repeat the
### composers' IsActive gate, so an inactive entry's containers collapse.
### ==========================================================================
flowcontainer = {
	name = "widget_je_colonial_empire_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ce_overview_panel = {}
}

flowcontainer = {
	name = "widget_je_colonial_empire_status"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ce_status_sections = {}
}

flowcontainer = {
	name = "widget_je_colonial_empire_reference"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ce_reference_sections = {}
}
