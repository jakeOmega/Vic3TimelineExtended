	### One great power: its flag (vanilla's tiny_flag, the country on click)
	### and name, its stance, its prestige at the monthly assessment and what
	### it adds to or takes from stability a month, the one term of the bar it
	### makes. An item of the datamodel over colonial_empire_gp_rows, whose
	### datacontext is the row's script container
	### (colonial_empire_refresh_gp_rows). The country is reached through its
	### stored capital, ScriptContainer.MakeScope.Var('ce_gp_capital')
	### .GetState.GetCountry, the covert rows' proven chain (gotcha #15); the
	### figures through the guarded colonial_gp_row_disp_* values. The hover
	### reads nothing but the container and the player (gotcha #24).
	type te_ce_gp_row = widget {
		size = { 476 28 }
		tooltip = "je_colonial_empire_gp_row_tt"

		flowcontainer = {
			direction = horizontal
			spacing = 4
			parentanchor = vcenter
			ignoreinvisible = yes

			widget = {
				size = { 28 26 }
				parentanchor = vcenter

				tiny_flag = {
					parentanchor = center
					visible = "[ScriptContainer.HasVariable('ce_gp_capital')]"
					datacontext = "[ScriptContainer.MakeScope.Var('ce_gp_capital').GetState.GetCountry]"
				}
			}
			widget = {
				size = { 180 26 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 180
					fontsize_min = 12
					elide = right
					align = left|nobaseline
					using = colonial_empire_fontsize_row
					default_format = "#tooltippable"
					visible = "[ScriptContainer.HasVariable('ce_gp_capital')]"
					text = "je_colonial_empire_gp_name"
				}
			}
			widget = {
				size = { 100 26 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 100
					elide = right
					align = left|nobaseline
					using = colonial_empire_fontsize_row
					visible = "[LessThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('colonial_gp_row_disp_stance'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_gp_condemning"
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 100
					elide = right
					align = left|nobaseline
					using = colonial_empire_fontsize_row
					visible = "[GreaterThan_CFixedPoint( ScriptContainer.MakeScope.ScriptValue('colonial_gp_row_disp_stance'), '(CFixedPoint)0' )]"
					text = "je_colonial_empire_gp_supporting"
				}
			}
			widget = {
				size = { 76 26 }
				parentanchor = vcenter

				textbox = {
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 76
					elide = right
					align = right|nobaseline
					using = colonial_empire_fontsize_row
					text = "[ScriptContainer.MakeScope.ScriptValue('colonial_gp_row_disp_prestige')|0]"
				}
			}
			widget = {
				size = { 76 26 }
				parentanchor = vcenter

				textbox = {
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 76
					elide = right
					align = right|nobaseline
					using = colonial_empire_fontsize_row
					text = "je_colonial_empire_gp_effect"
				}
			}
		}
	}

	### A great-power escalation in force, under the table: its name, its
	### hover the overview's, and its loss a month in the table's last column
