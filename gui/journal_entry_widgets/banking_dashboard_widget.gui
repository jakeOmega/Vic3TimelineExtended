	banking_dash_policy_row = {
		visible = "[GetScriptedGui('banking_dash_disable_ce_target_reduction').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		tooltip = "banking_dash_tt_ce_target_reduction"
		blockoverride "row_label" {
			text = "CE_TARGET_REDUCTION"
		}
