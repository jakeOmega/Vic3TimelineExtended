	### ---- Available interventions ----------------------------------------
	textbox = {
		text = "banking_dash_available_header"
		default_format = "#header"
		autoresize = yes
		max_width = 500
		align = left|nobaseline
		margin = { 4 6 }
	}

	### Monetary Policy
	flowcontainer = {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2
		visible = "[GetScriptedGui('banking_dash_system_market').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		banking_dash_category_header = {
			blockoverride "left_text" {
				text = "banking_dash_cat_monetary"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('banking_dash_collapsed_monetary')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('banking_dash_collapsed_monetary')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('banking_dash_collapsed_monetary'))]"
