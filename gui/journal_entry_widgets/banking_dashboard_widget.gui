### Banking policy dashboard journal-entry widgets.
###
### A type library, one type per section:
###   te_banking_overview_panel     the entry's four bars and the readings'
###                                 icons, with next month's ranges under
###                                 the first row, always shown
###   te_banking_sec_active         Active Policies
###   te_banking_sec_monetary       Monetary Policy (the dial block)
###   te_banking_sec_interventions  Available Interventions, one collapsible
###                                 category per group of tools
###   te_banking_topbar_readings    the cycle's phase in vanilla's top bar
###                                 (gui/topbar.gui), from the overview's icon
###                                 type
###   te_banking_mon_readout        the Budget tab's read-only monetary
###                                 readings, for a country with a dial or an
###                                 anchor but no entry (#805); reads GetPlayer
### gui/journal_entry_widgets/banking_layout_widget.gui sets their order, with
### the history charts (banking_history_widget.gui) and How Banking Works, for
### both hosts: the journal entry (je_banking.txt attaches the named roots at
### the foot of that file) and the Budget panel's Banking tab
### (gui/budget_panel.gui), which instances the same types under datacontext
### GetPlayerJournalEntry('je_banking_cycle'), as te_banking_topbar_readings
### does too. So every JournalEntry.* expression below resolves in all three.
### Keep it that way: read nothing the tab's datacontext does not supply.
###
### Every yes/no question and every action is answered by a scripted GUI in
### common/scripted_guis/banking_dashboard_scripted_gui.txt, which in turn calls the
### same shared triggers/effects as the journal-entry buttons. Nothing here holds
### gameplay state; the only widget-local state is the GUI variable system flag that
### collapses a section. Each flag says its default (style guide rule 7):
### banking_dash_<section>_closed is open until closed (test_banking_layout.py).
###
### The Monetary Policy section's dial block is answered by a second file,
### common/scripted_guis/te_monetary_sguis.txt — one op-parameterised handler
### (banking_mon_control_sgui, ops 0-14: 0/1 target stepper, 2/3 delegation,
### 4/5/6/14 mandate, 7/8 monetisation stepper, 9-12 the fine and far steps,
### 13 recapitalise) plus scope-free display handlers. That op table is an
### implicit contract between this file and that one; keep both headers in
### step.

types banking_dashboard_widget_types
{
	### A row of the Monetary Policy table: the label (a concept, so hovering the
	### word explains the term) on the left, the value on the right. Both columns
	### are fixed-width wrappers so the readings line up; the text inside them
	### elides rather than pushing the row past the block. Every instance puts
	### its tooltip (the reading, and what moves it) on the row, as the UN's
	### pillar rows do. The table is in the UN tables' medium type, and its label
	### column is 164, the same as a banking_dash_pair's, so a full row's value
	### lines up with the left value of a pair row (play-test round 2, which
	### asked for a shorter panel; round 3 widened the column from 132 so the
	### longest label, "Gap to World Rate", fits the width budget).
	type banking_dash_condition_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4

		widget = {
			size = { 164 22 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 164
				elide = right
				align = nobaseline
				using = fontsize_medium
				default_format = "#tooltippable"
				block "condition_label" {}
			}
		}

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			parentanchor = vcenter
			block "condition_value" {}
		}
	}

	### Free-standing value textbox used inside banking_dash_condition_row.
	### 292 is what the Monetary Policy block has left of its 460 once the
	### 164 label column and the 4 spacing are taken; wider runs the value
	### past the block's right edge. Any row whose text can run longer — a
	### country name, two signed figures, a state word after a number — sets
	### `multiline = yes` and wraps instead of eliding: Peg Confidence,
	### Exchange Rate Index, Trade and Prices, Monetary Anchor, Backstops,
	### Monetary Union.
	type banking_dash_condition_value = textbox {
		parentanchor = vcenter
		autoresize = yes
		max_width = 292
		elide = right
		align = nobaseline
		using = fontsize_medium
	}

	### One reading of a two-column pair row: label 164 + 4 + value 62 = 230,
	### so two fill the block's 460. Only for short readings (a percentage or a
	### signed figure, six characters at most); anything longer keeps a full row. The instance puts
	### its tooltip on the cell, so each half explains itself.
	type banking_dash_pair = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4

		widget = {
			size = { 164 22 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 164
				elide = right
				align = nobaseline
				using = fontsize_medium
				default_format = "#tooltippable"
				block "pair_label" {}
			}
		}
		widget = {
			size = { 62 22 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 62
				elide = right
				align = nobaseline
				using = fontsize_medium
				block "pair_value" {}
			}
		}
	}

	### Two readings on one row, where two short related figures used to take
	### two (play-test round 2). Either half can be hidden; the other stays put
	### on the left.
	type banking_dash_pair_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 0
		block "pair_left" {}
		block "pair_right" {}
	}

	### One action button. The data context is a scripted GUI, so visibility,
	### the disabled state, the tooltip and the click all come from script.
	### `button` + `default_button_action` is the in-game text-button idiom
	### (vanilla budget_panel.gui "PAUSE_ALL_CONSTRUCTION_BUTTON"); the
	### frontend-only button_standard_* family is never instantiated in-game.
	type banking_dash_action_button = button {
		using = default_button_action
		size = { 100 28 }
		parentanchor = vcenter
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
	}

	### A monetary-policy control button. Deliberately carries NO `visible` of
	### its own, unlike banking_dash_action_button above: the delegation and
	### mandate buttons take their visibility from a different scripted GUI than
	### the one that answers their enabled state, and two `visible` properties on
	### one widget is a bug rather than a conjunction (gui_modding_guide.md
	### gotcha 17). Each instance therefore writes its own visible / enabled /
	### onclick / tooltip against the shared banking_mon_control_sgui datacontext
	### its row supplies.
	type banking_dash_mon_button = button {
		using = default_button_action
		size = { 128 26 }
		parentanchor = vcenter
	}

	### The label column of a monetary row with controls, sized to line up with
	### banking_dash_condition_row's.
	type banking_dash_mon_label = widget {
		size = { 164 26 }

		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 164
			elide = right
			align = nobaseline
			using = fontsize_medium
			default_format = "#tooltippable"
			block "mon_label_text" {}
		}
	}

	### A heading inside a section, over one group of its rows, with a faint rule
	### under it: the UN's un_chamber_subheader, at this panel's 460 width. The
	### Monetary Policy block grew to some twenty rows over three phases; these
	### split it into the rate and who holds the dial, what gold is doing, the
	### exchange rate, what the debt costs, and what prices are doing (the
	### central bank's rows joined the rate in play-test round 2). How Banking Works
	### uses it for its topics. A heading whose rows are all hidden carries the
	### same `visible` as they do; the first heading of a block drops its top
	### margin (blockoverride "subheader_margin" {}), so the block does not open
	### on a gap. Until 2026-09-29 these were centred #lore captions in capitals.
	type banking_dash_subheader = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		block "subheader_margin" {
			margin_top = 8
		}

		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 460 -1 }
			align = left|nobaseline
			using = fontsize_large
			default_format = "#title"
			block "subheader_text" {}
		}
		divider_clean = {
			blockoverride "size" {
				size = { 460 2 }
			}
		}
	}

	### Explanatory text under a banking_dash_subheader in How Banking Works: how
	### a thing works, rather than what it reads now (the UN's un_chamber_note,
	### at this panel's 460). Static keys only.
	type banking_dash_note = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 460 -1 }
		maximumsize = { 460 -1 }
		align = left|nobaseline
		using = fontsize_medium
		default_format = "#lore"
	}

	### A plain 0-1 meter under a row of the gold sub-section (the bank's vault
	### against its limit, peg confidence against 100). Vanilla's own bar type,
	### so it matches the journal entry's scripted bars above.
	type banking_dash_mon_meter = default_progressbar_horizontal {
		parentanchor = hcenter
		size = { 440 16 }
		blockoverride "values" {
			block "meter_value" {}
			min = 0
			max = 1
		}
	}

	### The value column of a monetary row with a control: 160, which leaves the
	### Delegation row room for its 128 button (164 + 4 + 160 + 4 + 128 = 460),
	### and still fits "Bound by mandate" without eliding.
	type banking_dash_mon_value = widget {
		size = { 160 26 }

		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 160
			elide = right
			align = nobaseline
			using = fontsize_medium
			block "mon_value_text" {}
		}
	}

	### One policy: status/label, point cost, and the enable + disable actions.
	### Exactly one of the two buttons is ever shown, because their scripted GUIs
	### mirror the enable/disable scripted_button pair's `visible` triggers. The
	### row's tooltip is the policy's description and effects, so its name is
	### set as hoverable text; the button's own tooltip says why it is greyed.
	### 6 + 288 + 6 + 36 + 6 + 100 + 6 = 448, inside the Monetary Policy block's
	### 460 (the open-market operations row sits there).
	###
	### Play-test round 3 (the owner: "a lot of the interventions ... are too
	### long"): the name is in the medium type, with a dashboard name where the
	### button's own is longer than the 288 cell holds (banking_dash_name_*,
	### the sector alone under the Directed Credit heading), and the
	### requirement ("At least 2 free Banking Intervention Points") is a compact
	### cell, the budget's icon and the points, with the full line in the row's
	### tooltip under Requires. test_banking_layout.WidthBudgetTest holds every
	### name to the cell.
	type banking_dash_policy_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6
		margin = { 6 2 }
		parentanchor = hcenter

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.35
		}

		widget = {
			size = { 288 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 288
				elide = right
				align = nobaseline
				using = fontsize_medium
				default_format = "#tooltippable"
				block "row_label" {}
			}
		}

		widget = {
			size = { 36 26 }
			block "cost_icon" {
				icon = {
					size = { 18 18 }
					parentanchor = left|vcenter
					texture = "gfx/interface/icons/banking_icons/budget.dds"
				}
			}
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 16
				elide = right
				align = right|nobaseline
				using = fontsize_medium
				block "row_cost" {}
			}
		}

		banking_dash_action_button = { block "enable_action" {} }
		banking_dash_action_button = { block "disable_action" {} }
	}

	### Collapsible section header. The flag lives in the GUI variable system
	### only — it is presentation state and is never written to the save — and
	### is named for the section's default: banking_dash_<section>_closed exists
	### while the player has closed a section that starts open.
	type banking_dash_category_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 500 32 }
		}
		blockoverride "left_text_alignment" {
			align = left|nobaseline
		}
	}

	### ==========================================================================
	### OVERVIEW: THE BARS AND THE READINGS AS ICONS
	### ==========================================================================
	### At the top of both hosts, always shown: what a returning player checks.
	### The entry's four bars, then the readings as icons, each with its word
	### beside it (style guide rule 4; the owner's first play-test, 2026-09-29:
	### "an icon for the inflation band, maybe other banking icons"). The cells
	### replace the Current Conditions table; each cell's tooltip is the one its
	### row had. The icons are the banking set of PR #586
	### (gfx/interface/icons/banking_icons/), apart from vanilla's momentum
	### arrows and warning badge; docs/systems/banking_gui_icons.md records
	### what each shows (test_banking_layout.BankingIconsTest).

	### A cell of the overview: the icon on the left, and beside it the caption
	### (a concept) over the reading's word. Play-test round 2 laid the cells
	### on their side to shorten the panel: 40 high instead of 76, the word
	### still right next to its icon. Fixed size, so no cell can widen its
	### row: three to a row is 3 x 158 + 2 x 3 = 480, the bars' width. The
	### caption says which reading it is, because two band words (Elevated,
	### High) name a band of bubble pressure and of inflation alike. The
	### instance puts one icon per state in "icons", each with its own
	### visible, and its word (or words) in "word"; "badge" is for a small
	### alert over the icon's corner. Round 3: 158 wide (3 x 158 + 2 x 3 = 480)
	### and the text from x 34, so its column is 124, and the word in the small
	### type, so the longest ("Hyperinflation") fits the width budget.
	type te_banking_ov_cell = widget {
		size = { 158 40 }

		widget = {
			size = { 32 32 }
			parentanchor = left|vcenter
			block "icons" {}
		}
		textbox = {
			position = { 34 2 }
			autoresize = yes
			max_width = 124
			elide = right
			align = left|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			block "caption" {}
		}
		block "word" {}
		block "badge" {}
	}

	### The word beside a cell's icon, under its caption.
	type te_banking_ov_word = textbox {
		position = { 34 20 }
		autoresize = yes
		max_width = 124
		elide = right
		align = left|nobaseline
		using = fontsize_small
	}

	### A first-row cell's third line: how far its reading can move at the next
	### monthly update. As wide as the cell, with its text at the cell's x (34),
	### so it reads as the cell's own line under the word. The instance puts the
	### breakdown on the line, which is hoverable apart from the cell above, and
	### one te_banking_ov_change_text per shape of range in "range".
	type te_banking_ov_change = widget {
		size = { 158 18 }
		block "range" {}
	}

	### One shape of a change line's range. Underlined, as hoverable text is,
	### since its tooltip is not the cell's.
	type te_banking_ov_change_text = textbox {
		position = { 34 0 }
		autoresize = yes
		max_width = 124
		elide = right
		align = left|nobaseline
		using = fontsize_small
		default_format = "#tooltippable"
	}

	### The icons of the cycle's three readings, one per state, each with its own
	### visible: the phase from the banking_dash_phase_* scripted GUI its word
	### uses, momentum and bubble pressure from their display codes
	### (banking_overview_display_values.txt). The icons fill the widget, so an
	### instance sets the size: 32, the default, in the overview's cells. The top
	### bar draws the phase's too, also at 32 (te_banking_topbar_readings). One
	### type per reading, so the two places cannot draw different art for the
	### same state.
	type te_banking_phase_icons = widget {
		size = { 32 32 }

		icon = {
			size = { 100% 100% }
			visible = "[GetScriptedGui('banking_dash_phase_panic').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			texture = "gfx/interface/icons/banking_icons/phase_panic.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[GetScriptedGui('banking_dash_phase_downturn').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			texture = "gfx/interface/icons/banking_icons/phase_downturn.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[GetScriptedGui('banking_dash_phase_stagnation').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			texture = "gfx/interface/icons/banking_icons/phase_stagnation.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[GetScriptedGui('banking_dash_phase_stable').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			texture = "gfx/interface/icons/banking_icons/phase_stable.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[GetScriptedGui('banking_dash_phase_expansion').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			texture = "gfx/interface/icons/banking_icons/phase_expansion.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[GetScriptedGui('banking_dash_phase_boom').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			texture = "gfx/interface/icons/banking_icons/phase_boom.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[GetScriptedGui('banking_dash_phase_frenzy').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			texture = "gfx/interface/icons/banking_icons/phase_frenzy.dds"
		}
	}

	### Momentum: an arrow per band, from the band word's own edges
	### (banking_disp_momentum_band_code). The double arrows are Collapsing and
	### Surging, which the old table also tagged contracting / overheating.
	### Freefall and Overheating, the bands past the bar's ends, draw them too
	### until their own art exists (banking_gui_icons.md, placeholders): the
	### word beside them, in red, tells them apart.
	type te_banking_momentum_icons = widget {
		size = { 32 32 }

		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_band_code'), '(CFixedPoint)1' )]"
			texture = "gfx/interface/icons/generic_icons/down_down.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_band_code'), '(CFixedPoint)2' )]"
			texture = "gfx/interface/icons/generic_icons/down_down.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_band_code'), '(CFixedPoint)3' )]"
			texture = "gfx/interface/icons/generic_icons/trend_down.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_band_code'), '(CFixedPoint)4' )]"
			texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_band_code'), '(CFixedPoint)5' )]"
			texture = "gfx/interface/icons/generic_icons/trend_up.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_band_code'), '(CFixedPoint)6' )]"
			texture = "gfx/interface/icons/generic_icons/trend_upup.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_band_code'), '(CFixedPoint)7' )]"
			texture = "gfx/interface/icons/generic_icons/trend_upup.dds"
		}
	}

	### Bubble pressure's band (banking_disp_bubble_band_code).
	type te_banking_bubble_icons = widget {
		size = { 32 32 }

		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_bubble_band_code'), '(CFixedPoint)1' )]"
			texture = "gfx/interface/icons/banking_icons/bubble_low.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_bubble_band_code'), '(CFixedPoint)2' )]"
			texture = "gfx/interface/icons/banking_icons/bubble_building.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_bubble_band_code'), '(CFixedPoint)3' )]"
			texture = "gfx/interface/icons/banking_icons/bubble_elevated.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_bubble_band_code'), '(CFixedPoint)4' )]"
			texture = "gfx/interface/icons/banking_icons/bubble_high.dds"
		}
		icon = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_bubble_band_code'), '(CFixedPoint)5' )]"
			texture = "gfx/interface/icons/banking_icons/bubble_severe.dds"
		}
	}

	### The crash-risk mark over the bubble icon's top-right corner, the old
	### row's "(crash risk)" tag: the cycle at the top of its range, or booming
	### with momentum Surging or Overheating (+3 or more). The instance sets its
	### position. The top bar shows
	### the same state as a line of the phase's tooltip (banking_dash_top_phase_tt).
	type te_banking_crash_risk_badge = icon {
		size = { 16 16 }
		visible = "[GetScriptedGui('banking_dash_bubble_risk_high').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		texture = "gfx/interface/icons/generic_icons/warning.dds"
		tooltip = "banking_dash_ov_crash_risk_tt"
	}

	type te_banking_overview_panel = flowcontainer {
		# je_banking_cycle has is_shown_when_inactive, so the panel can open for a
		# country whose entry has not activated yet and therefore has none of the
		# cycle variables. Draw nothing until the journal entry is running.
		visible = "[JournalEntry.IsActive]"
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		# 10 + the bars' 480 + 10 = 500, the width of the section headers below.
		margin = { 10 8 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}

		### THE JOURNAL ENTRY'S OWN SCRIPTED BARS, AT THE TOP. Phase, momentum,
		### policy stance, bubble pressure — the same four bars, from the same
		### datamodel, that vanilla's panel draws at the very bottom. The block is
		### te_je_scripted_bars (gui/te_system_tab_widgets.gui), which reproduces
		### only the variants the mod's entries use. They are NOT drawn twice:
		### je_banking.txt puts a marker widget in custom_widget_container_7, and
		### the mod's journal_entry.gui override hides its own bar block for any
		### entry that does.
		te_je_scripted_bars = {}

		### Row 1: the cycle — phase, momentum, bubble pressure — and, on a third
		### line under each, how far it can move next month. The line hangs off its
		### cell (no spacing between the two rows), so it reads as the cell's own.
		flowcontainer = {
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes

			### The readings.
			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 3

				### The phase: icon and coloured word from the same banking_dash_phase_*
				### scripted GUI, the one the word always used.
				te_banking_ov_cell = {
					tooltip = "banking_dash_phase_tt"
					blockoverride "caption" {
						text = "banking_dash_phase_label"
					}
					blockoverride "icons" {
						te_banking_phase_icons = {}
					}
					blockoverride "word" {
						te_banking_ov_word = {
							visible = "[GetScriptedGui('banking_dash_phase_panic').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							text = "banking_dash_phase_panic_value"
						}
						te_banking_ov_word = {
							visible = "[GetScriptedGui('banking_dash_phase_downturn').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							text = "banking_dash_phase_downturn_value"
						}
						te_banking_ov_word = {
							visible = "[GetScriptedGui('banking_dash_phase_stagnation').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							text = "banking_dash_phase_stagnation_value"
						}
						te_banking_ov_word = {
							visible = "[GetScriptedGui('banking_dash_phase_stable').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							text = "banking_dash_phase_stable_value"
						}
						te_banking_ov_word = {
							visible = "[GetScriptedGui('banking_dash_phase_expansion').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							text = "banking_dash_phase_expansion_value"
						}
						te_banking_ov_word = {
							visible = "[GetScriptedGui('banking_dash_phase_boom').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							text = "banking_dash_phase_boom_value"
						}
						te_banking_ov_word = {
							visible = "[GetScriptedGui('banking_dash_phase_frenzy').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							text = "banking_dash_phase_frenzy_value"
						}
					}
				}

				### Momentum's band (te_banking_momentum_icons).
				te_banking_ov_cell = {
					tooltip = "banking_dash_momentum_tt"
					blockoverride "caption" {
						text = "banking_dash_momentum_label"
					}
					blockoverride "icons" {
						te_banking_momentum_icons = {}
					}
					blockoverride "word" {
						te_banking_ov_word = {
							text = "banking_dash_momentum_value"
						}
					}
				}

				### Bubble pressure's band (te_banking_bubble_icons), with the crash-risk
				### badge over the icon's corner.
				te_banking_ov_cell = {
					tooltip = "banking_dash_bubble_tt"
					blockoverride "caption" {
						text = "banking_dash_bubble_label"
					}
					blockoverride "icons" {
						te_banking_bubble_icons = {}
					}
					blockoverride "word" {
						te_banking_ov_word = {
							text = "banking_dash_bubble_value"
						}
					}
					blockoverride "badge" {
						te_banking_crash_risk_badge = {
							position = { 22 0 }
						}
					}
				}
			}

			### Their change at the next monthly update, as a range worked out from
			### the readings (banking_disp_*_change_*, banking_overview_display_values.txt),
			### one shape of text per banking_disp_*_change_shape: 1 low to high,
			### 2 low or more, 3 high or less, 4 one figure. The breakdown is on hover.
			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 3

				### Under the phase: the cycle value.
				te_banking_ov_change = {
					tooltip = "banking_dash_value_change_tt"
					blockoverride "range" {
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_value_change_shape'), '(CFixedPoint)1' )]"
							text = "banking_dash_value_change_range"
						}
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_value_change_shape'), '(CFixedPoint)2' )]"
							text = "banking_dash_value_change_more"
						}
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_value_change_shape'), '(CFixedPoint)3' )]"
							text = "banking_dash_value_change_less"
						}
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_value_change_shape'), '(CFixedPoint)4' )]"
							text = "banking_dash_value_change_single"
						}
					}
				}

				### Under momentum.
				te_banking_ov_change = {
					tooltip = "banking_dash_momentum_change_tt"
					blockoverride "range" {
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_change_shape'), '(CFixedPoint)1' )]"
							text = "banking_dash_momentum_change_range"
						}
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_change_shape'), '(CFixedPoint)2' )]"
							text = "banking_dash_momentum_change_more"
						}
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_change_shape'), '(CFixedPoint)3' )]"
							text = "banking_dash_momentum_change_less"
						}
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_momentum_change_shape'), '(CFixedPoint)4' )]"
							text = "banking_dash_momentum_change_single"
						}
					}
				}

				### Under bubble pressure. Its range is always closed.
				te_banking_ov_change = {
					tooltip = "banking_dash_bubble_change_tt"
					blockoverride "range" {
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_bubble_change_shape'), '(CFixedPoint)1' )]"
							text = "banking_dash_bubble_change_range"
						}
						te_banking_ov_change_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_bubble_change_shape'), '(CFixedPoint)4' )]"
							text = "banking_dash_bubble_change_single"
						}
					}
				}
			}
		}

		### Row 2: what the player sets — the stance (only with a dial, once the
		### monetary layer has reported), the price band (the monetary layer
		### only, once it has reported) and the intervention budget (always).
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 3

			### Policy stance's band (banking_disp_stance_band_code).
			te_banking_ov_cell = {
				visible = "[And( GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				tooltip = "banking_dash_mon_stance_tt"
				blockoverride "caption" {
					text = "banking_dash_mon_stance_label"
				}
				blockoverride "icons" {
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_stance_band_code'), '(CFixedPoint)1' )]"
						texture = "gfx/interface/icons/banking_icons/stance_very_loose.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_stance_band_code'), '(CFixedPoint)2' )]"
						texture = "gfx/interface/icons/banking_icons/stance_loose.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_stance_band_code'), '(CFixedPoint)3' )]"
						texture = "gfx/interface/icons/banking_icons/stance_neutral.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_stance_band_code'), '(CFixedPoint)4' )]"
						texture = "gfx/interface/icons/banking_icons/stance_tight.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_stance_band_code'), '(CFixedPoint)5' )]"
						texture = "gfx/interface/icons/banking_icons/stance_very_tight.dds"
					}
				}
				blockoverride "word" {
					te_banking_ov_word = {
						text = "banking_dash_mon_stance_value"
					}
				}
			}

			### The price band (banking_disp_price_band_code): the six bands of the
			### ladder, and the two states with none (dollarised; set by plan).
			te_banking_ov_cell = {
				visible = "[And( GetScriptedGui('banking_mon_system_shown').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				tooltip = "banking_dash_mon_band_tt"
				blockoverride "caption" {
					text = "banking_dash_mon_inflation_label"
				}
				blockoverride "icons" {
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_price_band_code'), '(CFixedPoint)1' )]"
						texture = "gfx/interface/icons/banking_icons/price_deflation.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_price_band_code'), '(CFixedPoint)2' )]"
						texture = "gfx/interface/icons/banking_icons/price_stable.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_price_band_code'), '(CFixedPoint)3' )]"
						texture = "gfx/interface/icons/banking_icons/price_elevated.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_price_band_code'), '(CFixedPoint)4' )]"
						texture = "gfx/interface/icons/banking_icons/price_high.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_price_band_code'), '(CFixedPoint)5' )]"
						texture = "gfx/interface/icons/banking_icons/price_very_high.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_price_band_code'), '(CFixedPoint)6' )]"
						texture = "gfx/interface/icons/banking_icons/price_hyper.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_price_band_code'), '(CFixedPoint)7' )]"
						texture = "gfx/interface/icons/banking_icons/price_dollarised.dds"
					}
					icon = {
						size = { 32 32 }
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('banking_disp_price_band_code'), '(CFixedPoint)8' )]"
						texture = "gfx/interface/icons/banking_icons/price_planned.dds"
					}
				}
				blockoverride "word" {
					te_banking_ov_word = {
						text = "banking_dash_mon_band_value"
					}
				}
			}

			### The intervention budget: points free. One icon, always shown.
			te_banking_ov_cell = {
				tooltip = "banking_dash_budget_tt"
				blockoverride "caption" {
					text = "banking_dash_budget_label"
				}
				blockoverride "icons" {
					icon = {
						size = { 32 32 }
						texture = "gfx/interface/icons/banking_icons/budget.dds"
					}
				}
				blockoverride "word" {
					te_banking_ov_word = {
						text = "banking_dash_budget_value"
					}
				}
			}
		}
	}

	### ==========================================================================
	### THE TOP BAR'S BANKING PHASE
	### ==========================================================================
	### The cycle's phase as one icon in vanilla's top bar, after MONEY
	### (gui/topbar.gui). The owner asked for the band, not the number, and then
	### for the phase alone (momentum and bubble pressure stay in the overview):
	### no figures and no words. Hover it for the phase's word, a crash-risk
	### line while that risk is high, and the overview's phase tooltip; click it
	### for the Budget panel's Banking tab. The icon is the overview's own type,
	### so the two cannot disagree.
	###
	### 40 x 40, a primary button's height, with the icon at 32 px and 2 below
	### centre, as vanilla's primary icons are: level with Bureaucracy ... MONEY,
	### and the bar no taller. The widget keeps its 40 while the phase is hidden,
	### because gui/topbar.gui declares the bar's width with these 40 in it (see
	### the comment on its size line). test_topbar_banking.py recomputes all of
	### this from the markup. The top bar's hud_visibility hides it with the bar.
	type te_banking_topbar_readings = widget {
		size = { 40 40 }

		te_banking_topbar_gate = {
			blockoverride "readings" {
				te_banking_topbar_reading = {
					name = "te_topbar_banking_phase"
					tooltip = "banking_dash_top_phase_tt"
					te_banking_phase_icons = {
						size = { 32 32 }
						position = { 0 2 }
						parentanchor = center
					}
				}
			}
		}
	}

	### The top bar's gates, one widget each, outermost first, so nothing inside
	### a closed one is evaluated: not in observer mode (GetPlayer is empty there);
	### the Budget tab's gate, te_budget_banking_tab_sgui (the rule on and the
	### entry held), on the parent of the datacontext as budget_panel.gui has
	### it; and the entry running (JournalEntry.IsActive), the overview's own
	### gate. The instance puts the phase in "readings".
	type te_banking_topbar_gate = flowcontainer {
		visible = "[Not( GetMetaPlayer.IsObserver )]"
		ignoreinvisible = yes

		flowcontainer = {
			visible = "[GetScriptedGui('te_budget_banking_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			ignoreinvisible = yes

			flowcontainer = {
				datacontext = "[GetPlayerJournalEntry('je_banking_cycle')]"
				ignoreinvisible = yes

				flowcontainer = {
					visible = "[JournalEntry.IsActive]"
					ignoreinvisible = yes

					block "readings" {}
				}
			}
		}
	}

	### The phase's hover and click target: vanilla's top-bar button (glow on
	### hover, tooltip below, a click opens a panel), icon-only.
	type te_banking_topbar_reading = button {
		using = glow_button
		size = { 40 40 }
		using = tooltip_below
		onclick = "[InformationPanelBar.OpenPanelTab('budget', 'te_banking')]"
	}

	### ==========================================================================
	### ACTIVE POLICIES
	### ==========================================================================
	### What is in force, each with its Disable button. A row is drawn while its
	### tool is on, whatever economic system enacted it, so a tool inherited from
	### a repealed law keeps a working Disable here.
	type te_banking_sec_active = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2

		banking_dash_category_header = {
			blockoverride "left_text" {
				text = "banking_dash_active_header"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('banking_dash_active_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('banking_dash_active_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('banking_dash_active_closed'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 2
			visible = "[Not(GetVariableSystem.Exists('banking_dash_active_closed'))]"

			textbox = {
				visible = "[Not(GetScriptedGui('banking_dash_any_policy_active').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
				text = "banking_dash_no_active"
				autoresize = yes
				multiline = yes
				minimumsize = { 480 -1 }
				maximumsize = { 480 -1 }
				align = left|nobaseline
				margin = { 6 4 }
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_open_market_ops').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_open_market_ops"
				blockoverride "row_label" {
					text = "CB_OPEN_MARKET_OPS"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_open_market_ops"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_open_market_ops')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_open_market_ops')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_moral_suasion').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_moral_suasion"
				blockoverride "row_label" {
					text = "CB_MORAL_SUASION"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_moral_suasion"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_moral_suasion')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_moral_suasion')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_countercyclical_buffer').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_countercyclical_buffer"
				blockoverride "row_label" {
					text = "banking_dash_name_cb_countercyclical_buffer"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_countercyclical_buffer"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_countercyclical_buffer')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_countercyclical_buffer')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_raise_margin_requirements').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_raise_margin_requirements"
				blockoverride "row_label" {
					text = "CB_RAISE_MARGIN_REQ"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_raise_margin_requirements"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_raise_margin_requirements')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_raise_margin_requirements')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_expand_deposit_guarantee').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_expand_deposit_guarantee"
				blockoverride "row_label" {
					text = "CB_EXPAND_DEPOSIT_GUARANTEE"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_expand_deposit_guarantee"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_expand_deposit_guarantee')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_expand_deposit_guarantee')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_directed_credit_infrastructure').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_directed_credit_infrastructure"
				blockoverride "row_label" {
					text = "banking_dash_name_active_cb_directed_credit_infrastructure"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_directed_credit_infrastructure"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_directed_credit_infrastructure')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_directed_credit_infrastructure')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_export_credit_facility').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_export_credit_facility"
				blockoverride "row_label" {
					text = "CB_EXPORT_CREDIT"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_export_credit_facility"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_export_credit_facility')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_export_credit_facility')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_restrict_inflows').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
