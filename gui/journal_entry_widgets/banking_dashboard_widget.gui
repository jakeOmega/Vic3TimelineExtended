### Banking policy dashboard journal-entry widgets.
###
### A type library, one type per section:
###   te_banking_overview_panel     the entry's four bars and Current Conditions,
###                                 always shown
###   te_banking_sec_active         Active Policies
###   te_banking_sec_monetary       Monetary Policy (the dial block)
###   te_banking_sec_interventions  Available Interventions, one collapsible
###                                 category per group of tools
### gui/journal_entry_widgets/banking_layout_widget.gui sets their order, with
### the history charts (banking_history_widget.gui) and How Banking Works, for
### both hosts: the journal entry (je_banking.txt attaches the named roots at
### the foot of that file) and the Budget panel's Banking tab
### (gui/budget_panel.gui), which instances the same types under datacontext
### GetPlayerJournalEntry('je_banking_cycle'). So every JournalEntry.*
### expression below resolves in both hosts. Keep it that way: read nothing
### the tab's datacontext does not supply.
###
### Every yes/no question and every action is answered by a scripted GUI in
### common/scripted_guis/banking_dashboard_scripted_gui.txt, which in turn calls the
### same shared triggers/effects as the journal-entry buttons. Nothing here holds
### gameplay state; the only widget-local state is the GUI variable system flag that
### collapses a section. Each flag says its default (style guide rule 7):
### banking_dash_<section>_closed is open until closed (test_banking_layout.py).
###
### The Monetary Policy section's dial block is answered by a second file,
### common/scripted_guis/te_monetary_sguis.txt — one op-parameterised handler
### (banking_mon_control_sgui, ops 0-8: 0/1 target stepper, 2/3 delegation,
### 4/5/6 mandate, 7/8 monetisation stepper) plus six scope-free display
### handlers. That op table is an implicit contract between this file and that
### one; keep both headers in step.

types banking_dashboard_widget_types
{
	### A line of the Current Conditions block: label on the left, value on the right.
	### Both columns are fixed-width wrappers so the readings line up; the text
	### inside them elides rather than pushing the row past the panel. Every
	### instance puts its tooltip (what the reading is, and what moves it) on the
	### row, so the label is set as hoverable text (#tooltippable, style guide
	### rule 3), as the UN's pillar rows are.
	type banking_dash_condition_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6

		widget = {
			size = { 200 24 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 200
				elide = right
				align = nobaseline
				using = fontsize_large
				default_format = "#tooltippable"
				block "condition_label" {}
			}
		}

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			parentanchor = vcenter
			block "condition_value" {}
		}
	}

	### Free-standing value textbox used inside banking_dash_condition_row.
	### 254 is what the Monetary Policy block has left of its 460 once the
	### 200 label column and the 6 spacing are taken; wider runs the value
	### past the block's right edge. That is about 28 characters at this font,
	### so any row whose text can run longer — a country name, two signed
	### figures, a state word after a number — sets `multiline = yes` and
	### wraps instead of eliding: Peg Confidence, Exchange Rate Index, Trade
	### and Prices, Monetary Anchor, Backstops, Monetary Union.
	type banking_dash_condition_value = textbox {
		parentanchor = vcenter
		autoresize = yes
		max_width = 254
		elide = right
		align = nobaseline
		using = fontsize_large
	}

	### One action button. The data context is a scripted GUI, so visibility,
	### the disabled state, the tooltip and the click all come from script.
	### `button` + `default_button_action` is the in-game text-button idiom
	### (vanilla budget_panel.gui "PAUSE_ALL_CONSTRUCTION_BUTTON"); the
	### frontend-only button_standard_* family is never instantiated in-game.
	type banking_dash_action_button = button {
		using = default_button_action
		size = { 100 30 }
		parentanchor = vcenter
		visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
	}

	### A monetary-policy control button. Deliberately carries NO `visible` of
	### its own, unlike banking_dash_action_button above: the delegation and
	### mandate buttons take their visibility from a different scripted GUI than
	### the one that answers their enabled state, and two `visible` properties on
	### one widget is a bug rather than a conjunction (gui_modding_guide.md
	### gotcha 17). Each instance therefore writes its own visible / enabled /
	### onclick / tooltip against the shared banking_mon_control_sgui datacontext
	### its row supplies.
	type banking_dash_mon_button = button {
		using = default_button_action
		size = { 128 28 }
		parentanchor = vcenter
	}

	### The label column of a monetary row, sized to line up with
	### banking_dash_condition_row's.
	type banking_dash_mon_label = widget {
		size = { 200 28 }

		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 200
			elide = right
			align = nobaseline
			using = fontsize_large
			default_format = "#tooltippable"
			block "mon_label_text" {}
		}
	}

	### A heading inside a section, over one group of its rows, with a faint rule
	### under it: the UN's un_chamber_subheader, at this panel's 460 width. The
	### Monetary Policy block grew to some twenty rows over three phases; these
	### split it into what the world is doing, what gold is doing, what the debt
	### costs, what prices are doing, and who holds the dial. How Banking Works
	### uses it for its topics. A heading whose rows are all hidden carries the
	### same `visible` as they do; the first heading of a block drops its top
	### margin (blockoverride "subheader_margin" {}), so the block does not open
	### on a gap. Until 2026-09-29 these were centred #lore captions in capitals.
	type banking_dash_subheader = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		block "subheader_margin" {
			margin_top = 8
		}

		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 460 -1 }
			align = left|nobaseline
			using = fontsize_large
			default_format = "#title"
			block "subheader_text" {}
		}
		divider_clean = {
			blockoverride "size" {
				size = { 460 2 }
			}
		}
	}

	### A plain 0-1 meter under a row of the gold sub-section (the bank's vault
	### against its limit, peg confidence against 100). Vanilla's own bar type,
	### so it matches the journal entry's scripted bars above.
	type banking_dash_mon_meter = default_progressbar_horizontal {
		parentanchor = hcenter
		size = { 440 16 }
		blockoverride "values" {
			block "meter_value" {}
			min = 0
			max = 1
		}
	}

	### The value column of a monetary row: the whole 254 the row has after
	### the label column, so "Bound by mandate" fits without eliding.
	type banking_dash_mon_value = widget {
		size = { 254 28 }

		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 254
			elide = right
			align = nobaseline
			using = fontsize_large
			block "mon_value_text" {}
		}
	}

	### One policy: status/label, point cost, and the enable + disable actions.
	### Exactly one of the two buttons is ever shown, because their scripted GUIs
	### mirror the enable/disable scripted_button pair's `visible` triggers. The
	### row's tooltip is the policy's description and effects, so its name is
	### set as hoverable text; the button's own tooltip says why it is greyed.
	type banking_dash_policy_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6
		margin = { 6 3 }
		parentanchor = hcenter

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.35
		}

		widget = {
			size = { 240 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 240
				elide = right
				align = nobaseline
				using = fontsize_large
				default_format = "#tooltippable"
				block "row_label" {}
			}
		}

		widget = {
			size = { 84 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 84
				elide = right
				align = nobaseline
				block "row_cost" {}
			}
		}

		banking_dash_action_button = { block "enable_action" {} }
		banking_dash_action_button = { block "disable_action" {} }
	}

	### Collapsible section header. The flag lives in the GUI variable system
	### only — it is presentation state and is never written to the save — and
	### is named for the section's default: banking_dash_<section>_closed exists
	### while the player has closed a section that starts open.
	type banking_dash_category_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 500 32 }
		}
		blockoverride "left_text_alignment" {
			align = left|nobaseline
		}
	}

	### ==========================================================================
	### OVERVIEW: THE BARS AND CURRENT CONDITIONS
	### ==========================================================================
	### At the top of both hosts, always shown: what a returning player checks.
	type te_banking_overview_panel = flowcontainer {
		# je_banking_cycle has is_shown_when_inactive, so the panel can open for a
		# country whose entry has not activated yet and therefore has none of the
		# cycle variables. Draw nothing until the journal entry is running.
		visible = "[JournalEntry.IsActive]"
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		margin = { 14 8 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}

		### THE JOURNAL ENTRY'S OWN SCRIPTED BARS, AT THE TOP. Phase, momentum,
		### policy stance, bubble pressure — the same four bars, from the same
		### datamodel, that vanilla's panel draws at the very bottom. The block is
		### te_je_scripted_bars (gui/te_system_tab_widgets.gui), which reproduces
		### only the variants the mod's entries use. They are NOT drawn twice:
		### je_banking.txt puts a marker widget in custom_widget_container_7, and
		### the mod's journal_entry.gui override hides its own bar block for any
		### entry that does.
		te_je_scripted_bars = {}

		textbox = {
			text = "banking_dash_conditions_header"
			default_format = "#header"
			autoresize = yes
			max_width = 470
			align = left|nobaseline
			margin_bottom = 4
		}

		### Cycle phase
		banking_dash_condition_row = {
			tooltip = "banking_dash_phase_tt"
			blockoverride "condition_label" {
				text = "banking_dash_phase_label"
			}
			blockoverride "condition_value" {
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_phase_panic').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_phase_panic_value"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_phase_downturn').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_phase_downturn_value"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_phase_stagnation').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_phase_stagnation_value"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_phase_stable').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_phase_stable_value"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_phase_expansion').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_phase_expansion_value"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_phase_boom').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_phase_boom_value"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_phase_frenzy').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_phase_frenzy_value"
				}
			}
		}

		### Momentum
		banking_dash_condition_row = {
			tooltip = "banking_dash_momentum_tt"
			blockoverride "condition_label" {
				text = "banking_dash_momentum_label"
			}
			blockoverride "condition_value" {
				### Which way the cycle is heading, as an arrow (style guide rule
				### 5): up from Rising, down from Falling, flat while Steady — the
				### band word's own edges (banking_dash_momentum_band).
				icon = {
					size = { 24 24 }
					parentanchor = vcenter
					visible = "[GetScriptedGui('banking_dash_momentum_up').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					texture = "gfx/interface/icons/generic_icons/trend_up.dds"
				}
				icon = {
					size = { 24 24 }
					parentanchor = vcenter
					visible = "[GetScriptedGui('banking_dash_momentum_down').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					texture = "gfx/interface/icons/generic_icons/trend_down.dds"
				}
				icon = {
					size = { 24 24 }
					parentanchor = vcenter
					visible = "[GetScriptedGui('banking_dash_momentum_steady').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
				}
				banking_dash_condition_value = {
					text = "banking_dash_momentum_value"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_momentum_rising').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_momentum_rising_tag"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_momentum_falling').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_momentum_falling_tag"
				}
			}
		}

		### Bubble pressure
		### Policy stance, between momentum and bubble pressure — the order of the
		### bars above, and the order of cause: the stance feeds both. The BAND NAME
		### only, from the same customizable localization the Monetary Policy block
		### uses; a country with no dial has no stance, so it has no row.
		banking_dash_condition_row = {
			visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			tooltip = "banking_dash_mon_stance_tt"
			blockoverride "condition_label" {
				text = "banking_dash_mon_stance_label"
			}
			blockoverride "condition_value" {
				banking_dash_condition_value = {
					text = "banking_dash_mon_stance_value"
				}
			}
		}

		banking_dash_condition_row = {
			tooltip = "banking_dash_bubble_tt"
			blockoverride "condition_label" {
				text = "banking_dash_bubble_label"
			}
			blockoverride "condition_value" {
				banking_dash_condition_value = {
					text = "banking_dash_bubble_value"
				}
				banking_dash_condition_value = {
					visible = "[GetScriptedGui('banking_dash_bubble_risk_high').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "banking_dash_bubble_warn_tag"
				}
			}
		}

		### Intervention budget
		banking_dash_condition_row = {
			tooltip = "banking_dash_budget_tt"
			blockoverride "condition_label" {
				text = "banking_dash_budget_label"
			}
			blockoverride "condition_value" {
				banking_dash_condition_value = {
					text = "banking_dash_budget_value"
				}
			}
		}
	}

	### ==========================================================================
	### ACTIVE POLICIES
	### ==========================================================================
	### What is in force, each with its Disable button. A row is drawn while its
	### tool is on, whatever economic system enacted it, so a tool inherited from
	### a repealed law keeps a working Disable here.
	type te_banking_sec_active = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2

		banking_dash_category_header = {
			blockoverride "left_text" {
				text = "banking_dash_active_header"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('banking_dash_active_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('banking_dash_active_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('banking_dash_active_closed'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 2
			visible = "[Not(GetVariableSystem.Exists('banking_dash_active_closed'))]"

			textbox = {
				visible = "[Not(GetScriptedGui('banking_dash_any_policy_active').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
				text = "banking_dash_no_active"
				autoresize = yes
				multiline = yes
				minimumsize = { 480 -1 }
				maximumsize = { 480 -1 }
				align = left|nobaseline
				margin = { 6 4 }
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_open_market_ops').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_open_market_ops"
				blockoverride "row_label" {
					text = "CB_OPEN_MARKET_OPS"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_open_market_ops"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_open_market_ops')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_open_market_ops')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_moral_suasion').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_moral_suasion"
				blockoverride "row_label" {
					text = "CB_MORAL_SUASION"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_moral_suasion"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_moral_suasion')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_moral_suasion')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_countercyclical_buffer').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_countercyclical_buffer"
				blockoverride "row_label" {
					text = "CB_COUNTERCYCLICAL_BUFFER"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_countercyclical_buffer"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_countercyclical_buffer')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_countercyclical_buffer')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_raise_margin_requirements').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_raise_margin_requirements"
				blockoverride "row_label" {
					text = "CB_RAISE_MARGIN_REQ"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_raise_margin_requirements"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_raise_margin_requirements')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_raise_margin_requirements')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_expand_deposit_guarantee').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_expand_deposit_guarantee"
				blockoverride "row_label" {
					text = "CB_EXPAND_DEPOSIT_GUARANTEE"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_expand_deposit_guarantee"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_expand_deposit_guarantee')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_expand_deposit_guarantee')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_directed_credit_infrastructure').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_directed_credit_infrastructure"
				blockoverride "row_label" {
					text = "CB_DIRECTED_CREDIT_INFRA"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_directed_credit_infrastructure"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_directed_credit_infrastructure')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_directed_credit_infrastructure')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cb_export_credit_facility').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cb_export_credit_facility"
				blockoverride "row_label" {
					text = "CB_EXPORT_CREDIT"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cb_export_credit_facility"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cb_export_credit_facility')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cb_export_credit_facility')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
