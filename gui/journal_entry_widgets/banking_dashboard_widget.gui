					### devaluations, crisis outcomes, event modifiers.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_pressure_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_pressure_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_pressure_value"
							}
						}
					}

					### Monetising the deficit — ops 7 (down) and 8 (up) of
					### banking_mon_control_sgui, the same shape as the target
					### stepper above.
					###
					### NOT hidden for a country that may not monetise, unlike
					### the delegation and mandate rows further down. Printing
					### money is the one lever here whose absence is itself a
					### fact about the country's laws, so the row stays, the
					### level reads 0, and the two buttons grey out carrying
					### one line that names the cause
					### (te_mon_monetise_condition).
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 6
						parentanchor = left
						tooltip = "banking_dash_mon_monetise_tt"
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_monetise_label"
							}
						}

						button_icon_minus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ) ) )]"
						}

						widget = {
							size = { 68 28 }
							textbox = {
								parentanchor = center
								align = center|nobaseline
								autoresize = yes
								max_width = 68
								elide = right
								using = fontsize_large
								text = "banking_dash_mon_monetise_value"
							}
						}

						button_icon_plus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ) ) )]"
						}
