				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cw_consumption_ceiling').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cw_consumption_ceiling"
				blockoverride "row_label" {
					text = "banking_dash_name_cw_consumption_ceiling"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cw_consumption_ceiling"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cw_consumption_ceiling')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cw_consumption_ceiling')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cw_solidarity_campaign').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cw_solidarity_campaign"
				blockoverride "row_label" {
					text = "CW_SOLIDARITY_CAMPAIGN"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cw_solidarity_campaign"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cw_solidarity_campaign')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cw_solidarity_campaign')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_disable_cw_worker_buyout').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cw_worker_buyout"
				blockoverride "row_label" {
					text = "CW_WORKER_BUYOUT"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cw_worker_buyout"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cw_worker_buyout')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cw_worker_buyout')]"
					text = "banking_dash_btn_disable"
				}
			}
		}
	}

	### ==========================================================================
	### MONETARY POLICY
	### ==========================================================================
	### A section of its own between Active Policies and Available Interventions:
	### it is mostly readings (the rate, prices, gold, the exchange rate, what
	### borrowing costs), so it sits with the live sections rather than as the
	### first category of the interventions list, where it lived until the
	### style-guide pass (2026-09-29).
	###
	### Unlike the categories of Available Interventions, this one is NOT gated
	### on the market economy while the monetary layer is on. The policy dial exists for
	### every country — a command economy administers its rate, a bankless one
	### pays the world rate plus a spread — and the block's whole job for those
	### countries is to say so in one line (monetary_policy_design.md §3, §4,
	### §5.3). The category holds the dial block and nothing else: open-market
	### operations sit inside it under the rate target, and moral suasion moved
	### to Prudential Regulation.
	###
	### Under banking_system_simplified the dial block is gone and the only row
	### left is open-market operations' market-only fallback, so the category is
	### drawn for a market economy only (banking_dash_monetary_shown).
	type te_banking_sec_monetary = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2
		visible = "[GetScriptedGui('banking_dash_monetary_shown').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		banking_dash_category_header = {
			blockoverride "left_text" {
				text = "banking_dash_cat_monetary"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('banking_dash_monetary_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('banking_dash_monetary_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('banking_dash_monetary_closed'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 2
			visible = "[Not(GetVariableSystem.Exists('banking_dash_monetary_closed'))]"

			### ---- The policy dial (monetary_policy_design.md §3) ----------
			### Readouts for every country; the three interactive rows only for
			### one that holds the dial. Nothing here renders the neutral rate,
			### the stance gap or the estimation error — the stance band name is
			### the only window onto any of them (§8, "The rule").
			###
			### THE WHOLE BLOCK IS OFF UNDER `banking_system_simplified` — the rate,
			### the premium, prices, gold and the exchange rate all belong to the
			### monetary layer that setting removes. Open-market operations, which
			### that setting keeps, get a fallback row below the block instead.
			flowcontainer = {
				visible = "[GetScriptedGui('banking_mon_system_shown').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 2
				margin = { 8 6 }

				background = {
					using = entry_bg_fancy_dark
					alpha = 0.35
				}

				### Everything below is written by te_monetary_monthly_update, so
				### until a country's first pulse there is nothing to read and
				### every `var:` would log "Failed to fetch variable" per frame.
				textbox = {
					visible = "[Not( GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
					text = "banking_dash_mon_not_ready"
					autoresize = yes
					multiline = yes
					max_width = 460
					align = left|nobaseline
				}

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					parentanchor = hcenter
					spacing = 2
					visible = "[GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					### Why there is no dial here — one line, cause-specific.
					### Hidden for a country that holds one.
					textbox = {
						visible = "[Not( GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
						text = "banking_dash_mon_no_dial_line"
						autoresize = yes
						multiline = yes
						max_width = 460
						align = left|nobaseline
						margin_bottom = 2
					}

					banking_dash_subheader = {
						blockoverride "subheader_margin" {}
						blockoverride "subheader_text" {
							text = "banking_dash_mon_sub_rates"
						}
					}

					### World reference rate and world rate, side by side.
					###
					### The reference rate is read-only, the same figure for every country,
					### and the anchor the rest of the block is measured against: the base of
					### the lenders' floor (§10) and what the world rate falls back to when no
					### great power sets a rate of its own. Public by spec §10, unlike anything
					### downstream of the neutral rate. te_mon_era_base_now is the country's
					### per-pulse copy of global_var:te_mon_era_base_world, read rather than the
					### global because a .gui has no HasGlobalVariable to guard with
					### (gui_modding_guide.md gotcha 15); step 0 of the monthly update writes
					### it first, so banking_mon_display_ready is its guard.
					###
					### The world rate (phase 3, §12.1) is the REAL rate the discretionary great
					### powers are running, GDP-weighted: a no-dial country pays it plus
					### expectations plus a point, Peg Defence targets it, a gold country's
					### reserves move on the gap against it. te_mon_world_rate_now is its
					### per-pulse copy, behind its own readiness handler because a phase-2 save
					### has none until its first pulse.
					banking_dash_pair_row = {
						blockoverride "pair_left" {
							banking_dash_pair = {
								tooltip = "banking_dash_mon_world_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_world_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_world_value"
								}
							}
						}
						blockoverride "pair_right" {
							banking_dash_pair = {
								visible = "[GetScriptedGui('banking_mon_world_rate_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
								tooltip = "banking_dash_mon_worldrate_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_worldrate_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_worldrate_value"
								}
							}
						}
					}

					### The policy rate (the actual rate, one decimal) and, beside it, the
					### Rate Target: the dial itself. Ops 0 (down) and 1 (up) of
					### banking_mon_control_sgui; the handler answers why a step is greyed out,
					### so no threshold lives in this file. The target half is 106 + 2 + 26 +
					### 2 + 60 + 2 + 26 = 224, inside the pair's 230.
					banking_dash_pair_row = {
						blockoverride "pair_left" {
							banking_dash_pair = {
								tooltip = "banking_dash_mon_rate_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_rate_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_rate_value"
								}
							}
						}
						blockoverride "pair_right" {
							flowcontainer = {
								direction = horizontal
								ignoreinvisible = yes
								spacing = 2
								tooltip = "banking_dash_mon_target_tt"
								datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
								visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

								widget = {
									size = { 106 26 }
									textbox = {
										parentanchor = left|vcenter
										autoresize = yes
										max_width = 106
										elide = right
										align = nobaseline
										using = fontsize_medium
										default_format = "#tooltippable"
										text = "banking_dash_mon_target_label"
									}
								}

								button_icon_minus_action = {
									size = { 26 26 }
									parentanchor = vcenter
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
									### Click a point, ctrl-click a tenth, shift-click to the limit.
									click_modifiers = {
										ondefault = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
										onctrl = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
										onshift = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)11' ) ).End )]"
									}
									tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
								}

								widget = {
									size = { 60 26 }
									textbox = {
										parentanchor = center
										align = center|nobaseline
										autoresize = yes
										max_width = 60
										elide = right
										using = fontsize_medium
										text = "banking_dash_mon_target_value"
									}
								}

								button_icon_plus_action = {
									size = { 26 26 }
									parentanchor = vcenter
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
									### Click a point, ctrl-click a tenth, shift-click to the limit.
									click_modifiers = {
										ondefault = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
										onctrl = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
										onshift = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
									}
									tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
								}
							}
						}
					}

					### Delegation — ops 2 (delegate) and 3 (take it back), the button
					### beside the value it changes (164 + 4 + 160 + 4 + 128 = 460). Exactly one
					### button is ever drawn, and neither under central bank independence,
					### which is permanently mandate-bound; the value says so there (§5.2).
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = left
						tooltip = "banking_dash_mon_delegation_tt"
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_delegation_label"
							}
						}

						banking_dash_mon_value = {
							blockoverride "mon_value_text" {
								text = "banking_dash_mon_delegation_value"
							}
						}

						banking_dash_mon_button = {
							visible = "[And( GetScriptedGui('banking_mon_can_delegate').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Not( GetScriptedGui('banking_mon_is_delegated').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
							text = "banking_dash_mon_btn_delegate"
						}

						banking_dash_mon_button = {
							visible = "[And( GetScriptedGui('banking_mon_can_delegate').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('banking_mon_is_delegated').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ) ) )]"
							text = "banking_dash_mon_btn_take_control"
						}
					}

					### Mandate — which rule a delegated or independent bank follows. The
					### value takes the width the row has free (164 + 4 + 290 = 458), since
					### "Inflation Targeting" runs past the value column's 160.
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = left
						tooltip = "banking_dash_mon_mandate_tt"
						visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_mandate_label"
							}
						}

						widget = {
							size = { 290 26 }

							textbox = {
								parentanchor = left|vcenter
								autoresize = yes
								max_width = 290
								elide = right
								align = nobaseline
								using = fontsize_medium
								text = "banking_dash_mon_mandate_value"
							}
						}
					}

					### Mandate by Law (#799) — under central bank independence the
					### mandate is an act on the law, so this row stands where the
					### mandate buttons would: the act in force, or that there is none
					### yet. As wide as the Mandate row's value, for the act's name.
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = left
						tooltip = "banking_dash_mon_act_tt"
						visible = "[GetScriptedGui('banking_mon_mandate_by_law').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_act_label"
							}
						}

						widget = {
							size = { 290 26 }

							textbox = {
								parentanchor = left|vcenter
								autoresize = yes
								max_width = 290
								elide = right
								align = nobaseline
								using = fontsize_medium
								text = "banking_dash_mon_act_value"
							}
						}
					}

					### The statute's 12 months, counting down, while the bank still runs the
					### mandate it had before its act (#799).
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = left
						tooltip = "banking_dash_mon_act_tt"
						visible = "[GetScriptedGui('banking_mon_mandate_pending').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_pending_label"
							}
						}

						banking_dash_mon_value = {
							blockoverride "mon_value_text" {
								text = "banking_dash_mon_pending_value"
							}
						}
					}

					### Ops 14 / 4 / 5 / 6, a two-by-two grid: Inflation Targeting and the
					### Dual Mandate, then Growth and (on a gold standard) Peg Defence (#799).
					### 226 each (2 x 226 + 4 = 456), so every mandate shows its full name.
					### The mandate already in force is greyed out by the handler's is_valid
					### (that is the "you are here" marker), and so is every button for a
					### year after a change. Not drawn under independence, where an act sets
					### the mandate (the row above).
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = hcenter
						margin_bottom = 2
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_mandate_by_choice').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_button = {
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)14' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)14' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)14' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)14' ) ).End ) ) )]"
							size = { 226 26 }
							text = "banking_dash_mon_mandate_inflation"
						}

						banking_dash_mon_button = {
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ) ) )]"
							size = { 226 26 }
							text = "banking_dash_mon_mandate_dual"
						}
					}

					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = hcenter
						margin_bottom = 2
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_mandate_by_choice').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_button = {
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ) ) )]"
							size = { 226 26 }
							text = "banking_dash_mon_mandate_growth"
						}

						banking_dash_mon_button = {
							visible = "[GetScriptedGui('banking_mon_is_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End ) ) )]"
							size = { 226 26 }
							text = "banking_dash_mon_mandate_peg"
						}
					}

					### Open-market operations — the dial's own "beyond the floor"
					### tool, so it sits under the rate target rather than in a
					### category of its own. Drawn only where the currency law allows
					### unbacked money (banking_mon_shows_omo); every other reason it
					### cannot be used — the tech, the Prudential / Narrow Banking
					### lock, the rate not at its floor, points — leaves the row
					### visible and greyed, with the cause in the Enable tooltip.
					### Unlike an Available Interventions row it does not vanish
					### once enabled: the row type shows exactly one of its two
					### buttons, so Enable becomes Disable in place.
					banking_dash_policy_row = {
						visible = "[GetScriptedGui('banking_mon_shows_omo').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_tt_cb_open_market_ops"
						blockoverride "row_label" {
							text = "CB_OPEN_MARKET_OPS"
						}
						blockoverride "row_cost" {
							text = "banking_dash_cost_cb_open_market_ops"
						}
						blockoverride "enable_action" {
							datacontext = "[GetScriptedGui('banking_dash_enable_cb_open_market_ops')]"
							text = "banking_dash_btn_enable"
						}
						blockoverride "disable_action" {
							datacontext = "[GetScriptedGui('banking_dash_disable_cb_open_market_ops')]"
							text = "banking_dash_btn_disable"
						}
					}

					banking_dash_subheader = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						blockoverride "subheader_text" {
							text = "banking_dash_mon_sub_gold"
						}
					}

					### The bank's own vault (the hybrid model) — what the flows below
					### move, as pounds and as a share of its limit. NOT the treasury.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_bankgold_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_bankgold_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_bankgold_value"
							}
						}
					}

					banking_dash_mon_meter = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_bankgold_tt"
						blockoverride "meter_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('te_mon_bank_gold_scaled') )]"
						}
					}

					### ---- Gold and the peg (phase 3, §12.2-12.3) ---------------
					### Three rows, for a gold-standard country with a national
					### bank only (banking_mon_shows_gold) — suspended or not; the
					### values' customizable localization says "suspended" where
					### that is the answer. None of it is hidden state: the gap is
					### policy rate minus world rate, both displayed.
					###
					### Gap against the world rate — what moves the gold.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldgap_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_goldgap_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_goldgap_value"
							}
						}
					}

					### Gold flow this month. add_treasury never appears in the
					### budget ledger (§12.2), so this row is the only place the
					### player can see it; the tooltip carries the hot-money
					### balance that says how much of the vault is borrowed.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldflow_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_goldflow_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_goldflow_value"
							}
						}
					}

					### Borrowed gold — a row of its own since the first playtest: a
					### balance that grows every month the rate is held high, and
					### leaves first when it comes down, is not tooltip material. It
					### shares the Gold Flow tooltip, which explains the mechanism.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldflow_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_hotmoney_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_hotmoney_value"
							}
						}
					}

					### Peg confidence, 0-100. §3 asks for a bar; a figure with a
					### word beside it reads the same and costs no new widget.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_pegconf_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_pegconf_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								multiline = yes
								text = "banking_dash_mon_pegconf_value"
							}
						}
					}

					banking_dash_mon_meter = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_pegconf_tt"
						blockoverride "meter_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('te_mon_peg_confidence_scaled') )]"
						}
					}

					### Recapitalise — op 13, treasury -> vault, one way. The handler
					### answers why it is greyed out, so no threshold lives here.
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						parentanchor = hcenter
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_button = {
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)13' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)13' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)13' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)13' ) ).End ) ) )]"
							size = { 200 28 }
							text = "banking_dash_mon_btn_recapitalise"
						}
					}

					### ---- The exchange rate (phase 4, §15) ----------------------
					### Two rows for every country. The index is shown EXACTLY: every
					### input to it is already exact on this dashboard (r* enters only
					### through the policy rate the player chose), so it leaks no
					### hidden state. te_mon_fx_state says "Par" for metal and for a
					### command economy; the tooltip lists fx_target's four terms.
					banking_dash_subheader = {
						blockoverride "subheader_text" {
							text = "banking_dash_mon_sub_fx"
						}
					}

					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_fx_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_fx_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								multiline = yes
								text = "banking_dash_mon_fx_value"
							}
						}
					}

					### What the index is doing: the trade edge, and the inflation
					### it is importing (or, under a peg, the overvaluation).
					### Multiline: with two signed figures the float reading can
					### outrun the 254 value column, and wrapping beats eliding a
					### number.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_fx_effect_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_fx_effect_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								multiline = yes
								text = "banking_dash_mon_fx_effect_value"
							}
						}
					}

					### [P5] International monetary arrangements (§15A). Hidden unless the
					### country holds some role in one. Every branch that reads the
					### anchor sits behind te_mon_is_anchored in customizable
					### localization, so no absent scope variable is ever fetched.
					banking_dash_subheader = {
						visible = "[GetScriptedGui('banking_mon_shows_arrangements').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						blockoverride "subheader_text" {
							text = "banking_dash_mon_sub_arrangements"
						}
					}

					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_arrangements').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_anchor_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_anchor_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								multiline = yes
								text = "banking_dash_mon_anchor_value"
							}
						}
					}

					### A treaty pegger's confidence — §12.3's gauge, read against
					### overvaluation rather than a vault.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_anchor_peg').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_anchorpeg_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_pegconf_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_anchorpeg_value"
							}
						}
					}

					banking_dash_mon_meter = {
						visible = "[GetScriptedGui('banking_mon_shows_anchor_peg').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_anchorpeg_tt"
						blockoverride "meter_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('te_mon_peg_confidence_scaled') )]"
						}
					}

					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_arrangements').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_backstops_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_backstops_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								multiline = yes
								text = "banking_dash_mon_backstops_value"
							}
						}
					}

					### [P5b] The bloc's common currency (§15A.3): one state row and the
					### four actions, each its own scripted GUI.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_union').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_union_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_union_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								multiline = yes
								text = "banking_dash_mon_union_value"
							}
						}
					}

					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						parentanchor = hcenter
						visible = "[GetScriptedGui('banking_mon_shows_union').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_button = {
							datacontext = "[GetScriptedGui('banking_mon_union_adopt')]"
							visible = "[GetScriptedGui('banking_mon_union_adopt').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
							size = { 200 28 }
							text = "banking_dash_mon_btn_union_adopt"
						}

						banking_dash_mon_button = {
							datacontext = "[GetScriptedGui('banking_mon_union_leave')]"
							visible = "[GetScriptedGui('banking_mon_union_leave').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
							size = { 200 28 }
							text = "banking_dash_mon_btn_union_leave"
						}

						banking_dash_mon_button = {
							datacontext = "[GetScriptedGui('banking_mon_union_press_on')]"
							visible = "[GetScriptedGui('banking_mon_union_press_on').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
							size = { 200 28 }
							text = "banking_dash_mon_btn_union_press"
						}

						banking_dash_mon_button = {
							datacontext = "[GetScriptedGui('banking_mon_union_press_off')]"
							visible = "[GetScriptedGui('banking_mon_union_press_off').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
							size = { 200 28 }
							text = "banking_dash_mon_btn_union_press_off"
						}
					}

					banking_dash_subheader = {
						blockoverride "subheader_text" {
							text = "banking_dash_mon_sub_borrowing"
						}
					}

					### What the treasury actually pays. The engine's own figure
					### first, this system's arithmetic beside it — if the two
					### drift apart, something outside the system is moving the
					### rate and the player can see it (§17 check 6).
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_paid_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_paid_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_paid_value"
							}
							banking_dash_condition_value = {
								text = "banking_dash_mon_paid_script_tag"
							}
						}
					}

					### Credit standing (the structural tier) and risk premium (the cyclical
					### tier), side by side (§7).
					banking_dash_pair_row = {
						blockoverride "pair_left" {
							banking_dash_pair = {
								tooltip = "banking_dash_mon_standing_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_standing_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_standing_value"
								}
							}
						}
						blockoverride "pair_right" {
							banking_dash_pair = {
								tooltip = "banking_dash_mon_premium_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_premium_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_premium_value"
								}
							}
						}
					}

					banking_dash_subheader = {
						blockoverride "subheader_text" {
							text = "banking_dash_mon_sub_prices"
						}
					}

					### ---- Prices (monetary_policy_design.md §3, §9) --------
					### Headline and expected inflation are shown EXACTLY, to one
					### decimal: both are things the player can act on, and both
					### are already priced by their lenders. Core inflation, the
					### noise walk and the §9.1 pressure sum are hidden state and
					### appear nowhere here (ruling P7) — the two pressure rows
					### print only the part the player CHOSE, which is a modifier
					### the engine breaks down on its own.

					### Inflation (what prices actually did) and expected inflation (what
					### lenders and workers have priced in, the half that costs money).
					banking_dash_pair_row = {
						blockoverride "pair_left" {
							banking_dash_pair = {
								tooltip = "banking_dash_mon_inflation_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_inflation_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_inflation_value"
								}
							}
						}
						blockoverride "pair_right" {
							banking_dash_pair = {
								tooltip = "banking_dash_mon_expected_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_expected_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_expected_value"
								}
							}
						}
					}

					### The price band has no row here: the overview's Inflation cell shows it,
					### with the same tooltip (banking_dash_mon_band_tt), since play-test round 2.
					###
					### Wage pressure (the labour and welfare half, §9.4, kept apart because it
					### is the half that earns the real-wage dividend) and price pressure
					### (everything else the player chose: devaluations, crisis outcomes,
					### event modifiers).
					banking_dash_pair_row = {
						blockoverride "pair_left" {
							banking_dash_pair = {
								tooltip = "banking_dash_mon_wage_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_wage_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_wage_value"
								}
							}
						}
						blockoverride "pair_right" {
							banking_dash_pair = {
								tooltip = "banking_dash_mon_pressure_tt"
								blockoverride "pair_label" {
									text = "banking_dash_mon_pressure_label"
								}
								blockoverride "pair_value" {
									text = "banking_dash_mon_pressure_value"
								}
							}
						}
					}

					### Inflation anchoring — how much of the two rows above a
					### credible bank absorbs, out of how much it could
					### (te_mon_pressure_anchoring). Only for a country that
					### holds any.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_has_anchoring').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_anchoring_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_anchoring_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_anchoring_value"
							}
						}
					}

					### Asset purchases — what the open-market operations tool and the
					### bank's own purchases at its rate floor add to prices
					### (te_mon_purchase_pressure_display, §0.12). A row of its own
					### because neither is a modifier: they are counted outside
					### country_inflation_pressure_add so Inflation Anchoring
					### cannot absorb them, which means the Price Pressure row
					### above cannot print them. Only while something is bought.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_has_purchases').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_purchases_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_purchases_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_purchases_value"
							}
						}
					}

					### Monetising the deficit — ops 7 (down) and 8 (up) of
					### banking_mon_control_sgui, the same shape as the target
					### stepper above.
					###
					### NOT hidden for a country that may not monetise, unlike
					### the delegation and mandate rows further down. Printing
					### money is the one lever here whose absence is itself a
					### fact about the country's laws, so the row stays, the
					### level reads 0, and the two buttons grey out carrying
					### one line that names the cause
					### (te_mon_monetise_condition).
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 6
						parentanchor = left
						tooltip = "banking_dash_mon_monetise_tt"
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_monetise_label"
							}
						}

						button_icon_minus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ) ) )]"
						}

						widget = {
							size = { 60 26 }
							textbox = {
								parentanchor = center
								align = center|nobaseline
								autoresize = yes
								max_width = 60
								elide = right
								using = fontsize_medium
								text = "banking_dash_mon_monetise_value"
							}
						}

						button_icon_plus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ) ) )]"
						}
					}

				}
			}

			### ---- Open-market operations without a dial block ------------
			### banking_system_simplified only: the dial block above is off,
			### the tool is not, so it gets an ordinary Available Interventions
			### row here. With the monetary layer on it lives under the rate
			### target instead, and this container is hidden.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 2
				visible = "[GetScriptedGui('banking_dash_omo_fallback_shown').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				banking_dash_policy_row = {
					visible = "[GetScriptedGui('banking_dash_enable_cb_open_market_ops').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "banking_dash_tt_cb_open_market_ops"
					blockoverride "row_label" {
						text = "CB_OPEN_MARKET_OPS"
					}
					blockoverride "row_cost" {
						text = "banking_dash_cost_cb_open_market_ops"
					}
					blockoverride "enable_action" {
						datacontext = "[GetScriptedGui('banking_dash_enable_cb_open_market_ops')]"
						text = "banking_dash_btn_enable"
					}
					blockoverride "disable_action" {
						datacontext = "[GetScriptedGui('banking_dash_disable_cb_open_market_ops')]"
						text = "banking_dash_btn_disable"
					}
				}
			}
		}
	}

	### ==========================================================================
	### THE MONETARY READOUT (#805)
	### ==========================================================================
	### What the Budget panel's Banking tab shows a country that has a monetary
	### stance but not the journal entry (te_budget_banking_readout_sgui): a
	### national bank's dial (te_mon_has_dial needs a bank, not the entry), or a
	### currency tied to another's. Such a country runs a central bank and can
	### meet a peg crisis, so it sees the readings that matter for one, and no
	### control: Policy Rate and World Rate, the Mandate (a dial), the Monetary
	### Anchor (anchored), the Exchange Rate, and Peg Confidence with its meter
	### (a gold dial, or a treaty peg). The dashboard's own rows have the rest.
	###
	### THE ONE TYPE IN THIS FILE THAT DOES NOT READ JournalEntry. It is drawn
	### where there is no entry, so every expression reads GetPlayer, and its
	### keys are the banking_dash_ro_* copies of the dashboard's. Its row
	### gates are the dashboard's own scripted GUIs, with GetPlayer as the root.
	### 20 + 460 + 20 = 500, the width of the entry's sections.
	type te_banking_mon_readout = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2
		minimumsize = { 500 -1 }
		margin = { 20 8 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.35
		}

		### Before the first monthly update there is nothing to read, and a
		### missing `var:` logs once a frame (banking_mon_display_ready).
		textbox = {
			visible = "[Not( GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			text = "banking_dash_mon_not_ready"
			autoresize = yes
			multiline = yes
			max_width = 460
			align = left|nobaseline
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 2
			visible = "[GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

			### The rate, and the world rate it is measured against: what Peg
			### Defence follows, and what a gold country's gold moves on.
			banking_dash_pair_row = {
				blockoverride "pair_left" {
					banking_dash_pair = {
						tooltip = "banking_dash_ro_rate_tt"
						blockoverride "pair_label" {
							text = "banking_dash_mon_rate_label"
						}
						blockoverride "pair_value" {
							text = "banking_dash_ro_rate_value"
						}
					}
				}
				blockoverride "pair_right" {
					banking_dash_pair = {
						visible = "[GetScriptedGui('banking_mon_world_rate_ready').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						tooltip = "banking_dash_mon_worldrate_tt"
						blockoverride "pair_label" {
							text = "banking_dash_mon_worldrate_label"
						}
						blockoverride "pair_value" {
							text = "banking_dash_ro_worldrate_value"
						}
					}
				}
			}

			banking_dash_condition_row = {
				visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "banking_dash_ro_mandate_tt"
				blockoverride "condition_label" {
					text = "banking_dash_mon_mandate_label"
				}
				blockoverride "condition_value" {
					banking_dash_condition_value = {
						text = "banking_dash_ro_mandate_value"
					}
				}
			}

			banking_dash_condition_row = {
				visible = "[GetScriptedGui('banking_mon_is_anchored').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "banking_dash_ro_anchor_tt"
				blockoverride "condition_label" {
					text = "banking_dash_mon_anchor_label"
				}
				blockoverride "condition_value" {
					banking_dash_condition_value = {
						multiline = yes
						text = "banking_dash_ro_anchor_value"
					}
				}
			}

			banking_dash_condition_row = {
				tooltip = "banking_dash_ro_fx_tt"
				blockoverride "condition_label" {
					text = "banking_dash_mon_fx_label"
				}
				blockoverride "condition_value" {
					banking_dash_condition_value = {
						multiline = yes
						text = "banking_dash_ro_fx_value"
					}
				}
			}

			### Peg Confidence: a gold dial's (banking_mon_shows_gold), or a
			### treaty pegger's (banking_mon_shows_anchor_peg). Never both: an
			### anchored country has no dial.
			banking_dash_condition_row = {
				visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "banking_dash_ro_pegconf_tt"
				blockoverride "condition_label" {
					text = "banking_dash_mon_pegconf_label"
				}
				blockoverride "condition_value" {
					banking_dash_condition_value = {
						multiline = yes
						text = "banking_dash_ro_pegconf_value"
					}
				}
			}

			banking_dash_mon_meter = {
				visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "banking_dash_ro_pegconf_tt"
				blockoverride "meter_value" {
					value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('te_mon_peg_confidence_scaled') )]"
				}
			}

			banking_dash_condition_row = {
				visible = "[GetScriptedGui('banking_mon_shows_anchor_peg').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "banking_dash_ro_anchorpeg_tt"
				blockoverride "condition_label" {
					text = "banking_dash_mon_pegconf_label"
				}
				blockoverride "condition_value" {
					banking_dash_condition_value = {
						text = "banking_dash_ro_anchorpeg_value"
					}
				}
			}

			banking_dash_mon_meter = {
				visible = "[GetScriptedGui('banking_mon_shows_anchor_peg').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				tooltip = "banking_dash_ro_anchorpeg_tt"
				blockoverride "meter_value" {
					value = "[FixedPointToFloat( GetPlayer.MakeScope.ScriptValue('te_mon_peg_confidence_scaled') )]"
				}
			}
		}
	}

	### ==========================================================================
	### AVAILABLE INTERVENTIONS
	### ==========================================================================
	### The current economic system's tools, one collapsible category each. A
	### tool that cannot be used stays in its category, greyed, with the reason
	### in its Enable button's tooltip.
	type te_banking_sec_interventions = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2

		### A group heading over centred category sections, so centred (style
		### guide rule 7).
		textbox = {
			text = "banking_dash_available_header"
			default_format = "#header"
			autoresize = yes
			max_width = 500
			parentanchor = hcenter
			align = center|nobaseline
			margin = { 4 6 }
		}

		### Prudential Regulation
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 2
			visible = "[GetScriptedGui('banking_dash_system_market').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

			banking_dash_category_header = {
				blockoverride "left_text" {
					text = "banking_dash_cat_prudential"
					using = elide_fontsize_min
				}
				blockoverride "onclick" {
					onclick = "[GetVariableSystem.Toggle('banking_dash_prudential_closed')]"
				}
				blockoverride "onclick_showmore" {
					visible = "[GetVariableSystem.Exists('banking_dash_prudential_closed')]"
				}
				blockoverride "onclick_showless" {
					visible = "[Not(GetVariableSystem.Exists('banking_dash_prudential_closed'))]"
				}
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 2
				visible = "[Not(GetVariableSystem.Exists('banking_dash_prudential_closed'))]"

				### Softest first. Moral suasion is a lean on the banks against a
				### boom, the same job the buffer and margin requirements do with
				### rules instead of words (banking_cycle_sim.py's LEANING_TOOLS),
				### so it sits here rather than under Monetary Policy.
				banking_dash_policy_row = {
					visible = "[GetScriptedGui('banking_dash_enable_cb_moral_suasion').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "banking_dash_tt_cb_moral_suasion"
					blockoverride "row_label" {
						text = "CB_MORAL_SUASION"
					}
					blockoverride "row_cost" {
						text = "banking_dash_cost_cb_moral_suasion"
					}
					blockoverride "enable_action" {
						datacontext = "[GetScriptedGui('banking_dash_enable_cb_moral_suasion')]"
						text = "banking_dash_btn_enable"
					}
					blockoverride "disable_action" {
						datacontext = "[GetScriptedGui('banking_dash_disable_cb_moral_suasion')]"
						text = "banking_dash_btn_disable"
					}
				}

				banking_dash_policy_row = {
					visible = "[GetScriptedGui('banking_dash_enable_cb_reserve_requirements').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "banking_dash_tt_cb_reserve_requirements"
					blockoverride "row_label" {
						text = "CB_RESERVE_REQUIREMENTS"
					}
					blockoverride "row_cost" {
						text = "banking_dash_cost_cb_reserve_requirements"
					}
					blockoverride "enable_action" {
