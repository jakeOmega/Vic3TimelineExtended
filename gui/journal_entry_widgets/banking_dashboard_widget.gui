		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 2
			visible = "[Not(GetVariableSystem.Exists('banking_dash_collapsed_council'))]"

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_enable_cw_council_directive').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cw_council_directive"
				blockoverride "row_label" {
					text = "CW_COUNCIL_DIRECTIVE"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cw_council_directive"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cw_council_directive')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cw_council_directive')]"
					text = "banking_dash_btn_disable"
				}
			}

			banking_dash_policy_row = {
				visible = "[GetScriptedGui('banking_dash_enable_cw_consumption_ceiling').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				tooltip = "banking_dash_tt_cw_consumption_ceiling"
				blockoverride "row_label" {
					text = "CW_CONSUMPTION_CEILING"
				}
				blockoverride "row_cost" {
					text = "banking_dash_cost_cw_consumption_ceiling"
				}
				blockoverride "enable_action" {
					datacontext = "[GetScriptedGui('banking_dash_enable_cw_consumption_ceiling')]"
					text = "banking_dash_btn_enable"
				}
				blockoverride "disable_action" {
					datacontext = "[GetScriptedGui('banking_dash_disable_cw_consumption_ceiling')]"
					text = "banking_dash_btn_disable"
				}
			}

		}
	}

	### Membership Mobilisation
	flowcontainer = {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2
		visible = "[GetScriptedGui('banking_dash_system_coop').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		banking_dash_category_header = {
			blockoverride "left_text" {
				text = "banking_dash_cat_membership"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('banking_dash_collapsed_membership')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('banking_dash_collapsed_membership')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('banking_dash_collapsed_membership'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 2
			visible = "[Not(GetVariableSystem.Exists('banking_dash_collapsed_membership'))]"

