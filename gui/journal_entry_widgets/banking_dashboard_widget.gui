				}

				banking_dash_policy_row = {
					visible = "[GetScriptedGui('banking_dash_enable_cb_expand_deposit_guarantee').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "banking_dash_tt_cb_expand_deposit_guarantee"
					blockoverride "row_label" {
						text = "CB_EXPAND_DEPOSIT_GUARANTEE"
					}
					blockoverride "row_cost" {
						text = "banking_dash_cost_cb_expand_deposit_guarantee"
