	### ---- Available interventions ----------------------------------------
	textbox = {
		text = "banking_dash_available_header"
		default_format = "#header"
		autoresize = yes
		max_width = 500
		align = left|nobaseline
		margin = { 4 6 }
	}

	### Monetary Policy
	###
	### Unlike every other category below, this one is NOT gated on the market
	### economy. The policy dial exists for every country — a command economy
	### administers its rate, a bankless one pays the world rate plus a spread —
	### and the block's whole job for those countries is to say so in one line
	### (monetary_policy_design.md §3, §4, §5.3). The market-economy gate moved
	### down onto the two intervention rows, which really are market-only.
	flowcontainer = {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2

		banking_dash_category_header = {
			blockoverride "left_text" {
				text = "banking_dash_cat_monetary"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('banking_dash_collapsed_monetary')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('banking_dash_collapsed_monetary')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('banking_dash_collapsed_monetary'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 2
			visible = "[Not(GetVariableSystem.Exists('banking_dash_collapsed_monetary'))]"

			### ---- The policy dial (monetary_policy_design.md §3) ----------
			### Readouts for every country; the three interactive rows only for
			### one that holds the dial. Nothing here renders the neutral rate,
			### the stance gap or the estimation error — the stance band name is
			### the only window onto any of them (§8, "The rule").
			###
			### THE WHOLE BLOCK IS OFF UNDER `banking_system_simplified` — the rate,
			### the premium, prices, gold and the exchange rate all belong to the
			### monetary layer that setting removes. The two intervention rows below
			### it share the category header and are NOT gated on it.
			flowcontainer = {
				visible = "[GetScriptedGui('banking_mon_system_shown').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 2
				margin = { 8 6 }

				background = {
					using = entry_bg_fancy_dark
					alpha = 0.35
				}

				### Everything below is written by te_monetary_monthly_update, so
				### until a country's first pulse there is nothing to read and
				### every `var:` would log "Failed to fetch variable" per frame.
				textbox = {
					visible = "[Not( GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
					text = "banking_dash_mon_not_ready"
					autoresize = yes
					multiline = yes
					max_width = 460
					align = left|nobaseline
				}

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					parentanchor = hcenter
					spacing = 2
					visible = "[GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					### Why there is no dial here — one line, cause-specific.
					### Hidden for a country that holds one.
					textbox = {
						visible = "[Not( GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
						text = "banking_dash_mon_no_dial_line"
						autoresize = yes
						multiline = yes
						max_width = 460
						align = left|nobaseline
						margin_bottom = 2
					}

					banking_dash_mon_subheader = {
						blockoverride "mon_subheader_text" {
							text = "banking_dash_mon_sub_rates"
						}
					}

					### World reference rate — read-only, the same figure for
					### every country, and the anchor the rest of the block is
					### measured against: it is the base of the lenders' floor
					### (§10) and what the World Rate below falls back to when
					### no great power sets a rate of its own. Public
					### information by spec §10, unlike anything downstream of
					### the neutral rate.
					###
					### te_mon_era_base_now is the country's per-pulse copy of
					### global_var:te_mon_era_base_world. It is read rather than
					### the global because a .gui has no HasGlobalVariable to
					### guard with (gui_modding_guide.md gotcha 15), and step 0
					### of the monthly update writes it before anything else —
					### so banking_mon_display_ready, which now asks for it,
					### is the guard.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_world_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_world_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_world_value"
							}
						}
					}

					### World rate (phase 3, §12.1) — the REAL rate the discretionary
					### great powers are actually running, GDP-weighted. A no-dial
					### country pays it plus expectations plus a point, Peg Defence
					### targets it, and a gold country's reserves move on the gap
					### against it. Built from displayed figures only (policy rates
					### and expected inflation), so it is printed exactly.
					###
					### te_mon_world_rate_now is the per-pulse copy of
					### global_var:te_world_rate, read for the same reason as
					### te_mon_era_base_now above; its own readiness handler
					### because a phase-2 save has none until its first pulse.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_world_rate_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_worldrate_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_worldrate_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_worldrate_value"
							}
						}
					}

					### Policy rate — the actual rate, one decimal.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_rate_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_rate_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_rate_value"
							}
						}
					}

					### Target — the dial itself. Ops 0 (down) and 1 (up) of
					### banking_mon_control_sgui; the handler answers why a step
					### is greyed out, so no threshold lives in this file.
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 6
						parentanchor = left
						tooltip = "banking_dash_mon_target_tt"
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_target_label"
							}
						}

						button_icon_minus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
							### Click a point, ctrl-click a tenth, shift-click to the limit.
							click_modifiers = {
								ondefault = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
								onctrl = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
								onshift = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)11' ) ).End )]"
							}
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
						}

						widget = {
							size = { 68 28 }
							textbox = {
								parentanchor = center
								align = center|nobaseline
								autoresize = yes
								max_width = 68
								elide = right
								using = fontsize_large
								text = "banking_dash_mon_target_value"
							}
						}

						button_icon_plus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
							### Click a point, ctrl-click a tenth, shift-click to the limit.
							click_modifiers = {
								ondefault = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
								onctrl = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
								onshift = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
							}
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
						}
					}

					banking_dash_mon_subheader = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						blockoverride "mon_subheader_text" {
							text = "banking_dash_mon_sub_gold"
						}
					}

					### The bank's own vault (the hybrid model) — what the flows below
					### move, as pounds and as a share of its limit. NOT the treasury.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_bankgold_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_bankgold_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_bankgold_value"
							}
						}
					}

					banking_dash_mon_meter = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_bankgold_tt"
						blockoverride "meter_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('te_mon_bank_gold_scaled') )]"
						}
					}

					### ---- Gold and the peg (phase 3, §12.2-12.3) ---------------
					### Three rows, for a gold-standard country with a national
					### bank only (banking_mon_shows_gold) — suspended or not; the
					### values' customizable localization says "suspended" where
					### that is the answer. None of it is hidden state: the gap is
					### policy rate minus world rate, both displayed.
					###
					### Gap against the world rate — what moves the gold.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldgap_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_goldgap_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_goldgap_value"
							}
						}
					}

					### Gold flow this month. add_treasury never appears in the
					### budget ledger (§12.2), so this row is the only place the
					### player can see it; the tooltip carries the hot-money
					### balance that says how much of the vault is borrowed.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldflow_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_goldflow_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_goldflow_value"
							}
						}
					}

					### Borrowed gold and what it costs — rows of their own since the
					### first playtest: a balance the player owes, growing every month
					### the rate is held high, is not tooltip material. Both share the
					### Gold Flow tooltip, which is where the mechanism is explained.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldflow_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_hotmoney_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_hotmoney_value"
							}
						}
					}

					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldflow_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_goldcarry_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_goldcarry_value"
							}
						}
					}

					### Peg confidence, 0-100. §3 asks for a bar; a figure with a
					### word beside it reads the same and costs no new widget.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_pegconf_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_pegconf_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_pegconf_value"
							}
						}
					}

					banking_dash_mon_meter = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_pegconf_tt"
						blockoverride "meter_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('te_mon_peg_confidence_scaled') )]"
						}
					}

					### Recapitalise — op 13, treasury -> vault, one way. The handler
					### answers why it is greyed out, so no threshold lives here.
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						parentanchor = hcenter
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_button = {
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)13' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)13' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)13' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)13' ) ).End ) ) )]"
							size = { 200 28 }
							text = "banking_dash_mon_btn_recapitalise"
						}
					}

					### ---- The exchange rate (phase 4, §15) ----------------------
					### Two rows for every country. The index is shown EXACTLY: every
					### input to it is already exact on this dashboard (r* enters only
					### through the policy rate the player chose), so it leaks no
					### hidden state. te_mon_fx_state says "Par" for metal and for a
					### command economy; the tooltip lists fx_target's four terms.
					banking_dash_mon_subheader = {
						blockoverride "mon_subheader_text" {
							text = "banking_dash_mon_sub_fx"
						}
					}

					banking_dash_condition_row = {
