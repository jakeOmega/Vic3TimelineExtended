	### ---- Available interventions ----------------------------------------
	textbox = {
		text = "banking_dash_available_header"
		default_format = "#header"
		autoresize = yes
		max_width = 500
		align = left|nobaseline
		margin = { 4 6 }
	}

	### Monetary Policy
	###
	### Unlike every other category below, this one is NOT gated on the market
	### economy. The policy dial exists for every country — a command economy
	### administers its rate, a bankless one pays the world rate plus a spread —
	### and the block's whole job for those countries is to say so in one line
	### (monetary_policy_design.md §3, §4, §5.3). The market-economy gate moved
	### down onto the two intervention rows, which really are market-only.
	flowcontainer = {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2

		banking_dash_category_header = {
			blockoverride "left_text" {
				text = "banking_dash_cat_monetary"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('banking_dash_collapsed_monetary')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('banking_dash_collapsed_monetary')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('banking_dash_collapsed_monetary'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 2
			visible = "[Not(GetVariableSystem.Exists('banking_dash_collapsed_monetary'))]"

			### ---- The policy dial (monetary_policy_design.md §3) ----------
			### Readouts for every country; the three interactive rows only for
			### one that holds the dial. Nothing here renders the neutral rate,
			### the stance gap or the estimation error — the stance band name is
			### the only window onto any of them (§8, "The rule").
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 2
				margin = { 8 6 }

				background = {
					using = entry_bg_fancy_dark
					alpha = 0.35
				}

				### Everything below is written by te_monetary_monthly_update, so
				### until a country's first pulse there is nothing to read and
				### every `var:` would log "Failed to fetch variable" per frame.
				textbox = {
					visible = "[Not( GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
					text = "banking_dash_mon_not_ready"
					autoresize = yes
					multiline = yes
					max_width = 460
					align = left|nobaseline
				}

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					parentanchor = hcenter
					spacing = 2
					visible = "[GetScriptedGui('banking_mon_display_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

					### Why there is no dial here — one line, cause-specific.
					### Hidden for a country that holds one.
					textbox = {
						visible = "[Not( GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
						text = "banking_dash_mon_no_dial_line"
						autoresize = yes
						multiline = yes
						max_width = 460
						align = left|nobaseline
						margin_bottom = 2
					}

					### World reference rate — read-only, the same figure for
					### every country, and the anchor the rest of the block is
					### measured against: it is the base of the lenders' floor
					### (§10) and what the World Rate below falls back to when
					### no great power sets a rate of its own. Public
					### information by spec §10, unlike anything downstream of
					### the neutral rate.
					###
					### te_mon_era_base_now is the country's per-pulse copy of
					### global_var:te_mon_era_base_world. It is read rather than
					### the global because a .gui has no HasGlobalVariable to
					### guard with (gui_modding_guide.md gotcha 15), and step 0
					### of the monthly update writes it before anything else —
					### so banking_mon_display_ready, which now asks for it,
					### is the guard.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_world_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_world_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_world_value"
							}
						}
					}

					### World rate (phase 3, §12.1) — the REAL rate the discretionary
					### great powers are actually running, GDP-weighted. A no-dial
					### country pays it plus expectations plus a point, Peg Defence
					### targets it, and a gold country's reserves move on the gap
					### against it. Built from displayed figures only (policy rates
					### and expected inflation), so it is printed exactly.
					###
					### te_mon_world_rate_now is the per-pulse copy of
					### global_var:te_world_rate, read for the same reason as
					### te_mon_era_base_now above; its own readiness handler
					### because a phase-2 save has none until its first pulse.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_world_rate_ready').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_worldrate_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_worldrate_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_worldrate_value"
							}
						}
					}

					### Policy rate — the actual rate, one decimal.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_rate_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_rate_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_rate_value"
							}
						}
					}

					### Target — the dial itself. Ops 0 (down) and 1 (up) of
					### banking_mon_control_sgui; the handler answers why a step
					### is greyed out, so no threshold lives in this file.
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 6
						parentanchor = left
						tooltip = "banking_dash_mon_target_tt"
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_target_label"
							}
						}

						button_icon_minus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) )]"
						}

						widget = {
							size = { 68 28 }
							textbox = {
								parentanchor = center
								align = center|nobaseline
								autoresize = yes
								max_width = 68
								elide = right
								using = fontsize_large
								text = "banking_dash_mon_target_value"
							}
						}

						button_icon_plus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) )]"
						}
					}

					### ---- Gold and the peg (phase 3, §12.2-12.3) ---------------
					### Three rows, for a gold-standard country with a national
					### bank only (banking_mon_shows_gold) — suspended or not; the
					### values' customizable localization says "suspended" where
					### that is the answer. None of it is hidden state: the gap is
					### policy rate minus world rate, both displayed.
					###
					### Gap against the world rate — what moves the gold.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldgap_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_goldgap_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_goldgap_value"
							}
						}
					}

					### Gold flow this month. add_treasury never appears in the
					### budget ledger (§12.2), so this row is the only place the
					### player can see it; the tooltip carries the hot-money
					### balance that says how much of the vault is borrowed.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_goldflow_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_goldflow_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_goldflow_value"
							}
						}
					}

					### Peg confidence, 0-100. §3 asks for a bar; a figure with a
					### word beside it reads the same and costs no new widget.
					banking_dash_condition_row = {
						visible = "[GetScriptedGui('banking_mon_shows_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "banking_dash_mon_pegconf_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_pegconf_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_pegconf_value"
							}
						}
					}

					### What the treasury actually pays. The engine's own figure
					### first, this system's arithmetic beside it — if the two
					### drift apart, something outside the system is moving the
					### rate and the player can see it (§17 check 6).
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_paid_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_paid_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_paid_value"
							}
							banking_dash_condition_value = {
								text = "banking_dash_mon_paid_script_tag"
							}
						}
					}

					### Credit standing — the structural tier (§7).
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_standing_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_standing_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_standing_value"
							}
						}
					}

					### Risk premium — the cyclical tier (§7).
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_premium_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_premium_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_premium_value"
							}
						}
					}

					### ---- Prices (monetary_policy_design.md §3, §9) --------
					### Headline and expected inflation are shown EXACTLY, to one
					### decimal: both are things the player can act on, and both
					### are already priced by their lenders. Core inflation, the
					### noise walk and the §9.1 pressure sum are hidden state and
					### appear nowhere here (ruling P7) — the two pressure rows
					### print only the part the player CHOSE, which is a modifier
					### the engine breaks down on its own.

					### Inflation — what prices actually did.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_inflation_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_inflation_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_inflation_value"
							}
						}
					}

					### Expected inflation — what lenders and workers have
					### priced in, which is the half that costs money.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_expected_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_expected_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_expected_value"
							}
						}
					}

					### Price band — the band NAME, and in the tooltip the band
					### modifier's own account of what it costs. No band edge
					### and no modifier value is copied into this file: both
					### come from customizable_localization blocks reading the
					### band variable step 6b wrote.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_band_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_band_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_band_value"
							}
						}
					}

					### Wage pressure — the labour and welfare half (§9.4),
					### kept apart from every other source because it is the
					### half that earns the real-wage dividend.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_wage_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_wage_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_wage_value"
							}
						}
					}

					### Price pressure — everything else the player chose:
					### devaluations, crisis outcomes, event modifiers.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_pressure_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_pressure_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_pressure_value"
							}
						}
					}

					### Monetising the deficit — ops 7 (down) and 8 (up) of
					### banking_mon_control_sgui, the same shape as the target
					### stepper above.
					###
					### NOT hidden for a country that may not monetise, unlike
					### the delegation and mandate rows further down. Printing
					### money is the one lever here whose absence is itself a
					### fact about the country's laws, so the row stays, the
					### level reads 0, and the two buttons grey out carrying
					### one line that names the cause
					### (te_mon_monetise_condition).
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 6
						parentanchor = left
						tooltip = "banking_dash_mon_monetise_tt"
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_monetise_label"
							}
						}

						button_icon_minus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ) )]"
						}

						widget = {
							size = { 68 28 }
							textbox = {
								parentanchor = center
								align = center|nobaseline
								autoresize = yes
								max_width = 68
								elide = right
								using = fontsize_large
								text = "banking_dash_mon_monetise_value"
							}
						}

						button_icon_plus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ) )]"
						}
					}

					### Policy stance — the band NAME and nothing else.
					banking_dash_condition_row = {
						tooltip = "banking_dash_mon_stance_tt"
						blockoverride "condition_label" {
							text = "banking_dash_mon_stance_label"
						}
						blockoverride "condition_value" {
							banking_dash_condition_value = {
								text = "banking_dash_mon_stance_value"
							}
						}
					}

					### Delegation — ops 2 (delegate) and 3 (take it back).
					### Exactly one button is ever drawn, and neither is drawn
					### under central bank independence, which is permanently
					### mandate-bound; the value cell says so there (§5.2).
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 6
						parentanchor = left
						tooltip = "banking_dash_mon_delegation_tt"
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_delegation_label"
							}
						}

						banking_dash_mon_value = {
							blockoverride "mon_value_text" {
								text = "banking_dash_mon_delegation_value"
							}
						}

						banking_dash_mon_button = {
							visible = "[And( GetScriptedGui('banking_mon_can_delegate').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Not( GetScriptedGui('banking_mon_is_delegated').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) )]"
							text = "banking_dash_mon_btn_delegate"
						}

						banking_dash_mon_button = {
							visible = "[And( GetScriptedGui('banking_mon_can_delegate').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('banking_mon_is_delegated').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ) )]"
							text = "banking_dash_mon_btn_take_control"
						}
					}

					### Mandate — which rule a delegated bank follows.
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 6
						parentanchor = left
						tooltip = "banking_dash_mon_mandate_tt"
						visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_label = {
							blockoverride "mon_label_text" {
								text = "banking_dash_mon_mandate_label"
							}
						}

						banking_dash_mon_value = {
							blockoverride "mon_value_text" {
								text = "banking_dash_mon_mandate_value"
							}
						}
					}

					### Ops 4 / 5 / 6. The mandate already in force is greyed out
					### by the handler's is_valid — that is the "you are here"
					### marker — and peg defence only exists on a gold standard.
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = hcenter
						margin_bottom = 2
						datacontext = "[GetScriptedGui('banking_mon_control_sgui')]"
						visible = "[GetScriptedGui('banking_mon_has_dial').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

						banking_dash_mon_button = {
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ) )]"
							text = "banking_dash_mon_mandate_price"
						}

						banking_dash_mon_button = {
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ) )]"
							text = "banking_dash_mon_mandate_growth"
						}

						banking_dash_mon_button = {
							visible = "[GetScriptedGui('banking_mon_is_gold').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End ) )]"
							text = "banking_dash_mon_mandate_peg"
						}
					}
				}
			}

			### ---- Market-economy interventions ---------------------------
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 2
				visible = "[GetScriptedGui('banking_dash_system_market').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

				banking_dash_policy_row = {
					visible = "[GetScriptedGui('banking_dash_enable_cb_open_market_ops').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "banking_dash_tt_cb_open_market_ops"
