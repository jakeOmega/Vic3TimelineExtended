### Nuclear Weapons — the programme half, as a type library: one type per
### section (te_nuclear_sec_*) for je_nuclear_program ("Nuclear Weapons").
### gui/journal_entry_widgets/nuclear_layout_widget.gui sets the order of these
### sections among the deterrence half's (nuclear_deterrence_widget.gui) and
### holds the named roots the entry attaches; see its header for the whole
### panel.
###
### te_nuclear_sec_programme   Funding (a stepper), the warhead production
###                            rate, time to the next warhead and the first
###                            device (open, only while the country has a
###                            programme). Mounted in container_3, just
###                            above the entry's native bar.
### te_nuclear_sec_taboo       The nuclear taboo (open, from the world's first
###                            warhead), with its chart as a subsection, open.
### te_nuclear_sec_delivery    Delivery capability and home defence (open).
### te_nuclear_sec_powers      The global nuclear-powers leaderboard, a table
###                            of the ten largest arsenals (open, from the
###                            world's first warhead).
### The notes these sections used to carry (how a strike's odds combine, what
### the leaderboard's estimates are) are in "How Nuclear Weapons Work"
### (te_nuclear_sec_how, nuclear_layout_widget.gui).
###
### WHERE THE NUMBERS COME FROM. Nothing here computes anything. Every value is
### a display-only script value in common/script_values/extra_script_values.txt
### (the nuclear_program_display_* family), every branchy phrase is a
### customizable-localization block in
### common/customizable_localization/nuclear_program_custom_loc.txt, and the
### programme's state is the single variable nuclear_program_last_status, written
### in one place only — nuclear_program_refresh_state_effect. No threshold and no
### rate is restated in this file.
###
### WHAT A HUMAN CAN DO HERE. The entry's two scripted buttons are hidden from
### humans (`is_ai = yes` on their `visible`) and remain the AI's only path into
### the programme. Both of their actions exist below, through
### nuclear_program_funding_sgui:
###     op 0   step funding down      op 1   step funding up
### The op table is repeated in common/scripted_guis/nuclear_program_sguis.txt
### and in docs/systems/journal_entry_systems.md; keep all three in step.
###
### The Nuclear Powers leaderboard is a datamodel over nd_powers, a list of
### the ten largest arsenals' capitals that update_nuclear_powers_ranking keeps
### on the panel's global store (NUC-14 of the 2026-10-27 GUI audit): each row
### reads its country through the capital (State.GetOwner, gui_modding_guide.md
### gotcha #15), with vanilla's flag for the name and a click.
###
### NO CONTROL'S `visible` COMES FROM AN op-BRANCHING `IsShown`. Whether a saved
### scope passed through `IsShown( … AddScope('op', …) … )` reaches a handler's
### `is_shown` is unproven in this mod: `is_valid` provably receives it, but no
### vanilla handler reads a saved scope inside `is_shown`. With this entry's
### button grid hidden from humans, a stepper whose `visible` silently evaluated
### false would leave the player unable to act at all, so the two stepper buttons
### carry no `visible` — they are simply there while the entry is active, and
### `is_valid` greys them and says why.
###
### THE ROOTS ARE GATED ON JournalEntry.IsActive (nuclear_layout_widget.gui).
### je_nuclear_program carries is_shown_when_inactive, so the panel is built for
### every country that has the tech and the game rule, including ones whose
### entry never activated and which have none of the programme's variables
### (gotcha #14). Everything is guarded in script as well, but there is nothing
### worth drawing in that state and the sguis re-render every frame the entry is
### on screen. The one thing that *does* have to speak for a deactivated entry —
### "a disarmament settlement has dismantled our programme" — is the entry's
### status_desc, which gui/journal_entry.gui:188 renders with no IsActive gate.
###
### Section collapse state lives in GetVariableSystem: client-side, never saved,
### never gameplay state, and invisible to script. Each flag says its default
### (style guide rule 7): *_closed sections are open until closed, *_open ones
### collapsed until opened (test_nuclear_layout.py).

types nuclear_program_widget_types
{
	type nuclear_program_panel = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 1
		margin = { 10 6 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	type nuclear_program_section_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 520 38 }
		}
	}

	type nuclear_program_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = te_nuclear_fontsize_row
	}

	### A label/value line. One tooltip for the whole row, so the number and the
	### explanation of the number are never separated. 200 + 276 (round 3: the
	### values are the longer half; test_nuclear_layout.LabelBudgetTest).
	type nuclear_program_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 6 1 }

		block "row_tooltip" {}

		textbox = {
			size = { 200 24 }
			align = left|nobaseline
			using = te_nuclear_fontsize_row
			parentanchor = vcenter
			elide = right
			alwaystransparent = yes
			### Underlined, since the row carries a tooltip (style rule 3). A row
			### without one overrides this block empty.
			block "label_format" {
				default_format = "#tooltippable"
			}
			block "row_label" {}
		}

		textbox = {
			size = { 276 24 }
			align = right|nobaseline
			using = te_nuclear_fontsize_row
			parentanchor = vcenter
			elide = right
			alwaystransparent = yes
			block "row_value" {}
		}
	}

	### The funding control. The scripted GUI's datacontext is set here, on the
	### row, so both buttons inherit it and address their action by op code
	### alone. Each tooltip is IsValidTooltip (why the button is greyed out, one
	### ticked or crossed line per clause of the shared trigger) concatenated
	### with ExecuteTooltip (what pressing it does, rendered from the very effect
	### the AI's button runs, without running it).
	type nuclear_program_funding_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 6 2 }
		datacontext = "[GetScriptedGui('nuclear_program_funding_sgui')]"

		textbox = {
			text = "je_nuclear_program_widget_funding_label"
			size = { 170 24 }
			align = left|nobaseline
			using = te_nuclear_fontsize_row
			parentanchor = vcenter
			elide = right
			alwaystransparent = yes
		}

		button_icon_minus_action = {
			size = { 24 24 }
			parentanchor = vcenter
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
			tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
		}

		textbox = {
			text = "je_nuclear_program_widget_funding_value"
			tooltip = "je_nuclear_program_widget_funding_tt"
			default_format = "#tooltippable"
			size = { 246 24 }
			align = center|nobaseline
			using = te_nuclear_fontsize_row
			parentanchor = vcenter
			elide = right
		}

		button_icon_plus_action = {
			size = { 24 24 }
			parentanchor = vcenter
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
		}
	}

	### One row of Nuclear Powers (NUC-14): an item of nd_powers, so its
	### datacontext is the country's capital and the country is State.GetOwner
	### (gui_modding_guide.md gotcha #15). Vanilla's flag gives the name on
	### hover and opens the country on a click; then the name, the arsenal as
	### the world estimates it, and the public doctrine as the overview's icon
	### (its name on hover). Our own row is tinted.
	### 6 + 40 + 6 + 240 + 6 + 110 + 6 + 28 = 442.
	type nuclear_program_power_row = widget {
		size = { 480 30 }

		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/backgrounds/white.dds"
			color = { 0.9 0.75 0.35 0.2 }
			visible = "[ObjectsEqual( State.GetOwner, GetPlayer.Self )]"
		}
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 6
			position = { 6 0 }
			parentanchor = vcenter

			widget = {
				size = { 40 28 }
				parentanchor = vcenter

				tiny_flag = {
					parentanchor = center
					datacontext = "[State.GetOwner]"
				}
			}
			textbox = {
				size = { 240 28 }
				align = left|nobaseline
				using = te_nuclear_fontsize_row
				parentanchor = vcenter
				elide = right
				text = "[State.GetOwner.GetNameNoFormatting]"
			}
			textbox = {
				size = { 110 28 }
				align = right|nobaseline
				using = te_nuclear_fontsize_row
				parentanchor = vcenter
				elide = right
				text = "nuclear_program_power_estimate"
			}
			widget = {
				size = { 28 28 }
				parentanchor = vcenter
				tooltip = "nuclear_program_power_doctrine_tt"

				icon = {
					size = { 28 28 }
					visible = "[EqualTo_CFixedPoint( State.GetOwner.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)1' )]"
					texture = "gfx/interface/icons/nuclear_icons/doctrine_nfu.dds"
				}
				icon = {
					size = { 28 28 }
					visible = "[EqualTo_CFixedPoint( State.GetOwner.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)2' )]"
					texture = "gfx/interface/icons/nuclear_icons/doctrine_existential.dds"
				}
				icon = {
					size = { 28 28 }
					visible = "[EqualTo_CFixedPoint( State.GetOwner.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)3' )]"
					texture = "gfx/interface/icons/nuclear_icons/doctrine_flexible.dds"
				}
				icon = {
					size = { 28 28 }
					visible = "[EqualTo_CFixedPoint( State.GetOwner.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)4' )]"
					texture = "gfx/interface/icons/nuclear_icons/doctrine_compellence.dds"
				}
				icon = {
					size = { 28 28 }
					visible = "[EqualTo_CFixedPoint( State.GetOwner.MakeScope.ScriptValue('nd_display_doctrine_code'), '(CFixedPoint)5' )]"
					texture = "gfx/interface/icons/nuclear_icons/doctrine_warfighting.dds"
				}
			}
		}
	}

	### The leaderboard's column heads, in its rows' cells.
	type nuclear_program_powers_head = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6
		margin = { 6 1 }

		textbox = {
			size = { 286 24 }
			align = left|nobaseline
			using = te_nuclear_fontsize_row
			parentanchor = vcenter
			elide = right
			default_format = "#lore"
			text = "je_nuclear_program_widget_powers_head_country"
		}
		textbox = {
			size = { 110 24 }
			align = right|nobaseline
			using = te_nuclear_fontsize_row
			parentanchor = vcenter
			elide = right
			default_format = "#tooltippable"
			text = "je_nuclear_program_widget_powers_head_warheads"
			tooltip = "je_nuclear_program_widget_powers_head_warheads_tt"
		}
	}

	### ======================================================================
	### SECTIONS. nuclear_layout_widget.gui composes them, in its order.
	### ======================================================================

	### The programme (open; only while the country has one): funding, the
	### production rate, time to the next warhead and the first device. Warheads
	### held is the overview's (its row here said the same number a third time). The journal entry mounts it directly above its native bar, which is
	### progress toward that next warhead, so the numbers that explain the bar sit
	### next to it. The entry is also active for an armed power without the
	### standing to build and for a non-nuclear party to a crisis, and neither has
	### anything to fund.
	type te_nuclear_sec_programme = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('nuclear_program_has_programme_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		nuclear_program_section_header = {
			blockoverride "left_text" {
				text = "je_nuclear_program_widget_programme_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('nuclear_program_programme_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('nuclear_program_programme_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('nuclear_program_programme_closed'))]"
			}
		}

		nuclear_program_panel = {
			visible = "[Not(GetVariableSystem.Exists('nuclear_program_programme_closed'))]"

			nuclear_program_funding_row = {}

			nuclear_program_row = {
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_rate_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_rate_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "je_nuclear_program_widget_rate_tt"
				}
			}

			nuclear_program_row = {
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_next_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_next_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "je_nuclear_program_widget_next_tt"
				}
			}

			nuclear_program_row = {
				blockoverride "label_format" {}
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_first_device_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_first_device_value"
				}
			}
		}
	}

	### The nuclear taboo (open; from the world's first warhead, for every country
	### — the entry is active for all of them by then): the score, where it is
	### heading and why, what a nuclear act costs us now, the burden of our arsenal,
	### the last use in war, and its chart (nuclear_taboo_values.txt).
	type te_nuclear_sec_taboo = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetScriptedGui('nd_taboo_exists_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"

		nuclear_program_section_header = {
			blockoverride "left_text" {
				text = "je_nuclear_program_widget_taboo_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('nd_taboo_panel_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('nd_taboo_panel_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('nd_taboo_panel_closed'))]"
			}
		}

		nuclear_program_panel = {
			visible = "[Not(GetVariableSystem.Exists('nd_taboo_panel_closed'))]"

			### One row for the score, where it is heading and its band (NUC-11):
			### the overview's bar draws the same movement, without colour.
			nuclear_program_row = {
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_taboo_score_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_taboo_score_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "[Concatenate( Localize( 'je_nuclear_program_widget_taboo_score_tt' ), GetScriptedGui('nd_taboo_breakdown_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
				}
			}

			nuclear_program_row = {
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_taboo_strategic_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_taboo_strategic_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "je_nuclear_program_widget_taboo_costs_tt"
				}
			}

			nuclear_program_row = {
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_taboo_tactical_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_taboo_tactical_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "je_nuclear_program_widget_taboo_costs_tt"
				}
			}

			nuclear_program_row = {
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_taboo_threat_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_taboo_threat_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "je_nuclear_program_widget_taboo_costs_tt"
				}
			}

			nuclear_program_row = {
				visible = "[GetScriptedGui('nd_armed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_taboo_burden_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_taboo_burden_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "je_nuclear_program_widget_taboo_burden_tt"
				}
			}

			### When a weapon was last used in war: a live line, in the section's
			### own text style.
			nuclear_program_text = {
				text = "je_nuclear_program_widget_taboo_note"
			}

			### The taboo's history (a subsection, open: the owner's rule for history
			### charts, 2026-09-29) — the shared chart types and range variable
			### (te_history_chart.gui), as the UN chart uses.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				margin_left = 20
				margin_top = 6

				nd_subsection_header = {
					blockoverride "left_text" {
						text = "je_nuclear_program_widget_taboo_history_header"
					}
					blockoverride "onclick" {
						onclick = "[GetVariableSystem.Toggle('nd_taboo_hist_closed')]"
					}
					blockoverride "onclick_showmore" {
						visible = "[GetVariableSystem.Exists('nd_taboo_hist_closed')]"
					}
					blockoverride "onclick_showless" {
						visible = "[Not(GetVariableSystem.Exists('nd_taboo_hist_closed'))]"
					}
				}
			}
			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 2
				visible = "[Not(GetVariableSystem.Exists('nd_taboo_hist_closed'))]"

				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					parentanchor = hcenter
					spacing = 4
					margin = { 4 4 }

					te_history_range_button = {
						blockoverride "range_text" {
							text = "te_hist_range_1y"
						}
						blockoverride "range_enabled" {
							enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '1' ))]"
						}
						blockoverride "range_onclick" {
							onclick = "[GetVariableSystem.Set( 'te_hist_range', '1' )]"
						}
					}
					te_history_range_button = {
						blockoverride "range_text" {
							text = "te_hist_range_5y"
						}
						blockoverride "range_enabled" {
							enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '5' ))]"
						}
						blockoverride "range_onclick" {
							onclick = "[GetVariableSystem.Set( 'te_hist_range', '5' )]"
						}
					}
					te_history_range_button = {
						blockoverride "range_text" {
							text = "te_hist_range_20y"
						}
						blockoverride "range_enabled" {
							enabled = "[Or( GetVariableSystem.HasValue( 'te_hist_range', '1' ), GetVariableSystem.HasValue( 'te_hist_range', '5' ) )]"
						}
						blockoverride "range_onclick" {
							onclick = "[GetVariableSystem.Set( 'te_hist_range', '20' )]"
						}
					}
				}

				textbox = {
					visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('te_hist') ) )]"
					parentanchor = hcenter
					autoresize = yes
					multiline = yes
					max_width = 480
					align = hcenter|nobaseline
					text = "te_hist_since"
				}

				te_history_chart = {
					blockoverride "chart_title" {
						text = "nd_taboo_hist_title"
					}
					blockoverride "chart_legend" {
						text = "nd_taboo_hist_legend"
					}
					# The store's marker pips belong to other systems.
					blockoverride "marker_pips" {}
					blockoverride "bar_tooltip" {
						tooltip = "nd_taboo_hist_tt"
					}
					blockoverride "bar_body" {
						te_history_bar_unsigned = {
							visible = "[ScriptContainer.HasVariable( 'te_hist_v_nd_taboo' )]"
							blockoverride "values" {
								min = 0
								max = 100
								value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_nd_taboo' ) ) )]"
							}
							blockoverride "cover_values" {
								min = 0
								max = 100
								value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_nd_taboo' ), '(CFixedPoint)4' ) ) )]"
							}
							blockoverride "color" {
								color = { 0.80 0.45 0.25 1.0 }
							}
						}
					}
				}

				te_history_chart = {
					blockoverride "chart_title" {
						text = "nd_taboo_hist_target_title"
					}
					blockoverride "chart_legend" {
						text = "nd_taboo_hist_target_legend"
					}
					# The store's marker pips belong to other systems.
					blockoverride "marker_pips" {}
					blockoverride "bar_tooltip" {
						tooltip = "nd_taboo_hist_target_tt"
					}
					blockoverride "bar_body" {
						te_history_bar_unsigned = {
							visible = "[ScriptContainer.HasVariable( 'te_hist_v_nd_taboo_tgt' )]"
							blockoverride "values" {
								min = 0
								max = 100
								value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)2', ScriptContainer.GetVariableValue( 'te_hist_v_nd_taboo_tgt' ) ) )]"
							}
							blockoverride "cover_values" {
								min = 0
								max = 100
								value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_nd_taboo_tgt' ), '(CFixedPoint)4' ) ) )]"
							}
							blockoverride "color" {
								color = { 0.55 0.55 0.70 1.0 }
							}
						}
					}
				}
			}
		}
	}

	### What our warheads can reach and what our skies can stop (open; for everyone
	### the entry is active for — a non-nuclear crisis target has a home defence
	### too). The two ratings are the same modifiers the strike resolution reads;
	### the tooltips list the contributing technologies through the nine
	### te_nuke_attack_* / te_nuke_defense_* customizable-localization blocks. How
	### the two combine is in How Nuclear Weapons Work.
	type te_nuclear_sec_delivery = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		nuclear_program_section_header = {
			blockoverride "left_text" {
				text = "je_nuclear_program_widget_odds_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('nuclear_program_odds_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('nuclear_program_odds_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('nuclear_program_odds_closed'))]"
			}
		}

		nuclear_program_panel = {
			visible = "[Not(GetVariableSystem.Exists('nuclear_program_odds_closed'))]"

			nuclear_program_row = {
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_delivery_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_delivery_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "je_nuclear_program_widget_delivery_tt"
				}
			}

			nuclear_program_row = {
				blockoverride "row_label" {
					text = "je_nuclear_program_widget_defence_label"
				}
				blockoverride "row_value" {
					text = "je_nuclear_program_widget_defence_value"
				}
				blockoverride "row_tooltip" {
					tooltip = "je_nuclear_program_widget_defence_tt"
				}
			}
		}
	}

	### The world's ten largest arsenals as the world estimates them (open: a
	### live list, the owner's rule of 2026-09-29), as a table (NUC-14): a
	### datamodel over nd_powers, the capitals update_nuclear_powers_ranking
	### keeps on the panel's global store each month, largest first. Drawn from
	### the world's first warhead, which is when the nuclear taboo is born,
	### once the store exists (nd_powers_listed_sgui), so the datamodel never
	### reads a store the first ranking has not made yet.
	type te_nuclear_sec_powers = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[And( GetScriptedGui('nd_taboo_exists_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), GetScriptedGui('nd_powers_listed_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"

		nuclear_program_section_header = {
			blockoverride "left_text" {
				text = "je_nuclear_program_widget_powers_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('nuclear_program_powers_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('nuclear_program_powers_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('nuclear_program_powers_closed'))]"
			}
		}

		nuclear_program_panel = {
			visible = "[Not(GetVariableSystem.Exists('nuclear_program_powers_closed'))]"

			nuclear_program_powers_head = {}
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2
				datamodel = "[GetGlobalVariable('nd_lists_store').GetList('nd_powers')]"

				item = {
					nuclear_program_power_row = {
						datacontext = "[Scope.GetState]"
					}
				}
			}
		}
	}
}
