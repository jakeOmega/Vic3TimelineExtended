			blockoverride "breakdown_label" { text = "je_ch_widget_bd_instability_label" }
			blockoverride "breakdown_value" { text = "je_ch_widget_bd_instability_value" }
			blockoverride "breakdown_visible" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
			}
		}

		widget = { size = { 474 4 } }

		### Totals. Always visible; the multiplier line is op 10.
		ch_breakdown_row = {
			blockoverride "breakdown_label" { text = "je_ch_widget_bd_raw_label" }
			blockoverride "breakdown_value" { text = "je_ch_widget_bd_raw_value" }
			blockoverride "breakdown_detail" { text = "je_ch_widget_bd_global_raw_detail" }
		}
		ch_breakdown_row = {
			blockoverride "breakdown_label" { text = "je_ch_widget_bd_mult_label" }
			blockoverride "breakdown_value" { text = "je_ch_widget_bd_mult_value" }
			blockoverride "breakdown_visible" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
			}
		}
	}

	### ---- Top cultural powers -----------------------------------------------
	ch_section_header = {
		blockoverride "left_text" {
			text = "je_ch_widget_board_header"
			using = elide_fontsize_min
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('ch_board_open')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('ch_board_open'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('ch_board_open')]"
		}
	}

	### Ten rows, each one ExecuteTooltip. Inside the collapsed container, so a
	### closed board renders nothing at all.
	ch_panel = {
		visible = "[GetVariableSystem.Exists('ch_board_open')]"

		textbox = {
			text = "je_ch_widget_board_legend"
			autoresize = yes
			max_width = 474
			align = left|nobaseline
			using = fontsize_small
			default_format = "#lore"
			margin_bottom = 2
		}

		ch_board_row = {
			datacontext = "[GetScriptedGui('ch_board_row_sgui')]"
			blockoverride "row_visible" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			}
			blockoverride "row_text" {
				text = "[ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			}
			blockoverride "row_tooltip" {
				tooltip = "[GetScriptedGui('ch_board_detail_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			}
			blockoverride "row_us_marker" {
				visible = "[GetScriptedGui('ch_board_is_us_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			}
		}
		ch_board_row = {
			datacontext = "[GetScriptedGui('ch_board_row_sgui')]"
			blockoverride "row_visible" {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
			}
			blockoverride "row_text" {
				text = "[ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
			}
			blockoverride "row_tooltip" {
				tooltip = "[GetScriptedGui('ch_board_detail_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
			}
			blockoverride "row_us_marker" {
				visible = "[GetScriptedGui('ch_board_is_us_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
			}
