	### ---- History -----------------------------------------------------------
	ch_section_header = {
		blockoverride "left_text" {
			text = "je_ch_widget_history_header"
			using = elide_fontsize_min
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('ch_hist_open')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('ch_hist_open'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('ch_hist_open')]"
		}
	}

	flowcontainer = {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2
		visible = "[GetVariableSystem.Exists('ch_hist_open')]"

		### The range selector and the retention note are shared with the banking
		### charts: the same te_hist_range GUI variable drives both, so a player
		### who picks 5 years in one place sees 5 years in the other.
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			parentanchor = hcenter
			spacing = 4
			margin = { 4 4 }

			te_history_range_button = {
				blockoverride "range_text" {
					text = "te_hist_range_1y"
				}
				blockoverride "range_enabled" {
					enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '1' ))]"
				}
				blockoverride "range_onclick" {
					onclick = "[GetVariableSystem.Set( 'te_hist_range', '1' )]"
				}
			}
			te_history_range_button = {
				blockoverride "range_text" {
					text = "te_hist_range_5y"
				}
				blockoverride "range_enabled" {
					enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '5' ))]"
				}
				blockoverride "range_onclick" {
					onclick = "[GetVariableSystem.Set( 'te_hist_range', '5' )]"
				}
			}
			te_history_range_button = {
				blockoverride "range_text" {
					text = "te_hist_range_10y"
				}
				blockoverride "range_enabled" {
					enabled = "[Or( GetVariableSystem.HasValue( 'te_hist_range', '1' ), GetVariableSystem.HasValue( 'te_hist_range', '5' ) )]"
				}
				blockoverride "range_onclick" {
					onclick = "[GetVariableSystem.Set( 'te_hist_range', '10' )]"
				}
			}
		}

		textbox = {
			visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('te_hist') ) )]"
			parentanchor = hcenter
			autoresize = yes
			multiline = yes
			max_width = 480
			align = hcenter|nobaseline
			text = "te_hist_since"
		}

		### Share of global influence. The axis tops out at 50 rather than 100
		### because the share is a fraction of the world's total pull and no
		### country has approached half of it; a 0-100 axis would flatten the whole
		### series into the bottom fifth of the chart.
		te_history_chart = {
			blockoverride "chart_title" {
				text = "te_hist_chart_ch_share_title"
			}
			blockoverride "chart_legend" {
				text = "te_hist_chart_ch_share_legend"
			}
			blockoverride "bar_tooltip" {
				tooltip = "te_hist_tt_ch_share"
			}
			blockoverride "bar_body" {
				te_history_bar_unsigned = {
					visible = "[ScriptContainer.HasVariable( 'te_hist_v_ch_share' )]"
					blockoverride "values" {
						min = 0
						max = 50
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)1', ScriptContainer.GetVariableValue( 'te_hist_v_ch_share' ) ) )]"
					}
					blockoverride "cover_values" {
						min = 0
						max = 50
						value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_ch_share' ), '(CFixedPoint)2' ) ) )]"
					}
					blockoverride "color" {
						color = { 0.78 0.60 0.30 1.0 }
					}
				}
			}
		}
	}
}
