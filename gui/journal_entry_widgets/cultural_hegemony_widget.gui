			}
			blockoverride "row_tooltip" {
				tooltip = "[GetScriptedGui('ch_board_detail_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
			}
			blockoverride "row_us_marker" {
				visible = "[GetScriptedGui('ch_board_is_us_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
			}
		}

		### Our own standing, for the common case of being outside the top ten.
		textbox = {
			datacontext = "[GetScriptedGui('ch_show_sgui')]"
			visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)11' ) ).End )]"
			text = "je_ch_widget_board_us"
			autoresize = yes
			max_width = 474
			align = left|nobaseline
			using = fontsize_medium
			margin_top = 4
		}
	}

	### ---- Political models of the world ------------------------------------
	### Every country's political model (ch_set_political_model) weighted by its
	### cultural pull: each model's share of world culture, recounted with the
	### leaderboard. The pie is fifteen stacked progresspies, one per model, each
	### filled to the model's CUMULATIVE share (ch_model_pie_cum_<n>_display) and
	### declared largest first, so the later, smaller layers draw on top and
	### slice n shows between cum_<n-1> and cum_<n>. Each layer's colour is baked
	### into its texture's fill frame, as vanilla colours its own progresspies
	### (sidebar_progress / sidebar_progress_red); frame 1 is transparent so the
	### layers below show through. Layer order, legend order, the script values'
	### order and the texture generator's MODELS tuple are the same list:
	### scripts/image_pipeline/gen_ch_model_pie_textures.py.
	ch_section_header = {
		blockoverride "left_text" {
			text = "je_ch_widget_models_header"
			using = elide_fontsize_min
		}
		blockoverride "onclick" {
			onclick = "[GetVariableSystem.Toggle('ch_models_open')]"
		}
		blockoverride "onclick_showmore" {
			visible = "[Not(GetVariableSystem.Exists('ch_models_open'))]"
		}
		blockoverride "onclick_showless" {
			visible = "[GetVariableSystem.Exists('ch_models_open')]"
		}
	}

	ch_panel = {
		visible = "[GetVariableSystem.Exists('ch_models_open')]"
		datacontext = "[GetScriptedGui('ch_show_sgui')]"

		### Before the first rebuild there is nothing to draw (op 12).
		textbox = {
			visible = "[Not( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)12' ) ).End ) )]"
			text = "je_ch_widget_models_pending"
			autoresize = yes
			multiline = yes
			minimumsize = { 474 -1 }
			maximumsize = { 474 -1 }
			align = left|nobaseline
			using = fontsize_medium
			default_format = "#lore"
		}

		textbox = {
			visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
			text = "je_ch_widget_models_legend"
			autoresize = yes
			multiline = yes
			minimumsize = { 474 -1 }
			maximumsize = { 474 -1 }
			align = left|nobaseline
			using = fontsize_small
			default_format = "#lore"
			margin_bottom = 4
		}

		flowcontainer = {
			visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
			direction = horizontal
			ignoreinvisible = yes
			spacing = 12

			widget = {
				size = { 160 160 }
				parentanchor = top
				tooltip = "je_ch_widget_models_pie_tt"

				icon = {
					size = { 100% 100% }
					texture = "gfx/interface/backgrounds/round_frame_dec.dds"
				}

				widget = {
					size = { 75% 75% }
					parentanchor = center
					position = { 0 -1 }

					progresspie = {
						size = { 100% 100% }
						min = 0
						max = 100
						value = "[FixedPointToFloat(GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).ScriptValue('ch_model_pie_cum_15_display'))]"
