					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
				}
				blockoverride "row_text" {
					text = "[ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
				}
				blockoverride "row_tooltip" {
					tooltip = "[Concatenate( GetScriptedGui('ch_board_detail_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_ch_board_row_hint_tt' ) ) )]"
				}
				blockoverride "row_us_marker" {
					visible = "[GetScriptedGui('ch_board_is_us_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
				}
			}
			ch_board_row = {
				datacontext = "[GetScriptedGui('ch_board_row_sgui')]"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
				}
				blockoverride "row_text" {
					text = "[ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
				}
				blockoverride "row_tooltip" {
					tooltip = "[Concatenate( GetScriptedGui('ch_board_detail_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_ch_board_row_hint_tt' ) ) )]"
				}
				blockoverride "row_us_marker" {
					visible = "[GetScriptedGui('ch_board_is_us_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
				}
			}
			ch_board_row = {
				datacontext = "[GetScriptedGui('ch_board_row_sgui')]"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
				}
				blockoverride "row_text" {
					text = "[ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
				}
				blockoverride "row_tooltip" {
					tooltip = "[Concatenate( GetScriptedGui('ch_board_detail_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_ch_board_row_hint_tt' ) ) )]"
				}
				blockoverride "row_us_marker" {
					visible = "[GetScriptedGui('ch_board_is_us_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
				}
			}

			### Our own rank, only when we are outside the top ten: inside it, the
			### arrow marks our row.
			textbox = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_rank_self_display'), '(CFixedPoint)11' )]"
				tooltip = "je_ch_widget_rank_tt"
				text = "je_ch_widget_board_us"
				autoresize = yes
				max_width = 474
				align = left|nobaseline
				using = fontsize_medium
				margin_top = 4
			}
		}
	}

	### Political models of the world. Every country's political model
	### (ch_set_political_model) weighted by its cultural pull: each model's share
	### of world culture, recounted with the leaderboard. The pie is fifteen
	### stacked progresspies, one per model, each filled to the model's
	### CUMULATIVE share as a 0-1 fraction (max = 1, as every vanilla
	### progresspie; ch_model_pie_cum_<n>_display) and declared largest first, so
	### the later, smaller layers draw on top and slice n shows between
	### cum_<n-1> and cum_<n>. Each layer's colour is baked into its texture's
	### fill frame, as vanilla colours its own progresspies (sidebar_progress /
	### sidebar_progress_red); frame 1 is transparent so the layers below show
	### through. Layer order, legend order, the script values' order and the
	### texture generator's MODELS tuple are the same list:
	### scripts/image_pipeline/gen_ch_model_pie_textures.py.
	type te_ch_sec_models = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		ch_section_header = {
			blockoverride "left_text" {
				text = "je_ch_widget_models_header"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('ch_models_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('ch_models_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('ch_models_closed'))]"
			}
		}

		ch_panel = {
			visible = "[Not(GetVariableSystem.Exists('ch_models_closed'))]"
			datacontext = "[GetScriptedGui('ch_show_sgui')]"

			### Before the first rebuild there is nothing to draw (op 12).
			textbox = {
				visible = "[Not( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)12' ) ).End ) )]"
				text = "je_ch_widget_models_pending"
				autoresize = yes
				multiline = yes
				minimumsize = { 474 -1 }
				maximumsize = { 474 -1 }
				align = left|nobaseline
				using = fontsize_medium
				default_format = "#lore"
			}

			flowcontainer = {
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)12' ) ).End )]"
				direction = horizontal
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 12

				widget = {
					size = { 160 160 }
					parentanchor = top
					tooltip = "je_ch_widget_models_pie_tt"

					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/backgrounds/round_frame_dec.dds"
					}

					widget = {
						size = { 75% 75% }
						parentanchor = center
						position = { 0 -1 }

						progresspie = {
							size = { 100% 100% }
							min = 0
							max = 1
							value = "[FixedPointToFloat(GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).ScriptValue('ch_model_pie_cum_15_display'))]"
							texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_pie_fascist.dds"
							framesize = { 128 128 }
							frame = 2
						}
						progresspie = {
							size = { 100% 100% }
							min = 0
							max = 1
							value = "[FixedPointToFloat(GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).ScriptValue('ch_model_pie_cum_14_display'))]"
							texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_pie_developmentalist_junta.dds"
