							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_model_code'), '(CFixedPoint)14' )]"
							blockoverride "cell_size" {
								size = { 118 58 }
							}
							blockoverride "label_width" {
								max_width = 116
							}
							blockoverride "icon_texture" {
								texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_pie_republican.dds"
								framesize = { 128 128 }
								frame = 2
							}
							blockoverride "label" {
								text = "je_ch_ov_model_republican"
							}
						}
						te_ch_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_model_code'), '(CFixedPoint)15' )]"
							blockoverride "cell_size" {
								size = { 118 58 }
							}
							blockoverride "label_width" {
								max_width = 116
							}
							blockoverride "icon_texture" {
								texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_pie_developmentalist_junta.dds"
								framesize = { 128 128 }
								frame = 2
							}
							blockoverride "label" {
								text = "je_ch_ov_model_developmentalist_junta"
							}
						}
					}

					### Foreign Cultural Benchmark, only while we carry it.
					te_ch_ov_icon_label = {
						visible = "[GetScriptedGui('ch_benchmark_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "je_ch_ov_benchmark_tt"
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/ch_icons/benchmark.dds"
						}
						blockoverride "label" {
							text = "je_ch_ov_benchmark_label"
						}
					}
				}

				### Row 2: our share of global cultural influence with last month's
				### trend, and the three leading cultural powers.
				flowcontainer = {
					direction = horizontal
					parentanchor = hcenter
					ignoreinvisible = yes
					spacing = 12

					te_ch_ov_pie = {
						parentanchor = vcenter
						tooltip = "je_ch_ov_share_tt"
						blockoverride "pie_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_share_frac') )]"
						}
						blockoverride "label" {
							text = "je_ch_ov_share_label"
						}
						blockoverride "trend" {
							widget = {
								size = { 20 20 }
								parentanchor = vcenter

								icon = {
									size = { 20 20 }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_share_trend'), '(CFixedPoint)1' )]"
									texture = "gfx/interface/icons/generic_icons/trend_up.dds"
								}
								icon = {
									size = { 20 20 }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_share_trend'), '(CFixedPoint)-1' )]"
									texture = "gfx/interface/icons/generic_icons/trend_down.dds"
								}
								icon = {
									size = { 20 20 }
									visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_share_trend'), '(CFixedPoint)0' )]"
									texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
								}
							}
						}
					}

					### The three leading cultural powers at the last recount, leader
					### first, as vanilla flags (the country's name on hover, the
					### country on click), the way the UN overview draws its Security
					### Council. Each flag's country comes from a capital the viewer
					### holds (ch_leaders_display_write), and its slot's gate means a
					### seat that is not set is never read. The slots keep their width
					### whether filled or not, so the row does not change width.
					flowcontainer = {
						direction = vertical
						parentanchor = vcenter
						ignoreinvisible = yes
						spacing = 4
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_leader_count'), '(CFixedPoint)1' )]"

						textbox = {
							parentanchor = hcenter
							autoresize = yes
							align = hcenter|nobaseline
							using = fontsize_medium
							default_format = "#tooltippable"
							text = "je_ch_ov_leaders_label"
							tooltip = "je_ch_ov_leaders_tt"
						}
						flowcontainer = {
							direction = horizontal
							parentanchor = hcenter
							spacing = 6

							widget = {
								size = { 70 48 }

								widget = {
									size = { 70 48 }
									visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_leader_count'), '(CFixedPoint)1' )]"

									flag = {
										parentanchor = center
										datacontext = "[JournalEntry.GetCountry.MakeScope.Var('ch_leader_seat_1').GetState.GetCountry]"
									}
								}
							}
							widget = {
								size = { 70 48 }

								widget = {
									size = { 70 48 }
									visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_leader_count'), '(CFixedPoint)2' )]"

									flag = {
										parentanchor = center
										datacontext = "[JournalEntry.GetCountry.MakeScope.Var('ch_leader_seat_2').GetState.GetCountry]"
									}
								}
							}
							widget = {
								size = { 70 48 }

								widget = {
									size = { 70 48 }
									visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_leader_count'), '(CFixedPoint)3' )]"

									flag = {
										parentanchor = center
										datacontext = "[JournalEntry.GetCountry.MakeScope.Var('ch_leader_seat_3').GetState.GetCountry]"
									}
								}
							}
						}
					}
				}
			}
		}
	}

	### ==========================================================================
	### STATUS SECTIONS — open by default
	### ==========================================================================

	### Cultural Programmes: the funding stepper and one row per programme. The
	### one reason that greys most of the controls at once (no Ministry of
	### Culture) is said once, above the rows; each button's tooltip still lists
	### every condition with ticks and crosses.
	type te_ch_sec_programmes = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		ch_section_header = {
			blockoverride "left_text" {
				text = "je_ch_widget_programmes_header"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('ch_programmes_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('ch_programmes_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('ch_programmes_closed'))]"
			}
		}

		ch_panel = {
			visible = "[Not(GetVariableSystem.Exists('ch_programmes_closed'))]"

			textbox = {
				visible = "[GetScriptedGui('ch_ministry_missing_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				parentanchor = hcenter
				autoresize = yes
				multiline = yes
				maximumsize = { 474 -1 }
				align = hcenter|nobaseline
				using = fontsize_medium
				text = "je_ch_prog_needs_ministry"
				margin_bottom = 2
			}

			### Funding stepper — ops 0 (down) and 1 (up), in the programme rows'
			### three columns: label, level, controls.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 6
				margin = { 6 3 }
				parentanchor = hcenter
				datacontext = "[GetScriptedGui('ch_policy_sgui')]"

				background = {
					using = entry_bg_fancy_dark
					alpha = 0.35
				}

				widget = {
					size = { 250 26 }
					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 250
						elide = right
						align = nobaseline
						using = fontsize_large
						default_format = "#tooltippable"
						text = "je_ch_widget_funding_label"
						tooltip = "ch_policy_funding_step_tt"
					}
				}

				widget = {
					size = { 80 26 }
					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 80
						elide = right
						align = nobaseline
						using = fontsize_medium
						text = "je_ch_widget_funding_value"
					}
				}

				widget = {
					size = { 112 28 }
					parentanchor = vcenter

					flowcontainer = {
						parentanchor = center
						direction = horizontal
						spacing = 12

						button_icon_minus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
						}
						button_icon_plus_action = {
							size = { 26 26 }
							parentanchor = vcenter
							enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
							tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
						}
					}
				}
			}

			### International Cultural Outreach — ops 2 / 3
			ch_programme_row = {
				blockoverride "programme_label" {
					text = "je_ch_widget_prog_outreach"
					tooltip = "je_ch_prog_outreach_tt"
					default_format = "#tooltippable"
				}
				blockoverride "programme_status" { text = "je_ch_widget_prog_outreach_status" }
				blockoverride "programme_enable" {
					visible = "[Not(GetScriptedGui('ch_active_world_exposition_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
					text = "ch_policy_outreach_on"
				}
				blockoverride "programme_disable" {
					visible = "[GetScriptedGui('ch_active_world_exposition_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ) ) )]"
					text = "ch_policy_outreach_off"
				}
			}

			### Cultural Institutes — ops 4 / 5
			ch_programme_row = {
				blockoverride "programme_label" {
					text = "je_ch_widget_prog_institutes"
					tooltip = "je_ch_prog_institutes_tt"
					default_format = "#tooltippable"
				}
				blockoverride "programme_status" { text = "je_ch_widget_prog_institutes_status" }
				blockoverride "programme_enable" {
					visible = "[Not(GetScriptedGui('ch_active_cultural_institutes_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ) ) )]"
					text = "ch_policy_institutes_on"
				}
				blockoverride "programme_disable" {
					visible = "[GetScriptedGui('ch_active_cultural_institutes_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ) ) )]"
					text = "ch_policy_institutes_off"
				}
			}

			### Global Media Campaign — ops 6 / 7. Mutually exclusive with Cultural
			### Protectionism; the Enable control stays visible and greys out, and
			### ch_possible_global_media_campaign carries the reason.
			ch_programme_row = {
				blockoverride "programme_label" {
					text = "je_ch_widget_prog_media"
					tooltip = "je_ch_prog_media_tt"
					default_format = "#tooltippable"
				}
				blockoverride "programme_status" { text = "je_ch_widget_prog_media_status" }
				blockoverride "programme_enable" {
					visible = "[Not(GetScriptedGui('ch_active_global_media_campaign_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End ) ) )]"
					text = "ch_policy_media_on"
				}
				blockoverride "programme_disable" {
					visible = "[GetScriptedGui('ch_active_global_media_campaign_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End ) ) )]"
					text = "ch_policy_media_off"
				}
			}

			### Cultural Protectionism — ops 8 / 9
			ch_programme_row = {
				blockoverride "programme_label" {
					text = "je_ch_widget_prog_protectionism"
					tooltip = "je_ch_prog_protectionism_tt"
					default_format = "#tooltippable"
				}
				blockoverride "programme_status" { text = "je_ch_widget_prog_protectionism_status" }
				blockoverride "programme_enable" {
					visible = "[Not(GetScriptedGui('ch_active_cultural_protectionism_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ))]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End ) ) )]"
					text = "ch_policy_protectionism_on"
				}
				blockoverride "programme_disable" {
					visible = "[GetScriptedGui('ch_active_cultural_protectionism_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
					onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
					tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End ) ) )]"
					text = "ch_policy_protectionism_off"
				}
			}
		}
	}

	### Where our pull comes from: one row per component that adds anything, as
	### the UN draws its authority pillars (owner, 2026-09-30): the name, a bar
	### with zero at the centre line, the value. Then the totals under a rule.
	type te_ch_sec_breakdown = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		ch_section_header = {
			blockoverride "left_text" {
				text = "je_ch_widget_breakdown_header"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('ch_breakdown_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('ch_breakdown_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('ch_breakdown_closed'))]"
			}
		}

		ch_panel = {
			visible = "[Not(GetVariableSystem.Exists('ch_breakdown_closed'))]"

			### Art, in two mutually exclusive forms: below the diminishing-returns
			### threshold (op 0) and above it (op 1). Which one shows is
			### ch_show_sgui's decision, so 33 stays in cultural_pull_art_dr_threshold.
			### The two differ only in their hover.
			### Art Production, below the threshold — op 0
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_art_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_art_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "pos_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_art_pos') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_art_value" }
			}
			### Art Production, diminished — op 1
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_art_dr_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_art_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "pos_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_art_pos') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_art_value" }
			}
			### The art multiplier (country_cultural_hegemony_art_mult), under the Art
			### row it scales, while the Art row shows and the multiplier is not zero.
			ch_bar_subrow = {
				tooltip = "je_ch_widget_bd_art_mult_tt"
				blockoverride "row_visible" {
					visible = "[And( Or( ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ), NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_art_mult_pct_display'), '(CFixedPoint)0' ) )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_art_mult_label" }
				blockoverride "row_value" { text = "je_ch_widget_bd_art_mult_value" }
			}
			### Prestige — op 2
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_prestige_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_prestige_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "pos_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_prestige_pos') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_prestige_value" }
			}
			### Standard of living — op 3 (the one component that can be either sign)
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_sol_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_sol_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "neg_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_sol_neg') )]"
						}
						blockoverride "pos_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_sol_pos') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_sol_value" }
			}
			### Tech leadership — op 4
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_tech_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_tech_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "pos_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_tech_pos') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_tech_value" }
			}
			### Monuments — op 5
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_monuments_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_monuments_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "pos_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_monuments_pos') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_monuments_value" }
			}
			### Megaprojects — op 6
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_megaprojects_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)6' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_megaprojects_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "pos_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_megaprojects_pos') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_megaprojects_value" }
			}
			### Flat pull modifiers — op 7
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_modifiers_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)7' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_modifiers_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "pos_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_modifiers_pos') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_modifiers_value" }
			}
			### Infamy — op 8
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_infamy_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)8' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_infamy_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "neg_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_infamy_neg') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_infamy_value" }
			}
			### Instability — op 9
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_instability_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)9' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_instability_label" }
				blockoverride "row_bar" {
					ch_pull_bar = {
						blockoverride "neg_value" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_bar_instability_neg') )]"
						}
					}
				}
				blockoverride "row_value" { text = "je_ch_widget_bd_instability_value" }
			}

			### Totals, with no bar. The raw score always shows; the multiplier is op 10.
			divider_clean = {
				blockoverride "size" {
					size = { 474 2 }
				}
			}
			### Raw score
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_raw_tt"
				blockoverride "row_label" { text = "je_ch_widget_bd_raw_label" }
				blockoverride "row_value" { text = "je_ch_widget_bd_raw_value" }
			}
			### Pull multiplier — op 10
			ch_bar_row = {
				tooltip = "je_ch_widget_bd_mult_tt"
				blockoverride "row_visible" {
					visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)10' ) ).End )]"
				}
				blockoverride "row_label" { text = "je_ch_widget_bd_mult_label" }
				blockoverride "row_value" { text = "je_ch_widget_bd_mult_value" }
			}
		}
	}

	### The top ten cultural powers. Ten rows, each one ExecuteTooltip; the
	### bracketed figure's meaning is on each row's hover and in How Cultural
	### Hegemony Works.
	type te_ch_sec_board = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		ch_section_header = {
			blockoverride "left_text" {
