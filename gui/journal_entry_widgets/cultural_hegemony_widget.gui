	### ==========================================================================
	### REFERENCE SECTIONS
	### ==========================================================================

	### Our share, month by month. Open by default, like the UN's authority
	### history; the range selector and the retention note are shared with the
	### banking charts (the same te_hist_range GUI variable drives both).
	type te_ch_sec_history = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		ch_section_header = {
			blockoverride "left_text" {
				text = "je_ch_widget_history_header"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('ch_hist_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('ch_hist_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('ch_hist_closed'))]"
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('ch_hist_closed'))]"
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 2

			### The range selector and the retention note are shared with the banking
			### charts: the same te_hist_range GUI variable drives both, so a player
			### who picks 5 years in one place sees 5 years in the other.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 4
				margin = { 4 4 }

				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_1y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '1' ))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '1' )]"
					}
				}
				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_5y"
					}
					blockoverride "range_enabled" {
						enabled = "[Not(GetVariableSystem.HasValue( 'te_hist_range', '5' ))]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '5' )]"
					}
				}
				te_history_range_button = {
					blockoverride "range_text" {
						text = "te_hist_range_20y"
					}
					blockoverride "range_enabled" {
						enabled = "[Or( GetVariableSystem.HasValue( 'te_hist_range', '1' ), GetVariableSystem.HasValue( 'te_hist_range', '5' ) )]"
					}
					blockoverride "range_onclick" {
						onclick = "[GetVariableSystem.Set( 'te_hist_range', '20' )]"
					}
				}
			}

			textbox = {
				visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('te_hist') ) )]"
				parentanchor = hcenter
				autoresize = yes
				multiline = yes
				max_width = 480
				align = hcenter|nobaseline
				text = "te_hist_since"
			}

			### Share of global influence. The axis tops out at 50 rather than 100
			### because the share is a fraction of the world's total pull and no
			### country has approached half of it; a 0-100 axis would flatten the whole
			### series into the bottom fifth of the chart.
			te_history_chart = {
				blockoverride "chart_title" {
					text = "te_hist_chart_ch_share_title"
				}
				blockoverride "chart_legend" {
					text = "te_hist_chart_ch_share_legend"
				}
				blockoverride "bar_tooltip" {
					tooltip = "te_hist_tt_ch_share"
				}
				# The shared store also holds banking events. Show only cultural
				# programme changes here, including those already saved before this fix.
				blockoverride "marker_pips" {
					icon = {
						visible = "[Or( Or( Or( ScriptContainer.HasVariable('te_hist_mk_ch_on_outreach'), ScriptContainer.HasVariable('te_hist_mk_ch_off_outreach') ), Or( ScriptContainer.HasVariable('te_hist_mk_ch_on_institutes'), ScriptContainer.HasVariable('te_hist_mk_ch_off_institutes') ) ), Or( Or( ScriptContainer.HasVariable('te_hist_mk_ch_on_media'), ScriptContainer.HasVariable('te_hist_mk_ch_off_media') ), Or( ScriptContainer.HasVariable('te_hist_mk_ch_on_protectionism'), ScriptContainer.HasVariable('te_hist_mk_ch_off_protectionism') ) ) )]"
						parentanchor = hcenter
						alwaystransparent = yes
						size = { 9 9 }
						texture = "gfx/interface/icons/generic_icons/information.dds"
					}
				}
				blockoverride "bar_body" {
					te_history_bar_unsigned = {
						visible = "[ScriptContainer.HasVariable( 'te_hist_v_ch_share' )]"
						blockoverride "values" {
							min = 0
							max = 50
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)1', ScriptContainer.GetVariableValue( 'te_hist_v_ch_share' ) ) )]"
						}
						blockoverride "cover_values" {
							min = 0
							max = 50
							value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_ch_share' ), '(CFixedPoint)2' ) ) )]"
						}
						blockoverride "color" {
							# The share's amber, as the overview's pie (#d89a2b).
							color = { 0.85 0.60 0.17 1.0 }
						}
					}
				}
			}
		}
	}

	### "How Cultural Hegemony Works": every explanation, gathered out of the
	### live sections into one section, collapsed by default, one heading per
	### topic. The live sections say what is happening; this says how it works.
	type te_ch_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		ch_section_header = {
			blockoverride "left_text" {
				text = "je_ch_how_header"
				using = elide_fontsize_min
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('ch_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('ch_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('ch_how_open')]"
			}
		}

		ch_panel = {
			visible = "[GetVariableSystem.Exists('ch_how_open')]"

			ch_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_ch_how_sub_share"
				}
			}
			ch_note = {
				text = "je_ch_how_share"
			}
			ch_subheader = {
				blockoverride "subheader_text" {
					text = "je_ch_how_sub_programmes"
				}
			}
			ch_note = {
				text = "je_ch_how_programmes"
			}
			ch_subheader = {
				blockoverride "subheader_text" {
					text = "je_ch_how_sub_pull"
				}
			}
			ch_note = {
				text = "je_ch_how_pull"
			}
			ch_subheader = {
				blockoverride "subheader_text" {
					text = "je_ch_how_sub_board"
				}
			}
			ch_note = {
				text = "je_ch_how_board"
			}
			ch_subheader = {
				blockoverride "subheader_text" {
					text = "je_ch_how_sub_models"
				}
			}
			ch_note = {
				text = "je_ch_widget_models_legend"
			}
			ch_note = {
				text = "je_ch_how_models"
			}
			ch_subheader = {
				blockoverride "subheader_text" {
					text = "je_ch_how_sub_benchmark"
				}
			}
			ch_note = {
				text = "je_ch_how_benchmark"
			}
		}
	}

	### ==========================================================================
	### COMPOSERS — the one order of the sections, for both hosts
	### ==========================================================================

	### Everything a returning player checks, open by default.
	type te_ch_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_ch_sec_board = {}
		te_ch_sec_programmes = {}
		te_ch_sec_breakdown = {}
		te_ch_sec_models = {}
	}

	### The chart, then how it all works.
	type te_ch_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_ch_sec_history = {}
		te_ch_sec_how = {}
	}
}


### ==========================================================================
### JOURNAL ENTRY ROOTS
### ==========================================================================
### The names je_cultural_hegemony.txt attaches: the overview above the status
### text (custom_widget_container_1), the status sections below it (_2) and the
### reference sections below the scripted-button grid (_3), which draws nothing
### for a human. Bare wrappers that repeat the composers' IsActive gate, so an
### inactive entry's containers collapse. The Society panel's Hegemony tab
### (gui/culture_panel.gui) instances the same three composers under a
### GetPlayerJournalEntry datacontext.
flowcontainer = {
	name = "widget_je_ch_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ch_overview_panel = {}
}

flowcontainer = {
	name = "widget_je_ch_status"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ch_status_sections = {}
}

flowcontainer = {
	name = "widget_je_ch_reference"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_ch_reference_sections = {}
}
