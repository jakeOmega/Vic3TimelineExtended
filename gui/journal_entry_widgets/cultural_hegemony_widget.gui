### Cultural Hegemony journal-entry widgets.
###
### A type library, one type per section, composed in one order for both hosts:
### the journal entry (je_cultural_hegemony.txt attaches the named roots at the
### foot of this file) and the Society panel's Hegemony tab (gui/culture_panel.gui
### instances the same three composers). Layout, as gui_style_guide.md sets it:
###
###   te_ch_overview_panel        always shown: tier, world rank, the exported
###                               model and the benchmark alert as icons with a
###                               word beneath; our cultural share as a framed pie
###                               with last month's trend, and the three leading
###                               powers as vanilla flags
###   te_ch_status_sections       open by default (flags *_closed):
###     te_ch_sec_board           the top ten cultural powers (first: owner,
###                               2026-09-29)
###     te_ch_sec_programmes      funding stepper and the four programmes
###     te_ch_sec_breakdown       where our pull comes from, a bar per component
###     te_ch_sec_models          political models of the world, pie and legend
###   te_ch_reference_sections
###     te_ch_sec_history         the share history chart, open (ch_hist_closed)
###     te_ch_sec_how             "How Cultural Hegemony Works", collapsed
###                               (ch_how_open): every explanation, one heading
###                               per topic
###
### Collapse flags say their default: *_closed sections are open until closed,
### *_open ones collapsed until opened (test_cultural_hegemony_layout.py).
###
### NOTHING HERE HOLDS LOGIC.
###   - is a programme running -> ch_active_<programme>_sgui, which takes NO saved
###                               scope. The Disable control is drawn on its
###                               IsShown and the Enable control on Not(IsShown),
###                               so whether the player can act never depends on a
###                               saved scope reaching is_shown. The funding
###                               steppers are always drawn and grey out instead.
###   - every other yes/no     -> ch_show_sgui / ch_board_row_sgui (op per
###                               question), which FAIL OPEN, ch_board_is_us_sgui
###                               (fail closed: no marker beats ten), and the
###                               scope-free ch_ministry_missing_sgui /
###                               ch_benchmark_sgui.
###   - every action           -> ch_policy_sgui (op per control), which delegates
###                               to ch_possible_<button> / ch_effect_<button>,
###                               the same helpers the journal entry's scripted
###                               buttons use, so the AI and the player run one
###                               implementation.
###   - every number           -> a script value read through
###                               JournalEntry.GetCountry.MakeScope.ScriptValue;
###                               the overview's codes are the ch_disp_* values
###                               (cultural_hegemony_script_values.txt)
###   - every banded word      -> GetCustom('ch_tier_text' / 'ch_tier_blurb' /
###                               'ch_exported_model_text') or a code-gated
###                               variant, driven by ch_tier and
###                               global_var:ch_rank_1_ideology
### No threshold, no classification and no arithmetic lives in this file. The only
### widget-local state is the GUI variable system flag behind each expander.
###
### The overview's art (the tier icons, the benchmark alert, the share pie's
### pair, gfx/interface/icons/ch_icons/ and ch_model_pie/) and what each shows
### are in docs/systems/cultural_hegemony_gui_icons.md.
###
### ---- ch_policy_sgui op table (mirrored in the sgui file and the system doc) --
###   0 / 1   programme funding   decrease / increase
###   2 / 3   International Cultural Outreach   begin / end
###   4 / 5   Cultural Institutes               fund  / defund
###   6 / 7   Global Media Campaign             launch / end
###   8 / 9   Cultural Protectionism            enact / end
###
### ---- ch_show_sgui op table -------------------------------------------------
###   0 art (no diminishing returns)   1 art (diminished)   2 prestige
###   3 standard of living             4 tech leadership     5 monuments
###   6 megaprojects                   7 pull modifiers      8 infamy
###   9 instability                    10 pull multiplier
###   12 exported-model block (the models section's "census taken" gate)
###   (11, the "Rank N of M" line, is retired: the overview and the board's
###   own-rank line test ch_rank_self_display without a saved scope)
###   31-45 one "Political models" legend row each (op = 30 + ch_model code)
###
### ---- ch_board_is_us_sgui ----------------------------------------------------
###   op = board rank 1 to 10; drives that row's "us" marker and nothing else.
###
### ---- ch_board_row_sgui / ch_board_detail_sgui ------------------------------
###   op = board rank, 1 to 10. The row's TEXT comes from an ExecuteTooltip on the
###   row sgui, because the board is a list of COUNTRIES and .gui cannot name one:
###   Var().GetCountry.GetName is recorded as blank in this mod (gotcha #11) and
###   Scope.GetCountry appears in no vanilla .gui (gotcha #15). The sgui enters the
###   ranked country's scope in script and prints [THIS.GetCountry.GetName], which
###   is vanilla's own shape for this case. Each row is its own widget, so the
###   "headers print before nested lines" trap (gotcha #18) cannot apply.

types cultural_hegemony_widget_types
{
	### A panel: the standard journal-entry widget frame.
	type ch_panel = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2
		margin = { 14 8 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	type ch_section_header = section_header_button {
		blockoverride "layout" {
			parentanchor = hcenter
			size = { 520 38 }
		}
		blockoverride "left_text_alignment" {
			align = left|nobaseline
		}
	}

	### A heading inside a section's panel, over one group of its lines, with a
	### faint rule under it (un_chamber_subheader's shape, at this panel's
	### 474 px text column).
	type ch_subheader = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		block "subheader_margin" {
			margin_top = 10
		}

		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 474 -1 }
			align = left|nobaseline
			using = fontsize_large
			default_format = "#title"
			block "subheader_text" {}
		}
		divider_clean = {
			blockoverride "size" {
				size = { 474 2 }
			}
		}
	}

	### Explanatory text under a heading: how a group works, rather than what it
	### says now. Static keys only.
	type ch_note = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 474 -1 }
		maximumsize = { 474 -1 }
		align = left|nobaseline
		using = fontsize_medium
		default_format = "#lore"
	}

	### A component's bar, the way the UN draws its authority pillars: zero is the
	### centre line, a gain fills the right half and a penalty the left. Each half
	### is scaled by its side of the component's range (the ch_bar_<c>_min / _max
	### script values), so the instance supplies 0..1 in "pos_value" and -1..0 in
	### "neg_value" (ch_disp_bar_<c>_pos / _neg); both default to 0. Drawn from the
	### bare progressbars of te_state_stat_bar (a dark track, white.dds tinted) in
	### the history charts' green and red. The left half uses vanilla's "REVERSE
	### HACK" (te_history_bar_signed): the textures swapped and a -1..0 range, so
	### its colour is drawn from the centre line outwards. Every piece is
	### alwaystransparent, so the row's tooltip shows over the bar.
	type ch_pull_bar = widget {
		size = { 164 14 }
		parentanchor = vcenter
		alwaystransparent = yes

		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/backgrounds/white.dds"
			color = { 0.0 0.0 0.0 0.35 }
			alwaystransparent = yes
		}

		widget = {
			size = { 82 14 }
			parentanchor = left
			alwaystransparent = yes

			progressbar = {
				size = { 100% 100% }
				direction = horizontal
				progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				noprogresstexture = "gfx/interface/backgrounds/white.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				min = -1
				max = 0
				color = { 0.78 0.31 0.28 1.0 }

				block "neg_value" {
					value = 0
				}
			}
		}

		widget = {
			size = { 82 14 }
			parentanchor = right
			alwaystransparent = yes

			progressbar = {
				size = { 100% 100% }
				direction = horizontal
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				min = 0
				max = 1
				color = { 0.36 0.68 0.40 1.0 }

				block "pos_value" {
					value = 0
				}
			}
		}

		### Zero.
		icon = {
			size = { 2 18 }
			parentanchor = center
			texture = "gfx/interface/backgrounds/white.dds"
			color = { 0.85 0.80 0.65 0.9 }
			alwaystransparent = yes
		}
	}

	### One line of the pull breakdown, as a UN pillar row: the component's name
	### (a concept, so it hovers), its bar, and its contribution, in fixed
	### columns (176 / 164 / 60). The working behind the number and the bar's
	### range are on the row's hover. A total has no bar: its row leaves the
	### column empty, so the values still line up.
	type ch_bar_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 8
		margin = { 4 1 }
		datacontext = "[GetScriptedGui('ch_show_sgui')]"

		block "row_visible" {}

		widget = {
			size = { 176 22 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 176
				elide = right
				align = nobaseline
				using = fontsize_medium
				block "row_label" {}
			}
		}

		widget = {
			size = { 164 22 }
			block "row_bar" {}
		}

		widget = {
			size = { 60 22 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 60
				elide = right
				align = nobaseline
				using = fontsize_medium
				block "row_value" {}
			}
		}
	}

	### A line under a component that qualifies it, set in under its name and
	### spanning the name and bar columns, its value in the value column. The
	### art multiplier under Art Production.
	type ch_bar_subrow = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 8
		margin = { 4 1 }
		datacontext = "[GetScriptedGui('ch_show_sgui')]"

		block "row_visible" {}

		widget = {
			size = { 348 20 }
			textbox = {
				parentanchor = left|vcenter
				position = { 16 0 }
				autoresize = yes
				max_width = 332
				elide = right
				align = nobaseline
				using = fontsize_medium
				default_format = "#lore"
				block "row_label" {}
			}
		}

		widget = {
			size = { 60 20 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 60
				elide = right
				align = nobaseline
				using = fontsize_medium
				block "row_value" {}
			}
		}
	}

	### One action control. Everything that differs between one control and the
	### next (the label and the four properties that address ch_policy_sgui)
	### arrives through a single block, which is the banking dashboard's shape
	### (`banking_dash_action_button`). The data context is ch_policy_sgui, so
	### visibility, the disabled state, the tooltip and the click all come from
	### script. The tooltip is IsValidTooltip (why it is greyed, as ticks and
	### crosses) concatenated with ExecuteTooltip (what pressing it would do,
	### rendered without running).
	type ch_action_button = button {
		using = default_button_action
		size = { 112 28 }
		parentanchor = vcenter

		block "action" {}
	}

	### One programme: name, running/idle status, and the enable + disable controls.
	### Exactly one of the two buttons is ever shown, because ch_policy_sgui's
	### is_shown mirrors the matching scripted_button pair's `visible`. Three
	### fixed columns (250 / 80 / 112), shared with the funding row above the
	### programmes, so the four rows and the stepper line up. The name column
	### takes the longest name in the large font ("Cultural Protectionism"), the
	### status column "Running" / "Idle" (test_cultural_hegemony_layout.py
	### holds every label to its cell).
	type ch_programme_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6
		margin = { 6 3 }
		parentanchor = hcenter
		datacontext = "[GetScriptedGui('ch_policy_sgui')]"

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.35
		}

		widget = {
			size = { 250 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 250
				elide = right
				align = nobaseline
				using = fontsize_large
				block "programme_label" {}
			}
		}

		widget = {
			size = { 80 26 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 80
				elide = right
				align = nobaseline
				using = fontsize_medium
				block "programme_status" {}
			}
		}

		ch_action_button = { block "programme_enable" {} }
		ch_action_button = { block "programme_disable" {} }
	}

	### One leaderboard row: the line built in script, the rank's component
	### snapshot on hover, and a marker when the row is us.
	type ch_board_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 4
		margin = { 6 1 }

		block "row_visible" {}

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.3
		}

		### The "this is us" marker: a text pip rather than a second background,
		### because no vanilla background template reads as a highlight over
		### entry_bg_fancy_dark. Its column is always reserved, so every row's text
		### starts at the same x. Whether it shows is ch_board_is_us_sgui's
		### decision; the .gui never compares countries itself.
		widget = {
			size = { 16 20 }
			parentanchor = vcenter

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				using = fontsize_medium
				text = "je_ch_widget_board_us_marker"
				block "row_us_marker" {}
			}
		}

		textbox = {
			autoresize = yes
			multiline = yes
			minimumsize = { 456 -1 }
			maximumsize = { 456 -1 }
			align = left|nobaseline
			using = fontsize_medium
			block "row_text" {}
			block "row_tooltip" {}
		}
	}

	### One "Political models" legend row: the model's pie texture as its swatch
	### (frame 2 is the coloured disc), its name and its share of world culture.
	### Whether it shows is ch_show_sgui's decision (ops 31-45). The name is the
	### model's short name, its full name on hover: "Liberal / Progressive
	### Democratic" and five others do not fit a line beside the pie.
	type ch_model_legend_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 6
		datacontext = "[GetScriptedGui('ch_show_sgui')]"

		block "legend_visible" {}

		icon = {
			size = { 14 14 }
			parentanchor = vcenter
			framesize = { 128 128 }
			frame = 2
			block "legend_swatch" {}
		}

		widget = {
			size = { 216 20 }
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 216
				elide = right
				align = nobaseline
				using = fontsize_medium
				block "legend_label" {}
			}
		}

		widget = {
			size = { 60 20 }
			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 60
				elide = right
				align = nobaseline
				using = fontsize_medium
				block "legend_value" {}
			}
		}
	}

	### A cell of the overview's first row: an icon, its word small beneath
	### (te_un_ov_icon_label's shape). Fixed width, so the row cannot push the
	### panel wider.
	type te_ch_ov_icon_label = widget {
		block "cell_size" {
			size = { 110 58 }
		}

		icon = {
			size = { 36 36 }
			parentanchor = top|hcenter
			block "icon_texture" {}
		}
		textbox = {
			parentanchor = bottom|hcenter
			autoresize = yes
			block "label_width" {
				max_width = 108
			}
			elide = right
			align = hcenter|nobaseline
			using = fontsize_small
			default_format = "#tooltippable"
			block "label" {}
		}
	}

	### A 0..1 share as a pie over a background disc, inside vanilla's decorated
	### round frame, its label and trend arrow beneath (te_un_ov_pie's shape).
	### Its own pair (#586, docs/systems/cultural_hegemony_gui_icons.md): our share
	### in amber over the rest of the world in a muted grey.
	type te_ch_ov_pie = widget {
		size = { 180 108 }

		icon = {
			size = { 86 86 }
			parentanchor = top|hcenter
			texture = "gfx/interface/backgrounds/round_frame_dec.dds"
		}
		widget = {
			size = { 62 62 }
			parentanchor = top|hcenter
			position = { 0 12 }

			progresspie = {
				size = { 100% 100% }
				min = 0
				max = 1
				value = 1
				texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_share_rest.dds"
				framesize = { 128 128 }
				frame = 2
			}
			progresspie = {
				size = { 100% 100% }
				min = 0
				max = 1
				block "pie_value" {}
				texture = "gfx/interface/journal_entry_widgets/ch_model_pie/ch_share_fill.dds"
				framesize = { 128 128 }
				frame = 2
			}
		}
		flowcontainer = {
			parentanchor = bottom|hcenter
			direction = horizontal
			spacing = 4
			ignoreinvisible = yes

			textbox = {
				parentanchor = vcenter
				autoresize = yes
				align = hcenter|nobaseline
				using = fontsize_medium
				default_format = "#tooltippable"
				block "label" {}
			}
			block "trend" {}
		}
	}

	### ==========================================================================
	### OVERVIEW — always shown, at the top of both hosts
	### ==========================================================================
	### What a returning player checks: our tier, where we rank, whose political
	### model leads the world, whether we are paying the benchmark, our share
	### with last month's trend, and who the leading powers are. Each tooltip carries the text it replaced (the
	### tier's blurb, the rank's reading, the exported model's share and push).
	type te_ch_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

		# je_cultural_hegemony has is_shown_when_inactive = { has_game_rule = ... }, so
		# this panel is built for every country that can see the entry at all,
		# including ones whose entry has never activated. Everything below is
		# guarded in script too, but there is nothing worth drawing in that state.
		# Vanilla uses the same test at gui/journal_entry.gui:670.
		visible = "[JournalEntry.IsActive]"

		ch_panel = {
			### The text column's width, so the overview's panel lines up with the
			### sections' whichever cells are showing.
			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 8
				minimumsize = { 474 -1 }

				### Row 1: tier · world rank · exported model · benchmark
				flowcontainer = {
					direction = horizontal
					parentanchor = hcenter
					ignoreinvisible = yes
					spacing = 6

					### The influence tier (ch_tier, 0-5), its full name and blurb on
					### hover. One icon per tier (docs/systems/cultural_hegemony_gui_icons.md).
					flowcontainer = {
						ignoreinvisible = yes
						tooltip = "je_ch_ov_tier_tt"

						te_ch_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_tier_code'), '(CFixedPoint)0' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/ch_icons/tier_negligible.dds"
							}
							blockoverride "label" {
								text = "je_ch_ov_tier_0"
							}
						}
						te_ch_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_tier_code'), '(CFixedPoint)1' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/ch_icons/tier_minor.dds"
							}
							blockoverride "label" {
								text = "je_ch_ov_tier_1"
							}
						}
						te_ch_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_tier_code'), '(CFixedPoint)2' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/ch_icons/tier_moderate.dds"
							}
							blockoverride "label" {
								text = "je_ch_ov_tier_2"
							}
						}
						te_ch_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_tier_code'), '(CFixedPoint)3' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/ch_icons/tier_significant.dds"
							}
							blockoverride "label" {
								text = "je_ch_ov_tier_3"
							}
						}
						te_ch_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_tier_code'), '(CFixedPoint)4' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/ch_icons/tier_major.dds"
							}
							blockoverride "label" {
								text = "je_ch_ov_tier_4"
							}
						}
						te_ch_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_tier_code'), '(CFixedPoint)5' )]"
							blockoverride "icon_texture" {
								texture = "gfx/interface/icons/ch_icons/tier_hegemon.dds"
							}
							blockoverride "label" {
								text = "je_ch_ov_tier_5"
							}
						}
					}

					### World rank, once the first recount has numbered us.
					widget = {
						size = { 110 58 }
						visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_rank_self_display'), '(CFixedPoint)1' ), GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_ranked_total_display'), '(CFixedPoint)1' ) )]"
						tooltip = "je_ch_widget_rank_tt"

						textbox = {
							parentanchor = top|hcenter
							position = { 0 8 }
							autoresize = yes
							max_width = 108
							elide = right
							align = hcenter|nobaseline
							using = fontsize_large
							text = "je_ch_ov_rank_value"
						}
						textbox = {
							parentanchor = bottom|hcenter
							autoresize = yes
							max_width = 108
							elide = right
							align = hcenter|nobaseline
							using = fontsize_small
							default_format = "#tooltippable"
							text = "je_ch_ov_rank_label"
						}
					}

					### The world's leading cultural power's political model, as its
					### slice colour in the models pie below, once the first census
					### has run. Codes: ch_set_political_model's 1-15. The cell is
					### 118 wide, for the longest short name ("Constitutional") in the
					### small font; the full name is on hover.
					flowcontainer = {
						ignoreinvisible = yes
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_model_code'), '(CFixedPoint)1' )]"
						tooltip = "je_ch_ov_model_tt"

						te_ch_ov_icon_label = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('ch_disp_model_code'), '(CFixedPoint)1' )]"
							blockoverride "cell_size" {
								size = { 118 58 }
							}
							blockoverride "label_width" {
								max_width = 116
							}
							blockoverride "icon_texture" {
