				tooltip = "je_space_race_widget_eb_profit_tt"

				flowcontainer = {
					direction = horizontal
					spacing = 4
					parentanchor = right|vcenter

					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 76
						align = right|nobaseline
						using = te_sr_fontsize_row
						elide = right
