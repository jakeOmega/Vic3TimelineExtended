		using = te_sr_fontsize_row
		elide = right
	}

	### A button of the Colonies view switch, 92 wide: greyed while its view is
	### shown (the radio pattern of the Demographics history's range buttons).
	### Five fit the 480 column: 5 × 92 + 4 × 4 = 476.
	type te_sr_colony_view_button = button {
		using = default_button
		size = { 92 28 }
		parentanchor = vcenter
		block "view_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 86
			elide = right
			using = te_sr_fontsize_row
			block "view_label" {}
		}
	}

	### A colonization tab's button (UI pass design § 11): the colony views'
	### switch's shape (te_sr_colony_view_button); the one for the tab shown is
	### greyed. 96 wide for Fleets and Colonies, 148 (_wide) for Mission Control
	### and Solar System: 2 × 148 + 2 × 96 + 3 × 4 = 500, in the panel's 520.
	type te_sr_tab_button = button {
		using = default_button
		size = { 96 28 }
		parentanchor = vcenter
		block "tab_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 90
			elide = right
			using = te_sr_fontsize_row
			block "tab_label" {}
		}
	}
	type te_sr_tab_button_wide = button {
		using = default_button
		size = { 148 28 }
		parentanchor = vcenter
		block "tab_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 142
			elide = right
			using = te_sr_fontsize_row
			block "tab_label" {}
		}
	}

	### Colonies (solar colonization; audit SPC-5): every colony we hold, in one
	### table, each in its own box (a colony's name opens its page: colony
	### management design § 8), where the colony sections of slices 2-6 (Our Colonies, Settlers,
	### Colony Modules, Colony Autonomy, Colony Defences) each gave one aspect of
	### the same worlds. Under Simple and Full Colonies a switch above the rows
	### picks the view (GetVariableSystem's sr_colony_view: People, the default,
	### Modules, Autonomy, and under Full Colonies Defenses); each view's
	### section-wide figures and controls sit under the switch, its column heads
	### over the rows, and Autonomy's free colonies after them. Under Races Only
	### the rows are the colonies' names, whose hovers give their
	### specializations' effects. Listed for as long as we hold one, whether or
	### not the program runs. Open by default; the flag is sr_panel_colonies_closed.
	type te_sr_sec_colonies = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_colonies_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_colonies_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_colonies_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_colonies_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_colonies_closed'))]"

			te_sr_value_row = {
				blockoverride "row_label" {
					text = "je_space_race_widget_colonies_held_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_colonies_held_figure"
				}
			}
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_colonies_empty"
			}

			### The view switch (Simple and Full Colonies), said once above the rows:
			### a fixed slot as wide as five buttons (5 x 92 + 4 x 4), the buttons from
			### its left edge, so the Bases button joining mid-game (In-Situ Resource
			### Utilization) moves nothing (gui_style_guide rule 8).
			widget = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
				size = { 476 36 }
				parentanchor = hcenter

				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					parentanchor = left|vcenter
					spacing = 4

					te_sr_colony_view_button = {
						tooltip = "je_space_race_widget_cv_people_tt"
						blockoverride "view_button" {
							enabled = "[Not( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), Not( Or( GetVariableSystem.HasValue('sr_colony_view', 'modules'), Or( GetVariableSystem.HasValue('sr_colony_view', 'autonomy'), Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'bases') ) ) ) ) ) ) )]"
							onclick = "[GetVariableSystem.Clear('sr_colony_view')]"
						}
						blockoverride "view_label" {
							text = "je_space_race_widget_cv_people"
						}
					}
					te_sr_colony_view_button = {
						tooltip = "je_space_race_widget_cv_modules_tt"
						blockoverride "view_button" {
							enabled = "[Not( GetVariableSystem.HasValue('sr_colony_view', 'modules') )]"
							onclick = "[GetVariableSystem.Set('sr_colony_view', 'modules')]"
						}
						blockoverride "view_label" {
							text = "je_space_race_widget_cv_modules"
						}
					}
					te_sr_colony_view_button = {
						tooltip = "je_space_race_widget_cv_autonomy_tt"
						blockoverride "view_button" {
							enabled = "[Not( GetVariableSystem.HasValue('sr_colony_view', 'autonomy') )]"
							onclick = "[GetVariableSystem.Set('sr_colony_view', 'autonomy')]"
						}
						blockoverride "view_label" {
							text = "je_space_race_widget_cv_autonomy"
						}
					}
					te_sr_colony_view_button = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' )]"
						tooltip = "je_space_race_widget_cv_defences_tt"
						blockoverride "view_button" {
							enabled = "[Not( GetVariableSystem.HasValue('sr_colony_view', 'defences') )]"
							onclick = "[GetVariableSystem.Set('sr_colony_view', 'defences')]"
						}
						blockoverride "view_label" {
							text = "je_space_race_widget_cv_defences"
						}
					}
					te_sr_colony_view_button = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' )]"
						tooltip = "je_space_race_widget_cv_bases_tt"
						blockoverride "view_button" {
							enabled = "[Not( GetVariableSystem.HasValue('sr_colony_view', 'bases') )]"
							onclick = "[GetVariableSystem.Set('sr_colony_view', 'bases')]"
						}
						blockoverride "view_label" {
							text = "je_space_race_widget_cv_bases"
						}
					}
				}
			}

			### People: the emigration program, the settlers it sends, our people off Earth.
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), Not( Or( GetVariableSystem.HasValue('sr_colony_view', 'modules'), Or( GetVariableSystem.HasValue('sr_colony_view', 'autonomy'), Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'bases') ) ) ) ) ) )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				### Emigration (sr_settlers_sgui): op 0 down, op 1 up, beside the level, as funding is.
				flowcontainer = {
					direction = horizontal
					spacing = 4
					ignoreinvisible = yes
					margin = { 4 1 }

					textbox = {
						text = "je_space_race_widget_emig_label"
						size = { 110 26 }
						align = left|nobaseline
						using = te_sr_fontsize_row
						parentanchor = vcenter
						elide = right
					}

					button_icon_minus_action = {
						size = { 26 26 }
						parentanchor = vcenter
						enabled = "[GetScriptedGui('sr_settlers_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						onclick = "[GetScriptedGui('sr_settlers_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_settlers_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_settlers_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
					}

					widget = {
						size = { 84 26 }
						parentanchor = vcenter

						textbox = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)0' )]"
							text = "je_space_race_widget_emig_level_0"
							size = { 84 26 }
							align = center|nobaseline
							using = te_sr_fontsize_row
							elide = right
						}
						textbox = {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)0' )]"
							raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_amount')|D]#!"
							size = { 84 26 }
							align = center|nobaseline
							using = te_sr_fontsize_row
							elide = right
						}
					}

					button_icon_plus_action = {
						size = { 26 26 }
						parentanchor = vcenter
						enabled = "[GetScriptedGui('sr_settlers_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						onclick = "[GetScriptedGui('sr_settlers_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_settlers_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_settlers_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
					}
				}

				### Last month's settlers, and the Launch Capacity they take a week
				### (colony people design §§ 6.2, 10).
				te_sr_value_row = {
					tooltip = "je_space_race_widget_emig_month_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_emig_sent_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_emig_sent_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_emig_month_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_emig_bill_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_emig_bill_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_offworld_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_offworld_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_offworld_figure"
					}
				}
			}

			### Modules: fabrication, shipments, upkeep, the Extraplanetary Base room,
			### then the queue in its own box, in order (place 1 is built next).
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'modules') )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				te_sr_value_row = {
					tooltip = "je_space_race_widget_fab_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_fab_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_fab_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_shipments_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_shipments_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_shipments_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_mod_upkeep_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_mod_upkeep_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_mod_upkeep_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_ebase_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_ebase_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_ebase_figure"
					}
				}
				### The levels queued and not yet built, while there are any
				### (UI pass design § 8).
				te_sr_value_row = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_queued'), '(CFixedPoint)0' )]"
					tooltip = "je_space_race_widget_ebase_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_ebase_queued_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_ebase_queued_figure"
					}
				}
				### Resort Colony levels against their room, and those queued while
				### there are any (#1948 design § 9), shown with Space Colonization.
				te_sr_value_row = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_resort_shown'), '(CFixedPoint)1' )]"
					tooltip = "je_space_race_widget_resort_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_resort_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_resort_figure"
					}
				}
				te_sr_value_row = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_resort_queued'), '(CFixedPoint)0' )]"
					tooltip = "je_space_race_widget_resort_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_resort_queued_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_resort_queued_figure"
					}
				}
				### The queue on its own (the owner, 2026-10-31: "visually separate
				### the Queue better"): its heading with the count, then an inset
				### box holding when the next module is built and the places, and
				### a gap before the colonies' rows.
				flowcontainer = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_1'), '(CFixedPoint)1' )]"
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					margin_bottom = 8

					te_sr_subheader = {
						blockoverride "subheader_text" {
							text = "je_space_race_widget_mq_header"
						}
					}
					flowcontainer = {
						direction = vertical
						ignoreinvisible = yes
						spacing = 2
						margin = { 0 4 }

						background = {
							using = dark_area
							alpha = 0.3
						}

						### The hover says what holds the queue now (the owner, 2026-11-15):
						### stopped (by its reason), every shipment slot taken, waiting for its
						### launch window, on hold (the owner, 2026-11-23), or fabricating.
						te_sr_value_row = {
							tooltip = "[SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)3' ), SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_stop_reason'), '(CFixedPoint)1' ), 'je_space_race_widget_mq_tt_stopped_site', 'je_space_race_widget_mq_tt_stopped_fab' ), SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)2' ), 'je_space_race_widget_mq_tt_full', SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)4' ), 'je_space_race_widget_mq_tt_window', SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)5' ), 'je_space_race_widget_mq_tt_held', SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)6' ), 'je_space_race_widget_mq_tt_yard', 'je_space_race_widget_mq_tt_months' ) ) ) ) )]"
							blockoverride "row_label" {
								text = "je_space_race_widget_mq_next_label"
							}
							blockoverride "row_value" {
								text = "[SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)3' ), 'je_space_race_widget_mq_next_none', SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)2' ), 'je_space_race_widget_mq_next_full', SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)5' ), 'je_space_race_widget_mq_next_held', 'je_space_race_widget_mq_next_months' ) ) )]"
							}
						}
						te_sr_mq_rows = {}
					}
				}
			}

			### Autonomy: what the free colonies we supply trade us.
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'autonomy') )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				te_sr_value_row = {
					tooltip = "je_space_race_widget_free_trade_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_free_trade_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_free_trade_figure"
					}
				}
			}

			### Bases (Extraplanetary Base ground types design § 9.1): the
			### checkbox, our levels and room, what moves and why, the base's
			### totals before other modifiers, then the near-Earth asteroids'
			### box above the colonies'. The figures are the refresh's and the
			### clicks' (sr_eb_* variables, the stored profits a level): nothing
			### here reads a market. Three things do walk the buildings: the levels
			### rows (sr_ebase_levels, sr_ebase_queued_levels, as in Modules), the
			### unassigned row (sr_ebase_queued_levels, once) and each box's +,
			### whose validity counts the queued levels (sr_ebase_assign_sgui).
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'bases') ) )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				### The checkbox (sr_ebase_auto_sgui): ticked while sr_eb_manual is not set.
				### The scripted GUI has no is_valid, so nothing greys it and its hover
				### is what the click does, then the rule.
				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 6
					margin = { 4 1 }

					checkbutton = {
						using = check_button
						size = { 24 24 }
						parentanchor = vcenter
						checked = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_manual'), '(CFixedPoint)0' )]"
						onclick = "[GetScriptedGui('sr_ebase_auto_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_ebase_auto_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), Localize( 'je_space_race_widget_eb_auto_tt' ) ) )]"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 440
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						tooltip = "je_space_race_widget_eb_auto_tt"
						text = "je_space_race_widget_eb_auto"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_ebase_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_ebase_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_ebase_figure"
					}
				}
				te_sr_value_row = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_queued'), '(CFixedPoint)0' )]"
					tooltip = "je_space_race_widget_ebase_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_ebase_queued_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_ebase_queued_figure"
					}
				}
				### With the checkbox off, the levels built and queued that no site
				### is assigned: + needs some (sr_ebase_assign_sgui), and with the
				### checkbox on every level counts as assigned where it works.
				te_sr_value_row = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_manual'), '(CFixedPoint)1' )]"
					tooltip = "je_space_race_widget_eb_unassigned_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_eb_unassigned_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_eb_unassigned_figure"
					}
				}

				### What moves and why, once a level has been placed: with the
				### checkbox off, how far our levels are from our assignments;
				### with it on, the move under way (its source, destination,
				### year and gain) or why nothing moves; then, while nothing
				### moves, the last move.
				flowcontainer = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_placed'), '(CFixedPoint)1' )]"
					direction = vertical
					ignoreinvisible = yes
					margin = { 4 4 }

					flowcontainer = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_manual'), '(CFixedPoint)1' )]"
						direction = vertical
						ignoreinvisible = yes
						tooltip = "je_space_race_widget_eb_toward_tt"

						te_sr_eb_move_text = {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_to_go'), '(CFixedPoint)0' )]"
							text = "je_space_race_widget_eb_toward"
						}
						te_sr_eb_move_text = {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_to_go'), '(CFixedPoint)0' )]"
							text = "je_space_race_widget_eb_toward_months"
						}
						te_sr_eb_move_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_to_go'), '(CFixedPoint)0' )]"
							text = "je_space_race_widget_eb_at_assignments_line"
						}
					}
					flowcontainer = {
						visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_manual'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_moving'), '(CFixedPoint)1' ) )]"
						direction = vertical
						ignoreinvisible = yes
						tooltip = "je_space_race_widget_eb_moving_tt"

						te_sr_eb_move_text = {
							text = "je_space_race_widget_eb_moving"
						}
						te_sr_eb_move_text = {
							text = "je_space_race_widget_eb_from_to"
						}
						te_sr_eb_move_text = {
							visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_move_from_profit'), '(CFixedPoint)0' )]"
							text = "je_space_race_widget_eb_gain"
						}
						te_sr_eb_move_text = {
							visible = "[Not( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_move_from_profit'), '(CFixedPoint)0' ) )]"
							text = "je_space_race_widget_eb_loss"
						}
					}
					flowcontainer = {
						visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_manual'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_moving'), '(CFixedPoint)0' ) )]"
						direction = vertical
						ignoreinvisible = yes
						tooltip = "je_space_race_widget_eb_stay_tt"

						te_sr_eb_move_text = {
							text = "je_space_race_widget_eb_stay"
						}
						te_sr_eb_move_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_all_lose'), '(CFixedPoint)1' )]"
							text = "je_space_race_widget_eb_all_lose"
						}
						te_sr_eb_move_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_due'), '(CFixedPoint)1' )]"
							text = "je_space_race_widget_eb_next_month"
						}
						### Why nothing moves: it names what the best site with
						### room is measured against, so it wraps to a second line.
						textbox = {
							visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_all_lose'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_due'), '(CFixedPoint)0' ) )]"
							autoresize = yes
							multiline = yes
							maximumsize = { 472 -1 }
							align = left|nobaseline
							using = te_sr_fontsize_row
							text = "je_space_race_widget_eb_no_gain"
						}
					}
					flowcontainer = {
						visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_moving'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_last'), '(CFixedPoint)1' ) )]"
						direction = vertical
						ignoreinvisible = yes
						tooltip = "je_space_race_widget_eb_last_tt"

						te_sr_eb_move_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_last_one_year'), '(CFixedPoint)0' )]"
							text = "je_space_race_widget_eb_last"
						}
						te_sr_eb_move_text = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_last_one_year'), '(CFixedPoint)1' )]"
							text = "je_space_race_widget_eb_last_one"
						}
						te_sr_eb_move_text = {
							text = "je_space_race_widget_eb_last_from_to"
						}
					}
				}

				### The totals (sr_eb_totals, Task 7): goods a week and profit a
				### week from where our levels work, then where they are headed
				### (If prices hold with the checkbox on, At our assignments off).
				te_sr_subheader = {
					tooltip = "je_space_race_widget_eb_totals_tt"
					blockoverride "subheader_text" {
						text = "je_space_race_widget_eb_totals_header"
					}
				}
				te_sr_eb_total_row = {
					tooltip = "je_space_race_widget_eb_now_tt"
					blockoverride "total_label" {
						text = "je_space_race_widget_eb_now"
					}
					blockoverride "total_value" {
						text = "je_space_race_widget_eb_now_profit"
					}
				}
				te_sr_eb_goods_line = {
					blockoverride "g_iron" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_now_iron')|K]"
					}
					blockoverride "g_tech_metals" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_now_tech_metals')|K]"
					}
					blockoverride "g_gold" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_now_gold')|K]"
					}
					blockoverride "g_copper" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_now_copper')|K]"
					}
					blockoverride "g_lead" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_now_lead')|K]"
					}
					blockoverride "g_sulfur" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_now_sulfur')|K]"
					}
					blockoverride "g_glass" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_now_glass')|K]"
					}
				}
				te_sr_eb_total_row = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_manual'), '(CFixedPoint)0' )]"
					tooltip = "je_space_race_widget_eb_if_prices_hold_tt"
					blockoverride "total_label" {
						text = "je_space_race_widget_eb_if_prices_hold"
					}
					blockoverride "total_value" {
						text = "je_space_race_widget_eb_end_profit"
					}
				}
				te_sr_eb_total_row = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_manual'), '(CFixedPoint)1' )]"
					tooltip = "je_space_race_widget_eb_at_assignments_tt"
					blockoverride "total_label" {
						text = "je_space_race_widget_eb_at_assignments"
					}
					blockoverride "total_value" {
						text = "je_space_race_widget_eb_end_profit"
					}
				}
				te_sr_eb_goods_line = {
					blockoverride "g_iron" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_end_iron')|K]"
					}
					blockoverride "g_tech_metals" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_end_tech_metals')|K]"
					}
					blockoverride "g_gold" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_end_gold')|K]"
					}
					blockoverride "g_copper" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_end_copper')|K]"
					}
					blockoverride "g_lead" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_end_lead')|K]"
					}
					blockoverride "g_sulfur" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_end_sulfur')|K]"
					}
					blockoverride "g_glass" {
						raw_text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_end_glass')|K]"
					}
				}

				### The near-Earth asteroids (place 0), with Asteroid Mining.
				te_sr_eb_near_earth_row = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_eb_room_near_earth'), '(CFixedPoint)0' )]"
				}
			}

			### The rows, under the view's column heads.
			te_sr_colony_head_row = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)1' ) )]"
			}
			te_sr_colony_rows = {}

			### Autonomy: the free colonies, with our ties and Supply.
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'autonomy') )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				te_sr_subheader = {
					blockoverride "subheader_text" {
						text = "je_space_race_widget_free_header"
					}
				}
				te_sr_text = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_free_count'), '(CFixedPoint)0' )]"
					text = "je_space_race_widget_free_empty"
				}
				te_sr_free_rows = {}
			}
		}
	}

	### Another country's Colonies (National Info, spec
	### 2026-11-02-charts-help-national-info § 6.4): the colonies it holds, to
	### read. The player's own Colonies section (te_sr_sec_colonies, with the
	### settlers, modules, autonomy and defenses and their buttons) reads the
	### entry, so it stays the player's; this reads the shown Country only, and
	### shows only for another country. Its header and the count as the
	### player's section has them, then a row per colony
	### (te_sr_colony_brief_rows, generated). The solar colonization frame of the
	### Timeline Extended window's tab draws it, under the overview
	### (gen_te_systems_window.SR_FOREIGN); the journal never does. The flag is
	### sr_panel_colonies_brief_closed, client-side like the rest.
	type te_sr_sec_colonies_brief = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[Not( Country.IsLocalPlayer )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_colonies_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_colonies_brief_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_colonies_brief_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_colonies_brief_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_colonies_brief_closed'))]"

			te_sr_value_row = {
				blockoverride "row_label" {
					text = "je_space_race_widget_colonies_held_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_colonies_held_figure"
				}
			}
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_colonies_brief_empty"
			}
			te_sr_colony_brief_rows = {}
		}
	}

	### One colony in another country's Colonies (te_sr_sec_colonies_brief):
	### its icon, its name (the hover its specializations' effects, the
	### player's Colonies rows' hover) and, under Simple and Full Colonies, its
	### people against its room. Nothing to press. 24 + 330 + 110 + 2 x 4
	### spacing + 2 x 4 margin = 480. Instances in te_sr_colony_brief_rows
	### (sr_sites_generated_rows.gui), one per world, each shown while the
	### shown country holds it.
	type te_sr_colony_brief_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "brief_visible" {}

		icon = {
			size = { 24 24 }
			parentanchor = vcenter
			block "brief_icon" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 330 -1 }
			maximumsize = { 330 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "brief_name" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 110 -1 }
			maximumsize = { 110 -1 }
			parentanchor = vcenter
			align = right|nobaseline
			using = te_sr_fontsize_row
			elide = right
			tooltip = "je_space_race_widget_settlers_people_tt"
			block "brief_people" {}
		}
	}

	### One world in Solar System (te_sr_sec_solar_system): its icon and name,
	### then who holds it: "Ours", the holder's flag (vanilla's tiny_flag: the
	### country's name on hover, the country on click; a 48-character name would
	### not fit the row), "Another power" (a holder with no capital to show),
	### "Our target", "Unclaimed" or "Free" (a free colony, slice 5), each on one equality test of
	### sr_disp_site_<key> and sr_disp_site_target_<key>
	### (sr_sites_display_generated.txt). The flag reads the holder's capital,
	### stored on the viewer by sr_sites_refresh_snapshot (sr_ss_cap_<key>),
	### through the inner container's datacontext, as the Rivals rows do
	### (gui_modding_guide.md gotcha #15): its visible is on the outer
	### container, so an empty slot is never read. Then the colony fleets on
	### their way there (simple and full colonies; slices 2-3 design § 8). The
	### fleets read "count·months": how many are on their way and the months
	### until the first lands, highlighted when the first is ours. The name's
	### hover is what the world offers: its stage, its two specializations'
	### effects, our drive's transit there and its next window
	### (je_space_race_widget_ss_site_tt_<key>, audit SPC-7). Under it, slots
	### and Extraplanetary Base room (Simple and Full Colonies).
	### Two lists instance it, both generated (sr_sites_generated_rows.gui):
	### - Solar System (te_sr_solar_system_rows), a list to read: no window, no
	###   button. 24 icon + 180 name + 122 holder + 65 inbound + 3 × 3 spacing
	###   + 2 × 4 margin = 408, in the column. Shown while Solar System lists
	###   every world or the world is one our fleets can go to, ours, or one a
	###   fleet is bound for.
	### - The colony target popup (te_sr_target_picker_rows, UI pass design
	###   § 5): the launch window toward it (te_sr_site_window_cell, block
	###   site_window) and the Target button (sr_colony_target_sgui,
	###   scope:site = the world's index; Clear on our target), on every world
	###   so a greyed one says why, and under the name, first, the world's
	###   people room (te_sr_site_people_cell, block site_people). 391 + 152 window + 66 button + 5 × 3
	###   spacing + 2 × 4 margin = 632, in the popup's 760. Shown while the popup lists every world or we can
	###   target it.
	type te_sr_site_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		margin = { 4 1 }
		block "site_visible" {}

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 3

			widget = {
				size = { 24 24 }
				parentanchor = vcenter

				icon = {
					size = { 24 24 }
					parentanchor = center
					block "site_icon" {}
				}
			}
			widget = {
				size = { 180 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 180
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "site_name" {}
				}
			}
			widget = {
				size = { 122 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					default_format = "#v"
					text = "je_space_race_widget_ss_ours"
					block "site_ours_visible" {}
				}
				### Ours, in Solar System's list: vanilla's go-to arrow beside
				### the word opens the colony's window (the Colonies list's own).
				### Hidden in the colony target popup, which is a popup already.
				button_icon_goto = {
					position = { 44 0 }
					parentanchor = left|vcenter
					size = { 22 22 }
					tooltip = "je_space_race_widget_colony_open_tt"
					block "site_open" {
						visible = no
					}
				}
				flowcontainer = {
					parentanchor = left|vcenter
					ignoreinvisible = yes
					block "site_other_visible" {}

					flowcontainer = {
						direction = horizontal
						spacing = 4
						ignoreinvisible = yes
						block "site_context" {}

						widget = {
							size = { 28 24 }
							parentanchor = vcenter

							tiny_flag = {
								parentanchor = center
								datacontext = "[State.GetCountry]"
							}
						}
					}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_ss_unknown"
					block "site_unknown_visible" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					default_format = "#v"
					text = "je_space_race_widget_ss_target"
					block "site_target_mark_visible" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					default_format = "#grey"
					text = "je_space_race_widget_ss_unclaimed"
					block "site_unclaimed_visible" {}
				}
				### A free colony (slice 5 design § 9): claimed, no holder.
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_ss_free_tt"
					text = "je_space_race_widget_ss_free"
					block "site_free_visible" {}
				}
				### Occupied, and ruined (Full Colonies; slice 6 design § 16).
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_ss_occupied_tt"
					text = "je_space_race_widget_ss_occupied"
					block "site_occupied_visible" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_ss_ruined_tt"
					text = "je_space_race_widget_ss_ruined"
					block "site_ruined_visible" {}
				}
			}
			### Fleets on their way: the colonization entry's icon and their number;
			### on hover the first's landing and whether it is ours.
			widget = {
				size = { 65 24 }
				parentanchor = vcenter

				flowcontainer = {
					direction = horizontal
					spacing = 2
					ignoreinvisible = yes
					parentanchor = left|vcenter
					block "site_inbound" {}

					icon = {
						size = { 16 16 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 47
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_inbound_ours" {}
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 47
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_inbound_rival" {}
					}
				}
			}
			block "site_window" {}
			button = {
				using = default_button_action
				size = { 66 24 }
				parentanchor = vcenter
				block "site_target_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 62
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_target_button"
					block "site_target_set_visible" {}
				}
				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 62
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_target_clear"
					block "site_target_clear_visible" {}
				}
			}
		}
		### Under the name, what the site offers a colony (the owner, 2026-10-30:
		### the Colonies list showed slots and base room only for colonies held):
		### its Habitat cap, on hover the people and crews it holds at the cap at
		### our share (colony people design § 10), and its
		### Extraplanetary Base room, grade and ground type ("300 (+30%) Metallic",
		### ground types design § 9.2), each an icon and a figure with its
		### meaning on hover; the base room's hover is its type's
		### (je_space_race_widget_ss_bases_tt_<type>, block site_bases_tooltip).
		### Then its Resort Colony room and draw (#1948). Each cell holds its longest
		### figure at test_space_race_labels.py's measure and no more, so the line
		### fits the row's 400 inside its margins: 3 margin + 32 slots (18 icon +
		### 4 + 10 for "4", a world's Habitat cap) + 8 + 233 bases (18 icon + 4 +
		### 94 for "300 (+30%)" + 4 + 113 for "Carbonaceous") + 8 + 116 resorts
		### (18 icon + 4 + 94 for "100 (+25%)", Mars's room since 2026-11-28)
		### = 400. It starts under the icon, not the name, to make
		### that room. Simple and Full Colonies only. The colony target popup
		### puts the world's people room first (te_sr_site_people_cell, block
		### site_people): 88 + 8 more, 496 in its row's 624.
		flowcontainer = {
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
			direction = horizontal
			ignoreinvisible = yes
			spacing = 8
			margin_left = 3

			block "site_people" {}
			widget = {
				size = { 32 22 }
				parentanchor = vcenter
				block "site_slots_tooltip" {
					tooltip = "je_space_race_widget_ss_slots_tt"
				}

				flowcontainer = {
					direction = horizontal
					spacing = 4
					parentanchor = left|vcenter

					icon = {
						size = { 18 18 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/space_race_icons/module.dds"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 10
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_slots" {}
					}
				}
			}
			widget = {
				size = { 233 22 }
				parentanchor = vcenter
				block "site_bases_tooltip" {}

				flowcontainer = {
					direction = horizontal
					spacing = 4
					parentanchor = left|vcenter

					icon = {
						size = { 18 18 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/building_icons/building_space_mine.dds"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 94
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_bases" {}
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 113
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_ground" {}
					}
				}
			}
			### Its Resort Colony room and draw (#1948 design § 9).
			widget = {
				size = { 116 22 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_ss_resorts_tt"

				flowcontainer = {
					direction = horizontal
					spacing = 4
					parentanchor = left|vcenter

					icon = {
						size = { 18 18 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/building_icons/building_tourism_industry.dds"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 94
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_resorts" {}
					}
				}
			}
		}
	}

	### A site's launch window in the colony target popup (UI pass design § 5):
	### the four states of Next Windows' row (te_sr_window_row,
	### sr_launch_window_widgets.gui) on sr_disp_win_state_<body> for the body
	### our transit to the site is read for (gen_solar_sites.transit_body).
	### 152 wide: "+999% now, 99 mo" with depots, at its longest.
	type te_sr_site_window_cell = widget {
		size = { 152 24 }
		parentanchor = vcenter
		tooltip = "je_space_race_widget_tp_window_tt"

		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 152
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_win_any"
			block "win_any_visible" {}
		}
		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 152
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_win_open"
			block "win_open_visible" {}
		}
		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 152
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "win_wait" {}
		}
		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 152
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "win_paid" {}
		}
	}

	### A site's people room in the colony target popup (the owner, 2026-11-22):
	### the people the world would hold as ours before any Habitat, its base room
	### at our factor (sr_disp_ss_people_room_<key>: the table's room x
	### sr_our_room_mult, up to double with Space Colonization and Terraforming),
	### of which each Habitat adds its share. 88 wide: 18 icon + 4 + 66 for "100,000".
	type te_sr_site_people_cell = widget {
		size = { 88 22 }
		parentanchor = vcenter
		tooltip = "je_space_race_widget_tp_people_tt"

		flowcontainer = {
			direction = horizontal
			spacing = 4
			parentanchor = left|vcenter

			icon = {
				size = { 18 18 }
				parentanchor = vcenter
				texture = "gfx/interface/icons/generic_icons/population.dds"
			}
			textbox = {
				parentanchor = vcenter
				autoresize = yes
				max_width = 66
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "people_room" {}
			}
		}
	}

	### The colony target popup's content (UI pass design § 5), under the
	### popup's journal-entry datacontext: what it is for, how many worlds we
	### can target with Show all beside the count (the client-side
	### sr_panel_target_popup_all_open, as Solar System's own toggle), every world under
	### its location, and a line while no world can be targeted.
	type te_sr_target_popup_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		minimumsize = { 632 -1 }
		spacing = 2

		te_sr_note = {
			text = "je_space_race_widget_tp_intro"
		}

		### The count reads the player: SelectLocalization renders its key
		### without the journal entry (gotcha #16).
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin = { 4 1 }

			textbox = {
				autoresize = yes
				minimumsize = { 352 -1 }
				maximumsize = { 352 -1 }
				parentanchor = vcenter
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				text = "[SelectLocalization( GetVariableSystem.Exists('sr_panel_target_popup_all_open'), 'je_space_race_widget_tp_all', 'je_space_race_widget_tp_count' )]"
			}
			button = {
				using = default_button
				size = { 116 26 }
				parentanchor = vcenter
				onclick = "[GetVariableSystem.Toggle('sr_panel_target_popup_all_open')]"
				tooltip = "je_space_race_widget_tp_toggle_tt"

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 110
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_show_all"
					visible = "[Not(GetVariableSystem.Exists('sr_panel_target_popup_all_open'))]"
				}
				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 110
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_show_fewer"
					visible = "[GetVariableSystem.Exists('sr_panel_target_popup_all_open')]"
				}
			}
		}

		te_sr_target_picker_rows = {}

		te_sr_note = {
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_tp_count'), '(CFixedPoint)0' )]"
			text = "je_space_race_widget_tp_none"
		}
	}

	### The colony target popup (UI pass design § 5), opened from Colony
	### Fleets' Change and Choose (te_popup = sr_target); instanced in
	### te_popups (gui/te_popups.gui). The content sits under the entry's
	### scope-free gate and its GetPlayerJournalEntry datacontext on a child
	### (gotchas #22, #29); with the entry gone, one line says so.
	type te_sr_target_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'sr_target')]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_tp_title"
		}
		### The rows' 632, plus the window's margins (2 × 35), the list's
		### (2 × 10) and a scrollbar: 760.
		blockoverride "popup_size" {
			size = { 760 640 }
		}
		blockoverride "popup_list" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_space_race_solar_colonization')]"
					direction = vertical
					ignoreinvisible = yes

					te_sr_target_popup_body = {}
				}
			}
			te_sr_note = {
				visible = "[Not( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "je_space_race_widget_tp_gone"
			}
		}
	}

	### One site on the map (te_sr_system_map): a marker by its state, as the
	### list's row words it (sr_disp_site_<key>: unclaimed, ours, another
	### power's as its flag, or a red marker while we don't know whose, free,
	### occupied, ruined), a ring round our colony fleets' target and the
	### track's ship at its corner while a colony fleet is on its way. Its
	### hover is the site's (its stage, place and specializations). A click on
	### ours opens the colony's window; on any other it lists the site's
	### location below the map. 20 × 20, the marker 14; placed in its
	### location's column by pip_position. Instances in te_sr_map_locations
	### (sr_sites_generated_rows.gui).
	type te_sr_map_pip = widget {
		size = { 20 20 }
		block "pip_position" {}

		icon = {
			size = { 20 20 }
			texture = "gfx/interface/icons/space_race_icons/map_target.dds"
			block "pip_target_visible" {}
		}
		icon = {
			size = { 14 14 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/map_pip_unclaimed.dds"
			block "pip_unclaimed_visible" {}
		}
		icon = {
			size = { 14 14 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/map_pip_ours.dds"
			block "pip_ours_visible" {}
		}
		### Another power's: its flag (its capital stored on the viewer,
		### sr_ss_cap_<key>, gotcha #15), small and not a button, so the click
		### is the marker's.
		flowcontainer = {
			parentanchor = center
			ignoreinvisible = yes
			block "pip_other_visible" {}

			flowcontainer = {
				ignoreinvisible = yes
				block "pip_context" {}

				icon = {
					datacontext = "[State.GetCountry]"
					size = { 20 13 }
					texture = "[Country.GetFlag.GetSmallFlagTexture]"
					frame = "[Country.GetFlag.GetSmallFlagFrame]"
					framesize = "[GetSmallFlagFrameSize]"
					alwaystransparent = yes
				}
			}
		}
		icon = {
			size = { 14 14 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/map_pip_other.dds"
			block "pip_unknown_visible" {}
		}
		icon = {
			size = { 14 14 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/map_pip_free.dds"
			block "pip_free_visible" {}
		}
		icon = {
			size = { 14 14 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/map_pip_occupied.dds"
			block "pip_occupied_visible" {}
		}
		icon = {
			size = { 14 14 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/map_pip_ruined.dds"
			block "pip_ruined_visible" {}
		}
		icon = {
			size = { 9 9 }
			parentanchor = top|right
			texture = "gfx/interface/icons/space_race_icons/track_ship.dds"
			block "pip_inbound_visible" {}
		}
		button_normal = {
			size = { 100% 100% }
			block "pip_open" {}
		}
		button_normal = {
			size = { 100% 100% }
			block "pip_select" {}
		}
	}

	### One location on the map, a column of it: its world's icon on its orbit
	### (the backdrop's, gen_space_map_art.py), its short name beneath, then
	### its sites' markers two abreast (te_sr_map_pip, in loc_pips). The icon
	### and name are one button: a click lists this location's sites below the
	### map, a second click goes back to the usual list; the location listed
	### has its icon framed. 50 wide, nine to the map's 450. The names are at
	### the overview's 16 (style guide rule 3), which a 50-wide column does not
	### hold ("Neptune" takes 66), so each is 100 wide, centred on its column
	### and on one of two lines by turns (loc_name gives the position: 40 or
	### 58), and neighbours never share a line. 142 high: icon 4 to 38, names
	### 40 to 76, markers from 80 (three rows of 20).
	type te_sr_map_location = widget {
		size = { 50 142 }

		widget = {
			size = { 42 42 }
			position = { 4 0 }
			block "loc_selected_visible" {}

			icon = {
				using = highlighted_square_selection
			}
		}
		icon = {
			size = { 34 34 }
			position = { 8 4 }
			block "loc_icon" {}
		}
		textbox = {
			size = { 100 18 }
			align = center|nobaseline
			using = te_sr_fontsize_overview
			elide = right
			block "loc_name" {}
		}
		button_normal = {
			size = { 50 78 }
			block "loc_select" {}
		}
		button_normal = {
			size = { 50 78 }
			block "loc_clear" {}
		}
		block "loc_pips" {}
	}

	### One entry of the map's key: a marker and its word small beside it, the
	### hover what the marker means (style guide rule 4).
	type te_sr_map_key = flowcontainer {
		direction = horizontal
		spacing = 3
		block "key_tooltip" {}

		icon = {
			size = { 14 14 }
			parentanchor = vcenter
			block "key_icon" {}
		}
		textbox = {
			parentanchor = vcenter
			autoresize = yes
			max_width = 90
			align = left|nobaseline
			using = te_sr_fontsize_overview
			elide = right
			block "key_text" {}
		}
	}

	### The system map (the owner, 2026-11-23: "some kind of schematic view of
	### the solar system"; UI pass design § 12): the Sun and the nine
	### locations from the Moon outward on their orbits, each with its sites'
	### markers, so who holds what, our target and the colony fleets in flight
	### read at a glance; under it the markers' key. The orbits are the
	### backdrop's (map_backdrop.dds, drawn by gen_space_map_art.py with this
	### layout: the first column at 28, columns of 50, the icons' line at 21).
	### A location's button and a marker set sr_ss_loc, which Solar System's
	### list reads. 480 × 148, the column's width; the columns are
	### te_sr_map_locations (generated, sr_sites_generated_rows.gui). The key
	### is 6 markers and their words, 462 at the overview's 16.
	type te_sr_system_map = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4
		parentanchor = hcenter

		widget = {
			size = { 480 148 }

			background = {
				using = dark_area
				alpha = 0.45
			}
			icon = {
				size = { 480 148 }
				texture = "gfx/interface/icons/space_race_icons/map_backdrop.dds"
				alwaystransparent = yes
			}
			te_sr_map_locations = {
				position = { 28 2 }
			}
		}
		flowcontainer = {
			direction = horizontal
			spacing = 10
			parentanchor = hcenter

			te_sr_map_key = {
				blockoverride "key_tooltip" {
					tooltip = "je_space_race_widget_map_key_ours_tt"
				}
				blockoverride "key_icon" {
					texture = "gfx/interface/icons/space_race_icons/map_pip_ours.dds"
				}
				blockoverride "key_text" {
					text = "je_space_race_widget_ss_ours"
				}
			}
			te_sr_map_key = {
				blockoverride "key_tooltip" {
					tooltip = "je_space_race_widget_map_key_other_tt"
				}
				blockoverride "key_icon" {
					texture = "gfx/interface/icons/space_race_icons/map_pip_other.dds"
				}
				blockoverride "key_text" {
					text = "je_space_race_widget_map_key_other"
				}
			}
			te_sr_map_key = {
				blockoverride "key_tooltip" {
					tooltip = "je_space_race_widget_map_key_unclaimed_tt"
				}
				blockoverride "key_icon" {
					texture = "gfx/interface/icons/space_race_icons/map_pip_unclaimed.dds"
				}
				blockoverride "key_text" {
					text = "je_space_race_widget_ss_unclaimed"
				}
			}
			te_sr_map_key = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
				blockoverride "key_tooltip" {
					tooltip = "je_space_race_widget_ss_free_tt"
				}
				blockoverride "key_icon" {
					texture = "gfx/interface/icons/space_race_icons/map_pip_free.dds"
				}
				blockoverride "key_text" {
					text = "je_space_race_widget_ss_free"
				}
			}
			te_sr_map_key = {
				blockoverride "key_tooltip" {
					tooltip = "je_space_race_widget_map_key_target_tt"
				}
				blockoverride "key_icon" {
					texture = "gfx/interface/icons/space_race_icons/map_target.dds"
				}
				blockoverride "key_text" {
					text = "je_space_race_widget_map_key_target"
				}
			}
			te_sr_map_key = {
				blockoverride "key_tooltip" {
					tooltip = "je_space_race_widget_ss_inbound_tt"
				}
				blockoverride "key_icon" {
					texture = "gfx/interface/icons/space_race_icons/track_ship.dds"
				}
				blockoverride "key_text" {
					text = "je_space_race_widget_map_key_inbound"
				}
			}
		}
	}

	### Solar System (solar colonization only): the system map
	### (te_sr_system_map: the nine locations on their orbits, each site a
	### marker), then the worlds under their locations, with who holds them
	### (design § 9), a list to read: a target is picked in the colony target
	### popup, from Colony Fleets (UI pass design § 5), and a row of ours opens
	### the colony's window. Open by default, and filtered by default to the
	### worlds that matter now: those our next colony fleet can go to, ours and
	### any a fleet is bound for (sr_disp_ss_filtered_<location>), with "Show
	### all" beside the count. A location picked on the map
	### (sr_ss_loc its key) lists that location's sites alone, every one,
	### with "All locations" in Show all's slot to go back. Rows in
	### gen_solar_sites.panel_order(), written from the table and held to it
	### by test_solar_sites.py. The flags are sr_panel_solar_system_closed,
	### sr_panel_solar_system_all_open and sr_ss_loc, client-side like the rest.
	type te_sr_sec_solar_system = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_solar_system_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_solar_system_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_solar_system_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_closed'))]"

			te_sr_system_map = {}

			### How many worlds the list shows, and the toggle that shows every
			### one; with a location picked on the map, that the list is its
			### sites, and the button back to every location.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				margin = { 4 1 }
				margin_top = 6

				### The count reads the player: SelectLocalization renders its key
				### without the journal entry (gotcha #16).
				textbox = {
					autoresize = yes
					minimumsize = { 332 -1 }
					maximumsize = { 332 -1 }
					parentanchor = vcenter
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "[SelectLocalization( GetVariableSystem.Exists('sr_ss_loc'), 'je_space_race_widget_ss_one_location', SelectLocalization( GetVariableSystem.Exists('sr_panel_solar_system_all_open'), 'je_space_race_widget_ss_all', 'je_space_race_widget_ss_filtered' ) )]"
				}
				### The two buttons take turns in one slot of their size (style
				### guide rule 8), 136 for "All locations": 4 + 332 + 4 + 136 + 4 = 480.
				widget = {
					size = { 136 26 }
					parentanchor = vcenter

					button = {
						visible = "[Not( GetVariableSystem.Exists('sr_ss_loc') )]"
						using = default_button
						size = { 136 26 }
						onclick = "[GetVariableSystem.Toggle('sr_panel_solar_system_all_open')]"
						tooltip = "je_space_race_widget_ss_toggle_tt"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 130
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_ss_show_all"
							visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_all_open'))]"
						}
						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 130
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_ss_show_fewer"
							visible = "[GetVariableSystem.Exists('sr_panel_solar_system_all_open')]"
						}
					}
					button = {
						visible = "[GetVariableSystem.Exists('sr_ss_loc')]"
						using = default_button
						size = { 136 26 }
						onclick = "[GetVariableSystem.Clear('sr_ss_loc')]"
						tooltip = "je_space_race_widget_ss_all_locations_tt"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 130
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_ss_all_locations"
						}
					}
				}
			}

			### Every world under its location, generated from the site table
			### (gui/journal_entry_widgets/sr_sites_generated_rows.gui).
			te_sr_solar_system_rows = {}
		}
	}

	### One fleet slot in Colony Fleets: the colonization entry's icon, the world
	### it is bound for (sr_cf_slot_<n>_name, generated custom loc), the leg
	### flown so far as a bar with the ship on it (sr_disp_cf_slot_<n>_frac, as a
	### space fleet's track) and when it lands. 24 + 150 + 92 + 188 + 3 × 4
	### spacing + 2 × 4 margin = 474. Instances in te_sr_cf_slot_rows
	### (sr_sites_generated_rows.gui), one per slot.
	type te_sr_cf_slot_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "slot_visible" {}

		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			icon = {
				size = { 24 24 }
				parentanchor = center
				texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
			}
		}
		widget = {
			size = { 150 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 150
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "slot_name" {}
			}
		}
		widget = {
			size = { 92 18 }
			parentanchor = vcenter

			default_progressbar_horizontal = {
				size = { 100% 100% }
				blockoverride "values" {
					block "slot_frac" {}
					min = 0
					max = 1
				}
				blockoverride "on_top_of_the_progressbar" {
					progressbar = {
						noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
						progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
						size = { 100% 100% }
						skip_initial_animation = yes
						direction = horizontal
						block "slot_frac" {}
						min = 0
						max = 1
						marker = {
							icon = {
								size = { 18 18 }
								parentanchor = vcenter
								widgetanchor = center
								texture = "gfx/interface/icons/space_race_icons/track_ship.dds"
							}
						}
					}
				}
			}
		}
		widget = {
			size = { 188 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 188
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "slot_eta" {}
			}
		}
	}

	### Where our next colony fleet goes, in Colony Fleets (audit SPC-7): a
	### label, the world or "chosen at launch", then Change and Clear beside
	### our target, or Choose (UI pass design § 5): both open the colony
	### target popup. 110 + 184 + 66 + 66 + 3 × 4 + 2 × 4 = 446 at most, in
	### the 480 column. The label is underlined where the row has a hover
	### (the pick's rule).
	type te_sr_cf_dest_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "dest_row" {}

		textbox = {
			autoresize = yes
			minimumsize = { 110 -1 }
			maximumsize = { 110 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "dest_label" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 184 -1 }
			maximumsize = { 184 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			default_format = "#v"
			block "dest_value" {}
		}
		block "dest_button" {}
	}

	### Colony Fleets (solar colonization; slices 2-3 design §§ 3, 8): where our
	### next colony fleet goes, as a value row with Clear beside our target
	### (sr_cf_target_clear_sgui; audit SPC-7), the drive it flies on
	### ([concept_sr_drive]), and under simple and full colonies our colony fleets
	### in flight, one row per slot. Change and Choose open the colony target
	### popup (te_sr_target_popup; UI pass design § 5). Open by default; the
	### flag is sr_panel_fleets_closed.
	type te_sr_sec_colony_fleets = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_fleets_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_fleets_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_fleets_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_fleets_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_fleets_closed'))]"

			### Our target, with Clear beside it; or, with none, the program's
			### pick at launch, its rule on hover.
			te_sr_cf_dest_row = {
				blockoverride "dest_row" {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)1' )]"
				}
				blockoverride "dest_label" {
					text = "je_space_race_widget_cf_target_label"
				}
				blockoverride "dest_value" {
					text = "je_space_race_widget_cf_target_value"
					tooltip = "je_space_race_widget_cf_target_habs_tt"
				}
				blockoverride "dest_button" {
					button = {
						using = default_button_action
						size = { 66 24 }
						parentanchor = vcenter
						onclick = "[GetVariableSystem.Set('te_popup', 'sr_target')]"
						tooltip = "je_space_race_widget_cf_change_tt"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 62
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_cf_change"
						}
					}
					button = {
						using = default_button_action
						size = { 66 24 }
						parentanchor = vcenter
						enabled = "[GetScriptedGui('sr_cf_target_clear_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('sr_cf_target_clear_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_cf_target_clear_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_cf_target_clear_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 62
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_ss_target_clear"
						}
					}
				}
			}
			te_sr_cf_dest_row = {
				blockoverride "dest_row" {
					visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)0' ) )]"
					tooltip = "je_space_race_widget_cf_destination_auto"
				}
				blockoverride "dest_label" {
					text = "je_space_race_widget_cf_next_label"
				}
				blockoverride "dest_value" {
					text = "je_space_race_widget_cf_next_auto"
				}
				blockoverride "dest_button" {
					button = {
						using = default_button_action
						size = { 66 24 }
						parentanchor = vcenter
						onclick = "[GetVariableSystem.Set('te_popup', 'sr_target')]"
						tooltip = "je_space_race_widget_cf_change_tt"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 62
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_cf_choose"
						}
					}
				}
			}
			te_sr_cf_dest_row = {
				blockoverride "dest_row" {
					visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ) )]"
					tooltip = "je_space_race_widget_cf_destination_auto_contested"
				}
				blockoverride "dest_label" {
					text = "je_space_race_widget_cf_next_label"
				}
				blockoverride "dest_value" {
					text = "je_space_race_widget_cf_next_auto"
				}
				blockoverride "dest_button" {
					button = {
						using = default_button_action
						size = { 66 24 }
						parentanchor = vcenter
						onclick = "[GetVariableSystem.Set('te_popup', 'sr_target')]"
						tooltip = "je_space_race_widget_cf_change_tt"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 62
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_cf_choose"
						}
					}
				}
			}
			te_sr_value_row = {
				blockoverride "row_label" {
					text = "je_space_race_widget_cf_drive_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_cf_drive_value"
				}
			}
			te_sr_value_row = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
				blockoverride "row_label" {
					text = "je_space_race_widget_cf_in_flight_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_cf_in_flight_figure"
				}
			}
			te_sr_cf_slot_rows = {}
		}
	}

	### One free colony in Colony Autonomy's Free Colonies (slice 5 design §§ 3,
	### 9): its icon and name, its people (K figures), our ties with it (0-100;
