	### The Colonies window's list of our colonies, one a line: the world's icon
	### and the colony's name on a button (clean_button, as the list's names),
	### greyed for the colony shown (the radio pattern of the tabs). 212 wide:
	### 4 + 20 + 4 + 180 + 4, the name's cell the list's own 180 ("Venus Cloud
	### Habitat" takes 178). Instances in te_sr_colony_switch_rows
	### (sr_sites_generated_rows.gui): every world, shown while ours.
	type te_sr_colony_switch_row = button {
		using = clean_button
		size = { 212 26 }
		block "switch_row" {}

		icon = {
			size = { 20 20 }
			position = { 4 0 }
			parentanchor = left|vcenter
			block "switch_icon" {}
		}
		textbox = {
			position = { 28 0 }
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 180
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "switch_name" {}
		}
	}

	### The Colonies window's content (te_sr_colony_popup): at the left how
	### many colonies we hold and each of them on a button
	### (te_sr_colony_switch_rows, generated), a click showing that colony;
	### beside them the shown colony's page (te_sr_colony_pages, one
	### te_sr_colony_page a world, generated), or one line when the colony the
	### window was opened on is no longer ours. 212 + 14 + 472 + 16 + 472 = 1186.
	type te_sr_colony_popup_body = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 14

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 2
			minimumsize = { 212 -1 }

			widget = {
				size = { 212 30 }

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 130
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_colonies_held_label"
				}
				textbox = {
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 74
					align = right|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_cw_held_figure"
				}
				divider_clean = {
					parentanchor = bottom|left
					blockoverride "size" {
						size = { 212 2 }
					}
				}
			}
			te_sr_colony_switch_rows = {}
		}
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			minimumsize = { 960 -1 }

			te_sr_colony_pages = {}
		}
	}

	### The Colonies window (the owner, 2026-11-23: "clicking on a base should
	### open the base in a new window"): a colony's page, with every colony we
	### hold a click away at its left. Opened on a colony by its name or arrow
	### in the Colonies list, by its row in Solar System and by its marker on
	### the map (te_popup = sr_colony, sr_colony_focus its key); instanced in
	### te_popups (gui/te_popups.gui). The content sits under the entry's
	### scope-free gate and its GetPlayerJournalEntry datacontext on a child,
	### as the colony target popup's (gotchas #22, #29); the gate's block also
	### gives the player's Country, which the names' hovers read
	### (je_space_race_widget_colony_site_tt_<key>, written for the journal
	### entry, where te_je_country gives it). With the entry gone, one line
	### says so. 1186 of content, plus the window's margins (2 × 35), the
	### list's (2 × 10) and a scrollbar: 1300. 860 high: the page is its
	### header (58) over the taller column, Modules, which is its heading,
	### three rows of tiles and sixteen module lines on a world that takes
	### Terraforming (30 + 3 × 54 + 16 × 32 = 704); the list scrolls with the
	### page past twenty-five colonies or so.
	type te_sr_colony_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'sr_colony')]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_cw_title"
		}
		blockoverride "popup_size" {
			size = { 1300 860 }
		}
		blockoverride "popup_list" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				datacontext = "[GetPlayer]"
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_space_race_solar_colonization')]"
					direction = vertical
					ignoreinvisible = yes

					te_sr_colony_popup_body = {}
				}
			}
			te_sr_note = {
				visible = "[Not( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "je_space_race_widget_tp_gone"
			}
		}
	}

	### The column heads over te_sr_colony_row's figures (colony management design
	### § 8): above the rows for the People, Autonomy and Defenses views, and under
	### each heading on a colony's page; the module cells label themselves. At the
	### figures' widths and 28 in.
	type te_sr_colony_head_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		margin = { 4 1 }

		te_sr_colony_heads_people = {
			visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), Not( Or( GetVariableSystem.HasValue('sr_colony_view', 'modules'), Or( GetVariableSystem.HasValue('sr_colony_view', 'autonomy'), Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'bases') ) ) ) ) ) )]"
		}
		te_sr_colony_heads_autonomy = {
			visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'autonomy') )]"
		}
		te_sr_colony_heads_defences = {
			visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') )]"
		}
	}

	### People's heads: people and room, crews.
	type te_sr_colony_heads_people = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin_left = 28

		widget = {
			size = { 144 20 }

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 144
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				tooltip = "je_space_race_widget_settlers_people_tt"
				text = "je_space_race_widget_ch_people"
			}
		}
		widget = {
			size = { 60 20 }

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 60
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				tooltip = "je_space_race_widget_settlers_crews_tt"
				text = "je_space_race_widget_ch_crews"
			}
		}
	}

	### Autonomy's heads: autonomy, drift, the colony's own building.
	type te_sr_colony_heads_autonomy = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin_left = 28

		widget = {
			size = { 80 20 }

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 80
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				tooltip = "je_space_race_widget_autonomy_figure_tt"
				text = "je_space_race_widget_ch_autonomy"
			}
		}
		widget = {
			size = { 70 20 }

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 70
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				tooltip = "je_space_race_widget_autonomy_drift_tt"
