	### ======================================================================
	### REFERENCE (collapsed by default)
	### ======================================================================

	### "How the Space Race Works": every explanation the live sections used to
	### carry, one heading per topic. The same on all nine entries, so one
	### flag serves them all.
	type te_sr_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('sr_panel_how_open')]"
			}
		}

		te_sr_panel = {
			visible = "[GetVariableSystem.Exists('sr_panel_how_open')]"

			te_sr_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_space_race_widget_how_sub_approach"
				}
			}
			te_sr_note = {
				text = "je_space_race_widget_how_approach"
			}
			te_sr_subheader = {
				blockoverride "subheader_text" {
					text = "je_space_race_widget_how_sub_funding"
				}
			}
			te_sr_note = {
				text = "je_space_race_widget_how_funding"
			}
			te_sr_subheader = {
				blockoverride "subheader_text" {
					text = "je_space_race_widget_how_sub_setbacks"
				}
			}
			te_sr_note = {
				text = "je_space_race_widget_how_setbacks"
			}
			te_sr_subheader = {
