	type te_sr_settler_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "settler_visible" {}

		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			icon = {
				size = { 24 24 }
				parentanchor = center
				block "settler_icon" {}
