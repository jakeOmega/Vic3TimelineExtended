	### One fleet slot in Fleets: where it is (or "→ Mars" in transit), its
	### strength now / full (the roles on hover), its drive (or its refit's
	### months), its propellant in km/s (its capacity on the strength hover), its
	### months of supply and its marines; then, at a location, its orders: the destination button
	### (it steps through the other eight; the leg on hover), Go, Merge, Detach,
	### Land, Embark; and from 6b its posture, its target world and Seize /
	### Destroy. In transit, its landing instead. 80 + 80 + 88 + 48 + 56 + 64 +
	### 5 × 4 + 2 × 4 = 444; the orders 104 + 5 × 56 + 5 × 4 = 404. Instances in
	### te_sr_fleet_rows (sr_fleets_generated_rows.gui), one per slot; the
	### scripted GUIs are sr_fleet_sguis.txt's, scope:op the slot.
	type te_sr_fleet_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2
		block "fl_visible" {}

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin = { 4 1 }

			widget = {
				size = { 80 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 80
					align = left|nobaseline
					using = fontsize_small
					elide = right
					block "fl_where" {}
				}
			}
			widget = {
				size = { 80 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 80
					align = left|nobaseline
					using = fontsize_small
					elide = right
					default_format = "#v"
					block "fl_strength" {}
				}
			}
			widget = {
				size = { 88 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_drive_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 88
					align = left|nobaseline
					using = fontsize_small
					elide = right
					block "fl_drive" {}
				}
				flowcontainer = {
					parentanchor = left|vcenter
					direction = horizontal
					spacing = 2
					ignoreinvisible = yes
					block "fl_refit_visible" {}

					background = {
						using = entry_bg_fancy_dark
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 60
						align = left|nobaseline
						using = fontsize_small
						elide = right
						text = "je_space_race_widget_fl_refit"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 18
						align = left|nobaseline
						using = fontsize_small
						default_format = "#v"
						block "fl_refit" {}
					}
				}
			}
			widget = {
				size = { 48 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_dv_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 48
					align = left|nobaseline
					using = fontsize_small
					elide = right
					block "fl_dv" {}
				}
			}
			widget = {
				size = { 56 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_supply_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 56
					align = left|nobaseline
					using = fontsize_small
					elide = right
					block "fl_supply" {}
				}
			}
			widget = {
				size = { 64 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_marines_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 64
					align = left|nobaseline
					using = fontsize_small
					elide = right
					block "fl_marines" {}
				}
			}
		}
		### In transit: when it lands.
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			margin = { 8 1 }
			block "fl_transit_visible" {}

			textbox = {
				autoresize = yes
				max_width = 460
				align = left|nobaseline
				using = fontsize_small
				elide = right
				block "fl_transit" {}
