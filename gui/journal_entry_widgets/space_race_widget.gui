					text = "je_space_race_widget_how_sub_first"
				}
			}
			te_sr_note = {
				text = "je_space_race_widget_how_first"
			}
			te_sr_subheader = {
				blockoverride "subheader_text" {
					text = "je_space_race_widget_how_sub_rivals"
				}
			}
			te_sr_note = {
				text = "je_space_race_widget_how_rivals"
