					icon = {
						size = { 18 18 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/space_race_icons/module.dds"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 40
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_slots" {}
