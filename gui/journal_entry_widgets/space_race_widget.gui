	### Colony Autonomy (solar colonization, simple and full colonies; slice 5
	### design § 9): every colony we hold, with its autonomy, status and Abandon;
	### then the free colonies, with our ties and Supply. Open by default; the
	### flag is sr_panel_autonomy_closed.
	type te_sr_sec_autonomy = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[And( JournalEntry.IsActive, EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ) )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_autonomy_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_autonomy_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_autonomy_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_autonomy_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_autonomy_closed'))]"

			te_sr_note = {
				text = "je_space_race_widget_autonomy_note"
			}
			te_sr_value_row = {
				tooltip = "je_space_race_widget_free_trade_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_free_trade_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_free_trade_figure"
				}
			}
			te_sr_note = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_settlers_empty"
			}
			te_sr_autonomy_rows = {}
			te_sr_subheader = {
				blockoverride "subheader_text" {
					text = "je_space_race_widget_free_header"
				}
			}
			te_sr_note = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_free_count'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_free_empty"
			}
			te_sr_free_rows = {}
		}
	}

	### One colony we hold in Colony Modules (simple and full colonies; colony
	### modules design § 11): its icon and name, its staffing (the share of its
	### modules its crews can run), then a cell per module type, in the column
	### order of the header row (te_sr_module_header_row): the first
	### specialization, the second, Habitat, Spaceport, Defences. A cell is the
	### level (its tooltip what the module does: a specialization's is its Our
	### Colonies row's), "+N" for what is queued or on its way, and a button that
	### queues one more (sr_colony_module_sgui, scope:site = the world's index,
	### scope:op = the type). The last button clears the colony's queue
	### (scope:op = 0). 24 + 88 + 36 + 5 × 52 + 24 + 8 × 4 spacing + 2 × 4
