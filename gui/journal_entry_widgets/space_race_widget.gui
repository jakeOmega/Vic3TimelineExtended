	### One world in Solar System (te_sr_sec_solar_system): its icon and name,
	### then who holds it: "Ours", the holder's flag (vanilla's tiny_flag: the
	### country's name on hover, the country on click; a 48-character name would
	### not fit the row), "Another power" (a holder with no capital to show),
	### "Our target", "Unclaimed" or "Free" (a free colony, slice 5), each on one equality test of
	### sr_disp_site_<key> and sr_disp_site_target_<key>
	### (sr_sites_display_generated.txt). The flag reads the holder's capital,
	### stored on the viewer by sr_sites_refresh_snapshot (sr_ss_cap_<key>),
	### through the inner container's datacontext, as the Rivals rows do
	### (gui_modding_guide.md gotcha #15): its visible is on the outer
	### container, so an empty slot is never read. Then the colony fleets on
	### their way there (simple and full colonies; slices 2-3 design § 8) and
	### the Target button (§ 3: sr_colony_target_sgui, scope:site = the world's
	### index; Clear on our target). The fleets read "count·months": how many
	### are on their way and the months until the first lands, highlighted
	### when the first is ours. 24 icon + 180 name + 124 holder + 64 inbound +
	### 60 button + 4 × 4 spacing + 2 × 4 margin = 476, in the 480 column. The
	### instances are generated (te_sr_solar_system_rows,
	### sr_sites_generated_rows.gui).
	type te_sr_site_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			icon = {
				size = { 24 24 }
				parentanchor = center
				block "site_icon" {}
			}
		}
		widget = {
			size = { 180 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 180
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				block "site_name" {}
			}
		}
		widget = {
			size = { 124 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				default_format = "#v"
				text = "je_space_race_widget_ss_ours"
				block "site_ours_visible" {}
			}
			flowcontainer = {
				parentanchor = left|vcenter
				ignoreinvisible = yes
				block "site_other_visible" {}

				flowcontainer = {
					direction = horizontal
					spacing = 4
					ignoreinvisible = yes
					block "site_context" {}

					widget = {
						size = { 28 24 }
						parentanchor = vcenter

						tiny_flag = {
							parentanchor = center
							datacontext = "[State.GetCountry]"
						}
					}
				}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				text = "je_space_race_widget_ss_unknown"
				block "site_unknown_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				default_format = "#v"
				text = "je_space_race_widget_ss_target"
				block "site_target_mark_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				default_format = "#grey"
				text = "je_space_race_widget_ss_unclaimed"
				block "site_unclaimed_visible" {}
			}
			### A free colony (slice 5 design § 9): claimed, no holder.
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				tooltip = "je_space_race_widget_ss_free_tt"
				text = "je_space_race_widget_ss_free"
				block "site_free_visible" {}
			}
			### Occupied, and ruined (Full Colonies; slice 6 design § 16).
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				default_format = "#R"
				tooltip = "je_space_race_widget_ss_occupied_tt"
				text = "je_space_race_widget_ss_occupied"
				block "site_occupied_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				default_format = "#grey"
				tooltip = "je_space_race_widget_ss_ruined_tt"
				text = "je_space_race_widget_ss_ruined"
				block "site_ruined_visible" {}
			}
		}
		### Fleets on their way: the colonization entry's icon and their number;
		### on hover the first's landing and whether it is ours.
		widget = {
			size = { 64 24 }
			parentanchor = vcenter

			flowcontainer = {
				direction = horizontal
				spacing = 2
				ignoreinvisible = yes
				parentanchor = left|vcenter
				block "site_inbound" {}

				icon = {
					size = { 16 16 }
					parentanchor = vcenter
					texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
				}
				textbox = {
					parentanchor = vcenter
					autoresize = yes
					max_width = 46
					align = left|nobaseline
					using = fontsize_small
					elide = right
					default_format = "#v"
					block "site_inbound_ours" {}
				}
				textbox = {
					parentanchor = vcenter
					autoresize = yes
					max_width = 46
					align = left|nobaseline
					using = fontsize_small
					elide = right
					block "site_inbound_rival" {}
				}
			}
		}
		button = {
			using = default_button_action
			size = { 60 24 }
			parentanchor = vcenter
			block "site_target_button" {}

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 56
				elide = right
				using = fontsize_small
				text = "je_space_race_widget_ss_target_button"
				block "site_target_set_visible" {}
			}
			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 56
				elide = right
				using = fontsize_small
				text = "je_space_race_widget_ss_target_clear"
				block "site_target_clear_visible" {}
			}
		}
	}

	### Solar System (solar colonization only): every world, under its
	### location (the owner's nine, less Earth and the Moon), with who holds it
	### (design § 9). Rows in gen_solar_sites.panel_order(), written from the
	### table and held to it by test_solar_sites.py. Closed by default (43
	### lines): the flag is sr_panel_solar_system_open, client-side like the
	### rest, so a fresh client shows the header only.
	type te_sr_sec_solar_system = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_solar_system_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_solar_system_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('sr_panel_solar_system_open')]"
			}
		}

		te_sr_panel = {
			visible = "[GetVariableSystem.Exists('sr_panel_solar_system_open')]"

			te_sr_note = {
				text = "je_space_race_widget_solar_system_note"
			}

			### Every world under its location, generated from the site table
			### (gui/journal_entry_widgets/sr_sites_generated_rows.gui).
			te_sr_solar_system_rows = {}
		}
	}

	### One fleet slot in Colony Fleets: the colonization entry's icon, the world
	### it is bound for (sr_cf_slot_<n>_name, generated custom loc) and when it
	### lands. 24 + 180 + 236 + 2 × 4 spacing + 2 × 4 margin = 456. Instances in
	### te_sr_cf_slot_rows (sr_sites_generated_rows.gui), one per slot.
	type te_sr_cf_slot_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "slot_visible" {}

		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			icon = {
				size = { 24 24 }
				parentanchor = center
				texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
			}
		}
		widget = {
			size = { 180 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 180
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				block "slot_name" {}
			}
		}
		widget = {
			size = { 236 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 236
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				block "slot_eta" {}
			}
		}
	}

	### Colony Fleets (solar colonization; slices 2-3 design §§ 3, 8): where our
	### next colony fleet goes (our target, or the programme's own pick), the
	### drive it flies on, and under simple and full colonies our fleets in
	### flight, one row per slot. Open by default; the flag is
	### sr_panel_fleets_closed.
	type te_sr_sec_colony_fleets = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_fleets_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_fleets_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_fleets_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_fleets_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_fleets_closed'))]"

			te_sr_note = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)1' )]"
				text = "je_space_race_widget_cf_destination_target"
			}
			te_sr_note = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)0' ) )]"
				text = "je_space_race_widget_cf_destination_auto"
			}
			te_sr_note = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ) )]"
				text = "je_space_race_widget_cf_destination_auto_contested"
			}
			te_sr_note = {
				tooltip = "je_space_race_widget_cf_drive_tt"
				text = "je_space_race_widget_cf_drive_line"
			}
			te_sr_value_row = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
				blockoverride "label_format" {}
				blockoverride "row_label" {
					text = "je_space_race_widget_cf_in_flight_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_cf_in_flight_figure"
				}
			}
			te_sr_cf_slot_rows = {}
			te_sr_note = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_cf_races_only_note"
			}
		}
	}

	### One colony we hold in Settlers: its icon and name, its people and room
	### (K figures: "12.5K / 40K"), the module levels its people can crew (AGI
	### under Artificial General Intelligence), and its priority, a button that
	### steps it (sr_colony_priority_sgui, scope:site = the world's index).
	### 24 + 180 + 110 + 40 + 70 + 4 × 4 spacing + 2 × 4 margin = 448.
