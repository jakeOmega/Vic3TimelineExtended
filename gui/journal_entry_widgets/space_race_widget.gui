			te_sr_fl_button = {
				blockoverride "fl_btn" {
					block "fl_embark_button" {}
				}
				blockoverride "fl_btn_label" {
					text = "je_space_race_widget_fl_embark"
				}
			}
		}
		### Posture and target (6b), at a location other than Earth.
