	### One location in a fleet's destination popup: its name, the leg's months
	### and delta-v at the fleet's pace (red when the fleet carries less), from
	### Earth the launch window toward it (Next Windows' "Open now" and "In N
	### months"; blank for other legs: a closed window only raises the delta-v,
	### UI pass design § 4), our worlds there, the strength there and on its way
	### of countries at war with us, and Choose, greyed with the reason where
	### the fleet can't choose; the destination already chosen reads Chosen in
	### vanilla's selected-tab look (the Strategic Reserve's policy choice).
	### Picking closes the popup; Go on the fleet's row sends it. 146 + 60 + 60 +
	### 116 + 44 + 56 + 66 + 72 + 7 × 4 + 2 × 4 = 656.
	type te_sr_dest_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "dr_visible" {}

		widget = {
			size = { 146 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 146
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "dr_name" {}
			}
		}
		widget = {
			size = { 60 24 }
