	### Solar System (solar colonization only): the worlds under their locations
	### (the owner's nine, less Earth and the Moon), with who holds them (design
	### § 9). Open by default, directly under Colony Fleets (audit SPC-7: Target
	### beside the destination it sets), and filtered by default to the worlds
	### that matter now: those our next colony fleet can go to, ours and any a
	### fleet is bound for (sr_disp_ss_filtered_<location>), with "Show all 40"
	### beside the count. Rows in gen_solar_sites.panel_order(), written from the
	### table and held to it by test_solar_sites.py. The flags are
	### sr_panel_solar_system_closed and sr_panel_solar_system_all_open,
	### client-side like the rest.
	type te_sr_sec_solar_system = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_solar_system_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_solar_system_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_solar_system_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_closed'))]"

			### How many worlds the list shows, and the toggle that shows every one.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				margin = { 4 1 }

				### The count reads the player: SelectLocalization renders its key
				### without the journal entry (gotcha #16).
				textbox = {
					autoresize = yes
					minimumsize = { 352 -1 }
					maximumsize = { 352 -1 }
					parentanchor = vcenter
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "[SelectLocalization( GetVariableSystem.Exists('sr_panel_solar_system_all_open'), 'je_space_race_widget_ss_all', 'je_space_race_widget_ss_filtered' )]"
				}
				button = {
					using = default_button
					size = { 116 26 }
					parentanchor = vcenter
					onclick = "[GetVariableSystem.Toggle('sr_panel_solar_system_all_open')]"
					tooltip = "je_space_race_widget_ss_toggle_tt"

					textbox = {
						parentanchor = center
						align = center|nobaseline
						autoresize = yes
						max_width = 110
						elide = right
						using = te_sr_fontsize_row
						text = "je_space_race_widget_ss_show_all"
						visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_all_open'))]"
					}
					textbox = {
						parentanchor = center
						align = center|nobaseline
						autoresize = yes
						max_width = 110
						elide = right
						using = te_sr_fontsize_row
						text = "je_space_race_widget_ss_show_fewer"
						visible = "[GetVariableSystem.Exists('sr_panel_solar_system_all_open')]"
					}
				}
			}

			### Every world under its location, generated from the site table
			### (gui/journal_entry_widgets/sr_sites_generated_rows.gui).
			te_sr_solar_system_rows = {}
		}
	}

	### One fleet slot in Colony Fleets: the colonization entry's icon, the world
	### it is bound for (sr_cf_slot_<n>_name, generated custom loc) and when it
	### lands. 24 + 180 + 236 + 2 × 4 spacing + 2 × 4 margin = 456. Instances in
	### te_sr_cf_slot_rows (sr_sites_generated_rows.gui), one per slot.
