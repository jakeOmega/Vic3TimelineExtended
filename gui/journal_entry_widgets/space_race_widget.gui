					ignoreinvisible = yes
					block "fl_refit_visible" {}

					background = {
						using = entry_bg_fancy_dark
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 60
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						default_format = "#tooltippable"
						text = "je_space_race_widget_fl_refit"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 18
						align = left|nobaseline
						using = te_sr_fontsize_row
						default_format = "#v"
						block "fl_refit" {}
					}
				}
			}
			widget = {
				size = { 48 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_dv_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 48
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					default_format = "#tooltippable"
					block "fl_dv" {}
				}
			}
			widget = {
				size = { 58 24 }
