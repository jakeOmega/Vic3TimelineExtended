	### One stance on a fleet's page in the Fleets window (design § 5.1): its
	### word, two to the line beside the caption (104 + 4 + 2 × 180 + 4 = 472).
	### The button while the stance isn't the fleet's; the stance in force in
	### vanilla's selected-tab look, as te_sr_posture_choice's, with its own
	### hover (what the stance does).
	type te_sr_stance_choice = widget {
		size = { 180 26 }
		parentanchor = vcenter

		button = {
			using = default_button_action
			size = { 100% 100% }
			block "sc_shown" {}
			block "sc_action" {}

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 172
				elide = right
				using = te_sr_fontsize_row
				block "sc_label" {}
			}
		}
		icon = {
			using = selected_tabs
			size = { 100% 100% }
			block "sc_selected" {}
			block "sc_held_tooltip" {}

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 172
				elide = right
				using = te_sr_fontsize_row
				default_format = "#variable"
				block "sc_label" {}
			}
		}
	}

	### One posture button on a fleet's card (UI pass design § 7; the fleet
	### cards, owner 2026-11-14): its icon over its word, four to the line
	### (4 × 114 + 3 × 4 = 468). The button while its posture isn't the
	### fleet's, greyed with the reason where the fleet can't take it; the
	### posture in force in vanilla's selected-tab look (the Strategic
	### Reserve's policy choice), not a greyed button that reads as
	### unavailable, with its own hover (pc_held_tooltip: what the posture
	### does), as the Strategic Reserve's choice has. A fleet's page in the
	### Fleets window sets them beside a caption, at 90 with the word in 86
	### (pc_size, pc_label_width).
	type te_sr_posture_choice = widget {
		block "pc_size" {
			size = { 114 46 }
		}
		parentanchor = vcenter

		button = {
			using = default_button_action
			size = { 100% 100% }
			block "pc_shown" {}
			block "pc_action" {}

			icon = {
				size = { 20 20 }
				position = { 0 3 }
				parentanchor = top|hcenter
				block "pc_icon" {}
			}
			textbox = {
				position = { 0 23 }
				parentanchor = top|hcenter
				align = center|nobaseline
				autoresize = yes
				block "pc_label_width" {
					max_width = 100
				}
				elide = right
				using = te_sr_fontsize_row
				block "pc_label" {}
			}
		}
		icon = {
			using = selected_tabs
			size = { 100% 100% }
			block "pc_selected" {}
			block "pc_held_tooltip" {}

			icon = {
				size = { 20 20 }
				position = { 0 3 }
				parentanchor = top|hcenter
				block "pc_icon" {}
			}
			textbox = {
				position = { 0 23 }
				parentanchor = top|hcenter
				align = center|nobaseline
				autoresize = yes
				block "pc_label_width" {
					max_width = 100
				}
				elide = right
				using = te_sr_fontsize_row
				default_format = "#variable"
				block "pc_label" {}
			}
		}
	}

	### One ship role on a fleet's card: its icon, lit while the fleet has
	### ships of the role and dimmed while it has none (style guide rule 4),
	### how many beside it, and its word beneath. The hover is the fleet's
	### ships, each role of its full number (rule 2). Five to the line:
	### 5 × 90 + 4 × 4 = 466.
