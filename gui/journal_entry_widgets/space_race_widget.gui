			text = "je_space_race_widget_howc_fleets"
		}
		te_sr_subheader = {
			blockoverride "subheader_text" {
				text = "je_space_race_widget_howc_sub_windows"
			}
		}
		te_sr_note = {
			text = "je_space_race_widget_howc_windows"
		}
		te_sr_subheader = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
			blockoverride "subheader_text" {
				text = "je_space_race_widget_howc_sub_settlers"
			}
		}
		te_sr_note = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
			text = "je_space_race_widget_howc_settlers"
		}
		te_sr_subheader = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
			blockoverride "subheader_text" {
				text = "je_space_race_widget_howc_sub_modules"
			}
		}
		te_sr_note = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
			text = "je_space_race_widget_howc_modules"
		}
		### Extraplanetary Bases (ground types design § 9.6): the grade, a line per
		### ground type, and the Bases view's checkbox in a sentence.
		te_sr_subheader = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
			blockoverride "subheader_text" {
				text = "je_space_race_widget_howc_sub_bases"
			}
		}
		te_sr_note = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
