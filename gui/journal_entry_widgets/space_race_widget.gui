		icon = {
			size = { 24 24 }
			position = { 8 1 }
			alpha = 0.3
			block "rc_icon" {}
			block "rc_dim" {}
		}
		textbox = {
			position = { 36 3 }
			autoresize = yes
			max_width = 50
			elide = right
			align = left|nobaseline
			using = te_sr_fontsize_row
			default_format = "#v"
			block "rc_count" {}
