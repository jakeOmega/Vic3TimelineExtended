	### Settlers (solar colonization, simple and full colonies; slices 2-3
	### design § 10): the emigration programme (sr_settlers_sgui: op 0 down,
	### op 1 up), the emigrants it sends, the nation's people off Earth and
	### their bonus, crews, then every colony we hold. Open by default; the
	### flag is sr_panel_settlers_closed.
	type te_sr_sec_settlers = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[And( JournalEntry.IsActive, EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ) )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_settlers_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_settlers_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_settlers_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_settlers_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_settlers_closed'))]"

			te_sr_note = {
				text = "je_space_race_widget_settlers_note"
			}

			### The programme: op 0 down, op 1 up, beside the level, as funding is.
			flowcontainer = {
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes
				margin = { 4 1 }

				textbox = {
					text = "je_space_race_widget_emig_label"
					size = { 110 26 }
					align = left|nobaseline
					using = fontsize_medium
					parentanchor = vcenter
					elide = right
				}

				button_icon_minus_action = {
					size = { 26 26 }
					parentanchor = vcenter
					enabled = "[GetScriptedGui('sr_settlers_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					onclick = "[GetScriptedGui('sr_settlers_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
					tooltip = "[Concatenate( GetScriptedGui('sr_settlers_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_settlers_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
				}

				widget = {
					size = { 84 26 }
					parentanchor = vcenter

					textbox = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)0' )]"
						text = "je_space_race_widget_emig_level_0"
						size = { 84 26 }
