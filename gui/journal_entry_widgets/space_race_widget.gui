	### solar_colonization: the overview, wrapped by the journal root
	### widget_je_space_race_solar_colonization_overview.
	type te_sr_solar_colonization_overview = flowcontainer {
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		datacontext = "[GetScriptedGui('sr_milestone_solar_colonization_sgui')]"

		te_sr_overview_milestone = {
			blockoverride "sr_status_standard" {
				visible = "[LessThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_status_solar_colonization'), '(CFixedPoint)1' )]"
			}
			blockoverride "sr_status_safe" {
				visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_status_solar_colonization'), '(CFixedPoint)2' )]"
			}
			blockoverride "sr_status_ambitious" {
				visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_status_solar_colonization'), '(CFixedPoint)3' )]"
			}
			blockoverride "sr_risk_lit" {
				visible = "[NotEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_risk_shown_solar_colonization'), '(CFixedPoint)0' )]"
			}
			blockoverride "sr_risk_unlit" {
				visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_risk_shown_solar_colonization'), '(CFixedPoint)0' )]"
			}
			blockoverride "sr_risk_label" {
				text = "je_space_race_widget_risk_solar_colonization"
			}
			blockoverride "sr_label_safe" {
				text = "je_space_race_widget_ov_safe_solar_colonization"
			}
			blockoverride "sr_label_ambitious" {
				text = "je_space_race_widget_ov_ambitious_solar_colonization"
			}
			# The stage, whose tooltip is the stage's description (the first lunar
			# colony's race for the first is on the reward hover and the Program
			# row's Lunar Colony icon).
			# Stage 0 (and a race not yet begun) reads "the Moon". The stage is the
			# world's (global_var:sr_colonization_stage), so both keys read it on
			# Country, the same for every country.
			blockoverride "sr_third_cells" {
				te_sr_ov_icon_label = {
					tooltip = "[SelectLocalization( Country.IsLocalPlayer, 'je_space_race_widget_profile_solar_colonization', 'je_space_race_widget_profile_solar_colonization_ni' )]"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/space_race_icons/stage.dds"
					}
					blockoverride "label" {
						text = "[SelectLocalization( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_current_colonization_stage'), '(CFixedPoint)1' ), 'je_space_race_widget_ov_stage', 'je_space_race_widget_ov_stage_moon' )]"
					}
				}
			}
			blockoverride "sr_progress_label" {
				text = "je_space_race_widget_ov_colony_label"
			}
			# Fleets staged in orbit while a full bar waits for a launch window
			# (gui/sr_launch_window_widgets.gui), then the 40 worlds: every one
			# claimed, ours on top; then what needs us.
			blockoverride "sr_extra_rows" {
				# Staged in Orbit is the player's own: progress past the goal, the
				# exact progress another country's band stands for. Its gate here,
				# with Country.IsLocalPlayer, so another country's column keeps no
				# empty row.
				flowcontainer = {
					visible = "[And( Country.IsLocalPlayer, GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('sr_launch_staged_shown'), '(CFixedPoint)0' ) )]"
					direction = vertical
					parentanchor = hcenter
					ignoreinvisible = yes

					te_sr_ov_staged = {
						using = te_own_country_only
					}
				}
				te_sr_ov_pie = {
					parentanchor = hcenter
					tooltip = "je_space_race_widget_ov_worlds_tt"
					blockoverride "pie_claimed" {
						value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('sr_disp_worlds_claimed_frac') )]"
					}
					blockoverride "pie_ours" {
						value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('sr_disp_worlds_ours_frac') )]"
					}
					blockoverride "pie_label" {
						text = "je_space_race_widget_ov_worlds"
					}
				}
				# What needs us (audit SPC-6; Simple and Full Colonies): Banking's
				# cells, two to a row. Colonies names a colony demanding self-rule,
				# Defense (Full Colonies) the worst threat to ours, Modules an idle
				# queue, Next Window the stage's next one; each hover lists the rest.
				# The player's own (National Info shows another country none of
				# it): what the colonies, their defense, the module queue and the
				# next window ask of us. The outer gate repeats Country.IsLocalPlayer
				# so another country's column keeps no empty row.
				flowcontainer = {
					visible = "[And( Country.IsLocalPlayer, EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ) )]"
					direction = vertical
					ignoreinvisible = yes
					parentanchor = hcenter

					flowcontainer = {
						using = te_own_country_only
						direction = vertical
						ignoreinvisible = yes
						spacing = 4
						parentanchor = hcenter

						flowcontainer = {
							direction = horizontal
							ignoreinvisible = yes
							spacing = 4
							parentanchor = hcenter

							te_banking_ov_cell = {
								tooltip = "je_space_race_widget_ovc_colonies_tt"
								blockoverride "caption" {
									text = "je_space_race_widget_ovc_colonies_cap"
								}
								blockoverride "icons" {
									icon = {
										size = { 100% 100% }
										texture = "gfx/interface/icons/space_race_icons/colony_mars.dds"
									}
								}
								blockoverride "word" {
									te_banking_ov_word = {
										visible = "[GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' )]"
										text = "je_space_race_widget_ovc_colonies_word_restless"
									}
									te_banking_ov_word = {
										visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_colonies_word_calm"
									}
								}
								blockoverride "third_line" {
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_colonies_fig_one"
									}
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)2' )]"
										text = "je_space_race_widget_ovc_colonies_fig_more"
									}
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_colonies_fig_calm"
									}
								}
							}
							te_banking_ov_cell = {
								visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' )]"
								tooltip = "je_space_race_widget_ovc_defense_tt"
								blockoverride "caption" {
									text = "je_space_race_widget_ovc_defense_cap"
								}
								blockoverride "icons" {
									icon = {
										size = { 100% 100% }
										texture = "gfx/interface/icons/space_race_icons/warship.dds"
									}
								}
								blockoverride "word" {
									te_banking_ov_word = {
										text = "je_space_race_widget_ovc_defense_word"
									}
								}
								blockoverride "third_line" {
									te_banking_ov_word = {
										position = { 78 46 }
										text = "je_space_race_widget_ovc_defense_fig"
									}
								}
							}
						}
						flowcontainer = {
							direction = horizontal
							ignoreinvisible = yes
							spacing = 4
							parentanchor = hcenter

							te_banking_ov_cell = {
								tooltip = "je_space_race_widget_ovc_modules_tt"
								blockoverride "caption" {
									text = "je_space_race_widget_ovc_modules_cap"
								}
								blockoverride "icons" {
									icon = {
										size = { 100% 100% }
										texture = "gfx/interface/icons/space_race_icons/module.dds"
									}
								}
								blockoverride "word" {
									te_banking_ov_word = {
										visible = "[GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_mq_count'), '(CFixedPoint)1' )]"
										text = "je_space_race_widget_ovc_modules_word_queued"
									}
									te_banking_ov_word = {
										visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_mq_count'), '(CFixedPoint)1' ) ), GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_fab_stock'), Country.MakeScope.ScriptValue('sr_mod_fab_stock_cap') ) )]"
										text = "je_space_race_widget_ovc_modules_word_idle"
									}
									te_banking_ov_word = {
										visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_mq_count'), '(CFixedPoint)1' ) ), Not( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_fab_stock'), Country.MakeScope.ScriptValue('sr_mod_fab_stock_cap') ) ) )]"
										text = "je_space_race_widget_ovc_modules_word_empty"
									}
								}
								blockoverride "third_line" {
									te_banking_ov_word = {
										position = { 78 46 }
										text = "je_space_race_widget_ovc_modules_fig"
									}
								}
							}
							te_banking_ov_cell = {
								tooltip = "je_space_race_widget_ovc_window_tt"
								blockoverride "caption" {
									text = "je_space_race_widget_ovc_window_cap"
								}
								blockoverride "icons" {
									icon = {
										size = { 100% 100% }
										texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
									}
								}
								blockoverride "word" {
									te_banking_ov_word = {
										visible = "[Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_window_disp_apply'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_window_word_any"
									}
									te_banking_ov_word = {
										visible = "[And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_window_disp_apply'), '(CFixedPoint)1' ), GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_window_disp_next'), '(CFixedPoint)999' ) )]"
										text = "je_space_race_widget_ovc_window_word_none"
									}
									te_banking_ov_word = {
										visible = "[And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_window_disp_apply'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_window_disp_next'), '(CFixedPoint)0' ) )]"
										text = "je_space_race_widget_ovc_window_word_open"
									}
									te_banking_ov_word = {
										visible = "[And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_window_disp_apply'), '(CFixedPoint)1' ), And( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_window_disp_next'), '(CFixedPoint)1' ), Not( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_window_disp_next'), '(CFixedPoint)999' ) ) ) )]"
										text = "je_space_race_widget_ovc_window_word_in"
									}
								}
								blockoverride "third_line" {
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_current_colonization_stage'), '(CFixedPoint)1' ), Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_held_beyond_moon'), '(CFixedPoint)1' ) ) )]"
										text = "je_space_race_widget_ovc_window_fig"
									}
									# The Moon full and no Mars Landing: why the bar holds.
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[And( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_current_colonization_stage'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_held_beyond_moon'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_window_fig_mars"
									}
									# Stage 0 is the Moon, which needs no window.
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_current_colonization_stage'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_window_fig_moon"
									}
								}
							}
						}
						### Crews (colony people design § 10): shown while any colony of ours
						### is short of crews, how many, its hover what that costs and the cure.
						flowcontainer = {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_understaffed_count'), '(CFixedPoint)1' )]"
							direction = horizontal
							ignoreinvisible = yes
							spacing = 4
							parentanchor = hcenter

							te_banking_ov_cell = {
								tooltip = "je_space_race_widget_ovc_crews_tt"
								blockoverride "caption" {
									text = "je_space_race_widget_ovc_crews_cap"
								}
								blockoverride "icons" {
									icon = {
										size = { 100% 100% }
										texture = "gfx/interface/icons/space_race_icons/page_crews.dds"
									}
								}
								blockoverride "word" {
									te_banking_ov_word = {
										text = "je_space_race_widget_ovc_crews_word"
									}
								}
								blockoverride "third_line" {
									te_banking_ov_word = {
										position = { 78 46 }
										text = "je_space_race_widget_ovc_crews_fig"
									}
								}
							}
						}
						### Base Room (UI pass design § 8, the parallel to Seabed's Long-haul):
						### our Extraplanetary Base levels, built and queued, against our room
						### ("120 +20 / 400", or "140 / 400" once the figures run too long for the
						### word to show them apart), red once they pass it; where the next level goes
						### (§ 9.3), or -75% past the room; on hover that site's figures. Shown once
						### the building is ours to build. Levels, queue and room are read live; the
						### grades come from the monthly refresh and the one when a base is built
						### (space_race_events.110).
						### The row also holds the Resort Room cell (#1948) and the Earth alert's
						### Hostile Fleet cell (§ 9), so it shows while any of them does.
						flowcontainer = {
							visible = "[Or( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' ), Or( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_shown'), '(CFixedPoint)1' ), And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_earth_hostile'), '(CFixedPoint)1' ) ) ) )]"
							direction = horizontal
							ignoreinvisible = yes
							spacing = 4
							parentanchor = hcenter

							te_banking_ov_cell = {
								visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_shown'), '(CFixedPoint)1' )]"
								tooltip = "je_space_race_widget_ovc_ebase_tt"
								blockoverride "caption" {
									text = "je_space_race_widget_ovc_ebase_cap"
								}
								blockoverride "icons" {
									icon = {
										size = { 100% 100% }
										texture = "gfx/interface/icons/building_icons/building_space_mine.dds"
									}
								}
								blockoverride "word" {
									# Built and queued levels against the room: apart while they fit
									# (sr_disp_ebase_split), their sum when not; red past the room.
									te_banking_ov_word = {
										visible = "[And( Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_past'), '(CFixedPoint)1' ) ), Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_split'), '(CFixedPoint)1' ) ) )]"
										text = "je_space_race_widget_ovc_ebase_word"
									}
									te_banking_ov_word = {
										visible = "[And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_past'), '(CFixedPoint)1' ), Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_split'), '(CFixedPoint)1' ) ) )]"
										text = "je_space_race_widget_ovc_ebase_word_past"
									}
									te_banking_ov_word = {
										visible = "[And( Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_past'), '(CFixedPoint)1' ) ), EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_split'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_ebase_word_split"
									}
									te_banking_ov_word = {
										visible = "[And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_past'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_split'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_ebase_word_split_past"
									}
								}
								blockoverride "third_line" {
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_next_past'), '(CFixedPoint)1' )]"
										text = "je_space_race_widget_ovc_ebase_fig_past"
									}
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_ebase_next_past'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_ebase_fig"
									}
								}
							}
							# Resort Room (#1948 design § 9): the twin of Base Room for the Resort
							# Colony, built and queued levels against its room, red past it, and the
							# draw the next level would work at. Shown with Space Colonization.
							te_banking_ov_cell = {
								visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_shown'), '(CFixedPoint)1' )]"
								tooltip = "je_space_race_widget_ovc_resort_tt"
								blockoverride "caption" {
									text = "je_space_race_widget_ovc_resort_cap"
								}
								blockoverride "icons" {
									icon = {
										size = { 100% 100% }
										texture = "gfx/interface/icons/building_icons/building_tourism_industry.dds"
									}
								}
								blockoverride "word" {
									# Built and queued levels against the room: apart while they fit
									# (sr_disp_resort_split), their sum when not; red past the room.
									te_banking_ov_word = {
										visible = "[And( Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_past'), '(CFixedPoint)1' ) ), Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_split'), '(CFixedPoint)1' ) ) )]"
										text = "je_space_race_widget_ovc_resort_word"
									}
									te_banking_ov_word = {
										visible = "[And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_past'), '(CFixedPoint)1' ), Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_split'), '(CFixedPoint)1' ) ) )]"
										text = "je_space_race_widget_ovc_resort_word_past"
									}
									te_banking_ov_word = {
										visible = "[And( Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_past'), '(CFixedPoint)1' ) ), EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_split'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_resort_word_split"
									}
									te_banking_ov_word = {
										visible = "[And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_past'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_split'), '(CFixedPoint)1' ) )]"
										text = "je_space_race_widget_ovc_resort_word_split_past"
									}
								}
								blockoverride "third_line" {
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_next_draw'), '(CFixedPoint)0' )]"
										text = "je_space_race_widget_ovc_resort_fig_plus"
									}
									te_banking_ov_word = {
										position = { 78 46 }
										visible = "[Not( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_resort_next_draw'), '(CFixedPoint)0' ) )]"
										text = "je_space_race_widget_ovc_resort_fig"
									}
								}
							}
							# The Earth alert (UI pass design § 9; Full Colonies): while a fleet
							# of a power at war with us is bound for Earth, when the first
							# lands and its strength against ours there; red while a landing
							# would tip the balance at Earth (sr_earth_alert_loud).
							te_banking_ov_cell = {
								visible = "[And( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_earth_hostile'), '(CFixedPoint)1' ) )]"
								tooltip = "je_space_race_widget_ovc_earth_tt"
								blockoverride "caption" {
									text = "je_space_race_widget_ovc_earth_cap"
								}
								blockoverride "icons" {
									icon = {
										size = { 100% 100% }
										texture = "gfx/interface/icons/space_race_icons/warship.dds"
									}
								}
								blockoverride "word" {
									te_banking_ov_word = {
										visible = "[Not( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_earth_hostile'), '(CFixedPoint)2' ) )]"
										text = "je_space_race_widget_ovc_earth_word"
									}
									te_banking_ov_word = {
										visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_earth_hostile'), '(CFixedPoint)2' )]"
										text = "je_space_race_widget_ovc_earth_word_loud"
									}
								}
								blockoverride "third_line" {
									te_banking_ov_word = {
										position = { 78 46 }
										text = "je_space_race_widget_ovc_earth_fig"
									}
								}
							}
						}
					}
				}
			}
			blockoverride "sr_progress_value" {
				value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('sr_disp_progress_frac_solar_colonization') )]"
			}
			# Another country's estimate (te_sr_ov_band_row): the country as
			# its own viewer and rival, so the open band.
			blockoverride "sr_band_lo" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( Country.MakeScope ).AddScope( 'sr_rival', Country.MakeScope ).ScriptValue('sr_disp_rival_lo_solar_colonization') )]"
			}
			blockoverride "sr_band_hi" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( Country.MakeScope ).AddScope( 'sr_rival', Country.MakeScope ).ScriptValue('sr_disp_rival_hi_solar_colonization') )]"
			}
			blockoverride "sr_band_est" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( Country.MakeScope ).AddScope( 'sr_rival', Country.MakeScope ).ScriptValue('sr_disp_rival_est_solar_colonization') )]"
			}
			blockoverride "sr_band_text" {
				text = "je_space_race_widget_band_solar_colonization"
			}
			blockoverride "sr_progress_text" {
				text = "je_space_race_widget_progress_solar_colonization"
			}
			blockoverride "sr_progress_tooltip" {
				tooltip = "[SelectLocalization( Country.IsLocalPlayer, 'je_space_race_widget_reward_solar_colonization', 'te_tt_blank' )]"
			}
		}
	}

	### solar_colonization: the live sections, wrapped by the journal root
	### widget_je_space_race_solar_colonization: the tab buttons over the four
	### tabs' parts (te_sr_solar_colonization_<tab>, below), one shown at a
	### time. The Timeline Extended window's full screen lays the parts out
	### side by side instead, with no buttons (te_sr_wide_sections).
	type te_sr_solar_colonization_status = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		datacontext = "[GetScriptedGui('sr_milestone_solar_colonization_sgui')]"

		# The tabs (UI pass design § 11): the client-side sr_tab, absent for
		# Mission Control (the default), else fleets, colonies or system; Set and
		# Clear, as the colony views' sr_colony_view, so a tab is remembered for
		# the session in both hosts. 500 wide (te_sr_tab_button).
		flowcontainer = {
			direction = horizontal
			parentanchor = hcenter
			spacing = 4
			visible = "[JournalEntry.IsActive]"

			te_sr_tab_button_wide = {
				tooltip = "je_space_race_widget_tab_mission_tt"
				blockoverride "tab_button" {
					enabled = "[GetVariableSystem.Exists('sr_tab')]"
					onclick = "[GetVariableSystem.Clear('sr_tab')]"
				}
				blockoverride "tab_label" {
					text = "je_space_race_widget_tab_mission"
				}
			}
			te_sr_tab_button = {
				tooltip = "je_space_race_widget_tab_fleets_tt"
				blockoverride "tab_button" {
					enabled = "[Not( GetVariableSystem.HasValue('sr_tab', 'fleets') )]"
					onclick = "[GetVariableSystem.Set('sr_tab', 'fleets')]"
				}
				blockoverride "tab_label" {
					text = "je_space_race_widget_tab_fleets"
				}
			}
			te_sr_tab_button = {
				tooltip = "je_space_race_widget_tab_colonies_tt"
				blockoverride "tab_button" {
					enabled = "[Not( GetVariableSystem.HasValue('sr_tab', 'colonies') )]"
					onclick = "[GetVariableSystem.Set('sr_tab', 'colonies')]"
				}
				blockoverride "tab_label" {
					text = "je_space_race_widget_tab_colonies"
				}
			}
			te_sr_tab_button_wide = {
				tooltip = "je_space_race_widget_tab_system_tt"
				blockoverride "tab_button" {
					enabled = "[Not( GetVariableSystem.HasValue('sr_tab', 'system') )]"
					onclick = "[GetVariableSystem.Set('sr_tab', 'system')]"
				}
				blockoverride "tab_label" {
					text = "je_space_race_widget_tab_system"
				}
			}
		}

		# Mission Control: approach, funding, setbacks, launch windows, Rivals.
		# Its debris row in the status's own block, sr_debris, which the
		# window's hosts empty (Orbit shows it once), passed on to the part's.
		te_sr_solar_colonization_mission = {
			visible = "[Not( GetVariableSystem.Exists('sr_tab') )]"
			blockoverride "sr_mission_debris" {
				block "sr_debris" {
					te_sr_debris_row = {}
				}
			}
		}

		# Fleets: Colony Fleets, then under Full Colonies Space Command and Space
		# Fleets.
		te_sr_solar_colonization_fleets = {
			visible = "[GetVariableSystem.HasValue('sr_tab', 'fleets')]"
		}

		# Colonies.
		te_sr_solar_colonization_colonies = {
			visible = "[GetVariableSystem.HasValue('sr_tab', 'colonies')]"
		}

		# Solar System: the worlds.
		te_sr_solar_colonization_system = {
			visible = "[GetVariableSystem.HasValue('sr_tab', 'system')]"
		}
	}

	### solar_colonization's Mission Control: approach, funding, setbacks, launch
	### windows, the profile, Rivals. The debris row is in sr_mission_debris,
	### which the status relays as its sr_debris and full screen empties.
	type te_sr_solar_colonization_mission = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		datacontext = "[GetScriptedGui('sr_milestone_solar_colonization_sgui')]"

		te_sr_status_sections = {
			blockoverride "status_debris" {
				block "sr_mission_debris" {
					te_sr_debris_row = {}
				}
			}
			blockoverride "sr_control_onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_control_solar_colonization_closed')]"
			}
			blockoverride "sr_control_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_control_solar_colonization_closed')]"
			}
			blockoverride "sr_control_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_control_solar_colonization_closed'))]"
			}
			blockoverride "sr_control_visible" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_control_solar_colonization_closed'))]"
			}
			blockoverride "sr_funding_value" {
				text = "[SelectLocalization( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_funding_solar_colonization_past_cap'), '(CFixedPoint)0' ), 'je_space_race_widget_funding_past_cap_solar_colonization', 'je_space_race_widget_funding_solar_colonization' )]"
			}
			blockoverride "sr_setbacks_value" {
				text = "je_space_race_widget_setbacks_solar_colonization"
			}
			blockoverride "sr_eta_value" {
				text = "je_space_race_widget_eta_solar_colonization"
			}
			blockoverride "sr_profile_text" {
				text = "je_space_race_widget_profile_solar_colonization"
			}
			# Launch windows (gui/sr_launch_window_widgets.gui).
			blockoverride "sr_control_extra" {
				te_sr_sec_windows = {}
			}
			blockoverride "sr_rivals_onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_rivals_solar_colonization_closed')]"
			}
			blockoverride "sr_rivals_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_rivals_solar_colonization_closed')]"
			}
			blockoverride "sr_rivals_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_rivals_solar_colonization_closed'))]"
			}
			blockoverride "sr_rivals_visible" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_rivals_solar_colonization_closed'))]"
			}
			blockoverride "sr_rivals_none" {
				visible = "[IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('sr_rivals_list_solar_colonization') )]"
			}
			blockoverride "sr_rivals_datamodel" {
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('sr_rivals_list_solar_colonization')]"
			}
			blockoverride "sr_rival_tooltip" {
				tooltip = "je_space_race_widget_rival_tt_solar_colonization"
			}
			blockoverride "sr_rival_lo" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'sr_rival', State.GetCountry.MakeScope ).ScriptValue('sr_disp_rival_lo_solar_colonization') )]"
			}
			blockoverride "sr_rival_hi" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'sr_rival', State.GetCountry.MakeScope ).ScriptValue('sr_disp_rival_hi_solar_colonization') )]"
			}
			blockoverride "sr_rival_est" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'sr_rival', State.GetCountry.MakeScope ).ScriptValue('sr_disp_rival_est_solar_colonization') )]"
			}
			blockoverride "sr_rival_range" {
				text = "je_space_race_widget_rival_range_solar_colonization"
			}
		}
	}

	### solar_colonization's Fleets: Colony Fleets, then under Full Colonies
	### Space Command and Space Fleets.
	type te_sr_solar_colonization_fleets = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		datacontext = "[GetScriptedGui('sr_milestone_solar_colonization_sgui')]"

		te_sr_sec_colony_fleets = {}
		te_sr_sec_space_command = {}
		te_sr_sec_space_fleets = {}
	}

	### solar_colonization's Colonies.
	type te_sr_solar_colonization_colonies = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		datacontext = "[GetScriptedGui('sr_milestone_solar_colonization_sgui')]"

		te_sr_sec_colonies = {}
	}

	### solar_colonization's Solar System: the map and the worlds.
	type te_sr_solar_colonization_system = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		datacontext = "[GetScriptedGui('sr_milestone_solar_colonization_sgui')]"

		te_sr_sec_solar_system = {}
	}

}

### ==========================================================================
### JOURNAL ENTRY ROOTS (je_space_race.txt). Thin wrappers that repeat the
### composers' IsActive gate, so an inactive entry's containers collapse, around
### the milestone's own types above (te_sr_<m>_overview, te_sr_<m>_status),
### which set its scripted GUI as the datacontext and pass its data. Per
### milestone: the overview (custom_widget_container_1) and the live sections
### (custom_widget_container_2); the waiting entry has an overview only.
### ==========================================================================

### suborbital

flowcontainer = {
	name = "widget_je_space_race_suborbital_overview"
	visible = "[JournalEntry.IsActive]"
	direction = vertical
	parentanchor = hcenter
	minimumsize = { 520 -1 }
	ignoreinvisible = yes

	### The "?" to the Help page, at the top of the entry (te_help_row).
	te_help_row = {
		blockoverride "help_onclick" {
			onclick = "[GetVariableSystem.Set('te_popup', 'help_space_race')]"
		}
	}

	te_je_country = {
		te_sr_suborbital_overview = {}
	}
}

flowcontainer = {
	name = "widget_je_space_race_suborbital"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	minimumsize = { 520 -1 }
	ignoreinvisible = yes

	te_je_country = {
		te_sr_suborbital_status = {}
	}
}

