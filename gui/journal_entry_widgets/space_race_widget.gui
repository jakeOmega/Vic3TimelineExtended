	### One colony we hold: its specialization's name, and on hover what it does
	### (GetStaticModifier('<modifier>').GetDesc in the tooltip key, never a typed
	### number). The instance sets when the row shows, on one equality test of
	### its sr_disp_colony_<world>_<specialization> value, and which loc keys it
	### reads, and the icon of the kind of world it is (space_race_icons/
	### colony_<kind>.dds, one of nine; the same cell shape as the Colonial
	### Empire's territory row). Fixed width, 24 icon + 4 + 442 name = the 470 the
	### name box had alone, + 2 x 4 margin = the 480 column.
	type te_sr_colony_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "colony_visible" {}
		block "colony_tooltip" {}

		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			icon = {
				size = { 24 24 }
				parentanchor = center
				block "colony_icon" {}
			}
		}
		widget = {
			size = { 442 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 442
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				default_format = "#tooltippable"
				block "colony_name" {}
			}
		}
	}

	### Our Colonies (solar colonization only): every world we hold, under its
	### stage, as the specialization we chose. Listed for as long as we hold one,
	### so the entry's passive mode (every world claimed, or its production method
	### off) still shows what its modifiers come from; it does not depend on the
	### controls' is_shown. The record is <modifier>_held (sr_grant_colony_modifier),
	### read through sr_disp_colony_*: one row for each of the 68 specializations,
	### in the order the colony events offer them, hidden until held, so a stage
	### heading shows only when we hold one of its worlds (sr_disp_colonies_stage_<n>).
	### Rows sit in one 520-wide column like the other live sections. Open by
	### default; the flag is sr_panel_colonies_closed (client-side, like the rest).
	type te_sr_sec_colonies = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_colonies_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_colonies_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_colonies_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_colonies_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_colonies_closed'))]"

			te_sr_value_row = {
				blockoverride "label_format" {}
				blockoverride "row_label" {
					text = "je_space_race_widget_colonies_held_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_colonies_held_figure"
				}
			}
			te_sr_note = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_colonies_empty"
			}

			te_sr_subheader = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_stage_1'), '(CFixedPoint)1' )]"
