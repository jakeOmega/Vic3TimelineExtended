					block "fl_pick" {}
				}
			}
			te_sr_fl_button = {
				blockoverride "fl_btn" {
					block "fl_go_button" {}
				}
				blockoverride "fl_btn_label" {
					text = "je_space_race_widget_fl_go"
				}
			}
			te_sr_fl_button = {
				blockoverride "fl_btn" {
					block "fl_merge_button" {}
				}
				blockoverride "fl_btn_label" {
					text = "je_space_race_widget_fl_merge"
				}
			}
			te_sr_fl_button = {
				blockoverride "fl_btn" {
					block "fl_detach_button" {}
				}
				blockoverride "fl_btn_label" {
					text = "je_space_race_widget_fl_detach"
				}
			}
			te_sr_fl_button = {
				blockoverride "fl_btn" {
					block "fl_land_button" {}
				}
				blockoverride "fl_btn_label" {
					text = "je_space_race_widget_fl_land"
				}
			}
			te_sr_fl_button = {
				blockoverride "fl_btn" {
					block "fl_embark_button" {}
				}
				blockoverride "fl_btn_label" {
					text = "je_space_race_widget_fl_embark"
				}
			}
		}
		### Posture and target (6b), at a location other than Earth; at Earth only
		### while a lunar world there may be closed in on (lunar colonization § 8.1).
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin = { 4 1 }
			block "fl_combat_visible" {}

			button = {
				using = default_button_action
				size = { 104 22 }
				parentanchor = vcenter
				block "fl_posture_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 100
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_fl_posture_1"
					block "fl_posture_1_visible" {}
				}
				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 100
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_fl_posture_2"
					block "fl_posture_2_visible" {}
				}
				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 100
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_fl_posture_3"
					block "fl_posture_3_visible" {}
				}
				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 100
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_fl_posture_4"
					block "fl_posture_4_visible" {}
				}
			}
			button = {
				using = default_button_action
				size = { 190 22 }
				parentanchor = vcenter
				block "fl_target_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 184
					elide = right
					using = te_sr_fontsize_row
					block "fl_target" {}
				}
			}
			button = {
				using = default_button_action
				size = { 80 22 }
				parentanchor = vcenter
				block "fl_destroy_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
