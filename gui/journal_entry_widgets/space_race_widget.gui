	### modules design § 11): fabrication (points a month and the stock),
	### shipments waiting and in flight, the modules' upkeep, the Extraplanetary
	### Base room, the queue in order, then every colony we hold. Open by default; the flag is
	### sr_panel_modules_closed.
	type te_sr_sec_modules = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[And( JournalEntry.IsActive, EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ) )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_modules_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_modules_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_modules_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_modules_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_modules_closed'))]"

			te_sr_note = {
				text = "je_space_race_widget_modules_note"
			}
			te_sr_value_row = {
				tooltip = "je_space_race_widget_fab_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_fab_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_fab_figure"
				}
			}
			te_sr_value_row = {
				tooltip = "je_space_race_widget_shipments_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_shipments_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_shipments_figure"
				}
			}
			te_sr_value_row = {
				tooltip = "je_space_race_widget_mod_upkeep_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_mod_upkeep_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_mod_upkeep_figure"
				}
			}
			te_sr_value_row = {
				tooltip = "je_space_race_widget_ebase_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_ebase_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_ebase_figure"
				}
			}
			te_sr_note = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_settlers_empty"
			}
			### The queue, first in first out: place 1 is built next.
			te_sr_subheader = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_1'), '(CFixedPoint)1' )]"
				blockoverride "subheader_text" {
					text = "je_space_race_widget_mq_header"
				}
			}
			te_sr_mq_rows = {}
			te_sr_module_header_row = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)1' )]"
			}
			te_sr_module_rows = {}
		}
	}

	### ======================================================================
	### FLEETS (solar colonization, Full Colonies; slice 6 design § 16)
	### ======================================================================

	### A small action button in a fleet's orders line: `fl_btn` carries the
	### four properties that address the scripted GUI (the slot is scope:op),
	### `fl_btn_label` its text.
	type te_sr_fl_button = button {
		using = default_button_action
		size = { 56 22 }
		parentanchor = vcenter
		block "fl_btn" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 54
			elide = right
			using = fontsize_small
			block "fl_btn_label" {}
		}
	}

	### The column heads above the Fleets rows, the widths of te_sr_fleet_row's
