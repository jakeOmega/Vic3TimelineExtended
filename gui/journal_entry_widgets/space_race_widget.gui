			size = { 56 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 56
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#v"
				block "loc_ours" {}
			}
		}
		widget = {
			size = { 79 24 }
			parentanchor = vcenter

			flowcontainer = {
				parentanchor = left|vcenter
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes

				flowcontainer = {
					ignoreinvisible = yes
					block "loc_flag_visible" {}

					flowcontainer = {
						ignoreinvisible = yes
						block "loc_context" {}

						widget = {
