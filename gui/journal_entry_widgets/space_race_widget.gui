			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 180
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "fr_name" {}
			}
		}
		widget = {
			size = { 122 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 122
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#v"
				text = "je_space_race_widget_ss_ours"
				block "fr_ours_visible" {}
			}
			flowcontainer = {
				parentanchor = left|vcenter
				ignoreinvisible = yes
				block "fr_other_visible" {}

				flowcontainer = {
					direction = horizontal
					spacing = 4
					ignoreinvisible = yes
					block "fr_context" {}

					widget = {
						size = { 28 24 }
						parentanchor = vcenter

						tiny_flag = {
							parentanchor = center
							datacontext = "[State.GetCountry]"
						}
