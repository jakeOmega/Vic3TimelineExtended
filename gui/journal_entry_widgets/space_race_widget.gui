				elide = right
				tooltip = "je_space_race_widget_ss_ruined_tt"
				text = "je_space_race_widget_ss_ruined"
				block "fr_ruined_visible" {}
			}
		}
		widget = {
			size = { 80 24 }
			parentanchor = vcenter

			button = {
				using = default_button_action
				size = { 100% 100% }
				block "fr_target_visible" {}
				block "fr_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 76
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_target_button"
				}
			}
			icon = {
				using = selected_tabs
				size = { 100% 100% }
				tooltip = "je_space_race_widget_ft_targeted_tt"
				block "fr_targeted_visible" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 76
					elide = right
					using = te_sr_fontsize_row
					default_format = "#variable"
					text = "je_space_race_widget_ft_targeted"
				}
			}
		}
	}

	### ======================================================================
	### MARINES: where a fleet's marines land, and where they embark from
	### ======================================================================

	### A fleet's Marines popup, opened by Land or Embark on its card in Space
	### Fleets (te_popup sr_land_<n>); instanced in te_popups. The bodies are
	### te_sr_land_popup_body's, one a slot (sr_fleets_generated_rows.gui), under
	### the entry's scope-free gate and its GetPlayerJournalEntry datacontext, as
	### the target popup's.
	type te_sr_land_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[Or( Or( Or( GetVariableSystem.HasValue('te_popup', 'sr_land_1'), GetVariableSystem.HasValue('te_popup', 'sr_land_2') ), Or( GetVariableSystem.HasValue('te_popup', 'sr_land_3'), GetVariableSystem.HasValue('te_popup', 'sr_land_4') ) ), Or( Or( GetVariableSystem.HasValue('te_popup', 'sr_land_5'), GetVariableSystem.HasValue('te_popup', 'sr_land_6') ), Or( GetVariableSystem.HasValue('te_popup', 'sr_land_7'), Or( GetVariableSystem.HasValue('te_popup', 'sr_land_8'), GetVariableSystem.HasValue('te_popup', 'sr_land_9') ) ) ) )]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_ld_title"
		}
		### The slot's 560, plus the window's margins (2 × 35), the list's
		### (2 × 10) and a scrollbar: 688.
		blockoverride "popup_size" {
			size = { 688 460 }
		}
		blockoverride "popup_list" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_space_race_solar_colonization')]"
					direction = vertical
					ignoreinvisible = yes

					te_sr_land_popup_body = {}
				}
			}
			te_sr_note = {
				visible = "[Not( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "je_space_race_widget_tp_gone"
			}
		}
	}

	### One slot's body in the Marines popup (instances in te_sr_land_popup_body):
	### while the fleet is at a location, what Land and Embark do, the marines
	### aboard of the carriers' room, the amount with - and + (Transfer's keys),
	### the columns' heads and our colonies there; otherwise the destination
	### popup's line.
	type te_sr_land_slot = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		minimumsize = { 560 -1 }
		spacing = 2
		block "ld_visible" {}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 2
			block "ld_here_visible" {}

			te_sr_note = {
				text = "je_space_race_widget_ld_intro"
			}
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				margin = { 4 1 }

				textbox = {
					autoresize = yes
					max_width = 300
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_ld_aboard"
				}
				textbox = {
					autoresize = yes
					max_width = 120
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "ld_aboard" {}
				}
			}
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				margin = { 4 1 }

				textbox = {
					size = { 180 26 }
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_ld_amount"
					tooltip = "je_space_race_widget_ld_amount_tt"
				}
				widget = {
					size = { 28 26 }

					button_icon_minus_action = {
						size = { 26 26 }
						parentanchor = center
						block "ld_less" {}
					}
				}
				textbox = {
					size = { 64 26 }
					align = center|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "ld_amount" {}
				}
				widget = {
					size = { 28 26 }

					button_icon_plus_action = {
						size = { 26 26 }
						parentanchor = center
						block "ld_more" {}
					}
				}
			}
			### The heads, te_sr_land_row's widths.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 3
				margin = { 4 1 }

				widget = {
					size = { 24 20 }
				}
				textbox = {
					size = { 180 20 }
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_ld_col_colony"
				}
				textbox = {
					size = { 80 20 }
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_ld_col_marines"
					tooltip = "je_space_race_widget_ld_col_marines_tt"
				}
				textbox = {
					size = { 80 20 }
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_ld_col_garrison"
					tooltip = "je_space_race_widget_ld_due_tt"
				}
			}
			block "ld_rows" {}
		}
		te_sr_note = {
			text = "je_space_race_widget_dp_gone"
			block "ld_gone_visible" {}
		}
	}

	### One colony of ours in a fleet's Marines popup: its icon and name (Solar
	### System's hover), our marines there, Due while its garrison order waits
	### for marines, then Land (up to the amount of the marines aboard land
	### there) and Embark (up to the amount of ours there come aboard, within
	### the carriers' room); the popup stays open.
	### 24 + 180 + 80 + 80 + 80 + 80 + 5 × 3 + 2 × 4 = 547.
	type te_sr_land_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 3
		margin = { 4 1 }
		block "lr_visible" {}

		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			icon = {
				size = { 24 24 }
				parentanchor = center
				block "lr_icon" {}
			}
		}
		widget = {
			size = { 180 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 180
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "lr_name" {}
			}
		}
		widget = {
			size = { 80 24 }
			parentanchor = vcenter
			tooltip = "je_space_race_widget_ld_col_marines_tt"

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 80
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "lr_marines" {}
			}
		}
		widget = {
			size = { 80 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 80
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#yellow;bold"
				tooltip = "je_space_race_widget_ld_due_tt"
				text = "je_space_race_widget_ld_due"
				block "lr_due_visible" {}
			}
		}
		widget = {
			size = { 80 24 }
			parentanchor = vcenter

			button = {
				using = default_button_action
				size = { 100% 100% }
				block "lr_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 76
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ld_button"
				}
			}
		}
		widget = {
			size = { 80 24 }
			parentanchor = vcenter

			button = {
				using = default_button_action
				size = { 100% 100% }
				block "lr_embark_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 76
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ld_embark_button"
				}
			}
		}
	}

	### ======================================================================
	### TRANSFER (UI pass design § 6): the popup that took in Merge and Detach
	### ======================================================================

	### An Into button: a new fleet, or another fleet of ours here, named by its
	### drive and strength, as its Fleets row shows them (the rows carry no
	### number). `xf_to_btn` carries the scripted GUI's properties
	### (sr_fleet_xfer_to_sgui, scope:op the slot, scope:pick 0 or the other slot)
	### and, for a fleet, its visible (sr_disp_fl_<n>_xf_here_<m>: it is here).
	type te_sr_xf_to_button = button {
		using = default_button_action
		size = { 168 26 }
		parentanchor = vcenter
		block "xf_to_btn" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 162
			elide = right
			using = te_sr_fontsize_row
			block "xf_to_label" {}
		}
	}

	### Into, then up to three lines of te_sr_xf_to_button: 60 + 3 × 168 + 3 × 4
	### + 2 × 4 = 584, the rows' width. A line with no fleet here hides.
	type te_sr_xf_to_line = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		textbox = {
			size = { 60 26 }
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_xf_to_label"
		}
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 4
			block "xf_to_rows" {}
		}
	}

	### The column heads over te_sr_xf_role_row's cells; Move spans the − and +
	### buttons and the amount between them (28 + 64 + 28 + 2 × 4 = 128).
	type te_sr_xf_head_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		widget = {
			size = { 160 20 }
		}
		textbox = {
			size = { 64 20 }
			align = right|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_xf_col_now"
		}
		textbox = {
			size = { 128 20 }
			align = center|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_xf_col_move"
			tooltip = "je_space_race_widget_xf_col_move_tt"
		}
		textbox = {
			size = { 104 20 }
			align = right|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_xf_col_stay"
			tooltip = "je_space_race_widget_xf_col_stay_tt"
		}
		textbox = {
			size = { 104 20 }
			align = right|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_xf_col_there"
			tooltip = "je_space_race_widget_xf_col_there_tt"
		}
	}

	### A role, the marines, or the strength's total: its name, what the fleet
	### has now, − the amount to move + (the construction market's keys: the
	### buttons' click_modifiers, sr_fleet_xfer_step_sgui), what stays and what
	### the fleet it goes into then has. Each button sits in a fixed widget, so a
	### hidden one (the total's) keeps its column. 160 + 64 + 28 + 64 + 28 + 104 +
	### 104 + 6 × 4 + 2 × 4 = 584.
	type te_sr_xf_role_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		textbox = {
			size = { 160 26 }
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "xf_name" {}
		}
		textbox = {
			size = { 64 26 }
			align = right|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "xf_now" {}
		}
		widget = {
			size = { 28 26 }

			button_icon_minus_action = {
				size = { 26 26 }
				parentanchor = center
				block "xf_less" {}
			}
		}
		textbox = {
			size = { 64 26 }
			align = center|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "xf_amount" {}
		}
		widget = {
			size = { 28 26 }

			button_icon_plus_action = {
				size = { 26 26 }
				parentanchor = center
				block "xf_more" {}
			}
		}
		textbox = {
			size = { 104 26 }
			align = right|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "xf_stay" {}
		}
		textbox = {
			size = { 104 26 }
			align = right|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "xf_there" {}
		}
	}

	### The popup's foot: Transfer (sr_fleet_transfer_sgui, scope:op the slot),
	### centered under the rows in a slot their width (style guide rules 6 and 8).
	### `xf_go_btn` carries its four properties: greyed, its hover names the
	### refusal; a click moves what is chosen and closes the popup.
	type te_sr_xf_go_row = widget {
		size = { 584 38 }

		button = {
			using = default_button_action
			size = { 140 30 }
			parentanchor = center
			block "xf_go_btn" {}

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 134
				elide = right
				using = te_sr_fontsize_row
				text = "je_space_race_widget_xf_go"
			}
		}
	}

	### The Transfer popup (UI pass design § 6), opened from a fleet's Transfer
	### (te_popup = sr_xfer_<n>, n the slot); instanced in te_popups
	### (gui/te_popups.gui). Its content is generated, a body a slot
	### (te_sr_xfer_popup_body, sr_fleets_generated_rows.gui), under the
	### entry's scope-free gate and its GetPlayerJournalEntry datacontext
	### (gotchas #22, #29); with the entry gone, one line says so.
	type te_sr_xfer_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[Or( GetVariableSystem.HasValue('te_popup', 'sr_xfer_1'), Or( GetVariableSystem.HasValue('te_popup', 'sr_xfer_2'), Or( GetVariableSystem.HasValue('te_popup', 'sr_xfer_3'), Or( GetVariableSystem.HasValue('te_popup', 'sr_xfer_4'), Or( GetVariableSystem.HasValue('te_popup', 'sr_xfer_5'), Or( GetVariableSystem.HasValue('te_popup', 'sr_xfer_6'), Or( GetVariableSystem.HasValue('te_popup', 'sr_xfer_7'), Or( GetVariableSystem.HasValue('te_popup', 'sr_xfer_8'), GetVariableSystem.HasValue('te_popup', 'sr_xfer_9') ) ) ) ) ) ) ) )]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_xf_title"
		}
		### The rows' 584, plus the window's margins (2 × 35), the list's
		### (2 × 10) and a scrollbar, as the colony target popup: 712.
		blockoverride "popup_size" {
			size = { 712 620 }
		}
		blockoverride "popup_list" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_space_race_solar_colonization')]"
					direction = vertical
					ignoreinvisible = yes

					te_sr_xfer_popup_body = {}
				}
			}
			te_sr_note = {
				visible = "[Not( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "je_space_race_widget_tp_gone"
			}
		}
	}

	### Locations is a strip (owner, 2026-11-14): the nine locations from Earth
	### outward, a column each (te_sr_location_cell), under their worlds' icons;
	### this column, at their left, says what each line is, as an icon with its
	### word on hover: ours (the fleet's emblem), the strongest other power's
	### (its flag, then the bare shield beside every other power's strength) and
	### the warships on their way (the warship, audit SPC-16). The cells' heights
	### are te_sr_location_cell's, line for line.
	type te_sr_location_captions = flowcontainer {
		direction = vertical

		widget = {
			size = { 26 34 }
		}
		widget = {
			size = { 26 22 }
			tooltip = "je_space_race_widget_loc_col_ours"

			icon = {
				size = { 18 18 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/fleet.dds"
			}
		}
		widget = {
			size = { 26 26 }
		}
		widget = {
			size = { 26 22 }
			tooltip = "je_space_race_widget_loc_others_tt"

			icon = {
				size = { 18 18 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/fleet_other.dds"
			}
		}
		widget = {
			size = { 26 22 }
			tooltip = "je_space_race_widget_loc_inbound_tt"

			icon = {
				size = { 18 18 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/warship.dds"
			}
		}
		widget = {
			size = { 26 24 }
		}
	}

	### One location in Locations, a column of the strip: its world's icon (its
	### name on hover), our strength there, the strongest other power's flag
	### (its capital stored on the viewer, sr_ls_cap_<loc>, gotcha #15) over
	### every other power's strength there, exact (fleets in space are seen),
	### the fleets on their way ("count·months", highlighted when the first is
	### ours), and from 6b its status as an icon, red where it is bad for us (a
	### battle this month, our colonies there blockaded, our blockade of an
	### enemy's; from 6c, our colonies interdicted, our interdiction; 6d, Earth's
	### own), each with its hover. 50 wide: 26 + 9 × 50 = 476, in the column.
	### Instances in te_sr_location_cells (sr_fleets_generated_rows.gui).
	type te_sr_location_cell = flowcontainer {
		direction = vertical

		widget = {
			size = { 50 34 }
			block "loc_name" {}

			icon = {
				size = { 30 30 }
				parentanchor = center
				block "loc_icon" {}
			}
		}
		widget = {
			size = { 50 22 }

			textbox = {
				parentanchor = center
				autoresize = yes
				max_width = 50
				align = center|nobaseline
				using = te_sr_fontsize_overview
				elide = right
				default_format = "#v"
				block "loc_ours" {}
			}
		}
		widget = {
			size = { 50 26 }

			flowcontainer = {
				parentanchor = center
				ignoreinvisible = yes
				block "loc_flag_visible" {}

				flowcontainer = {
					ignoreinvisible = yes
					block "loc_context" {}

					widget = {
						size = { 28 24 }

						tiny_flag = {
							parentanchor = center
							datacontext = "[State.GetCountry]"
						}
					}
				}
			}
		}
		widget = {
			size = { 50 22 }

			textbox = {
				parentanchor = center
				autoresize = yes
				max_width = 50
				align = center|nobaseline
				using = te_sr_fontsize_overview
				elide = right
				block "loc_others" {}
			}
		}
		widget = {
			size = { 50 22 }

			flowcontainer = {
				parentanchor = center
				ignoreinvisible = yes
				block "loc_inbound" {}

				textbox = {
					autoresize = yes
					max_width = 50
					align = center|nobaseline
					using = te_sr_fontsize_overview
					elide = right
					default_format = "#v"
					block "loc_inbound_ours" {}
				}
				textbox = {
					autoresize = yes
					max_width = 50
					align = center|nobaseline
					using = te_sr_fontsize_overview
					elide = right
					block "loc_inbound_rival" {}
				}
			}
		}
		widget = {
			size = { 50 24 }

			icon = {
				size = { 20 20 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/status_battle.dds"
				tooltip = "je_space_race_widget_loc_battle_tt"
				block "loc_battle_visible" {}
			}
			icon = {
				size = { 20 20 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/status_blockaded.dds"
				tooltip = "je_space_race_widget_loc_blockaded_tt"
				block "loc_blockaded_visible" {}
			}
			icon = {
				size = { 20 20 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/posture_standoff.dds"
				tooltip = "je_space_race_widget_loc_blockading_tt"
				block "loc_blockading_visible" {}
			}
			icon = {
				size = { 20 20 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/status_interdicted.dds"
				tooltip = "je_space_race_widget_loc_interdicted_tt"
				block "loc_interdicted_visible" {}
			}
			icon = {
				size = { 20 20 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/posture_interdict.dds"
				tooltip = "je_space_race_widget_loc_interdicting_tt"
				block "loc_interdicting_visible" {}
			}
			icon = {
				size = { 20 20 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/status_blockaded.dds"
				tooltip = "je_space_race_widget_loc_earth_blockaded_tt"
				block "loc_earth_blockaded_visible" {}
			}
			icon = {
				size = { 20 20 }
				parentanchor = center
				texture = "gfx/interface/icons/space_race_icons/posture_standoff.dds"
				tooltip = "je_space_race_widget_loc_earth_blockading_tt"
				block "loc_earth_blockading_visible" {}
			}
		}
	}

	### Space Command (Full Colonies; slice 6 design § 5): six overview cells
	### (what it builds a month, the fleets' strength, its upkeep and the
	### reserve; then, space forces personnel design § 7, Personnel and Crewed),
	### then Launch, Auto-launch (sr_reserve_auto_sgui) and Crews first
	### (sr_pers_priority_sgui), each toggle reading "Label: value", then
	### Construction (the owner, 2026-11-25): the yards' three modes
	### (sr_sc_mode_sgui: Full, Orders Only, Paused; one Pause / Resume /
	### Resuming button until then), and a table, a row a role
	### (te_sr_sc_build_rows, generated): what we hold of it, its weight in the
	### build mix with - and + (sr_sc_mix_sgui; five buttons each stepping 0 to
	### 3 and round until then), and its order with -, + and withdraw
	### (sr_sc_order_sgui), then the hulls on order and the months they take.
	### Open by default; the flag is sr_panel_space_command_closed.
	###
	### Launch's button; the two toggles are wider for their "Label: value":
	### 90 + 160 + 196 + 2 × 4 = 454, in the row's 472.
	type te_sr_sc_button = button {
		using = default_button_action
		size = { 90 26 }
		parentanchor = vcenter
		block "sc_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 84
			elide = right
			using = te_sr_fontsize_row
			block "sc_label" {}
		}
	}

	type te_sr_sc_button_mid = button {
		using = default_button_action
		size = { 160 26 }
		parentanchor = vcenter
		block "sc_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 154
			elide = right
			using = te_sr_fontsize_row
			block "sc_label" {}
		}
	}

	type te_sr_sc_button_wide = button {
		using = default_button_action
		size = { 196 26 }
		parentanchor = vcenter
		block "sc_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 190
			elide = right
			using = te_sr_fontsize_row
			block "sc_label" {}
		}
	}

	### One of the yards' three modes: a button, or, for the mode in force,
	### vanilla's selected-tab look (selected_tabs), as the Strategic Reserve
	### draws its policy in force (widget_je_st_res_policy_choice): a greyed
	### button would read as unavailable. Three to the line: 3 × 112 + 2 × 4.
	type te_sr_sc_mode_choice = widget {
		size = { 112 28 }
		parentanchor = vcenter

		button = {
			using = default_button_action
			size = { 100% 100% }
			block "mode_button" {}

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 106
				elide = right
				using = te_sr_fontsize_row
				block "mode_label" {}
			}
		}
		icon = {
			using = selected_tabs
			size = { 100% 100% }
			block "mode_selected" {}

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 106
				elide = right
				using = te_sr_fontsize_row
				default_format = "#variable"
				block "mode_label" {}
			}
		}
	}

	### The table's column heads, each over its cell: Role 100, Fleets 58,
	### Reserve 66, Mix 116 (its head over the stepper's 76), Order 124 (over the
	### stepper's 96): 464 + 4 × 4 = 480, the panel's 480.
	type te_sr_sc_build_heads = flowcontainer {
		direction = horizontal
		spacing = 4
		margin_top = 4

		widget = {
			size = { 100 20 }

			widget = {
				size = { 100 20 }

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 100
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_sc_col_role_tt"
					text = "je_space_race_widget_sc_col_role"
				}
			}
		}
		widget = {
			size = { 58 20 }

			widget = {
				size = { 58 20 }

				textbox = {
					parentanchor = center
					autoresize = yes
					max_width = 58
					align = center|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_sc_col_fleets_tt"
					text = "je_space_race_widget_sc_col_fleets"
				}
			}
		}
		widget = {
			size = { 66 20 }

			widget = {
				size = { 66 20 }

				textbox = {
					parentanchor = center
					autoresize = yes
					max_width = 66
					align = center|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_sc_col_reserve_tt"
					text = "je_space_race_widget_sc_col_reserve"
				}
			}
		}
		widget = {
			size = { 116 20 }

			widget = {
				size = { 76 20 }

				textbox = {
					parentanchor = center
					autoresize = yes
					max_width = 76
					align = center|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_sc_col_mix_tt"
					text = "je_space_race_widget_sc_col_mix"
				}
			}
		}
		widget = {
			size = { 124 20 }

			widget = {
				size = { 96 20 }

				textbox = {
					parentanchor = center
					autoresize = yes
					max_width = 96
					align = center|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_sc_col_order_tt"
					text = "je_space_race_widget_sc_col_order"
				}
			}
		}
	}

	### A role's row: its icon and word; our fleets' strength in it, and the
	### ground reserve's; its build-mix weight between - and +, and its share of
	### what a month has left after the orders; its order between - and + (a
	### click 1 hull, shift-click 10, ctrl-click 100), and withdraw. The cells'
	### bindings are the generated rows' (te_sr_sc_build_rows).
	type te_sr_sc_build_row = flowcontainer {
		direction = horizontal
		spacing = 4

		widget = {
			size = { 100 28 }
			block "br_role" {}

			icon = {
				size = { 20 20 }
				parentanchor = left|vcenter
				block "br_icon" {}
			}
			textbox = {
				position = { 24 0 }
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 76
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "br_name" {}
			}
		}
		widget = {
			size = { 58 28 }
			block "br_fleets_tooltip" {}

			textbox = {
				parentanchor = center
				autoresize = yes
				max_width = 58
				align = center|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#v"
				block "br_fleets" {}
			}
		}
		widget = {
			size = { 66 28 }

			textbox = {
				parentanchor = center
				autoresize = yes
				max_width = 66
				align = center|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#v"
				block "br_reserve" {}
			}
		}
		widget = {
			size = { 116 28 }

			flowcontainer = {
				direction = horizontal
				spacing = 2
				parentanchor = left|vcenter

				button_icon_minus_action = {
					size = { 26 26 }
					parentanchor = vcenter
					block "br_mix_down" {}
				}
				widget = {
					size = { 20 26 }
					parentanchor = vcenter

					textbox = {
						parentanchor = center
						autoresize = yes
						max_width = 20
						align = center|nobaseline
						using = te_sr_fontsize_row
						elide = right
						default_format = "#v"
						block "br_mix_weight" {}
					}
				}
				button_icon_plus_action = {
					size = { 26 26 }
					parentanchor = vcenter
					block "br_mix_up" {}
				}
				widget = {
					size = { 38 26 }
					parentanchor = vcenter
					block "br_mix_share_tooltip" {}

					textbox = {
						parentanchor = center
						autoresize = yes
						max_width = 38
						align = center|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "br_mix_share" {}
					}
				}
			}
		}
		widget = {
			size = { 124 28 }

			flowcontainer = {
				direction = horizontal
				spacing = 2
				parentanchor = left|vcenter

				button_icon_minus_action = {
					size = { 26 26 }
					parentanchor = vcenter
					block "br_order_down" {}
				}
				widget = {
					size = { 40 26 }
					parentanchor = vcenter

					textbox = {
						parentanchor = center
						autoresize = yes
						max_width = 40
						align = center|nobaseline
						using = te_sr_fontsize_row
						elide = right
						default_format = "#v"
						block "br_order" {}
					}
				}
				button_icon_plus_action = {
					size = { 26 26 }
					parentanchor = vcenter
					block "br_order_up" {}
				}
				button_icon_cancel = {
					size = { 26 26 }
					parentanchor = vcenter
					block "br_order_clear" {}
				}
			}
		}
	}

	type te_sr_sec_space_command = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[And( JournalEntry.IsActive, EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ) )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_sc_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_space_command_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_space_command_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_space_command_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_space_command_closed'))]"

			### 6d: nothing leaves Earth (design § 15). State, so in the row style;
			### the rules are on the Help page, under How Solar Colonization Works.
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_earth_blockaded'), '(CFixedPoint)1' )]"
				text = "je_space_race_widget_sc_blockaded_note"
			}
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_launch_site_lost'), '(CFixedPoint)1' )]"
				text = "je_space_race_widget_sc_site_lost_note"
			}
			### The six readings as overview cells, two to a row (style guide rule 4;
			### owner, 2026-11-14): Banking's cell, each with its icon in an inset box,
			### its caption and its figure, the breakdown on hover. Built a month
			### reads the yards' state while they build nothing (sr_disp_sc_paused):
			### Paused (owner, 2026-10-31), Resuming while a resume waits for the next
			### step, Idle in Orders Only with nothing on order (the owner,
			### 2026-11-25). One slot, the four cells taking turns, each with its own
			### hover.
			flowcontainer = {
				direction = horizontal
				spacing = 4

				widget = {
					size = { 238 70 }

					te_banking_ov_cell = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_paused'), '(CFixedPoint)0' )]"
						tooltip = "je_space_race_widget_sc_rate_tt"
						blockoverride "caption" {
							text = "je_space_race_widget_ovc_sc_rate_cap"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/building_icons/building_space_command.dds"
							}
						}
						blockoverride "word" {
							te_banking_ov_word = {
								text = "je_space_race_widget_ovc_sc_rate_word"
							}
						}
					}
					te_banking_ov_cell = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_paused'), '(CFixedPoint)1' )]"
						tooltip = "je_space_race_widget_sc_rate_paused_tt"
						blockoverride "caption" {
							text = "je_space_race_widget_ovc_sc_rate_cap"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/building_icons/building_space_command.dds"
							}
						}
						blockoverride "word" {
							te_banking_ov_word = {
								text = "je_space_race_widget_ovc_sc_rate_word_paused"
							}
						}
					}
					te_banking_ov_cell = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_paused'), '(CFixedPoint)2' )]"
						tooltip = "je_space_race_widget_sc_rate_resuming_tt"
						blockoverride "caption" {
							text = "je_space_race_widget_ovc_sc_rate_cap"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/building_icons/building_space_command.dds"
							}
						}
						blockoverride "word" {
							te_banking_ov_word = {
								text = "je_space_race_widget_ovc_sc_rate_word_resuming"
							}
						}
					}
					te_banking_ov_cell = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_paused'), '(CFixedPoint)3' )]"
						tooltip = "je_space_race_widget_sc_rate_idle_tt"
						blockoverride "caption" {
							text = "je_space_race_widget_ovc_sc_rate_cap"
						}
						blockoverride "icons" {
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/building_icons/building_space_command.dds"
							}
						}
						blockoverride "word" {
							te_banking_ov_word = {
								text = "je_space_race_widget_ovc_sc_rate_word_idle"
							}
						}
					}
				}
				te_banking_ov_cell = {
					tooltip = "je_space_race_widget_sc_strength_tt"
					blockoverride "caption" {
						text = "je_space_race_widget_ovc_sc_strength_cap"
					}
					blockoverride "icons" {
						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/icons/space_race_icons/warship.dds"
						}
					}
					blockoverride "word" {
						te_banking_ov_word = {
							text = "je_space_race_widget_ovc_sc_strength_word"
						}
					}
				}
			}
			### Upkeep, and 6d's ground reserve (design § 15), over Launch and its toggle.
			flowcontainer = {
				direction = horizontal
				spacing = 4

				te_banking_ov_cell = {
					tooltip = "je_space_race_widget_sc_upkeep_tt"
					blockoverride "caption" {
						text = "je_space_race_widget_ovc_sc_upkeep_cap"
					}
					blockoverride "icons" {
						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/icons/space_race_icons/page_crews.dds"
						}
					}
					blockoverride "word" {
						te_banking_ov_word = {
							text = "je_space_race_widget_ovc_sc_upkeep_word"
						}
					}
				}
				te_banking_ov_cell = {
					tooltip = "je_space_race_widget_sc_reserve_tt"
					blockoverride "caption" {
						text = "je_space_race_widget_ovc_sc_reserve_cap"
					}
					blockoverride "icons" {
						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/icons/space_race_icons/module_port.dds"
						}
					}
					blockoverride "word" {
						te_banking_ov_word = {
							text = "je_space_race_widget_ovc_sc_reserve_word"
						}
					}
				}
			}
			### Space forces personnel (design § 7): the personnel in service of the
			### Space Forces Bases' capacity, and the share of the fleets they crew,
			### red while it is below full.
			flowcontainer = {
				direction = horizontal
				spacing = 4

				te_banking_ov_cell = {
					tooltip = "je_space_race_widget_sc_personnel_tt"
					blockoverride "caption" {
						text = "je_space_race_widget_ovc_sc_personnel_cap"
					}
					blockoverride "icons" {
						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/icons/space_race_icons/module_train.dds"
						}
					}
					blockoverride "word" {
						te_banking_ov_word = {
							text = "je_space_race_widget_ovc_sc_personnel_word"
						}
					}
				}
				te_banking_ov_cell = {
					tooltip = "je_space_race_widget_sc_crewed_tt"
					blockoverride "caption" {
						text = "je_space_race_widget_ovc_sc_crewed_cap"
					}
					blockoverride "icons" {
						icon = {
							size = { 100% 100% }
							texture = "gfx/interface/icons/space_race_icons/page_crewed.dds"
						}
					}
					blockoverride "word" {
						# Red while short of personnel (sr_disp_pers_short), as the base
						# room cell reads red past its room.
						te_banking_ov_word = {
							visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_pers_short'), '(CFixedPoint)1' ) )]"
							text = "je_space_race_widget_ovc_sc_crewed_word"
						}
						te_banking_ov_word = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_pers_short'), '(CFixedPoint)1' )]"
							text = "je_space_race_widget_ovc_sc_crewed_word_short"
						}
					}
				}
			}
			### Launch, then the two toggles, each reading "Label: value" (the owner,
			### 2026-11-25; "Auto: on" and "Hulls" until then): Auto-launch, and who
			### takes the personnel first (space forces personnel design § 4), Hulls
			### (the default) or Marines. A toggle is two buttons in one slot of its size.
			flowcontainer = {
				direction = horizontal
				spacing = 4
				margin = { 4 1 }

				te_sr_sc_button = {
					blockoverride "sc_button" {
						enabled = "[GetScriptedGui('sr_reserve_launch_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('sr_reserve_launch_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_reserve_launch_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_reserve_launch_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
					}
					blockoverride "sc_label" {
						text = "je_space_race_widget_sc_launch"
					}
				}
				widget = {
					size = { 160 26 }
					parentanchor = vcenter

					te_sr_sc_button_mid = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_reserve_auto'), '(CFixedPoint)1' )]"
						blockoverride "sc_button" {
							enabled = "[GetScriptedGui('sr_reserve_auto_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							onclick = "[GetScriptedGui('sr_reserve_auto_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							tooltip = "[Concatenate( GetScriptedGui('sr_reserve_auto_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_reserve_auto_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
						}
						blockoverride "sc_label" {
							text = "je_space_race_widget_sc_auto_on"
						}
					}
					te_sr_sc_button_mid = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_reserve_auto'), '(CFixedPoint)0' )]"
						blockoverride "sc_button" {
							enabled = "[GetScriptedGui('sr_reserve_auto_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							onclick = "[GetScriptedGui('sr_reserve_auto_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							tooltip = "[Concatenate( GetScriptedGui('sr_reserve_auto_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_reserve_auto_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
						}
						blockoverride "sc_label" {
							text = "je_space_race_widget_sc_auto_off"
						}
					}
				}
				widget = {
					size = { 196 26 }
					parentanchor = vcenter

					te_sr_sc_button_wide = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_pers_marines_first'), '(CFixedPoint)0' )]"
						blockoverride "sc_button" {
							enabled = "[GetScriptedGui('sr_pers_priority_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							onclick = "[GetScriptedGui('sr_pers_priority_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							tooltip = "[Concatenate( GetScriptedGui('sr_pers_priority_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_pers_priority_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
						}
						blockoverride "sc_label" {
							text = "je_space_race_widget_sc_hulls_first"
						}
					}
					te_sr_sc_button_wide = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_pers_marines_first'), '(CFixedPoint)1' )]"
						blockoverride "sc_button" {
							enabled = "[GetScriptedGui('sr_pers_priority_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							onclick = "[GetScriptedGui('sr_pers_priority_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
							tooltip = "[Concatenate( GetScriptedGui('sr_pers_priority_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_pers_priority_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
						}
						blockoverride "sc_label" {
							text = "je_space_race_widget_sc_marines_first"
						}
					}
				}
			}
			### Construction (the owner, 2026-11-25): the yards' mode, then the
			### table, then what is on order. The mode in force is drawn selected.
			te_sr_subheader = {
				blockoverride "subheader_text" {
					text = "je_space_race_widget_sc_build_header"
				}
			}
			flowcontainer = {
				direction = horizontal
				spacing = 4
				margin = { 4 1 }

				te_sr_sc_mode_choice = {
					blockoverride "mode_button" {
						visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_mode'), '(CFixedPoint)1' ) )]"
						enabled = "[GetScriptedGui('sr_sc_mode_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						onclick = "[GetScriptedGui('sr_sc_mode_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_sc_mode_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_sc_mode_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
					}
					blockoverride "mode_selected" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_mode'), '(CFixedPoint)1' )]"
						tooltip = "je_space_race_widget_sc_mode_full_on_tt"
					}
					blockoverride "mode_label" {
						text = "je_space_race_widget_sc_mode_full"
					}
				}
				te_sr_sc_mode_choice = {
					blockoverride "mode_button" {
						visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_mode'), '(CFixedPoint)2' ) )]"
						enabled = "[GetScriptedGui('sr_sc_mode_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						onclick = "[GetScriptedGui('sr_sc_mode_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_sc_mode_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_sc_mode_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
					}
					blockoverride "mode_selected" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_mode'), '(CFixedPoint)2' )]"
						tooltip = "je_space_race_widget_sc_mode_orders_on_tt"
					}
					blockoverride "mode_label" {
						text = "je_space_race_widget_sc_mode_orders"
					}
				}
				te_sr_sc_mode_choice = {
					blockoverride "mode_button" {
						visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_mode'), '(CFixedPoint)3' ) )]"
						enabled = "[GetScriptedGui('sr_sc_mode_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
						onclick = "[GetScriptedGui('sr_sc_mode_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_sc_mode_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_sc_mode_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ) ) )]"
					}
					blockoverride "mode_selected" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_mode'), '(CFixedPoint)3' )]"
						tooltip = "je_space_race_widget_sc_mode_paused_on_tt"
					}
					blockoverride "mode_label" {
						text = "je_space_race_widget_sc_mode_paused"
					}
				}
			}
			te_sr_sc_build_heads = {}
			te_sr_sc_build_rows = {}
			### Under the table, so a line that comes and goes moves nothing above it.
			te_sr_value_row = {
				tooltip = "je_space_race_widget_sc_orders_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_sc_orders_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_sc_orders_figure"
				}
			}
			te_sr_value_row = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_order_months'), '(CFixedPoint)1' )]"
				tooltip = "je_space_race_widget_sc_order_months_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_sc_order_months_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_sc_order_months_figure"
				}
			}
		}
	}

	### The picture at the head of Space Fleets (owner, 2026-11-14): a fleet of
	### the day, by the drive our program flies on (sr_drive_level: chemical,
	### fusion, fusion torch, antimatter), so it changes as the drives do. One
	### slot, the four pictures taking turns. Each is painted at the slot's own
	### shape, 960 x 220, so centercrop has nothing to cut
	### (space_race_gui_icons.md, "Space Fleets: the banner").
	type te_sr_fleet_banner = widget {
		size = { 480 110 }
		parentanchor = hcenter

		widget = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_drive_level'), '(CFixedPoint)0' )]"

			background = {
				texture = "gfx/interface/illustrations/space_race/fleet_banner_chemical.dds"
				fittype = centercrop
			}
		}
		widget = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_drive_level'), '(CFixedPoint)1' )]"

			background = {
				texture = "gfx/interface/illustrations/space_race/fleet_banner_fusion.dds"
				fittype = centercrop
			}
		}
		widget = {
			size = { 100% 100% }
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_drive_level'), '(CFixedPoint)2' )]"

			background = {
				texture = "gfx/interface/illustrations/space_race/fleet_banner_torch.dds"
				fittype = centercrop
			}
		}
		widget = {
			size = { 100% 100% }
			visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_drive_level'), '(CFixedPoint)3' )]"

			background = {
				texture = "gfx/interface/illustrations/space_race/fleet_banner_antimatter.dds"
				fittype = centercrop
			}
		}
	}

	### Space Fleets (Full Colonies; slice 6 design § 16): the banner, our nine
	### fleet slots as cards, then every location's forces. Open by default; the
	### flags are sr_panel_space_fleets_closed and, for Locations,
	### sr_panel_locations_closed (sr_panel_fleets_closed is Colony Fleets'); each
	### card has its own, sr_panel_fleet_<n>_closed, in its generated row.
	type te_sr_sec_space_fleets = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[And( JournalEntry.IsActive, EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ) )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_space_fleets_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_space_fleets_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_space_fleets_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_space_fleets_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_space_fleets_closed'))]"

			te_sr_fleet_banner = {}
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_space_fleets_empty"
			}
			# No Space Command, no fleet orders (UI pass design § 10): said once,
			# above the rows; each button's hover gives the reason too.
			te_sr_text = {
				visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_operational'), '(CFixedPoint)0' ) )]"
				text = "je_space_race_widget_space_fleets_no_sc"
			}
			# Short of personnel (space forces personnel design § 7): every fleet fires,
			# and its marines fight, at the share the personnel crew.
			te_sr_text = {
				visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_pers_short'), '(CFixedPoint)1' ) )]"
				text = "je_space_race_widget_space_fleets_short"
			}
			te_sr_fleet_rows = {}
		}

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_locations_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_locations_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_locations_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_locations_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_locations_closed'))]"

			te_sr_location_cells = {}
		}
	}

	### ======================================================================
	### THE FLEETS WINDOW (the owner, 2026-11-25: "space fleets [should] have
	### their own 'details' type popout window, like bases/colonies have now")
	### ======================================================================

	### The Fleets window's list of our fleets, one a line: the fleet's number,
	### the world of where it is or is bound, that place's name and its
	### strength now, on a button (clean_button, as the Colonies window's list),
	### greyed for the fleet shown. 244 wide: 4 + 38 + 4 + 20 + 4 + 122 + 4 +
	### 44 + 4, the number's and the name's cells the card's own. Instances in
	### te_sr_fleet_switch_rows (sr_fleets_generated_rows.gui): every slot,
	### shown while it holds a fleet.
	type te_sr_fleet_switch_row = button {
		using = clean_button
		size = { 244 26 }
		block "switch_row" {}

		textbox = {
			position = { 4 0 }
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 38
			align = left|nobaseline
			using = te_sr_fontsize_row
			default_format = "#title"
			block "switch_number" {}
		}
		widget = {
			size = { 20 20 }
			position = { 46 0 }
			parentanchor = left|vcenter

			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/location_earth.dds"
				block "fl_place_earth" {}
			}
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/colony_venus.dds"
				block "fl_place_inner" {}
			}
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/colony_mars.dds"
				block "fl_place_mars" {}
			}
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/colony_asteroid.dds"
				block "fl_place_asteroids" {}
			}
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/colony_jovian.dds"
				block "fl_place_jupiter" {}
			}
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/colony_saturnian.dds"
				block "fl_place_saturn" {}
			}
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/colony_uranian.dds"
				block "fl_place_uranus" {}
			}
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/colony_neptunian.dds"
				block "fl_place_neptune" {}
			}
			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/icons/space_race_icons/colony_dwarf.dds"
				block "fl_place_kuiper" {}
			}
		}
		textbox = {
			position = { 70 0 }
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 122
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "fl_where" {}
		}
		textbox = {
			position = { -4 0 }
			parentanchor = right|vcenter
			autoresize = yes
			max_width = 44
			align = right|nobaseline
			using = te_sr_fontsize_row
			default_format = "#v"
			elide = right
			block "switch_strength" {}
		}
	}

	### A caption at the head of an orders line on a fleet's page: 104 wide,
	### for "Destination" at the rows' 17.
	type te_sr_fp_caption = widget {
		size = { 104 26 }
		parentanchor = vcenter

		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 104
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "caption_text" {}
		}
	}

	### The picture at the head of a fleet's page (the owner, 2026-11-25: "it
	### would be nice to include the fleet banner image (the era specific
	### one)"): Space Fleets' own four pictures (te_sr_fleet_banner), here at the
	### size they were painted, 960 x 220, which is the page column's width, so
	### nothing is scaled or cut. One slot, the four taking turns on the page's
	### blocks (pb_<drive>): the fleet's own drive, not the program's, so a
	### fleet not yet refitted shows the ships it flies, as its Drive tile says.
	type te_sr_fleet_page_banner = widget {
		size = { 960 220 }

		widget = {
			size = { 100% 100% }
			block "pb_chemical" {}

			background = {
				texture = "gfx/interface/illustrations/space_race/fleet_banner_chemical.dds"
				fittype = centercrop
			}
		}
		widget = {
			size = { 100% 100% }
			block "pb_fusion" {}

			background = {
				texture = "gfx/interface/illustrations/space_race/fleet_banner_fusion.dds"
				fittype = centercrop
			}
		}
		widget = {
			size = { 100% 100% }
			block "pb_torch" {}

			background = {
				texture = "gfx/interface/illustrations/space_race/fleet_banner_torch.dds"
				fittype = centercrop
			}
		}
		widget = {
			size = { 100% 100% }
			block "pb_antimatter" {}

			background = {
				texture = "gfx/interface/illustrations/space_race/fleet_banner_antimatter.dds"
				fittype = centercrop
			}
		}
	}

	### A fleet's page in the Fleets window (te_sr_fleet_popup): everything its
	### card in Space Fleets has, at once and with room, plus what the card
	### keeps on hovers. At the top the picture of a fleet of its drive's day
	### (te_sr_fleet_page_banner), then the fleet's emblem, its number and
	### where it is (or is bound, with the transit track under the head); then
	### two columns. Left, 472: Ships (each role now of full on a tile, the
	### drive, and Transfer on the heading) and Condition (the card's four
	### bars, then its fire on fleets and on Defenses as combat counts them,
	### its dock and what the dock repairs a month).
	### Right, 480: Orders, a caption a line (destination and Go with the leg
	### under them, the posture's four buttons, the target with Seize /
	### Destroy and what we know of it, the marines' Land and Embark), then
	### Locations, the panel's own strip (476), so the theatre is in view while
	### the fleet gets its orders. The orders' buttons are the card's, with the card's blocks, so
	### te_sr_fleet_pages (generated, sr_fleets_generated_rows.gui) fills a
	### page from the card's own overrides; they open the same pickers, which
	### draw over this window and leave it open under them. Shown while its
	### slot is the window's (fp_visible: sr_fleet_focus its number, and a
	### fleet in it).
	type te_sr_fleet_page = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 6
		block "fp_visible" {}

		te_sr_fleet_page_banner = {
			blockoverride "pb_chemical" {
				block "fp_banner_chemical" {}
			}
			blockoverride "pb_fusion" {
				block "fp_banner_fusion" {}
			}
			blockoverride "pb_torch" {
				block "fp_banner_torch" {}
			}
			blockoverride "pb_antimatter" {
				block "fp_banner_antimatter" {}
			}
		}
		### The fleet: its emblem, its number, and the world and name of where it
		### is, or is bound.
		widget = {
			size = { 960 58 }

			widget = {
				size = { 48 48 }
				position = { 0 2 }

				background = {
					using = dark_area
					alpha = 0.3
				}
				icon = {
					size = { 40 40 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/fleet.dds"
				}
			}
			flowcontainer = {
				position = { 58 3 }
				direction = horizontal
				spacing = 6

				textbox = {
					autoresize = yes
					max_width = 200
					align = left|nobaseline
					using = te_sr_fontsize_heading
					default_format = "#title"
					text = "je_space_race_widget_fw_fleet"
				}
				textbox = {
					autoresize = yes
					max_width = 60
					align = left|nobaseline
					using = te_sr_fontsize_heading
					default_format = "#title"
					block "fp_number" {}
				}
			}
			flowcontainer = {
				position = { 58 30 }
				direction = horizontal
				spacing = 4

				widget = {
					size = { 20 20 }
					parentanchor = vcenter

					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/location_earth.dds"
						block "fl_place_earth" {}
					}
					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/colony_venus.dds"
						block "fl_place_inner" {}
					}
					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/colony_mars.dds"
						block "fl_place_mars" {}
					}
					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/colony_asteroid.dds"
						block "fl_place_asteroids" {}
					}
					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/colony_jovian.dds"
						block "fl_place_jupiter" {}
					}
					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/colony_saturnian.dds"
						block "fl_place_saturn" {}
					}
					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/colony_uranian.dds"
						block "fl_place_uranus" {}
					}
					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/colony_neptunian.dds"
						block "fl_place_neptune" {}
					}
					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/icons/space_race_icons/colony_dwarf.dds"
						block "fl_place_kuiper" {}
					}
				}
				textbox = {
					parentanchor = vcenter
					autoresize = yes
					max_width = 400
					align = left|nobaseline
					using = te_sr_fontsize_overview
					default_format = "#lore"
					elide = right
					block "fl_where" {}
				}
			}
			divider_clean = {
				parentanchor = bottom|left
				blockoverride "size" {
					size = { 960 2 }
				}
			}
		}
		### In transit: the leg flown so far, the ship on it, and when it lands
		### (the card's track, at the page's width).
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 8
			block "fl_transit_visible" {}

			widget = {
				size = { 472 18 }
				parentanchor = vcenter

				default_progressbar_horizontal = {
					size = { 100% 100% }
					blockoverride "values" {
						block "fl_transit_frac" {}
						min = 0
						max = 1
					}
					blockoverride "on_top_of_the_progressbar" {
						progressbar = {
							noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							size = { 100% 100% }
							skip_initial_animation = yes
							direction = horizontal
							block "fl_transit_frac" {}
							min = 0
							max = 1
							marker = {
								icon = {
									size = { 18 18 }
									parentanchor = vcenter
									widgetanchor = center
									texture = "gfx/interface/icons/space_race_icons/track_ship.dds"
								}
							}
						}
					}
				}
			}
