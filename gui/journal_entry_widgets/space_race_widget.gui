			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_dp_col_enemy"
			tooltip = "je_space_race_widget_dp_col_enemy_tt"
		}
		textbox = {
			size = { 66 20 }
			align = left|nobaseline
			using = te_sr_fontsize_row
