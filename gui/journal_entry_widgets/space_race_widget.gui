								text = "je_space_race_widget_fl_col_marines"
							}
						}
						te_sr_fl_button = {
							blockoverride "fl_btn" {
								block "fl_land_button" {}
							}
							blockoverride "fl_btn_icon" {
								texture = "gfx/interface/icons/space_race_icons/order_land.dds"
							}
							blockoverride "fl_btn_label" {
								text = "je_space_race_widget_fl_land"
							}
						}
						te_sr_fl_button = {
							blockoverride "fl_btn" {
								block "fl_embark_button" {}
							}
							blockoverride "fl_btn_icon" {
								texture = "gfx/interface/icons/space_race_icons/order_embark.dds"
							}
							blockoverride "fl_btn_label" {
								text = "je_space_race_widget_fl_embark"
							}
						}
					}
				}

				te_sr_page_heading = {
					blockoverride "heading_text" {
						text = "je_space_race_widget_locations_header"
					}
				}
				te_sr_location_cells = {}
			}
		}
	}

	### The Fleets window's content (te_sr_fleet_popup): at the left how many
	### fleets we have and each of them on a button (te_sr_fleet_switch_rows,
	### generated), a click showing that fleet; beside them, what Space Fleets
	### says once above its cards (no Space Command, short of personnel; no
	### fleets at all, if the last one goes under the open window), then
	### the shown fleet's page (te_sr_fleet_pages, one te_sr_fleet_page a slot,
	### generated), or one line when the fleet the window was opened on is
	### gone and others are left. 244 + 14 + 960 = 1218.
	type te_sr_fleet_popup_body = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 14

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 2
			minimumsize = { 244 -1 }

			widget = {
				size = { 244 30 }

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 150
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fw_count_label"
				}
				textbox = {
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 86
					align = right|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fw_count_figure"
				}
				divider_clean = {
					parentanchor = bottom|left
					blockoverride "size" {
						size = { 244 2 }
					}
				}
			}
			te_sr_fleet_switch_rows = {}
		}
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 4
			minimumsize = { 960 -1 }

			### With the last fleet gone under the open window, Space Fleets' own
			### line, in place of a page's "choose another" over an empty list.
			te_sr_fleet_wide_note = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_space_fleets_empty"
			}
			te_sr_fleet_wide_note = {
				visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_sc_operational'), '(CFixedPoint)0' ) )]"
				text = "je_space_race_widget_space_fleets_no_sc"
			}
			te_sr_fleet_wide_note = {
				visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_pers_short'), '(CFixedPoint)1' ) )]"
				text = "je_space_race_widget_space_fleets_short"
			}
			te_sr_fleet_pages = {}
		}
	}

	### A line across the Fleets window's page column (te_sr_text at its 960).
	type te_sr_fleet_wide_note = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 960 -1 }
		maximumsize = { 960 -1 }
		align = left|nobaseline
		using = te_sr_fontsize_row
	}

	### The Fleets window (the owner, 2026-11-25): a fleet's page, with every
	### fleet we have a click away at its left. Opened on a fleet by the arrow
	### at the head of its card in Space Fleets; instanced in te_popups
	### (gui/te_popups.gui). It is up while the client-side key sr_fleet_focus
	### exists, its value the slot shown, and NOT on te_popup, which the
	### pickers its orders open (destination, target, Transfer, Marines) take:
	### they draw over this window, and closing one, or choosing in it, comes
	### back here (seen in game, 2026-11-25: Choose, Transfer and a click
	### outside a picker). While one is up this window's two close buttons are
	### hidden, so its click outside reaches the picker alone (seen), and so
	### should Escape, the header button's shortcut (not yet tried: a hidden
	### button taking no shortcut is the assumption). A page may open only
	### popups instanced after this window in te_popups: one drawn under it
	### would hide its close buttons with nothing in reach
	### (test_space_fleet_window.py holds the page to the four pickers). The
	### content sits under the entry's scope-free gate and its
	### GetPlayerJournalEntry datacontext on a child, as the Colonies window's
	### (gotchas #22, #29). 1218 of content, plus the window's margins
	### (2 × 35), the list's (2 × 10) and a scrollbar: 1332. 880 high: the
	### window's own 108 (measured in game), the page's picture (220) and head
	### (58), then the taller column, Orders over Locations (30 + 26 + 20 + 46
	### + 26 + 3 × 20 + 26 + 30 + 150, and the gaps: about 460).
	type te_sr_fleet_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.Exists('sr_fleet_focus')]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_fw_title"
		}
		blockoverride "popup_size" {
			size = { 1332 880 }
		}
		blockoverride "popup_close" {
			visible = "[Not( GetVariableSystem.Exists('te_popup') )]"
			onclick = "[GetVariableSystem.Clear('sr_fleet_focus')]"
		}
		blockoverride "popup_list" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				datacontext = "[GetPlayer]"
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_space_race_solar_colonization')]"
					direction = vertical
					ignoreinvisible = yes

					te_sr_fleet_popup_body = {}
				}
			}
			te_sr_note = {
				visible = "[Not( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "je_space_race_widget_tp_gone"
			}
		}
	}

	### Everything a returning player checks, open by default.
	type te_sr_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_sr_sec_control = {
