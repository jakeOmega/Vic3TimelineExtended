	### One power in Space Powers: its name on a line of its own (a name can
	### run to 48 characters, which no column beside the icons holds), then its
	### programme as eight small icons in journal order (te_sr_ov_programme's
	### order), and, in a fixed column beside them, its furthest milestone
	### under way with its progress (lead_column: te_sr_power_lead_band for a
	### rival, te_sr_power_lead_own for us). 8 x 24 + 8 x 2 + 270 = 478, inside
	### the 480 column. Our row sets the datacontext on the inner container
	### ("row_context"); the others are items of the Space Powers datamodel,
	### each with its capital as the item's datacontext.
	type te_sr_power_row = widget {
		size = { 480 50 }

		flowcontainer = {
			direction = vertical
			spacing = 4
			block "row_context" {}

			textbox = {
				minimumsize = { 480 -1 }
				maximumsize = { 480 -1 }
				autoresize = yes
				elide = right
				align = left|nobaseline
				using = te_sr_fontsize_row
				text = "je_space_race_widget_rival_name"
				tooltip = "je_space_race_widget_power_name_tt"
			}
			flowcontainer = {
				direction = horizontal
				spacing = 2

				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_suborbital"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_suborbital.dds"
					}
					blockoverride "lit" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)3' )]"
					}
					blockoverride "running" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)1' )]"
					}
					blockoverride "unlit" {
						visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)3' ) ), NotEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "first" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)4' )]"
					}
				}
				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_orbital"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_orbital.dds"
					}
					blockoverride "lit" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_orbital'), '(CFixedPoint)3' )]"
					}
					blockoverride "running" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_orbital'), '(CFixedPoint)1' )]"
					}
					blockoverride "unlit" {
						visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_orbital'), '(CFixedPoint)3' ) ), NotEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_orbital'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "first" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_orbital'), '(CFixedPoint)4' )]"
					}
				}
				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_moon_landing"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_moon_landing.dds"
					}
					blockoverride "lit" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_landing'), '(CFixedPoint)3' )]"
					}
					blockoverride "running" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_landing'), '(CFixedPoint)1' )]"
					}
					blockoverride "unlit" {
						visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_landing'), '(CFixedPoint)3' ) ), NotEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_landing'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "first" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_landing'), '(CFixedPoint)4' )]"
					}
				}
				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_probe"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_probe.dds"
					}
					blockoverride "lit" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_probe'), '(CFixedPoint)3' )]"
					}
					blockoverride "running" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_probe'), '(CFixedPoint)1' )]"
					}
					blockoverride "unlit" {
						visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_probe'), '(CFixedPoint)3' ) ), NotEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_probe'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "first" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_probe'), '(CFixedPoint)4' )]"
					}
				}
				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_moon_base"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_moon_base.dds"
					}
					blockoverride "lit" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_base'), '(CFixedPoint)3' )]"
					}
					blockoverride "running" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_base'), '(CFixedPoint)1' )]"
					}
					blockoverride "unlit" {
						visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_base'), '(CFixedPoint)3' ) ), NotEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_base'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "first" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_moon_base'), '(CFixedPoint)4' )]"
					}
				}
				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_mars_landing"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_mars_landing.dds"
					}
					blockoverride "lit" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_mars_landing'), '(CFixedPoint)3' )]"
					}
					blockoverride "running" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_mars_landing'), '(CFixedPoint)1' )]"
					}
					blockoverride "unlit" {
						visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_mars_landing'), '(CFixedPoint)3' ) ), NotEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_mars_landing'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "first" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_mars_landing'), '(CFixedPoint)4' )]"
					}
				}
				te_sr_power_cell_interstellar = {}
				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_solar_colonization"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
					}
					blockoverride "lit" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_solar_colonization'), '(CFixedPoint)3' )]"
					}
					blockoverride "running" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_solar_colonization'), '(CFixedPoint)1' )]"
					}
					blockoverride "unlit" {
						visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_solar_colonization'), '(CFixedPoint)3' ) ), NotEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_solar_colonization'), '(CFixedPoint)1' ) )]"
					}
				}
				block "lead_column" {}
			}
		}
	}

	### Space Powers: our program, then every other power in the race,
	### furthest along first: a datamodel of the viewer's list sr_powers_list,
	### the powers' capitals (sr_powers_refresh, space_race_effects.txt, once a
	### month; audit SPC-9). A live list, open by default (style guide rule 1).
	### Our row reads our capital straight (GetPlayer.GetCapital), so it shows
	### before the first refresh too.
	type te_sr_sec_powers = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_powers_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_powers_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_powers_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_powers_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_powers_closed'))]"

			te_sr_power_row = {
				blockoverride "row_context" {
					datacontext = "[GetPlayer.GetCapital]"
				}
				blockoverride "lead_column" {
					te_sr_power_lead_own = {}
				}
			}
			te_sr_subheader = {
				blockoverride "subheader_text" {
					text = "je_space_race_widget_powers_others"
				}
			}
			te_sr_text = {
				visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_power_total'), '(CFixedPoint)0' ) )]"
				text = "je_space_race_widget_powers_pending"
			}
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_power_total'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_powers_none"
			}

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 2
				datamodel = "[GetPlayer.MakeScope.GetList('sr_powers_list')]"

				item = {
					te_sr_power_row = {
						datacontext = "[Scope.GetState]"
						blockoverride "lead_column" {
							te_sr_power_lead_band = {}
						}
					}
				}
			}
		}
	}

	### Orbit: what the anti-satellite strike and debris mean for us now
	### (Global Commons § 6), for a player between milestones too. Orbital
	### debris (Mission Control's own row, which reads only globals and the
	### player), our satellites, the strikes so far, the Moratorium and our own
	### strike; each row's hover gives the detail. A live section, open by
	### default. The figures: te_orbital_debris_values.txt (te_asat_disp_*), the
	### words: te_orbital_debris_custom_loc.txt, the hovers' lists:
	### common/scripted_guis/te_orbital_debris_sguis.txt.
	type te_sr_sec_orbit = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
