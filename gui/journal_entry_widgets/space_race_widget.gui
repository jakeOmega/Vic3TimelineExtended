flowcontainer = {
	name = "widget_je_space_race_probe"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	spacing = 4

	visible = "[JournalEntry.IsActive]"

	widget_je_sr_milestone_panel = {
		blockoverride "panel_context" {
			datacontext = "[GetScriptedGui('sr_milestone_probe_sgui')]"
		}
		blockoverride "panel_tooltip" {
			tooltip = "je_space_race_widget_reward_probe"
		}
		blockoverride "panel_progress" {
			text = "je_space_race_widget_progress_probe"
		}
		blockoverride "panel_pace" {
			text = "je_space_race_widget_pace_probe"
		}
		blockoverride "panel_note" {
			text = "je_space_race_widget_note_probe"
		}
		blockoverride "panel_profile" {
			text = "je_space_race_widget_profile_probe"
		}

		blockoverride "panel_controls" {
