	### A section's heading on a colony's page: its title with a rule under it,
	### and on the right the section's control (Settlers' priority, Clear,
	### Abandon), each of a fixed size, so nothing drifts (style guide rule 8).
	### 472 wide, the row's inner width.
	type te_sr_page_heading = widget {
		size = { 472 30 }

		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 300
			align = left|nobaseline
			using = te_sr_fontsize_heading
			default_format = "#title"
			elide = right
			block "heading_text" {}
		}
		flowcontainer = {
			parentanchor = right|vcenter
			direction = horizontal
			spacing = 6
			ignoreinvisible = yes
			block "heading_controls" {}
		}
		divider_clean = {
			parentanchor = bottom|left
			blockoverride "size" {
				size = { 472 2 }
			}
		}
	}

	### A reading on a colony's page (style guide rule 4): its icon in an inset
	### box of its own, the caption over the figure, the hover on the whole tile.
	### Two to a row: 2 x 233 + 6 = 472. The figure's column is 233 - 54 = 179.
	type te_sr_page_tile = widget {
		size = { 233 50 }
		block "tile_tooltip" {}

		background = {
			using = entry_bg_simple
		}
		widget = {
			size = { 42 42 }
			position = { 4 0 }
			parentanchor = left|vcenter

			background = {
				using = dark_area
				alpha = 0.3
			}
			icon = {
				size = { 34 34 }
				parentanchor = center
				block "tile_icon" {}
			}
		}
		textbox = {
			position = { 54 3 }
			autoresize = yes
			max_width = 175
			elide = right
			align = left|nobaseline
			using = te_sr_fontsize_overview
			block "tile_caption" {}
		}
		flowcontainer = {
			position = { 54 23 }
			direction = horizontal
			spacing = 4
			ignoreinvisible = yes
			block "tile_value" {}
		}
	}

	### A tile's figure, or a word beside a heading.
	type te_sr_page_value = textbox {
		autoresize = yes
		max_width = 175
		parentanchor = vcenter
		align = left|nobaseline
		using = te_sr_fontsize_row
		elide = right
	}

	### A module on a colony's page: its icon, its full name (its hover what the
	### module does), its level and "+N" queued or on its way, the button that
	### queues one more and the one that takes a level down, or stops it
	### (dismantling, owner 2026-10-31). 4 + 28 + 4 + 318 + 4 + 20 + 4 + 24 + 4 +
	### 24 + 4 + 24 = 466, in 472. While a level comes down, a second line under
	### the name says so, with its months to go.
	type te_sr_page_mod_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		widget = {
			size = { 472 28 }

			flowcontainer = {
				parentanchor = left|vcenter
				direction = horizontal
				spacing = 4
				margin_left = 4

				widget = {
					size = { 28 28 }
					parentanchor = vcenter

					background = {
						using = dark_area
						alpha = 0.3
					}
					icon = {
						size = { 24 24 }
						parentanchor = center
						block "row_icon" {}
					}
				}
				widget = {
					size = { 318 28 }
					parentanchor = vcenter

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 318
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "row_name" {}
					}
				}
				widget = {
					size = { 20 28 }
					parentanchor = vcenter

					textbox = {
						parentanchor = center
						autoresize = yes
						max_width = 20
						align = center|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "row_level" {}
					}
				}
				widget = {
					size = { 24 28 }
					parentanchor = vcenter

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 24
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						default_format = "#v"
						block "row_pending" {}
					}
				}
				widget = {
					size = { 24 28 }
					parentanchor = vcenter

					button_icon_plus_action = {
						size = { 22 22 }
						parentanchor = center
						block "row_button" {}
					}
				}
				widget = {
					size = { 24 28 }
					parentanchor = vcenter

					button_icon_minus_action = {
						size = { 22 22 }
						parentanchor = center
						block "row_dismantle" {}
					}
				}
			}
		}
		### Coming down: under the name (4 + 28 + 4 = 36 in), its months to go.
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin_left = 36
			tooltip = "je_space_race_widget_mod_dismantling_tt"
			block "row_dismantling" {}

			textbox = {
				parentanchor = vcenter
				autoresize = yes
				max_width = 300
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#R"
				text = "je_space_race_widget_mod_coming_down"
			}
			textbox = {
				parentanchor = vcenter
				autoresize = yes
				max_width = 60
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#v"
				block "row_dismantling_months" {}
			}
		}
	}

	### A module cell of te_sr_colony_row: its label (its hover what the module
	### does), its level, "+N" queued or on its way, and a button that queues one
	### more. 38 + 12 + 20 + 20 = 90.
	type te_sr_mod_cell = flowcontainer {
		direction = horizontal
		ignoreinvisible = no
		spacing = 0
		parentanchor = vcenter

		widget = {
			size = { 38 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 38
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "cell_label" {}
			}
		}
		widget = {
			size = { 12 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = center
				autoresize = yes
				max_width = 12
				align = center|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "cell_level" {}
			}
		}
		widget = {
			size = { 20 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 20
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#v"
				block "cell_pending" {}
			}
		}
		button_icon_plus_action = {
			size = { 20 20 }
			parentanchor = vcenter
			block "cell_button" {}
		}
	}

	### A button of the Colonies view switch, 112 wide: greyed while its view is
	### shown (the radio pattern of the Demographics history's range buttons).
	type te_sr_colony_view_button = button {
		using = default_button
		size = { 112 28 }
		parentanchor = vcenter
		block "view_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 106
			elide = right
			using = te_sr_fontsize_row
			block "view_label" {}
		}
	}

	### Colonies (solar colonization; audit SPC-5): every colony we hold, in one
	### table, each in its own box (a colony's name opens its page: colony
	### management design § 8), where the colony sections of slices 2-6 (Our Colonies, Settlers,
	### Colony Modules, Colony Autonomy, Colony Defences) each gave one aspect of
	### the same worlds. Under Simple and Full Colonies a switch above the rows
	### picks the view (GetVariableSystem's sr_colony_view: People, the default,
	### Modules, Autonomy, and under Full Colonies Defenses); each view's
	### section-wide figures and controls sit under the switch, its column heads
	### over the rows, and Autonomy's free colonies after them. Under Races Only
	### the rows are the colonies' names, whose hovers give their
	### specializations' effects. Listed for as long as we hold one, whether or
	### not the program runs. Open by default; the flag is sr_panel_colonies_closed.
	type te_sr_sec_colonies = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_colonies_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_colonies_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_colonies_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_colonies_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_colonies_closed'))]"

			te_sr_value_row = {
				blockoverride "row_label" {
					text = "je_space_race_widget_colonies_held_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_colonies_held_figure"
				}
			}
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_colonies_empty"
			}

			### The view switch (Simple and Full Colonies), said once above the rows.
			flowcontainer = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
				direction = horizontal
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 4
				margin = { 0 4 }

				te_sr_colony_view_button = {
					tooltip = "je_space_race_widget_cv_people_tt"
					blockoverride "view_button" {
						enabled = "[Not( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), Not( Or( GetVariableSystem.HasValue('sr_colony_view', 'modules'), Or( GetVariableSystem.HasValue('sr_colony_view', 'autonomy'), Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), GetVariableSystem.HasValue('sr_colony_view', 'detail') ) ) ) ) ) )]"
						onclick = "[GetVariableSystem.Clear('sr_colony_view')]"
					}
					blockoverride "view_label" {
						text = "je_space_race_widget_cv_people"
					}
				}
				te_sr_colony_view_button = {
					tooltip = "je_space_race_widget_cv_modules_tt"
					blockoverride "view_button" {
						enabled = "[Not( GetVariableSystem.HasValue('sr_colony_view', 'modules') )]"
						onclick = "[GetVariableSystem.Set('sr_colony_view', 'modules')]"
					}
					blockoverride "view_label" {
						text = "je_space_race_widget_cv_modules"
					}
				}
				te_sr_colony_view_button = {
					tooltip = "je_space_race_widget_cv_autonomy_tt"
					blockoverride "view_button" {
						enabled = "[Not( GetVariableSystem.HasValue('sr_colony_view', 'autonomy') )]"
						onclick = "[GetVariableSystem.Set('sr_colony_view', 'autonomy')]"
					}
					blockoverride "view_label" {
						text = "je_space_race_widget_cv_autonomy"
					}
				}
				te_sr_colony_view_button = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' )]"
					tooltip = "je_space_race_widget_cv_defences_tt"
					blockoverride "view_button" {
						enabled = "[Not( GetVariableSystem.HasValue('sr_colony_view', 'defences') )]"
						onclick = "[GetVariableSystem.Set('sr_colony_view', 'defences')]"
					}
					blockoverride "view_label" {
						text = "je_space_race_widget_cv_defences"
					}
				}
			}

			### People: the emigration program, the settlers it sends, our people off Earth.
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), Not( Or( GetVariableSystem.HasValue('sr_colony_view', 'modules'), Or( GetVariableSystem.HasValue('sr_colony_view', 'autonomy'), Or( And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'defences') ), GetVariableSystem.HasValue('sr_colony_view', 'detail') ) ) ) ) )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				### Emigration (sr_settlers_sgui): op 0 down, op 1 up, beside the level, as funding is.
				flowcontainer = {
					direction = horizontal
					spacing = 4
					ignoreinvisible = yes
					margin = { 4 1 }

					textbox = {
						text = "je_space_race_widget_emig_label"
						size = { 110 26 }
						align = left|nobaseline
						using = te_sr_fontsize_row
						parentanchor = vcenter
						elide = right
					}

					button_icon_minus_action = {
						size = { 26 26 }
						parentanchor = vcenter
						enabled = "[GetScriptedGui('sr_settlers_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						onclick = "[GetScriptedGui('sr_settlers_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_settlers_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_settlers_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End ) ) )]"
					}

					widget = {
						size = { 84 26 }
						parentanchor = vcenter

						textbox = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)0' )]"
							text = "je_space_race_widget_emig_level_0"
							size = { 84 26 }
							align = center|nobaseline
							using = te_sr_fontsize_row
							elide = right
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)1' )]"
							text = "je_space_race_widget_emig_level_1"
							size = { 84 26 }
							align = center|nobaseline
							using = te_sr_fontsize_row
							elide = right
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)2' )]"
							text = "je_space_race_widget_emig_level_2"
							size = { 84 26 }
							align = center|nobaseline
							using = te_sr_fontsize_row
							elide = right
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)3' )]"
							text = "je_space_race_widget_emig_level_3"
							size = { 84 26 }
							align = center|nobaseline
							using = te_sr_fontsize_row
							elide = right
						}
					}

					button_icon_plus_action = {
						size = { 26 26 }
						parentanchor = vcenter
						enabled = "[GetScriptedGui('sr_settlers_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						onclick = "[GetScriptedGui('sr_settlers_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_settlers_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_settlers_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
					}
				}

				te_sr_value_row = {
					tooltip = "je_space_race_widget_emig_month_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_emig_month_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_emig_month_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_offworld_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_offworld_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_offworld_figure"
					}
				}
			}

			### Modules: fabrication, shipments, upkeep, the Extraplanetary Base room,
			### then the queue in its own box, in order (place 1 is built next).
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'modules') )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				te_sr_value_row = {
					tooltip = "je_space_race_widget_fab_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_fab_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_fab_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_shipments_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_shipments_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_shipments_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_mod_upkeep_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_mod_upkeep_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_mod_upkeep_figure"
					}
				}
				te_sr_value_row = {
					tooltip = "je_space_race_widget_ebase_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_ebase_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_ebase_figure"
					}
				}
				### The levels queued and not yet built, while there are any
				### (UI pass design § 8).
				te_sr_value_row = {
					visible = "[GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_ebase_queued'), '(CFixedPoint)0' )]"
					tooltip = "je_space_race_widget_ebase_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_ebase_queued_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_ebase_queued_figure"
					}
				}
				### The queue on its own (the owner, 2026-10-31: "visually separate
				### the Queue better"): its heading with the count, then an inset
				### box holding when the next module is built and the places, and
				### a gap before the colonies' rows.
				flowcontainer = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_1'), '(CFixedPoint)1' )]"
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					margin_bottom = 8

					te_sr_subheader = {
						blockoverride "subheader_text" {
							text = "je_space_race_widget_mq_header"
						}
					}
					flowcontainer = {
						direction = vertical
						ignoreinvisible = yes
						spacing = 2
						margin = { 0 4 }

						background = {
							using = dark_area
							alpha = 0.3
						}

						te_sr_value_row = {
							tooltip = "je_space_race_widget_mq_next_tt"
							blockoverride "row_label" {
								text = "je_space_race_widget_mq_next_label"
							}
							blockoverride "row_value" {
								text = "[SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)3' ), 'je_space_race_widget_mq_next_none', SelectLocalization( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_next_state'), '(CFixedPoint)2' ), 'je_space_race_widget_mq_next_full', 'je_space_race_widget_mq_next_months' ) )]"
							}
						}
						te_sr_mq_rows = {}
					}
				}
			}

			### Autonomy: what the free colonies we supply trade us.
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'autonomy') )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				te_sr_value_row = {
					tooltip = "je_space_race_widget_free_trade_tt"
					blockoverride "row_label" {
						text = "je_space_race_widget_free_trade_label"
					}
					blockoverride "row_value" {
						text = "je_space_race_widget_free_trade_figure"
					}
				}
			}

			### A colony's page (colony management design § 8): Back to the list.
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'detail') )]"
				direction = horizontal
				ignoreinvisible = yes
				margin = { 0 2 }

				te_sr_colony_view_button = {
					tooltip = "je_space_race_widget_cv_back_tt"
					blockoverride "view_button" {
						onclick = "[GetVariableSystem.Clear('sr_colony_view')]"
					}
					blockoverride "view_label" {
						text = "je_space_race_widget_cv_back"
					}
				}
			}

			### The rows, under the view's column heads.
			te_sr_colony_head_row = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_held'), '(CFixedPoint)1' ) )]"
			}
			te_sr_colony_rows = {}

			### Autonomy: the free colonies, with our ties and Supply.
			flowcontainer = {
				visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'autonomy') )]"
				direction = vertical
				ignoreinvisible = yes
				spacing = 2

				te_sr_subheader = {
					blockoverride "subheader_text" {
						text = "je_space_race_widget_free_header"
					}
				}
				te_sr_text = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_free_count'), '(CFixedPoint)0' )]"
					text = "je_space_race_widget_free_empty"
				}
				te_sr_free_rows = {}
			}
		}
	}

	### One world in Solar System (te_sr_sec_solar_system): its icon and name,
	### then who holds it: "Ours", the holder's flag (vanilla's tiny_flag: the
	### country's name on hover, the country on click; a 48-character name would
	### not fit the row), "Another power" (a holder with no capital to show),
	### "Our target", "Unclaimed" or "Free" (a free colony, slice 5), each on one equality test of
	### sr_disp_site_<key> and sr_disp_site_target_<key>
	### (sr_sites_display_generated.txt). The flag reads the holder's capital,
	### stored on the viewer by sr_sites_refresh_snapshot (sr_ss_cap_<key>),
	### through the inner container's datacontext, as the Rivals rows do
	### (gui_modding_guide.md gotcha #15): its visible is on the outer
	### container, so an empty slot is never read. Then the colony fleets on
	### their way there (simple and full colonies; slices 2-3 design § 8). The
	### fleets read "count·months": how many are on their way and the months
	### until the first lands, highlighted when the first is ours. The name's
	### hover is what the world offers: its stage, its two specializations'
	### effects, our drive's transit there and its next window
	### (je_space_race_widget_ss_site_tt_<key>, audit SPC-7). Under it, slots
	### and Extraplanetary Base room (Simple and Full Colonies).
	### Two lists instance it, both generated (sr_sites_generated_rows.gui):
	### - Solar System (te_sr_solar_system_rows), a list to read: no window, no
	###   button. 24 icon + 180 name + 122 holder + 65 inbound + 3 × 3 spacing
	###   + 2 × 4 margin = 408, in the column. Shown while Solar System lists
	###   every world or the world is one our fleets can go to, ours, or one a
	###   fleet is bound for.
	### - The colony target popup (te_sr_target_picker_rows, UI pass design
	###   § 5): the launch window toward it (te_sr_site_window_cell, block
	###   site_window) and the Target button (sr_colony_target_sgui,
	###   scope:site = the world's index; Clear on our target), on every world
	###   so a greyed one says why. 391 + 152 window + 66 button + 5 × 3
	###   spacing + 2 × 4 margin = 632, in the popup's 760. Shown while the popup lists every world or we can
	###   target it.
	type te_sr_site_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		margin = { 4 1 }
		block "site_visible" {}

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 3

			widget = {
				size = { 24 24 }
				parentanchor = vcenter

				icon = {
					size = { 24 24 }
					parentanchor = center
					block "site_icon" {}
				}
			}
			widget = {
				size = { 180 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 180
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "site_name" {}
				}
			}
			widget = {
				size = { 122 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					default_format = "#v"
					text = "je_space_race_widget_ss_ours"
					block "site_ours_visible" {}
				}
				flowcontainer = {
					parentanchor = left|vcenter
					ignoreinvisible = yes
					block "site_other_visible" {}

					flowcontainer = {
						direction = horizontal
						spacing = 4
						ignoreinvisible = yes
						block "site_context" {}

						widget = {
							size = { 28 24 }
							parentanchor = vcenter

							tiny_flag = {
								parentanchor = center
								datacontext = "[State.GetCountry]"
							}
						}
					}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_ss_unknown"
					block "site_unknown_visible" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					default_format = "#v"
					text = "je_space_race_widget_ss_target"
					block "site_target_mark_visible" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					default_format = "#grey"
					text = "je_space_race_widget_ss_unclaimed"
					block "site_unclaimed_visible" {}
				}
				### A free colony (slice 5 design § 9): claimed, no holder.
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_ss_free_tt"
					text = "je_space_race_widget_ss_free"
					block "site_free_visible" {}
				}
				### Occupied, and ruined (Full Colonies; slice 6 design § 16).
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_ss_occupied_tt"
					text = "je_space_race_widget_ss_occupied"
					block "site_occupied_visible" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					tooltip = "je_space_race_widget_ss_ruined_tt"
					text = "je_space_race_widget_ss_ruined"
					block "site_ruined_visible" {}
				}
			}
			### Fleets on their way: the colonization entry's icon and their number;
			### on hover the first's landing and whether it is ours.
			widget = {
				size = { 65 24 }
				parentanchor = vcenter

				flowcontainer = {
					direction = horizontal
					spacing = 2
					ignoreinvisible = yes
					parentanchor = left|vcenter
					block "site_inbound" {}

					icon = {
						size = { 16 16 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 47
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_inbound_ours" {}
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 47
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "site_inbound_rival" {}
					}
				}
			}
			block "site_window" {}
			button = {
				using = default_button_action
				size = { 66 24 }
				parentanchor = vcenter
				block "site_target_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 62
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_target_button"
					block "site_target_set_visible" {}
				}
				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 62
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_target_clear"
					block "site_target_clear_visible" {}
				}
			}
		}
		### Under the name, what the site offers a colony (the owner, 2026-10-30:
