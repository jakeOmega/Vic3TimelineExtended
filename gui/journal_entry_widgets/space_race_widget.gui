		}
		te_sr_subheader = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
			blockoverride "subheader_text" {
				text = "je_space_race_widget_howc_sub_autonomy"
			}
		}
		te_sr_note = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
			text = "je_space_race_widget_howc_autonomy"
		}
		te_sr_subheader = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' )]"
			blockoverride "subheader_text" {
				text = "je_space_race_widget_howc_sub_space_command"
			}
		}
		te_sr_note = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' )]"
			text = "je_space_race_widget_howc_space_command"
		}
		te_sr_subheader = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' )]"
			blockoverride "subheader_text" {
				text = "je_space_race_widget_howc_sub_defences"
			}
		}
		te_sr_note = {
			visible = "[EqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' )]"
			text = "je_space_race_widget_howc_defences"
		}
