		widget = {
			size = { 176 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 176
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "mq_module" {}
			}
		}
		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			button_icon_round_action = {
				size = { 24 24 }
				blockoverride "icon" {
					texture = "gfx/interface/icons/generic_icons/up_up.dds"
				}
