						using = fontsize_medium
						elide = right
					}
					textbox = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)1' )]"
						text = "je_space_race_widget_emig_level_1"
						size = { 84 26 }
						align = center|nobaseline
						using = fontsize_medium
						elide = right
					}
					textbox = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)2' )]"
						text = "je_space_race_widget_emig_level_2"
						size = { 84 26 }
						align = center|nobaseline
						using = fontsize_medium
						elide = right
					}
					textbox = {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_emig_level'), '(CFixedPoint)3' )]"
						text = "je_space_race_widget_emig_level_3"
						size = { 84 26 }
						align = center|nobaseline
						using = fontsize_medium
						elide = right
