	### A section's heading on a colony's page: its title with a rule under it,
	### and on the right the section's control (Settlers' priority, Clear,
	### Abandon), each of a fixed size, so nothing drifts (style guide rule 8).
	### 472 wide, the row's inner width.
	type te_sr_page_heading = widget {
		size = { 472 30 }

		textbox = {
			parentanchor = left|vcenter
			autoresize = yes
			max_width = 300
			align = left|nobaseline
			using = te_sr_fontsize_heading
			default_format = "#title"
			elide = right
			block "heading_text" {}
		}
		flowcontainer = {
			parentanchor = right|vcenter
			direction = horizontal
			spacing = 6
			ignoreinvisible = yes
			block "heading_controls" {}
		}
		divider_clean = {
			parentanchor = bottom|left
			blockoverride "size" {
				size = { 472 2 }
			}
		}
	}

	### A reading on a colony's page (style guide rule 4): its icon in an inset
	### box of its own, the caption over the figure, the hover on the whole tile.
	### Two to a row: 2 x 233 + 6 = 472. The figure's column is 233 - 54 = 179.
	type te_sr_page_tile = widget {
		size = { 233 50 }
		block "tile_tooltip" {}

		background = {
			using = entry_bg_simple
		}
		widget = {
			size = { 42 42 }
			position = { 4 0 }
			parentanchor = left|vcenter

			background = {
				using = dark_area
				alpha = 0.3
			}
			icon = {
				size = { 34 34 }
				parentanchor = center
				block "tile_icon" {}
			}
		}
		textbox = {
			position = { 54 3 }
			autoresize = yes
			max_width = 175
			elide = right
			align = left|nobaseline
			using = te_sr_fontsize_overview
			block "tile_caption" {}
		}
		flowcontainer = {
			position = { 54 23 }
			direction = horizontal
			spacing = 4
			ignoreinvisible = yes
			block "tile_value" {}
		}
	}

	### A tile's figure, or a word beside a heading.
	type te_sr_page_value = textbox {
		autoresize = yes
		max_width = 175
		parentanchor = vcenter
		align = left|nobaseline
		using = te_sr_fontsize_row
		elide = right
	}

	### A discovery's boon under a module on a colony's page (row_boons): the
	### discovery's name and +100%, its hover the outcome (gen_solar_sites
	### _boon_lines fills one per discovery that boosts the module there).
	type te_sr_page_boon_line = textbox {
		autoresize = yes
		max_width = 430
		align = left|nobaseline
		using = te_sr_fontsize_row
		elide = right
	}

	### A module on a colony's page: its icon, its full name (its hover what the
	### module does), its level and "+N" queued or on its way, the button that
	### queues one more and the one that takes a level down, or stops it
	### (dismantling, owner 2026-10-31). 4 + 28 + 4 + 318 + 4 + 20 + 4 + 24 + 4 +
	### 24 + 4 + 24 = 466, in 472. While a level comes down, a second line under
	### the name says so, with its months to go; under that, a line for each
	### discovery there that makes the module stronger (row_boons).
	type te_sr_page_mod_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		widget = {
			size = { 472 28 }

			flowcontainer = {
				parentanchor = left|vcenter
				direction = horizontal
				spacing = 4
				margin_left = 4

				widget = {
					size = { 28 28 }
					parentanchor = vcenter

					background = {
						using = dark_area
						alpha = 0.3
					}
					icon = {
						size = { 24 24 }
						parentanchor = center
						block "row_icon" {}
					}
				}
				widget = {
					size = { 318 28 }
					parentanchor = vcenter

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 318
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "row_name" {}
					}
				}
				widget = {
					size = { 20 28 }
					parentanchor = vcenter

					textbox = {
						parentanchor = center
						autoresize = yes
						max_width = 20
						align = center|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "row_level" {}
					}
				}
				widget = {
					size = { 24 28 }
					parentanchor = vcenter

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 24
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						default_format = "#v"
						block "row_pending" {}
					}
				}
				widget = {
					size = { 24 28 }
					parentanchor = vcenter

					button_icon_plus_action = {
						size = { 22 22 }
						parentanchor = center
						block "row_button" {}
					}
				}
				widget = {
					size = { 24 28 }
					parentanchor = vcenter

					button_icon_minus_action = {
						size = { 22 22 }
						parentanchor = center
						block "row_dismantle" {}
					}
				}
			}
		}
		### Coming down: under the name (4 + 28 + 4 = 36 in), its months to go.
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin_left = 36
			tooltip = "je_space_race_widget_mod_dismantling_tt"
			block "row_dismantling" {}

			textbox = {
				parentanchor = vcenter
				autoresize = yes
				max_width = 300
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#R"
				text = "je_space_race_widget_mod_coming_down"
			}
			textbox = {
				parentanchor = vcenter
				autoresize = yes
				max_width = 60
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#v"
				block "row_dismantling_months" {}
			}
		}
		### A discovery's boon (gen_solar_sites.DISCOVERY_BOONS; the owner,
		### 2026-11-25): under the name, a line for each of the world's
		### discoveries whose outcome makes this module stronger there, naming
		### the discovery, its hover the outcome. Hidden where none does.
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin_left = 36
			block "row_boons" {
				visible = no
			}
		}
	}

