				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "free_people" {}
			}
		}
		widget = {
			size = { 44 24 }
			parentanchor = vcenter
			tooltip = "je_space_race_widget_free_ties_tt"

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
