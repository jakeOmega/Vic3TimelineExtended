		widget = {
			size = { 64 24 }
			parentanchor = vcenter

			flowcontainer = {
				direction = horizontal
				spacing = 2
				ignoreinvisible = yes
				parentanchor = left|vcenter
				block "loc_inbound" {}

				icon = {
					size = { 16 16 }
					parentanchor = vcenter
					texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
				}
				textbox = {
					parentanchor = vcenter
					autoresize = yes
					max_width = 60
					align = left|nobaseline
					using = fontsize_small
					elide = right
					default_format = "#v"
					block "loc_inbound_ours" {}
				}
				textbox = {
					parentanchor = vcenter
					autoresize = yes
					max_width = 60
					align = left|nobaseline
					using = fontsize_small
					elide = right
					block "loc_inbound_rival" {}
				}
			}
		}
		widget = {
			size = { 106 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 106
				align = left|nobaseline
				using = fontsize_small
				elide = right
				default_format = "#R"
				tooltip = "je_space_race_widget_loc_battle_tt"
				text = "je_space_race_widget_loc_status_battle"
