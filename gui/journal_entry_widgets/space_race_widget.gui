	### One location in Locations: its name, our strength there, the strongest
	### other power's flag (its capital stored on the viewer, sr_ls_cap_<loc>,
	### gotcha #15) and every other power's strength there, exact (fleets in
	### space are seen), the fleets on their way ("count·months", highlighted
	### when the first is ours), and from 6b its status (a battle this month, our
	### colonies there blockaded, our blockade of an enemy's; from 6c, our
	### colonies interdicted, our interdiction). 150 + 56 + 80 + 64 + 106 +
	### 4 × 4 + 2 × 4 = 480, the column. Instances in te_sr_location_rows
	### (sr_fleets_generated_rows.gui).
	type te_sr_location_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		widget = {
			size = { 150 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 150
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				block "loc_name" {}
			}
		}
		widget = {
			size = { 56 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 56
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				default_format = "#v"
				block "loc_ours" {}
			}
		}
		widget = {
			size = { 80 24 }
			parentanchor = vcenter

			flowcontainer = {
				parentanchor = left|vcenter
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes

				flowcontainer = {
					ignoreinvisible = yes
					block "loc_flag_visible" {}

					flowcontainer = {
						ignoreinvisible = yes
						block "loc_context" {}

						widget = {
							size = { 28 24 }
							parentanchor = vcenter

							tiny_flag = {
								parentanchor = center
