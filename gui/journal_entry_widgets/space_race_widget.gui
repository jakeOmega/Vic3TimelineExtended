		### Autonomy: autonomy, and its drift a month (that colony's terms on hover).
		flowcontainer = {
			visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ), GetVariableSystem.HasValue('sr_colony_view', 'autonomy') )]"
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin_left = 28

			widget = {
				size = { 80 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_autonomy_figure_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 80
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "aut_figure" {}
				}
			}
			widget = {
				size = { 70 24 }
				parentanchor = vcenter
				block "aut_drift_tooltip" {}

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 70
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "aut_drift" {}
				}
			}
			widget = {
				size = { 104 24 }
				parentanchor = vcenter
				block "aut_build_tooltip" {}

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 104
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "aut_build" {}
				}
			}
		}
