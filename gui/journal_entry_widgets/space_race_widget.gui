	### A colony's page (colony management design § 8, rebuilt on the owner's
	### review of 2026-10-30; a window of its own since the owner's of
	### 2026-11-23, "clicking on a base should open the base in a new window"):
	### one colony in the Colonies window (te_sr_colony_popup): the colony's
	### icon, name and place across the top, then two columns of 472. Left,
	### People, Autonomy, under Full Colonies Defenses, and with In-Situ
	### Resource Utilization its Extraplanetary Base levels (the Bases view's
	### own lines, so a base is assigned here too); right, Modules, the long
	### one. Each section is a heading with its
	### control on the right and its readings in tiles two to a row
	### (te_sr_page_tile); the modules are one to a line with their icons and
	### full names (te_sr_page_mod_row). Every figure, hover and button is a
	### block the list's row has too, so te_sr_colony_pages (generated,
	### sr_sites_generated_rows.gui) fills a page from the row's own overrides.
	### Shown while its colony is the window's (page_visible: sr_colony_focus
	### its key, and ours).
	type te_sr_colony_page = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 6
		block "page_visible" {}

		### The colony: its world's icon, its name (its hover the site's
		### specializations) and where it is.
		widget = {
			size = { 960 58 }

			widget = {
				size = { 48 48 }
				position = { 0 2 }

				background = {
					using = dark_area
					alpha = 0.3
				}
				icon = {
					size = { 40 40 }
					parentanchor = center
					block "colony_icon" {}
				}
			}
			textbox = {
				position = { 58 3 }
				autoresize = yes
				max_width = 880
				align = left|nobaseline
				using = te_sr_fontsize_heading
				default_format = "#title"
				elide = right
				block "colony_name" {}
			}
			textbox = {
				position = { 58 30 }
				autoresize = yes
				max_width = 880
				align = left|nobaseline
				using = te_sr_fontsize_overview
				default_format = "#lore"
				elide = right
				block "page_place" {}
			}
			divider_clean = {
				parentanchor = bottom|left
				blockoverride "size" {
					size = { 960 2 }
				}
			}
		}
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 16

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 4
				minimumsize = { 472 -1 }

				te_sr_page_heading = {
