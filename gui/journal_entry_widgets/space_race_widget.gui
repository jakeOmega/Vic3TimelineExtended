	### One location in a fleet's destination popup: its name, the leg's weeks
	### (ticks of the fleets' clock) and delta-v at the fleet's pace (red when the fleet carries less), from
	### Earth the launch window toward it (Next Windows' "Open now" and "In N
	### months"; blank for other legs: a closed window only raises the delta-v,
	### UI pass design § 4; and blank for a fleet at a torch or antimatter pace
	### (sr_fl_<n>_pace >= 2), which leaves in any month, so the cell would read
	### as a wait it doesn't have), our worlds there, the strength there and on its way
	### of countries at war with us, the battle forecast, and Choose, greyed with the reason where
	### the fleet can't choose; the destination already chosen reads Chosen in
	### vanilla's selected-tab look (the Strategic Reserve's policy choice).
	### Picking closes the popup; Go on the fleet's row sends it. Between the
	### strength on its way and Choose, the battle forecast. 146 + 60 + 60 +
	### 116 + 44 + 56 + 66 + 96 + 72 + 8 × 4 + 2 × 4 = 756.
	type te_sr_dest_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "dr_visible" {}

		widget = {
			size = { 146 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 146
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "dr_name" {}
			}
		}
		widget = {
			size = { 60 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 60
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "dr_weeks" {}
			}
		}
		widget = {
			size = { 60 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 60
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "dr_dv_covered" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 60
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				tooltip = "je_space_race_widget_dp_dv_short_tt"
				block "dr_dv_short" {}
			}
		}
		widget = {
			size = { 116 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 116
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				text = "je_space_race_widget_win_open"
				block "dr_win_open_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 116
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "dr_win_wait" {}
			}
		}
		widget = {
			size = { 44 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 44
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "dr_worlds" {}
			}
		}
		widget = {
			size = { 56 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 56
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "dr_enemy" {}
			}
		}
		widget = {
			size = { 66 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 66
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "dr_inbound" {}
			}
		}
		### The battle forecast with this fleet there (2026-11-25 design
		### § 5.4): the verdict, kept when the popup opened; its hover gives
		### the sums and the loss. Blank, with no hover, where nothing of the
		### enemy's is there or on its way.
		widget = {
			size = { 96 24 }
			parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 96
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fc_tier_0"
					block "dr_battle_0_visible" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 96
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fc_tier_1"
					block "dr_battle_1_visible" {}
					block "dr_battle_tooltip" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 96
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fc_tier_2"
					block "dr_battle_2_visible" {}
					block "dr_battle_tooltip" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 96
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fc_tier_3"
					block "dr_battle_3_visible" {}
					block "dr_battle_tooltip" {}
				}
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 96
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fc_tier_4"
					block "dr_battle_4_visible" {}
					block "dr_battle_tooltip" {}
				}
		}
		widget = {
			size = { 72 24 }
			parentanchor = vcenter

			button = {
				using = default_button_action
				size = { 100% 100% }
				block "dr_choose_visible" {}
				block "dr_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 68
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_dp_choose"
				}
			}
			icon = {
				using = selected_tabs
				size = { 100% 100% }
				tooltip = "je_space_race_widget_dp_chosen_tt"
				block "dr_chosen_visible" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 68
					elide = right
					using = te_sr_fontsize_row
					default_format = "#variable"
					text = "je_space_race_widget_dp_chosen"
				}
			}
		}
	}

	### ======================================================================
	### THE TARGET POPUP (UI pass design § 7)
	### ======================================================================

	### A fleet's target popup, opened by the target button on its row in Space
	### Fleets (te_popup sr_ftarget_<n>); instanced in te_popups. The bodies are
	### te_sr_ftarget_popup_body's, one a slot (sr_fleets_generated_rows.gui),
	### under the entry's scope-free gate and its GetPlayerJournalEntry
	### datacontext, as the destination popup's.
	type te_sr_ftarget_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[Or( Or( Or( GetVariableSystem.HasValue('te_popup', 'sr_ftarget_1'), GetVariableSystem.HasValue('te_popup', 'sr_ftarget_2') ), Or( GetVariableSystem.HasValue('te_popup', 'sr_ftarget_3'), GetVariableSystem.HasValue('te_popup', 'sr_ftarget_4') ) ), Or( Or( GetVariableSystem.HasValue('te_popup', 'sr_ftarget_5'), GetVariableSystem.HasValue('te_popup', 'sr_ftarget_6') ), Or( GetVariableSystem.HasValue('te_popup', 'sr_ftarget_7'), Or( GetVariableSystem.HasValue('te_popup', 'sr_ftarget_8'), GetVariableSystem.HasValue('te_popup', 'sr_ftarget_9') ) ) ) )]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_ft_title"
		}
		### The note's 480, plus the window's margins (2 × 35), the list's
		### (2 × 10) and a scrollbar: 608.
		blockoverride "popup_size" {
			size = { 608 480 }
		}
		blockoverride "popup_list" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_space_race_solar_colonization')]"
					direction = vertical
					ignoreinvisible = yes

					te_sr_ftarget_popup_body = {}
				}
			}
			te_sr_note = {
				visible = "[Not( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "je_space_race_widget_tp_gone"
			}
		}
	}

	### One slot's body in the target popup (instances in
	### te_sr_ftarget_popup_body): while the fleet is at a location, what a target
	### is for, then the worlds there; otherwise the destination popup's line.
	type te_sr_ftarget_slot = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		minimumsize = { 480 -1 }
		spacing = 2
		block "ft_visible" {}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 2
			block "ft_here_visible" {}

			te_sr_note = {
				text = "je_space_race_widget_ft_intro"
			}
			block "ft_rows" {}
		}
		te_sr_note = {
			text = "je_space_race_widget_dp_gone"
			block "ft_gone_visible" {}
		}
	}

	### One world in a fleet's target popup: its icon and name (Solar System's
	### hover), its holder as Solar System shows it, and Target, greyed with the
	### reason where the fleet's posture can't take it (closing in, a world held
	### by a country at war with us, a free colony or ours an enemy occupies;
	### interdicting, one held by a country at peace with us and not our ally);
	### the fleet's target reads Targeted, in the selected-tab look. Choosing
	### closes the popup. 24 + 180 + 122 + 80 + 3 × 3 + 2 × 4 = 423.
	type te_sr_ftarget_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 3
		margin = { 4 1 }
		block "fr_visible" {}

		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			icon = {
				size = { 24 24 }
				parentanchor = center
				block "fr_icon" {}
