	### One entry of Colony Modules' queue (colony modules design § 5): its place,
	### the world and the module (custom loc sr_mq_<n>_world_name and
	### sr_mq_<n>_module_name, from the place's sr_mq_<n>_site and _type), a
	### button that moves it up a place, or to the top on alt-click, as the base
	### game's ship construction queue does (sr_colony_module_queue_up_sgui,
	### scope:op = the place, or the place + 20; hidden on place 1, its cell kept),
	### and a button that removes it (sr_colony_module_queue_sgui, scope:op = the
	### place). Fabrication builds place 1 next. 30 + 200 + 176 + 24 + 24 + 4 × 4
	### spacing + 2 × 4 margin = 478, in the 480 column. Instances in te_sr_mq_rows
	### (sr_sites_generated_rows.gui).
	type te_sr_mq_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "mq_visible" {}

		widget = {
			size = { 30 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				max_width = 30
				align = right|nobaseline
				using = te_sr_fontsize_row
				default_format = "#v"
				block "mq_place" {}
			}
		}
		widget = {
			size = { 200 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 200
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "mq_world" {}
			}
		}
		widget = {
			size = { 176 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 176
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "mq_module" {}
			}
		}
		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			button_icon_round_action = {
				size = { 24 24 }
				blockoverride "icon" {
					texture = "gfx/interface/icons/generic_icons/up_up.dds"
				}
				blockoverride "icon_size" {
					size = { 75% 75% }
				}
				block "mq_up_button" {}
			}
		}
		button_icon_cancel = {
			size = { 24 24 }
			parentanchor = vcenter
			block "mq_remove_button" {}
		}
	}

	### ======================================================================
	### FLEETS (solar colonization, Full Colonies; slice 6 design § 16)
	### ======================================================================

	### A small action button in a fleet's orders line: `fl_btn` carries the
	### four properties that address the scripted GUI (the slot is scope:op),
	### `fl_btn_label` its text.
	type te_sr_fl_button = button {
		using = default_button_action
		size = { 60 22 }
		parentanchor = vcenter
		block "fl_btn" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 58
			elide = right
			using = te_sr_fontsize_row
			block "fl_btn_label" {}
		}
	}

	### The column heads above the Fleets rows, the widths of te_sr_fleet_row's
