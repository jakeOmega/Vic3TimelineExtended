				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "slot_eta" {}
			}
		}
	}

	### Where our next colony fleet goes, in Colony Fleets (audit SPC-7): a
	### label, the world or "chosen at launch", and Clear beside our target.
	### 110 + 250 + 66 + 2 × 4 + 2 × 4 = 442, in the 480 column. The label is
	### underlined where the row has a hover (the pick's rule).
	type te_sr_cf_dest_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "dest_row" {}

		textbox = {
			autoresize = yes
			minimumsize = { 110 -1 }
			maximumsize = { 110 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			block "dest_label_format" {
				default_format = "#tooltippable"
			}
			block "dest_label" {}
		}
		textbox = {
			autoresize = yes
			minimumsize = { 250 -1 }
			maximumsize = { 250 -1 }
			parentanchor = vcenter
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			default_format = "#v"
			block "dest_value" {}
		}
		block "dest_button" {}
	}

	### Colony Fleets (solar colonization; slices 2-3 design §§ 3, 8): where our
	### next colony fleet goes, as a value row with Clear beside our target
	### (sr_cf_target_clear_sgui; audit SPC-7), the drive it flies on
	### ([concept_sr_drive]), and under simple and full colonies our colony fleets
	### in flight, one row per slot. Solar System, with the Target buttons,
	### follows directly. Open by default; the flag is sr_panel_fleets_closed.
	type te_sr_sec_colony_fleets = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_fleets_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_fleets_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_fleets_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_fleets_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_fleets_closed'))]"

			### Our target, with Clear beside it; or, with none, the program's
			### pick at launch, its rule on hover.
			te_sr_cf_dest_row = {
				blockoverride "dest_row" {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)1' )]"
				}
				blockoverride "dest_label_format" {}
				blockoverride "dest_label" {
					text = "je_space_race_widget_cf_target_label"
				}
				blockoverride "dest_value" {
					text = "je_space_race_widget_cf_target_value"
				}
				blockoverride "dest_button" {
					button = {
						using = default_button_action
						size = { 66 24 }
						parentanchor = vcenter
						enabled = "[GetScriptedGui('sr_cf_target_clear_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('sr_cf_target_clear_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_cf_target_clear_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_cf_target_clear_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 62
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_ss_target_clear"
						}
					}
				}
			}
			te_sr_cf_dest_row = {
				blockoverride "dest_row" {
					visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)0' ) )]"
					tooltip = "je_space_race_widget_cf_destination_auto"
				}
				blockoverride "dest_label" {
					text = "je_space_race_widget_cf_next_label"
				}
				blockoverride "dest_value" {
					text = "je_space_race_widget_cf_next_auto"
				}
			}
			te_sr_cf_dest_row = {
				blockoverride "dest_row" {
					visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ) )]"
					tooltip = "je_space_race_widget_cf_destination_auto_contested"
				}
				blockoverride "dest_label" {
					text = "je_space_race_widget_cf_next_label"
				}
				blockoverride "dest_value" {
					text = "je_space_race_widget_cf_next_auto"
				}
			}
			te_sr_value_row = {
				blockoverride "label_format" {}
				blockoverride "row_label" {
					text = "je_space_race_widget_cf_drive_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_cf_drive_value"
				}
			}
			te_sr_value_row = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
				blockoverride "label_format" {}
				blockoverride "row_label" {
					text = "je_space_race_widget_cf_in_flight_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_cf_in_flight_figure"
				}
			}
			te_sr_cf_slot_rows = {}
		}
	}

