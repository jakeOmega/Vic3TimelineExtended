	### Fleets (Full Colonies; slice 6 design § 16): our nine fleet slots, then
	### every location's forces. Open by default; the flags are
	### sr_panel_space_fleets_closed and, for Locations, sr_panel_locations_closed
	### (sr_panel_fleets_closed is Colony Fleets').
	type te_sr_sec_space_fleets = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[And( JournalEntry.IsActive, EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ) )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_space_fleets_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_space_fleets_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_space_fleets_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_space_fleets_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_space_fleets_closed'))]"

			te_sr_note = {
				text = "je_space_race_widget_space_fleets_note"
			}
			te_sr_note = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_space_fleets_empty"
			}
			te_sr_fleet_header_row = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)1' )]"
			}
			te_sr_fleet_rows = {}
		}

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_locations_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_locations_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_locations_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_locations_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_locations_closed'))]"

			te_sr_location_header_row = {}
			te_sr_location_rows = {}
		}
	}

	### One colony of ours in Colony Defences (6b; slice 6 design § 16): its icon
	### and name, its Defences, its integrity, its marines, and its status
	### (Blockaded, Under assault, Occupied with the occupier's flag). 24 + 156 +
	### 40 + 50 + 50 + 124 + 5 × 4 + 2 × 4 = 472. Instances in
	### te_sr_defence_rows (sr_fleets_generated_rows.gui).
	type te_sr_defence_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }
		block "def_visible" {}

		widget = {
			size = { 24 24 }
			parentanchor = vcenter

			icon = {
				size = { 24 24 }
				parentanchor = center
				block "def_icon" {}
			}
		}
		widget = {
			size = { 156 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 156
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				block "def_name" {}
			}
		}
		widget = {
			size = { 40 24 }
			parentanchor = vcenter
			tooltip = "je_space_race_widget_def_level_tt"

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 40
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				default_format = "#v"
				block "def_level" {}
			}
		}
		widget = {
			size = { 50 24 }
			parentanchor = vcenter
			tooltip = "je_space_race_widget_def_integrity_tt"

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 50
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				block "def_integrity" {}
			}
		}
		widget = {
			size = { 50 24 }
			parentanchor = vcenter
			tooltip = "je_space_race_widget_def_marines_tt"

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 50
				align = left|nobaseline
				using = fontsize_medium
				elide = right
				block "def_marines" {}
			}
		}
		widget = {
			size = { 124 24 }
			parentanchor = vcenter

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_small
				elide = right
				default_format = "#grey"
				text = "je_space_race_widget_def_status_calm"
				block "def_calm_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_small
				elide = right
				default_format = "#R"
				tooltip = "je_space_race_widget_loc_blockaded_tt"
				text = "je_space_race_widget_def_status_blockaded"
				block "def_blockaded_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_small
				elide = right
				default_format = "#R"
				tooltip = "je_space_race_widget_loc_interdicted_tt"
				text = "je_space_race_widget_def_status_interdicted"
				block "def_interdicted_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 124
				align = left|nobaseline
				using = fontsize_small
				elide = right
				default_format = "#R"
				tooltip = "je_space_race_widget_def_assault_tt"
				text = "je_space_race_widget_def_status_assault"
				block "def_assault_visible" {}
			}
			flowcontainer = {
				parentanchor = left|vcenter
				direction = horizontal
				spacing = 4
				ignoreinvisible = yes
				block "def_occupied_visible" {}

				textbox = {
					parentanchor = vcenter
					autoresize = yes
					max_width = 92
					align = left|nobaseline
					using = fontsize_small
					elide = right
					default_format = "#R"
					tooltip = "je_space_race_widget_def_occupied_tt"
					text = "je_space_race_widget_def_status_occupied"
				}
				flowcontainer = {
					ignoreinvisible = yes
					block "def_occupier_context" {}

					widget = {
						size = { 28 24 }
						parentanchor = vcenter

						tiny_flag = {
							parentanchor = center
							datacontext = "[State.GetCountry]"
						}
					}
				}
			}
		}
	}

