			parentanchor = vcenter
			tooltip = "je_space_race_widget_settlers_crews_tt"

			textbox = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_agi'), '(CFixedPoint)0' )]"
