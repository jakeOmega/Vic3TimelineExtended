	### The colony target popup's content (UI pass design § 5), under the
	### popup's journal-entry datacontext: what it is for, how many worlds we
	### can target with Show all beside the count (the client-side
	### sr_panel_target_popup_all_open, as Solar System's own toggle), every world under
	### its location, and a line while no world can be targeted.
	type te_sr_target_popup_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		minimumsize = { 632 -1 }
		spacing = 2

		te_sr_note = {
			text = "je_space_race_widget_tp_intro"
		}

		### The count reads the player: SelectLocalization renders its key
		### without the journal entry (gotcha #16).
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin = { 4 1 }

			textbox = {
				autoresize = yes
				minimumsize = { 352 -1 }
				maximumsize = { 352 -1 }
				parentanchor = vcenter
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				text = "[SelectLocalization( GetVariableSystem.Exists('sr_panel_target_popup_all_open'), 'je_space_race_widget_tp_all', 'je_space_race_widget_tp_count' )]"
			}
			button = {
				using = default_button
				size = { 116 26 }
				parentanchor = vcenter
				onclick = "[GetVariableSystem.Toggle('sr_panel_target_popup_all_open')]"
				tooltip = "je_space_race_widget_tp_toggle_tt"

				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 110
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_show_all"
					visible = "[Not(GetVariableSystem.Exists('sr_panel_target_popup_all_open'))]"
				}
				textbox = {
					parentanchor = center
					align = center|nobaseline
					autoresize = yes
					max_width = 110
					elide = right
					using = te_sr_fontsize_row
					text = "je_space_race_widget_ss_show_fewer"
					visible = "[GetVariableSystem.Exists('sr_panel_target_popup_all_open')]"
				}
			}
		}

		te_sr_target_picker_rows = {}

		te_sr_note = {
			visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_tp_count'), '(CFixedPoint)0' )]"
			text = "je_space_race_widget_tp_none"
		}
	}

	### The colony target popup (UI pass design § 5), opened from Colony
	### Fleets' Change and Choose (te_popup = sr_target); instanced in
	### te_popups (gui/te_popups.gui). The content sits under the entry's
	### scope-free gate and its GetPlayerJournalEntry datacontext on a child
	### (gotchas #22, #29); with the entry gone, one line says so.
	type te_sr_target_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'sr_target')]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_tp_title"
		}
		### The rows' 632, plus the window's margins (2 × 35), the list's
		### (2 × 10) and a scrollbar: 760.
		blockoverride "popup_size" {
			size = { 760 640 }
		}
		blockoverride "popup_list" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_space_race_solar_colonization')]"
					direction = vertical
					ignoreinvisible = yes

					te_sr_target_popup_body = {}
				}
			}
			te_sr_note = {
				visible = "[Not( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "je_space_race_widget_tp_gone"
			}
		}
	}

	### Solar System (solar colonization only): the worlds under their locations
	### (the owner's nine, less Earth and the Moon), with who holds them (design
	### § 9), a list to read: a target is picked in the colony target popup,
	### from Colony Fleets (UI pass design § 5). Open by default, near the foot
	### of the panel (#1274), and filtered by default to the worlds that matter
	### now: those our next colony fleet can go to, ours and any a
	### fleet is bound for (sr_disp_ss_filtered_<location>), with "Show all 40"
	### beside the count. Rows in gen_solar_sites.panel_order(), written from the
	### table and held to it by test_solar_sites.py. The flags are
	### sr_panel_solar_system_closed and sr_panel_solar_system_all_open,
	### client-side like the rest.
	type te_sr_sec_solar_system = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[JournalEntry.IsActive]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_solar_system_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_solar_system_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_solar_system_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_closed'))]"

			### How many worlds the list shows, and the toggle that shows every one.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				margin = { 4 1 }

				### The count reads the player: SelectLocalization renders its key
				### without the journal entry (gotcha #16).
				textbox = {
					autoresize = yes
					minimumsize = { 352 -1 }
					maximumsize = { 352 -1 }
					parentanchor = vcenter
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "[SelectLocalization( GetVariableSystem.Exists('sr_panel_solar_system_all_open'), 'je_space_race_widget_ss_all', 'je_space_race_widget_ss_filtered' )]"
				}
				button = {
					using = default_button
					size = { 116 26 }
					parentanchor = vcenter
					onclick = "[GetVariableSystem.Toggle('sr_panel_solar_system_all_open')]"
					tooltip = "je_space_race_widget_ss_toggle_tt"

					textbox = {
						parentanchor = center
						align = center|nobaseline
						autoresize = yes
						max_width = 110
						elide = right
						using = te_sr_fontsize_row
						text = "je_space_race_widget_ss_show_all"
						visible = "[Not(GetVariableSystem.Exists('sr_panel_solar_system_all_open'))]"
					}
					textbox = {
						parentanchor = center
						align = center|nobaseline
						autoresize = yes
						max_width = 110
						elide = right
						using = te_sr_fontsize_row
						text = "je_space_race_widget_ss_show_fewer"
						visible = "[GetVariableSystem.Exists('sr_panel_solar_system_all_open')]"
					}
				}
			}

			### Every world under its location, generated from the site table
			### (gui/journal_entry_widgets/sr_sites_generated_rows.gui).
			te_sr_solar_system_rows = {}
		}
	}

