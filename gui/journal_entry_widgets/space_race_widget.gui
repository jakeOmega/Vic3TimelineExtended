			size = { 114 12 }
			position = { 0 21 }
			blockoverride "values" {
				block "fg_value" {}
				min = 0
				max = 1
			}
		}
		textbox = {
			position = { 0 34 }
			autoresize = yes
			max_width = 114
			elide = right
			align = left|nobaseline
			using = te_sr_fontsize_row
			default_format = "#v"
			block "fg_figure" {}
		}
