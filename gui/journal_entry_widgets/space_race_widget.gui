	### solar_colonization: the overview, wrapped by the journal root
	### widget_je_space_race_solar_colonization_overview.
	type te_sr_solar_colonization_overview = flowcontainer {
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		datacontext = "[GetScriptedGui('sr_milestone_solar_colonization_sgui')]"

		te_sr_overview_milestone = {
			blockoverride "sr_status_standard" {
				visible = "[LessThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_status_solar_colonization'), '(CFixedPoint)1' )]"
			}
			blockoverride "sr_status_safe" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_status_solar_colonization'), '(CFixedPoint)2' )]"
			}
			blockoverride "sr_status_ambitious" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_status_solar_colonization'), '(CFixedPoint)3' )]"
			}
			blockoverride "sr_status_shielded" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_status_solar_colonization'), '(CFixedPoint)4' )]"
			}
			blockoverride "sr_risk_lit" {
				visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_risk_shown_solar_colonization'), '(CFixedPoint)0' )]"
			}
			blockoverride "sr_risk_unlit" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_risk_shown_solar_colonization'), '(CFixedPoint)0' )]"
			}
			blockoverride "sr_risk_label" {
				text = "je_space_race_widget_risk_solar_colonization"
			}
			blockoverride "sr_label_safe" {
				text = "je_space_race_widget_ov_safe_solar_colonization"
			}
			blockoverride "sr_label_ambitious" {
				text = "je_space_race_widget_ov_ambitious_solar_colonization"
			}
			# The stage, whose tooltip is the stage's description (the first lunar
			# colony's race for the first is on the reward hover and the Program
			# row's Lunar Colony icon).
			# Stage 0 (and a race not yet begun) reads "the Moon"; SelectLocalization
			# renders its key without the journal entry, so both read the player.
			blockoverride "sr_third_cells" {
				te_sr_ov_icon_label = {
					tooltip = "je_space_race_widget_profile_solar_colonization"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/space_race_icons/stage.dds"
					}
					blockoverride "label" {
						text = "[SelectLocalization( GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('sr_current_colonization_stage'), '(CFixedPoint)1' ), 'je_space_race_widget_ov_stage', 'je_space_race_widget_ov_stage_moon' )]"
					}
				}
			}
			blockoverride "sr_progress_label" {
				text = "je_space_race_widget_ov_colony_label"
			}
			# Fleets staged in orbit while a full bar waits for a launch window
			# (gui/sr_launch_window_widgets.gui), then the 40 worlds: every one
			# claimed, ours on top; then what needs us.
			blockoverride "sr_extra_rows" {
				te_sr_ov_staged = {}
				te_sr_ov_pie = {
					parentanchor = hcenter
					tooltip = "je_space_race_widget_ov_worlds_tt"
					blockoverride "pie_claimed" {
						value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_worlds_claimed_frac') )]"
					}
					blockoverride "pie_ours" {
						value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_worlds_ours_frac') )]"
					}
					blockoverride "pie_label" {
						text = "je_space_race_widget_ov_worlds"
					}
				}
				# What needs us (audit SPC-6; Simple and Full Colonies): Banking's
				# cells, two to a row. Colonies names a colony demanding self-rule,
				# Defense (Full Colonies) the worst threat to ours, Modules an idle
				# queue, Next Window the stage's next one; each hover lists the rest.
				flowcontainer = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' )]"
					direction = vertical
					ignoreinvisible = yes
					spacing = 4
					parentanchor = hcenter

					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = hcenter

						te_banking_ov_cell = {
							tooltip = "je_space_race_widget_ovc_colonies_tt"
							blockoverride "caption" {
								text = "je_space_race_widget_ovc_colonies_cap"
							}
							blockoverride "icons" {
								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/icons/space_race_icons/colony_mars.dds"
								}
							}
							blockoverride "word" {
								te_banking_ov_word = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' )]"
									text = "je_space_race_widget_ovc_colonies_word_restless"
								}
								te_banking_ov_word = {
									visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' ) )]"
									text = "je_space_race_widget_ovc_colonies_word_calm"
								}
							}
							blockoverride "third_line" {
								te_banking_ov_word = {
									position = { 78 46 }
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' ) )]"
									text = "je_space_race_widget_ovc_colonies_fig_one"
								}
								te_banking_ov_word = {
									position = { 78 46 }
									visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)2' )]"
									text = "je_space_race_widget_ovc_colonies_fig_more"
								}
								te_banking_ov_word = {
									position = { 78 46 }
									visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_aut_restless_count'), '(CFixedPoint)1' ) )]"
									text = "je_space_race_widget_ovc_colonies_fig_calm"
								}
							}
						}
						te_banking_ov_cell = {
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' )]"
							tooltip = "je_space_race_widget_ovc_defense_tt"
							blockoverride "caption" {
								text = "je_space_race_widget_ovc_defense_cap"
							}
							blockoverride "icons" {
								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/icons/space_race_icons/warship.dds"
								}
							}
							blockoverride "word" {
								te_banking_ov_word = {
									text = "je_space_race_widget_ovc_defense_word"
								}
							}
							blockoverride "third_line" {
								te_banking_ov_word = {
									position = { 78 46 }
									text = "je_space_race_widget_ovc_defense_fig"
								}
							}
						}
					}
					flowcontainer = {
						direction = horizontal
						ignoreinvisible = yes
						spacing = 4
						parentanchor = hcenter

						te_banking_ov_cell = {
							tooltip = "je_space_race_widget_ovc_modules_tt"
							blockoverride "caption" {
								text = "je_space_race_widget_ovc_modules_cap"
							}
							blockoverride "icons" {
								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/icons/space_race_icons/module.dds"
								}
							}
							blockoverride "word" {
								te_banking_ov_word = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_count'), '(CFixedPoint)1' )]"
									text = "je_space_race_widget_ovc_modules_word_queued"
								}
								te_banking_ov_word = {
									visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_count'), '(CFixedPoint)1' ) ), GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fab_stock'), JournalEntry.GetCountry.MakeScope.ScriptValue('sr_mod_fab_stock_cap') ) )]"
									text = "je_space_race_widget_ovc_modules_word_idle"
								}
								te_banking_ov_word = {
									visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_mq_count'), '(CFixedPoint)1' ) ), Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fab_stock'), JournalEntry.GetCountry.MakeScope.ScriptValue('sr_mod_fab_stock_cap') ) ) )]"
									text = "je_space_race_widget_ovc_modules_word_empty"
								}
							}
							blockoverride "third_line" {
								te_banking_ov_word = {
									position = { 78 46 }
									text = "je_space_race_widget_ovc_modules_fig"
								}
							}
						}
						te_banking_ov_cell = {
							tooltip = "je_space_race_widget_ovc_window_tt"
							blockoverride "caption" {
								text = "je_space_race_widget_ovc_window_cap"
							}
							blockoverride "icons" {
								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/icons/event_icons/je_space_race_solar_colonization.dds"
								}
							}
							blockoverride "word" {
								te_banking_ov_word = {
									visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_window_disp_apply'), '(CFixedPoint)1' ) )]"
									text = "je_space_race_widget_ovc_window_word_any"
								}
								te_banking_ov_word = {
									visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_window_disp_apply'), '(CFixedPoint)1' ), GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_window_disp_next'), '(CFixedPoint)999' ) )]"
									text = "je_space_race_widget_ovc_window_word_none"
								}
								te_banking_ov_word = {
									visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_window_disp_apply'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_window_disp_next'), '(CFixedPoint)0' ) )]"
									text = "je_space_race_widget_ovc_window_word_open"
								}
								te_banking_ov_word = {
									visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_window_disp_apply'), '(CFixedPoint)1' ), And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_window_disp_next'), '(CFixedPoint)1' ), Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_window_disp_next'), '(CFixedPoint)999' ) ) ) )]"
									text = "je_space_race_widget_ovc_window_word_in"
								}
							}
							blockoverride "third_line" {
								te_banking_ov_word = {
									position = { 78 46 }
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_current_colonization_stage'), '(CFixedPoint)1' ), Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_held_beyond_moon'), '(CFixedPoint)1' ) ) )]"
									text = "je_space_race_widget_ovc_window_fig"
								}
								# The Moon full and no Mars Landing: why the bar holds.
								te_banking_ov_word = {
									position = { 78 46 }
									visible = "[And( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_current_colonization_stage'), '(CFixedPoint)1' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_held_beyond_moon'), '(CFixedPoint)1' ) )]"
									text = "je_space_race_widget_ovc_window_fig_mars"
								}
								# Stage 0 is the Moon, which needs no window.
								te_banking_ov_word = {
									position = { 78 46 }
									visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_current_colonization_stage'), '(CFixedPoint)1' ) )]"
									text = "je_space_race_widget_ovc_window_fig_moon"
								}
							}
						}
					}
				}
			}
			blockoverride "sr_progress_value" {
				value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_progress_frac_solar_colonization') )]"
			}
			blockoverride "sr_progress_text" {
				text = "je_space_race_widget_progress_solar_colonization"
			}
			blockoverride "sr_progress_tooltip" {
				tooltip = "je_space_race_widget_reward_solar_colonization"
			}
		}
	}

	### solar_colonization: the live sections, wrapped by the journal root
	### widget_je_space_race_solar_colonization.
	type te_sr_solar_colonization_status = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		datacontext = "[GetScriptedGui('sr_milestone_solar_colonization_sgui')]"

		te_sr_status_sections = {
			blockoverride "status_debris" {
				block "sr_debris" {
					te_sr_debris_row = {}
				}
			}
			blockoverride "sr_control_onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_control_solar_colonization_closed')]"
			}
			blockoverride "sr_control_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_control_solar_colonization_closed')]"
			}
			blockoverride "sr_control_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_control_solar_colonization_closed'))]"
			}
			blockoverride "sr_control_visible" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_control_solar_colonization_closed'))]"
			}
			blockoverride "sr_funding_value" {
				text = "[SelectLocalization( GreaterThan_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_funding_solar_colonization_past_cap'), '(CFixedPoint)0' ), 'je_space_race_widget_funding_past_cap_solar_colonization', 'je_space_race_widget_funding_solar_colonization' )]"
			}
			blockoverride "sr_setbacks_value" {
				text = "je_space_race_widget_setbacks_solar_colonization"
			}
			blockoverride "sr_eta_value" {
				text = "je_space_race_widget_eta_solar_colonization"
			}
			blockoverride "sr_profile_text" {
				text = "je_space_race_widget_profile_solar_colonization"
			}
			# Launch windows (gui/sr_launch_window_widgets.gui).
			blockoverride "sr_control_extra" {
				te_sr_sec_windows = {}
			}
			blockoverride "sr_rivals_onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_rivals_solar_colonization_closed')]"
			}
			blockoverride "sr_rivals_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_rivals_solar_colonization_closed')]"
			}
			blockoverride "sr_rivals_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_rivals_solar_colonization_closed'))]"
			}
			blockoverride "sr_rivals_visible" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_rivals_solar_colonization_closed'))]"
			}
			blockoverride "sr_rivals_none" {
				visible = "[IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('sr_rivals_list_solar_colonization') )]"
			}
			blockoverride "sr_rivals_datamodel" {
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('sr_rivals_list_solar_colonization')]"
			}
			blockoverride "sr_rival_tooltip" {
				tooltip = "je_space_race_widget_rival_tt_solar_colonization"
			}
			blockoverride "sr_rival_lo" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'sr_rival', State.GetCountry.MakeScope ).ScriptValue('sr_disp_rival_lo_solar_colonization') )]"
			}
			blockoverride "sr_rival_hi" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'sr_rival', State.GetCountry.MakeScope ).ScriptValue('sr_disp_rival_hi_solar_colonization') )]"
			}
			blockoverride "sr_rival_est" {
				value = "[FixedPointToFloat( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'sr_rival', State.GetCountry.MakeScope ).ScriptValue('sr_disp_rival_est_solar_colonization') )]"
			}
			blockoverride "sr_rival_range" {
				text = "je_space_race_widget_rival_range_solar_colonization"
			}
		}

		te_sr_sec_colony_fleets = {}
		te_sr_sec_solar_system = {}
		te_sr_sec_colonies = {}
		te_sr_sec_space_command = {}
		te_sr_sec_space_fleets = {}
		te_sr_sec_how_colonies = {}
	}

}

### ==========================================================================
### JOURNAL ENTRY ROOTS (je_space_race.txt). Thin wrappers that repeat the
### composers' IsActive gate, so an inactive entry's containers collapse, around
### the milestone's own types above (te_sr_<m>_overview, te_sr_<m>_status),
### which set its scripted GUI as the datacontext and pass its data. Per
### milestone: the overview (custom_widget_container_1) and the live sections
### (custom_widget_container_2); the waiting entry has an overview only. One
### reference root serves all nine (custom_widget_container_3).
### ==========================================================================

### suborbital

flowcontainer = {
	name = "widget_je_space_race_suborbital_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	minimumsize = { 520 -1 }
	ignoreinvisible = yes

	te_sr_suborbital_overview = {}
}

flowcontainer = {
	name = "widget_je_space_race_suborbital"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	minimumsize = { 520 -1 }
	ignoreinvisible = yes

	te_sr_suborbital_status = {}
}

