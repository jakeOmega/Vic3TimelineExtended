	### One fleet slot in Space Fleets, as a card (owner, 2026-11-14). Its head
	### is always shown: the fleet's emblem and number, the world of where it is
	### and its name (or "→ Mars" in transit), its drive (or its refit's months), the
	### arrow that opens the Fleets window on it (te_sr_fleet_popup) and the button
	### that rolls the card up or down (the flag sr_panel_fleet_<n>_closed, so
	### a card starts open); rolled up, the head also gives its strength. In
	### transit, a track under the head: the leg flown so far, the ship on it,
	### and when it lands. The body, while the card is open: its ships by role
	### (te_sr_fl_role_cell), then strength, propellant, supply and marines as
	### bars, now of full (te_sr_fl_gauge); then, at a location, its orders:
	### the destination button (it opens the destination popup; the leg on
	### hover), Go, Transfer (its popup, te_sr_xfer_popup), Land, Embark; and
	### from 6b its posture's four buttons (UI pass design § 7), then its target
	### world (it opens the target popup) and Seize / Destroy. The card is 480
	### wide with a margin of 6, so each line has 468: the head 30 + 38 + 24 + 122 +
	### 94 + 140 + 5 × 4 = 468 (each cell at its longest text's budget, since the
	### arrow joined them: "VIII", "→ Merc./Venus", "Antimatter", "9999/9999");
	### the track 200 + 4 + 264 = 468; the orders
	### 108 + 80 + 98 + 2 × 80 + 4 × 4 = 462; target and Seize 190 + 98 + 4 =
	### 292. Instances in te_sr_fleet_rows (sr_fleets_generated_rows.gui), one
	### per slot; the scripted GUIs are sr_fleet_sguis.txt's, scope:op the slot
	### (and scope:pick the posture).
	type te_sr_fleet_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4
		margin = { 6 6 }
		minimumsize = { 480 -1 }
		block "fl_visible" {}

		background = {
			using = entry_bg_simple
		}

		### The head.
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4

			widget = {
				size = { 30 30 }
				parentanchor = vcenter

				background = {
					using = dark_area
					alpha = 0.3
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/fleet.dds"
				}
			}
			widget = {
				size = { 38 30 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 38
					align = left|nobaseline
					using = te_sr_fontsize_row
					default_format = "#title"
					block "fl_number" {}
				}
			}
			### The world of the location it is at, or is bound for: one slot, the
			### nine taking turns (sr_disp_fl_<n>_place; the locations' icons, as
			### Locations draws them).
			widget = {
				size = { 24 30 }
				parentanchor = vcenter

				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/location_earth.dds"
					block "fl_place_earth" {}
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/colony_venus.dds"
					block "fl_place_inner" {}
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/colony_mars.dds"
					block "fl_place_mars" {}
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/colony_asteroid.dds"
					block "fl_place_asteroids" {}
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/colony_jovian.dds"
					block "fl_place_jupiter" {}
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/colony_saturnian.dds"
					block "fl_place_saturn" {}
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/colony_uranian.dds"
					block "fl_place_uranus" {}
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/colony_neptunian.dds"
					block "fl_place_neptune" {}
				}
				icon = {
					size = { 24 24 }
					parentanchor = center
					texture = "gfx/interface/icons/space_race_icons/colony_dwarf.dds"
					block "fl_place_kuiper" {}
				}
			}
			widget = {
				size = { 122 30 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 122
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_where" {}
				}
			}
			widget = {
				size = { 94 30 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_drive_tt"

				### The drive, or while a refit runs, "Refit" and its months in its
				### place: the drive's override hides it then. Neither has a
				### background: the engine drew one on this flowcontainer smaller
				### than its autoresized text and off to one side (2026-11-24).
				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 94
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_drive" {}
				}
				flowcontainer = {
					parentanchor = left|vcenter
					direction = horizontal
					spacing = 4
					ignoreinvisible = yes
					block "fl_refit_visible" {}

					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 60
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						text = "je_space_race_widget_fl_refit"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 18
						align = left|nobaseline
						using = te_sr_fontsize_row
						default_format = "#v"
						block "fl_refit" {}
					}
				}
			}
			### One slot at the head's end: the button that rolls the card up; or,
			### rolled up, its strength (the bar shows it otherwise) and the button
			### that rolls it down, on the flag's one bare test. Left of either,
			### vanilla's go-to arrow, as a colony's row has: it opens the Fleets
			### window on this fleet (te_sr_fleet_popup). Last, so it draws over the
			### rolled-up wrapper. 86 + 2 + 24 + 2 + 24 = 138, in 140.
			widget = {
				size = { 140 30 }
				parentanchor = vcenter

				button_icon_round_action = {
					size = { 24 24 }
					parentanchor = right|vcenter
					tooltip = "je_space_race_widget_fl_roll_up_tt"
					blockoverride "icon" {
						texture = "gfx/interface/icons/generic_icons/up_up.dds"
					}
					blockoverride "icon_size" {
						size = { 75% 75% }
					}
					block "fl_roll_up" {}
				}
				widget = {
					size = { 100% 100% }
					block "fl_rolled_visible" {}

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 86
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "fl_strength_brief" {}
					}
					button_icon_round_action = {
						size = { 24 24 }
						parentanchor = right|vcenter
						tooltip = "je_space_race_widget_fl_roll_down_tt"
						blockoverride "icon" {
							texture = "gfx/interface/icons/generic_icons/down_down.dds"
						}
						blockoverride "icon_size" {
							size = { 75% 75% }
						}
						block "fl_roll_down" {}
					}
				}
				button_icon_goto = {
					size = { 24 24 }
					position = { -26 0 }
					parentanchor = right|vcenter
					tooltip = "je_space_race_widget_fl_open_tt"
					block "fl_open" {}
				}
			}
		}
		### In transit: the leg flown so far, the ship on it, and when it lands.
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			block "fl_transit_visible" {}

			widget = {
				size = { 96 18 }
				parentanchor = vcenter

				default_progressbar_horizontal = {
					size = { 100% 100% }
					blockoverride "values" {
						block "fl_transit_frac" {}
						min = 0
						max = 1
					}
					blockoverride "on_top_of_the_progressbar" {
						progressbar = {
							noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
							size = { 100% 100% }
							skip_initial_animation = yes
							direction = horizontal
							block "fl_transit_frac" {}
							min = 0
							max = 1
							marker = {
								icon = {
									size = { 18 18 }
									parentanchor = vcenter
									widgetanchor = center
									texture = "gfx/interface/icons/space_race_icons/track_ship.dds"
								}
							}
						}
					}
				}
			}
			### "Lands in N weeks", 190 wide (its longest, 9999 weeks, 187), the
			### track before it 96 for the stance's 168 after it:
			### 96 + 4 + 190 + 4 + 168 = 462, in the card's 468.
			widget = {
				size = { 190 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 190
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_transit" {}
				}
			}
			### The stance in flight: whom the fleet fights on landing.
			te_sr_stance_button = {
				blockoverride "sb_btn" {
					block "fl_stance_button" {}
				}
				blockoverride "sb_1" {
					block "fl_stance_1_visible" {}
				}
				blockoverride "sb_2" {
					block "fl_stance_2_visible" {}
				}
				blockoverride "sb_3" {
					block "fl_stance_3_visible" {}
				}
				blockoverride "sb_4" {
					block "fl_stance_4_visible" {}
				}
			}
		}
		### The body, while the card is open.
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 4
			block "fl_body_visible" {}

			### Its ships, by role.
			flowcontainer = {
				direction = horizontal
				spacing = 4

				te_sr_fl_role_cell = {
					blockoverride "rc_tooltip" {
						block "fl_roles_tooltip" {}
					}
					blockoverride "rc_icon" {
						texture = "gfx/interface/icons/space_race_icons/role_war.dds"
					}
					blockoverride "rc_lit" {
						block "fl_role_war_lit" {}
					}
					blockoverride "rc_dim" {
						block "fl_role_war_dim" {}
					}
					blockoverride "rc_count" {
						block "fl_role_war" {}
					}
					blockoverride "rc_label" {
						text = "je_space_race_widget_fl_role_war"
					}
				}
				te_sr_fl_role_cell = {
					blockoverride "rc_tooltip" {
						block "fl_roles_tooltip" {}
					}
					blockoverride "rc_icon" {
						texture = "gfx/interface/icons/space_race_icons/role_rapid.dds"
					}
					blockoverride "rc_lit" {
						block "fl_role_rapid_lit" {}
					}
					blockoverride "rc_dim" {
						block "fl_role_rapid_dim" {}
					}
					blockoverride "rc_count" {
						block "fl_role_rapid" {}
					}
					blockoverride "rc_label" {
						text = "je_space_race_widget_fl_role_rapid"
					}
				}
				te_sr_fl_role_cell = {
					blockoverride "rc_tooltip" {
						block "fl_roles_tooltip" {}
					}
					blockoverride "rc_icon" {
						texture = "gfx/interface/icons/space_race_icons/role_siege.dds"
					}
					blockoverride "rc_lit" {
						block "fl_role_siege_lit" {}
					}
					blockoverride "rc_dim" {
						block "fl_role_siege_dim" {}
					}
					blockoverride "rc_count" {
						block "fl_role_siege" {}
					}
					blockoverride "rc_label" {
						text = "je_space_race_widget_fl_role_siege"
					}
				}
				te_sr_fl_role_cell = {
					blockoverride "rc_tooltip" {
						block "fl_roles_tooltip" {}
					}
					blockoverride "rc_icon" {
						texture = "gfx/interface/icons/space_race_icons/role_carrier.dds"
					}
					blockoverride "rc_lit" {
						block "fl_role_carrier_lit" {}
					}
					blockoverride "rc_dim" {
						block "fl_role_carrier_dim" {}
					}
					blockoverride "rc_count" {
						block "fl_role_carrier" {}
					}
					blockoverride "rc_label" {
						text = "je_space_race_widget_fl_role_carrier"
					}
				}
				te_sr_fl_role_cell = {
					blockoverride "rc_tooltip" {
						block "fl_roles_tooltip" {}
					}
					blockoverride "rc_icon" {
						texture = "gfx/interface/icons/space_race_icons/role_tender.dds"
					}
					blockoverride "rc_lit" {
						block "fl_role_tender_lit" {}
					}
					blockoverride "rc_dim" {
						block "fl_role_tender_dim" {}
					}
					blockoverride "rc_count" {
						block "fl_role_tender" {}
					}
					blockoverride "rc_label" {
						text = "je_space_race_widget_fl_role_tender"
					}
				}
			}
			### Strength, propellant, supply and marines, now of full.
			flowcontainer = {
				direction = horizontal
				spacing = 4

				te_sr_fl_gauge = {
					tooltip = "je_space_race_widget_fl_strength_tt"
					blockoverride "fg_label" {
						text = "je_space_race_widget_fl_col_strength"
					}
					blockoverride "fg_value" {
						block "fl_strength_frac" {}
					}
					blockoverride "fg_figure" {
						block "fl_strength" {}
					}
				}
				te_sr_fl_gauge = {
					tooltip = "je_space_race_widget_fl_dv_tt"
					blockoverride "fg_label" {
						text = "je_space_race_widget_fl_col_dv"
					}
					blockoverride "fg_value" {
						block "fl_dv_frac" {}
					}
					blockoverride "fg_figure" {
						block "fl_dv" {}
					}
				}
				te_sr_fl_gauge = {
					tooltip = "je_space_race_widget_fl_supply_tt"
					blockoverride "fg_label" {
						text = "je_space_race_widget_fl_col_supply"
					}
					blockoverride "fg_value" {
						block "fl_supply_frac" {}
					}
					blockoverride "fg_figure" {
						block "fl_supply" {}
					}
				}
				te_sr_fl_gauge = {
					tooltip = "je_space_race_widget_fl_marines_tt"
					blockoverride "fg_label" {
						text = "je_space_race_widget_fl_col_marines"
					}
					blockoverride "fg_value" {
						block "fl_marines_frac" {}
					}
					blockoverride "fg_figure" {
						block "fl_marines" {}
					}
				}
			}
			### Orders, at a location.
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				block "fl_orders_visible" {}

				button = {
					using = default_button_action
					size = { 108 26 }
					parentanchor = vcenter
					block "fl_pick_button" {}

					textbox = {
						parentanchor = center
						align = center|nobaseline
						autoresize = yes
						max_width = 104
						elide = right
						using = te_sr_fontsize_row
						block "fl_pick" {}
					}
				}
				te_sr_fl_button = {
					blockoverride "fl_btn" {
						block "fl_go_button" {}
					}
					blockoverride "fl_btn_icon" {
						texture = "gfx/interface/icons/space_race_icons/order_go.dds"
					}
					blockoverride "fl_btn_label" {
						text = "je_space_race_widget_fl_go"
					}
				}
				### Transfer (UI pass design § 6): opens the slot's Transfer popup,
				### which took in Merge and Detach. Wider than te_sr_fl_button's 80
				### for its word: 3 + 16 + 2 + 76 + 1 = 98.
				button = {
					using = default_button_action
					size = { 98 26 }
					parentanchor = vcenter
					block "fl_transfer_button" {}

					icon = {
						size = { 16 16 }
						position = { 3 0 }
						parentanchor = left|vcenter
						texture = "gfx/interface/icons/space_race_icons/order_transfer.dds"
					}
					textbox = {
						position = { 21 0 }
						parentanchor = left|vcenter
						align = left|nobaseline
						autoresize = yes
						max_width = 76
						elide = right
						using = te_sr_fontsize_row
						text = "je_space_race_widget_fl_transfer"
					}
				}
				te_sr_fl_button = {
					blockoverride "fl_btn" {
						block "fl_land_button" {}
					}
					blockoverride "fl_btn_icon" {
						texture = "gfx/interface/icons/space_race_icons/order_land.dds"
					}
					blockoverride "fl_btn_label" {
						text = "je_space_race_widget_fl_land"
					}
				}
				te_sr_fl_button = {
					blockoverride "fl_btn" {
						block "fl_embark_button" {}
					}
					blockoverride "fl_btn_icon" {
						texture = "gfx/interface/icons/space_race_icons/order_embark.dds"
					}
					blockoverride "fl_btn_label" {
						text = "je_space_race_widget_fl_embark"
					}
				}
			}
			### Posture and target (6b), at a location other than Earth; at Earth only
			### while a lunar world there may be closed in on (lunar colonization § 8.1).
			### The posture's four buttons on a line of their own (UI pass design § 7),
			### the one in force lit; then the target, which opens the target popup, and
			### Seize / Destroy.
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				spacing = 4
				block "fl_combat_visible" {}

				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					te_sr_posture_choice = {
						blockoverride "pc_icon" {
							texture = "gfx/interface/icons/space_race_icons/posture_station.dds"
						}
						blockoverride "pc_label" {
							text = "je_space_race_widget_fl_posture_1"
						}
						blockoverride "pc_shown" {
							block "fl_posture_1_choice" {}
						}
						blockoverride "pc_selected" {
							block "fl_posture_1_selected" {}
						}
						blockoverride "pc_held_tooltip" {
							tooltip = "je_space_race_widget_fl_posture_1_held_tt"
						}
						blockoverride "pc_action" {
							block "fl_posture_1_button" {}
						}
					}
					te_sr_posture_choice = {
						blockoverride "pc_icon" {
							texture = "gfx/interface/icons/space_race_icons/posture_standoff.dds"
						}
						blockoverride "pc_label" {
							text = "je_space_race_widget_fl_posture_2"
						}
						blockoverride "pc_shown" {
							block "fl_posture_2_choice" {}
						}
						blockoverride "pc_selected" {
							block "fl_posture_2_selected" {}
						}
						blockoverride "pc_held_tooltip" {
							tooltip = "je_space_race_widget_fl_posture_2_held_tt"
						}
						blockoverride "pc_action" {
							block "fl_posture_2_button" {}
						}
					}
					te_sr_posture_choice = {
						blockoverride "pc_icon" {
							texture = "gfx/interface/icons/space_race_icons/posture_closein.dds"
						}
						blockoverride "pc_label" {
							text = "je_space_race_widget_fl_posture_3"
						}
						blockoverride "pc_shown" {
							block "fl_posture_3_choice" {}
						}
						blockoverride "pc_selected" {
							block "fl_posture_3_selected" {}
						}
						blockoverride "pc_held_tooltip" {
							tooltip = "je_space_race_widget_fl_posture_3_held_tt"
						}
						blockoverride "pc_action" {
							block "fl_posture_3_button" {}
						}
					}
					te_sr_posture_choice = {
						blockoverride "pc_icon" {
							texture = "gfx/interface/icons/space_race_icons/posture_interdict.dds"
						}
						blockoverride "pc_label" {
							text = "je_space_race_widget_fl_posture_4"
						}
						blockoverride "pc_shown" {
							block "fl_posture_4_choice" {}
						}
						blockoverride "pc_selected" {
							block "fl_posture_4_selected" {}
						}
						blockoverride "pc_held_tooltip" {
							tooltip = "je_space_race_widget_fl_posture_4_held_tt"
						}
						blockoverride "pc_action" {
							block "fl_posture_4_button" {}
						}
					}
				}
				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 4

					button = {
						using = default_button_action
						size = { 190 26 }
						parentanchor = vcenter
						block "fl_target_button" {}

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 184
							elide = right
							using = te_sr_fontsize_row
							block "fl_target" {}
						}
					}
					### Seize, or Destroy: its icon and word change with the order.
					button = {
						using = default_button_action
						size = { 98 26 }
						parentanchor = vcenter
						block "fl_destroy_button" {}

						icon = {
							size = { 16 16 }
							position = { 3 0 }
							parentanchor = left|vcenter
							texture = "gfx/interface/icons/space_race_icons/order_seize.dds"
							block "fl_destroy_off_visible" {}
						}
						icon = {
							size = { 16 16 }
							position = { 3 0 }
							parentanchor = left|vcenter
							texture = "gfx/interface/icons/space_race_icons/order_destroy.dds"
							block "fl_destroy_on_visible" {}
						}
						textbox = {
							position = { 21 0 }
							parentanchor = left|vcenter
							align = left|nobaseline
							autoresize = yes
							max_width = 76
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_fl_seize"
							block "fl_destroy_off_visible" {}
						}
						textbox = {
							position = { 21 0 }
							parentanchor = left|vcenter
							align = left|nobaseline
							autoresize = yes
							max_width = 76
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_fl_destroy"
							block "fl_destroy_on_visible" {}
						}
					}
					te_sr_stance_button = {
						blockoverride "sb_btn" {
							block "fl_stance_button" {}
						}
						blockoverride "sb_1" {
							block "fl_stance_1_visible" {}
						}
						blockoverride "sb_2" {
							block "fl_stance_2_visible" {}
						}
						blockoverride "sb_3" {
							block "fl_stance_3_visible" {}
						}
						blockoverride "sb_4" {
							block "fl_stance_4_visible" {}
						}
					}
				}
			}
		}
	}

	### ======================================================================
	### THE DESTINATION POPUP (UI pass design § 4)
	### ======================================================================

	### A fleet's destination popup, opened by the destination button on its
	### row in Space Fleets (te_popup sr_dest_<n>); instanced in te_popups
	### (gui/te_popups.gui). The bodies are te_sr_dest_popup_body's, one a slot
	### (sr_fleets_generated_rows.gui, gen_space_fleets.py), under the entry's
	### scope-free gate and its GetPlayerJournalEntry datacontext on a child
	### (gotchas #22, #29); with the entry gone, one line says so.
	type te_sr_dest_popup = te_ui_popup {
		blockoverride "popup_visible" {
			visible = "[Or( Or( Or( GetVariableSystem.HasValue('te_popup', 'sr_dest_1'), GetVariableSystem.HasValue('te_popup', 'sr_dest_2') ), Or( GetVariableSystem.HasValue('te_popup', 'sr_dest_3'), GetVariableSystem.HasValue('te_popup', 'sr_dest_4') ) ), Or( Or( GetVariableSystem.HasValue('te_popup', 'sr_dest_5'), GetVariableSystem.HasValue('te_popup', 'sr_dest_6') ), Or( GetVariableSystem.HasValue('te_popup', 'sr_dest_7'), Or( GetVariableSystem.HasValue('te_popup', 'sr_dest_8'), GetVariableSystem.HasValue('te_popup', 'sr_dest_9') ) ) ) )]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_dp_title"
		}
		### The rows' 756, plus the window's margins (2 × 35), the list's
		### (2 × 10) and a scrollbar: 884.
		blockoverride "popup_size" {
			size = { 884 600 }
		}
		blockoverride "popup_list" {
			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					datacontext = "[GetPlayerJournalEntry('je_space_race_solar_colonization')]"
					direction = vertical
					ignoreinvisible = yes

					te_sr_dest_popup_body = {}
				}
			}
			te_sr_note = {
				visible = "[Not( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				text = "je_space_race_widget_tp_gone"
			}
		}
	}

	### One slot's body in the destination popup (instances in
	### te_sr_dest_popup_body). While the fleet is at a location: the fleet
	### (te_sr_fleet_row's Where, Strength, km/s and Supply, its ships on the
	### strength's hover), a note while it can't leave this month whatever the
	### leg (sr_disp_fl_<n>_why: no Space Command of ours, refitting, below the
	### minimum strength, Earth's launches barred), and a row per other
	### location. Otherwise one line, so
	### nothing acts on a slot that has left or is gone.
	type te_sr_dest_slot = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		minimumsize = { 756 -1 }
		spacing = 2
		block "dp_visible" {}

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			spacing = 2
			block "dp_here_visible" {}

			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				margin = { 4 1 }

				textbox = {
					size = { 130 20 }
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fl_col_where"
				}
				textbox = {
					size = { 92 20 }
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fl_col_strength"
				}
				textbox = {
					size = { 60 20 }
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fl_col_dv"
					tooltip = "je_space_race_widget_fl_dv_tt"
				}
				textbox = {
					size = { 58 20 }
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					text = "je_space_race_widget_fl_col_supply"
					tooltip = "je_space_race_widget_fl_supply_tt"
				}
			}
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				margin = { 4 1 }

				widget = {
					size = { 130 24 }
					parentanchor = vcenter

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 130
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "dp_where" {}
					}
				}
				widget = {
					size = { 92 24 }
					parentanchor = vcenter

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 92
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "dp_strength" {}
					}
				}
				widget = {
					size = { 60 24 }
					parentanchor = vcenter
					tooltip = "je_space_race_widget_fl_dv_tt"

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 60
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "dp_dv" {}
					}
				}
				widget = {
					size = { 58 24 }
					parentanchor = vcenter
					tooltip = "je_space_race_widget_fl_supply_tt"

					textbox = {
						parentanchor = left|vcenter
						autoresize = yes
						max_width = 58
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						block "dp_supply" {}
					}
				}
			}

			### Why it can't leave this month, whatever the leg; Go waits, the
			### choice doesn't.
			te_sr_note = {
				text = "je_space_race_widget_dp_why_refit"
				block "dp_why_1_visible" {}
			}
			te_sr_note = {
				text = "je_space_race_widget_dp_why_weak"
				block "dp_why_2_visible" {}
			}
			te_sr_note = {
				text = "je_space_race_widget_dp_why_barred"
				block "dp_why_3_visible" {}
			}
			te_sr_note = {
				text = "je_space_race_widget_dp_why_no_sc"
				block "dp_why_4_visible" {}
			}

			te_sr_dest_header_row = {}
			block "dp_rows" {}
		}
		te_sr_note = {
			text = "je_space_race_widget_dp_gone"
			block "dp_gone_visible" {}
		}
	}

	### The column heads above the destination rows, te_sr_dest_row's widths.
	type te_sr_dest_header_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4
		margin = { 4 1 }

		textbox = {
