	### Space Command (Full Colonies; slice 6 design § 5): what it builds a month
	### and its levels, the fleets' strength and its upkeep, then the build mix,
	### five buttons each stepping a role's weight 0 → 3 (sr_sc_mix_sgui,
	### scope:op the role). Open by default; the flag is
	### sr_panel_space_command_closed.
	type te_sr_sc_mix_button = button {
		using = default_button_action
		size = { 90 26 }
		parentanchor = vcenter
		block "mix_button" {}

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 86
			elide = right
			using = te_sr_fontsize_row
			block "mix_label" {}
		}
	}

	type te_sr_sec_space_command = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[And( JournalEntry.IsActive, EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ) )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_sc_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_space_command_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_space_command_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_space_command_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_space_command_closed'))]"

			### 6d: nothing leaves Earth (design § 15). State, so in the row style;
			### the rules are in How Solar Colonization Works.
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_earth_blockaded'), '(CFixedPoint)1' )]"
				text = "je_space_race_widget_sc_blockaded_note"
			}
			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_launch_site_lost'), '(CFixedPoint)1' )]"
				text = "je_space_race_widget_sc_site_lost_note"
			}
			te_sr_value_row = {
				tooltip = "je_space_race_widget_sc_rate_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_sc_rate_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_sc_rate_figure"
				}
			}
			te_sr_value_row = {
				tooltip = "je_space_race_widget_sc_strength_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_sc_strength_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_sc_strength_figure"
				}
			}
			te_sr_value_row = {
				tooltip = "je_space_race_widget_sc_upkeep_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_sc_upkeep_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_sc_upkeep_figure"
				}
			}
			### 6d: the ground reserve (design § 15), Launch and its toggle.
			te_sr_value_row = {
				tooltip = "je_space_race_widget_sc_reserve_tt"
				blockoverride "row_label" {
					text = "je_space_race_widget_sc_reserve_label"
				}
				blockoverride "row_value" {
					text = "je_space_race_widget_sc_reserve_figure"
				}
			}
			flowcontainer = {
				direction = horizontal
				ignoreinvisible = yes
				spacing = 4
				margin = { 4 1 }

				te_sr_sc_mix_button = {
					blockoverride "mix_button" {
						enabled = "[GetScriptedGui('sr_reserve_launch_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('sr_reserve_launch_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_reserve_launch_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_reserve_launch_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
					}
					blockoverride "mix_label" {
						text = "je_space_race_widget_sc_launch"
					}
				}
				te_sr_sc_mix_button = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_reserve_auto'), '(CFixedPoint)1' )]"
					blockoverride "mix_button" {
						enabled = "[GetScriptedGui('sr_reserve_auto_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('sr_reserve_auto_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_reserve_auto_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_reserve_auto_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
					}
					blockoverride "mix_label" {
						text = "je_space_race_widget_sc_auto_on"
					}
				}
				te_sr_sc_mix_button = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_reserve_auto'), '(CFixedPoint)0' )]"
					blockoverride "mix_button" {
						enabled = "[GetScriptedGui('sr_reserve_auto_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('sr_reserve_auto_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_reserve_auto_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_reserve_auto_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"
					}
					blockoverride "mix_label" {
						text = "je_space_race_widget_sc_auto_off"
					}
				}
			}
			te_sr_subheader = {
				blockoverride "subheader_text" {
					text = "je_space_race_widget_sc_mix_header"
				}
			}
			flowcontainer = {
				direction = horizontal
				spacing = 4
				margin = { 4 1 }

				te_sr_sc_mix_button = {
					blockoverride "mix_button" {
						enabled = "[GetScriptedGui('sr_sc_mix_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						onclick = "[GetScriptedGui('sr_sc_mix_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_sc_mix_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_sc_mix_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End ) ) )]"
					}
					blockoverride "mix_label" {
						text = "je_space_race_widget_sc_mix_war"
					}
				}
				te_sr_sc_mix_button = {
					blockoverride "mix_button" {
						enabled = "[GetScriptedGui('sr_sc_mix_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						onclick = "[GetScriptedGui('sr_sc_mix_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_sc_mix_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_sc_mix_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)2' ) ).End ) ) )]"
					}
					blockoverride "mix_label" {
						text = "je_space_race_widget_sc_mix_rapid"
					}
				}
				te_sr_sc_mix_button = {
					blockoverride "mix_button" {
						enabled = "[GetScriptedGui('sr_sc_mix_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
						onclick = "[GetScriptedGui('sr_sc_mix_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_sc_mix_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_sc_mix_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)3' ) ).End ) ) )]"
					}
					blockoverride "mix_label" {
						text = "je_space_race_widget_sc_mix_siege"
					}
				}
				te_sr_sc_mix_button = {
					blockoverride "mix_button" {
						enabled = "[GetScriptedGui('sr_sc_mix_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
						onclick = "[GetScriptedGui('sr_sc_mix_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_sc_mix_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_sc_mix_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)4' ) ).End ) ) )]"
					}
					blockoverride "mix_label" {
						text = "je_space_race_widget_sc_mix_carrier"
					}
				}
				te_sr_sc_mix_button = {
					blockoverride "mix_button" {
						enabled = "[GetScriptedGui('sr_sc_mix_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
						onclick = "[GetScriptedGui('sr_sc_mix_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_sc_mix_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_sc_mix_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)5' ) ).End ) ) )]"
					}
					blockoverride "mix_label" {
						text = "je_space_race_widget_sc_mix_tender"
					}
				}
			}
		}
	}

	### Fleets (Full Colonies; slice 6 design § 16): our nine fleet slots, then
	### every location's forces. Open by default; the flags are
	### sr_panel_space_fleets_closed and, for Locations, sr_panel_locations_closed
	### (sr_panel_fleets_closed is Colony Fleets').
	type te_sr_sec_space_fleets = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		spacing = 2
		visible = "[And( JournalEntry.IsActive, EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_full'), '(CFixedPoint)1' ) )]"

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_space_fleets_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_space_fleets_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_space_fleets_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_space_fleets_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_space_fleets_closed'))]"

			te_sr_text = {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)0' )]"
				text = "je_space_race_widget_space_fleets_empty"
			}
			te_sr_fleet_header_row = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_fl_count'), '(CFixedPoint)1' )]"
			}
			te_sr_fleet_rows = {}
		}

		te_sr_section_header = {
			blockoverride "left_text" {
				text = "je_space_race_widget_locations_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_locations_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_locations_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_locations_closed'))]"
			}
		}

		te_sr_panel = {
			visible = "[Not(GetVariableSystem.Exists('sr_panel_locations_closed'))]"

			te_sr_location_header_row = {}
			te_sr_location_rows = {}
		}
	}

	### Everything a returning player checks, open by default.
	type te_sr_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_sr_sec_control = {
			blockoverride "control_onclick" {
				block "sr_control_onclick" {}
			}
			blockoverride "control_showmore" {
				block "sr_control_showmore" {}
			}
			blockoverride "control_showless" {
				block "sr_control_showless" {}
			}
			blockoverride "control_visible" {
				block "sr_control_visible" {}
			}
			blockoverride "funding_value" {
				block "sr_funding_value" {}
			}
			blockoverride "setbacks_value" {
				block "sr_setbacks_value" {}
			}
			blockoverride "eta_value" {
				block "sr_eta_value" {}
			}
			blockoverride "profile_text" {
				block "sr_profile_text" {}
			}
			blockoverride "control_extra" {
				block "sr_control_extra" {}
			}
			blockoverride "control_debris" {
				block "status_debris" {
					te_sr_debris_row = {}
				}
			}
		}
		te_sr_sec_rivals = {
			blockoverride "rivals_onclick" {
				block "sr_rivals_onclick" {}
			}
			blockoverride "rivals_showmore" {
				block "sr_rivals_showmore" {}
			}
			blockoverride "rivals_showless" {
				block "sr_rivals_showless" {}
			}
			blockoverride "rivals_visible" {
				block "sr_rivals_visible" {}
			}
			blockoverride "rivals_none" {
				block "sr_rivals_none" {}
			}
			blockoverride "rivals_datamodel" {
				block "sr_rivals_datamodel" {}
			}
			blockoverride "rival_tooltip" {
				block "sr_rival_tooltip" {}
			}
			blockoverride "rival_lo" {
				block "sr_rival_lo" {}
			}
			blockoverride "rival_hi" {
				block "sr_rival_hi" {}
			}
			blockoverride "rival_est" {
				block "sr_rival_est" {}
			}
			blockoverride "rival_range" {
				block "sr_rival_range" {}
			}
		}
	}

	### ======================================================================
	### THE SPACE RACE TAB'S OWN SECTIONS (the Timeline Extended window,
	### gui/te_systems_window.gui). The tab stays open once the country is in
	### the race (sr_in_space_race), with or without a milestone running, so
	### these read no journal entry: the player through GetPlayer, a power
	### through its capital. Below the milestones' blocks; never in the journal.
	### ======================================================================

	### One entry of a power's programme in a Space Powers row: its journal
	### icon at half the programme row's size, lit once achieved, half while
	### under way, faint otherwise, with a small mark for a first
	### (te_sr_ov_prog_cell's states). The instance sets the texture, the
	### tests that pick one, and the tooltip: the state in words, in the third
	### person (sr_power_prog_<m>, read on the row's power).
	type te_sr_power_cell = widget {
		size = { 24 24 }

		icon = {
			size = { 22 22 }
			parentanchor = center
			block "lit" {}
			block "prog_texture" {}
		}
		icon = {
			size = { 22 22 }
			parentanchor = center
			alpha = 0.6
			block "running" {}
			block "prog_texture" {}
		}
		icon = {
			size = { 22 22 }
			parentanchor = center
			alpha = 0.25
			block "unlit" {}
			block "prog_texture" {}
		}
		icon = {
			size = { 10 10 }
			parentanchor = top|right
			texture = "gfx/interface/icons/space_race_icons/first_mark.dds"
			block "first" {
				visible = no
			}
		}
	}

	### The Interstellar Probe and the wait for its data in a Space Powers row:
	### te_sr_ov_prog_cell_interstellar's four states at half the size, on the
	### row's power, with one hover for all four.
	type te_sr_power_cell_interstellar = widget {
		size = { 24 24 }
		tooltip = "je_space_race_widget_power_prog_interstellar"

		icon = {
			size = { 22 22 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/interstellar_not_begun.dds"
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_interstellar'), '(CFixedPoint)0' )]"
		}
		icon = {
			size = { 22 22 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/interstellar_under_way.dds"
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_interstellar'), '(CFixedPoint)1' )]"
		}
		icon = {
			size = { 22 22 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/interstellar_awaiting_data.dds"
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_interstellar'), '(CFixedPoint)2' )]"
		}
		icon = {
			size = { 22 22 }
			parentanchor = center
			texture = "gfx/interface/icons/space_race_icons/interstellar_data_received.dds"
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_interstellar'), '(CFixedPoint)3' )]"
		}
		icon = {
			size = { 10 10 }
			parentanchor = top|right
			texture = "gfx/interface/icons/space_race_icons/first_mark.dds"
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_interstellar_probe'), '(CFixedPoint)4' )]"
		}
	}

	### The text of a row's estimate column: right-aligned in the column, its
	### width fixed (te_sr_power_lead_band / _own). The instance sets which
	### code it shows for, its text and its hover.
	type te_sr_power_lead_text = textbox {
		minimumsize = { 266 -1 }
		maximumsize = { 266 -1 }
		autoresize = yes
		elide = right
		parentanchor = right|vcenter
		align = right|nobaseline
		using = te_sr_fontsize_row
		default_format = "#tooltippable"
	}

	### The estimate column of another power's row: its furthest milestone
	### under way (sr_disp_power_lead) and the Rivals rows' band around its
	### progress (sr_disp_rival_lo/hi_<m>, the power passed in as
	### scope:sr_rival), so the band is as wide as the Rivals rows' and our
	### covert network narrows it alike. One text per code, by one equality
	### test each, so no two show at once.
	type te_sr_power_lead_band = widget {
		size = { 270 24 }

		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)0' )]"
			text = "je_space_race_widget_power_lead_none"
			tooltip = "je_space_race_widget_power_lead_none_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)1' )]"
			text = "je_space_race_widget_power_lead_suborbital"
			tooltip = "je_space_race_widget_power_est_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)2' )]"
			text = "je_space_race_widget_power_lead_orbital"
			tooltip = "je_space_race_widget_power_est_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)3' )]"
			text = "je_space_race_widget_power_lead_moon_landing"
			tooltip = "je_space_race_widget_power_est_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)4' )]"
			text = "je_space_race_widget_power_lead_probe"
			tooltip = "je_space_race_widget_power_est_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)5' )]"
			text = "je_space_race_widget_power_lead_moon_base"
			tooltip = "je_space_race_widget_power_est_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)6' )]"
			text = "je_space_race_widget_power_lead_mars_landing"
			tooltip = "je_space_race_widget_power_est_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)7' )]"
			text = "je_space_race_widget_power_lead_interstellar_probe"
			tooltip = "je_space_race_widget_power_est_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)8' )]"
			text = "je_space_race_widget_power_lead_solar_colonization"
			tooltip = "je_space_race_widget_power_est_tt"
		}
	}

	### The estimate column of our own row: our furthest milestone under way and
	### our exact progress towards its goal (sr_disp_progress_frac_<m>).
	type te_sr_power_lead_own = widget {
		size = { 270 24 }

		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)0' )]"
			text = "je_space_race_widget_power_lead_none"
			tooltip = "je_space_race_widget_power_lead_none_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)1' )]"
			text = "je_space_race_widget_power_own_suborbital"
			tooltip = "je_space_race_widget_power_own_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)2' )]"
			text = "je_space_race_widget_power_own_orbital"
			tooltip = "je_space_race_widget_power_own_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)3' )]"
			text = "je_space_race_widget_power_own_moon_landing"
			tooltip = "je_space_race_widget_power_own_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)4' )]"
			text = "je_space_race_widget_power_own_probe"
			tooltip = "je_space_race_widget_power_own_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)5' )]"
			text = "je_space_race_widget_power_own_moon_base"
			tooltip = "je_space_race_widget_power_own_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)6' )]"
			text = "je_space_race_widget_power_own_mars_landing"
			tooltip = "je_space_race_widget_power_own_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)7' )]"
			text = "je_space_race_widget_power_own_interstellar_probe"
			tooltip = "je_space_race_widget_power_own_tt"
		}
		te_sr_power_lead_text = {
			visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_power_lead'), '(CFixedPoint)8' )]"
			text = "je_space_race_widget_power_own_solar_colonization"
			tooltip = "je_space_race_widget_power_own_tt"
		}
	}

	### One power in Space Powers: its name on a line of its own (a name can
	### run to 48 characters, which no column beside the icons holds), then its
	### programme as eight small icons in journal order (te_sr_ov_programme's
	### order), and, in a fixed column beside them, its furthest milestone
	### under way with its progress (lead_column: te_sr_power_lead_band for a
	### rival, te_sr_power_lead_own for us). 8 x 24 + 8 x 2 + 270 = 478, inside
	### the 480 column. Our row sets the datacontext on the inner container
	### ("row_context"); the others are items of the Space Powers datamodel,
	### each with its capital as the item's datacontext.
	type te_sr_power_row = widget {
		size = { 480 50 }

		flowcontainer = {
			direction = vertical
			spacing = 4
			block "row_context" {}

			textbox = {
				minimumsize = { 480 -1 }
				maximumsize = { 480 -1 }
				autoresize = yes
				elide = right
				align = left|nobaseline
				using = te_sr_fontsize_row
				default_format = "#tooltippable"
				text = "je_space_race_widget_rival_name"
				tooltip = "je_space_race_widget_power_name_tt"
			}
			flowcontainer = {
				direction = horizontal
				spacing = 2

				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_suborbital"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_suborbital.dds"
					}
					blockoverride "lit" {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)3' )]"
					}
					blockoverride "running" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)1' )]"
					}
					blockoverride "unlit" {
						visible = "[And( Not( GreaterThanOrEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)3' ) ), NotEqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)1' ) )]"
					}
					blockoverride "first" {
						visible = "[EqualTo_CFixedPoint( State.GetCountry.MakeScope.ScriptValue('sr_disp_prog_suborbital'), '(CFixedPoint)4' )]"
					}
				}
				te_sr_power_cell = {
					tooltip = "je_space_race_widget_power_prog_orbital"
					blockoverride "prog_texture" {
						texture = "gfx/interface/icons/event_icons/je_space_race_orbital.dds"
					}
					blockoverride "lit" {
