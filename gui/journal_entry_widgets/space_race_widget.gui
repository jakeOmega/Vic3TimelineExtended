	### One fleet slot in Fleets: where it is (or "→ Mars" in transit), its
	### strength now / full (the roles on hover), its drive (or its refit's
	### months), its propellant in km/s (its capacity on the strength hover), its
	### months of supply and its marines; then, at a location, its orders: the destination button
	### (it steps through the other eight; the leg on hover), Go, Merge, Detach,
	### Land, Embark; and from 6b its posture, its target world and Seize /
	### Destroy. In transit, its landing instead. 90 + 92 + 96 + 48 + 58 + 66 +
	### 5 × 4 + 2 × 4 = 478; the orders 108 + 5 × 60 + 5 × 4 = 428; posture,
	### target and Seize 104 + 190 + 80 + 2 × 4 = 382. Instances in
	### te_sr_fleet_rows (sr_fleets_generated_rows.gui), one per slot; the
	### scripted GUIs are sr_fleet_sguis.txt's, scope:op the slot.
	type te_sr_fleet_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 2
		block "fl_visible" {}

		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin = { 4 1 }

			widget = {
				size = { 90 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 90
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_where" {}
				}
			}
			widget = {
				size = { 92 24 }
				parentanchor = vcenter

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 92
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_strength" {}
				}
			}
			widget = {
				size = { 96 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_drive_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 96
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_drive" {}
				}
				flowcontainer = {
					parentanchor = left|vcenter
					direction = horizontal
					spacing = 2
					ignoreinvisible = yes
					block "fl_refit_visible" {}

					background = {
						using = entry_bg_fancy_dark
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 60
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						text = "je_space_race_widget_fl_refit"
					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 18
						align = left|nobaseline
						using = te_sr_fontsize_row
						default_format = "#v"
						block "fl_refit" {}
					}
				}
			}
			widget = {
				size = { 48 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_dv_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 48
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_dv" {}
				}
			}
			widget = {
				size = { 58 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_supply_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 58
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_supply" {}
				}
			}
			widget = {
				size = { 66 24 }
				parentanchor = vcenter
				tooltip = "je_space_race_widget_fl_marines_tt"

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 66
					align = left|nobaseline
					using = te_sr_fontsize_row
					elide = right
					block "fl_marines" {}
				}
			}
		}
		### In transit: when it lands.
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			margin = { 8 1 }
			block "fl_transit_visible" {}

			textbox = {
				autoresize = yes
				max_width = 460
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				block "fl_transit" {}
			}
		}
		### Orders, at a location.
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin = { 4 1 }
			block "fl_orders_visible" {}

			button = {
				using = default_button_action
				size = { 108 22 }
				parentanchor = vcenter
				block "fl_pick_button" {}

				textbox = {
					parentanchor = center
					align = center|nobaseline
