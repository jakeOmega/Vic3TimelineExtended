	### The reference, after the live sections.
	type te_sr_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_sr_sec_how = {}
	}

	### ======================================================================
	### PER-MILESTONE PANELS. What each milestone's journal roots wrap, and
	### what the Timeline Extended window's Space Race tab instances
	### (gui/te_systems_window.gui), so the two hosts cannot drift: the
	### milestone's scripted GUI as the datacontext its controls address,
	### and its data passed to the composers as sr_* blockoverrides. Each
	### reads only its own milestone (test_space_race_layout.py).
	### ======================================================================

	### suborbital: the overview, wrapped by the journal root
	### widget_je_space_race_suborbital_overview.
	type te_sr_suborbital_overview = flowcontainer {
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		datacontext = "[GetScriptedGui('sr_milestone_suborbital_sgui')]"

		te_sr_overview_milestone = {
			blockoverride "sr_status_standard" {
				visible = "[LessThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_status_suborbital'), '(CFixedPoint)1' )]"
			}
			blockoverride "sr_status_safe" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_status_suborbital'), '(CFixedPoint)2' )]"
			}
			blockoverride "sr_status_ambitious" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_status_suborbital'), '(CFixedPoint)3' )]"
			}
			blockoverride "sr_status_shielded" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_status_suborbital'), '(CFixedPoint)4' )]"
			}
			blockoverride "sr_risk_lit" {
				visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_risk_shown_suborbital'), '(CFixedPoint)0' )]"
			}
			blockoverride "sr_risk_unlit" {
				visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_risk_shown_suborbital'), '(CFixedPoint)0' )]"
			}
			blockoverride "sr_risk_label" {
				text = "je_space_race_widget_risk_suborbital"
			}
			blockoverride "sr_label_safe" {
				text = "je_space_race_widget_ov_safe_suborbital"
			}
			blockoverride "sr_label_ambitious" {
				text = "je_space_race_widget_ov_ambitious_suborbital"
			}
			blockoverride "sr_third_cells" {
				te_sr_ov_first = {
					blockoverride "first_open" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_first_claimed_suborbital'), '(CFixedPoint)0' )]"
					}
					blockoverride "first_claimed" {
						visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_first_claimed_suborbital'), '(CFixedPoint)1' )]"
					}
				}
			}
			blockoverride "sr_progress_label" {
				text = "je_space_race_widget_ov_progress_label"
			}
			blockoverride "sr_progress_value" {
				value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_progress_frac_suborbital') )]"
			}
			blockoverride "sr_progress_text" {
				text = "je_space_race_widget_progress_suborbital"
			}
			blockoverride "sr_progress_tooltip" {
				tooltip = "je_space_race_widget_reward_suborbital"
			}
		}
	}

	### suborbital: the live sections, wrapped by the journal root
	### widget_je_space_race_suborbital.
	type te_sr_suborbital_status = flowcontainer {
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		datacontext = "[GetScriptedGui('sr_milestone_suborbital_sgui')]"

		te_sr_status_sections = {
			blockoverride "status_debris" {
				block "sr_debris" {
					te_sr_debris_row = {}
				}
			}
			blockoverride "sr_control_onclick" {
				onclick = "[GetVariableSystem.Toggle('sr_panel_control_suborbital_closed')]"
			}
			blockoverride "sr_control_showmore" {
				visible = "[GetVariableSystem.Exists('sr_panel_control_suborbital_closed')]"
			}
			blockoverride "sr_control_showless" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_control_suborbital_closed'))]"
			}
			blockoverride "sr_control_visible" {
				visible = "[Not(GetVariableSystem.Exists('sr_panel_control_suborbital_closed'))]"
