			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
			text = "je_space_race_widget_dp_col_window"
			tooltip = "je_space_race_widget_dp_col_window_tt"
		}
		textbox = {
			size = { 44 20 }
			align = left|nobaseline
			using = te_sr_fontsize_row
			elide = right
