		textbox = {
			position = { 0 24 }
			parentanchor = top|hcenter
			autoresize = yes
			max_width = 88
			elide = right
			align = center|nobaseline
			using = te_sr_fontsize_overview
			block "rc_label" {}
		}
	}

	### One reading on a fleet's card as a bar (style guide rule 5): its
