					text = "je_space_race_widget_colonies_stage_1"
				}
			}

			te_sr_colony_row = {
				blockoverride "colony_visible" {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colony_valles_marineris_research'), '(CFixedPoint)1' )]"
				}
				blockoverride "colony_tooltip" {
					tooltip = "je_space_race_widget_colony_valles_marineris_research_tt"
				}
				blockoverride "colony_icon" {
					texture = "gfx/interface/icons/space_race_icons/colony_mars.dds"
