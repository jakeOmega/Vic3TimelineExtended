						size = { 66 24 }
						parentanchor = vcenter
						onclick = "[GetVariableSystem.Set('te_popup', 'sr_target')]"
						tooltip = "je_space_race_widget_cf_change_tt"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 62
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_cf_change"
						}
					}
					button = {
						using = default_button_action
						size = { 66 24 }
						parentanchor = vcenter
						enabled = "[GetScriptedGui('sr_cf_target_clear_sgui').IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						onclick = "[GetScriptedGui('sr_cf_target_clear_sgui').Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
						tooltip = "[Concatenate( GetScriptedGui('sr_cf_target_clear_sgui').IsValidTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), GetScriptedGui('sr_cf_target_clear_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) ) )]"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 62
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_ss_target_clear"
						}
					}
				}
			}
			te_sr_cf_dest_row = {
				blockoverride "dest_row" {
					visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)0' ) )]"
					tooltip = "je_space_race_widget_cf_destination_auto"
				}
				blockoverride "dest_label" {
					text = "je_space_race_widget_cf_next_label"
				}
				blockoverride "dest_value" {
					text = "je_space_race_widget_cf_next_auto"
				}
				blockoverride "dest_button" {
					button = {
						using = default_button_action
						size = { 66 24 }
						parentanchor = vcenter
						onclick = "[GetVariableSystem.Set('te_popup', 'sr_target')]"
						tooltip = "je_space_race_widget_cf_change_tt"

						textbox = {
							parentanchor = center
							align = center|nobaseline
							autoresize = yes
							max_width = 62
							elide = right
							using = te_sr_fontsize_row
							text = "je_space_race_widget_cf_choose"
						}
					}
				}
			}
			te_sr_cf_dest_row = {
				blockoverride "dest_row" {
					visible = "[And( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_cf_target'), '(CFixedPoint)0' ), EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('sr_disp_colonies_contested'), '(CFixedPoint)1' ) )]"
					tooltip = "je_space_race_widget_cf_destination_auto_contested"
				}
