					}
					textbox = {
						parentanchor = vcenter
						autoresize = yes
						max_width = 66
						align = left|nobaseline
						using = te_sr_fontsize_row
						elide = right
						text = "je_space_race_widget_eb_a_level"
					}
				}
			}
		}
		flowcontainer = {
			direction = horizontal
			ignoreinvisible = yes
			spacing = 4
			margin_left = 28
