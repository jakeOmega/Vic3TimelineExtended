			}
		}
		button_icon_cancel = {
			size = { 24 24 }
			parentanchor = vcenter
			block "mq_remove_button" {}
		}
	}

	### ======================================================================
	### FLEETS (solar colonization, Full Colonies; slice 6 design § 16)
	### ======================================================================

	### A small action button in a fleet's orders line: its icon, then its
	### word. `fl_btn` carries the four properties that address the scripted
	### GUI (the slot is scope:op), `fl_btn_icon` the texture, `fl_btn_label`
	### the text. 3 + 16 + 2 + 58 + 1 = 80.
	type te_sr_fl_button = button {
		using = default_button_action
		size = { 80 26 }
		parentanchor = vcenter
		block "fl_btn" {}

		icon = {
			size = { 16 16 }
			position = { 3 0 }
			parentanchor = left|vcenter
			block "fl_btn_icon" {}
		}
		textbox = {
			position = { 21 0 }
			parentanchor = left|vcenter
			align = left|nobaseline
			autoresize = yes
			max_width = 58
			elide = right
			using = te_sr_fontsize_row
			block "fl_btn_label" {}
		}
	}

