				max_width = 122
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				default_format = "#grey"
				text = "je_space_race_widget_ss_unclaimed"
				block "fr_unclaimed_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 122
				align = left|nobaseline
				using = te_sr_fontsize_row
				elide = right
				tooltip = "je_space_race_widget_ss_free_tt"
				text = "je_space_race_widget_ss_free"
				block "fr_free_visible" {}
			}
			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				max_width = 122
				align = left|nobaseline
