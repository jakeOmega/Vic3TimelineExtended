			parentanchor = vcenter
			block "free_supply_button" {}

			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 62
				elide = right
				using = te_sr_fontsize_row
				text = "je_space_race_widget_free_supply"
				block "free_supply_visible" {}
			}
			textbox = {
				parentanchor = center
				align = center|nobaseline
				autoresize = yes
				max_width = 62
				elide = right
				using = te_sr_fontsize_row
