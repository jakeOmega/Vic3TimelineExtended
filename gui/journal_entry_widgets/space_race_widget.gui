	### The Help page's popup, in te_popups (gui/te_popups.gui).
	type te_space_race_help_popup = te_ui_help_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'help_space_race')]"
		}
		blockoverride "popup_title" {
			text = "je_space_race_widget_how_header"
		}
		blockoverride "popup_list" {
			te_space_race_help_body = {}
		}
	}

	### The Space Race tab of the Timeline Extended window (the window mounts
	### it from gui/te_systems_window_generated.gui). Open from the first
	### milestone on, with or without one running (te_window_space_race_tab_sgui,
	### sr_in_space_race). First the entries (owner, 2026-10-27):
	### te_sr_window_milestones (generated, from the generator's SR_MILESTONES)
	### holds a te_system_tab_frame per entry, since GetPlayerJournalEntry takes
	### one literal key, each shown only while the shown Country holds that
	### entry active (its live sections, which read the entry, the player's own:
	### te_own_country_only), and a note in their place while none is; each
	### frame's header, and the note's, carries the "?" to the Help page. Then
	### the tab's own sections, which read no entry: Space Powers (the
	### country's program, and for the player every other power's) and Orbit
	### (debris, satellites, strikes), after the milestones
	### (owner, 2026-10-27: the milestone we run is the summary a player acts
	### on), under the tab's own gate, so they show between milestones too.
	### Orbit holds the debris row.
	###
	### Not drawn, as in the journal: the goal bar (every entry mounts the
	### bars-on-top marker, and the overview draws the progress), the status
	### line (only for an inactive entry) and the 32 scripted buttons (the AI's:
	### each `visible` carries is_ai = yes; Mission Control carries the same
	### actions for a human). te_sr_tab_layout is the block a wide mount
	### overrides.
	type te_sr_tab_body = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		ignoreinvisible = yes
		spacing = 10

		block "te_sr_tab_layout" {
			te_sr_window_milestones = {}

			flowcontainer = {
				name = "te_systems_window_space_race_summary"
				visible = "[GetScriptedGui('te_window_space_race_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
				parentanchor = hcenter
				direction = vertical
				ignoreinvisible = yes
				spacing = 4
				minimumsize = { 520 -1 }

				te_sr_sec_powers = {}
				te_sr_sec_orbit = {}
			}
		}
	}

	### The tab full screen (spec docs/superpowers/specs/2026-11-02-te-window-wide-mode-design.md
	### § 7), te_sr_tab_layout's override in the window's full-screen frame, in
	### three columns of a fixed 520 (te_ui_columns_three), read down each and
	### then across. Solar System Colonization's four tabs lie side by side,
	### with no tab buttons (owner, 2026-11-26: the side columns held only
	### read-only figures while the tabs hid three of four parts): column 1 the
	### milestones under way, Solar Colonization's frame filling its
	### sr_window_solar_colonization_live block with Mission Control and the
	### Solar System under its overview (its debris row left to Orbit), above
	### its Program Effects and Open Journal Entry; column 2 Colonies, which
	### keeps its views' buttons; column 3 Fleets, then Space Powers and Orbit.
	### Colonies' column closes up while it doesn't show (another milestone, or
	### another country's in National Info), leaving two; Fleets shows under
	### the same gates as Colonies. The summary keeps the tab's gate on its own
	### wrapper, as in te_sr_tab_body (the name stays there: the window's tests
	### find the wrapper by it).
	type te_sr_wide_sections = te_ui_columns_three {
		### Each milestone's header, and the idle note's, at the column's 520
		### (sr_window_header_size, generated), not the side panel's 554, which
		### overhung the column by 17 a side: here they head a column under the
		### page's own title, which the window's full-screen mount draws.
		blockoverride "column_1" {
			te_sr_window_milestones = {
				blockoverride "sr_window_solar_colonization_live" {
					te_sr_solar_colonization_mission = {
						blockoverride "sr_mission_debris" {}
					}
					te_sr_solar_colonization_system = {}
				}
				blockoverride "sr_window_header_size" {
					size = { 520 44 }
				}
			}
		}

		blockoverride "column_2_visible" {
			visible = "[And( GetScriptedGui('te_window_space_race_solar_colonization_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), Country.IsLocalPlayer )]"
		}
		blockoverride "column_2" {
			te_sr_window_solar_colonization_colonies = {}
		}

		blockoverride "column_3" {
			te_sr_window_solar_colonization_fleets = {}

			flowcontainer = {
				visible = "[GetScriptedGui('te_window_space_race_tab_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
				parentanchor = hcenter
				direction = vertical
				ignoreinvisible = yes
				spacing = 4
				minimumsize = { 520 -1 }

				te_sr_sec_powers = {}
				te_sr_sec_orbit = {}
			}
		}
	}

	### ======================================================================
	### PER-MILESTONE PANELS. What each milestone's journal roots wrap, and
	### what the Timeline Extended window's Space Race tab instances
	### (te_sr_window_milestones, gui/te_systems_window_generated.gui), so the
	### two hosts cannot drift: the
	### milestone's scripted GUI as the datacontext its controls address,
	### and its data passed to the composers as sr_* blockoverrides. Each
	### reads only its own milestone (test_space_race_layout.py).
	### ======================================================================

	### suborbital: the overview, wrapped by the journal root
	### widget_je_space_race_suborbital_overview.
	type te_sr_suborbital_overview = flowcontainer {
		parentanchor = hcenter
		minimumsize = { 520 -1 }
		ignoreinvisible = yes
		datacontext = "[GetScriptedGui('sr_milestone_suborbital_sgui')]"

		te_sr_overview_milestone = {
			blockoverride "sr_status_standard" {
				visible = "[LessThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_status_suborbital'), '(CFixedPoint)1' )]"
			}
			blockoverride "sr_status_safe" {
				visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_status_suborbital'), '(CFixedPoint)2' )]"
			}
			blockoverride "sr_status_ambitious" {
				visible = "[EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_disp_status_suborbital'), '(CFixedPoint)3' )]"
			}
			blockoverride "sr_risk_lit" {
				visible = "[NotEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('sr_risk_shown_suborbital'), '(CFixedPoint)0' )]"
			}
			blockoverride "sr_risk_unlit" {
