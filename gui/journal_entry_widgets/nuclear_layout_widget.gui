### Nuclear Weapons — layout. The one place that sets the order of the nuclear
### entry's sections (je_nuclear_program, "Nuclear Weapons"). The entry attaches
### the named roots at the foot of this file; the sections are types in
### nuclear_program_widget.gui (programme, taboo, delivery and defence, powers)
### and nuclear_deterrence_widget.gui (crisis, strike, world crises, posture, forces,
### at home, reputation); the overview is nuclear_overview_widget.gui. A future
### tab (style guide rule 9) would compose the same types.
###
### The whole panel, top to bottom (gui/journal_entry.gui draws container_1,
### the status desc (188), container_2, the button grid (hidden from humans),
### container_3, the native bar (670), container_4):
###   container_1  widget_je_nuclear_overview   the overview, always shown
###   status desc  empty while the entry is active (the overview says it all);
###                the taboo, programme and posture lines for an inactive one,
###                where it is the only thing drawn
###   container_3  widget_je_nuclear_programme  The Programme (only with one),
###                directly above the native bar, which is progress toward the
###                next warhead
###   native bar   progress toward the next warhead
###   container_4  widget_je_nuclear_status     the live sections, open:
###                Nuclear Crisis (only in one), Strike (armed, with a
###                country we could strike), World Crises (only while
###                there is one anywhere), Nuclear Posture, Forces and
###                At Home (only while armed), Reputation (once there is a
###                record), The Nuclear Taboo (from the first warhead), Delivery
###                and Defence, Nuclear Powers (from the first warhead)
###   container_4  widget_je_nuclear_reference  How Nuclear Weapons Work,
###                a link to the Help page (te_nuclear_weapons_help_popup,
###                in gui/te_popups.gui)
###
### Collapse flags say their default: *_closed sections are open until closed,
### *_open ones collapsed until opened (test_nuclear_layout.py).

types nuclear_layout_widget_types
{
	### Everything a returning player checks, open by default. The crisis comes
	### first while there is one: it has a deadline. The world's crises follow
	### it, for the same reason.
	type te_nuclear_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_nuclear_sec_crisis = {}
		te_nuclear_sec_strike = {}
		te_nuclear_sec_world_crises = {}
		te_nuclear_sec_posture = {}
		te_nuclear_sec_forces = {}
		te_nuclear_sec_home = {}
		te_nuclear_sec_reputation = {}
		te_nuclear_sec_taboo = {}
		te_nuclear_sec_delivery = {}
		te_nuclear_sec_powers = {}
	}

	### "How Nuclear Weapons Work": a link at the foot of the panel to the Help
	### page (style rule 1; spec 2026-11-02-charts-help-national-info § 5.2).
	### Its header alone, which opens te_nuclear_weapons_help_popup (te_popup =
	### help_nuclear_weapons) instead of expanding; it keeps its name and its
	### place in the composer. The "?" in the tab's header opens the same page.
	type te_nuclear_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 2

		nd_section_header = {
			tooltip = "te_help_link_tt"
			blockoverride "left_text" {
				text = "je_nuclear_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Set('te_popup', 'help_nuclear_weapons')]"
			}
			### No arrow: the link opens a page. Hide the arrows' container,
			### not the onclick_show* blocks: one of those also sits on the
			### header's expand_button widget, whose visibility picks the click
			### sound (vanilla section_header_button), so this keeps "increment".
			blockoverride "arrow_visible" {
				visible = no
			}
		}
	}

	### The Help page: every explanation, gathered out of the live sections, one
	### subheading per topic. The live sections say what is happening; this says
	### how it works. It reads GetPlayer only, never the entry, so it opens from
	### any host (test_te_help_pages.py). Instanced only by
	### te_nuclear_weapons_help_popup.
	type te_nuclear_weapons_help_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		nd_subheader = {
			blockoverride "subheader_margin" {}
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_programme"
			}
		}
		nd_note = {
			text = "je_nuclear_how_programme"
		}
		nd_subheader = {
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_crisis"
			}
		}
		nd_note = {
			text = "nd_w_crisis_actions_legend"
		}
		nd_subheader = {
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_strike"
			}
		}
		nd_note = {
			text = "je_nuclear_how_strike"
		}
		nd_subheader = {
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_posture"
			}
		}
		nd_note = {
			text = "je_nuclear_how_posture"
		}
		nd_subheader = {
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_home"
			}
		}
		nd_note = {
			text = "nd_w_home_legend"
		}
		nd_subheader = {
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_reputation"
			}
		}
		nd_note = {
			text = "nd_w_reputation_legend"
		}
		nd_subheader = {
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_taboo"
			}
		}
		nd_note = {
			text = "je_nuclear_how_taboo"
		}
		nd_subheader = {
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_delivery"
			}
		}
		nd_note = {
			text = "je_nuclear_program_widget_odds_note"
		}
		nd_subheader = {
			blockoverride "subheader_text" {
				text = "je_nuclear_how_sub_powers"
			}
		}
		nd_note = {
			text = "je_nuclear_program_widget_powers_legend"
		}
	}

	### The Help page's popup, in te_popups (gui/te_popups.gui).
	type te_nuclear_weapons_help_popup = te_ui_help_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'help_nuclear_weapons')]"
		}
		blockoverride "popup_title" {
			text = "je_nuclear_how_header"
		}
		blockoverride "popup_list" {
			te_nuclear_weapons_help_body = {}
		}
	}

	### How it all works. (The leaderboard was here, collapsed, until the owner's
	### rule of 2026-09-29 that live lists stay open.)
	type te_nuclear_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_nuclear_sec_how = {}
	}

	### The tab's body (spec 2026-11-02-te-window-wide-mode § 9.1):
	### te_system_tab_frame with its blocks filled, mounted by the Military
	### panel's Nuclear tab and the Timeline Extended window's Nuclear Weapons
	### tab. In the entry's order: the overview, The Programme with the entry's
	### progress bar under it, the live sections, then How Nuclear Weapons Work,
	### inside te_nuclear_tab_layout, which a wide mount overrides; then the
	### frame's Open Journal Entry. Not drawn: the status description (empty
	### while the entry is active: the overview says it) and the two scripted
	### buttons (the AI's; the programme's funding stepper carries the same
	### actions for a human).
	type te_nuclear_tab_body = te_system_tab_frame {
		blockoverride "tab_header" {
			default_header = {
				using = default_list_position
				blockoverride "text" {
					text = "je_nuclear_program"
				}
				te_help_button = {
					onclick = "[GetVariableSystem.Set('te_popup', 'help_nuclear_weapons')]"
				}
			}
		}

		blockoverride "tab_gate" {
			visible = "[GetScriptedGui('te_military_nuclear_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		blockoverride "tab_entry" {
			datacontext = "[GetPlayerJournalEntry('je_nuclear_program')]"
		}

		blockoverride "tab_content" {
			block "te_nuclear_tab_layout" {
				te_nuclear_overview_panel = {}
				te_nuclear_sec_programme = {}

				### The entry's own bar, progress toward the next warhead, under
				### The Programme as in the journal. Drawn only with a programme,
				### beside the section that explains it: the journal draws it
				### for every active entry, empty for a country with nothing to
				### build.
				flowcontainer = {
					visible = "[GetScriptedGui('nuclear_program_has_programme_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					parentanchor = hcenter
					direction = vertical
					ignoreinvisible = yes

					te_je_goal_bar = {}
				}

				te_nuclear_status_sections = {}
				te_nuclear_reference_sections = {}
			}
		}

		blockoverride "tab_open_journal_tooltip" {
			tooltip = "te_military_nuclear_open_journal_tt"
		}
	}

	### The tab in the Timeline Extended window's full screen (spec
	### 2026-11-02-te-window-wide-mode § 7): te_nuclear_tab_layout's sections
	### on te_ui_columns_three, read down each column and then across, each
	### under its composer's gate. The goal bar keeps its wrapper and gate,
	### under The Programme. The window's wide mount puts it in place of
	### te_nuclear_tab_layout; the Military panel and the side panel keep the
	### one column. test_nuclear_layout.py holds the columns.
	type te_nuclear_wide_sections = te_ui_columns_three {
		blockoverride "column_1" {
			te_nuclear_overview_panel = {}
			te_nuclear_sec_programme = {}

			flowcontainer = {
				visible = "[GetScriptedGui('nuclear_program_has_programme_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				parentanchor = hcenter
				direction = vertical
				ignoreinvisible = yes

				te_je_goal_bar = {}
			}

			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 4
				visible = "[JournalEntry.IsActive]"

				te_nuclear_sec_crisis = {}
				te_nuclear_sec_strike = {}
				te_nuclear_sec_world_crises = {}
			}
		}

		blockoverride "column_2" {
			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 4
				visible = "[JournalEntry.IsActive]"

				te_nuclear_sec_posture = {}
				te_nuclear_sec_forces = {}
				te_nuclear_sec_home = {}
				te_nuclear_sec_reputation = {}
			}
		}

		blockoverride "column_3" {
			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				ignoreinvisible = yes
				spacing = 4
				visible = "[JournalEntry.IsActive]"

				te_nuclear_sec_taboo = {}
				te_nuclear_sec_delivery = {}
				te_nuclear_sec_powers = {}
			}

			te_nuclear_reference_sections = {}
		}
	}
}

### ==========================================================================
### JOURNAL ENTRY ROOTS (je_nuclear_program.txt). Bare wrappers that repeat
### the IsActive gate, so an inactive entry's containers collapse: the entry
### carries is_shown_when_inactive, and a country whose entry never activated
### has none of the system's variables (gui_modding_guide.md gotcha #14).
###
### Each root is vertical and exactly a section's width (520, the section
### headers'). A wrapper whose width came from its one child was centred in
### the journal's column by the width it had when first laid out: the
### programme's, laid out while its section was still hidden, drew half its
### width off the column's left edge (play-test 2026-09-29). A fixed width
### cannot lag.
### ==========================================================================
flowcontainer = {
	name = "widget_je_nuclear_overview"
	visible = "[JournalEntry.IsActive]"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	minimumsize = { 520 -1 }

	te_je_country = {
		te_nuclear_overview_panel = {}
	}
}

### container_3, directly above the native bar. The root carries the section's
### "has a programme" gate as well as IsActive, as main's root did, so it is
### laid out only once there is something in it.
flowcontainer = {
	name = "widget_je_nuclear_programme"
	visible = "[And( JournalEntry.IsActive, GetScriptedGui('nuclear_program_has_programme_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ) )]"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	minimumsize = { 520 -1 }

	te_je_country = {
		te_nuclear_sec_programme = {}
	}
}

flowcontainer = {
	name = "widget_je_nuclear_status"
	visible = "[JournalEntry.IsActive]"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	minimumsize = { 520 -1 }

	te_je_country = {
		te_nuclear_status_sections = {}
	}
}

flowcontainer = {
	name = "widget_je_nuclear_reference"
	visible = "[JournalEntry.IsActive]"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes
	minimumsize = { 520 -1 }

	te_je_country = {
		te_nuclear_reference_sections = {}
	}
}
