### Covert Warfare JE widgets
###
### Three widgets, all mounted from je_covert_warfare:
###   widget_je_covert_command_centre  custom_widget_container_1  (above status desc)
###     Intelligence capacity, operation slots, the funding ladder and its
###     stepper, Tradecraft (slice 5), the detection factors and the defensive side. Everything the
###     journal entry used to say in 16 triggered_desc lines.
###   widget_je_covert_operations      custom_widget_container_2  (below status desc)
###     One row per running operation, from the operator's `iw_ops` variable
###     list of script containers (see common/scripted_effects/covert_warfare_effects.txt
###     for their tags and variables).
###   widget_je_covert_networks        custom_widget_container_3  (below the buttons)
###     One row per per-target network, from the operator's `iw_nets` list
###     (slice 4; see covert_warfare_effects.txt § PER-TARGET NETWORKS).
###
### SCRIPTED GUI OP CODES (common/scripted_guis/covert_warfare_sguis.txt):
###     0  funding stepper minus   covert_possible/effect_decrease_funding
###     1  funding stepper plus    covert_possible/effect_increase_funding
### Both delegate to the same shared trigger and effect the journal entry's
### scripted buttons call, so the grid and this widget cannot diverge.
###
### The per-row "Stand down" controls use no op code. They pass the row's target
### country as the saved scope `iw_tgt` and pick the operation type by which of
### the covert_stand_down_<type>_sgui entries (one per type) the instance points at — so
### the target can travel alone in a SINGLE AddScope, the only shape vanilla
### demonstrates. Fail-closed: see covert_possible_stand_down.
###
### The per-row priority stepper also uses no op code: up and down are two
### scripted GUIs (covert_priority_up_sgui / _down_sgui), and the row's
### container travels as the saved scope `iw_op`. Fail-closed: see
### covert_priority_op_is_ours.
###
### EDITING RULES
### * Never compare a game number against a literal here. The phase lines read
###   the stored `iw_phase` (1/2/3), written by covert_op_refresh_phase; the 6
###   and 12 month thresholds live only in covert_op_is_established /
###   covert_op_is_fully_operational.
### * Every question that needs script asks it through an is_shown-only
###   scripted GUI (covert_ops_dormant_sgui, covert_last_exposed_known_sgui,
###   covert_ops_phase_ready_sgui, covert_ops_priority_ready_sgui).
### * Panel NUMBERS come from JournalEntry.GetCountry.MakeScope.ScriptValue, a
###   proven read. GetModifier.GetValueWithBreakdownFor is used for hover
###   breakdowns ONLY, so if that chain fails in-game the panel still reads
###   correctly and only the tooltip is lost.
### * Target country names go through the stored capital state
###   (`iw_target_capital`), because Var().GetCountry.GetName renders blank in
###   this mod — docs/guides/gui_modding_guide.md gotcha #11.
### * All three roots are gated on [JournalEntry.IsActive]: the entry has
###   is_shown_when_inactive, so without the gate every display read would run
###   for countries that have none of these variables (gotcha #14).

types covert_operations_widget_types
{
	### ---- COMMAND CENTRE BUILDING BLOCKS -------------------------------

	### A section heading inside the command centre.
	type covert_cc_header = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_medium
		margin_top = 4
		block "header_text" {}
	}

	### One line of body text. `line_extra` exists so an instance can add a
	### `visible` or a `tooltip` without needing a second type.
	type covert_cc_line = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_small
		block "line_text" {}
		block "line_extra" {}
	}

	### The funding stepper: label, minus, current level, plus. Its datacontext
	### is covert_funding_sgui, set on the container, so both buttons address
	### their action by op code alone.
	type covert_cc_funding_stepper = flowcontainer {
		direction = horizontal
		spacing = 3
		datacontext = "[GetScriptedGui('covert_funding_sgui')]"

		textbox = {
			text = "je_iw_funding_stepper_label"
			size = { 250 24 }
			align = left|nobaseline
			using = fontsize_small
			parentanchor = vcenter
			elide = right
		}

		button_icon_minus_action = {
			size = { 24 24 }
			parentanchor = vcenter
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)0' ) ).End )]"
			tooltip = "je_iw_funding_step_down_tooltip"
		}

		textbox = {
			text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('covert_funding_level_display')|0]"
			size = { 140 24 }
			align = center|nobaseline
			using = fontsize_small
			parentanchor = vcenter
			elide = right
		}

		button_icon_plus_action = {
			size = { 24 24 }
			parentanchor = vcenter
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
			tooltip = "je_iw_funding_step_up_tooltip"
		}
	}

	### ---- OPERATION ROW BUILDING BLOCKS --------------------------------

	type widget_je_covert_operation_text = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = fontsize_large
	}

	### "Stand down" for one row. One instance per operation type, of which exactly one is
	### visible — `sd_visible` gates it on the row's operation tag.
	###
	### `sd_context` is the only other per-instance part: it points the button at
	### that type's covert_stand_down_<type>_sgui. Everything else is shared,
	### because the target travels as a saved scope built from the row's own
	### container, so the markup is identical for every type.
	###
	### The target country is reached through the stored capital state, the same
	### chain the row's title line uses (gotcha #11). If that chain or the saved
	### scope ever fails, covert_possible_stand_down does not hold and the button
	### is simply disabled — it can never end the wrong operation.
	type covert_op_stand_down_button = button {
		using = default_button_action
		size = { 150 24 }
		margin_left = 12
		margin_top = 2

		block "sd_context" {}
		block "sd_visible" {}

		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'iw_tgt', ScriptContainer.MakeScope.Var('iw_target_capital').GetState.GetCountry.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'iw_tgt', ScriptContainer.MakeScope.Var('iw_target_capital').GetState.GetCountry.MakeScope ).End )]"
		tooltip = "je_iw_stand_down_tooltip"

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 140
			elide = right
			using = fontsize_small
			text = "je_iw_stand_down_button"
		}
	}

	### The priority stepper for one operation row: label, minus, level, plus.
	### Up and down are separate scripted GUIs, each named by its button's own
	### datacontext, so the row's container travels alone in a single AddScope
	### (the stand-down shape). Hidden until every container carries
	### iw_priority, so a pre-slice-3 save never reads a missing variable.
	type covert_op_priority_stepper = flowcontainer {
		direction = horizontal
		spacing = 3
		margin_left = 12
		### Hidden on a cultivate-assets row: its priority is fixed at 1
		### (covert_possible_priority_up), and the row says so instead.
		visible = "[And( GetScriptedGui('covert_ops_priority_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), Not( ScriptContainer.HasTag('iw_op_cultivate_assets') ) )]"

		textbox = {
			text = "je_iw_priority_stepper_label"
			size = { 120 24 }
			align = left|nobaseline
			using = fontsize_small
			parentanchor = vcenter
			elide = right
		}

		button_icon_minus_action = {
			size = { 24 24 }
			parentanchor = vcenter
			datacontext = "[GetScriptedGui('covert_priority_down_sgui')]"
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'iw_op', ScriptContainer.MakeScope ).End )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'iw_op', ScriptContainer.MakeScope ).End )]"
			tooltip = "je_iw_priority_step_down_tooltip"
		}

		textbox = {
			text = "[ScriptContainer.GetVariableValue('iw_priority')|0]"
			size = { 40 24 }
			align = center|nobaseline
			using = fontsize_small
			parentanchor = vcenter
		}

		button_icon_plus_action = {
			size = { 24 24 }
			parentanchor = vcenter
			datacontext = "[GetScriptedGui('covert_priority_up_sgui')]"
			enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'iw_op', ScriptContainer.MakeScope ).End )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).AddScope( 'iw_op', ScriptContainer.MakeScope ).End )]"
			tooltip = "je_iw_priority_step_up_tooltip"
		}
	}

	### The phase, dormancy and detection lines, indented under the title.
	type widget_je_covert_operation_detail = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 460 -1 }
		maximumsize = { 460 -1 }
		margin_left = 12
		align = left|nobaseline
		using = fontsize_small
	}

	type widget_je_covert_operation_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 8 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}

		# ---- Operation type and target (exactly one tag matches) ----
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_election_interference')]"
			text = "je_iw_op_row_election_interference"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_financial_subversion')]"
			text = "je_iw_op_row_financial_subversion"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_infrastructure_sabotage')]"
			text = "je_iw_op_row_infrastructure_sabotage"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_comms_disruption')]"
			text = "je_iw_op_row_comms_disruption"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_industrial_espionage')]"
			text = "je_iw_op_row_industrial_espionage"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_military_espionage')]"
			text = "je_iw_op_row_military_espionage"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_influence_campaign')]"
			text = "je_iw_op_row_influence_campaign"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_ideological_subversion')]"
			text = "je_iw_op_row_ideological_subversion"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_destabilization')]"
			text = "je_iw_op_row_destabilization"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_regime_change')]"
			text = "je_iw_op_row_regime_change"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_nuclear_sabotage')]"
			text = "je_iw_op_row_nuclear_sabotage"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_space_espionage')]"
			text = "je_iw_op_row_space_espionage"
		}
		widget_je_covert_operation_text = {
			visible = "[ScriptContainer.HasTag('iw_op_cultivate_assets')]"
			text = "je_iw_op_row_cultivate_assets"
		}

		# ---- Phase, and how long until the next one ----
		# iw_phase is written by covert_op_refresh_phase, so the 6 / 12 month
		# thresholds stay in script. Hidden entirely until every container in
		# iw_ops carries it, which covers containers restored from a save made
		# before this widget shipped — they get it at the first monthly pulse.
		widget_je_covert_operation_detail = {
			visible = "[And3( GetScriptedGui('covert_ops_phase_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_phase'), '(CFixedPoint)1'), Not( ScriptContainer.HasTag('iw_op_cultivate_assets') ) )]"
			text = "je_iw_op_row_phase_prep"
		}
		widget_je_covert_operation_detail = {
			visible = "[And3( GetScriptedGui('covert_ops_phase_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_phase'), '(CFixedPoint)2'), Not( ScriptContainer.HasTag('iw_op_cultivate_assets') ) )]"
			text = "je_iw_op_row_phase_est"
		}
		widget_je_covert_operation_detail = {
			visible = "[And3( GetScriptedGui('covert_ops_phase_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_phase'), '(CFixedPoint)3'), Not( ScriptContainer.HasTag('iw_op_cultivate_assets') ) )]"
			text = "je_iw_op_row_phase_full"
		}

		# ---- Cultivate assets (slice 6): no phase effect and no priority to
		#      show; one line saying what it does instead ----
		widget_je_covert_operation_detail = {
			visible = "[ScriptContainer.HasTag('iw_op_cultivate_assets')]"
			text = "je_iw_op_row_cultivate_detail"
		}

		# ---- Priority: a stepper, then what the current level means ----
		covert_op_priority_stepper = { }
		widget_je_covert_operation_detail = {
			visible = "[And3( GetScriptedGui('covert_ops_priority_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_priority'), '(CFixedPoint)1'), Not( ScriptContainer.HasTag('iw_op_cultivate_assets') ) )]"
			text = "je_iw_op_row_priority_1"
		}
		widget_je_covert_operation_detail = {
			visible = "[And3( GetScriptedGui('covert_ops_priority_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_priority'), '(CFixedPoint)2'), Not( ScriptContainer.HasTag('iw_op_cultivate_assets') ) )]"
			text = "je_iw_op_row_priority_2"
		}
		widget_je_covert_operation_detail = {
			visible = "[And3( GetScriptedGui('covert_ops_priority_ready_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_priority'), '(CFixedPoint)3'), Not( ScriptContainer.HasTag('iw_op_cultivate_assets') ) )]"
			text = "je_iw_op_row_priority_3"
		}

		# ---- Is it doing anything at all? ----
		widget_je_covert_operation_detail = {
			visible = "[GetScriptedGui('covert_ops_dormant_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			text = "je_iw_op_row_dormant"
		}

		# ---- This operation's own monthly detection risk ----
		widget_je_covert_operation_detail = {
			text = "je_iw_op_row_detection"
		}


		# ---- Stand down ----
		# One instance per type; only the row's own type is ever visible.
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_election_interference_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_election_interference')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_financial_subversion_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_financial_subversion')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_infrastructure_sabotage_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_infrastructure_sabotage')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_comms_disruption_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_comms_disruption')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_industrial_espionage_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_industrial_espionage')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_military_espionage_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_military_espionage')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_influence_campaign_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_influence_campaign')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_ideological_subversion_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_ideological_subversion')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_destabilization_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_destabilization')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_regime_change_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_regime_change')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_nuclear_sabotage_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_nuclear_sabotage')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_space_espionage_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_space_espionage')]"
			}
		}
		covert_op_stand_down_button = {
			blockoverride "sd_context" {
				datacontext = "[GetScriptedGui('covert_stand_down_cultivate_assets_sgui')]"
			}
			blockoverride "sd_visible" {
				visible = "[ScriptContainer.HasTag('iw_op_cultivate_assets')]"
			}
		}
	}

	### ---- NETWORK ROW (slice 4) ---------------------------------------

	### One row per network in the operator's iw_nets. All numbers are
	### variables the monthly tick (covert_nets_sync) writes on the container;
	### the trend line is chosen by the stored code, never by comparing
	### strength against a literal.
	type widget_je_covert_network_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 6 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}

		widget_je_covert_operation_text = {
			text = "je_iw_net_row_title"
		}
		widget_je_covert_operation_detail = {
			text = "je_iw_net_row_strength"
		}
		widget_je_covert_operation_detail = {
			visible = "[EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_trend'), '(CFixedPoint)1')]"
			text = "je_iw_net_row_trend_growing"
		}
		widget_je_covert_operation_detail = {
			visible = "[EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_trend'), '(CFixedPoint)2')]"
			text = "je_iw_net_row_trend_decaying"
		}
		widget_je_covert_operation_detail = {
			visible = "[EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_trend'), '(CFixedPoint)0')]"
			text = "je_iw_net_row_trend_holding"
		}
		widget_je_covert_operation_detail = {
			text = "je_iw_net_row_benefit"
		}
	}
}


### WIDGETS

### The command centre. Gated on IsActive: the journal entry is shown when
### inactive, and none of these variables exist for a country whose entry never
### activated (gotcha #14).
flowcontainer = {
	name = "widget_je_covert_command_centre"
	direction = vertical
	parentanchor = hcenter
	spacing = 2
	visible = "[JournalEntry.IsActive]"

	### ---- INTELLIGENCE CAPACITY ----
	covert_cc_header = {
		blockoverride "header_text" { text = "je_iw_capacity_header" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_capacity_total" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_capacity_modifiers" }
		blockoverride "line_extra" { tooltip = "je_iw_capacity_modifiers_tooltip" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_capacity_components" }
	}

	### ---- OPERATION SLOTS ----
	covert_cc_header = {
		blockoverride "header_text" { text = "je_iw_slots_header" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_slots_detail" }
		blockoverride "line_extra" { tooltip = "je_iw_slots_detail_tooltip" }
	}

	### ---- FUNDING ----
	covert_cc_header = {
		blockoverride "header_text" { text = "je_iw_funding_header" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_funding_state" }
	}
	covert_cc_funding_stepper = { }
	### The six-level ladder. One ExecuteTooltip call over constants and one
	### country variable — no iteration — so it is cheap enough to leave open.
	covert_cc_line = {
		blockoverride "line_text" {
			text = "[GetScriptedGui('covert_funding_ladder_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		}
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_funding_cost" }
	}
	### Funding 0 stands everything down. Said once, loudly, here.
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_funding_dormant_banner" }
		blockoverride "line_extra" {
			visible = "[GetScriptedGui('covert_ops_dormant_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		}
	}

	### ---- TRADECRAFT (slice 5) ----
	### Score, tier name (custom loc, branching on the tier triggers) and why it
	### last moved; the tooltip carries the rules, the capacity breakdown and
	### the unlock ladder.
	covert_cc_header = {
		blockoverride "header_text" { text = "je_iw_tradecraft_header" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_tradecraft_line" }
		blockoverride "line_extra" { tooltip = "je_iw_tradecraft_tooltip" }
	}

	### ---- DETECTION FACTORS ----
	covert_cc_header = {
		blockoverride "header_text" { text = "je_iw_detection_header" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_detection_factors" }
		blockoverride "line_extra" { tooltip = "je_iw_detection_factors_tooltip" }
	}

	### ---- COVERT DEFENCE ----
	covert_cc_header = {
		blockoverride "header_text" { text = "je_iw_defense_header" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_defense_standing" }
	}
	covert_cc_line = {
		blockoverride "line_text" { text = "je_iw_defense_axes" }
		blockoverride "line_extra" { tooltip = "je_iw_defense_axes_tooltip" }
	}
	### The one honest word on hostile operations: what our own counterintelligence
	### actually caught, named in script so an annexed attacker degrades to an
	### anonymous line. Nothing here aggregates the undetected covert_* effect
	### modifiers a target may be carrying.
	covert_cc_line = {
		blockoverride "line_text" {
			text = "[GetScriptedGui('covert_last_exposed_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		}
		blockoverride "line_extra" {
			visible = "[GetScriptedGui('covert_last_exposed_known_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
		}
	}
}

### One row per running operation.
flowcontainer = {
	name = "widget_je_covert_operations"
	direction = vertical
	parentanchor = hcenter
	spacing = 4
	visible = "[JournalEntry.IsActive]"

	datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('iw_ops')]"

	item = {
		widget_je_covert_operation_row = {
			datacontext = "[Scope.GetScriptContainer]"
		}
	}
}

### One row per network (slice 4). Mounted on custom_widget_container_3,
### below the journal entry's buttons. The header only shows when there is
### at least one network, so a country that has never run an operation sees
### nothing here.
flowcontainer = {
	name = "widget_je_covert_networks"
	direction = vertical
	parentanchor = hcenter
	spacing = 4
	visible = "[JournalEntry.IsActive]"

	covert_cc_header = {
		blockoverride "header_text" {
			text = "je_iw_net_header"
			tooltip = "je_iw_net_header_tooltip"
			visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('iw_nets') ) )]"
		}
	}

	flowcontainer = {
		direction = vertical
		parentanchor = hcenter
		spacing = 4
		datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('iw_nets')]"

		item = {
			widget_je_covert_network_row = {
				datacontext = "[Scope.GetScriptContainer]"
			}
		}
	}
}
