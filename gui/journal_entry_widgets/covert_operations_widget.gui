	### ---- NETWORK ROW (slice 4) ---------------------------------------

	### One row per network in the operator's iw_nets. All numbers are
	### variables the monthly tick (covert_nets_sync) writes on the container;
	### the trend arrow is chosen by the stored code, never by comparing
	### strength against a literal, and the bar reads strength through a
	### container-scoped display value.
	type widget_je_covert_network_row = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		spacing = 2
		margin = { 20 6 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}

		widget_je_covert_operation_text = {
			text = "je_iw_net_row_title"
		}

		# ---- Strength: where it is heading, then the bar ----
		# Play-test round 1: the bar's marker read as an unexplained target.
		# The headline above the bar now names it: "45 → 50: their service
		# revealed", then "→ 75: their operations revealed", then "full
		# report", with the marker hidden, as the Tradecraft bar says where it
		# is heading (style rule 5). Which headline shows is chosen by the
		# stored report tier, like the report lines below, so no strength is
		# compared here. The hover (headline and bar) says what each part of
		# the report reveals and why the marker sits there.
		widget_je_covert_operation_detail = {
			visible = "[Not( ScriptContainer.HasVariable('iw_net_intel_tier') )]"
			text = "je_iw_net_row_strength"
			tooltip = "je_iw_net_row_strength_tt"
		}
		widget_je_covert_operation_detail = {
			visible = "[And( ScriptContainer.HasVariable('iw_net_intel_tier'), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)0') )]"
			text = "je_iw_net_row_strength_to_service"
			tooltip = "je_iw_net_row_strength_tt"
		}
		widget_je_covert_operation_detail = {
			visible = "[And( ScriptContainer.HasVariable('iw_net_intel_tier'), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)1') )]"
			text = "je_iw_net_row_strength_to_ops"
			tooltip = "je_iw_net_row_strength_tt"
		}
		widget_je_covert_operation_detail = {
			visible = "[And( ScriptContainer.HasVariable('iw_net_intel_tier'), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)2') )]"
			text = "je_iw_net_row_strength_full"
			tooltip = "je_iw_net_row_strength_tt"
		}
		# The bar, full width under its headline, with the marker where the
		# next part of the report starts, and which way strength is moving.
		flowcontainer = {
			direction = horizontal
			spacing = 8
			margin_left = 12

			default_progressbar_horizontal = {
				size = { 400 14 }
				parentanchor = vcenter
				tooltip = "je_iw_net_row_strength_tt"
				blockoverride "values" {
					value = "[FixedPointToFloat( ScriptContainer.MakeScope.ScriptValue('covert_disp_net_strength_frac') )]"
					min = 0
					max = 1
				}
				blockoverride "on_top_of_the_progressbar" {
					# Where the next part of the report starts: the service's
					# figures, then its operations against us. None once the
					# network reports everything, or before its first report.
					progressbar = {
						visible = "[And( ScriptContainer.HasVariable('iw_net_intel_tier'), NotEqualTo_CFixedPoint( ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)2' ) )]"
						noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
						progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
						size = { 100% 100% }
						skip_initial_animation = yes
						direction = horizontal
						value = "[FixedPointToFloat( ScriptContainer.MakeScope.ScriptValue('covert_disp_net_next_intel_frac') )]"
						min = 0
						max = 1
						marker = {
							icon = {
								size = { 36 20 }
								parentanchor = vcenter
								widgetanchor = center
								texture = "gfx/interface/progressbar/progressbar_marker.dds"
							}
						}
					}
				}
			}
			# Growing / decaying / holding at full strength, from the stored
			# iw_net_trend code; the sentence each replaced is its tooltip.
			widget = {
				size = { 24 24 }
				parentanchor = vcenter

				icon = {
					size = { 24 24 }
					visible = "[EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_trend'), '(CFixedPoint)1')]"
					texture = "gfx/interface/icons/generic_icons/trend_up.dds"
					tooltip = "je_iw_net_row_trend_growing"
				}
				icon = {
					size = { 24 24 }
					visible = "[EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_trend'), '(CFixedPoint)2')]"
					texture = "gfx/interface/icons/generic_icons/trend_down.dds"
					tooltip = "je_iw_net_row_trend_decaying"
				}
				icon = {
					size = { 24 24 }
					visible = "[EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_trend'), '(CFixedPoint)0')]"
					texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
					tooltip = "je_iw_net_row_trend_holding"
				}
			}
		}
		widget_je_covert_operation_detail = {
			text = "je_iw_net_row_ops"
		}
		widget_je_covert_operation_detail = {
			text = "je_iw_net_row_benefit"
		}

		# ---- What the network reports on its target (slice 7) ----
		# Chosen by the stored iw_net_intel_tier code (0 / 1 / 2), which
		# covert_net_clamp restates from strength after every write; the 50 /
		# 75 thresholds live only in covert_net_intel_tier_value. Every line
		# waits for the code to exist, so a network restored from a save made
		# before this slice shows no report until its first monthly pass.
		widget_je_covert_operation_detail = {
			visible = "[And( ScriptContainer.HasVariable('iw_net_intel_tier'), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)0') )]"
			text = "je_iw_net_row_intel_none"
		}
		widget_je_covert_operation_detail = {
			visible = "[And( ScriptContainer.HasVariable('iw_net_intel_tier'), Or( EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)1'), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)2') ) )]"
			text = "je_iw_net_row_intel_service"
			tooltip = "je_iw_net_row_intel_service_tooltip"
		}
		widget_je_covert_operation_detail = {
			visible = "[And( ScriptContainer.HasVariable('iw_net_intel_tier'), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)1') )]"
			text = "je_iw_net_row_intel_ops_locked"
		}
		widget_je_covert_operation_detail = {
			visible = "[And( ScriptContainer.HasVariable('iw_net_intel_tier'), EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('iw_net_intel_tier'), '(CFixedPoint)2') )]"
			text = "je_iw_net_row_intel_ops"
			tooltip = "je_iw_net_row_intel_ops_tooltip"
		}
	}

	### ======================================================================
	### OVERVIEW. Always shown, not collapsible (style rule 1).
	### ======================================================================
	type te_covert_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		visible = "[JournalEntry.IsActive]"

		covert_panel = {
			spacing = 10

			### Row 1: standing · funding · Tradecraft · a recent catch.
			### PLACEHOLDER icons, listed in docs/systems/covert_gui_icons.md.
			flowcontainer = {
				direction = horizontal
				spacing = 6
				ignoreinvisible = yes
				parentanchor = hcenter

				# Intelligence standing: our capacity against the world's best,
				# the verdict the journal entry's status text used to print as
				# its tooltip.
				covert_ov_icon_label = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_standing_code'), '(CFixedPoint)4' )]"
					tooltip = "je_iw_status_fortress"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_standing_4"
					}
				}
				covert_ov_icon_label = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_standing_code'), '(CFixedPoint)3' )]"
					tooltip = "je_iw_status_hardened"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_standing_3"
					}
				}
				covert_ov_icon_label = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_standing_code'), '(CFixedPoint)2' )]"
					tooltip = "je_iw_status_defended"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/undecided_icon.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_standing_2"
					}
				}
				covert_ov_icon_label = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_standing_code'), '(CFixedPoint)1' )]"
					tooltip = "je_iw_status_exposed"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_standing_1"
					}
				}
				covert_ov_icon_label = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_standing_code'), '(CFixedPoint)0' )]"
					tooltip = "je_iw_status_vulnerable"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/red_cross.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_standing_0"
					}
				}

				# Funding: the level's name; a warning while it is zero, when
				# nothing runs.
				covert_ov_icon_label = {
					visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_funding_level_display'), '(CFixedPoint)0' )]"
					tooltip = "je_iw_ov_funding_tt"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/warning.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_funding_label"
					}
				}
				covert_ov_icon_label = {
					visible = "[Not( EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_funding_level_display'), '(CFixedPoint)0' ) )]"
					tooltip = "je_iw_ov_funding_tt"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/gdp.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_funding_label"
					}
				}

				# Tradecraft: the tier's name.
				covert_ov_icon_label = {
					tooltip = "je_iw_ov_tc_tt"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/formation_order_icons/upgrade.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_tc_label"
					}
				}

				# A foreign operation our counterintelligence caught in the last
				# ten years: who and when, on hover (the Counterintelligence
				# section's Last Caught line).
				covert_ov_icon_label = {
					visible = "[GetScriptedGui('covert_last_exposed_known_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					tooltip = "[GetScriptedGui('covert_last_exposed_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/military_icons/navy_icons/detection_navy.dds"
					}
					blockoverride "label" {
						text = "je_iw_ov_caught_label"
					}
				}
			}

			### Row 2: operation slots, lit while in use, dimmed while free; the
			### label centred over them, the breakdown on hover.
			flowcontainer = {
				direction = vertical
				spacing = 2
				minimumsize = { 480 -1 }
				tooltip = "je_iw_slots_detail_tooltip"

				textbox = {
					autoresize = yes
					parentanchor = hcenter
					align = hcenter|nobaseline
					using = fontsize_medium
					text = "je_iw_slots_detail"
				}
				flowcontainer = {
					direction = horizontal
					spacing = 2
					ignoreinvisible = yes
					parentanchor = hcenter

					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)1' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)1' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)1' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)2' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)2' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)2' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)3' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)3' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)3' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)4' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)4' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)4' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)5' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)5' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)5' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)6' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)6' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)6' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)7' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)7' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)7' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)8' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)8' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)8' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)9' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)9' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)9' ) )]"
						}
					}
					covert_ov_slot = {
						visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_slots_shown'), '(CFixedPoint)10' )]"
						blockoverride "lit" {
							visible = "[GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)10' )]"
						}
						blockoverride "unlit" {
							visible = "[Not( GreaterThanOrEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_active_display'), '(CFixedPoint)10' ) )]"
						}
					}
				}
			}

			### Rows 3 and 4: capacity and Tradecraft as bars. Fixed-width cells
			### in the same order, so the two bars line up.
			flowcontainer = {
				direction = vertical
				spacing = 6
				parentanchor = hcenter

				# Capacity against the world's best; its make-up on hover.
				flowcontainer = {
					direction = horizontal
					spacing = 8
					tooltip = "je_iw_ov_capacity_tt"

					textbox = {
						minimumsize = { 100 -1 }
						maximumsize = { 100 -1 }
						autoresize = yes
						parentanchor = vcenter
						align = left|nobaseline
						using = fontsize_medium
						text = "je_iw_capacity_header"
					}
					default_progressbar_horizontal = {
						size = { 200 18 }
						parentanchor = vcenter
						blockoverride "values" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_capacity_frac') )]"
							min = 0
							max = 1
						}
					}
					textbox = {
						minimumsize = { 120 -1 }
						maximumsize = { 120 -1 }
						autoresize = yes
						parentanchor = vcenter
						align = left|nobaseline
						using = fontsize_medium
						text = "je_iw_capacity_total"
					}
					# The trend column of the Tradecraft row, kept empty so the
					# bars line up.
					widget = {
						size = { 24 24 }
					}
				}

				# Tradecraft, with a marker at the next tier's floor, the score
				# and where it is heading, and which way it last moved (why, on
				# the arrow). The rules on hover.
				flowcontainer = {
					direction = horizontal
					spacing = 8
					tooltip = "je_iw_tradecraft_tooltip"

					textbox = {
						minimumsize = { 100 -1 }
						maximumsize = { 100 -1 }
						autoresize = yes
						parentanchor = vcenter
						align = left|nobaseline
						using = fontsize_medium
						text = "je_iw_tradecraft_header"
					}
					default_progressbar_horizontal = {
						size = { 200 18 }
						parentanchor = vcenter
						blockoverride "values" {
							value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_tc_frac') )]"
							min = 0
							max = 1
						}
						blockoverride "on_top_of_the_progressbar" {
							# The next tier's floor; none once Veteran.
							progressbar = {
								visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_tradecraft_tier'), '(CFixedPoint)4' )]"
								noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								progresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
								size = { 100% 100% }
								skip_initial_animation = yes
								direction = horizontal
								value = "[FixedPointToFloat( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_tc_next_frac') )]"
								min = 0
								max = 1
								marker = {
									icon = {
										size = { 36 20 }
										parentanchor = vcenter
										widgetanchor = center
										texture = "gfx/interface/progressbar/progressbar_marker.dds"
									}
								}
							}
						}
					}
					textbox = {
						minimumsize = { 120 -1 }
						maximumsize = { 120 -1 }
						autoresize = yes
						parentanchor = vcenter
						align = left|nobaseline
						using = fontsize_medium
						text = "je_iw_tradecraft_line"
					}
					widget = {
						size = { 24 24 }
						parentanchor = vcenter
						tooltip = "je_iw_ov_tc_trend_tt"

						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_tc_trend'), '(CFixedPoint)1' )]"
							texture = "gfx/interface/icons/generic_icons/trend_up.dds"
						}
						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_tc_trend'), '(CFixedPoint)-1' )]"
							texture = "gfx/interface/icons/generic_icons/trend_down.dds"
						}
						icon = {
							size = { 24 24 }
							visible = "[EqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_disp_tc_trend'), '(CFixedPoint)0' )]"
							texture = "gfx/interface/icons/generic_icons/trend_nochange.dds"
						}
					}
				}
			}
		}
	}

	### ======================================================================
	### SECTIONS. Each is composed, in order, by te_covert_status_sections or
	### te_covert_reference_sections below.
	### ======================================================================

	### Operations: whether funding has stood them down or none is running,
	### said once, then one row per running operation.
	type te_covert_sec_operations = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		covert_section_header = {
			blockoverride "left_text" {
				text = "je_iw_sec_ops_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('covert_ops_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('covert_ops_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('covert_ops_closed'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 4
			visible = "[Not(GetVariableSystem.Exists('covert_ops_closed'))]"

			# True of every row, so said once above them (style rule 6), and
			# the empty state. The card shows only when one of them applies.
			covert_panel = {
				visible = "[Or( GetScriptedGui('covert_ops_dormant_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End ), IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('iw_ops') ) )]"

				covert_text = {
					visible = "[GetScriptedGui('covert_ops_dormant_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
					text = "je_iw_funding_dormant_banner"
				}
				covert_text = {
					visible = "[IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('iw_ops') )]"
					default_format = "#tooltippable"
					text = "je_iw_no_operations"
					tooltip = "je_iw_no_operations_tt"
				}
			}

			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				spacing = 4
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('iw_ops')]"

				item = {
					widget_je_covert_operation_row = {
						datacontext = "[Scope.GetScriptContainer]"
					}
				}
			}
		}
	}

	### Agent Networks (slice 4): one row per network. The whole section is
	### shown only once there is a network, so a country that has never run an
	### operation sees nothing here.
	type te_covert_sec_networks = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[Not( IsDataModelEmpty( JournalEntry.GetCountry.MakeScope.GetList('iw_nets') ) )]"

		covert_section_header = {
			blockoverride "left_text" {
				text = "je_iw_net_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('covert_nets_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('covert_nets_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('covert_nets_closed'))]"
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = hcenter
			spacing = 4
			visible = "[Not(GetVariableSystem.Exists('covert_nets_closed'))]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('iw_nets')]"

			item = {
				widget_je_covert_network_row = {
					datacontext = "[Scope.GetScriptContainer]"
				}
			}
		}
	}

	### Funding: what the level is doing, the stepper, what it costs, and the
	### ladder with the level in force marked.
	type te_covert_sec_funding = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		covert_section_header = {
			blockoverride "left_text" {
				text = "je_iw_funding_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('covert_funding_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('covert_funding_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('covert_funding_closed'))]"
			}
		}

		covert_panel = {
			visible = "[Not(GetVariableSystem.Exists('covert_funding_closed'))]"

			covert_text = {
				text = "je_iw_funding_state"
			}
			covert_cc_funding_stepper = { }
			covert_value_row = {
				tooltip = "je_iw_funding_cost_tt"
				blockoverride "row_label" {
					default_format = "#tooltippable"
					text = "je_iw_funding_cost_now_label"
				}
				blockoverride "row_value" {
					text = "je_iw_funding_cost_now"
				}
			}
			# Nothing above the top level.
			covert_value_row = {
				visible = "[NotEqualTo_CFixedPoint( JournalEntry.GetCountry.MakeScope.ScriptValue('covert_funding_level_display'), JournalEntry.GetCountry.MakeScope.ScriptValue('iw_funding_level_max') )]"
				blockoverride "row_label" {
					text = "je_iw_funding_cost_next_label"
				}
				blockoverride "row_value" {
					text = "je_iw_funding_cost_next"
				}
			}

			### The six-level ladder. One ExecuteTooltip call over constants and one
			### country variable — no iteration — so it is cheap enough to leave open.
			covert_subheader = {
				blockoverride "subheader_text" {
					text = "je_iw_funding_sub_levels"
				}
			}
			covert_text = {
				text = "[GetScriptedGui('covert_funding_ladder_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			}
		}
	}

	### Detection Risk: the factors every operation's risk shares. Each
	### operation's own risk is on its row.
	type te_covert_sec_detection = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		covert_section_header = {
			blockoverride "left_text" {
				text = "je_iw_detection_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('covert_detection_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('covert_detection_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('covert_detection_closed'))]"
			}
		}

		covert_panel = {
			visible = "[Not(GetVariableSystem.Exists('covert_detection_closed'))]"

			covert_value_row = {
				blockoverride "row_label" {
					text = "je_iw_detection_base_label"
				}
				blockoverride "row_value" {
					text = "je_iw_detection_base"
				}
			}
			covert_value_row = {
				blockoverride "row_label" {
					text = "je_iw_detection_funding_label"
				}
				blockoverride "row_value" {
					text = "je_iw_detection_funding"
				}
			}
			covert_value_row = {
				tooltip = "je_iw_detection_factors_tooltip"
				blockoverride "row_label" {
					text = "je_iw_detection_efficiency_label"
				}
				blockoverride "row_value" {
					text = "je_iw_detection_efficiency"
				}
			}
		}
	}

	### Counterintelligence: what defends us, and the last foreign operation
	### our counterintelligence caught.
	type te_covert_sec_counterintel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		covert_section_header = {
			blockoverride "left_text" {
				text = "je_iw_defense_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('covert_counterintel_closed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('covert_counterintel_closed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('covert_counterintel_closed'))]"
			}
		}

		covert_panel = {
			visible = "[Not(GetVariableSystem.Exists('covert_counterintel_closed'))]"

			covert_value_row = {
				tooltip = "je_iw_ci_slots_tt"
				blockoverride "row_label" {
					default_format = "#tooltippable"
					text = "je_iw_ci_slots_label"
				}
				blockoverride "row_value" {
					text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('covert_available_slots_display')|0]"
				}
			}
			covert_value_row = {
				tooltip = "je_iw_ci_funding_tt"
				blockoverride "row_label" {
					default_format = "#tooltippable"
					text = "je_iw_ci_funding_label"
				}
				blockoverride "row_value" {
					text = "je_iw_ci_funding"
				}
			}
			covert_value_row = {
				tooltip = "je_iw_ci_economic_tt"
				blockoverride "row_label" {
					default_format = "#tooltippable"
					text = "je_iw_ci_economic_label"
				}
				blockoverride "row_value" {
					text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('covert_defense_economic_display')|0]"
				}
			}
			covert_value_row = {
				tooltip = "je_iw_ci_military_tt"
				blockoverride "row_label" {
					default_format = "#tooltippable"
					text = "je_iw_ci_military_label"
				}
				blockoverride "row_value" {
					text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('covert_defense_military_display')|0]"
				}
			}
			covert_value_row = {
				tooltip = "je_iw_ci_ideological_tt"
				blockoverride "row_label" {
					default_format = "#tooltippable"
					text = "je_iw_ci_ideological_label"
				}
				blockoverride "row_value" {
					text = "[JournalEntry.GetCountry.MakeScope.ScriptValue('covert_defense_ideological_display')|0]"
				}
			}

			### The one honest word on hostile operations: what our own counterintelligence
			### actually caught, named in script so an annexed attacker degrades to an
			### anonymous line. Nothing here aggregates the undetected covert_* effect
			### modifiers a target may be carrying. The only other word on hostile
			### operations is a network row's tier-2 count (slice 7): what our agents
			### inside that country's service report, not what we caught at home.
			### Shown only while there is a catch from the last ten years.
			covert_subheader = {
				visible = "[GetScriptedGui('covert_last_exposed_known_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				blockoverride "subheader_text" {
					text = "je_iw_ci_sub_caught"
				}
			}
			covert_text = {
				visible = "[GetScriptedGui('covert_last_exposed_known_sgui').IsShown( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
				text = "[GetScriptedGui('covert_last_exposed_sgui').ExecuteTooltip( GuiScope.SetRoot( JournalEntry.GetCountry.MakeScope ).End )]"
			}
		}
	}

	### "How Covert Warfare Works": every explanation, gathered out of the live
	### sections into one section, collapsed by default, one heading per topic
	### (style rule 1; the UN's te_un_sec_how).
	type te_covert_sec_how = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		covert_section_header = {
			blockoverride "left_text" {
				text = "je_iw_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('covert_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('covert_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('covert_how_open')]"
			}
		}

		covert_panel = {
			visible = "[GetVariableSystem.Exists('covert_how_open')]"

			covert_subheader = {
				blockoverride "subheader_margin" {}
				blockoverride "subheader_text" {
					text = "je_iw_how_sub_ops"
				}
			}
			covert_note = {
				text = "je_iw_how_ops"
			}
			covert_subheader = {
				blockoverride "subheader_text" {
					text = "je_iw_how_sub_funding"
				}
			}
			covert_note = {
				text = "je_iw_how_funding"
			}
			covert_subheader = {
				blockoverride "subheader_text" {
					text = "je_iw_how_sub_detection"
				}
			}
			covert_note = {
				text = "je_iw_how_detection"
			}
			covert_subheader = {
				blockoverride "subheader_text" {
					text = "je_iw_how_sub_networks"
				}
			}
			covert_note = {
				text = "je_iw_net_header_tooltip"
			}
			covert_subheader = {
				blockoverride "subheader_text" {
					text = "je_iw_how_sub_tradecraft"
				}
			}
			covert_note = {
				text = "je_iw_how_tradecraft"
			}
			covert_subheader = {
				blockoverride "subheader_text" {
					text = "je_iw_how_sub_ci"
				}
			}
			covert_note = {
				text = "je_iw_how_ci"
			}
			covert_subheader = {
				blockoverride "subheader_text" {
					text = "je_iw_how_sub_standing"
				}
			}
			covert_note = {
				text = "je_iw_how_standing"
			}
		}
	}

	### ======================================================================
	### COMPOSERS. The one place that sets the sections' order.
	### ======================================================================

	### Everything a returning player checks, open by default.
	type te_covert_status_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_covert_sec_operations = {}
		te_covert_sec_networks = {}
		te_covert_sec_funding = {}
		te_covert_sec_detection = {}
		te_covert_sec_counterintel = {}
	}

	### How it all works, collapsed.
	type te_covert_reference_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4
		visible = "[JournalEntry.IsActive]"

		te_covert_sec_how = {}
	}
}

### ==========================================================================
### JOURNAL ENTRY ROOTS (je_covert_warfare.txt). Bare wrappers that repeat the
### composers' IsActive gate, so an inactive entry's containers collapse
### (gotcha #14).
### ==========================================================================
flowcontainer = {
	name = "widget_je_covert_overview"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_covert_overview_panel = {}
}

flowcontainer = {
	name = "widget_je_covert_status"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_covert_status_sections = {}
}

flowcontainer = {
	name = "widget_je_covert_reference"
	visible = "[JournalEntry.IsActive]"
	parentanchor = hcenter
	ignoreinvisible = yes

	te_covert_reference_sections = {}
}
