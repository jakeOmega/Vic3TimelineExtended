### AUTO-GENERATED by scripts/generators/gen_build_list_columns.py; do not edit manually.
### Vanilla's construction list cell and its two header rows (gui/map_list_panel.gui:
### productivity_or_other_information, construction_headers_condensed, construction_headers_full),
### redefined from this file so National Parks show pollution and Public Housing
### migration crowding where other buildings show productivity (gui_modding_guide.md
### gotcha #30: the 00_ file is read first and its definitions win). Copied from
### test_fixtures/vanilla_gui/map_list_panel.gui; only the `### MOD: Build list columns`
### blocks differ.

types te_build_list_columns {
	type productivity_or_other_information = container {
		block "productivity_info_datacontext" {}

		# Productivity
		textbox = {
			### MOD: Build list columns: productivity, but not for a building with a column below
			# vanilla: visible = "[And(Not(ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_government_administration').Self)), Not(ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_trade_center').Self)))]"
			visible = "[And(And(Not(ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_government_administration').Self)), Not(ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_trade_center').Self))), Not(Or(ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_national_park').Self), ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_public_housing').Self))))]"
			### END MOD ###
			raw_text = "#v @money![Building.GetBuildingType.GetExpansionProductivityImpact(Building.Self, Building.GetState)|1+]#!"
			tooltip = "[Building.GetBuildingType.GetExpansionProductivityImpactDesc(Building.Self, Building.GetState)]"

			elide = right
			fontsize_min = 12

			block "productivity_info_text_style" {}
		}

		# Tax Capacity (Government Administration)
		textbox = {
			visible = "[ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_government_administration').Self)]"
			raw_text = "[State.CalcTaxCapacityBalance|0+=]"
			tooltip = "STATE_TAX_CAPACITY_DESC"

			elide = right
			fontsize_min = 12

			block "productivity_info_text_style" {}
		}

		# Trade Capacity (Trade Center)
		textbox = {
			visible = "[ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_trade_center').Self)]"
			raw_text = "[State.GetTradeCapacityBalance|0+=]"
			tooltip = "STATE_TRADE_CAPACITY_USAGE_TOOLTIP"

			elide = right
			fontsize_min = 12

			block "productivity_info_text_style" {}
		}

		### MOD: Build list columns: a column of the mod's own for these buildings

		# building_national_park: the state region's pollution impact
		textbox = {
			visible = "[ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_national_park').Self)]"
			raw_text = "[State.GetStateRegion.GetPollutionImpact|%R1]"
			tooltip = "STATE_POLLUTION"

			elide = right
			fontsize_min = 12

			block "productivity_info_text_style" {}
		}

		# building_public_housing: the migration pull the state loses to crowding
		textbox = {
			visible = "[ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_public_housing').Self)]"
			raw_text = "[State.MakeScope.ScriptValue('migration_crowding_pull_pct')|%0-]"
			tooltip = "te_build_list_crowding_tt"

			elide = right
			fontsize_min = 12

			block "productivity_info_text_style" {}
		}
		### END MOD ###
	}

