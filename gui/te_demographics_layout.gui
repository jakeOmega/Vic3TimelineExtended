### Demographics — layout. The one place that sets the order of the Demographics sections, for all four hosts (issue
### #1029; Banking's banking_layout_widget.gui): the Population panel's Demographics tab (gui/pops_overview.gui instances
### te_demog_tab_sections), the Census Data window's Demographics tab (gui/pop_browser_panel.gui instances
### te_demog_browser_sections, the same sections for whichever country the window shows), the Timeline Extended
### window's Demographics tab (its generated mount instances te_demog_window_body, which holds
### te_demog_window_sections, or in full screen te_demog_browser_sections for the player's country) and the state
### panel's Demographics subtab (gui/states_panel.gui instances
### te_state_demog_content). The sections are types in
### gui/te_demographics_widgets.gui, and the country's read the Country in their context: the player's in the Population
### panel (its window's AccessPlayer), the window's in the Census Data window (PopBrowserPanel.GetCountry).
###
### The order: the people's health (the overview, Causes of Death, the pyramid), then the levers (Work and Retirement,
### Longevity, Family Policy), then the record (History), with the per-state detail last (Wealth, Where People Live,
### States). The explanations are on the Help page (te_demographics_help_popup, in gui/te_popups.gui), which a "?" at the
### top of every host opens: te_demog_window_body's header on the Population panel's tab and the window's, National
### Info's header for another country, and te_help_row on the state subtab, which has no header. The Census Data window
### (and the window's full screen) sets the tab's sections out in three columns the owner balanced (2026-11-03). The
### state subtab takes the same order, less the sections a state has no figures for (Family Policy, History, Where People
### Live, States), and with one of its own after Wealth: the state's Modifiers, the nine standing
### modifiers the census gives it, which its modifier rows leave out. test_demographics_layout.py holds the orders, the
### flags and the widths.
###
### Collapse flags say their default: *_closed sections are open until closed, *_open ones collapsed until opened. The
### state's flags are its own (te_demog_st_*), so collapsing a section on one host leaves the other alone; the tab and
### the Census Data window share theirs. No host has a journal entry, so there is no Open Journal Entry button (rule 9).

types te_demographics_layout
{
	### The tab: a fixed 520 width (rule 8). Until the country's first census (te_pops_demog_tab_unlock_sgui's
	### is_valid) one line says when it comes: the tab is greyed then, but a panel reopened on it still shows the line.
	type te_demog_tab_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 10
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }

		te_demog_panel = {
			visible = "[Not( GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) )]"

			te_demog_text = {
				text = "te_demog_pending"
			}
		}

		flowcontainer = {
			visible = "[GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 10

			te_demog_overview = {}
			te_demog_sec_causes = {}
			te_demog_sec_pyramid = {}
			te_demog_sec_work = {}
			### phase 3: shown once the country's late figures exist
			te_demog_sec_longevity = {}
			te_demog_sec_family = {}
			te_demog_sec_history = {}
			te_demog_sec_wealth = {}
			te_demog_sec_places = {}
			te_demog_sec_states = {}
		}
	}

	### The Census Data window, a fullscreen one: the tab's sections in three columns of a fixed 520 (rule 8), 30 apart,
	### on te_ui_columns_three (gui/te_widget_library.gui), as the owner balanced them (2026-11-03): the census with the
	### figures a country works with (Work and Retirement, Longevity, Wealth), then the pyramid and its record (History),
	### then where people die, the family laws and where they live, with the per-state detail last. Until the country's
	### first census the pending line alone, at the column's width. The Timeline Extended window's full-screen Demographics tab
	### places the same composer for the player's country (wide-mode PR D2), so nothing in it may read either window's own
	### panel: it reads the Country in its context.
	type te_demog_browser_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

		te_demog_panel = {
			visible = "[Not( GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) )]"

			te_demog_text = {
				text = "te_demog_pending"
			}
		}

		te_ui_columns_three = {
			visible = "[GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"

			blockoverride "column_1" {
				te_demog_overview = {}
				te_demog_sec_work = {}
				### phase 3: shown once the country's late figures exist
				te_demog_sec_longevity = {}
				### less the strata's incomes: vanilla's keys read the Population panel (PopsOverviewPanel), which this
				### window doesn't have, and logged nine lines a frame here (2026-10-31)
				te_demog_sec_wealth = {
					blockoverride "te_demog_wealth_strata_incomes" {}
				}
			}

			blockoverride "column_2" {
				te_demog_sec_pyramid = {}
				te_demog_sec_history = {}
			}

			blockoverride "column_3" {
				te_demog_sec_causes = {}
				te_demog_sec_family = {}
				te_demog_sec_places = {}
				te_demog_sec_states = {}
			}
		}
	}

	### The Timeline Extended window's Demographics tab (spec 2026-11-02-te-window-wide-mode § 6): the tab's sections, its
	### pending line and its fixed 520, less the strata incomes, as in the Census Data window.
	type te_demog_window_sections = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 10
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }

		te_demog_panel = {
			visible = "[Not( GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End ) )]"

			te_demog_text = {
				text = "te_demog_pending"
			}
		}

		flowcontainer = {
			visible = "[GetScriptedGui('te_pops_demog_tab_unlock_sgui').IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 10

			te_demog_overview = {}
			te_demog_sec_causes = {}
			te_demog_sec_pyramid = {}
			te_demog_sec_work = {}
			### phase 3: shown once the country's late figures exist
			te_demog_sec_longevity = {}
			te_demog_sec_family = {}
			te_demog_sec_history = {}
			### less the strata's incomes: vanilla's keys read the Population panel (PopsOverviewPanel), which this
			### window doesn't have (the Census Data window's override)
			te_demog_sec_wealth = {
				blockoverride "te_demog_wealth_strata_incomes" {}
			}
			te_demog_sec_places = {}
			te_demog_sec_states = {}
		}
	}

	### The tab body: te_system_tab_frame with the Population panel tab's gate. No entry: the Country the sections read is
	### the player's (the Population panel's window supplies AccessPlayer), and there is no Open Journal Entry. Its
	### header, as every other tab's in the window and the panels, carries the "?" to the Help page, hidden for an
	### observer. The window mounts it, and the Population panel's tab with te_demog_tab_sections in its layout block;
	### te_demog_tab_layout is what a wide mount overrides.
	type te_demog_window_body = te_system_tab_frame {
		blockoverride "tab_header" {
			default_header = {
				using = default_list_position
				blockoverride "text" {
					text = "te_window_tab_demographics"
				}
				### Show the census on the map (gui/te_map_widgets.gui; journal_map_modes.md).
				te_jmap_demog_map_button = {}
				te_help_button = {
					visible = "[Not( GetMetaPlayer.IsObserver )]"
					onclick = "[GetVariableSystem.Set('te_popup', 'help_demographics')]"
				}
			}
		}

		blockoverride "tab_gate" {
			visible = "[GetScriptedGui('te_pops_demog_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		blockoverride "tab_entry" {
			datacontext = "[GetPlayer]"
		}

		blockoverride "tab_content" {
			block "te_demog_tab_layout" {
				te_demog_window_sections = {}
			}
		}

		blockoverride "tab_open_journal" {}
	}

	### The subtab, at a fixed 520 (rule 8). A state with no census shows "Census pending" and the "?" to the Help page.
	type te_state_demog_content = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 10
		minimumsize = { 520 -1 }
		maximumsize = { 520 -1 }

		### The subtab has no header: the "?" to the Help page in a row at its top (te_help_row), outside the state's
		### census gate, so "Census pending" has it too.
		te_help_row = {
			blockoverride "help_onclick" {
				onclick = "[GetVariableSystem.Set('te_popup', 'help_demographics')]"
			}
		}

		te_demog_panel = {
			visible = "[Not( GetScriptedGui('te_demog_state_census_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End ) )]"

			te_demog_text = {
				text = "te_demog_st_pending"
			}
		}

		flowcontainer = {
			visible = "[GetScriptedGui('te_demog_state_census_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
			direction = vertical
			parentanchor = hcenter
			ignoreinvisible = yes
			spacing = 10

			te_state_demog_overview = {}
			te_state_demog_causes = {}
			te_state_demog_pyramid = {}
			te_state_demog_work = {}
			### phase 3: shown once the state has had a late step
			te_state_demog_longevity = {}
			te_state_demog_wealth = {}
			te_state_demog_modifiers = {}
		}
	}
}
