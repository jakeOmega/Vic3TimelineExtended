							te_seabed_claim_button = {
								visible = "[GetScriptedGui('te_seabed_claim_again_southern_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								blockoverride "claim_context" {
									datacontext = "[GetScriptedGui('te_seabed_claim_again_southern_sgui')]"
								}
								blockoverride "claim_text" {
									text = "te_seabed_claim_again_btn"
								}
							}
