					tooltip = "te_seabed_weight_tt_southern"
					text = "te_seabed_weight_pct_southern"
				}
				blockoverride "basin_next" {
					tooltip = "[SelectLocalization( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_southern'), '(CFixedPoint)0' ), 'te_seabed_next_tt_southern', 'te_seabed_col_next_tt' )]"
					text = "[SelectLocalization( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_southern'), '(CFixedPoint)-2' ), 'te_seabed_next_none', SelectLocalization( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_southern'), '(CFixedPoint)-1' ), 'te_seabed_next_full', 'te_seabed_next_southern' ) )]"
				}
			}
			flowcontainer = {
				using = te_own_country_only
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					margin_bottom = 4
					visible = "[GetVariableSystem.Exists('te_seabed_rivals_southern_open')]"

					te_seabed_rival_head = {}
					flowcontainer = {
						direction = vertical
						ignoreinvisible = yes
						spacing = 2
						datamodel = "[GetPlayer.MakeScope.GetList('te_seabed_rk_list_southern')]"

						item = {
							te_seabed_rival_row = {
								datacontext = "[Scope.GetState]"
								blockoverride "rival_mines" {
									raw_text = "[State.GetCountry.MakeScope.ScriptValue('te_seabed_held_disp_southern')|0]"
								}
								blockoverride "rival_claims" {
									raw_text = "[State.GetCountry.MakeScope.ScriptValue('te_seabed_unbuilt_disp_southern')|0]"
								}
								blockoverride "rival_weight" {
