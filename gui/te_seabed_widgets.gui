					tooltip = "te_seabed_weight_tt_arctic"
					text = "te_seabed_weight_pct_arctic"
				}
				blockoverride "basin_next" {
					tooltip = "[SelectLocalization( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_arctic'), '(CFixedPoint)0' ), 'te_seabed_next_tt_arctic', 'te_seabed_col_next_tt' )]"
					text = "[SelectLocalization( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_arctic'), '(CFixedPoint)-2' ), 'te_seabed_next_none', SelectLocalization( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_arctic'), '(CFixedPoint)-1' ), 'te_seabed_next_full', 'te_seabed_next_arctic' ) )]"
				}
