### Global Commons: the Seabed tab of the Timeline Extended window
### (te_seabed_tab_body, at the foot of this file, composes the three panels;
### the window mounts it from gui/te_systems_window_generated.gui). Layout A of the
### seabed claims spec (docs/superpowers/archive/specs/2026-10-17-seabed-claims-and-
### panel-design.md § 3): an overview of six boxes, two to a row; the three
### policy buttons; the Ocean Basins table, each basin opening onto its
### claimants. The explanations are on the Help page (gui/te_popups.gui), which
### the "?" in the tab's header opens. House style: docs/guides/gui_style_guide.md.
###
### DATA. No journal entry: every read is the shown country's, Country, which
### the mount supplies (the window's, the player; National Info's, any
### country; spec docs/superpowers/specs/2026-11-02-charts-help-national-info-
### design.md § 6.3), through Country.MakeScope: the guarded *_disp_* script
### values (te_global_commons_seabed_values.txt), which read 0 where a
### variable is missing, under the tab's gate (te_window_seabed_tab_sgui) on a
### parent in the window. A basin's rivals are a datamodel of the player's
### list te_seabed_rk_list_<b>, the other claimants' capitals, largest share
### first (te_seabed_rank_list; audit SEA-3): each item reaches its country
### through State.GetCountry (gotcha #15).
###
### ANOTHER COUNTRY (National Info). The player's own parts sit under
### te_own_country_only (gui/te_system_tab_widgets.gui): the policy buttons,
### each basin's claimants with Relinquish and Claim Again, and the chevron
### that opens them. The claimant list leaves out its viewer, whose own row is
### drawn apart, so read for another country it would show that country twice
### and leave the player out (spec § 6.7: a list relative to the viewer is
### hidden). The basin row already gives that country's Free, Pool and
### Weight, and the pool's hover its mines.
###
### WIDTHS. A 520 column, panels with 480 inside. Rows 17, headings 20, the
### overview 16 (te_seabed_fontsize_*, below; rule 3); test_seabed_layout.py
### holds every fixed cell to its longest text.

template te_seabed_fontsize_row {
	fontsize = 17
}

template te_seabed_fontsize_heading {
	fontsize = 20
}

template te_seabed_fontsize_overview {
	fontsize = 16
	using = tooltip_font
}

types te_seabed_widget_types
{
	type te_seabed_panel = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		parentanchor = hcenter
		margin = { 20 8 }
		minimumsize = { 520 -1 }

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.5
		}
	}

	### A heading inside a panel, with a faint rule under it.
	type te_seabed_subheader = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		margin_top = 6

		textbox = {
			autoresize = yes
			multiline = yes
			maximumsize = { 480 -1 }
			align = left|nobaseline
			using = te_seabed_fontsize_heading
			default_format = "#title"
			block "subheader_text" {}
		}
		divider_clean = {
			blockoverride "size" {
				size = { 480 2 }
			}
		}
	}

	### Explanatory text on the Help page.
	type te_seabed_note = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
		using = te_seabed_fontsize_row
		default_format = "#lore"
	}

	### ----------------------------------------------------------------------
	### The overview's box (rule 4; te_banking_ov_cell's shape): the icon in an
	### inset box of its own down the left, and beside it the caption, the
	### reading's word and a figure, in a 154 column at 16. Two to a row:
	### 238 + 4 + 238 = 480.
	### ----------------------------------------------------------------------
	type te_seabed_ov_cell = widget {
		size = { 238 70 }

		background = {
			using = entry_bg_simple
		}

		widget = {
			size = { 52 52 }
			position = { 6 0 }
			parentanchor = left|vcenter

			background = {
				using = dark_area
				alpha = 0.3
			}

			icon = {
				size = { 44 44 }
				parentanchor = center
				block "icon" {}
			}
		}
		textbox = {
			position = { 78 2 }
			autoresize = yes
			max_width = 154
			elide = right
			align = left|nobaseline
			using = te_seabed_fontsize_overview
			block "caption" {}
		}
		block "word" {}
		block "fig" {}
	}

	type te_seabed_ov_word = textbox {
		position = { 78 24 }
		autoresize = yes
		max_width = 154
		elide = right
		align = left|nobaseline
		using = te_seabed_fontsize_overview
	}

	type te_seabed_ov_fig = textbox {
		position = { 78 46 }
		autoresize = yes
		max_width = 154
		elide = right
		align = left|nobaseline
		using = te_seabed_fontsize_overview
	}

	### One policy button: greyed with its reasons, its effect on hover. The
	### label is the short name; the full one opens the effect on hover.
	### 3 x 156 + 2 x 6 = 480.
	type te_seabed_policy_button = button {
		using = default_button
		size = { 156 32 }
		block "policy_context" {}
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
		tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( Country.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( Country.MakeScope ).End ) ) )]"

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 150
			using = te_seabed_fontsize_row
			block "policy_text" {}
		}
	}

	### Relinquish / Claim Again, in our own row of a basin's claimants (the
	### player's own: under te_own_country_only with the claimants).
	type te_seabed_claim_button = button {
		using = default_button
		size = { 110 26 }
		parentanchor = vcenter
		block "claim_context" {}
		enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
		onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
		tooltip = "[Concatenate( ScriptedGui.IsValidTooltip( GuiScope.SetRoot( Country.MakeScope ).End ), Concatenate( Localize( 'te_tt_break' ), ScriptedGui.ExecuteTooltip( GuiScope.SetRoot( Country.MakeScope ).End ) ) )]"

		textbox = {
			parentanchor = center
			align = center|nobaseline
			autoresize = yes
			max_width = 106
			using = te_seabed_fontsize_row
			block "claim_text" {}
		}
	}

	### ----------------------------------------------------------------------
	### The Ocean Basins table: Basin (chevron 20 + 2 + name 82), Free, Pool
	### (the stacked bar), Weight and +1 licence. 104 + 64 + 144 + 72 + 96 = 480.
	### ----------------------------------------------------------------------
	type te_seabed_basin_head = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes

		textbox = {
			minimumsize = { 104 -1 }
			max_width = 104
			autoresize = yes
			align = left|nobaseline
			using = te_seabed_fontsize_row
			default_format = "#title"
			text = "te_seabed_col_basin"
		}
		textbox = {
			minimumsize = { 64 -1 }
			max_width = 64
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			tooltip = "te_seabed_col_free_tt"
			text = "te_seabed_col_free"
		}
		textbox = {
			minimumsize = { 144 -1 }
			max_width = 144
			autoresize = yes
			align = center|nobaseline
			using = te_seabed_fontsize_row
			tooltip = "te_seabed_col_pool_tt"
			text = "te_seabed_col_pool"
		}
		textbox = {
			minimumsize = { 72 -1 }
			max_width = 72
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			tooltip = "te_seabed_col_weight_tt"
			text = "te_seabed_col_weight"
		}
		textbox = {
			minimumsize = { 96 -1 }
			max_width = 96
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			tooltip = "te_seabed_col_next_tt"
			text = "te_seabed_col_next"
		}
	}

	### A basin's row. All five always show.
	type te_seabed_basin_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		margin_top = 2

		widget = {
			size = { 104 24 }

			button = {
				using = te_own_country_only
				size = { 20 24 }
				parentanchor = left|vcenter
				tooltip = "te_seabed_rivals_hint_tt"
				block "basin_toggle" {}
			}
			textbox = {
				position = { 22 0 }
				parentanchor = vcenter
				autoresize = yes
				max_width = 82
				align = left|nobaseline
				using = te_seabed_fontsize_row
				block "basin_name" {}
			}
		}
		textbox = {
			minimumsize = { 64 -1 }
			max_width = 64
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			block "basin_free" {}
		}
		widget = {
			size = { 144 24 }
			block "basin_pool" {}
		}
		textbox = {
			minimumsize = { 72 -1 }
			max_width = 72
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			block "basin_weight" {}
		}
		textbox = {
			minimumsize = { 96 -1 }
			max_width = 96
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			block "basin_next" {}
		}
	}

	### The pool bar's layers, largest fraction first, each drawn over the last
	### (Global Warming's temperature bar, PR #575): the background is rivals'
	### unused claims (up for grabs); then rivals' mines, our claims, our queued
	### mines (a lighter gold) and our built mines.
	type te_seabed_pool_bar = widget {
		size = { 136 14 }
		parentanchor = center
		block "bar_tooltip" {}

		default_progressbar_horizontal = {
			size = { 100% 100% }
			blockoverride "values" {
				value = 0
				min = 0
				max = 1
			}
		}
		widget = {
			size = { 100% 100% }
			alpha = 0.7
			bad_progressbar_horizontal = {
				size = { 100% 100% }
				blockoverride "background" {}
				blockoverride "frame" {}
				blockoverride "values" {
					block "bar_4" {}
					min = 0
					max = 1
				}
			}
		}
		widget = {
			size = { 100% 100% }
			alpha = 0.6
			green_progressbar_horizontal = {
				size = { 100% 100% }
				blockoverride "background" {}
				blockoverride "frame" {}
				blockoverride "values" {
					block "bar_3" {}
					min = 0
					max = 1
				}
			}
		}
		widget = {
			size = { 100% 100% }
			alpha = 0.45
			gold_progressbar_horizontal = {
				size = { 100% 100% }
				blockoverride "background" {}
				blockoverride "frame" {}
				blockoverride "values" {
					block "bar_2" {}
					min = 0
					max = 1
				}
			}
		}
		gold_progressbar_horizontal = {
			size = { 100% 100% }
			blockoverride "background" {}
			blockoverride "frame" {}
			blockoverride "values" {
				block "bar_1" {}
				min = 0
				max = 1
			}
		}
	}

	### The claimants under a basin, in fixed columns (audit SEA-3): the flag
	### (vanilla's tiny flag: the full name on hover, the country on click) and
	### the name, elided, then Mines, Claims and Weight, and in our own row the
	### basin's Relinquish or Claim Again. 8 + 28 + 4 + 136 + 4 + 56 + 4 + 60 + 4
	### + 64 + 110 = 478, in the 480 column; the heads span the same widths. Every
	### rival is a row, an item of the basin's list of capitals
	### (te_seabed_rk_list_<b>), its figures read through State.GetCountry.
	type te_seabed_rival_head = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		margin_left = 8

		textbox = {
			minimumsize = { 168 -1 }
			max_width = 168
			autoresize = yes
			align = left|nobaseline
			using = te_seabed_fontsize_row
			default_format = "#grey"
			text = "te_seabed_rival_col_name"
		}
		textbox = {
			minimumsize = { 60 -1 }
			max_width = 60
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			tooltip = "te_seabed_rival_col_mines_tt"
			text = "te_seabed_rival_col_mines"
		}
		textbox = {
			minimumsize = { 64 -1 }
			max_width = 64
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			tooltip = "te_seabed_rival_col_claims_tt"
			text = "te_seabed_rival_col_claims"
		}
		textbox = {
			minimumsize = { 68 -1 }
			max_width = 68
			autoresize = yes
			align = right|nobaseline
			using = te_seabed_fontsize_row
			tooltip = "te_seabed_rival_col_weight_tt"
			text = "te_seabed_rival_col_weight"
		}
	}

	### One claimant's columns: the instance passes the flag's country context
	### and the three figures (raw_text).
	type te_seabed_rival_cells = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4

		widget = {
			size = { 28 22 }
			tiny_flag = {
				parentanchor = center
				block "flag_context" {}
			}
		}
		textbox = {
			minimumsize = { 136 -1 }
			max_width = 136
			autoresize = yes
			elide = right
			parentanchor = vcenter
			align = left|nobaseline
			using = te_seabed_fontsize_row
			block "cell_name" {}
		}
		textbox = {
			minimumsize = { 56 -1 }
			max_width = 56
			autoresize = yes
			parentanchor = vcenter
			align = right|nobaseline
			using = te_seabed_fontsize_row
			default_format = "#v"
			block "cell_mines" {}
		}
		textbox = {
			minimumsize = { 60 -1 }
			max_width = 60
			autoresize = yes
			parentanchor = vcenter
			align = right|nobaseline
			using = te_seabed_fontsize_row
			default_format = "#v"
			block "cell_claims" {}
		}
		textbox = {
			minimumsize = { 64 -1 }
			max_width = 64
			autoresize = yes
			parentanchor = vcenter
			align = right|nobaseline
			using = te_seabed_fontsize_row
			default_format = "#v"
			block "cell_weight" {}
		}
	}

	### A rival's row: an item of the basin's claimant list
	### (te_seabed_rk_list_<b>, its capital the item's datacontext; audit
	### SEA-3), its columns read through State.GetCountry.
	type te_seabed_rival_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		margin_left = 8

		te_seabed_rival_cells = {
			blockoverride "flag_context" {
				datacontext = "[State.GetCountry]"
			}
			blockoverride "cell_name" {
				raw_text = "[State.GetCountry.GetNameNoFormatting]"
			}
			blockoverride "cell_mines" {
				block "rival_mines" {}
			}
			blockoverride "cell_claims" {
				block "rival_claims" {}
			}
			blockoverride "cell_weight" {
				block "rival_weight" {}
			}
		}
	}

	### Our own row, with the basin's Relinquish or Claim Again in its last
	### cell (rule 6: beside the item it acts on). The flag is the shown
	### country's, Country, as the row's figures are.
	type te_seabed_rival_us = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		margin_left = 8
		block "row_visible" {}

		te_seabed_rival_cells = {
			blockoverride "flag_context" {
				datacontext = "[Country]"
			}
			blockoverride "cell_name" {
				text = "te_seabed_rival_us_name"
			}
			blockoverride "cell_mines" {
				block "us_mines" {}
			}
			blockoverride "cell_claims" {
				block "us_claims" {}
			}
			blockoverride "cell_weight" {
				block "us_weight" {}
			}
		}
		block "row_buttons" {}
	}

	### A pool bar legend chip and its label.
	type te_seabed_legend_chip = flowcontainer {
		direction = horizontal
		spacing = 4
		widget = {
			size = { 14 14 }
			parentanchor = vcenter
			block "chip" {}
		}
		textbox = {
			autoresize = yes
			max_width = 300
			align = left|nobaseline
			using = te_seabed_fontsize_row
			block "chip_text" {}
		}
	}

	### ----------------------------------------------------------------------
	### The overview: always open (rule 1). Six boxes, the four questions first:
	### room to build (and at home), our licences (and the holding fee), long-haul
	### mines, unused claims (and what next January can take), the policy (and
	### its lock) and the regime.
	### ----------------------------------------------------------------------
	type te_seabed_overview_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

		te_seabed_panel = {
			flowcontainer = {
				direction = vertical
				spacing = 4
				margin_top = 4
				margin_bottom = 4

				flowcontainer = {
					direction = horizontal
					spacing = 4

					te_seabed_ov_cell = {
						tooltip = "te_seabed_ov_room_tt"
						blockoverride "icon" {
							texture = "gfx/interface/icons/state_status_icons/has_construction.dds"
						}
						blockoverride "caption" {
							text = "te_seabed_ov_room_cap"
						}
						blockoverride "word" {
							te_seabed_ov_word = {
								text = "te_seabed_ov_room_word"
							}
						}
						blockoverride "fig" {
							te_seabed_ov_fig = {
								text = "te_seabed_ov_room_fig"
							}
						}
					}
					te_seabed_ov_cell = {
						tooltip = "te_seabed_ov_licences_tt"
						blockoverride "icon" {
							texture = "gfx/interface/icons/building_icons/building_ocean_mine.dds"
						}
						blockoverride "caption" {
							text = "te_seabed_ov_licences_cap"
						}
						blockoverride "word" {
							te_seabed_ov_word = {
								text = "te_seabed_ov_licences_word"
							}
						}
						blockoverride "fig" {
							te_seabed_ov_fig = {
								visible = "[Not( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_fee_disp'), '(CFixedPoint)0' ) )]"
								text = "te_seabed_ov_licences_fig"
							}
							te_seabed_ov_fig = {
								visible = "[GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_fee_disp'), '(CFixedPoint)0' )]"
								text = "te_seabed_ov_licences_fig_fee"
							}
						}
					}
				}
				flowcontainer = {
					direction = horizontal
					spacing = 4

					te_seabed_ov_cell = {
						tooltip = "te_seabed_ov_longhaul_tt"
						blockoverride "icon" {
							texture = "gfx/interface/icons/generic_icons/warning.dds"
						}
						blockoverride "caption" {
							text = "te_seabed_ov_longhaul_cap"
						}
						blockoverride "word" {
							te_seabed_ov_word = {
								visible = "[GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_distant_total'), '(CFixedPoint)0' )]"
								text = "te_seabed_ov_longhaul_word"
							}
							te_seabed_ov_word = {
								visible = "[Not( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_distant_total'), '(CFixedPoint)0' ) )]"
								text = "te_seabed_ov_longhaul_word_none"
							}
						}
						blockoverride "fig" {
							te_seabed_ov_fig = {
								visible = "[GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_distant_total'), '(CFixedPoint)0' )]"
								text = "te_seabed_ov_longhaul_fig"
							}
							te_seabed_ov_fig = {
								visible = "[Not( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_distant_total'), '(CFixedPoint)0' ) )]"
								text = "te_seabed_ov_longhaul_fig_none"
							}
						}
					}
					te_seabed_ov_cell = {
						tooltip = "te_seabed_ov_claims_tt"
						blockoverride "icon" {
							texture = "gfx/interface/icons/military_icons/navy_icons/detection_navy.dds"
						}
						blockoverride "caption" {
							text = "te_seabed_ov_claims_cap"
						}
						blockoverride "word" {
							te_seabed_ov_word = {
								text = "te_seabed_ov_claims_word"
							}
						}
						blockoverride "fig" {
							te_seabed_ov_fig = {
								visible = "[GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_protected_disp'), '(CFixedPoint)0' )]"
								text = "te_seabed_ov_claims_fig"
							}
							te_seabed_ov_fig = {
								visible = "[Not( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_protected_disp'), '(CFixedPoint)0' ) )]"
								text = "te_seabed_ov_claims_fig_all"
							}
						}
					}
				}
				flowcontainer = {
					direction = horizontal
					spacing = 4

					te_seabed_ov_cell = {
						tooltip = "te_seabed_ov_policy_tt"
						blockoverride "icon" {
							texture = "gfx/interface/icons/topbar/influence_icon.dds"
						}
						blockoverride "caption" {
							text = "te_seabed_ov_policy_cap"
						}
						blockoverride "word" {
							te_seabed_ov_word = {
								text = "te_seabed_ov_policy_word"
							}
						}
						blockoverride "fig" {
							te_seabed_ov_fig = {
								visible = "[GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_policy_locked_disp'), '(CFixedPoint)0' )]"
								text = "te_seabed_ov_policy_fig"
							}
							te_seabed_ov_fig = {
								visible = "[Not( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_policy_locked_disp'), '(CFixedPoint)0' ) )]"
								text = "te_seabed_ov_policy_fig_free"
							}
						}
					}
					te_seabed_ov_cell = {
						tooltip = "te_seabed_ov_regime_tt"
						blockoverride "icon" {
							texture = "gfx/interface/icons/generic_icons/world_market.dds"
						}
						blockoverride "caption" {
							text = "te_seabed_ov_regime_cap"
						}
						blockoverride "word" {
							te_seabed_ov_word = {
								text = "te_seabed_ov_regime_word"
							}
						}
						blockoverride "fig" {
							te_seabed_ov_fig = {
								visible = "[And( GetScriptedGui('te_seabed_un_line_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), GetScriptedGui('te_seabed_itlos_party_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) )]"
								text = "te_seabed_ov_regime_fig"
							}
							te_seabed_ov_fig = {
								visible = "[And( GetScriptedGui('te_seabed_un_line_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), Not( GetScriptedGui('te_seabed_itlos_party_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) )]"
								text = "te_seabed_ov_regime_fig_noparty"
							}
							te_seabed_ov_fig = {
								visible = "[Not( GetScriptedGui('te_seabed_un_line_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) )]"
								text = "te_seabed_ov_regime_fig_nocon"
							}
						}
					}
				}
			}
		}
	}

	### ----------------------------------------------------------------------
	### The policy: one national choice, three short buttons centred under the
	### heading (rule 6); the full name, factor, influence and the five-year lock
	### on hover (rule 3). The buttons are all it holds, so the whole panel is
	### the player's own (te_own_country_only); the overview's Policy box shows
	### another country's policy and its lock.
	### ----------------------------------------------------------------------
	type te_seabed_policy_panel = flowcontainer {
		using = te_own_country_only
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

		te_seabed_panel = {
			te_seabed_subheader = {
				blockoverride "subheader_text" {
					text = "te_seabed_policy_header"
				}
			}
			flowcontainer = {
				direction = horizontal
				parentanchor = hcenter
				spacing = 6
				margin_top = 6
				margin_bottom = 4

				te_seabed_policy_button = {
					blockoverride "policy_context" {
						datacontext = "[GetScriptedGui('te_seabed_policy_1_sgui')]"
					}
					blockoverride "policy_text" {
						text = "te_seabed_policy_short_1"
					}
				}
				te_seabed_policy_button = {
					blockoverride "policy_context" {
						datacontext = "[GetScriptedGui('te_seabed_policy_2_sgui')]"
					}
					blockoverride "policy_text" {
						text = "te_seabed_policy_short_2"
					}
				}
				te_seabed_policy_button = {
					blockoverride "policy_context" {
						datacontext = "[GetScriptedGui('te_seabed_policy_3_sgui')]"
					}
					blockoverride "policy_text" {
						text = "te_seabed_policy_short_3"
					}
				}
			}
		}
	}

	### ----------------------------------------------------------------------
	### The basins: all five, always (rule 1: live, open). Each opens onto its
	### claimants (collapsed by default, te_seabed_rivals_<basin>_open: five open
	### lists would push the rest off the panel), our own row with Relinquish or
	### Claim Again, and the claimants past six. The bar's legend under the table.
	### The claimants and the chevron that opens them are the player's own
	### (te_own_country_only; the file's header says why).
	### ----------------------------------------------------------------------
	type te_seabed_basins_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes

		te_seabed_panel = {
			widget = {
				size = { 480 30 }

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 270
					align = left|nobaseline
					using = te_seabed_fontsize_heading
					default_format = "#title"
					text = "te_seabed_basins_header"
				}
				textbox = {
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 210
					align = right|nobaseline
					using = te_seabed_fontsize_row
					text = "[SelectLocalization( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_asof_year_disp'), '(CFixedPoint)0' ), 'te_seabed_basins_asof', 'te_seabed_basins_asof_old' )]"
				}
			}
			divider_clean = {
				blockoverride "size" {
					size = { 480 2 }
				}
			}
			te_seabed_basin_head = {}
			te_seabed_basin_row = {
				blockoverride "basin_toggle" {
					onclick = "[GetVariableSystem.Toggle('te_seabed_rivals_pacific_open')]"
					button = {
						using = expand_arrow
						size = { 18 18 }
						parentanchor = center
						alwaystransparent = yes
						visible = "[Not(GetVariableSystem.Exists('te_seabed_rivals_pacific_open'))]"
					}
					button = {
						using = expand_arrow_expanded
						size = { 18 18 }
						parentanchor = center
						alwaystransparent = yes
						visible = "[GetVariableSystem.Exists('te_seabed_rivals_pacific_open')]"
					}
				}
				blockoverride "basin_name" {
					tooltip = "te_seabed_basin_tt_pacific"
					text = "te_seabed_basin_pacific"
				}
				blockoverride "basin_free" {
					tooltip = "[GetScriptedGui('te_seabed_build_in_sgui').ExecuteTooltip( GuiScope.SetRoot( Country.MakeScope ).AddScope( 'op', MakeScopeValue( '(CFixedPoint)1' ) ).End )]"
					text = "[SelectLocalization( And( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_home_disp_pacific'), '(CFixedPoint)0' ), GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_unbuilt_disp_pacific'), '(CFixedPoint)0' ) ), 'te_seabed_free_home_pacific', 'te_seabed_free_pacific' )]"
				}
				blockoverride "basin_pool" {
					te_seabed_pool_bar = {
						blockoverride "bar_tooltip" {
							tooltip = "te_seabed_pool_tt_pacific"
						}
						blockoverride "bar_4" {
							value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('te_seabed_bar_pacific_4') )]"
						}
						blockoverride "bar_3" {
							value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('te_seabed_bar_pacific_3') )]"
						}
						blockoverride "bar_2" {
							value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('te_seabed_bar_pacific_2') )]"
						}
						blockoverride "bar_1" {
							value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('te_seabed_bar_pacific_1') )]"
						}
					}
				}
				blockoverride "basin_weight" {
					tooltip = "te_seabed_weight_tt_pacific"
					text = "te_seabed_weight_pct_pacific"
				}
				blockoverride "basin_next" {
					tooltip = "[SelectLocalization( GreaterThanOrEqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_pacific'), '(CFixedPoint)0' ), 'te_seabed_next_tt_pacific', 'te_seabed_col_next_tt' )]"
					text = "[SelectLocalization( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_pacific'), '(CFixedPoint)-2' ), 'te_seabed_next_none', SelectLocalization( EqualTo_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_need_navy_disp_pacific'), '(CFixedPoint)-1' ), 'te_seabed_next_full', 'te_seabed_next_pacific' ) )]"
				}
			}
			flowcontainer = {
				using = te_own_country_only
				direction = vertical
				ignoreinvisible = yes

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 2
					margin_bottom = 4
					visible = "[GetVariableSystem.Exists('te_seabed_rivals_pacific_open')]"

					te_seabed_rival_head = {}
					flowcontainer = {
						direction = vertical
