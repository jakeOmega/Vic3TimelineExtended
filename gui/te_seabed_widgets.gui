	### ----------------------------------------------------------------------
	### How Seabed Licences Work: collapsed (te_seabed_how_open).
	### ----------------------------------------------------------------------
	type te_seabed_how_panel = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		spacing = 4

		section_header_button = {
			blockoverride "layout" {
				parentanchor = hcenter
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "te_seabed_how_header"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('te_seabed_how_open')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('te_seabed_how_open'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('te_seabed_how_open')]"
			}
		}

		te_seabed_panel = {
			visible = "[GetVariableSystem.Exists('te_seabed_how_open')]"

			te_seabed_subheader = {
				blockoverride "subheader_text" {
					text = "te_seabed_how_sub_pools"
				}
			}
			te_seabed_note = {
				text = "te_seabed_how_pools"
			}
			te_seabed_subheader = {
				blockoverride "subheader_text" {
					text = "te_seabed_how_sub_weight"
