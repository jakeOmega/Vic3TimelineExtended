					te_seabed_pool_bar = {
						blockoverride "bar_tooltip" {
							tooltip = "te_seabed_pool_tt_arctic"
						}
						blockoverride "bar_4" {
							value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('te_seabed_bar_arctic_4') )]"
						}
						blockoverride "bar_3" {
							value = "[FixedPointToFloat( Country.MakeScope.ScriptValue('te_seabed_bar_arctic_3') )]"
						}
