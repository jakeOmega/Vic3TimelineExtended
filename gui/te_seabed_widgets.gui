						blockoverride "row_buttons" {
							te_seabed_claim_button = {
								visible = "[GetScriptedGui('te_seabed_relinquish_southern_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								blockoverride "claim_context" {
									datacontext = "[GetScriptedGui('te_seabed_relinquish_southern_sgui')]"
