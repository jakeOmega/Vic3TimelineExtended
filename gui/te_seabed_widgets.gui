					text = "[SelectLocalization( And( GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_home_disp_arctic'), '(CFixedPoint)0' ), GreaterThan_CFixedPoint( Country.MakeScope.ScriptValue('te_seabed_unbuilt_disp_arctic'), '(CFixedPoint)0' ) ), 'te_seabed_free_home_arctic', 'te_seabed_free_arctic' )]"
				}
