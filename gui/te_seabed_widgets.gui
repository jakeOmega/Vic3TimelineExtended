	### The Help page: every explanation, gathered out of the live sections, one
	### subheading per topic. The live sections say what is happening; this says
	### how it works. Seabed has no journal entry, and the figures its notes
	### quote read GetPlayer, as they did in the panel, so the page opens from
	### any host (test_te_help_pages.py). Instanced only by te_seabed_help_popup.
	type te_seabed_help_body = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 4

		te_seabed_subheader = {
			blockoverride "subheader_text" {
				text = "te_seabed_how_sub_pools"
			}
		}
		te_seabed_note = {
			text = "te_seabed_how_pools"
		}
		te_seabed_subheader = {
			blockoverride "subheader_text" {
				text = "te_seabed_how_sub_weight"
			}
		}
		te_seabed_note = {
			text = "te_seabed_how_weight"
		}
		te_seabed_subheader = {
			blockoverride "subheader_text" {
				text = "te_seabed_how_sub_licences"
			}
		}
		te_seabed_note = {
			text = "te_seabed_how_licences"
		}
		te_seabed_note = {
			text = "te_seabed_how_distant"
		}
		te_seabed_subheader = {
			blockoverride "subheader_text" {
				text = "te_seabed_how_sub_claims"
			}
		}
		te_seabed_note = {
			text = "te_seabed_how_claims"
		}
		te_seabed_subheader = {
			blockoverride "subheader_text" {
				text = "te_seabed_how_sub_leases"
			}
		}
		te_seabed_note = {
			text = "te_seabed_how_leases"
		}
		te_seabed_subheader = {
			blockoverride "subheader_text" {
				text = "te_seabed_how_sub_policy"
			}
		}
		te_seabed_note = {
			text = "te_seabed_how_policy"
		}
		te_seabed_note = {
			text = "te_seabed_how_regime"
		}
	}

	### The Help page's popup, in te_popups (gui/te_popups.gui).
	type te_seabed_help_popup = te_ui_help_popup {
		blockoverride "popup_visible" {
			visible = "[GetVariableSystem.HasValue('te_popup', 'help_seabed')]"
		}
		blockoverride "popup_title" {
			text = "te_seabed_how_header"
		}
		blockoverride "popup_list" {
			te_seabed_help_body = {}
		}
	}

	### ----------------------------------------------------------------------
	### The Seabed tab of the Timeline Extended window (te_system_tab_frame,
	### gui/te_system_tab_widgets.gui; the window mounts it from
	### gui/te_systems_window_generated.gui). No journal entry: the panels read
	### Country, the player's in the window (the frame's tab_country), under the tab's gate
	### (te_window_seabed_tab_sgui) on a parent, the header outside it, and no
	### Open Journal Entry. te_seabed_tab_layout is the block a wide mount
	### overrides.
	### ----------------------------------------------------------------------
	type te_seabed_tab_body = te_system_tab_frame {
		blockoverride "tab_header" {
			default_header = {
				using = default_list_position
				blockoverride "text" {
					text = "te_seabed_tab_header"
				}
				### Show the ocean basins on the map (gui/te_map_widgets.gui; journal_map_modes.md).
				te_jmap_seabed_map_button = {}
				te_help_button = {
					visible = "[Not( GetMetaPlayer.IsObserver )]"
					onclick = "[GetVariableSystem.Set('te_popup', 'help_seabed')]"
				}
			}
		}
		blockoverride "tab_gate" {
			visible = "[GetScriptedGui('te_window_seabed_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}
		blockoverride "tab_content" {
			block "te_seabed_tab_layout" {
				te_seabed_overview_panel = {}
				te_seabed_policy_panel = {}
				te_seabed_basins_panel = {}
			}
		}
		blockoverride "tab_open_journal" {}
	}

	### The tab full screen (spec docs/superpowers/specs/2026-11-02-te-window-wide-mode-design.md
	### § 7), te_seabed_tab_layout's override in the window's full-screen
	### frame: the overview and the policy, then the Ocean Basins table, in two
	### columns of a fixed 520 (te_ui_columns_two). The tab's gate stays on the
	### frame's parent; the panels' spacing of 10 is the columns'.
	type te_seabed_wide_sections = te_ui_columns_two {
		blockoverride "column_1" {
			te_seabed_overview_panel = {}
			te_seabed_policy_panel = {}
		}

		blockoverride "column_2" {
			te_seabed_basins_panel = {}
		}
	}
}
