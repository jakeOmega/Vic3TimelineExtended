### State-view widget library — types instanced from gui/states_panel.gui.
###
### states_panel.gui is a full-file override of vanilla and is re-merged on
### every vanilla patch, so the mod's own markup lives here and the override
### carries only the instances. Types declared in a .gui file are global
### (te_history_chart.gui is instanced from other files the same way), so
### nothing includes this file.
###
### ALIGNMENT. Every reading is a te_state_stat_row: the label in a fixed-width
### column and the number right-anchored in a fixed-width column beside it, so
### a stack of rows ends at one x with no padding spaces in localization — the
### same idiom as ch_breakdown_row and nuclear_program_row in the JE widgets.
### The defaults suit a 250 px column of the tourism card;
### te_state_tile_row resizes them for the 160 px text column of a
### state_panel_status_item_small tile.
###
### DATA. Every number is a state-scope script value read through
### State.MakeScope.ScriptValue (ScriptValue needs MakeScope, and the JE
### widgets' JournalEntry.GetCountry.MakeScope root does not exist here). Bars
### read *_fill_pct script values that are already clamped to 0-100 and carry
### their cap in script, so no threshold or cap is restated in this file.

types te_state_panel_widget_types
{
	### One label/value line: an optional 20 px icon, the label column, then
	### the value column with its text anchored right. A row's hover
	### (row_tooltip, or a te_state_meter's meter_tooltip around it) is not
	### underlined, as vanilla's rows aren't (gui_style_guide.md rule 3).
	type te_state_stat_row = flowcontainer {
		direction = horizontal
		ignoreinvisible = yes
		spacing = 4

		block "row_visible" {}
		block "row_tooltip" {}

		block "row_icon" {
			icon = {
				size = { 20 20 }
				parentanchor = vcenter
				block "row_icon_texture" {}
			}
		}

		widget = {
			block "label_size" {
				size = { 162 22 }
			}

			textbox = {
				parentanchor = left|vcenter
				autoresize = yes
				block "label_max_width" {
					max_width = 162
				}
				elide = right
				align = nobaseline
				block "row_font" {
					using = fontsize_medium
				}
				block "row_label" {}
			}
		}

		widget = {
			block "value_size" {
				size = { 60 22 }
			}

			textbox = {
				parentanchor = right|vcenter
				autoresize = yes
				block "value_max_width" {
					max_width = 60
				}
				elide = right
				align = right|nobaseline
				block "row_font" {
					using = fontsize_medium
				}
				block "row_value" {}
			}
		}
	}

	### The same row sized for a status tile's 160 px text column: no icon,
	### 96 px of label, 60 px of value.
	type te_state_tile_row = te_state_stat_row {
		blockoverride "row_icon" {}

		blockoverride "label_size" {
			size = { 96 20 }
		}
		blockoverride "label_max_width" {
			max_width = 96
		}
		blockoverride "value_size" {
			size = { 60 20 }
		}
		blockoverride "value_max_width" {
			max_width = 60
		}
	}

	### The tile row for a word rather than a number (a basin's name, "62 → 55"):
	### 60 px of label, 96 px of value. "Southern" at fontsize_medium needs about
	### 66 px (gui_style_guide.md rule 3's budget), past the number column's 60.
	type te_state_tile_word_row = te_state_stat_row {
		blockoverride "row_icon" {}

		blockoverride "label_size" {
			size = { 60 20 }
		}
		blockoverride "label_max_width" {
			max_width = 60
		}
		blockoverride "value_size" {
			size = { 96 20 }
		}
		blockoverride "value_max_width" {
			max_width = 96
		}
	}

	### A row with no icon whose label takes the icon's place, so it spans the
	### full 250 px column — column headers and the card's footer.
	type te_state_wide_row = te_state_stat_row {
		blockoverride "row_icon" {}

		blockoverride "label_size" {
			size = { 186 24 }
		}
		blockoverride "label_max_width" {
			max_width = 186
		}
		blockoverride "value_size" {
			size = { 60 24 }
		}
	}

	### A thin headroom bar: how far a source has climbed toward its own cap.
	### A bare progressbar over a dark track — gui_modding_guide.md: vanilla's
	### framed progressbar_properties bars turn to noise a few pixels tall. The
	### instance supplies `value` from a 0-100 *_fill_pct script value. The
	### default indent lines the bar up under a te_state_stat_row's label
	### (20 px icon + 4 px spacing).
	type te_state_stat_bar = flowcontainer {
		direction = horizontal
		alwaystransparent = yes

		block "bar_indent" {
			widget = {
				size = { 24 4 }
			}
		}

		widget = {
			block "bar_size" {
				size = { 226 4 }
			}
			alwaystransparent = yes

			icon = {
				size = { 100% 100% }
				texture = "gfx/interface/backgrounds/white.dds"
				color = { 0.0 0.0 0.0 0.35 }
				alwaystransparent = yes
			}

			progressbar = {
				size = { 100% 100% }
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				min = 0
				max = 100

				block "bar_value" {
					value = 0
				}
				block "bar_color" {
					color = { 0.86 0.70 0.36 1.0 }
				}
			}
		}
	}

	### One source of a breakdown: its row, the bar under it, and one tooltip
	### over both, so the number, the bar and the rule behind them are never
	### separated.
	type te_state_meter = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		alwaystransparent = no

		block "meter_tooltip" {}
	}

	### Column header: the concept name and the column total, in the tiles'
	### title font, over a divider. Laid out like te_state_wide_row but with
	### its own textboxes, so the instance's header_label / header_value land
	### directly on a block of this type rather than being forwarded through a
	### blockoverride of a nested derived type. Both headers carry a hover.
	type te_state_column_header = flowcontainer {
		direction = vertical
		spacing = 3
		alwaystransparent = no

		block "header_tooltip" {}

		flowcontainer = {
			direction = horizontal
			spacing = 4

			widget = {
				size = { 186 24 }

				textbox = {
					parentanchor = left|vcenter
					autoresize = yes
					max_width = 186
					elide = right
					align = nobaseline
					block "header_label" {}
				}
			}

			widget = {
				size = { 60 24 }

				textbox = {
					parentanchor = right|vcenter
					autoresize = yes
					max_width = 60
					elide = right
					align = right|nobaseline
					block "header_value" {}
				}
			}
		}

		divider_clean = {
			blockoverride "size" {
				size = { 250 2 }
			}
		}
	}

	### TOURISM
	###
	### A full-width card above the status grid rather than a tile in it: the
	### grid is a wrap_count = 2 flowcontainer of 260 px tiles, and anything that
	### is not exactly one tile breaks its rows (the old in-grid tourism box was
	### 250 px wide and ~220 px tall beside a ~90 px tile). 530 px matches the
	### population block above and the two-tile span below.
	###
	### Left column: the output sources (common/script_values/tourism.txt,
	### total_tourism_output_bonus_percent). Right column: the throughput
	### sources (total_tourism_throughput_bonus_percent). Both are re-applied
	### monthly by te_update_tourism_modifier as the tourism_output /
	### tourism_throughput static modifiers; the footer reads the state's live
	### modifier values, which also carry airports, decrees, pollution, turmoil
	### and the rest, with the engine's own breakdown on hover.
	type te_state_tourism_card = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		margin_top = 10

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin = { 10 8 }
			spacing = 6

			background = {
				using = entry_bg_simple
			}

			flowcontainer = {
				direction = horizontal
				spacing = 10

				### OUTPUT
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 4

					te_state_column_header = {
						blockoverride "header_tooltip" {
							tooltip = "te_state_tourism_output_tt"
						}
						blockoverride "header_label" {
							text = "[concept_tourism_output]"
						}
						blockoverride "header_value" {
							raw_text = "#bold [State.MakeScope.ScriptValue('total_tourism_output_bonus_percent')|+=0%]#!"
						}
					}

					te_state_meter = {
						blockoverride "meter_tooltip" {
							tooltip = "te_state_tourism_appeal_tt"
						}

						te_state_stat_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/goods_icons/tourism.dds"
							}
							blockoverride "row_label" {
								text = "[concept_tourism_base_appeal]"
							}
							blockoverride "row_value" {
								raw_text = "[State.MakeScope.ScriptValue('tourism_bonus_from_base_appeal')|+=0%]"
							}
						}
						te_state_stat_bar = {
							blockoverride "bar_value" {
								value = "[FixedPointToFloat(State.MakeScope.ScriptValue('tourism_fill_base_appeal_pct'))]"
							}
						}
					}

					te_state_meter = {
						blockoverride "meter_tooltip" {
							tooltip = "te_state_tourism_cities_tt"
						}

						te_state_stat_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/building_icons/urban_center.dds"
							}
							blockoverride "row_label" {
								text = "[SelectLocalization(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('city_size_rank'), '(CFixedPoint)0'), 'te_state_tourism_cities_ranked', 'te_state_tourism_cities_unranked')]"
							}
							blockoverride "row_value" {
								raw_text = "[State.MakeScope.ScriptValue('tourism_bonus_from_urban_centers')|+=0%]"
							}
						}
						te_state_stat_bar = {
							blockoverride "bar_value" {
								value = "[FixedPointToFloat(State.MakeScope.ScriptValue('tourism_fill_urban_centers_pct'))]"
							}
						}
					}

					### Monuments are uncapped (+10% each, more for the 1836
					### wonders), so there is no headroom to draw.
					te_state_meter = {
						blockoverride "meter_tooltip" {
							tooltip = "te_state_tourism_monuments_tt"
						}

						te_state_stat_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/building_icons/statue_of_liberty.dds"
							}
							blockoverride "row_label" {
								text = "[concept_tourism_monuments]"
							}
							blockoverride "row_value" {
								raw_text = "[State.MakeScope.ScriptValue('tourism_bonus_from_monuments')|+=0%]"
							}
						}
					}
				}

				### THROUGHPUT
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 4

					te_state_column_header = {
						blockoverride "header_tooltip" {
							tooltip = "te_state_tourism_throughput_tt"
						}
						blockoverride "header_label" {
							text = "[concept_tourism_throughput]"
						}
						blockoverride "header_value" {
							raw_text = "#bold [State.MakeScope.ScriptValue('total_tourism_throughput_bonus_percent')|+=0%]#!"
						}
					}

					te_state_meter = {
						blockoverride "meter_tooltip" {
							tooltip = "te_state_tourism_infrastructure_tt"
						}

						te_state_stat_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/state_status_icons/state_infrastructure.dds"
							}
							blockoverride "row_label" {
								text = "[concept_tourism_infrastructure]"
							}
							blockoverride "row_value" {
								raw_text = "[State.MakeScope.ScriptValue('tourism_throughput_from_infrastructure')|+=0%]"
							}
						}
						te_state_stat_bar = {
							blockoverride "bar_value" {
								value = "[FixedPointToFloat(State.MakeScope.ScriptValue('tourism_fill_infrastructure_pct'))]"
							}
							blockoverride "bar_color" {
								color = { 0.42 0.68 0.78 1.0 }
							}
						}
					}

					te_state_meter = {
						blockoverride "meter_tooltip" {
							tooltip = "te_state_tourism_art_tt"
						}

						te_state_stat_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/goods_icons/fine_art.dds"
							}
							blockoverride "row_label" {
								text = "[concept_tourism_art]"
							}
							blockoverride "row_value" {
								raw_text = "[State.MakeScope.ScriptValue('tourism_throughput_from_art')|+=0%]"
							}
						}
						te_state_stat_bar = {
							blockoverride "bar_value" {
								value = "[FixedPointToFloat(State.MakeScope.ScriptValue('tourism_fill_art_pct'))]"
							}
							blockoverride "bar_color" {
								color = { 0.42 0.68 0.78 1.0 }
							}
						}
					}

					te_state_meter = {
						blockoverride "meter_tooltip" {
							tooltip = "te_state_tourism_parks_tt"
						}

						te_state_stat_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/state_status_icons/pollution.dds"
							}
							blockoverride "row_label" {
								text = "[concept_tourism_parks]"
							}
							blockoverride "row_value" {
								raw_text = "[State.MakeScope.ScriptValue('tourism_throughput_from_parks')|+=0%]"
							}
						}
						te_state_stat_bar = {
							blockoverride "bar_value" {
								value = "[FixedPointToFloat(State.MakeScope.ScriptValue('tourism_fill_parks_pct'))]"
							}
							blockoverride "bar_color" {
								color = { 0.42 0.68 0.78 1.0 }
							}
						}
					}

					### A Skyscraper's flat +10%: no headroom to draw.
					te_state_meter = {
						blockoverride "meter_tooltip" {
							tooltip = "te_state_tourism_skyscraper_tt"
						}

						te_state_stat_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/building_icons/skyscraper.dds"
							}
							blockoverride "row_label" {
								text = "te_state_tourism_skyscraper_lbl"
							}
							blockoverride "row_value" {
								raw_text = "[State.MakeScope.ScriptValue('tourism_throughput_from_skyscraper')|+=0%]"
							}
						}
					}
				}
			}

			divider_clean = {
				blockoverride "size" {
					size = { 510 2 }
				}
			}

			### FOOTER — the modifiers actually on the state right now.
			flowcontainer = {
				direction = horizontal
				spacing = 10

				te_state_wide_row = {
					blockoverride "row_tooltip" {
						tooltip = "te_state_tourism_output_applied_tt"
					}
					blockoverride "row_label" {
						text = "te_state_tourism_applied_label"
					}
					blockoverride "row_value" {
						raw_text = "[State.GetModifier.GetValueWithBreakdownFor('goods_output_tourism_mult')]"
					}
				}

				te_state_wide_row = {
					blockoverride "row_tooltip" {
						tooltip = "te_state_tourism_throughput_applied_tt"
					}
					blockoverride "row_label" {
						text = "te_state_tourism_applied_label"
					}
					blockoverride "row_value" {
						raw_text = "[State.GetModifier.GetValueWithBreakdownFor('building_tourism_industry_throughput_add')]"
					}
				}
			}
		}
	}

	### GRAND MONUMENT
	###
	### A full-width card under the tourism card, shown only while a Grand
	### Monument stands in the state (gm_status_code, 0 without one), in any
	### country's state. One per state: the building is one per state, levels
	### uncapped. Left, its status as the journal entry's row shows it
	### (gm_row_status, the mod's own icons with the word beneath). Right, its
	### name and dedication (the row's gm_row_title keys), then what it does
	### here: grandeur with a bar of the step now being filled, its tourism
	### output and its dedication's local effect, each as last
	### refreshed by gm_state_monthly (gm_state_disp_* in gm_values.txt); the
	### local effect's name and format come from the custom localization
	### gm_local_effect_label / _value. Under them, while contested, who wants it
	### kept and who resents it, then the inscription (empty when none).
	###
	### Display only but for Dedicate and Carry It Off: Pull Down, Rededicate,
	### Keep as Heritage and the names are the journal entry's, so a state of
	### the player's own carries a goto button instead, to the Grand Monuments
	### tab of the Timeline Extended window (te_systems_window.gui), which shows
	### the entry's own panels. The title column stops short of it. A
	### construction site here has its own card below (te_state_gm_site_card),
	### with its Dedicate button.
	###
	### Under the picture and details, full width, the monuments that stand beside
	### this one (te_state_gm_beside, gui/gm_trophy_widgets.gui): a row each, only
	### while one does. This card is the state's whole: its Grandeur, tourism and
	### local effect are the building's, at every monument's levels together.
	###
	### Columns: 120 picture + 10 + 380 = 510, the tourism card's inner width.
	### Rows: 20 icon + 4 + 266 label + 4 + 86 value = 380.
	type te_state_gm_row = te_state_stat_row {
		blockoverride "label_size" {
			size = { 266 22 }
		}
		blockoverride "label_max_width" {
			max_width = 266
		}
		blockoverride "value_size" {
			size = { 86 22 }
		}
		blockoverride "value_max_width" {
			max_width = 86
		}
	}

	### A construction site (sites spec 2026-10-18 §3.1), a card of its own
	### under the monument's, as its row is under Awaiting Dedication: what is
	### being built, the levels built and the grandeur they come to, whether
	### levels are still being built, and for our own the Dedicate button
	### (gm_dedicate_button, grand_monuments_widget.gui). Display only but for
	### that button. Rows: 20 icon + 4 + 266 label + 4 + 86 value = 380.
	type te_state_gm_site_card = flowcontainer {
		visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_disp_site'), '(CFixedPoint)1')]"
		direction = vertical
		parentanchor = hcenter
		margin_top = 10

		container = {
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				margin = { 10 8 }
				spacing = 8
				minimumsize = { 530 -1 }

				background = {
					using = entry_bg_simple
				}

				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 10

					icon = {
						size = { 120 120 }
						texture = "gfx/interface/icons/gm_icons/status_undedicated.dds"
					}

					flowcontainer = {
						direction = vertical
						ignoreinvisible = yes
						spacing = 4

						textbox = {
							autoresize = yes
							multiline = yes
							minimumsize = { 380 -1 }
							maximumsize = { 380 -1 }
							align = left|nobaseline
							using = fontsize_large
							text = "gm_site_card_title"
						}
						te_state_gm_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/building_icons/building_grand_monument.dds"
							}
							blockoverride "row_label" {
								text = "gm_site_card_levels_lbl"
							}
							blockoverride "row_value" {
								text = "gm_site_card_levels"
							}
						}
						te_state_gm_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/building_icons/building_grand_monument.dds"
							}
							blockoverride "row_label" {
								text = "gm_site_card_grandeur_lbl"
							}
							blockoverride "row_value" {
								text = "gm_site_card_grandeur"
							}
						}
						### What a level finished now adds (Plan B: the world-wealth rate).
						te_state_gm_row = {
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/building_icons/building_grand_monument.dds"
							}
							blockoverride "row_label" {
								text = "gm_site_card_rate_lbl"
							}
							blockoverride "row_value" {
								text = "gm_site_card_rate"
							}
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_disp_site_building'), '(CFixedPoint)1')]"
							autoresize = yes
							multiline = yes
							minimumsize = { 380 -1 }
							maximumsize = { 380 -1 }
							align = left|nobaseline
							using = fontsize_medium
							text = "gm_site_row_building"
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_disp_site_building'), '(CFixedPoint)0')]"
							autoresize = yes
							multiline = yes
							minimumsize = { 380 -1 }
							maximumsize = { 380 -1 }
							align = left|nobaseline
							using = fontsize_medium
							text = "gm_site_row_ready"
						}

						### DEDICATE — our own site: holds its ceremony
						### (gm_dedicate_sgui).
						gm_dedicate_button = {}
					}
				}
			}
		}
	}

	type te_state_gm_card = flowcontainer {
		visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)0')]"
		direction = vertical
		parentanchor = hcenter
		margin_top = 10

		container = {
			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				margin = { 10 8 }
				spacing = 8
				minimumsize = { 530 -1 }

				background = {
					using = entry_bg_simple
				}

				### The picture and the details, side by side.
				flowcontainer = {
					direction = horizontal
					ignoreinvisible = yes
					spacing = 10

					### STATUS — one code each (gotcha #23), as Our Monuments' rows.
					### 120 x 144: the 120 x 120 picture, then 24 px under it for
					### gm_row_status's word, set at gm_fontsize_overview (16) since
					### the Grand Monuments type-size pass (it was 12 in 20 px).
					widget = {
						size = { 120 144 }

						gm_picture = {
							size = { 120 120 }
							parentanchor = top|hcenter
						}
						gm_row_status = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)1')]"
							tooltip = "gm_je_status_undedicated_tt"
							blockoverride "status_texture" {
								texture = "gfx/interface/icons/gm_icons/status_undedicated.dds"
							}
							blockoverride "status_size" {
								size = { 120 144 }
							}
						}
						gm_row_status = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)2')]"
							tooltip = "gm_je_status_upheld_tt"
							blockoverride "status_texture" {
								texture = "gfx/interface/icons/gm_icons/status_upheld.dds"
							}
							blockoverride "status_size" {
								size = { 120 144 }
							}
						}
						gm_row_status = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)3')]"
							tooltip = "gm_je_status_heritage_tt"
							blockoverride "status_texture" {
								texture = "gfx/interface/icons/gm_icons/status_heritage.dds"
							}
							blockoverride "status_size" {
								size = { 120 144 }
							}
						}
						gm_row_status = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)4')]"
							tooltip = "gm_je_status_contested_tt"
							blockoverride "status_texture" {
								texture = "gfx/interface/icons/gm_icons/status_contested.dds"
							}
							blockoverride "status_size" {
								size = { 120 144 }
							}
						}
					}

					flowcontainer = {
						direction = vertical
						ignoreinvisible = yes
						spacing = 4
						minimumsize = { 380 -1 }

						### NAME — a typed name (v2 §3.5) prints straight from
						### the state's gm_name, as in the journal entry's row.
						textbox = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_has_typed_name'), '(CFixedPoint)0')]"
							autoresize = yes
							multiline = yes
							minimumsize = { 350 -1 }
							maximumsize = { 350 -1 }
							align = left|nobaseline
							using = fontsize_large
							text = "gm_row_title"
						}
						textbox = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_has_typed_name'), '(CFixedPoint)1')]"
							autoresize = yes
							multiline = yes
							minimumsize = { 350 -1 }
							maximumsize = { 350 -1 }
							align = left|nobaseline
							using = fontsize_large
							text = "gm_row_title_named"
						}

						### A LANDMARK standing since 1836 (phase 4): its history on hover.
						textbox = {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_disp_is_landmark'), '(CFixedPoint)1' )]"
							autoresize = yes
							multiline = yes
							minimumsize = { 350 -1 }
							maximumsize = { 350 -1 }
							align = left|nobaseline
							using = fontsize_medium
							tooltip = "gm_row_landmark_tt"
							text = "gm_row_landmark"
						}

						### GRANDEUR and the step now being filled.
						te_state_meter = {
							blockoverride "meter_tooltip" {
								tooltip = "gm_state_grandeur_tt"
							}

							te_state_gm_row = {
								blockoverride "row_icon_texture" {
									texture = "gfx/interface/icons/building_icons/building_grand_monument.dds"
								}
								blockoverride "row_label" {
									text = "gm_state_lbl_grandeur"
								}
								blockoverride "row_value" {
									text = "gm_state_val_grandeur"
								}
							}
							te_state_stat_bar = {
								blockoverride "bar_size" {
									size = { 356 4 }
								}
								blockoverride "bar_value" {
									value = "[FixedPointToFloat(State.MakeScope.ScriptValue('gm_state_disp_step_pct'))]"
								}
							}
						}

						### FINISHED — dedicated and its construction done (ageing
						### spec 2026-10-16 §3): its levels and its years, the
						### rest on hover.
						textbox = {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_frozen'), '(CFixedPoint)1' )]"
							autoresize = yes
							multiline = yes
							minimumsize = { 380 -1 }
							maximumsize = { 380 -1 }
							align = left|nobaseline
							using = fontsize_medium
							tooltip = "gm_row_frozen_tt"
							text = "gm_row_frozen"
						}

						### IN THIS STATE — zero rows hide (before the first
						### pulse, and the local effect while undedicated).
						te_state_gm_row = {
							visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_disp_tourism'), '(CFixedPoint)0')]"
							blockoverride "row_tooltip" {
								tooltip = "gm_state_tourism_tt"
							}
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/goods_icons/tourism.dds"
							}
							blockoverride "row_label" {
								text = "gm_state_lbl_tourism"
							}
							blockoverride "row_value" {
								text = "gm_state_val_tourism"
							}
						}

						te_state_gm_row = {
							visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_disp_local'), '(CFixedPoint)0')]"
							blockoverride "row_tooltip" {
								tooltip = "gm_state_local_tt"
							}
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/timed_modifier_icons/modifier_statue_positive.dds"
							}
							blockoverride "row_label" {
								text = "gm_state_lbl_local"
							}
							blockoverride "row_value" {
								text = "gm_state_val_local"
							}
						}

						### UNIQUE DEDICATIONS standing here (signatures spec §2.2, §8):
						### Ancestral Antiquity's tourism and the Epigraphic Archive's
						### universities, the state's whole, each hidden at 0.
						te_state_gm_row = {
							visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_disp_sig_tourism'), '(CFixedPoint)0')]"
							blockoverride "row_tooltip" {
								tooltip = "gm_state_sig_tourism_tt"
							}
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/goods_icons/tourism.dds"
							}
							blockoverride "row_label" {
								text = "gm_state_lbl_sig_tourism"
							}
							blockoverride "row_value" {
								text = "gm_state_val_sig_tourism"
							}
						}

						te_state_gm_row = {
							visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_state_disp_sig_university'), '(CFixedPoint)0')]"
							blockoverride "row_tooltip" {
								tooltip = "gm_state_sig_university_tt"
							}
							blockoverride "row_icon_texture" {
								texture = "gfx/interface/icons/timed_modifier_icons/modifier_statue_positive.dds"
							}
							blockoverride "row_label" {
								text = "gm_state_lbl_sig_university"
							}
							blockoverride "row_value" {
								text = "gm_state_val_sig_university"
							}
						}

						### COUNTS toward the owner's open opportunity (opportunities
						### usability §4).
						textbox = {
							visible = "[EqualTo_CFixedPoint( State.MakeScope.ScriptValue('gm_state_disp_com_counts'), '(CFixedPoint)1' )]"
							autoresize = yes
							multiline = yes
							minimumsize = { 380 -1 }
							maximumsize = { 380 -1 }
							align = left|nobaseline
							using = fontsize_medium
							tooltip = "gm_row_com_counts_tt"
							text = "gm_row_com_counts"
						}

						### CONTESTED — the reason on hover; the choices are the
						### journal entry's.
						textbox = {
							visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('gm_status_code'), '(CFixedPoint)4')]"
							autoresize = yes
							multiline = yes
							minimumsize = { 380 -1 }
							maximumsize = { 380 -1 }
							align = left|nobaseline
							using = fontsize_medium
							tooltip = "gm_state_contest_tt"
							text = "gm_row_contest"
						}

						textbox = {
							autoresize = yes
							multiline = yes
							minimumsize = { 380 -1 }
							maximumsize = { 380 -1 }
							align = left|nobaseline
							using = fontsize_medium
							text = "gm_row_inscription"
						}

						### CARRY IT OFF — while our armies hold the state, or it
						### is our own unincorporated state and we did not raise
						### the monument (gui/gm_trophy_widgets.gui).
						gm_tr_take_button = {}

						### CLEAR IT AWAY — six stand here and this is the least
						### grand (gui/gm_trophy_widgets.gui).
						gm_clear_button = {}
					}
				}

				### BESIDE IT: the monuments that stand beside this one, full width
				### under the picture and details, a row each, while any does
				### (gui/gm_trophy_widgets.gui). Their levels are in the building's
				### Grandeur above; Carry It Off is on their rows.
				te_state_gm_beside = {}
			}

			### OPEN THE WINDOW'S TAB — our own state only, while the tab is
			### open (te_window_grand_monuments_tab_sgui, the gate the tab's own
			### content reads). One click does what the tab strip and the
			### launcher do: choose the tab, then open the window, whose root's
			### _show closes this panel as any vanilla goto would.
			widget = {
				visible = "[And(ObjectsEqual(State.GetOwner, GetPlayer.Self), GetScriptedGui('te_window_grand_monuments_tab_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				parentanchor = top|right
				position = { -5 5 }
				size = { 25 25 }

				button_icon_goto = {
					size = { 25 25 }
					tooltip = "gm_state_open_window_tt"
					onclick = "[GetVariableSystem.Set('te_systems_window_tab', 'grand_monuments')]"
					onclick = "[GetVariableSystem.Set('com_open_window', 'te_systems_window')]"
				}
			}
		}
	}

	### HOMELAND DYNAMICS

	### One culture's project: its name and progress, the bar, and a warning
	### line once it has stopped qualifying (the container is destroyed on the
	### next monthly pulse).
	type te_state_homeland_project = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 1
		te_state_tile_row = {
			blockoverride "row_label" {
				text = "[GetScriptedGui('te_homeland_project_culture_sgui').ExecuteTooltip(GuiScope.SetRoot(State.MakeScope).AddScope('project', ScriptContainer.MakeScope).End)]"
			}
			blockoverride "row_tooltip" {
				tooltip = "[GetScriptedGui('te_homeland_project_culture_sgui').ExecuteTooltip(GuiScope.SetRoot(State.MakeScope).AddScope('project', ScriptContainer.MakeScope).End)]"
			}
			blockoverride "row_value" {
				raw_text = "#v [ScriptContainer.MakeScope.ScriptValue('te_homeland_project_progress_pct')|1]%#!"
			}
		}
		te_state_stat_bar = {
			blockoverride "bar_indent" {}
			blockoverride "bar_size" { size = { 160 6 } }
			blockoverride "bar_value" {
				value = "[FixedPointToFloat(ScriptContainer.MakeScope.ScriptValue('te_homeland_project_progress_pct'))]"
			}
		}
		textbox = {
			visible = "[EqualTo_CFixedPoint(ScriptContainer.MakeScope.ScriptValue('te_homeland_project_eligible'), '(CFixedPoint)0')]"
			text = "TE_HOMELAND_PROJECT_INVALID"
			autoresize = yes
			maximumsize = { 160 -1 }
			multiline = yes
			using = fontsize_small
		}
	}

	### The Homeland Dynamics tile's extra_widget. Every line is conditional,
	### on state-scope values in common/script_values/homeland_values.txt:
	### - te_homeland_relevant = 0 hides the whole tile (states_panel.gui).
	### - te_homeland_pause_status: the pause reason, once for the tile.
	### - te_homeland_<track>_shown: a track appears only while it has
	###   projects or can run here, so a core state with nothing to form or
	###   lose shows no empty Creation / Removal sections.
	### - Bars exist only for real per-culture projects; there is no empty
	###   placeholder bar.
	type te_state_homeland_tracks = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 6

		textbox = {
			visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_pause_status'), '(CFixedPoint)1')]"
			text = "TE_HOMELAND_PAUSED_LOCKED"
			autoresize = yes
			maximumsize = { 160 -1 }
			multiline = yes
			using = fontsize_small
		}

		textbox = {
			visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_pause_status'), '(CFixedPoint)2')]"
			text = "TE_HOMELAND_PAUSED_SPLIT"
			autoresize = yes
			maximumsize = { 160 -1 }
			multiline = yes
			using = fontsize_small
		}

		### CREATION. Statuses 1-2 (paused) are the tile-level line above and
		### 3 (no culture) hides the track, so only 4-6 have a line here.
		flowcontainer = {
			visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_creation_shown'), '(CFixedPoint)0')]"
			direction = vertical
			ignoreinvisible = yes
			spacing = 3

			textbox = {
				text = "TE_HOMELAND_CREATION"
				autoresize = yes
				maximumsize = { 160 -1 }
			}
			flowcontainer = {
				direction = vertical
				spacing = 3
				datamodel = "[State.MakeScope.GetList('te_homeland_creation_projects')]"
				item = {
					te_state_homeland_project = {
						datacontext = "[Scope.GetScriptContainer]"
					}
				}
			}

			textbox = {
				visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_creation_status'), '(CFixedPoint)4')]"
				text = "TE_HOMELAND_CREATION_THRESHOLD"
				autoresize = yes
				maximumsize = { 160 -1 }
				multiline = yes
				using = fontsize_small
			}

			textbox = {
				visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_creation_status'), '(CFixedPoint)5')]"
				text = "TE_HOMELAND_TRACK_ACTIVE"
				autoresize = yes
				maximumsize = { 160 -1 }
				multiline = yes
				using = fontsize_small
			}

			textbox = {
				visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_creation_status'), '(CFixedPoint)6')]"
				text = "TE_HOMELAND_TRACK_WAITING"
				autoresize = yes
				maximumsize = { 160 -1 }
				multiline = yes
				using = fontsize_small
			}
		}

		### REMOVAL, laid out like CREATION.
		flowcontainer = {
			visible = "[NotEqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_removal_shown'), '(CFixedPoint)0')]"
			direction = vertical
			ignoreinvisible = yes
			spacing = 3

			textbox = {
				text = "TE_HOMELAND_REMOVAL"
				autoresize = yes
				maximumsize = { 160 -1 }
			}
			flowcontainer = {
				direction = vertical
				spacing = 3
				datamodel = "[State.MakeScope.GetList('te_homeland_removal_projects')]"
				item = {
					te_state_homeland_project = {
						datacontext = "[Scope.GetScriptContainer]"
					}
				}
			}

			textbox = {
				visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_removal_status'), '(CFixedPoint)4')]"
				text = "TE_HOMELAND_REMOVAL_THRESHOLD"
				autoresize = yes
				maximumsize = { 160 -1 }
				multiline = yes
				using = fontsize_small
			}

			textbox = {
				visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_removal_status'), '(CFixedPoint)5')]"
				text = "TE_HOMELAND_REMOVAL_TRACK_ACTIVE"
				autoresize = yes
				maximumsize = { 160 -1 }
				multiline = yes
				using = fontsize_small
			}

			textbox = {
				visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('te_homeland_removal_status'), '(CFixedPoint)6')]"
				text = "TE_HOMELAND_TRACK_WAITING"
				autoresize = yes
				maximumsize = { 160 -1 }
				multiline = yes
				using = fontsize_small
			}
		}
	}

	### WEALTH CONCENTRATION
	###
	### The Wealth Concentration tile's extra_widget (Nation tab plan, Part 2):
	### the state's score heading for its target once it has been scored, then
	### the state modifiers wealth concentration and the inheritance law give
	### it, each with its own tooltip. The tile shows while the state carries
	### any of them (gui_state_wealth_modifier_count), whatever the Demographics
	### rule, and both modifier rows in states_panel.gui leave the same six out
	### (test_hidden_state_modifiers.py's SHOWN_ON_A_CARD_NAMES). The score row
	### reads te_dg_wc only behind te_demog_state_wealth_sgui, as the
	### Demographics subtab's Wealth section does, so an unscored state reads
	### no missing variable.
	### Local Climate's rows (docs/systems/mod_systems/local_climate.md): 80 px of label, 76 of
	### value. "Humidity" needs about 75 px and "Seasonal" about 75 at fontsize_medium
	### (gui_style_guide.md rule 3's budget), past both the number row's 60 and the word row's 60.
	type te_state_climate_row = te_state_stat_row {
		blockoverride "row_icon" {}
		blockoverride "label_size" {
			size = { 80 20 }
		}
		blockoverride "label_max_width" {
			max_width = 80
		}
		blockoverride "value_size" {
			size = { 76 20 }
		}
		blockoverride "value_max_width" {
			max_width = 76
		}
	}

	### The Local Climate tile: the climate record of the state's region, where most of its people
	### live (common/script_values/local_climate_generated.txt). A region with no row says so.
	type te_state_climate_tile = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 3

		te_state_climate_row = {
			blockoverride "row_visible" {
				visible = "[GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_has_record'), '(CFixedPoint)0')]"
			}
			blockoverride "row_tooltip" {
				tooltip = "te_state_climate_summer_tt"
			}
			blockoverride "row_label" {
				text = "TE_STATE_CLIMATE_ROW_SUMMER"
			}
			blockoverride "row_value" {
				text = "te_state_climate_summer_value"
			}
		}

		te_state_climate_row = {
			blockoverride "row_visible" {
				visible = "[GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_has_record'), '(CFixedPoint)0')]"
			}
			blockoverride "row_tooltip" {
				tooltip = "te_state_climate_humidity_tt"
			}
			blockoverride "row_label" {
				text = "TE_STATE_CLIMATE_ROW_HUMIDITY"
			}
			blockoverride "row_value" {
				raw_text = "#v [SelectLocalization(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_summer_humidity'), '(CFixedPoint)2'), 'TE_CLIMATE_HUMIDITY_3', SelectLocalization(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_summer_humidity'), '(CFixedPoint)1'), 'TE_CLIMATE_HUMIDITY_2', SelectLocalization(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_summer_humidity'), '(CFixedPoint)0'), 'TE_CLIMATE_HUMIDITY_1', 'TE_CLIMATE_HUMIDITY_0')))]#!"
			}
		}

		te_state_climate_row = {
			blockoverride "row_visible" {
				visible = "[GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_has_record'), '(CFixedPoint)0')]"
			}
			blockoverride "row_tooltip" {
				tooltip = "te_state_climate_winter_tt"
			}
			blockoverride "row_label" {
				text = "TE_STATE_CLIMATE_ROW_WINTER"
			}
			blockoverride "row_value" {
				text = "te_state_climate_winter_value"
			}
		}

		te_state_climate_row = {
			blockoverride "row_visible" {
				visible = "[GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_has_record'), '(CFixedPoint)0')]"
			}
			blockoverride "row_tooltip" {
				tooltip = "te_state_climate_water_tt"
			}
			blockoverride "row_label" {
				text = "TE_STATE_CLIMATE_ROW_WATER"
			}
			blockoverride "row_value" {
				raw_text = "#v [SelectLocalization(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_aridity'), '(CFixedPoint)1'), 'TE_CLIMATE_WATER_2', SelectLocalization(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_aridity'), '(CFixedPoint)0'), 'TE_CLIMATE_WATER_1', 'TE_CLIMATE_WATER_0'))]#!"
			}
		}

		te_state_climate_row = {
			blockoverride "row_visible" {
				visible = "[GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_has_record'), '(CFixedPoint)0')]"
			}
			blockoverride "row_tooltip" {
				tooltip = "te_state_climate_malaria_tt"
			}
			blockoverride "row_label" {
				text = "TE_STATE_CLIMATE_ROW_MALARIA"
			}
			blockoverride "row_value" {
				raw_text = "#v [SelectLocalization(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_malaria'), '(CFixedPoint)1'), 'TE_CLIMATE_MALARIA_2', SelectLocalization(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_malaria'), '(CFixedPoint)0'), 'TE_CLIMATE_MALARIA_1', 'TE_CLIMATE_MALARIA_0'))]#!"
			}
		}
		textbox = {
			visible = "[Not(GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('te_climate_has_record'), '(CFixedPoint)0'))]"
			autoresize = yes
			max_width = 160
			multiline = yes
			using = fontsize_medium
			text = "TE_STATE_CLIMATE_NO_DATA"
		}
	}

	type te_state_wealth_tile = flowcontainer {
		direction = vertical
		ignoreinvisible = yes
		spacing = 3

		te_state_tile_word_row = {
			blockoverride "row_visible" {
				visible = "[GetScriptedGui('te_demog_state_wealth_sgui').IsShown( GuiScope.SetRoot( State.MakeScope ).End )]"
			}
			blockoverride "row_tooltip" {
				tooltip = "TE_STATE_WEALTH_ROW_SCORE_TT"
			}
			blockoverride "row_label" {
				text = "TE_STATE_WEALTH_ROW_SCORE"
			}
			blockoverride "row_value" {
				text = "te_demog_st_wc_value"
			}
		}

		### Names wrap rather than elide (rule 3): "Cadet Sons Leave the Land"
		### is wider than the 136 px beside its icon.
		flowcontainer = {
			datamodel = "[State.GetTimedModifiers]"
			direction = vertical
			ignoreinvisible = yes
			spacing = 3

			item = {
				flowcontainer = {
					visible = "[Or(EqualTo_string(TimedModifier.GetName, Localize('inh_concentrated_property')), Or(EqualTo_string(TimedModifier.GetName, Localize('inh_dispersed_property')), Or(EqualTo_string(TimedModifier.GetName, Localize('inh_forced_heirship_rural')), Or(EqualTo_string(TimedModifier.GetName, Localize('inh_land_hunger')), Or(EqualTo_string(TimedModifier.GetName, Localize('inh_primogeniture_rural')), EqualTo_string(TimedModifier.GetName, Localize('inh_undivided_farm_rural')))))))]"
					spacing = 4
					tooltip = "[TimedModifier.GetTooltip]"

					icon = {
						texture = "[TimedModifier.GetIcon]"
						size = { 20 20 }
						parentanchor = vcenter
					}
					textbox = {
						text = "[TimedModifier.GetName]"
						autoresize = yes
						multiline = yes
						maximumsize = { 136 -1 }
						align = nobaseline
						parentanchor = vcenter
						using = fontsize_medium
					}
				}
			}
		}
	}
}
