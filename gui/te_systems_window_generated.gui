	### The Space Race body's entries (te_sr_tab_body, space_race_widget.gui):
	### GetPlayerJournalEntry takes one literal key, so each entry has its own
	### frame, in je_space_race.txt's order, shown only while the shown
	### Country holds it (te_window_space_race_<m>_sgui on Country, on the
	### frame's root, so its header goes with it), and a note in their place
	### while none runs (te_window_space_race_idle_sgui). Several can run at
	### once. Each shows the types its journal roots wrap, the debris row
	### overridden out (Orbit shows it once), then Open Journal Entry for that
	### entry: the overview for any country, the live sections and the button
	### the player's own (National Info). Every header here, the note's too,
	### ends on the "?" that opens the Help page.
	type te_sr_window_milestones = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		ignoreinvisible = yes
		spacing = 10

		### No milestone running: one note in the entries' place, under a header
		### with the "?", so the tab never starts on Space Powers alone.
		flowcontainer = {
			name = "te_systems_window_space_race_idle"
			visible = "[GetScriptedGui('te_window_space_race_idle_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
			parentanchor = hcenter
			direction = vertical
			ignoreinvisible = yes
			spacing = 10
			minimumsize = { 520 -1 }

			default_header = {
				using = default_list_position
				blockoverride "text" {
					text = "te_window_space_race_idle_header"
				}
				te_help_button = {
					visible = "[Not( GetMetaPlayer.IsObserver )]"
					onclick = "[GetVariableSystem.Set('te_popup', 'help_space_race')]"
				}
			}
			te_sr_panel = {
				te_sr_text = {
					text = "te_window_space_race_idle_note"
				}
			}
		}

		### suborbital
		te_system_tab_frame = {
			blockoverride "tab_country" {}
			visible = "[GetScriptedGui('te_window_space_race_suborbital_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
			blockoverride "tab_header" {
				default_header = {
					using = default_list_position
					blockoverride "text" {
						text = "je_space_race_suborbital"
					}
					te_help_button = {
						visible = "[Not( GetMetaPlayer.IsObserver )]"
						onclick = "[GetVariableSystem.Set('te_popup', 'help_space_race')]"
					}
				}
			}
			blockoverride "tab_content" {
				te_sr_suborbital_overview = {}

				### The player's own: the live sections and Open Journal Entry, under the entry.
				flowcontainer = {
					using = te_own_country_only
					parentanchor = hcenter
					direction = vertical
					ignoreinvisible = yes

					flowcontainer = {
						datacontext = "[GetPlayerJournalEntry('je_space_race_suborbital')]"
						parentanchor = hcenter
						direction = vertical
						ignoreinvisible = yes
						spacing = 10

						te_sr_suborbital_status = {
							blockoverride "sr_debris" {}
						}
						button = {
							visible = "[JournalEntry.IsActive]"
							using = default_button
							parentanchor = hcenter
							size = { 480 32 }
							text = "te_system_tab_open_journal"
							tooltip = "te_window_space_race_open_journal_tt"
							onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
						}
					}
				}
			}
			blockoverride "tab_open_journal" {}
		}

		### orbital
		te_system_tab_frame = {
			blockoverride "tab_country" {}
			visible = "[GetScriptedGui('te_window_space_race_orbital_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
			blockoverride "tab_header" {
				default_header = {
					using = default_list_position
					blockoverride "text" {
						text = "je_space_race_orbital"
					}
					te_help_button = {
						visible = "[Not( GetMetaPlayer.IsObserver )]"
						onclick = "[GetVariableSystem.Set('te_popup', 'help_space_race')]"
					}
				}
			}
			blockoverride "tab_content" {
				te_sr_orbital_overview = {}

				### The player's own: the live sections and Open Journal Entry, under the entry.
				flowcontainer = {
					using = te_own_country_only
					parentanchor = hcenter
					direction = vertical
					ignoreinvisible = yes

					flowcontainer = {
						datacontext = "[GetPlayerJournalEntry('je_space_race_orbital')]"
						parentanchor = hcenter
						direction = vertical
						ignoreinvisible = yes
						spacing = 10

						te_sr_orbital_status = {
							blockoverride "sr_debris" {}
						}
						button = {
							visible = "[JournalEntry.IsActive]"
							using = default_button
							parentanchor = hcenter
							size = { 480 32 }
							text = "te_system_tab_open_journal"
							tooltip = "te_window_space_race_open_journal_tt"
							onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
						}
					}
				}
			}
			blockoverride "tab_open_journal" {}
		}

		### moon_landing
