				blockoverride "fifth_button" {
					text = "te_window_tab_covert_warfare"
				}
				blockoverride "fifth_button_tooltip" {
					tooltip = "[SelectLocalization( GetScriptedGui('te_military_covert_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_military_tab_covert_tt', SelectLocalization( GetScriptedGui('te_military_covert_tab_unlock_sgui').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), 'te_system_tab_met_tt', Concatenate( Localize( 'te_window_tab_covert_warfare_locked_tt' ), GetScriptedGui('te_military_covert_tab_unlock_sgui').IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) )]"
				}
				blockoverride "fifth_button_click" {
					enabled = "[GetScriptedGui('te_military_covert_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetVariableSystem.Set('te_systems_window_tab', 'covert_warfare')]"
				}
				blockoverride "fifth_button_visibility" {
					using = te_systems_window_covert_warfare_selected
				}
				blockoverride "fifth_button_visibility_checked" {
					using = te_systems_window_covert_warfare_unselected
				}
				blockoverride "fifth_button_selected" {
					text = "te_window_tab_covert_warfare"
				}
			}
			expand = {}
		}

		# TEMPORARY: a strip of its own for the developer tax-probes tab, so arming
		# the probes never shrinks the system tabs.
		hbox = {
			visible = "[GetScriptedGui('te_tp_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = fixed

			expand = {}
			tab_buttons = {
				minimumsize = { 540 -1 }
				maximumsize = { 540 -1 }
				blockoverride "first_button" { text = "te_tp_tab" }
				blockoverride "first_button_selected" { text = "te_tp_tab" }
				blockoverride "first_button_tooltip" { tooltip = "te_tp_tab_tt" }
				blockoverride "first_button_click" { onclick = "[GetVariableSystem.Set('te_systems_window_tab', 'tax_probes')]" }
				blockoverride "first_button_visibility" { using = te_systems_window_tax_probes_selected }
				blockoverride "first_button_visibility_checked" { visible = "[Not( And( GetVariableSystem.HasValue('te_systems_window_tab', 'tax_probes'), GetScriptedGui('te_tp_tab_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]" }
			}
			expand = {}
		}
	}

	### The full-screen frame's column: three 520 columns and their 30 px
	### gaps wide (spec § 4.3), centered, so the frame scrolls sideways
	### below that width. Each tab's mount as narrow, holding its wide
	### layout once the registry names one (its `wide`), else its body.
	type te_systems_window_tabs_wide = flowcontainer {
		name = "te_systems_window_content_wide"
		parentanchor = hcenter
