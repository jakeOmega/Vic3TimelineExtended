# COPY-PASTED FOR NOW
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

types journal_entry_panel_types
{
	type journal_entry_panel = default_block_window_two_lines {
		name = "journal_entry_panel"
		datacontext = "[JournalEntryPanel.AccessJournalEntryType]"

		### TIMELINE EXTENDED — the see-through page, the third change to this vanilla file (the bars-on-top marker
		### below is the other two). The eye in the header (top_left_button_*, below) fades the whole page so its
		### journal map shows through: a journal entry's map shows only while its page is open (journal_map_modes.md).
		### The faded page still takes clicks (the window's frame is a clickthrough_blocker), and every page reopens
		### opaque (_show clears the flag). On every journal page: the GUI can't tell which entries carry a map, and
		### 1.15's own map entries (the Great Game, the Forest of Bayonets, the Hungry Forties) gain from it too.
		alpha = "[Select_float( GetVariableSystem.Exists('te_je_see_through'), '(float)0.3', '(float)1' )]"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				on_start = "[GetVariableSystem.Clear('te_je_see_through')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/Global/panel_show"
				}
			}
		}

		blockoverride "window_header_name"
		{
			text = "[LabelingHelper.CapitalizeOnlyFirst(JournalEntryPanel.GetHeaderName(GetPlayer))]"
		}

		blockoverride "window_header_name_line_two" {
			text = "JOURNAL_ENTRY_TYPE_HEADING"
		}

		blockoverride "scrollarea_content" {
			# Content for when there is no journal entry
			flowcontainer = {
				name = "concluded_journal_entry_content"
				visible = "[Not(JournalEntryPanel.HasJournalEntry)]"
				datacontext = "[JournalEntryPanel.GetConcludedJournalEntry(GetPlayer)]"
				direction = vertical
				using = default_list_position
				spacing = 10

				widget  = {
					size = { @panel_width_plus_20 120 }
					parentanchor = hcenter

					background = {
						texture =  "gfx/interface/illustrations/journal/top_illu_journal_entries.dds"
						using = top_illu_properties
					}

					widget = {
						size = { 250 120 }
						parentanchor = hcenter

						icon = {
							parentanchor = hcenter
							size = { 120 120 }
							texture = "gfx/interface/backgrounds/round_frame_dec.dds"

							icon = {
								parentanchor = center
								texture = "[JournalEntryType.GetIcon]"
								size = { 100 100 }
							}
						}

						historical_journal_entry_outcome_icon_button = {
							blockoverride "historical_icon_visibility" {
								visible = "[And(ConcludedJournalEntry.IsHistorical, StringIsEmpty(ConcludedJournalEntry.GetHistoricalUrl))]"
							}

							blockoverride "historical_button_visibility" {
								visible = "[And(ConcludedJournalEntry.IsHistorical, Not(StringIsEmpty(ConcludedJournalEntry.GetHistoricalUrl)))]"
							}

							blockoverride "historical_button_tooltip" {
								tooltip = "JOURNAL_ENTRY_CONCLUDED_HISTORICAL_OPEN_URL_TOOLTIP"
							}

							blockoverride "historical_button_onclick" {
								onclick = "[ConcludedJournalEntry.OpenHistoricalLink]"
							}

							blockoverride "historical_icon_size" {
								size = { 40 40 }
							}

							blockoverride "historical_button_size" {
								size = { 44 44 }
							}
						}
					}
				}

				flowcontainer = {
					spacing = 5
					parentanchor = hcenter

					textbox = {
						text = "JOURNAL_ENTRY_CONCLUDED_LABEL"
						autoresize = yes
						align = nobaseline
						using = fontsize_large
						parentanchor = vcenter
					}
				}

				flowcontainer = {
					direction = vertical
					using = default_list_position

					spacing = 20

					textbox = {
						autoresize = yes
						text = "[ConcludedJournalEntry.GetConclusionDesc]"
						min_width = @panel_width_minus_30
						max_width = @panel_width_minus_30
						multiline = yes
						using = default_list_position
						align = nobaseline
						margin = { 15 15 }

						background = {
							using = entry_bg
						}
					}
				}
			}

			# Regular content for when there is a journal entry
			flowcontainer = {
				name = "journal_entry_content"
				visible = "[JournalEntryPanel.HasJournalEntry]"
				datacontext = "[JournalEntryPanel.AccessJournalEntry]"
				direction = vertical
				using = default_list_position
				spacing = 10

				container = {
					ignoreinvisible = yes
					parentanchor = hcenter

					flowcontainer = {
						name = "custom_widget_container_je_icon"
						visible = "[JournalEntry.HasCustomWidget('custom_widget_container_je_icon')]"
						parentanchor = hcenter
						direction = vertical
					}

					widget  = {
						size = { @panel_width_plus_20 120 }
						visible = "[Not(JournalEntry.HasCustomWidget('custom_widget_container_je_icon') )]"

						parentanchor = hcenter

						background = {
							visible = "[JournalEntry.GetType.GetGroup.HasIllustration]"
							texture = "[JournalEntry.GetType.GetGroup.GetIllustration]"
							using = top_illu_properties
							alpha = 0.65
						}

						widget = {
							size = { 250 120 }
							parentanchor = hcenter

							icon = {
								parentanchor = hcenter
								size = { 120 120 }
								texture = "gfx/interface/backgrounds/round_frame_dec.dds"

								icon = {
									parentanchor = center
									texture = "[JournalEntry.GetIcon]"
									size = { 100 100 }
								}
							}

							# completion in progress
							icon = {
								visible = "[JournalEntry.IsProgressing]"
								parentanchor = right|vcenter
								size = { 50 50 }
								texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
								tooltip = "JOURNAL_ENTRY_IN_PROGRESS"
								using = shimmer

								icon = {
									parentanchor = center
									using = rotate_glow_animation_02
									size = { 300% 300% }
									alpha = 0.5
								}
							}
						}

						textbox = {
							visible = "[InDebugMode]"
							raw_text = "DEBUG_JOURNAL_ENTRY_ID"
							autoresize = yes
							align = nobaseline
							using = fontsize_large
							parentanchor = hcenter
						}

						### TIMED AND SCALING MODIFIERS
						flowcontainer = {
							visible = "[Or(Not(IsDataModelEmpty(JournalEntry.GetTimedModifiers)), Not(IsDataModelEmpty(JournalEntry.GetScalingModifiers)))]"
							direction = vertical
							parentanchor = vcenter|right
							spacing = 5
							margin = { 10 10 }
							margin_right = 30
							ignoreinvisible = yes

							background = {
								using = fade_left_simple
								margin_right = 10
							}

							flowcontainer = {
								visible = "[Not(IsDataModelEmpty(JournalEntry.GetScalingModifiers))]"
								spacing = 5
								wrap_count = 4
								datamodel = "[JournalEntry.GetScalingModifiers]"

								item = {
									icon = {
										size = { 35 35 }
										using = tooltip_se
										tooltip = "[ScalingModifier.GetTooltip]"
										texture = "[ScalingModifier.GetIcon]"
									}
								}
							}

							flowcontainer = {
								visible = "[Not(IsDataModelEmpty(JournalEntry.GetTimedModifiers))]"
								spacing = 5
								wrap_count = 4
								datamodel = "[JournalEntry.GetTimedModifiers]"

								item = {
									icon = {
										size = { 35 35 }
										using = tooltip_se
										tooltip = "[TimedModifier.GetTooltip]"
										texture = "[TimedModifier.GetIcon]"
									}
								}
							}
						}
					}

					icon = {
						visible = "[JournalEntry.IsDLCContent]"
						texture = "[JournalEntry.GetDLCIcon]"
						tooltip = "JOURNAL_ENTRY_DLC_TOOLTIP"
						position = { 10 5 }
						size = { 50 50 }
					}
				}

				### TIMED AND SCALING MODIFIERS ALT
				widget = {
					visible = "[And3(JournalEntry.HasCustomWidget('custom_widget_container_je_icon'), Or(Not(IsDataModelEmpty(JournalEntry.GetTimedModifiers)), Not(IsDataModelEmpty(JournalEntry.GetScalingModifiers))), Not(JournalEntry.HasCustomWidget('custom_widget_container_2')))]"
					size = { @panel_width_plus_20 60 }
					parentanchor = hcenter

					flowcontainer = {
						parentanchor = vcenter|right
						spacing = 5
						margin = { 10 10 }
						margin_right = 10
						ignoreinvisible = yes

						background = {
							using = fade_left_simple
							margin_right = 10
						}

						flowcontainer = {
							visible = "[Not(IsDataModelEmpty(JournalEntry.GetScalingModifiers))]"
							spacing = 5
							wrap_count = 4
							datamodel = "[JournalEntry.GetScalingModifiers]"

							item = {
								icon = {
									size = { 35 35 }
									using = tooltip_se
									tooltip = "[ScalingModifier.GetTooltip]"
									texture = "[ScalingModifier.GetIcon]"
								}
							}
						}

						flowcontainer = {
							visible = "[Not(IsDataModelEmpty(JournalEntry.GetTimedModifiers))]"
							spacing = 5
							wrap_count = 4
							datamodel = "[JournalEntry.GetTimedModifiers]"

							item = {
								icon = {
									size = { 35 35 }
									using = tooltip_se
									tooltip = "[TimedModifier.GetTooltip]"
									texture = "[TimedModifier.GetIcon]"
								}
							}
						}
					}
				}

				flowcontainer = {
					name = "custom_widget_container_1"
					visible = "[JournalEntry.HasCustomWidget('custom_widget_container_1')]"
					parentanchor = hcenter
					direction = vertical
				}

				# time out info
				flowcontainer = {
					visible = "[JournalEntry.CanTimeOut]"
					spacing = 5
					parentanchor = hcenter
					tooltip = "JOURNAL_ENTRY_ON_TIMEOUT_LONG"

					icon = {
						size = { 30 30 }
						texture = "gfx/interface/icons/generic_icons/clock.dds"
					}
					textbox = {
						text = "[JournalEntry.GetTimeoutTooltip]"
						autoresize = yes
						align = nobaseline
						using = fontsize_large
						parentanchor = vcenter
					}
				}

				textbox = {
					visible = "[Not(StringIsEmpty(JournalEntry.GetStatusDesc))]"
					text = "[JournalEntry.GetStatusDesc]"
					autoresize = yes
					multiline = yes
					minimumsize = { @panel_width_minus_20 -1 }
					maximumsize = { @panel_width_minus_20 -1 }
					using = default_list_position
					align = hcenter|nobaseline
					using = fontsize_large

					margin = { 20 20 }

					background = {
						alpha = 0.5
						using = entry_bg_fancy_dark
					}
				}

				flowcontainer = {
					name = "custom_widget_container_2"
					visible = "[JournalEntry.HasCustomWidget('custom_widget_container_2')]"
					parentanchor = hcenter
					direction = vertical
				}

				flowcontainer = {
					name = "custom_widget_container_buttons"
					visible = "[JournalEntry.HasCustomWidget('custom_widget_container_buttons')]"
					parentanchor = hcenter
					direction = vertical
				}

				dynamicgridbox = {
					parentanchor = hcenter
					visible = "[And( Not( IsDataModelEmpty( JournalEntry.GetScriptedButtons ) ), Not( JournalEntry.HasCustomWidget('custom_widget_container_buttons') ) )]"
					datamodel = "[JournalEntry.GetScriptedButtons]"
					datamodel_wrap = 2
					flipdirection = yes

					item = {
						widget = {
							size = { 260 60 }

							scripted_journal_entry_button = {
								visible = "[Not( ScriptedButton.IsAutocomplete )]"
								parentanchor = center
							}

							scripted_journal_entry_goal = {
								visible = "[ScriptedButton.IsAutocomplete]"
								parentanchor = center
							}

							# Buttons for which the selected trigger is true have a different appearance and tooltip, but share all behaviors.
							# This means that even selected buttons are clickable as usual, assuming the possible trigger does not prevent it.
							# This enables more use cases, such as using buttons as on-off toggles, but requires the scripter to disable buttons manually in the possible trigger as needed.
						}
					}
				}

				flowcontainer = {
					name = "custom_widget_container_3"
					visible = "[JournalEntry.HasCustomWidget('custom_widget_container_3')]"
					parentanchor = hcenter
					direction = vertical
				}

				flowcontainer = {
					### TIMELINE EXTENDED — one of the changes to this vanilla file (the others
					### are the goal bar below and the see-through page above). A journal entry that draws its own bars higher up
					### the panel says so by putting a (zero-sized) widget in
					### custom_widget_container_7; see je_banking.txt and
					### gui/journal_entry_widgets/te_je_bars_on_top_marker.gui.
					visible = "[And( Not( IsDataModelEmpty( JournalEntry.GetScriptedProgressBars ) ), Not( JournalEntry.HasCustomWidget('custom_widget_container_7') ) )]"
					parentanchor = hcenter
					direction = vertical
					spacing = 10
					datamodel = "[JournalEntry.GetScriptedProgressBars]"

					item = {
						container = {

							# Default
							default_progressbar_horizontal = {
								visible = "[ScriptedProgressBar.IsDefault]"
								block "progressbar_size" {
									size = { 504 30 }
								}
								tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
								blockoverride "values" {
									value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
									min = 0
									max = 1
								}
								textbox = {
									text = "[ScriptedProgressBar.GetDesc]"
									autoresize = yes
									align = nobaseline
									margin_left = 10
									parentanchor = vcenter
								}
							}

							# Default Bad
							bad_progressbar_horizontal = {
								visible = "[ScriptedProgressBar.IsDefaultBad]"
								block "progressbar_size" {
									size = { 504 30 }
								}
								tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
								blockoverride "values" {
									value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
									min = 0
									max = 1
								}
								textbox = {
									text = "[ScriptedProgressBar.GetDesc]"
									autoresize = yes
									align = nobaseline
									margin_left = 10
									parentanchor = vcenter
								}
							}

							#Default Green
							green_progressbar_horizontal = {
								visible = "[ScriptedProgressBar.IsDefaultGreen]"
								block "progressbar_size" {
									size = { 504 30 }
								}

								tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"
								blockoverride "values" {
									value = "[JournalEntry.GetCurrentBarProgress(ScriptedProgressBar.Self)]"
									min = 0
									max = 1
								}
								textbox = {
									text = "[ScriptedProgressBar.GetDesc]"
									autoresize = yes
									align = nobaseline
									margin_left = 10
									parentanchor = vcenter
								}
								textbox = {
									text = "[ScriptedProgressBar.GetSecondDesc]"
									autoresize = yes
									align = right|nobaseline
									margin_right = 10
									parentanchor = right|vcenter
								}
							}

							# Look defined in script
							widget = {
								size = { 520 45 }
								parentanchor = center
								visible = "[ScriptedProgressBar.IsDynamic]"

								hbox = {
									size = { 100% 100% }
									spacing = 5

									icon = {
										size = { 40 40 }
										visible = "[ScriptedProgressBar.HasLeftIcon]"
										texture = "[ScriptedProgressBar.GetLeftIcon]"
									}

									scripted_progressbar_dynamic = {
										layoutpolicy_horizontal = expanding
										tooltip = "[ScriptedProgressBar.GetPeriodicProgressBreakdown]"

										block "progressbar_size" {
											size = { 430 30 }
										}

										textbox = {
											text = "[ScriptedProgressBar.GetDesc]"
											autoresize = yes
											align = nobaseline
											margin_left = 10
											parentanchor = vcenter
										}
										textbox = {
											text = "[ScriptedProgressBar.GetSecondDesc]"
											autoresize = yes
											align = right|nobaseline
											margin_right = 10
											parentanchor = right|vcenter
										}
									}

									icon = {
										size = { 40 40 }
										visible = "[ScriptedProgressBar.HasRightIcon]"
										texture = "[ScriptedProgressBar.GetRightIcon]"
									}
								}
							}
						}
					}
				}

				flowcontainer = {
					parentanchor = hcenter
					### TIMELINE EXTENDED — the bars-on-top marker (custom_widget_container_7)
					### hides the goal bar too, for an entry whose own widget shows its progress.
					visible = "[And( And(JournalEntry.HasProgressBar, JournalEntry.IsActive), Not( JournalEntry.HasCustomWidget('custom_widget_container_7') ) )]"
					margin = { 0 5 }

					default_progressbar_horizontal = {
						block "progressbar_size" {
							size = { 504 30 }
						}
						blockoverride "values" {
							value = "[FixedPointToFloat(JournalEntry.GetGoalProgressPercent)]"
							min = 0
							max = 1
						}

						container = {
							visible = "[Not(JournalEntry.ShowProgressbarAsTime)]"

							textbox = {
								visible = "[EqualTo_CFixedPoint(JournalEntry.GetBaselineValue, '(CFixedPoint)0')]"
								text = "JOURNAL_ENTRY_PROGRESSBAR_FROM_ZERO"
								size = { 504 30 }
								align = nobaseline
								margin_left = 10
								parentanchor = vcenter
							}
							textbox = {
								visible = "[Not(EqualTo_CFixedPoint(JournalEntry.GetBaselineValue, '(CFixedPoint)0'))]"
								text = "JOURNAL_ENTRY_PROGRESSBAR_FROM_BASE"
								size = { 504 30 }
								align = nobaseline
								margin_left = 10
								parentanchor = vcenter
							}
						}

						container = {
							visible = "[JournalEntry.ShowProgressbarAsTime]"

							textbox = {
								visible = "[JournalEntry.ShowProgressbarAsMonths]"
								text = "JOURNAL_ENTRY_PROGRESSBAR_MONTHS"
								size = { 504 30 }
								align = nobaseline
								margin_left = 10
								parentanchor = vcenter
							}
							textbox = {
								visible = "[JournalEntry.ShowProgressbarAsWeeks]"
								text = "JOURNAL_ENTRY_PROGRESSBAR_WEEKS"
								size = { 504 30 }
								align = nobaseline
								margin_left = 10
								parentanchor = vcenter
							}
						}
					}
				}

				flowcontainer = {
					direction = vertical
					using = default_list_position

					spacing = 20

					# PROGRESS BAR CONDITIONS
					flowcontainer = {
						visible = "[Or(Not(StringIsEmpty(JournalEntry.GetAdvanceDesc)), Not(StringIsEmpty(JournalEntry.GetDepleteDesc)))]"
						direction = vertical

						background = {
							using = dropdown_background
							margin = { 0 -2 }
						}

						section_header_button = {
							blockoverride "layout" {
								size = { @panel_width_plus_10 38 }
							}

							blockoverride "left_text" {
								text = "PROGRESS_CONDITIONS_HEADER"
							}

							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Toggle( 'journal_entry_progress_conditions' )]"
							}

							blockoverride "onclick_showmore" {
								visible = "[Not(GetVariableSystem.Exists( 'journal_entry_progress_conditions' ))]"
							}

							blockoverride "onclick_showless" {
								visible = "[GetVariableSystem.Exists( 'journal_entry_progress_conditions' )]"
							}
						}

						flowcontainer = {
							visible = "[GetVariableSystem.Exists('journal_entry_progress_conditions')]"
							minimumsize = { @panel_width -1 }
							parentanchor = hcenter
							margin_top = 5
							margin_bottom = 10
							direction = vertical
							spacing = 10

							textbox = {
								visible = "[Not(StringIsEmpty(JournalEntry.GetAdvanceDesc))]"
								autoresize = yes
								text = "[JournalEntry.GetAdvanceDesc]"
								min_width = @panel_width_minus_30
								max_width = @panel_width_minus_30
								multiline = yes
								using = default_list_position
								align = nobaseline
							}

							textbox = {
								visible = "[Not(StringIsEmpty(JournalEntry.GetDepleteDesc))]"
								autoresize = yes
								text = "[JournalEntry.GetDepleteDesc]"
								min_width = @panel_width_minus_30
								max_width = @panel_width_minus_30
								multiline = yes
								using = default_list_position
								align = nobaseline
							}
						}
					}

					flowcontainer = {
						name = "custom_widget_container_4"
						visible = "[JournalEntry.HasCustomWidget('custom_widget_container_4')]"
						parentanchor = hcenter
						direction = vertical
					}

					textbox = {
						autoresize = yes
						text = "[JournalEntry.GetReason]"
						min_width = @panel_width_minus_30
						max_width = @panel_width_minus_30
						multiline = yes
						using = default_list_position
						align = nobaseline
						margin = { 15 15 }

						background = {
							using = entry_bg
						}
					}

					flowcontainer = {
						name = "custom_widget_container_5"
						visible = "[JournalEntry.HasCustomWidget('custom_widget_container_5')]"
						parentanchor = hcenter
						direction = vertical
					}

					flowcontainer = {
						visible = "[Not( IsDataModelEmpty( JournalEntry.GetInvolvedCountries ) )]"
						direction = vertical
						using = default_list_position
						min_width = @panel_width_minus_30
						max_width = @panel_width_minus_30

						textbox = {
							autoresize = yes
							text = "INVOLVED_COUNTRIES"
							using = fontsize_large
							parentanchor = hcenter
							align = nobaseline
							margin = { 15 15 }
						}

						dynamicgridbox = {
							parentanchor = hcenter
							datamodel = "[JournalEntry.GetInvolvedCountries]"
							datamodel_wrap = 8
							flipdirection = yes

							item = {
								widget = {
									size = { 60 60 }

									small_flag = {}
								}
							}
						}

						background = {
							using = entry_bg
						}
					}

					flowcontainer = {
						name = "custom_widget_container_6"
						visible = "[JournalEntry.HasCustomWidget('custom_widget_container_6')]"
						parentanchor = hcenter
						direction = vertical
					}

					flowcontainer = {
						direction = vertical
						max_update_rate = 8
						using = default_list_position
						name = "complete_text"

						spacing = 5

						textbox = {
							visible = "[Not(StringIsEmpty(JournalEntry.GetProgressDesc))]"
							text = "[JournalEntry.GetProgressDesc]"
							autoresize = yes
							multiline = yes
							minimumsize = { @panel_width_minus_30 -1 }
							maximumsize = { @panel_width_minus_30 -1 }
							using = default_list_position
							align = nobaseline

							margin = { 15 0 }

							background = {
								using = entry_bg
							}
						}

						flowcontainer = {
							direction = vertical
							using = default_list_position
							spacing = 5
							datamodel = "[JournalEntry.GetOutcomes]"

							item = {
								flowcontainer = {
									direction = vertical
									spacing = 5

									textbox = {
										visible = "[And(Not(StringIsEmpty(JournalEntryOutcome.GetConditionsDesc)), Not(JournalEntryOutcome.IsTimeout))]"
										text = "[JournalEntryOutcome.GetConditionsDesc]"
										autoresize = yes
										multiline = yes
										minimumsize = { @panel_width_minus_30 -1 }
										maximumsize = { @panel_width_minus_30 -1 }
										using = default_list_position
										align = nobaseline

										margin = { 15 5 }

										background = {
											texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
											color = "[JournalEntryOutcome.GetColor]"
											alpha = 0.4

											modify_texture = {
												using = texture_velvet
											}
										}

										historical_journal_entry_outcome_icon_button = {}
									}

									textbox = {
										visible = "[Not(StringIsEmpty(JournalEntryOutcome.GetEffectDesc))]"
										text = "[JournalEntryOutcome.GetEffectDesc]"
										autoresize = yes
										multiline = yes
										minimumsize = { @panel_width_minus_30 -1 }
										maximumsize = { @panel_width_minus_30 -1 }
										using = default_list_position
										align = nobaseline

										margin_left = 35
										margin_right = 15
									}
								}
							}
						}
					}
				}

				flowcontainer = {
					name = "custom_widget_container_7"
					visible = "[JournalEntry.HasCustomWidget('custom_widget_container_7')]"
					parentanchor = hcenter
					direction = vertical
				}

				### TUTORIAL

				divider_clean = {
					visible = "[Or(JournalEntry.HasHowTutorialLesson, JournalEntry.HasWhyTutorialLesson)]"
				}

				flowcontainer = {
					direction = vertical
					parentanchor = hcenter
					spacing = 10

					button = {
						using = default_button
						parentanchor = hcenter
						size = { @panel_width_minus_30 60 }
						text = "TELL_ME_HOW"
						using = fontsize_large
						tooltip = "[JournalEntry.CanStartTutorialLessonDesc]"
						visible = "[JournalEntry.HasHowTutorialLesson]"
						enabled = "[JournalEntry.CanStartTutorialLesson]"
						onclick = "[JournalEntry.StartHowTutorialLesson]"
						onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
					}
					button = {
						using = default_button
						parentanchor = hcenter
						size = { @panel_width_minus_30 60 }
						text = "TELL_ME_WHY"
						using = fontsize_large
						tooltip = "[JournalEntry.CanStartTutorialLessonDesc]"
						visible = "[JournalEntry.HasWhyTutorialLesson]"
						enabled = "[JournalEntry.CanStartTutorialLesson]"
						onclick = "[JournalEntry.StartWhyTutorialLesson]"
						onclick = "[InformationPanelBar.OpenJournalEntryPanel(JournalEntry.AccessSelf)]"
					}
				}
			}
		}

		blockoverride "pin_visibility" {
			visible = "[JournalEntryPanel.HasJournalEntry]"
			datacontext = "[JournalEntryPanel.AccessJournalEntry]"
		}

		blockoverride "pin_properties" {
			visible = "[JournalEntry.IsPinnedInOutliner]"
			onclick = "[JournalEntry.TogglePinInOutliner]"
			tooltip = "UNPIN_JOURNAL_ENTRY"
		}

		blockoverride "unpin_properties" {
			visible = "[Not(JournalEntry.IsPinnedInOutliner)]"
			onclick = "[JournalEntry.TogglePinInOutliner]"
			tooltip = "PIN_JOURNAL_ENTRY"
		}

		### TIMELINE EXTENDED — the see-through page's eye (see alpha above), in the header slot vanilla leaves empty
		### here (default_block_window's top-left button, beside the back arrow).
		blockoverride "top_left_button_visibility" {
			visible = "[JournalEntryPanel.HasJournalEntry]"
		}

		blockoverride "top_left_button_properties" {
			tooltip = "te_je_see_through_tt"
			onclick = "[GetVariableSystem.Toggle('te_je_see_through')]"
		}

		blockoverride "top_left_button_texture" {
			texture = "gfx/interface/icons/military_icons/navy_icons/visibility.dds"
		}
	}

	type historical_journal_entry_outcome_icon_button = flowcontainer {
		parentanchor = right|vcenter

		icon = {
			block "historical_icon_visibility" {
				visible = "[And(JournalEntryOutcome.IsHistorical, StringIsEmpty(JournalEntryOutcome.GetHistoricalUrl))]"
			}

			block "historical_icon_size" {
				size = { 30 30 }
			}

			tooltip = "JOURNAL_ENTRY_OUTCOME_HISTORICAL_TOOLTIP"
			texture = "gfx/interface/icons/generic_icons/historical_character_icon.dds"
		}

		button_icon_round = {
			block "historical_button_visibility" {
				visible = "[And(JournalEntryOutcome.IsHistorical, Not(StringIsEmpty(JournalEntryOutcome.GetHistoricalUrl)))]"
			}

			block "historical_button_tooltip" {
				tooltip = "JOURNAL_ENTRY_OUTCOME_HISTORICAL_OPEN_URL_TOOLTIP"
			}

			block "historical_button_onclick" {
				onclick = "[JournalEntryOutcome.OpenHistoricalLink]"
			}

			block "historical_button_size" {
				size = { 34 34 }
			}

			using = tooltip_se

			blockoverride "icon" {
				texture = "gfx/interface/icons/generic_icons/historical_character_icon.dds"
			}

			blockoverride "icon_size" {
				size = { 75% 75% }
			}
		}
	}

	type scripted_journal_entry_goal = widget {
		size = { 250 50 }
		tooltip = "SCRIPTED_GOAL_TOOLTIP"

		background = {
			visible = "[ScriptedButton.IsSelected]"
			using = paper_bg
		}

		background = {
			visible = "[Not(ScriptedButton.IsSelected)]"
			using = dark_area
			using = entry_bg_mask_top
			using = entry_bg_mask_bottom
		}

		background = {
			visible = "[Not(ScriptedButton.IsSelected)]"
			using = entry_bg
		}

		icon = {
			visible = "[Not( ScriptedButton.IsSelected )]"
			size = { 30 30 }
			parentanchor = vcenter
			position = { 10 -2 }
			texture = "gfx/interface/icons/generic_icons/checkbox_simple.dds"
		}

		icon = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 30 30 }
			parentanchor = vcenter
			position = { 10 -2 }
			texture = "gfx/interface/icons/generic_icons/checkbox_greencheck.dds"
		}

		textbox = {
			parentanchor = vcenter
			position = { 45 0 }
			elide = right
			max_width = 195
			fontsize_min = 12
			align = nobaseline
			autoresize = yes
			text = "[ScriptedButton.GetName]"
		}
	}

	type scripted_journal_entry_button = button {
		using = default_button_action
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		size = { 250 50 }
		margin = { 20 20 }

		widget = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 100% 100% }

			background = {
				using = paper_bg
			}
		}

		textbox = {
			parentanchor = center
			align = nobaseline
			autoresize = yes
			max_width = 230
			elide = right
			fontsize_min = 14
			text = "[ScriptedButton.GetName]"
		}

		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = highlighted_square_selection
		}
	}
}
