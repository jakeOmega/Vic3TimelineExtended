		size = { ${frame} }
	}
	blockoverride "plot_layouts" {
		### The bars' 96 px at the frame's foot, as te_history_chart has them; the 36 px above are the pips' lane.
		widget = {
			size = { 100% ${box_h} }
			parentanchor = bottom

			${plots}
			textbox = {
				parentanchor = left|top
				position = { 8 6 }
				autoresize = yes
				using = fontsize_medium
				raw_text = "100%"
			}
			textbox = {
				parentanchor = left|bottom
				position = { 8 -6 }
				autoresize = yes
				using = fontsize_medium
				raw_text = "0"
			}
		}
	}
	### Empty, with its line, until a census has counted deaths by cause (te_demog_dc_ready_sgui):
	### the game-start census counts none, so the frame stood empty through the first year. Only
	### while the store is a new game's, under 3 samples, as Births and Deaths' (its note).
	blockoverride "empty_visible" {
		visible = "[Or( IsDataModelEmpty( Country.MakeScope.GetList('te_dg_hist') ), And( LessThan_int32( GetDataModelSize( Country.MakeScope.GetList('te_dg_hist') ), '(int32)3' ), Not( GetScriptedGui('te_demog_dc_ready_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ) ) ) )]"
	}
	blockoverride "empty_text" {
		text = "[SelectLocalization( GetScriptedGui('te_history_tracked_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_demog_hist_empty', 'te_history_untracked' )]"
	}
}

@fragment demog_gini
te_history_chart = {
	blockoverride "chart_title_font" {
		using = te_demog_fontsize_heading
	}
	blockoverride "chart_legend_font" {
		using = fontsize_medium
	}
	blockoverride "chart_title" {
		text = "te_demog_hist_gini_title"
	}
	blockoverride "chart_legend" {
		text = "te_demog_hist_gini_legend"
	}
	blockoverride "bar_tooltip" {
		tooltip = "te_demog_hist_gini_tt"
	}
	blockoverride "marker_pips" {
		te_demog_hist_pips = {}
	}
	blockoverride "bar_body" {
		te_history_bar_unsigned = {
			visible = "[ScriptContainer.HasVariable('te_dg_h_gini')]"
			blockoverride "values" {
				min = 0
				max = 1
				value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)${thin:0.02}', ScriptContainer.GetVariableValue('te_dg_h_gini') ) )]"
			}
			blockoverride "cover_values" {
				min = 0
				max = 1
				value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue('te_dg_h_gini'), '(CFixedPoint)${thin:0.04}' ) ) )]"
			}
			blockoverride "color" {
				color = { 0.78 0.68 0.46 1.0 }
			}
		}
	}
	blockoverride "plot_size" {
		size = { ${frame} }
	}
	blockoverride "plot_layouts" {
		### The bars' 96 px at the frame's foot, as te_history_chart has them; the 36 px above are the pips' lane.
		widget = {
			size = { 100% ${box_h} }
			parentanchor = bottom

			${plots}
			textbox = {
				parentanchor = left|top
				position = { 8 6 }
				autoresize = yes
				using = fontsize_medium
				raw_text = "1"
			}
			textbox = {
				parentanchor = left|bottom
				position = { 8 -6 }
				autoresize = yes
				using = fontsize_medium
				raw_text = "0"
			}
		}
	}
	blockoverride "empty_visible" {
		visible = "[IsDataModelEmpty( Country.MakeScope.GetList('te_dg_hist') )]"
	}
	blockoverride "empty_text" {
		text = "[SelectLocalization( GetScriptedGui('te_history_tracked_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_demog_hist_empty', 'te_history_untracked' )]"
	}
}

