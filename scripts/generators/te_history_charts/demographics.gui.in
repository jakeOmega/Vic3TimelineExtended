		te_history_bar_unsigned = {
			visible = "[ScriptContainer.HasVariable('te_dg_h_gini')]"
			blockoverride "values" {
				min = 0
				max = 1
				value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)${thin:0.02}', ScriptContainer.GetVariableValue('te_dg_h_gini') ) )]"
			}
			blockoverride "cover_values" {
				min = 0
				max = 1
				value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue('te_dg_h_gini'), '(CFixedPoint)${thin:0.04}' ) ) )]"
			}
			blockoverride "color" {
				color = { 0.78 0.68 0.46 1.0 }
			}
		}
	}
	blockoverride "plot_size" {
		size = { ${frame} }
	}
	blockoverride "plot_layouts" {
		### The bars' 96 px at the frame's foot, as te_history_chart has them; the 36 px above are the pips' lane.
		widget = {
			size = { 100% ${box_h} }
			parentanchor = bottom

			te_history_plot = {
				visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '5')]"
