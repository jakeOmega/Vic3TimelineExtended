				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.902 0.404 0.404 1.0 }
				value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('te_dg_h_c8') )]"
				min = 0
				max = 1
			}
			progressbar = {
				size = { 100% 100% }
				direction = vertical
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.565 0.522 0.914 1.0 }
				value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('te_dg_h_c7') )]"
				min = 0
				max = 1
			}
			progressbar = {
				size = { 100% 100% }
				direction = vertical
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.0 0.514 0.0 1.0 }
				value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('te_dg_h_c6') )]"
				min = 0
				max = 1
			}
			progressbar = {
				size = { 100% 100% }
				direction = vertical
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.835 0.318 0.506 1.0 }
				value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('te_dg_h_c5') )]"
				min = 0
				max = 1
			}
			progressbar = {
				size = { 100% 100% }
				direction = vertical
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.788 0.522 0.0 1.0 }
				value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('te_dg_h_c4') )]"
				min = 0
				max = 1
			}
			progressbar = {
				size = { 100% 100% }
				direction = vertical
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.098 0.620 0.439 1.0 }
				value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('te_dg_h_c3') )]"
				min = 0
				max = 1
			}
			progressbar = {
				size = { 100% 100% }
				direction = vertical
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.851 0.349 0.149 1.0 }
				value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('te_dg_h_c2') )]"
				min = 0
				max = 1
			}
			progressbar = {
				size = { 100% 100% }
				direction = vertical
				progresstexture = "gfx/interface/backgrounds/white.dds"
				noprogresstexture = "gfx/interface/icons/generic_icons/transparent.dds"
				texture_density = 2
				skip_initial_animation = yes
				alwaystransparent = yes
				color = { 0.224 0.529 0.898 1.0 }
				value = "[FixedPointToFloat( ScriptContainer.GetVariableValue('te_dg_h_c1') )]"
				min = 0
				max = 1
			}
		}
	}
	blockoverride "plot_size" {
		size = { ${frame} }
	}
	blockoverride "plot_layouts" {
		### The bars' 96 px at the frame's foot, as te_history_chart has them; the 36 px above are the pips' lane.
		widget = {
			size = { 100% ${box_h} }
			parentanchor = bottom

			te_history_plot = {
				visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '5')]"
				blockoverride "bar_size" {
					size = { ${bars_5} ${bar_h} }
				}
			}
			te_history_plot = {
				visible = "[GetVariableSystem.HasValue('te_demog_hist_range', '20')]"
				blockoverride "bar_size" {
					size = { ${bars_20} ${bar_h} }
				}
			}
			te_history_plot = {
				visible = "[Not( Or( GetVariableSystem.HasValue('te_demog_hist_range', '5'), GetVariableSystem.HasValue('te_demog_hist_range', '20') ) )]"
				blockoverride "bar_size" {
					size = { ${bars_100} ${bar_h} }
				}
			}
			textbox = {
				parentanchor = left|top
				position = { 8 6 }
				autoresize = yes
				using = fontsize_medium
				raw_text = "100%"
			}
			textbox = {
				parentanchor = left|bottom
				position = { 8 -6 }
				autoresize = yes
				using = fontsize_medium
				raw_text = "0"
			}
		}
	}
	blockoverride "empty_visible" {
		visible = "[IsDataModelEmpty( Country.MakeScope.GetList('te_dg_hist') )]"
	}
	blockoverride "empty_text" {
		text = "[SelectLocalization( GetScriptedGui('te_history_tracked_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End ), 'te_demog_hist_empty', 'te_history_untracked' )]"
	}
}

@fragment demog_gini
