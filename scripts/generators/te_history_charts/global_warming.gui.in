# History chart fragments: global_warming (scripts/generators/gen_te_history_charts.py).
# Each "@fragment <name>" opens one chart's te_history_chart instance as its section
# had it, dedented, each size a placeholder (the generator's docstring lists them).
# Edit a chart here, then run the generator; its section instances the chart's
# te_hist_<id> wrapper.

@fragment gw_temp
te_history_chart = {
	blockoverride "chart_title" {
		text = "gw_hist_chart_temp_title"
	}
	blockoverride "chart_legend" {
		text = "gw_hist_chart_temp_legend"
	}
	# This series records no markers; the store's pips belong to
	# other systems (banking, cultural hegemony) and would go unexplained.
	blockoverride "marker_pips" {}
	blockoverride "bar_tooltip" {
		tooltip = "gw_hist_tt_temp"
	}
	blockoverride "bar_body" {
		te_history_bar_unsigned = {
			visible = "[ScriptContainer.HasVariable( 'te_hist_v_gw_temp' )]"
			blockoverride "values" {
				min = 0
				max = 4
				value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)${thin:0.08}', ScriptContainer.GetVariableValue( 'te_hist_v_gw_temp' ) ) )]"
			}
			blockoverride "cover_values" {
				min = 0
				max = 4
				value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_gw_temp' ), '(CFixedPoint)${thin:0.16}' ) ) )]"
			}
			blockoverride "color" {
				color = { 0.85 0.42 0.30 1.0 }
			}
		}
	}
}

@fragment gw_share
te_history_chart = {
	blockoverride "chart_title" {
		text = "gw_hist_chart_share_title"
	}
	blockoverride "chart_legend" {
		text = "gw_hist_chart_share_legend"
	}
	# This series records no markers; the store's pips belong to
	# other systems (banking, cultural hegemony) and would go unexplained.
	blockoverride "marker_pips" {}
	blockoverride "bar_tooltip" {
		tooltip = "gw_hist_tt_share"
	}
	blockoverride "bar_body" {
		te_history_bar_unsigned = {
			visible = "[ScriptContainer.HasVariable( 'te_hist_v_gw_share' )]"
			blockoverride "values" {
				min = 0
				max = 100
				value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)${thin:2}', ScriptContainer.GetVariableValue( 'te_hist_v_gw_share' ) ) )]"
			}
			blockoverride "cover_values" {
				min = 0
				max = 100
				value = "[FixedPointToFloat( Max_CFixedPoint( '(CFixedPoint)0', Subtract_CFixedPoint( ScriptContainer.GetVariableValue( 'te_hist_v_gw_share' ), '(CFixedPoint)${thin:4}' ) ) )]"
			}
			blockoverride "color" {
				color = { 0.45 0.60 0.40 1.0 }
			}
		}
	}
}
